# -*- coding: utf-8 -*-
"""分镜按流派重组 自检（老板 2026-10-02 五十六改：「图描述完全就只是为了文案的文字写的」）。

口径：
  1) 一条流派从一句变三句：take（长什么样）＋ cast（这段文案要变成这一派的什么料）＋ forbid（这样算不合格），
     三句一起进 AI 那一发的「【这一套图的取材路子】」；need 仍旧给人看；
  2) 🔁 重出那一发拿到的是整篇原文 ＋ 这一张是第几张／共几张 ＋ 前后段，不再只拿到一行段清单；
  3) 分镜按三块写（六十二改：『这一张要证明』『画面里必须出现的元素』逐条编号、『背景』，有歧义再加一行『先说清楚』；
     『版式』不再单列——字排哪儿挪进「配文方式」那一档的格子），🔁 那一发与格子模板、列头、提示词尾巴同一份口径；
     同一发还按每段的配文档回一份「配文」（大字／承接／标注／要害／字排哪儿，用不上哪格留空），档以客户拨的为准、AI 不许改档；
  4) 流派照旧不进提示词尾巴（尾巴只带「怎么画」那四轴，四轴有内置统一小红书打底兜着，永不为空）；
  5) 零 AI 的抄文案检查：分镜基本还是这段字 → 挂一颗「⚠️ 还是在抄文案」，点一下＝只重出这一段；
  6) 账号自加的流派跟内置的同一张表：cast/forbid 空着也能用，填了就一起喂 AI。

跑法：python3 -X utf8 scripts/dev/check_desc_deep.py
临时 profile 加载真扩展（msedge），全程 AI 走桩、不烧真接口。
"""
import json
import pathlib
import shutil
import sys
import tempfile
import time

from playwright.sync_api import sync_playwright

try:
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')
    sys.stderr.reconfigure(encoding='utf-8', errors='replace')
except Exception:
    pass

ROOT = pathlib.Path(__file__).resolve().parents[2]
EXT = ROOT / 'extension'
OUT = pathlib.Path(tempfile.gettempdir())
ERRORS = []

BODY = ('开场钩子：还在手动对账。\n\n'
        '每天要花两个小时把三张表的数字凑到一起。\n\n'
        '改成自动跑，第二天早上结果就摆在那。\n\n'
        '结尾引导：主页简介里找我。')

MOTIF_A = '真人工作场景'
MOTIF_C = '自家三格'
CUSTOM = {
    'k': MOTIF_C,
    'take': '只摆三样东西，一样占一块，别多',
    'cast': '把这段挑出三样最实在的东西，一样一块，按这段说的先后排',
    'forbid': '偷懒：还是把这段的字抄满三块',
    'need': '要三样实物',
}

S1 = '每天要花两个小时把三张表的数字凑到一起。'
S2 = '改成自动跑，第二天早上结果就摆在那。'
S3 = '结尾引导：主页简介里找我。'
# 抄文案那一格：三块的标题都写了，内容却还是把这行段原文整份搬上去（本地检查要判它不合格）
SHALLOW = ('这一张要证明：' + S1 + '｜画面里必须出现的元素：' + S1 + '｜背景：' + S1)
# 按流派重组过的一格（六十二改：三块＋一行先说清楚；『版式』不再单列，字排哪儿跟着配文档走）
DEEP = ('重组后：『这一张要证明』这张站稳不用人守着；『先说清楚』别把「结果」画成奖杯；'
        '『画面里必须出现的元素』1. 一双手离开键盘，屏幕上是跑完的日志（这就是不用人守着的凭据）；'
        '2. 桌上一杯放凉的茶；3. 墙上贴的那张手排班表；『背景』晚上家里书桌，台灯从右上方单光源，浅景深随手抓拍，不要棚拍不要广告片。')

ITEMS = [{'id': 's1', 'text': S1, 'desc': SHALLOW},
         {'id': 's2', 'text': S2, 'desc': DEEP},
         {'id': 's3', 'text': S3, 'desc': '缺：这张要有真截图'}]

NOTES = "async () => (await chrome.storage.local.get('np_notes')).np_notes || []"

SEED = r'''async (payload) => {
    await Storage.initializeDefaults(DEFAULT_PROMPTS);
    await ensureTenantInit();
    const cfg = await Storage.getConfig();
    cfg.product.name = '深分镜测试产品';
    cfg.product.sellPoints = [{title: '省两小时', content: '把三张表并成一份'}];
    cfg.ai.apiKey = 'test-local-only';
    cfg.imgMotifs = [payload.custom];
    await Storage.setConfig(cfg);
    // 真落档那一份：行自己带 shots，条目级那两份＝打开那一行的镜像（npArchiveData 里 npImgMirror 写的）
    const row = {id: 'g-deep', pid: 'xhs', style: '', updatedAt: Date.now(),
                 shots: { look: { motif: payload.motifA }, items: payload.items },
                 visual: { cover: '', images: '' }};
    await chrome.storage.local.set({
        np_notes: [{id: 'deep-1', title: '别再手动对账', status: '待发', platform: 'xhs',
                    form: '图文', draft: payload.body, createdAt: Date.now(),
                    imgDocs: [row], shots: row.shots, visual: row.visual}],
        np_assets: [],
    });
    self.aiCalls = 0;
    self.otherCalls = 0;
    self.descSystems = [];
    self.descUsers = [];
    // 全程走桩：只有 🔁 重出分镜那一发（系统提示词以「你在改一条…」开头）按段原文回号，
    // 其余任何一发（断句 / 素材清单 / 没料到的）一律记进 otherCalls 并返回空 JSON——绝不真打接口。
    // 回的那一份「配文」里档故意写成客户没拨过的「整段上屏」：扩展该只取字、不许 AI 反过来改档。
    AiClient.chatCompletion = async (cfg2, system, user) => {
        const sys = String(system || '');
        if (sys.indexOf('你在改一条') >= 0) {
            const segs = (String(user || '').match(/^本段（要写的就是它）：(.+)$/gm) || [])
                .map(s => s.replace(/^本段（要写的就是它）：/, '').trim());
            self.descSystems.push(sys);
            self.descUsers.push(String(user || ''));
            self.aiCalls++;
            return {content: JSON.stringify({风格: '', 画面: segs.map(t => ({
                句: t, 分镜: payload.deep,
                配文: {档: 'whole', 大字: '两小时不用守着', 承接: ['三张表并成一份', '早上来收结果'], 标注: [], 要害: '不用守着', 字排哪儿: '压在右边暗角'},
            }))})};
        }
        self.otherCalls++;
        return {content: '{}'};
    };
    return true;
}'''


def boot(p):
    for i in range(5):
        prof = OUT / ('descdeep-profile%d' % i)
        shutil.rmtree(prof, ignore_errors=True)
        ctx = p.chromium.launch_persistent_context(
            str(prof), headless=False, channel='msedge',
            ignore_default_args=['--disable-extensions'],
            args=[f'--disable-extensions-except={EXT}', f'--load-extension={EXT}'])
        t0 = time.time()
        while time.time() - t0 < 25 and not ctx.service_workers:
            time.sleep(0.3)
        if ctx.service_workers:
            return ctx
        print('  扩展没装起来（第 %d 趟），重来' % (i + 1), flush=True)
        ctx.close()
    raise RuntimeError('扩展装不上：连试 5 趟都没有 service worker')


def wait_calls(sw, n, limit=25):
    t0 = time.time()
    while time.time() - t0 < limit:
        if sw.evaluate('self.aiCalls') >= n:
            return True
        time.sleep(0.2)
    return False


with sync_playwright() as p:
    ctx = boot(p)
    try:
        sw = ctx.service_workers[0]
        assert sw.evaluate('chrome.runtime.onMessage.hasListeners()'), '后台路由没注册上'
        sw.evaluate(SEED, {'body': BODY, 'items': ITEMS, 'deep': DEEP,
                           'motifA': MOTIF_A, 'custom': CUSTOM})

        page = ctx.new_page()
        page.on('pageerror', lambda e: ERRORS.append(str(e)[:200]))
        page.set_viewport_size({'width': 1280, 'height': 980})
        page.goto(sw.url.replace('background.js', 'popup.html?mode=big'))
        page.wait_for_function('typeof switchMainTab === "function" && typeof npDescsRegen === "function"')
        page.set_default_timeout(25000)

        # ── 0) 表本身：内置十条每条都带着转译配方与反例，喂 AI 那一句三行齐全 ──
        lib = page.evaluate('''() => {
            const all = VisualMotif.all([]);
            const one = VisualMotif.of('真人工作场景', []);
            return {n: all.length,
                    noCast: all.filter(x => !x.cast).map(x => x.k),
                    noForbid: all.filter(x => !x.forbid).map(x => x.k),
                    rule: VisualMotif.ruleOf('真人工作场景', []),
                    take: one.take, cast: one.cast, forbid: one.forbid,
                    custom: VisualMotif.all([__CUSTOM__]).length};
        }'''.replace('__CUSTOM__', json.dumps(CUSTOM, ensure_ascii=False)))
        assert lib['n'] == 10, '内置十条流派：%s' % lib['n']
        assert not lib['noCast'] and not lib['noForbid'], '缺转译配方／反例的流派：%s %s' % (lib['noCast'], lib['noForbid'])
        assert lib['rule'].startswith('· 长什么样：' + lib['take']), lib['rule'][:80]
        assert '· 这段文案要变成这一派的什么料：' + lib['cast'] in lib['rule'], '喂 AI 那一句少了转译配方'
        assert '· 这样算不合格（这一派最常见的偷懒）：' + lib['forbid'] in lib['rule'], '喂 AI 那一句少了反例'
        assert lib['custom'] == 11, '账号自加的流派跟内置的同一张表：%s' % lib['custom']
        print('PASS: 十条内置流派都带 cast＋forbid，喂 AI 那一句三行齐全（长什么样／转译配方／这样算不合格）', flush=True)

        # ── 1) 档案那颗「🎬 出片台」→ 表上那一行 → 造图片：流派是这一行的身份，① 风格那档把三句配方收成折叠块 ──
        page.evaluate('() => switchMainTab("noteArchive")')
        page.wait_for_function('() => !!document.querySelector(\'#noteArchiveContent .npar-task[data-id="deep-1"]\')')
        page.locator('#noteArchiveContent .npar-task[data-id="deep-1"]').click()
        page.wait_for_function('() => _npMode === "task" && document.querySelectorAll("#noteTaskContent .np-task-img").length === 1')
        assert sw.evaluate('self.aiCalls') == 0 and sw.evaluate('self.otherCalls') == 0, '进这一页不该烧 AI'
        assert MOTIF_A in page.locator('#noteTaskContent tbody').first.inner_text(), \
            '这一行的流派读 shots.look.motif，摆在表上「出片风格」那一格'
        page.locator('#noteTaskContent .np-task-img').first.click()
        page.wait_for_function('() => _npMode === "out" && !!document.querySelector("#npImgTabs .np-imgtab")')
        keys = page.locator('#npImgTabs .np-imgtab').evaluate_all('els => els.map(x => x.getAttribute("data-t"))')
        assert keys == ['look', 'cut', 'desc', 'preview'], '造图片只剩四档：%s' % keys
        assert page.evaluate('() => npLookOf(npS()).motif') == MOTIF_A, '点的是哪一行就摊开哪一行的流派'
        page.locator('#npImgTabs .np-imgtab[data-t="look"]').click()
        page.wait_for_function('() => !!document.querySelector("#npLookBox")')
        assert page.locator('#npLookBox details').count() == 1, '这一派的用法收成折叠块，不铺长句'
        dbox = page.locator('#npLookBox details').text_content()
        assert '转译配方：' + lib['cast'] in dbox and '不合格的样子：' + lib['forbid'] in dbox, dbox[:120]

        # ── 2) ③ 分镜：抄文案那一格挂 ⚠️，重组过的那格与太短的那格都不挂 ──
        page.locator('#npImgTabs .np-imgtab[data-t="desc"]').click()
        page.wait_for_function('() => document.querySelectorAll(".np-shot").length === 3')
        body_txt = page.evaluate('() => document.getElementById("npTabBody").innerText')
        assert '分镜' in page.locator('#npImgTabs').inner_text(), '档位条上这一档的名字'
        assert '这一张要证明／画面里必须出现的元素／背景' in body_txt, '列头要写明那三块（举证口径）'
        assert '『画面里必须出现的元素』' in page.locator('.np-shot-desc').first.get_attribute('placeholder'), '空着的格子给写法模板'
        assert '配文方式' in body_txt and page.locator('.np-cap').count() == 12, '每一行都摆四档配文 chips（3 段 × 4 档）'
        assert page.locator('.np-shot-shallow').count() == 1, '只有抄文案那一格挂 ⚠️'
        assert page.locator('.np-shot-shallow').first.get_attribute('data-id') == 's1'
        assert '1 段还在抄文案' in page.evaluate('() => document.body.innerText'), '表尾要报到数'
        prompt_before = page.locator('.np-shot-pout').first.inner_text()
        assert MOTIF_A not in prompt_before and lib['cast'] not in prompt_before, '流派不进提示词尾巴（两条通道）'
        print('PASS: 抄文案的格子当场被查出（⚠️＋表尾报到数），重组过与太短的都不吵；这一派的用法是折叠块', flush=True)

        # ── 3) 回表加行那排流派 chip：悬浮也带三句，账号自加的那条跟内置同排摆出来（点了才铺，零 AI）──
        page.locator('#noteOutputContent .np-out-back').click()
        page.wait_for_function('() => _npMode === "task" && !!document.querySelector("#noteTaskContent .np-img-addopen")')
        page.locator('#noteTaskContent .np-img-addopen').click()
        page.wait_for_function('() => document.querySelectorAll("#noteTaskContent .np-img-add").length > 1')
        assert page.locator('#noteTaskContent .np-img-add').count() == 12, '内置 10 ＋ 账号自加 1 ＋「跟账号默认」'
        tip = page.locator('#noteTaskContent .np-img-add[data-k="%s"]' % MOTIF_A).get_attribute('title')
        assert '怎么把这段文案变成画面：' + lib['cast'] in tip and '这样算不合格：' + lib['forbid'] in tip, tip[:120]
        assert page.locator('#noteTaskContent .np-img-add[data-k="%s"]' % MOTIF_C).count() == 1, '自加的流派能当行身份挑'
        page.locator('#noteTaskContent .np-img-addclose').click()
        page.wait_for_function('() => !document.querySelector("#noteTaskContent .np-img-add")')
        assert sw.evaluate('self.aiCalls') == 0, '挑流派那排 chip 摆出来不该烧 AI'
        page.locator('#noteTaskContent .np-task-img').first.click()
        page.wait_for_function('() => _npMode === "out" && !!document.querySelector("#npImgTabs .np-imgtab")')
        page.locator('#npImgTabs .np-imgtab[data-t="desc"]').click()
        page.wait_for_function('() => document.querySelectorAll(".np-shot").length === 3')
        print('PASS: 流派 chip 的悬浮＝三句配方＋要什么料；自加的那条跟内置同一排（不点不烧 AI）', flush=True)

        # ── 4) 点 ⚠️ 只重出那一段：一发、一段、别的格子一个字不动 ──
        descs0 = page.evaluate('() => npS().shots.items.map(x => x.desc)')
        texts0 = page.evaluate('() => npS().shots.items.map(x => x.text)')
        page.locator('.np-shot-shallow').first.click()
        assert wait_calls(sw, 1), '点 ⚠️ 没打出那一发'
        t0 = time.time()
        while time.time() - t0 < 20:
            if page.evaluate('() => npS().shots.items[0].desc.indexOf("重组后") === 0'):
                break
            page.wait_for_timeout(300)
        assert sw.evaluate('self.aiCalls') == 1, '单段重出＝一发：%s' % sw.evaluate('self.aiCalls')
        one_user = sw.evaluate('self.descUsers[0]')
        assert one_user.count('本段（要写的就是它）：') == 1, '只该列那一段'
        assert one_user.count('—— 第 ') == 1 and '—— 第 1 张 / 共 3 张 ——' in one_user, '这一发只排了那一段的张位'
        assert S1 in one_user
        assert '前一段：（这就是第一张）' in one_user
        assert '后一段：' + S2 in one_user, '这一段后面接什么，AI 要看得见'
        assert ' '.join(BODY.split()) in one_user, '整篇原文要跟着过去'
        assert '配文方式：说一次（客户拨的档，不许改' in one_user, '每一段都带着它那一份配文档过去'
        descs1 = page.evaluate('() => npS().shots.items.map(x => x.desc)')
        assert descs1[0] == DEEP, descs1[0][:60]
        assert descs1[1:] == descs0[1:], '只重出那一段，另两格不动'
        cap0 = page.evaluate('() => npS().shots.items[0].cap || {}')
        assert cap0.get('big') == '两小时不用守着', 'AI 另写的那句大字该落进这一行：%s' % cap0
        assert cap0.get('lines') == ['三张表并成一份', '早上来收结果'], cap0
        assert 'mode' not in cap0 and page.evaluate('() => npCapModeOfItem(npS(), npS().shots.items[0])') == 'say', \
            '桩回的档是「整段上屏」，客户拨的是「说一次」——档不许被 AI 顶掉：%s' % cap0
        page.wait_for_function('() => !document.querySelector(".np-shot-shallow")')
        assert '还在抄文案' not in page.evaluate('() => document.body.innerText'), '表尾那句报到数也该跟着撤'
        assert page.evaluate('() => npS().shots.items.map(x => x.text)') == texts0, '段文本一个字没动'
        print('PASS: 点 ⚠️ 只重出那一段（一发·张位与前后段都带着·另两格不动·⚠️ 当场消失）', flush=True)

        # ── 5) 整表 🔁：三块写法 + 配文那一格 + 转译配方 + 反例 + 主次，全在那一发里 ──
        page.locator('#npShotTable .np-desc-regen').click()
        assert wait_calls(sw, 2), '🔁 没打出那一发'
        t0 = time.time()
        while time.time() - t0 < 20:
            if page.evaluate('() => npS().shots.items[2].desc.indexOf("重组后") === 0'):
                break
            page.wait_for_timeout(300)
        sys_d = sw.evaluate('self.descSystems[1]')
        for part in ('『这一张要证明』', '『画面里必须出现的元素』', '『背景』', '『先说清楚'):
            assert part in sys_d, '缺三块之一：%s' % part
        assert '『版式』' not in sys_d and '『多给的凭据』' not in sys_d, '字块与凭据已各自挪走，那一发不该再点名旧的两块'
        assert '字块留在哪儿不归你写' in sys_d, '字排哪儿归界面上那一档，别在分镜里再写一遍'
        assert '先想这段的结论靠什么一眼看得见' in sys_d, '那一发开头要先立「图替这段的结论举证」这条规矩'
        assert '别拿装饰凑' in sys_d, '补不出凭据要写「缺：××」，别拿装饰凑'
        assert '按 1. 2. 3. 逐条列、至少三条' in sys_d, '元素清单要逐条编号、数得出看得见的东西'
        assert '这就是……的凭据' in sys_d, '清单里至少一条自己带凭据'
        assert '这段没一字一字写' in sys_d
        assert '每段还要按它那一份「配文方式」给一份「配文」' in sys_d, '那一发还欠一份图上那套字'
        assert '这一档＝「说一次」' in sys_d, '整套默认那档的写法要展开给 AI 看'
        assert '"配文":{"档"' in sys_d, 'JSON 契约里没有配文那一格'
        assert '· 这段文案要变成这一派的什么料：' + lib['cast'] in sys_d, '转译配方没进那一发'
        assert '· 这样算不合格（这一派最常见的偷懒）：' + lib['forbid'] in sys_d, '反例没进那一发'
        assert '上面那句「这样算不合格」摆着的偷懒写法，一条都不许踩' in sys_d
        assert '第 1 张是这套的脸' in sys_d, '同一派里也要按张位分主次'
        assert '【本次画面流派】' + MOTIF_A in sys_d
        assert '这些是拿来判断这一张该往前推什么、怎么不跟邻张重样的，不是拿来抄进分镜的' in sys_d
        user_d = sw.evaluate('self.descUsers[1]')
        assert user_d.count('本段（要写的就是它）：') == 3
        assert '—— 第 3 张 / 共 3 张 ——' in user_d and '后一段：（这就是最后一张）' in user_d
        assert '【整篇原文' in user_d
        assert all(d == DEEP for d in page.evaluate('() => npS().shots.items.map(x => x.desc)'))
        prompt_after = page.locator('.np-shot-pout').first.inner_text()
        assert '【这一张要证明】这张站稳不用人守着' in prompt_after, '分镜变了，本地提示词当场按三块重排：%s' % prompt_after[:300]
        assert '【画面里必须出现的元素，逐条都要拍到】' in prompt_after and '1. 一双手离开键盘' in prompt_after, prompt_after[:300]
        assert '【背景】晚上家里书桌' in prompt_after, '『背景』单独成块：' + prompt_after[prompt_after.index('【背景】'):prompt_after.index('【背景】') + 120]
        assert '【先说清楚】' in prompt_after and '别把「结果」画成奖杯' in prompt_after, '那一行歧义堵句要进提示词'
        assert '一个字都不要写上屏' in prompt_after, '那几行是定画面的说明，得当场标明别上屏（实测 P2/P3 就是把那句抄成了页边标题）'
        assert '这一张画面上是：' not in prompt_after, '不再整份塞进那一行'
        assert '【图上就这些字：说一次】大字「两小时不用守着」' in prompt_after, '配文那一份接在画面说明后面'
        assert '句子里最要害的那几个字＝「不用守着」' in prompt_after and '字排在压在右边暗角' in prompt_after, prompt_after[-320:]
        assert '【配色与层级' in prompt_after and '#F5A623' in prompt_after, '整套共用的配色与层级进了尾巴'
        assert '【通则】' in prompt_after, '道具字与数字那条通则进了尾巴'
        for leak in (MOTIF_A, lib['cast'], lib['forbid']):
            assert leak not in prompt_after, '流派那两句又漏进提示词尾巴了'
        print('PASS: 🔁 那一发拿到整篇＋张位＋前后段＋配文档，写法定三块、带转译配方与反例（3 段一批一发）；本地提示词三块＋配文＋配色分层', flush=True)

        # ── 6) 换流派（① 风格那档的 chip）：零 AI 只记新派；自加的那条 cast/forbid 也照样进那一发 ──
        page.locator('#npImgTabs .np-imgtab[data-t="look"]').click()
        page.wait_for_function('() => !!document.querySelector("#npLookBox")')
        page.locator('#npLookBox .np-motif[data-k="%s"]' % MOTIF_C).click()
        page.wait_for_function('() => npLookOf(npS()).motif === "%s"' % MOTIF_C)
        assert sw.evaluate('self.aiCalls') == 2, '换流派不该烧 AI：%s' % sw.evaluate('self.aiCalls')
        page.locator('#npImgTabs .np-imgtab[data-t="desc"]').click()
        page.wait_for_function('() => document.querySelectorAll(".np-shot").length === 3')
        assert page.locator('.np-shot-pout').first.inner_text() == prompt_after, '换派不重排提示词（两条通道）'
        page.locator('#npShotTable .np-desc-regen').click()
        assert wait_calls(sw, 3), '自加流派的 🔁 没打出去'
        sys_c = sw.evaluate('self.descSystems[2]')
        assert '【本次画面流派】' + MOTIF_C in sys_c
        assert CUSTOM['cast'] in sys_c and CUSTOM['forbid'] in sys_c, '自加那条的三句配方没进那一发'
        assert '· 长什么样：' + CUSTOM['take'] in sys_c
        print('PASS: 账号自加的流派跟内置同一条通路——三句配方照样喂 AI，提示词尾巴依旧不碰', flush=True)

        # ── 7) 落档：重组过的分镜跟着这一行写回档案，再进来读得回 ──
        got = None
        t0 = time.time()
        while time.time() - t0 < 15:
            got = next((x for x in page.evaluate(NOTES) if x and x.get('id') == 'deep-1'), None)
            if got and (got.get('imgDocs') or [{}])[0].get('shots'):
                break
            page.wait_for_timeout(300)
        row = (got or {}).get('imgDocs', [{}])[0]
        assert row.get('shots', {}).get('look', {}).get('motif') == MOTIF_C, '新派随这一行落档'
        assert row['shots']['items'][0]['desc'] == DEEP, '重组过的分镜要落得回档'
        print('PASS: 流派与重组后的分镜随这一行落档', flush=True)

        assert sw.evaluate('self.otherCalls') == 0, '冒出了没料到的 AI 调用：%s 发' % sw.evaluate('self.otherCalls')
        page.screenshot(path=str(OUT / 'xhs-desc-deep.png'))
        print('SHOT: %s' % (OUT / 'xhs-desc-deep.png'), flush=True)
        assert not ERRORS, '有 pageerror：%s' % ERRORS[:2]
        print('PASS: 无 pageerror', flush=True)
    finally:
        ctx.close()

print('\n全绿：分镜按流派重组（三句配方 → 整篇＋张位＋前后段＋配文档 → 三块写法 → 零 AI 查抄文案 · 五十六改立、六十二改对齐三块＋配文）', flush=True)
