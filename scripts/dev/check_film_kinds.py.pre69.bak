# -*- coding: utf-8 -*-
"""出片台「一档一个成片形式」自检（老板 2026-10-02 五十九改：档案入口收成一颗「出片台」，造图片整页重做成四档）。

这一条改到「出片台」那张任务表上跑——入口＝直开 switchMainTab('noteTask', 那一篇)（＝档案那一行「下一步」走的那条通路；档案操作列现在只有一颗「下一步」，逐篇进）：
拉到那张表 → 表上「＋ 一片」挑成片形式加一行 → 点那一行的「🎬 出片」才进台子。成片形式的「六选一」盖板留在台子里，靠顶上「✏️ 换一种」重开。
（按画面表铺底图 / 段模型那条口径在 check_film_cards.py 里也验一份；这里验形式状态机本身。）

跑法：python3 -X utf8 scripts/dev/check_film_kinds.py
临时 profile 加载真扩展（msedge），AiClient 全程走桩——这一条链一次 AI 都不该打。
  1) 出片台表：给这一篇「＋ 一片」挑「PPT字体动效」→ 点那行「🎬 出片」进台子：带的是这一篇的稿（口播稿＝正文同文），
     当场分好幕、大字画面、Film.noteId＝档案 id；顶上「← 渲染任务」回表那行还在
  2) 台子里「✏️ 换一种」→ 六选一盖板重开（两种本机出片 + 四种扩展给料），台子盖住不许接稿
  3) 选「实拍」（不在本机出片）→ 那一档一页：整段文案只读 + 复制 + 看教程 + 换一种；filmKind 落档、不派生卡片口径、文案没被改写
  4) 再「换一种」→「卡片画面叙事」：台子露出来、画面切卡片、bar 记着这一档；这一步只换形式，不许偷偷改稿
  5) 纯编辑器段模型：一行＝一段底图，长行自动切成多幕共用同图；off 过场行 / 没传回图的行 → 纯色卡
"""
import base64
import io
import json
import os
import pathlib
import shutil
import sys
import time

from PIL import Image
from playwright.sync_api import expect, sync_playwright

try:
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')
except Exception:
    pass

ROOT = pathlib.Path(__file__).resolve().parents[2]
EXT = ROOT / 'extension'
OUT = pathlib.Path(os.environ.get('TEMP', '/tmp')) / 'xhs_film_kinds'
OUT.mkdir(parents=True, exist_ok=True)

BODY = '开场钩子。\n\n第一段干货。\n\n第二段干货。\n\n结尾引导。'
VOICE = '一个人做小红书。\n真正管用的就三步。\n私信我，免费测评。'
KIND_TEXT = 'PPT字体动效'
KIND_CARD = '卡片画面叙事'
KIND_LIVE = '实拍'

COLORS = {'a1': (220, 40, 40), 'a2': (40, 200, 60), 'a3': (40, 80, 220)}


def _png(color, size=(160, 120)):
    buf = io.BytesIO()
    Image.new('RGB', size, color).save(buf, 'PNG')
    return 'data:image/png;base64,' + base64.b64encode(buf.getvalue()).decode()


SEED = r'''async (payload) => {
    await Storage.initializeDefaults(DEFAULT_PROMPTS);
    await ensureTenantInit();
    const cfg = await Storage.getConfig();
    cfg.product.name = '成片形式测试产品';
    cfg.product.sellPoints = [{title: '省时间', content: '把重复步骤压掉'}];
    cfg.ai.apiKey = 'test-local-only';
    await Storage.setConfig(cfg);
    // 这一篇的画面表：三行、按号分别传回过 a1 / a2 / a3（卡片画面叙事要照它把第 N 段安第 N 张图）
    const shots = { style: '浅色底 + 大字卡片', cover: '', seed: '', items: [
        { id: 's1', text: '第一句画面。', desc: '中心思想：钩子', off: false, imgs: ['a1'] },
        { id: 's2', text: '第二句画面。', desc: '中心思想：第一个动作', off: false, imgs: ['a2'] },
        { id: 's3', text: '第三句画面。', desc: '中心思想：第二个动作', off: false, imgs: ['a3'] },
    ] };
    await chrome.storage.local.set({
        np_notes: [
            { id: 'film-1', title: '省时间三步', status: '待发', platform: 'xhs', form: '图文',
              draft: payload.body, voice: payload.voice,
              shots: shots, imgDocs: [{ id: 'r1', pid: 'xhs', style: '',
                                        shots: shots, visual: null, updatedAt: Date.now() }],
              createdAt: Date.now(), updatedAt: Date.now() },
        ],
        np_assets: [],
        xhsFilmDocs: {},
    });
    self.aiCalls = 0;
    AiClient.chatCompletion = async () => { self.aiCalls++; return { content: '{}' }; };
    return true;
}'''


def boot(p):
    """起浏览器 + 装真扩展（playwright 默认的 --disable-extensions 会跟 --load-extension 撞，摘掉；每趟全新档）"""
    for i in range(5):
        prof = OUT / ('profile%d' % i)
        shutil.rmtree(prof, ignore_errors=True)
        ctx = p.chromium.launch_persistent_context(
            str(prof), headless=False, channel='msedge',
            ignore_default_args=['--disable-extensions'],
            args=[f'--disable-extensions-except={EXT}', f'--load-extension={EXT}'])
        t0 = time.time()
        while time.time() - t0 < 25 and not ctx.service_workers:
            time.sleep(0.3)
        if ctx.service_workers:
            return ctx
        print('  扩展没装起来（第 %d 趟），重来' % (i + 1), flush=True)
        ctx.close()
    raise RuntimeError('扩展装不上：连试 5 趟都没有 service worker')


def wait_toast(page, needle, timeout=8.0):
    """等一条含 needle 的提示（toast 会自己消失，只能守着看）"""
    t0 = time.time()
    last = ''
    while time.time() - t0 < timeout:
        last = page.locator('#popToastBox').inner_text()
        if needle in last:
            return last
        page.wait_for_timeout(120)
    return last


with sync_playwright() as p:
    ctx = boot(p)
    sw = ctx.service_workers[0]
    assert sw.evaluate('chrome.runtime.onMessage.hasListeners()'), '后台路由没注册上'
    sw.evaluate(SEED, {'body': BODY, 'voice': VOICE})
    eid = sw.url.split('/')[2]

    errs = []
    page = ctx.new_page()
    page.set_default_timeout(20000)
    page.on('pageerror', lambda e: errs.append(str(e)))
    page.on('dialog', lambda d: d.accept())
    page.goto(f'chrome-extension://{eid}/popup.html?mode=big')
    page.wait_for_function('typeof switchMainTab === "function" && typeof npGoFilm === "function" '
                           '&& typeof npTaskListHtml === "function"')
    if page.locator('#fsClose').is_visible():
        page.locator('#fsClose').click()

    def open_table(ar_id='film-1'):
        """出片台那张任务表：直开这一篇（switchMainTab('noteTask', 那一篇)——档案行里那颗「下一步」走的也是这条）。
        表是异步画的（npOpenTask → npTaskPaint）：得等这一篇真上台（arId 换成它 ＋ 加行区露出来）再往下走，
        不然 «#noteTaskContent» 这个节点空壳也在 DOM 里，弱等待会当场放行、后面全打在没画完的表上。"""
        page.evaluate('''async (id) => {
            const list = await npNotesAll();
            const n = list.find(x => x && x.id === id) || null;
            switchMainTab('noteTask', n);
        }''', ar_id)
        page.wait_for_function('''() => _npMode === "task" && !!npS() && String(npS().arId) === '%s'
            && !!document.querySelector("#noteTaskContent .np-task-filmopen, #noteTaskContent .np-task-kind")''' % ar_id)

    def add_film(kind):
        """表上「＋ 一片」挑这一种成片形式加一行（零 AI），返回那一行的 id"""
        page.wait_for_function('() => !!document.querySelector("#noteTaskContent .np-task-filmopen, #noteTaskContent .np-task-kind")')
        if page.locator('#noteTaskContent .np-task-filmopen').count():
            page.locator('#noteTaskContent .np-task-filmopen').click()
        page.wait_for_function('() => document.querySelectorAll("#noteTaskContent .np-task-kind").length === 6')
        page.locator('#noteTaskContent .np-task-kind[data-k="%s"]' % kind).click()
        page.wait_for_function('(k) => (npS().filmDocs || []).some(x => x && x.kind === k)', arg=kind)
        return page.evaluate('(k) => (npS().filmDocs || []).find(x => x && x.kind === k).id', kind)

    def open_film_row(rid):
        page.locator('#noteTaskContent .np-task-film[data-id="%s"]' % rid).click()

    def gate_hidden():
        return page.evaluate('() => document.getElementById("filmGate").style.display === "none"')
    def film_state():
        return page.evaluate('''() => {
            const f = document.getElementById('filmFrame');
            const F = f && f.contentWindow && f.contentWindow.Film;
            if (!F) return null;
            return { noteId: String(F.noteId || ''), frame: String((F.cfg || {}).frame || ''),
                     scenes: (F.scenes || []).length, script: String(F.script || ''),
                     cards: (F.scenes || []).map(s => String((s.card || {}).id || '')) };
        }''')

    def rec():
        return page.evaluate('''async () => {
            const d = await chrome.storage.local.get('np_notes');
            const n = (d.np_notes || []).find(x => x && x.id === 'film-1') || {};
            return { filmKind: n.filmKind || '', style: n.style || '', form: n.form || '', voice: n.voice || '' };
        }''')

    def wait_rec(cond, timeout=15.0):
        t0 = time.time()
        r = rec()
        while time.time() - t0 < timeout and not cond(r):
            page.wait_for_timeout(300)
            r = rec()
        return r

    # ── 1) 表上加一行「PPT字体动效」→ 点出片进台子：带这一篇的稿、当场分幕、大字画面 ──
    open_table()
    rid = add_film(KIND_TEXT)
    row = page.locator('#noteTaskContent .np-task-film[data-id="%s"]' % rid).locator('xpath=ancestor::tr').inner_text().replace(' ', '')
    assert '还没分幕' in row and 'PPT字体动效' in row, ('字体动效有正文＝缺口是「还没分幕」（不再误报缺稿）', row)
    assert page.locator('#noteTaskContent .np-task-film[data-id="%s"]' % rid).evaluate('el => getComputedStyle(el).opacity') == '1', \
        '有正文的字体动效那颗出片是亮的'
    open_film_row(rid)
    page.wait_for_function('() => document.getElementById("filmGate").style.display === "none"')
    page.wait_for_function('''(id) => {
        const f = document.getElementById('filmFrame');
        const F = f && f.contentWindow && f.contentWindow.Film;
        return !!(F && F.noteId === id && F.scenes.length);
    }''', arg='film-1', timeout=30000)
    st1 = film_state()
    assert st1['noteId'] == 'film-1', '主行 key＝档案 id：%s' % st1
    assert st1['script'] == VOICE, '台子念的是这一篇的口播稿（正文同文那份）：%r' % st1['script']
    assert st1['frame'] == 'text' and st1['scenes'] >= 2, st1
    expect(page.locator('#filmBar')).to_contain_text(KIND_TEXT)
    assert sw.evaluate('self.aiCalls') == 0, '进台子这一趟一次 AI 都不该打：%s' % sw.evaluate('self.aiCalls')
    print('PASS: 表上「＋ 一片」（字体动效）→「🎬 出片」进台子：带这一篇的稿、当场分 %d 幕、大字画面（缺口＝「还没分幕」不误报缺稿）'
          % st1['scenes'], flush=True)

    # ── 2) 台子里「✏️ 换一种」→ 六选一盖板重开（2 本机 + 4 给料），台子盖住 ─────────
    page.locator('#filmBar .np-kind-change').click()
    page.wait_for_function('() => getComputedStyle(document.getElementById("filmGate")).display === "block"')
    picks = page.locator('#filmGate .np-kind-pick')
    assert picks.count() == 6, '换一种该重摆六种成片形式：%d' % picks.count()
    txt = [picks.nth(i).inner_text() for i in range(6)]
    local = [i for i in range(6) if '在这台电脑上出片' in txt[i]]
    off = [i for i in range(6) if '扩展给料' in txt[i]]
    assert sorted(local) == [0, 1] and len(off) == 4, (local, off)
    assert KIND_TEXT in txt[0] and KIND_CARD in txt[1], txt[:2]
    assert page.locator('#filmBar').evaluate('el => getComputedStyle(el).display') == 'none', '重选时别露台子'
    print('PASS: 「✏️ 换一种」→ 盖板六张卡重开（%d 项本机出片 + %d 项扩展给料）' % (len(local), len(off)), flush=True)

    # ── 3) 选「实拍」（不在本机出片）→ 那一档一页；filmKind 落档、文案不动 ───────────
    page.evaluate('() => { const b = document.getElementById("popToastBox"); if (b) b.innerHTML = ""; }')
    page.locator('#filmGate .np-kind-pick[data-k="%s"]' % KIND_LIVE).click()
    page.wait_for_function('() => !!document.querySelector("#filmGate .np-film-copy")')
    assert page.locator('#filmGate .np-film-guide').count() == 1 and page.locator('#filmGate .np-kind-change').count() == 1
    assert page.locator('#filmGate textarea').input_value() == VOICE, '只读那格该是这一篇现在那格文案'
    assert page.locator('#filmBar').evaluate('el => getComputedStyle(el).display') == 'none', '不在本机出片就别露台子'
    r3 = wait_rec(lambda r: r['filmKind'] == KIND_LIVE)
    assert r3['filmKind'] == KIND_LIVE, '成片形式要落进这一篇的档案档：%s' % r3
    assert r3['style'] != '卡片轮播口播', '实拍不派生卡片口径：%s' % r3
    assert r3['voice'] == VOICE, '选形式不许改写那格文案：%r' % r3['voice']
    assert sw.evaluate('self.aiCalls') == 0, '换到实拍这一发不烧 AI：%s' % sw.evaluate('self.aiCalls')
    print('PASS: 「换一种」→ 实拍（不在本机出片）：那一档一页（文案只读 + 复制 + 教程 + 换一种），filmKind 落档、文案没被改写', flush=True)

    # ── 4) 再换一种 → 卡片画面叙事：台子露出、画面切卡片、文案不许偷偷改写 ────────────
    page.locator('#filmGate .np-kind-change').click()
    page.wait_for_function('() => document.querySelectorAll("#filmGate .np-kind-pick").length === 6')
    page.evaluate('() => { const b = document.getElementById("popToastBox"); if (b) b.innerHTML = ""; }')
    page.locator('#filmGate .np-kind-pick[data-k="%s"]' % KIND_CARD).click()
    page.wait_for_function('''() => {
        const g = document.getElementById('filmGate'), b = document.getElementById('filmBar');
        return getComputedStyle(g).display === 'none' && getComputedStyle(b).display === 'flex';
    }''')
    page.wait_for_function('''() => {
        const f = document.getElementById('filmFrame');
        const F = f && f.contentWindow && f.contentWindow.Film;
        return !!(F && F.cfg.frame === 'card' && F.scenes.length);
    }''', timeout=30000)
    st4 = film_state()
    assert st4['frame'] == 'card' and st4['scenes'] >= 2, st4
    assert st4['script'] == VOICE, '换形式不许顺手改写那格文案：%r' % st4['script']
    bar = page.locator('#filmBar').inner_text()
    assert KIND_CARD in bar and '换一种' in bar, bar
    assert '口播稿还是按' in wait_toast(page, '口播稿还是按'), '换形式该提示稿子还是旧口径那份'
    r4 = wait_rec(lambda r: r['filmKind'] == KIND_CARD)
    assert r4['filmKind'] == KIND_CARD, '成片形式要落进这一篇的档案档：%s' % r4
    assert sw.evaluate('self.aiCalls') == 0, '换到卡片这一发不烧 AI：%s' % sw.evaluate('self.aiCalls')
    print('PASS: 「✏️ 换一种」→ 卡片画面叙事：台子露出 + 画面切卡片 + bar 记着这一档，文案没被改写（只提示去哪改）', flush=True)

    # ── 5) 顶上「← 出片台」回那张表：这一行（现在是卡片）还在 ─────────────────────────
    page.locator('#filmBar .np-film-task').click()
    page.wait_for_function('() => _npMode === "task" && !!document.querySelector("#noteTaskContent .np-task-film")')
    back = page.locator('#noteTaskContent .np-task-film[data-id="%s"]' % rid).locator('xpath=ancestor::tr').inner_text().replace(' ', '')
    assert KIND_CARD in back, '回表这一行跟着换成卡片画面叙事：%s' % back
    print('PASS: 台子顶上那颗「← 渲染任务」回那张表，这一行还在（成片形式跟着这一行变成了卡片画面叙事）', flush=True)

    # ── 6) 纯编辑器段模型：一行＝一段底图，长行切成多幕共用同图；off / 没传回图的行 → 纯色卡 ─
    # 重新进台子拿一个就绪的 video.html frame
    open_film_row(rid)
    page.wait_for_function('''() => {
        const f = document.getElementById('filmFrame');
        const F = f && f.contentWindow && f.contentWindow.Film;
        return !!(F && F.cfg.frame === 'card' && F.scenes.length);
    }''', timeout=30000)
    vf = [f for f in page.frames if 'video.html' in f.url][0]
    # 素材库备好 a1/a2/a3 三张本机图（段模型里 x1 安 a1、x4 安 a3，才量得出 cardImg）
    page.evaluate('''async (rows) => {
        await chrome.storage.local.set({ np_assets: rows.map(r => ({
            id: r[0], kind: 'local', ref: r[0] + '.png', name: r[0] + '.png',
            thumb: r[1], w: 900, h: 1600, needId: 'n1', addedAt: Date.now(),
        }))});
    }''', [['a1', _png(COLORS['a1'])], ['a2', _png(COLORS['a2'])], ['a3', _png(COLORS['a3'])]])
    rows7 = [
        {'rowId': 'x1', 'no': 1, 'off': False, 'assetIds': ['a1'],
         'text': '第一行的话很长很长：先把痛点讲透，再说到做法，一句一句接得住人，别在没人看的地方使劲。'},
        {'rowId': 'x2', 'no': 0, 'off': True, 'assetIds': [],
         'text': '这是一句过场话，占一幕念出来配纯色卡。'},
        {'rowId': 'x3', 'no': 2, 'off': False, 'assetIds': [],
         'text': '第三行还没传回图，先空着走纯色卡。'},
        {'rowId': 'x4', 'no': 3, 'off': False, 'assetIds': ['a3'],
         'text': '收口一句，私信我测评。'},
    ]
    vf.evaluate("""(a) => Film.loadNote({ id: 'seg-model', title: '段模型', script: '占位稿', frame: 'card', shots: a })""", rows7)
    vf.wait_for_function("""() => { const F = Film;
        return F.noteId === 'seg-model' && F.scenes.length && F.scenes[0].cardImg; }""", timeout=20000)
    seg = vf.evaluate("""() => ({
        scenes: Film.scenes.length,
        keys: Film.scenes.map(s => s.cardKey),
        ids: Film.scenes.map(s => String((s.card || {}).id || '')),
        runs: Film.cardRuns().length,
    })""")
    x1 = [i for i, k in enumerate(seg['keys']) if k == 'shot:x1']
    x2 = [i for i, k in enumerate(seg['keys']) if k == 'shot:x2']
    x3 = [i for i, k in enumerate(seg['keys']) if k == 'shot:x3']
    x4 = [i for i, k in enumerate(seg['keys']) if k == 'shot:x4']
    assert len(x1) >= 2, ('第一行的长话自动切成多幕（做字幕特效）', seg)
    assert all(seg['ids'][i] == 'a1' for i in x1), ('一行＝一段底图：切出的多幕共用同一张图', seg)
    assert seg['scenes'] > len(rows7), ('幕数 > 行数：不是老的「一行一幕」', seg['scenes'], len(rows7))
    assert x2 and all(seg['ids'][i] == '' for i in x2), ('off 过场句占一幕、走纯色卡', seg)
    assert x3 and all(seg['ids'][i] == '' for i in x3), ('没传回图的行走纯色卡（不再退回按素材库顺序铺）', seg)
    assert len(x4) == 1 and seg['ids'][x4[0]] == 'a3', ('按行传回的图安到该段', seg)
    assert seg['runs'] == 4, ('四行＝四段', seg)
    print('PASS: 画面表段模型：长行切 %d 幕共用 a1、off/没传图的行纯色卡、收口行按号安 a3（%d 段）' % (len(x1), seg['runs']), flush=True)

    assert sw.evaluate('self.aiCalls') == 0, '整条链零 AI：%s' % sw.evaluate('self.aiCalls')
    assert not errs, '页面报错：%s' % errs[:3]
    shot = OUT / 'film-kinds.png'
    page.screenshot(path=str(shot))
    print('PASS: 无 pageerror', flush=True)
    print('SCREENSHOT:', shot, flush=True)
    print('\n全绿：出片台一档一个成片形式（表上＋一片 → 台子带稿分幕 → 换一种 6 选 1 → 实拍不本机单页 → 卡片画面叙事 → 段模型）', flush=True)
    ctx.close()
