// ============================================================
// 小红书评论助手 — Popup v6（独立插件版，无需后台服务）
// 功能：提取评论 → AI挖掘潜在客户 → 生成话术 → 发送回复
// ============================================================
'use strict';

// 本会话内是否已完成账号绑定验证（成功即置位，防止后续轮询重新弹验证遮罩）
let _acctVerifiedInSession = false;

// ========== 窗口形态 ==========
const urlParams = new URLSearchParams(window.location.search);
const TARGET_TAB_ID = parseInt(urlParams.get('tabId')) || null;
const MODE_BIG = urlParams.get('mode') === 'big'; // 大窗（带框总览）
// body 标记窗口形态：big=大窗总览 / small=小窗分步
if (document.body) {
  document.body.setAttribute('data-mode', MODE_BIG ? 'big' : 'small');
}
// 独立窗口（由 background 用 ?tabId= 打开）→ 标记 body，应用无边框面板样式
if (TARGET_TAB_ID && document.body) {
  document.body.setAttribute('data-standalone', '1');
}

/** 获取要操作的小红书标签页（优先用窗口传入的 tabId，后备查询 activeTab） */
async function getTargetTab() {
  if (TARGET_TAB_ID) {
    try {
      const tab = await chrome.tabs.get(TARGET_TAB_ID);
      if (tab && tab.url && tab.url.includes('xiaohongshu.com')) return tab;
    } catch (_) {}
  }
  // ★ 小窗/无 tabId：优先取当前聚焦的小红书标签页（保证 openNote 后能切到笔记评论）
  const xhsTabs = await chrome.tabs.query({ url: '*://www.xiaohongshu.com/*' });
  const active = xhsTabs.find(t => t.active);
  if (active && active.id != null) return active;
  if (xhsTabs && xhsTabs.length > 0) return xhsTabs[0];
  const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
  return tab;
}

let pageData = null;
let kbImages = []; // 知识库匹配的图片

/* ========== 敏感数据读写：落盘为密文，页面里统一走这两个口子拿到明文 ========== */
/** 读敏感 key（knowledge_base / prospect_list / watering_logs / replied_comments …）的明文 */
async function readPlain(key) {
  const d = await chrome.storage.local.get(key);
  if (typeof DataPrivacy === 'undefined') return d[key];
  return DataPrivacy.unlock(key, d[key]);
}
/** 写敏感 key（自动加密落盘） */
async function writePlain(key, value) {
  const v = (typeof DataPrivacy !== 'undefined' && value !== undefined && value !== null)
    ? await DataPrivacy.lock(key, value) : value;
  await chrome.storage.local.set({ [key]: v });
}
/** 读 config 明文（AI Key 等字段自动解密） */
async function readConfigPlain() {
  const d = await chrome.storage.local.get('config');
  const cfg = (d && d.config) || {};
  return (typeof DataPrivacy === 'undefined') ? cfg : DataPrivacy.unlockConfig(cfg);
}
/** 写 config（AI Key 等字段自动加密落盘） */
async function writeConfigPlain(cfg) {
  const v = (typeof DataPrivacy === 'undefined') ? cfg : await DataPrivacy.lockConfig(cfg);
  await chrome.storage.local.set({ config: v, wizard_done: Date.now() });
}

// ========== 本地回复记录管理（chrome.storage.local） ==========
const REPLIED_KEY = 'replied_comments';

// ========== 评论记录（今天灌了多少、灌了哪些评论/话术，最多保留 500 条） ==========
const WATER_LOGS_KEY = 'watering_logs';
const WATER_LOGS_LIMIT = 500;

/** 读取全部灌水明细（新→旧） */
async function getWaterLogs() {
  try {
    const logs = (await readPlain(WATER_LOGS_KEY)) || [];
    return Array.isArray(logs) ? logs : [];
  } catch (_) { return []; }
}

/** 追加一条灌水明细（新记录在最前，超出上限裁剪最旧） */
async function addWaterLog(entry) {
  try {
    const logs = await getWaterLogs();
    logs.unshift({ ...entry, ts: Date.now() });
    if (logs.length > WATER_LOGS_LIMIT) logs.length = WATER_LOGS_LIMIT;
    await writePlain(WATER_LOGS_KEY, logs);
  } catch (_) {}
}

/** 清空灌水明细 */
async function clearWaterLogs() {
  try { await writePlain(WATER_LOGS_KEY, []); } catch (_) {}
}

/** 本地日期 YYYY-MM-DD（不用 toISOString，避免 UTC 时区差一天） */
function _localDateStr(ts) {
  const d = new Date(ts);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}

/** 💧 评论记录：今天/本周/累计统计 + 按天分组明细（时间/笔记/评论/话术）——渲染进传入容器（笔记池页尾的折叠块） */
async function renderWaterSummary(container) {
  const logs = await getWaterLogs();
  const now = new Date();
  const todayStr = _localDateStr(now.getTime());
  const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - ((now.getDay() + 6) % 7)).getTime(); // 本周一 00:00
  let today = 0, week = 0;
  const groups = new Map();
  for (const l of logs) {
    if (_localDateStr(l.ts) === todayStr) today++;
    if (l.ts >= weekStart) week++;
    const day = _localDateStr(l.ts);
    if (!groups.has(day)) groups.set(day, []);
    groups.get(day).push(l);
  }

  let listHtml = '';
  if (logs.length === 0) {
    listHtml = '<div style="text-align:center;color:#999;padding:30px 0;font-size:12px;">还没有评论记录<br><span style="font-size:11px;">发送第一条回复后，会在这里显示：今天灌了多少、灌了哪些评论和话术</span></div>';
  }
  for (const [day, items] of groups) {
    const d = new Date(day + 'T00:00:00');
    const dayLabel = day === todayStr ? '今天' : (d.getMonth() + 1) + '月' + d.getDate() + '日';
    listHtml += `<div style="margin:12px 0 6px;font-weight:600;color:#374151;font-size:12px;">📅 ${dayLabel}（${items.length} 条）</div>`;
    items.forEach((l, idx) => {
      const time = new Date(l.ts).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      const srcTag = l.source === 'batch' ? '<span style="color:#7c3aed;">批量</span>' : '<span style="color:#059669;">逐条</span>';
      const commentSnippet = String(l.comment || '');
      listHtml += `
      <div style="border:1px solid #e5e7eb;border-radius:6px;padding:8px 10px;margin-bottom:8px;background:#fff;font-size:11px;line-height:1.6;">
        <div style="display:flex;justify-content:space-between;gap:8px;">
          <span style="font-weight:600;color:#1f2937;word-break:break-all;">${esc(l.noteTitle || '（无标题）')}</span>
          <span style="color:#999;white-space:nowrap;">${time} ${srcTag}</span>
        </div>
        <div style="color:#6b7280;margin-top:2px;">@${esc(l.author || '匿名')} 的评论：${esc(commentSnippet.slice(0, 80))}${commentSnippet.length > 80 ? '…' : ''}</div>
        <div style="color:#333;margin-top:2px;background:#f9fafb;border-radius:4px;padding:4px 6px;">💬 ${esc(l.replyText || '（无话术内容）')}</div>
        <div style="margin-top:4px;text-align:right;">
          <button class="copy-log-btn" data-log-idx="${idx}" style="font-size:10px;padding:1px 8px;background:#f0f0f0;border:1px solid #ddd;border-radius:3px;cursor:pointer;">复制话术</button>
        </div>
      </div>`;
    });
  }

  if (!container) return;
  container.innerHTML = `
    <div style="padding:6px 2px;">
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;margin:6px 0 12px;">
        <button id="wsClearBtn" style="padding:5px 12px;font-size:11px;cursor:pointer;background:#fff;color:#d32f2f;border:1px solid #f0c2c2;border-radius:8px;">🗑 清空记录</button>
        <button id="wsRefreshBtn" style="padding:5px 12px;font-size:11px;cursor:pointer;background:var(--primary-bg);color:var(--primary);border:1px solid #cfe3fb;border-radius:8px;font-weight:600;">🔄 刷新</button>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
        <div style="flex:1;min-width:110px;background:var(--green-bg);border-radius:10px;padding:14px;text-align:center;"><div style="font-size:26px;font-weight:700;color:var(--green);">${today}</div><div style="font-size:11px;color:#666;">今天</div></div>
        <div style="flex:1;min-width:110px;background:var(--amber-bg);border-radius:10px;padding:14px;text-align:center;"><div style="font-size:26px;font-weight:700;color:var(--amber);">${week}</div><div style="font-size:11px;color:#666;">本周</div></div>
        <div style="flex:1;min-width:110px;background:var(--primary-bg);border-radius:10px;padding:14px;text-align:center;"><div style="font-size:26px;font-weight:700;color:var(--primary);">${logs.length}</div><div style="font-size:11px;color:#666;">累计</div></div>
      </div>
      <div style="font-size:11px;line-height:1.6;">${listHtml}</div>
    </div>`;

  container.querySelector('#wsRefreshBtn').onclick = () => renderWaterSummary(container);
  container.querySelector('#wsClearBtn').onclick = async () => {
    if (!confirm('确定清空全部评论记录？此操作不可恢复。')) return;
    await clearWaterLogs();
    renderWaterSummary(container);
  };
  // 复制话术（事件委托）
  container.querySelectorAll('.copy-log-btn').forEach(btn => {
    btn.onclick = () => {
      const log = logs[parseInt(btn.dataset.logIdx)];
      if (!log) return;
      navigator.clipboard.writeText(log.replyText || '').then(() => {
        btn.textContent = '已复制 ✓';
        setTimeout(() => { btn.textContent = '复制话术'; }, 1200);
      }).catch(() => {});
    };
  });
}

// ========== 灌水历史（auto_water_history：{noteId: {title,url,status,wateredAt}}，笔记池页尾折叠块用） ==========
const AW_HIST_STATUS = { success: '✅ 成功', failed: '❌ 失败', no_prospect: '⚠️ 无商机' };

/** 读取灌水历史（解密；拿不到当空） */
async function getWaterHistory() {
  try {
    const h = await readPlain('auto_water_history');
    return (h && typeof h === 'object' && !Array.isArray(h)) ? h : {};
  } catch (_) { return {}; }
}

/** 折叠块摘要用：共几条 / 今天几条 */
async function waterHistoryCountLabel() {
  const entries = Object.entries(await getWaterHistory());
  if (!entries.length) return '还没有记录';
  const t0 = new Date(); t0.setHours(0, 0, 0, 0);
  const today = entries.filter(([, r]) => Number((r || {}).wateredAt) >= t0.getTime()).length;
  return `今天 ${today} 篇 · 共 ${entries.length} 篇`;
}

/** 💧 灌水历史：按最后灌水时间倒序（标题/结果/时间），最多 100 条——渲染进传入容器 */
async function renderWaterHistory(container) {
  if (!container) return;
  const entries = Object.entries(await getWaterHistory()).sort((a, b) => ((b[1] || {}).wateredAt || 0) - ((a[1] || {}).wateredAt || 0));
  const rows = entries.slice(0, 100).map(([noteId, rec]) => {
    const r = rec || {};
    const time = r.wateredAt ? new Date(r.wateredAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—';
    return `<div style="display:flex;align-items:center;gap:8px;border:1px solid #e5e7eb;border-radius:6px;padding:6px 10px;margin-bottom:6px;background:#fff;font-size:11px;line-height:1.6;">
      <span style="flex:1;min-width:0;word-break:break-all;color:#1f2937;" title="${esc(r.url || '')}">${esc(String(r.title || noteId))}</span>
      <span style="white-space:nowrap;color:#555;">${esc(AW_HIST_STATUS[r.status] || r.status || '—')}</span>
      <span style="white-space:nowrap;color:#9ca3af;">${time}</span>
    </div>`;
  }).join('');

  container.innerHTML = `
    <div style="padding:6px 2px;">
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;margin:6px 0 10px;">
        <button id="awHistClearBtn" style="padding:5px 12px;font-size:11px;cursor:pointer;background:#fff;color:#d32f2f;border:1px solid #f0c2c2;border-radius:8px;">🗑 清空历史</button>
        <button id="awHistRefreshBtn" style="padding:5px 12px;font-size:11px;cursor:pointer;background:var(--primary-bg);color:var(--primary);border:1px solid #cfe3fb;border-radius:8px;font-weight:600;">🔄 刷新</button>
      </div>
      ${rows || '<div style="text-align:center;color:#999;padding:24px 0;font-size:12px;">还没有灌水历史<br><span style="font-size:11px;">跑过一轮自动灌水后，这里会记下每篇的结果</span></div>'}
      ${entries.length > 100 ? `<div style="text-align:center;color:#9ca3af;font-size:11px;padding:4px 0;">只显示最近 100 条（共 ${entries.length} 条）</div>` : ''}
    </div>`;

  container.querySelector('#awHistRefreshBtn').onclick = () => renderWaterHistory(container);
  container.querySelector('#awHistClearBtn').onclick = async () => {
    if (!confirm('确认清空所有灌水历史？此操作不可恢复。')) return;
    try { await writePlain('auto_water_history', {}); } catch (_) {}
    renderWaterHistory(container);
  };
}

// ========== 点赞记录（内存，刷新/关闭即清零） ==========
let likedComments = []; // { author, textSnippet, time }

function renderLikedList() {
  let container = document.getElementById('likedListContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'likedListContainer';
    const mc = document.getElementById('mainContent');
    if (mc) mc.appendChild(container);
  }
  if (likedComments.length === 0) {
    container.innerHTML = '';
    return;
  }
  container.innerHTML = `
    <details style="margin-top:8px;" open>
      <summary style="font-size:12px;font-weight:500;color:#555;cursor:pointer;padding:4px 0;">
        👍 已点赞（${likedComments.length}个）
      </summary>
      ${likedComments.map((item, i) => {
        const timeStr = item.time ? new Date(item.time).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }) : '';
        return `<div style="padding:4px 8px;margin:2px 0;background:#f0fdf4;border-radius:4px;font-size:11px;line-height:1.5;">
          <span style="color:#059669;font-weight:500;">@${esc(item.author)}</span>
          <span style="color:#999;font-size:10px;margin-left:4px;">${timeStr}</span>
          <div style="color:#333;margin-top:1px;">${esc(item.textSnippet)}</div>
        </div>`;
      }).join('')}
    </details>
  `;
}

/** 获取当前笔记的本地已回复记录列表 */
async function getLocalRepliedForNote(noteUrl) {
  if (!noteUrl) return [];
  const map = (await readPlain(REPLIED_KEY)) || {};
  return map[noteUrl] || [];
}

/** 将一条回复保存到本地存储 */
async function addLocalReply(noteUrl, author, comment) {
  if (!noteUrl) return;
  const map = (await readPlain(REPLIED_KEY)) || {};
  if (!map[noteUrl]) map[noteUrl] = [];
  const exists = map[noteUrl].some(e => e.author === author && e.comment === comment);
  if (!exists) {
    map[noteUrl].push({ author, comment, repliedAt: Date.now() });
    await writePlain(REPLIED_KEY, map);
  }
}

/** 获取某篇笔记的本地已回复次数（防拉黑检查） */
async function getNoteReplyCount(noteUrl) {
  if (!noteUrl) return 0;
  const list = await getLocalRepliedForNote(noteUrl);
  return list.length;
}

/** 创建已回复提醒 Banner DOM 元素 */
function createRepliedBanner(count) {
  const div = document.createElement('div');
  const bgColor = '#fff3cd', borderColor = '#ffc107', textColor = '#856404';
  div.style.cssText = `padding:10px 14px;border-radius:6px;margin-bottom:10px;font-size:13px;font-weight:600;background:${bgColor};border:1px solid ${borderColor};color:${textColor};line-height:1.5;`;
  div.innerHTML = `📢 本条笔记已有 <strong>${count}</strong> 条回复记录，已自动从扫描中排除`;
  return div;
}

// ========== 初始化 ==========
/* ─── 左面板宽度可拖拽调节（拖中间分隔条） ─── */
function initPanelResizer() {
  const divider = document.getElementById('divider');
  const panelLeft = document.getElementById('panelLeft');
  if (!divider || !panelLeft) return;
  // 恢复上次保存的宽度
  try {
    chrome.storage.local.get('panel_left_width', function (d) {
      const w = d['panel_left_width'];
      if (w && !isNaN(w)) { panelLeft.style.width = w + 'px'; panelLeft.style.maxWidth = w + 'px'; }
    });
  } catch (_) {}
  let dragging = false;
  divider.addEventListener('mousedown', function (e) {
    if (divider.style.display === 'none' || panelLeft.style.display === 'none') return;
    dragging = true;
    divider.classList.add('active');
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    e.preventDefault();
  });
  document.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    const rect = panelLeft.getBoundingClientRect();
    let w = e.clientX - rect.left;
    if (w < 200) w = 200;
    if (w > 620) w = 620;
    panelLeft.style.width = w + 'px';
    panelLeft.style.maxWidth = w + 'px';
  });
  document.addEventListener('mouseup', function () {
    if (!dragging) return;
    dragging = false;
    divider.classList.remove('active');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    const w = Math.round(panelLeft.getBoundingClientRect().width);
    try { chrome.storage.local.set({ panel_left_width: w }); } catch (_) {}
  });
}

// ═══ 拟人化挡位（与设置页「🤖 拟人化与频率」共享 lib/delay-presets.js 的表 + delay_config / delay_preset）═══
// 挡位只管停留/间隔；每轮篇数不在这里动（唯一入口＝「🎯 获客 → ⚙️ 设置 → 🤖 拟人化与频率 → ⚙️ 高级配置 → 每轮最多处理」）
const POPUP_DELAY_KEYS = ['browseDwell','typingCharDelay','likeGap','lazyLoadWait','retryBackWait','retryOpenWait','noteOpenBuffer','preSendGap','batchItemGap'];
function popupPresetLevel(cfg) {
  const mid = c => ((Number(c.min)||0)+(Number(c.max)||0))/2;
  let total = 0; POPUP_DELAY_KEYS.forEach(k => { const m = (cfg&&cfg[k])?mid(cfg[k]):0; total += (k==='typingCharDelay'? m*1000 : m); });
  let best = 2, bd = Infinity;
  for (const p of DELAY_PRESETS) { const t = POPUP_DELAY_KEYS.reduce((s,k)=>{ const m=(p.cfg[k])?mid(p.cfg[k]):0; return s+(k==='typingCharDelay'?m*1000:m); },0); const d=Math.abs(total-t); if(d<bd){bd=d;best=p.level;} }
  return best;
}
async function initDelayPresetSelector() {
  const sel = document.getElementById('plDelayPreset');
  if (!sel) return;
  DELAY_PRESETS.forEach(p => { const o = document.createElement('option'); o.value = p.level; o.textContent = p.level + ' ' + p.short; sel.appendChild(o); });
  let level = 2;
  try {
    const stored = (await chrome.storage.local.get(['delay_preset','delay_config'])) || {};
    const lvl = stored.delay_preset;
    if (lvl != null && DELAY_PRESETS.some(p=>p.level===Number(lvl))) level = Number(lvl);
    else level = popupPresetLevel(stored.delay_config || {});
  } catch (_) {}
  sel.value = String(level);
  sel.addEventListener('change', async () => {
    const lvl = Number(sel.value);
    const p = DELAY_PRESETS.find(x => x.level === lvl);
    if (!p) return;
    const cfg = {}; POPUP_DELAY_KEYS.forEach(k => cfg[k] = { min: p.cfg[k].min, max: p.cfg[k].max });
    try { await chrome.storage.local.set({ delay_config: cfg, delay_preset: lvl }); } catch (_) {}
  });
}

/* ─── 顶部「更多」菜单：大窗 / 设置 / 拟人化挡位 ───
 * 注：原先把这两项直接铺在 header 上（6 个控件挤一行）；收进菜单后 header 只留品牌+状态+租户。
 *     同时把原先写在 popup.html 内联 <script> 里的初始化搬到这里——扩展页 CSP 禁内联脚本，那段从未生效。
 *     Bot 间隔（扫新线索）2026-09-25 撤出本菜单：唯一入口＝线索 → ⚙️ 设置（#tab-leadtouch）。 */
function initHeaderMenu() {
  const btn = document.getElementById('hdrMoreBtn');
  const menu = document.getElementById('hdrMoreMenu');
  if (btn && menu) {
    const close = () => { menu.style.display = 'none'; };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    });
    document.addEventListener('click', (e) => {
      if (menu.style.display === 'block' && !menu.contains(e.target) && !btn.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
  // 锁定遮罩：日志来源过滤（同样原为 inline onclick，受 CSP 限制从未生效）
  const filters = document.querySelectorAll('.ovl-f');
  if (filters.length) {
    filters.forEach((b) => {
      b.addEventListener('click', () => {
        if (typeof window.__setOverlayLogFilter === 'function') window.__setOverlayLogFilter(b.dataset.f);
        if (typeof window._applyOverlayFilter === 'function') window._applyOverlayFilter();
        filters.forEach((x) => x.classList.toggle('active', x === b));
      });
    });
  }
}

/* ─── 打开设置页并落到指定分区（tab 省略=设置首页）─── */
// 配置中心现在内嵌在弹窗左栏「设置」里：⚙️ / 「去配置」就地切过去，不再另开页面。
// 只有拿不到左栏时（小窗状态卡）才退回另开设置页，免得按钮点了没反应。
function openSettingsTab(tab) {
  const rail = document.getElementById('rail');
  const frame = document.getElementById('settingsFrame');
  if (rail && rail.offsetParent !== null && frame) { switchMainTab('settings', tab); return; }
  const url = chrome.runtime.getURL('settings.html') + (tab ? ('#' + tab) : '');
  try { chrome.tabs.create({ url }); }
  catch (_) { chrome.runtime.openOptionsPage(); }
}
// 弹窗里的设置 iframe：首次进入才挂 src（免得每次开弹窗都白跑一遍设置页），之后直接换页
let _setTab = 'tenant';    // 当前停在设置的哪一页（下次进设置还回这里）
let _setReady = false;
function settingsFrameGo(tab) {
  _setTab = tab || 'tenant';
  const f = document.getElementById('settingsFrame');
  if (!f) return;
  if (!f.getAttribute('src')) {
    f.addEventListener('load', () => { _setReady = true; settingsFrameGo(_setTab); }, { once: true });
    f.setAttribute('src', 'settings.html?embed=1#' + _setTab);
    return;
  }
  if (!_setReady) return;   // 首屏还在加载：load 回来会按 _setTab 兜上
  try { f.contentWindow.settingsOpenTab(_setTab); } catch (_) {}
}
/* 业务侧内嵌的配置页（线索设置 · 线索任务配置）：还是那台配置中心，
   只是从业务入口进去、只显示某一页（?embed=1 已把它的侧栏收起）。同样首次进入才挂 src，
   之后重进就让它自己翻页，里面没保存的改动不会因为切走再回来被冲掉。 */
function _embedSettingsFrame(frameId, tab) {
  const f = document.getElementById(frameId);
  if (!f) return;
  if (!f.getAttribute('src')) { f.setAttribute('src', 'settings.html?embed=1#' + tab); return; }
  try { f.contentWindow.settingsOpenTab(tab); } catch (_) {}
}
document.addEventListener('DOMContentLoaded', async () => {
  initDelayPresetSelector();
  // ★ 立即用 DOM API 写入 mainContent，测试容器可操作性
  const mc = document.getElementById('mainContent');
  if (mc) {
    const loadMsg = document.createElement('div');
    loadMsg.style.cssText = 'padding:40px;text-align:center;font-size:14px;color:#555;';
    loadMsg.innerHTML = '⏳ 加载中...<br><span style="font-size:11px;color:#999;">如果持续显示此条，检查控制台(F12)错误</span>';
    mc.appendChild(loadMsg);
  }
  document.getElementById('refreshBtn')?.addEventListener('click', refreshData);
  document.getElementById('rescanBtn')?.addEventListener('click', refreshData);
  // ★ 首次设置：还没配 AI Key → 直接在 popup 内嵌两步面板（备份恢复 / 配置 AI），验证后在本人主页检测到缺 Key 即展示
  ensureFirstSetup();
  // 一级导航（获客 / 线索 / 发笔记 / 诊断&配置）+ 获客二级（工作台 / 队列 / 笔记池 / 词池）
  document.getElementById('tabHuoke')?.addEventListener('click', () => switchMainTab(_huokeSub));
  document.getElementById('tabProspect')?.addEventListener('click', () => switchMainTab('prospect'));
  // 线索的二级：通知 / 消息（两条独立线；通知页里再用胶囊切「来自哪个渠道」）
  document.getElementById('tabLeadNotif')?.addEventListener('click', () => switchMainTab('prospect'));
  document.getElementById('tabLeadMsg')?.addEventListener('click', () => switchMainTab('prospectMsg'));
  // 线索的「任务配置」：触达场合 AI 说话带什么去向（🎙 渠道基调 / 💰 成交引导两个横 tab）
  document.getElementById('tabLeadTaskCfg')?.addEventListener('click', () => switchMainTab('leadTaskCfg'));
  // 线索的「设置」：只管 Bot 间隔（多久扫一次新线索）
  document.getElementById('tabLeadCfg')?.addEventListener('click', () => switchMainTab('leadCfg'));
  // 获客的「设置」：拟人化与频率（挡位 / 灌水频率与去重 / 停留间隔 / 互动行为）
  document.getElementById('tabHuokeCfg')?.addEventListener('click', () => switchMainTab('huokeCfg'));
  // 发笔记：点一级项落到「笔记档案」（这块的主页）；写文案 / 出片台都是它的衍生页，从档案里进
  document.getElementById('tabNotePublish')?.addEventListener('click', () => switchMainTab('noteArchive'));
  // 发笔记的二级：笔记档案（主入口）+ 素材库（备图清单）
  document.getElementById('tabNoteAssets')?.addEventListener('click', () => switchMainTab('noteAssets'));
  document.getElementById('tabNoteArchive')?.addEventListener('click', () => switchMainTab('noteArchive'));
  document.getElementById('tabNoteTaskCfg')?.addEventListener('click', () => switchMainTab('noteTaskCfg'));
  document.getElementById('tabDiagnose')?.addEventListener('click', () => switchMainTab('diagnose'));
  // 设置：整台配置中心在弹窗内（左栏一条分隔线之下）；它的二级＝13 个配置页
  document.getElementById('tabSettings')?.addEventListener('click', () => switchMainTab('settings'));
  document.querySelectorAll('#setTabs [data-stab]').forEach(function (el) {
    el.addEventListener('click', function () { switchMainTab('settings', el.getAttribute('data-stab')); });
  });
  // 诊断&配置的二级：6 个节点都从左侧栏进
  document.querySelectorAll('#diagSubTabs [data-go]').forEach(function (el) {
    el.addEventListener('click', function () { switchMainTab('diagnose'); diagGo(parseInt(el.getAttribute('data-go'), 10)); });
  });
  document.getElementById('tabTaskCfg')?.addEventListener('click', () => switchMainTab('taskCfg'));
  document.getElementById('tabCommentAssistant')?.addEventListener('click', () => switchMainTab('comment'));
  document.getElementById('tabQueue')?.addEventListener('click', () => switchMainTab('queue'));
  document.getElementById('tabPool')?.addEventListener('click', () => switchMainTab('scenarioDrain'));
  document.getElementById('btnToQueue')?.addEventListener('click', () => switchMainTab('queue'));
  initHeaderMenu();
  // ★ 默认落到「获客 · 工作台」（日常主力）
  switchMainTab('comment');
  bindProspectModals();
  wireAccountGuardWatcher();
  document.getElementById('adminBtn')?.addEventListener('click', () => openSettingsTab(''));
  addLog('获客助手已加载', 'info');
  // ★ 先应用版本限制（隐藏不属于本版本的功能、到期锁定）
  await applyEditionToPopup();
  // 初始化顶部租户切换器
  initTenantSwitcher();
  // ★ 窗口形态分流：大窗 = 全部操作；小窗 = 只读状态卡
  if (MODE_BIG) {
    // 大窗：显示全部 tab，隐藏切换按钮
    document.getElementById('bigWindowBtn')?.remove();
  } else {
    // 小窗 = 只读状态卡：隐藏全部导航，把界面收敛为纯状态卡（全宽）
    ['rail', 'mainTabs', 'subTabs', 'leadTabs', 'diagSubTabs', 'noteTabs', 'setTabs'].forEach(function (id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    // 隐藏双栏/工具栏，只留状态卡（mainContent）
    const pl = document.getElementById('panelLeft');
    const dv = document.getElementById('divider');
    const rt = document.querySelector('.right-toolbar');
    const ni = document.getElementById('noteInfo');
    const sb = document.getElementById('statusBar');
    if (pl) pl.style.display = 'none';
    if (dv) dv.style.display = 'none';
    if (rt) rt.style.display = 'none';
    if (ni) ni.style.display = 'none';
    if (sb) sb.style.display = 'none';
    // 「↗ 大窗」按钮：手动打开大窗总览
    const _bigWinBtn = document.getElementById('bigWindowBtn');
    if (_bigWinBtn) _bigWinBtn.addEventListener('click', function () {
      chrome.runtime.sendMessage({ action: 'openBigWindow', senderTab: null }).catch(() => {});
    });
    // 第一次点图标自动开大窗；之后仅显示状态卡（不打扰）
    chrome.storage.local.get('_big_ever_opened', (r) => {
      if (!r._big_ever_opened) {
        chrome.storage.local.set({ _big_ever_opened: true });
        chrome.runtime.sendMessage({ action: 'openBigWindow', senderTab: null }).catch(() => {});
      }
    });
    // 只读状态卡 + 轮询
    startStatusPolling();
  }
  // 初始化左侧笔记搜索面板（仅在含灌水功能的版本启用；不自动刷新评论助手）
  if (editionFeatureOn('autoWater')) {
    window.AutoWaterApp?.activate();
  }
  // 左面板宽度拖拽（始终可用，即便非灌水版分隔条被隐藏也不影响）
  initPanelResizer();
  // ★ 弹窗刚打开时并没有真的在抓页面（要等用户点「评论刷新」或从左侧列表打开笔记），
  //   所以这里把状态条与内容区落到「待机」态，别再一直显示“正在提取页面数据…”骗人。
  setStatus('⏸️ 待机中：点右上「🔄 评论刷新」开始扫描当前笔记' + (editionFeatureOn('autoWater') ? '，或从左侧列表打开一篇笔记' : ''), '');
  showIdle();
});

/* ─── 首次设置（内嵌在 popup）：验证后若缺 AI Key 直接展示；备份恢复 / 配置AI 分栏 ─── */
/* 服务商 / 模型清单：lib/ai-providers.js 的 PROVIDER_CONFIG（与设置页、向导、后台共用一份） */
function fsProviderOf(val, id) {
  if (val === 'custom') return (document.getElementById(id)?.value || '').trim();
  return (PROVIDER_CONFIG[val] && PROVIDER_CONFIG[val].baseUrl) || '';
}
function fsFillModel(prov, cur, selId) {
  const sel = document.getElementById(selId); if (!sel) return;
  sel.innerHTML = '';
  const cfg = PROVIDER_CONFIG[prov];
  if (!cfg || prov === 'custom') {
    if (cur) { const o = new Option('当前：' + cur, cur, true, true); sel.appendChild(o); }
    QUICK_MODELS.normal.forEach(m => sel.appendChild(new Option(m.label, m.value)));
    return;
  }
  let has = !cur;
  cfg.models.forEach(m => { if (m.value === cur) has = true; const o = new Option(m.label, m.value, false, m.value === cur); sel.appendChild(o); });
  if (!has && cur) sel.insertBefore(new Option('当前：' + cur, cur, true, true), sel.firstChild);
}
function ensureFirstSetup() {
  (async function () {
    try {
      const got = await readConfigPlain();
      const ai = got.ai || {};
      if (ai.apiKey || ai.fallbackApiKey) return; // 已配置 AI，不展示
      if (document.getElementById('firstSetupPanel')) return;
      const ROOT = document.createElement('div');
      ROOT.id = 'firstSetupPanel';
      ROOT.style.cssText = 'position:fixed;inset:0;z-index:99980;background:rgba(22,22,26,0.97);color:#fff;overflow:auto;padding:22px 24px;box-sizing:border-box;';
      ROOT.innerHTML = `
        <style>
          .fs-col{background:#26262b;border:1px solid #33333a;border-radius:12px;padding:16px;}
          .fs-col h3{font-size:14px;margin:0 0 4px;}
          .fs-col .sub{font-size:12px;color:#a6a6b0;line-height:1.7;margin:0 0 12px;}
          .fs-field{margin-bottom:12px;}
          .fs-field label{display:block;font-size:12px;color:#a6a6b0;margin-bottom:5px;}
          .fs-field select,.fs-field input[type=password],.fs-field input[type=text]{width:100%;background:#1a1a1f;border:1px solid #3a3a44;border-radius:8px;color:#fff;padding:8px 10px;font-size:13px;box-sizing:border-box;outline:none;}
          .fs-field select:focus,.fs-field input:focus{border-color:#5b8dff;}
          .fs-btn{width:100%;padding:10px;border:none;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;}
          .fs-primary{background:#ff274b;color:#fff;}
          .fs-import{background:transparent;border:1px dashed #5b8dff;color:#b9ceff;}
          .fs-msg{font-size:12px;line-height:1.6;margin-top:10px;min-height:16px;color:#7bd88f;}
          .fs-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:720px;margin:0 auto;}
          @media(max-width:560px){.fs-grid{grid-template-columns:1fr;}}
        </style>
        <div style="max-width:720px;margin:0 auto;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
            <span style="font-size:26px;">🎯</span><h2 style="margin:0;font-size:18px;">先完成首次设置，才能开干</h2>
            <button id="fsClose" title="稍后再说" style="margin-left:auto;border:none;background:transparent;color:#aaa;font-size:18px;cursor:pointer;">✕</button>
          </div>
          <p style="font-size:12.5px;color:#a6a6b0;margin:0 0 16px;">两种方式任选一种：<b>新装填 AI</b>，<b>迁移从备份恢复</b>。选服务商即可自动带出地址和模型，不用手敲 URL。</p>
          <div class="fs-grid">
            <div class="fs-col">
              <h3>🛡️ 从整机备份恢复</h3>
              <p class="sub">导入之前「整机备份 / 恢复」导出的文件：所有产品 + 知识库 + 话术 + AI 配置一起还原（只想恢复某一个产品的资料，用「诊断&配置 → 知识库 → 📦 备份」）。</p>
              <input type="file" id="fsRestoreFile" accept="application/json,.json" style="display:none;">
              <label for="fsRestoreFile" id="fsRestoreBtn" class="fs-btn fs-import" style="display:block;text-align:center;cursor:pointer;">⬆ 选择备份文件导入</label>
              <div class="fs-msg" id="fsRestoreMsg"></div>
            </div>
            <div class="fs-col">
              <h3>配置 AI（日常对话 / 回复）</h3>
              <p class="sub">选一个已注册的服务商，填它的 API Key。Key 只存在你本地浏览器。</p>
              <div class="fs-field"><label>API 提供商</label><select id="fsProvider">
                <option value="deepseek">DeepSeek</option>
                <option value="ark">火山方舟 Coding Plan</option>
                <option value="openai">OpenAI</option>
                <option value="qwen">通义千问（阿里云）</option>
                <option value="siliconflow">硅基流动 SiliconFlow</option>
                <option value="qianfan">百度千帆 Qianfan</option>
                <option value="gemini">Google Gemini（免费）</option>
                <option value="openrouter">OpenRouter（免费路由）</option>
                <option value="groq">Groq（免费快）</option>
                <option value="zhipu">智谱 GLM（免费）</option>
                <option value="custom">自定义（手动填写地址）</option>
              </select></div>
              <div class="fs-field" id="fsCustomUrlWrap" style="display:none;"><label>自定义 API Base URL</label><input type="text" id="fsCustomUrl" placeholder="https://your-api.com/v1"></div>
              <div class="fs-field"><label>模型</label><select id="fsModel"><option value="" disabled selected>正在加载模型…</option></select></div>
              <div class="fs-field"><label>API Key *</label><input type="password" id="fsApiKey" placeholder="sk-…" autocomplete="off" style="font-family:monospace;"></div>
              <button class="fs-btn fs-primary" id="fsSave">保存并开始使用</button>
              <div class="fs-msg" id="fsMsg"></div>
            </div>
          </div>
        </div>`;
      document.body.appendChild(ROOT);

      const $ = (s) => ROOT.querySelector('#' + s);
      const msg = (el, txt, ok) => { if (!el) return; el.style.color = ok === false ? '#ffb3c1' : ok === true ? '#7bd88f' : '#d3d3dc'; el.textContent = txt; };
      $('fsClose').onclick = () => ROOT.remove();
      // 提供商 → 模型联动
      const syncProv = () => {
        const p = $('fsProvider').value;
        const pcfg = PROVIDER_CONFIG[p];
        $('fsCustomUrlWrap').style.display = p === 'custom' ? '' : 'none';
        if (pcfg && p !== 'custom') $('fsCustomUrl').value = pcfg.baseUrl || '';
        fsFillModel(p, $('fsModel').value, 'fsModel');
      };
      $('fsProvider').addEventListener('change', syncProv);
      syncProv();
      // 从备份恢复
      $('fsRestoreBtn').onclick = () => $('fsRestoreFile').click();
      $('fsRestoreFile').onchange = async () => {
        const f = $('fsRestoreFile').files && $('fsRestoreFile').files[0];
        if (!f) return;
        const m = $('fsRestoreMsg'); msg(m, '读取备份文件…', false);
        let text = await f.text();
        if (CryptoBox.isFileEnvelope(text)) {
          const pw = await CryptoBox.askPassword({
            title: '输入备份口令',
            hint: '这个备份是加密文件，请输入导出时设置的口令。',
            okText: '解密导入',
          });
          if (!pw.ok) { $('fsRestoreFile').value = ''; return msg(m, '', false); }
          msg(m, '解密中…', false);
          try { text = await CryptoBox.decryptFile(text, pw.password); }
          catch (err) { $('fsRestoreFile').value = ''; return msg(m, '❌ ' + ((err && err.message) || err), false); }
        }
        let backup = null;
        try { backup = JSON.parse(text); } catch (_) { return msg(m, '❌ 文件不是合法的 JSON 备份', false); }
        if (!backup || !backup.tenants || !backup.data) return msg(m, '❌ 不是有效的备份文件（缺 tenants/data）', false);
        msg(m, '合并导入中…', false);
        let r = null;
        try { r = await chrome.runtime.sendMessage({ action: 'importAllData', data: { backup } }); } catch (e) { r = null; }
        if (!r || !r.ok) return msg(m, '❌ 导入失败：' + ((r && r.error) || '后台未响应'), false);
        await chrome.storage.local.set({ wizard_done: Date.now() });
        const cfg = (await readConfigPlain()).ai || {};
        msg(m, '✅ 已导入 ' + (r.importedTenants || 0) + ' 个产品。' + ((cfg.apiKey || cfg.fallbackApiKey) ? 'AI 配置已就绪！' : '备份里没 AI Key，请在右侧填写。'), true);
        $('fsRestoreFile').value = '';
        if (cfg.apiKey || cfg.fallbackApiKey) setTimeout(() => ROOT.remove(), 900);
      };
      // 保存 AI
      $('fsSave').onclick = async () => {
        const key = $('fsApiKey').value.trim();
        const m = $('fsMsg');
        const p = $('fsProvider').value;
        if (p === 'custom' && !/^https?:\/\//i.test($('fsCustomUrl').value.trim())) return msg(m, '请填正确的自定义 API 地址（以 http:// 开头），或改选服务商', false);
        if (!key) return msg(m, '请填写 API Key', false);
        // 服务商域名授权要在点击手势里、读写配置之前要（火山方舟没写进 manifest host_permissions）
        const granted = await ensureProviderHostGranted(p);
        const cfg = await readConfigPlain();
        cfg.ai = cfg.ai || {};
        cfg.ai.apiKey = key;
        cfg.ai.apiBaseUrl = fsProviderOf(p, 'fsCustomUrl') || 'https://api.deepseek.com/v1';
        cfg.ai.model = $('fsModel').value.trim() || 'deepseek-v4-flash';
        await writeConfigPlain(cfg);
        msg(m, granted ? '✅ 已保存，AI 已就绪！'
                       : '⚠️ 已保存，但该服务商域名的访问授权没拿到——调用会被浏览器拦下，请再点一次「保存」并在弹窗里选「允许」', granted);
        if (granted) setTimeout(() => ROOT.remove(), 700);
        try { if (typeof applyEditionToPopup === 'function') applyEditionToPopup(); } catch (_) {}
      };
    } catch (e) { console.error('[首次设置] 面板初始化失败:', e); }
    })();
}

/* ─── 主功能 Tab 切换：评论助手 / 队列 / 笔记池 / 用户清单(+AI客服) ─── */
let _chatFollowLoaded = false;
let _prospectListLoaded = false;
let _touchQueue = [];          // 批量触达队列（草拟·确认，逐条）
let _touchBatchActive = false; // 批量触达是否进行中
let _touchBusy = false;        // 触达推进防重入锁
let _plHideBlocked = false;    // 是否隐藏"私信受限"
let _inboundAiScreen = true;   // 私信进线是否默认开 AI 筛选（筛掉刷号玩/无关）
let _selectedIds = new Set();  // 用户清单多选：勾选删除
let _outboundCollapsed = true; // 消息桶：我方触达分组默认折叠
let _syncInFlight = false;     // 通知同步防重入
const NOTIF_SYNC_CAP = 150;     // 单次同步新增上限（降为150，控制单次抓取体量以免动作过于集中）
let _huokeSub = 'comment';      // 获客分组下最后停留的子页（任务配置 / 队列 / 工作台 / 笔记池 / 设置）
function switchMainTab(name, arg) {
  // 切页＝这一篇的手改该落地了：延时的回写先刷掉（不然打字后 0.8 秒内点「拿去出片」会白改）
  npArchiveFlushTouch();
  // 台上开着哪一页，只在这一个地方定：离开造图片 / 教程（回档案 / 去别的 tab）就把模式掰回向导，
  // 否则 npS() 还认着 _npOut，下一篇的造图片函数会改到上一那篇的状态上
  _npMode = name === 'noteOut' ? 'out' : (name === 'noteGuide' ? 'guide' : (name === 'noteTask' ? 'task' : 'wizard'));
  const $ = (id) => document.getElementById(id);
  const tabComment = $('tabCommentAssistant');
  const tabNote = $('tabNotePublish');
  const noteTabs = $('noteTabs');
  const tabNoteA = $('tabNoteArchive');
  const tabNoteAs = $('tabNoteAssets');
  const tabNoteTc = $('tabNoteTaskCfg');
  const tabDiag = $('tabDiagnose');
  const tabQueue = $('tabQueue');
  const tabPool = $('tabPool');
  const tabTaskCfg = $('tabTaskCfg');
  const tabHuokeCfg = $('tabHuokeCfg');
  const tabHuoke = $('tabHuoke');
  const tabProspect = $('tabProspect');
  const subTabs = $('subTabs');
  const leadTabs = $('leadTabs');
  const diagSubTabs = $('diagSubTabs');
  const tabSettings = $('tabSettings');
  const setTabs = $('setTabs');
  const sc = $('settingsContent');
  const hcc = $('huokeCfgContent');   // 获客 · 设置（🤖 拟人化与频率）
  const lcc = $('leadCfgContent');    // 线索 · 设置（🤖 Bot 间隔）
  const ltc = $('leadTaskCfgContent');// 线索 · 任务配置（📮 渠道基调 / 成交引导）
  const mc = $('mainContent');
  const pc = $('prospectContent');
  const nc = $('notePublishContent');
  const noc = $('noteOutputContent');   // 造图片（按篇，从「出图 / 出片」那张表的一行进）
  const ntk = $('noteTaskContent');     // 出图 / 出片任务列表（按篇：这一篇要出的图与片摊在一张表上，入口在档案操作列）
  const ngc = $('noteGuideContent');    // 发布教程（按篇，同样从档案那一行进）
  const nac = $('noteArchiveContent');
  const nas = $('noteAssetsContent');
  const ntc = $('noteTaskCfgContent');   // 发笔记 · 任务配置（内容基调：阶段与人设 / 五条线与写法 / 话术比例）
  const dc = $('diagnoseContent');
  const src2 = $('drainContent');
  const dqc = $('drainQueueContent');
  const dcc = $('drainCfgContent');
  const fmc = $('filmContent');
  const cqb = $('cqBar');   // 💬 评论条队列顶栏：只属于「工作台」页
  // 诊断&配置的 6 个节点、线索的 通知/消息/设置 都在左栏当二级 tab，属于各自的一级项，跟着 _hideAll 一起收
  // 内容面板按 .content 泛收：别逐个列 id —— 内嵌 iframe 的宿主漏在清单外过一轮，切走后旧页会赖在屏上
  const _hideAll = () => {
    document.querySelectorAll('.content').forEach(x => { x.style.display = 'none'; });
    [cqb, leadTabs, diagSubTabs, noteTabs, setTabs].forEach(x => { if (x) x.style.display = 'none'; });
  };
  const _markTop = (on) => {
    [tabComment, tabNote, tabDiag, tabQueue, tabPool, tabTaskCfg, tabHuokeCfg, tabHuoke, tabProspect, tabSettings].forEach(t => { if (t) t.classList.remove('active'); });
    if (on) on.classList.add('active');
  };
  const _markSub = (on) => {
    [tabComment, tabQueue, tabPool, tabTaskCfg, tabHuokeCfg].forEach(t => { if (t) t.classList.remove('active'); });
    if (on) on.classList.add('active');
  };
  // 发笔记的二级＝（笔记档案 / 素材库 / 任务配置）；写文案、造图片、出片台、教程都从档案那一行进，二级栏停在「笔记档案」上
  const _markNote = (on) => {
    [tabNoteAs, tabNoteA, tabNoteTc].forEach(t => { if (t) t.classList.remove('active'); });
    if (on) on.classList.add('active');
  };
  // 获客分组只剩「工作台」一个子页时（无灌水的版本），整条二级栏隐藏，避免空条
  const _showSub = () => { if (subTabs) subTabs.style.display = ($('tabQueue') || $('tabPool') || tabHuokeCfg) ? '' : 'none'; };
  const _hideSub = () => { if (subTabs) subTabs.style.display = 'none'; };
  // 线索页：通知 / 消息 / 任务配置 / 设置是四条二级线；页内胶囊只切「通知来自哪个渠道」
  const _showLead = (subId) => {
    if (leadTabs) leadTabs.style.display = '';
    [$('tabLeadNotif'), $('tabLeadMsg'), $('tabLeadTaskCfg'), $('tabLeadCfg')].forEach(t => { if (t) t.classList.toggle('active', t.id === subId); });
  };
  const _prospect = (stage, ch, subId) => {
    if (stage !== _plStage) _plChannelSel = '';   // 换页 → 渠道回到「全部」
    _plStage = stage;
    if (ch) _plChannelSel = ch;                   // 指定渠道（旧入口 notifComment / notifLike …）
    _markTop(tabProspect); _hideSub(); _hideAll(); _showLead(subId);
    if (pc) pc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (pc) loadProspectList(pc);
  };

  // ── 线索（旧名 notifAll / prospectMsg / notif* 一律汇到这里）──
  if (name === 'prospect' || name === 'notifAll') return _prospect('notif', '', 'tabLeadNotif');
  if (name === 'prospectMsg') return _prospect('msg', '', 'tabLeadMsg');
  if (name === 'notifComment') return _prospect('notif', 'comment', 'tabLeadNotif');
  if (name === 'notifLike')    return _prospect('notif', 'like', 'tabLeadNotif');
  if (name === 'notifFollow')  return _prospect('notif', 'follow', 'tabLeadNotif');
  if (name === 'notifAi')      return _prospect('notif', 'ai', 'tabLeadNotif');
  if (name === 'leadTaskCfg') {
    // 线索 · 任务配置：触达场合（私信 / 通知回访）AI 说话带什么去向——页内两个横 tab（🎙 渠道基调 / 💰 成交引导）。
    // 页内就是配置中心的 #leadtask 一页；评论里的承接在 获客 → 任务配置 → 🎯 推广目标
    _markTop(tabProspect); _hideSub(); _hideAll(); _showLead('tabLeadTaskCfg');
    if (ltc) ltc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    _embedSettingsFrame('leadTaskCfgFrame', 'leadtask');
    return;
  }
  if (name === 'leadCfg') {
    // 线索 · 设置：只管线索自己的事——Bot 间隔（多久扫一次新线索）。
    // 页内就是配置中心的 #leadtouch 一页（渠道基调 / 成交引导 2026-09-25 搬去「任务配置」那页）
    _markTop(tabProspect); _hideSub(); _hideAll(); _showLead('tabLeadCfg');
    if (lcc) lcc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    _embedSettingsFrame('leadCfgFrame', 'leadtouch');
    return;
  }
  // ── 配置类入口已收进设置页：这里只做跳转 ──
  if (name === 'drainCfg') { switchMainTab('taskCfg'); return; }   // 旧名：词池配置已搬成获客的「任务配置」
  if (name === 'aiCsScene' || name === 'aiCsQa') {
    // 旧名（AI客服的场景 / 问答）：话术现在归在「线索 → 任务配置」；没有线索的版本回设置页看锁定说明
    if (document.getElementById('tabLeadTaskCfg')) switchMainTab('leadTaskCfg');
    else openSettingsTab('');
    return;
  }
  if (name === 'notePublish') {
    // 写文案：不再有独立的二级 tab，它是「笔记档案」的衍生页 —— 左栏二级停在「笔记档案」上
    // arg ＝ 档案那行「继续编辑」带过来的那一篇；arg='new' ＝ 档案页顶「✍️ 写文案」起新的一篇
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';     // 二级栏只属于「发笔记」，跟在它正下方
    _markNote(tabNoteA);
    if (nc) nc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (nc && (!_notePublishLoaded || arg)) {
      _notePublishLoaded = true;
      renderNotePublish(nc, (arg && arg !== 'new') ? arg : null);
    }
    return;
  }
  if (name === 'noteTask') {
    // 出图 / 出片：档案里这一篇要出的活摊在一张表上（一行＝一个活：图按「平台 × 画面流派」、片按「平台 × 成片形式」）。
    // 这一页只排活、不出料：点行上的「出图」进造图片、「出片」进出片台，改好的料各自写回这一档。
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteA);
    if (ntk) ntk.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (ntk && arg) npOpenTask(ntk, arg);
    return;
  }
  if (name === 'noteOut') {
    // 造图片：按「档案里的某一篇」造图片（定风格流派 → 断句出图提示词 / 口播稿）；发出去那一步在档案操作列的「📖 教程」里。
    // 入口只在笔记档案那一行；出的料写回那一档，所以它跟正文一样留在档案里。
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteA);
    if (noc) noc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (noc && arg) npOpenOutput(noc, arg);
    return;
  }
  if (name === 'noteGuide') {
    // 发布教程：按「档案里的某一篇」给这一份教程（发哪一种 → 怎么出、怎么发）。只读，不改这一篇的料。
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteA);
    if (ngc) ngc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (ngc && arg) npOpenGuide(ngc, arg);
    return;
  }
  if (name === 'noteAssets') {
    // 素材库：每次切入都重渲染（刚备的图 / 标的状态要立刻反映出来）
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteAs);
    if (nas) nas.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (nas) renderNoteAssets(nas);
    return;
  }
  if (name === 'noteTaskCfg') {
    // 发笔记 · 任务配置（内容基调）：谁在说 × 哪一阶段 × 讲哪几条线，页内三个横 tab；写文案按这里的基调出稿
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteTc);
    if (ntc) ntc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (ntc) renderNoteTaskCfg(ntc);
    return;
  }
  if (name === 'noteArchive') {
    // 笔记档案：每次切入都重渲染（刚定稿/改过状态的那篇要立刻反映出来）
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteA);
    if (nac) nac.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (nac) renderNoteArchive(nac);
    return;
  }
  if (name === 'noteFilm') {
    // 出片台：口播稿 → 分幕 → 配音 → 本机出片（内嵌 video.html?embed=1，不再另开窗口）
    _markTop(tabNote); _hideSub(); _hideAll();
    if (noteTabs) noteTabs.style.display = '';
    _markNote(tabNoteA);   // 出片台也是「笔记档案」的衍生页：左栏二级同样停在档案上
    if (fmc) fmc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    filmFrameGo();
    npFilmPaint();   // 盖板（第一步选成片形式）跟着这一篇重画：露台还是盖住、盖哪一层都在这儿定
    return;
  }
  if (name === 'diagnose') {
    _markTop(tabDiag); _hideSub(); _hideAll(); if (dc) dc.style.display = '';
    if (diagSubTabs) diagSubTabs.style.display = '';   // 二级栏只属于「诊断&配置」，跟在它正下方
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (dc && !_diagLoaded) { _diagLoaded = true; renderDiagnosis(dc); }
    return;
  }
  if (name === 'settings') {
    // 设置：整台配置中心内嵌在本页（iframe），二级＝它的 13 个页；arg ＝ 要落到哪一页
    _markTop(tabSettings); _hideSub(); _hideAll();
    if (setTabs) setTabs.style.display = '';
    if (sc) sc.style.display = '';
    document.querySelectorAll('#setTabs [data-stab]').forEach(t => t.classList.toggle('active', t.getAttribute('data-stab') === (arg || _setTab)));
    _setPanelLeftVisible(false); _setToolbarMode('none'); _setProspectCleanMode(true);
    settingsFrameGo(arg);
    return;
  }
  if (name === 'taskCfg') {
    // 任务配置：获客的第一个二级页——搜什么词 / 盯谁 / 更多设置（页内三级 tab）
    _huokeSub = 'taskCfg';
    _markTop(tabHuoke); _showSub(); _markSub(tabTaskCfg); _hideAll(); if (dcc) dcc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (dcc) renderDrainCfg(dcc);
    return;
  }
  if (name === 'scenarioDrain') {
    // 笔记池：获客的二级页之一（每次切入都重渲染，实时反映刚登记/更新的笔记）
    _huokeSub = 'scenarioDrain';
    _markTop(tabHuoke); _showSub(); _markSub(tabPool); _hideAll(); if (src2) src2.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (src2) renderScenarioDrain(src2);
    return;
  }
  if (name === 'queue') {
    // 队列：配置表派生出待跑队列，执行器按队列串行跑（执行器就在本页顶栏）
    _huokeSub = 'queue';
    _markTop(tabHuoke); _showSub(); _markSub(tabQueue); _hideAll(); if (dqc) dqc.style.display = 'flex';
    // 左栏的笔记列表（灌水那份）跟队列没关系，这页不占位，整页留给队列
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    if (dqc) renderDrainQueue(dqc);
    return;
  }
  if (name === 'huokeCfg') {
    // 获客 · 设置：拟人化与频率——灌水跑多少/多久不重复 + 挡位/各环节停留间隔 + 关注行为。
    // 这套是获客自己的跑法口径，页内就是配置中心的 #delays 一页
    _huokeSub = 'huokeCfg';
    _markTop(tabHuoke); _showSub(); _markSub(tabHuokeCfg); _hideAll(); if (hcc) hcc.style.display = '';
    _setPanelLeftVisible(false); _setToolbarMode('prospectList'); _setProspectCleanMode(true);
    _embedSettingsFrame('huokeCfgFrame', 'delays');
    return;
  }
  // comment（工作台）或默认
  _huokeSub = 'comment';
  _markTop(tabHuoke); _showSub(); _markSub(tabComment); _hideAll(); if (mc) mc.style.display = '';
  renderCqBar();   // 💬 回到工作台页：把本条商机的进度条按现场重新拉起来（切走时 _hideAll 已收起）
  _setPanelLeftVisible(true); _setToolbarMode('comment'); _setProspectCleanMode(false);
  // 📖 评论策略：口径 / 节奏是页面上的下拉（不在 storage 里），切回本页时按现场重画一次
  try { if (window.drainPaintStrategy) window.drainPaintStrategy(document.getElementById('hwStrat')); } catch (_) {}
}

// ★ 获客清单页：隐藏评论助手的整个工具栏（标题/返回列表/下拉按钮/刷新/设置）+ 状态栏 + noteInfo，只留清单内容
function _setProspectCleanMode(on) {
  const rt = document.querySelector('.right-toolbar');
  const sb = document.getElementById('statusBar');
  const ni = document.getElementById('noteInfo');
  const bl = document.getElementById('btnBackToList');
  const set = (el, d) => { if (el) el.style.display = d; };
  if (on) {
    set(rt, 'none'); set(sb, 'none'); set(ni, 'none'); set(bl, 'none');
  } else {
    set(rt, ''); set(sb, ''); set(ni, '');
    // bl(返回列表) 由评论区自身控制展示，这里不强制恢复
  }
}
let _notePublishLoaded = false;
let _diagLoaded = false;
let _drainLoaded = false;

/* ═══════════ ✍️ 写文案（卖点 → 人群 → 话题 → 挑稿 → 改稿 → 发稿）；造图片/出片台从「笔记档案」那一行进 ═══════════ */
function _npEl(container, id) { return container ? container.querySelector('#' + id) : null; }

let _npWiz = null;
/* 造图片（独立页）自己的状态：形状跟 _npWiz 一模一样，所以「选形式 / 造图片 / 教程」那整套函数原样能用。
   一份料挂一档：造图片只认「档案里的这一篇」，改完直接写回那一档（npArchiveSave(_npOut)）。
   带 npS() 的那批函数两套共用：_npMode＝'out' 时认 _npOut，在写文案向导里时认 _npWiz。 */
let _npOut = null;
let _npMode = 'wizard';   // 台上开着的是哪一页：'wizard'＝写文案向导，'out'＝造图片页，'guide'＝发布教程页，'task'＝出图/出片任务列表页（后三页共用 _npOut 那份按篇状态）
function npS() { return ((_npMode === 'out' || _npMode === 'guide' || _npMode === 'task') && _npOut) ? _npOut : _npWiz; }
let _npWizKeys = ['卖点', '人群', '话题', '挑稿', '改稿', '发稿'];
let _npPlanCache = null;   // 发笔记读规划：进向导时读一次（向导期间规划不会变）
async function npLoadPlanCache() {
  try { const d = await chrome.storage.local.get('note_plan'); return (d && d.note_plan) || null; } catch (_) { return null; }
}
function _npTypeName(k) {
  try { const t = NotePlan.typeOf(k); if (t) return t.name; } catch (_) {}
  return String(k || '');
}
function _npKindName(k) {
  try { const x = NotePlan.kindOf(k); if (x) return x.name; } catch (_) {}
  return '';
}
// 规划 → 发笔记（③ 选话题那一步）：把规划里「下一篇还没写过的」摆上来，一键接上
function npPlanCardHtml() {
  const plan = _npPlanCache;
  const items = (plan && Array.isArray(plan.items)) ? plan.items : [];
  if (!items.length) return '';
  const w = _npWiz || {};
  const cur = w.planItem || null;
  const next = items.find(it => it && !it.done) || null;
  const done = items.filter(it => it && it.done).length;
  const meta = (it) => {
    const t = _npTypeName(it.type);
    const k = _npKindName(it.kind);
    return t + (k && k !== t ? ' · ' + k : '') + (it.scope === 'samePeople' ? ' · 同人群' : (it.scope === 'breakout' ? ' · 破圈' : ''));
  };
  // 📅 栏目：长期栏目里那一篇，标上「星期几 · 栏目名」——到那天发这一篇
  const colTag = (it) => (it && it.col)
    ? '<span style="font-size:10px;color:#7a5af5;background:#f4f1ff;border:1px solid #e0d9ff;border-radius:8px;padding:0 5px;margin-left:5px;">📅 ' +
      ((it.day && NotePlan.columnDayName) ? NotePlan.columnDayName(it.day) : '日子自定') + ' · ' + esc(it.col) + '</span>'
    : '';
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:10px;background:#f8fafd;margin-bottom:10px;">' +
    '<div style="font-weight:700;font-size:12px;">📚 按规划发（已成稿 ' + done + '/' + items.length + '）</div>' +
    ((plan && plan.weekText) ? '<div style="font-size:10px;color:#7a5af5;margin-top:2px;">📅 每周固定：' + esc(plan.weekText) + '</div>' : '');
  if (cur) {
    h += '<div style="font-size:11px;color:#0a7b5a;margin-top:4px;">已选：第 ' + esc(String(cur.no || '')) + ' 篇「' + esc(cur.title || '') + '」' + colTag(cur) + '——成稿按它的类型与写法写（' + esc(meta(cur)) + '）。</div>' +
      '<button type="button" id="npPlanClear" class="btn btn-outline" style="margin-top:6px;font-size:11px;">不用规划，自己选话题</button>';
  } else if (next) {
    h += '<div style="font-size:11px;color:#666;margin-top:4px;">下一篇该发：</div>' +
      '<div style="font-size:12px;font-weight:600;margin-top:3px;">' + esc(String(next.no || '') + '. ' + (next.title || '')) + colTag(next) + '</div>' +
      '<div style="font-size:11px;color:#888;margin-top:1px;">' + esc(meta(next)) +
        (next.arc ? ' · 系列 ' + esc(next.arc.name || '') + ' ' + next.arc.part + '/' + next.arc.total : '') + '</div>' +
      (next.credential ? '<div style="font-size:11px;color:#8a929e;margin-top:1px;">凭据：' + esc(next.credential) + '</div>' : '') +
      '<button type="button" id="npPlanUse" class="btn btn-primary" style="margin-top:6px;font-size:11px;">按这条写</button>';
  } else {
    h += '<div style="font-size:11px;color:#666;margin-top:4px;">第一批排产都成稿了。去「诊断&amp;配置 → 规划」点「重新生成规划与评估」补下一批。</div>';
  }
  return h + '</div>';
}
// 成稿成功后把规划里那篇标成已完成（下次进来「下一篇」自动往后走）
async function npPlanMarkDone(item) {
  if (!item || !item.no) return;
  try {
    const p = _npPlanCache;
    if (!p || !Array.isArray(p.items)) return;
    const hit = p.items.find(x => x && x.no === item.no);
    if (!hit || hit.done) return;
    hit.done = true; hit.doneAt = Date.now();
    await chrome.storage.local.set({ note_plan: p });
    if (_npWiz && _npWiz.planItem && _npWiz.planItem.no === item.no) _npWiz.planItem = null;
  } catch (_) {}
}
let _lastScanWasAuto = false; // ★ 本次刷新是否由机器人/自动模式驱动（抓取异常时走"跳过"而非红色打断）

/** 平台 id：写稿半段固定「小红书」（口径统一）；⑥ 里＝当前正看着的那一版（多平台版本条切换） */
function npPid(w) {
  const p = (w && w.platform) || '';
  if (typeof Platforms === 'undefined') return 'xhs';
  return Platforms.has(p) ? p : ((_npWiz && _npWiz.platform) || Platforms.DEFAULT_ID);
}
/* 已发过池按平台分开记：一篇成稿派生到别的平台＝同一个话题再发一次，不该被自己那边判成重复 */
async function npUsedPool(pid) {
  const want = pid || npPid(_npWiz);
  try {
    const d = await chrome.storage.local.get('np_used_topics');
    const a = Array.isArray(d['np_used_topics']) ? d['np_used_topics'] : [];
    return a.filter(x => x && (x.platform || 'xhs') === want).map(x => (x && x.text) || '').filter(Boolean);
  } catch (_) { return []; }
}
/** 档案里写过的话题（按平台）：③ 出候选时排除掉，省得同一台机器反复写同一个题；
 *  ③ 的列表里也把它们摆出来（标「写过」），要重写同一个题是用户自己的选择 */
async function npWrittenTopics(pid) {
  const want = pid || npPid(_npWiz);
  const out = [];
  try {
    (await npNotesAll()).forEach(n => {
      if (!n || (n.platform || 'xhs') !== want) return;
      const t = String(n.topic || '').trim();
      if (t && out.indexOf(t) < 0) out.push(t);
    });
  } catch (_) {}
  return out;
}

async function npAddUsed(text, pid) {
  if (!text) return;
  try {
    const d = await chrome.storage.local.get('np_used_topics');
    const list = Array.isArray(d['np_used_topics']) ? d['np_used_topics'] : [];
    list.unshift({ text, platform: (pid || npPid(_npWiz)), fingerprint: String(text), addedAt: Date.now() });
    if (list.length > 500) list.length = 500;
    await chrome.storage.local.set({ 'np_used_topics': list });
  } catch (_) {}
}

// ✍️ 发笔记：AI 选题向导（卖点 → 人群 → 话题 → 挑稿（内容类型：线 × 写法）→ 成稿 → 造图片），成稿出来先停一下让人改，定稿再选「图文 / 视频」
//    preset ＝ 从「笔记档案」那一行点「✏️ 继续编辑」带过来的存档（不给＝起新的一篇）
async function renderNotePublish(container, preset) {
  _npWiz = {
    step: 0, platform: 'xhs',                     // 写稿半段固定按小红书口径写；⑥ 里它＝当前正看着哪一版
    platforms: ['xhs'],                           // 📮 ⑤ 勾的「这条发到哪些平台」（定稿时按它各写一版，可多选）
    verSeed: null, verMap: null, verBaseSnap: null, verGen: 0,   // 定稿：改写种子 / 各平台版本表 / 小红书原稿快照
    sellPoints: [], chosen: [], people: null, peopleError: '', topics: null, topicError: '',
    chosenTopicIdx: -1, chosenPeople: [], loading: false, prodName: '', sellImages: [],
    planItem: null,                                // ③ 选话题时「按规划第 N 篇写」选中的那篇（成稿按它的线/写法/要干嘛写）
    kbEntries: [], kbLoaded: false, chosenKb: [],   // ① 知识库素材：不选＝按卖点自动筛（喂人群/话题/成稿）
    draft: null, revisePrev: '',   // ⑤ 成稿 + 改稿
    path: '',                                     // 造图片页：'image' | 'video'（哪几条路＝按平台取）
    style: { image: '', video: '' },              // 表现形式：只剩视频那格在用（由成片形式派生）；image 是旧档留下的名目，只当老账读
    filmKind: '',                                 // 出片台那一步先选的「成片形式」（一篇一个；空＝还没选）
    visual: null, shots: null,                       // 图文：visual = { cover, images } 由画面表拼出；shots 才是真源
    voice: '', voiceError: '', voicePrev: '', voiceBusy: false,  // 视频：口播稿（可直接改 / AI 改 / 回退一版）
    noteStyle: {},                                // 🎚 这一条的两个覆盖：{ sellTalk, words }（空＝都跟账号默认；配比不在这里改，在「发笔记 → 任务配置」挂在五条线上）
    styleDefault: null, styleTouched: false,
    write: null,                                  // ④ 里改过这一条的「线 × 写法」（挑稿页点中哪篇就定哪篇；不碰排产表和话题）
    variants: null, variantsKey: '', variantsLine: '', variantsError: '', picked: null,   // ④ 挑稿：这条线底下的几种写法各一篇（当前正看着的那条线）
    varCache: {},                                 // ④ 每条线各存一份（切回生成过的那条线直接摆，不再烧 AI）；条件变了 key 对不上自然重出
    styleOpen: false,                             // ④ 底部「就改这一条」的卖货比例/字数折叠块
    hotHook: null, hotCands: null, hotIdx: 0, hotKey: '', hotSeen: [], hotBusy: false, hotErr: '',
                                                  // 🔥 热点线：④ 点到热点线就同步去找一条公开由头（why/angle 就是这篇的基调），不用另点按钮
  };
  container.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line);font-weight:600;color:var(--ink);">
      <span style="display:flex;align-items:center;gap:8px;min-width:0;"><button type="button" class="np-wiz-back" title="回到「笔记档案」——这一篇有没存的改动会先问一句" style="border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:12px;font-weight:700;padding:5px 10px;cursor:pointer;flex:none;">← 笔记档案</button><span>✍️ 写文案 · 卖点到发稿</span></span>
      <span style="display:flex;align-items:center;gap:8px;font-weight:500;">
        <span id="npSaveHint" style="font-size:11px;color:#0a7b5a;"></span>
        <button type="button" class="np-wiz-save" title="把这半篇存进「笔记档案」——没写完也能存（草稿状态），之后在档案那张卡上点「✏️ 写文案」接着写" style="padding:5px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:12px;font-weight:700;cursor:pointer;">💾 保存</button>
      </span>
    </div>
    <div id="npSteps" style="padding:10px 14px;border-bottom:1px solid var(--line);font-size:11px;"></div>
    <div id="npWizBody" style="padding:12px 14px;"></div>
    <div id="npWizNav" style="padding:10px 14px;border-top:1px solid var(--line);display:flex;gap:8px;align-items:center;flex-wrap:wrap;"></div>
  `;
  _npActiveContainer = container;
  ensureNpDelegation();
  _npWiz.prodName = await getProductName();
  _npPlanCache = await npLoadPlanCache();   // 规划那份排产表：这一步读进来，③ 选话题时按它摆「下一篇」
  _npWiz.styleDefault = await npLoadNoteStyle();   // 📐 账号默认（「发笔记 → 任务配置」定的五条线配比/字数）
  _npWiz.styleLook = await npLoadImgLook();        // 🎨 出图默认（四类风格轴 + 画面流派，五十五改）
  await npLoadImgMotifs();                          // 🎭 账号自加的画面流派（内置那十条在 lib/visual-motif.js）
  if (preset) await npWizLoadArchive(preset, container);
  _npWizSnap = npWizSig(_npWiz);   // 进来的样子＝干净基线（回退时据它判有没有改动）
  await npWizRender(container);
}

/** ✏️ 继续编辑：把档案里那一篇灌回向导。
 *  恢复的是「写这一篇时用过的那套」（卖点 / 人群 / 话题 / 素材 / 成稿 / 标题标签 / 形式与料），
 *  arId 仍指着这一档 —— 改完 💾 保存 或 走完定稿，存回去的还是这一篇，不会另起一档。
 *  已经造图片过（选过图文 / 视频，或已有出图提示词 / 口播稿）的落到 ⑥ 造图片，只到成稿的落到 ⑤。 */
async function npWizLoadArchive(n, container) {
  const w = _npWiz;
  if (!w || !n) return;
  w.arId = n.id;
  w.platform = (typeof Platforms !== 'undefined' && Platforms.has(n.platform)) ? n.platform : 'xhs';
  w.platforms = [w.platform];
  w.derivedFrom = n.derivedFrom || '';
  w.derivedFromTitle = n.derivedFromTitle || '';
  // ① 卖点：档案只记了「哪条卖点 + 有没有配图」，配图现去库里取（库里换了图，跟着变）
  w.sellPoints = (n.sellPoints || []).map((p) => ({
    point: String(p.point || ''), why: String(p.why || ''), type: '', play: '',
    image: p.hasImage ? (_npArImgs[String(p.point || '')] || '') : '',
    manual: true,
  }));
  w.chosen = (n.sellPoints || []).map((p, i) => ({
    __i: i, point: String(p.point || ''), why: String(p.why || ''),
    content: String(p.why || ''), image: p.hasImage ? (_npArImgs[String(p.point || '')] || '') : '',
  }));
  // 人群：只有名字，凑成「选定的人」那一份（回 ② 会重新拉一批，勾选按名字对得上就回勾）
  w.chosenPeople = (n.people || []).map((name, i) => ({ __i: i, name: String(name || '') })).filter(x => x.name);
  // 话题：档案只留了最终那一条——③ 里就摆它一条，够往下走（要换题就回 ③ 点「换一批」）
  w.topics = String(n.topic || '').trim() ? [{ topic: String(n.topic), fact: '' }] : [];
  w.chosenTopicIdx = w.topics.length ? 0 : -1;
  // 素材：档案存的是引用（id / 标题），回库里把整条捞回来当已选
  if ((n.kb || []).length) {
    await npLoadKbEntries();
    w.chosenKb = (n.kb || []).map((ref, i) => {
      const e = (w.kbEntries || []).find(x => (ref.id && x.id === ref.id) || (ref.title && x.title === ref.title));
      return e ? Object.assign({ __i: (w.kbEntries || []).indexOf(e) }, e) : { __i: -1, id: String(ref.id || ''), title: String(ref.title || '') };
    });
  }
  w.noteStyle = Object.assign({}, (n.wip && n.wip.noteStyle) || {});
  w.write = (n.wip && n.wip.write) ? Object.assign({}, n.wip.write) : null;
  w.planItem = (n.wip && n.wip.planItem) ? Object.assign({}, n.wip.planItem) : null;
  w.path = String((n.wip && n.wip.path) || '') || (n.form === '视频' ? 'video' : (n.form === '图文' ? 'image' : ''));
  w.style = { image: n.form === '图文' ? String(n.style || '') : '', video: n.form === '视频' ? String(n.style || '') : '' };
  w.filmKind = npKindFromLegacy(n);   // 这一档选过的成片形式（老档只记过视频表现形式的，反推回来）
  // 成稿：正文 / 标题 / 标签 / 建议发布
  if (String(n.draft || '').trim()) {
    w.draft = { content: String(n.draft), titles: (n.titles || []).map(String), tags: (n.tags || []).map(String), timeTip: String(n.timeTip || '') };
    _npNote = { draft: w.draft, title: String(n.title || ''), tags: (n.tags || []).map(String), titleIdx: 0 };
  }
  w.visual = n.visual ? { cover: String(n.visual.cover || ''), images: String(n.visual.images || '') } : null;
  w.voice = String(n.voice || '');
  _npStyleState.dirty = false;
  _npPeopleReady = ''; _npTopicsReady = '';
  // 已经出过料的（选过路 / 有提示词 / 有口播稿）直接落到 ⑥，只到成稿的落到 ⑤
  w.step = (w.draft && (w.path || w.visual || w.voice)) ? 5 : (w.draft ? 4 : Math.max(0, Math.min(3, Number((n.wip && n.wip.step) || 0) || 0)));
  if (typeof toast === 'function') toast('接着写《' + (n.title || String(n.draft || '').split('\n')[0] || '这一篇').slice(0, 18) + '》——改完点「💾 保存」或走完定稿，存的还是这一档');
}

/* ═══════════ 🖼 造图片（按篇，从「出图 / 出片」任务表那一行进） ═══════════
   它是「写文案 · 发稿」那份正文的下游：先有「出图 / 出片」那张任务表（一行＝一个活）→ 点开一行才 ✂️ 断句出画面表 / 口播稿（怎么发出去看「📖 教程」那一页）。
   状态挂在 _npOut 上（字段名跟 _npWiz 一样，所以那套函数原样跑），改完写回同一档
   （npArchiveSave(_npOut)）；口播稿那版直接进「出片台」（noteId＝这一档）。 */
let _npOutOpenRow = '';   // 任务表点「出图」时带过来的那一行：npOpenOutput 用完即清（不清会下一篇也摊在同一行上）

/** 按「档案里这一篇」把台上那份状态灌好：造图片页与「出图 / 出片」任务表页共用，要读的库一并捞齐 */
async function npLoadOutState(n) {
  _npOut = npOutShape(n);
  _npNote = { draft: _npOut.draft, title: String(n.title || ''), tags: (n.tags || []).map(String), titleIdx: 0 };
  _npOut.prodName = await getProductName();
  _npOut.styleDefault = await npLoadNoteStyle();
  _npOut.styleLook = await npLoadImgLook();        // 🎨 出图默认：造图片 ③ 那些轴没选过的就跟它走
  await npLoadImgMotifs();                          // 🎭 账号自加的画面流派
  await npShotImgIndex();          // 画面那几行挂的图＝素材库引用，显示时现取
  return _npOut;
}

/** 同一篇的「别的平台版本」：只在「出图 / 出片」那张表上摆只读行，每次进那一页重扫一遍（别处刚派生的一版要看得见）；
 *  画面流派 chip 那排也在这里重读一次——复用台上状态时（npOutReuse）没走 npLoadOutState，别拿旧表摊给用户 */
async function npLoadOutSibs(n) {
  const w = _npOut; if (!w) return;
  await npLoadImgMotifs();
  try { w.imgSibs = await npImgSibs(n); } catch (_) { w.imgSibs = []; }
  try { w.filmSibs = await npFilmSibs(n.id); } catch (_) { w.filmSibs = []; }
}

/** 台上已经挂着这一篇（造图片 ↔ 任务表互切）就别重读档案：新加那一行还是空的（空行不落档），重读会把它抹掉 */
function npOutReuse(n) {
  return (_npOut && n && String(_npOut.arId || '') === String(n.id)) ? _npOut : null;
}

async function npOpenOutput(container, n) {
  if (!container || !n) return;
  ensureNpDelegation();   // 造图片页可能是在没开过「写文案」的情况下直接进来的，点击事件得先挂上
  const w = npOutReuse(n) || await npLoadOutState(n);
  const hint = _npOutOpenRow; _npOutOpenRow = '';
  if (hint) {
    const r = (w.imgDocs || []).find(x => x && x.id === hint);
    if (r) { w.path = 'image'; npImgUseRow(w, r); }   // 任务表里点的是哪一行，这一页就摊开哪一行
  }
  w.uiTab = 'story';      // 出图列表搬去「出图 / 出片」那一页了：这一页从分镜表开始
  npOutPaint(container);
}

/* ═══════════ 🎯 出图 / 出片（按篇的任务表，入口在「笔记档案」的操作列）═══════════
   老板 2026-10-02 五十八改①：原来「造图片 ① 出图列表」管图、「出片台 那一叠片」管片，两张表各摊一半。
   合成这一张：一行＝一个要出的活——图按「平台 × 画面流派」、片按「平台 × 成片形式」；
   行上两颗按钮分别进造图片 / 出片台。这一页只排活、看进度、报缺口，自己不出料（出的料写回同一档）。
   两份列表的真源也没动：还是档案条目上的 imgDocs / filmDocs，老档照样读得回。 */
async function npOpenTask(container, n) {
  if (!container || !n) return;
  ensureNpDelegation();
  if (!npOutReuse(n)) await npLoadOutState(n);   // 从造图片那页切回来：台上的行与段还留着，别拿档案重灌一遍
  await npLoadOutSibs(n);
  npTaskPaint(container);
}

async function npTaskPaint(container) {
  const w = _npOut; if (!w || !container) return;
  let docs = {};
  try { const d = await chrome.storage.local.get(NP_FILM_DOCS_KEY); docs = (d && d[NP_FILM_DOCS_KEY]) || {}; } catch (_) {}
  if (_npOut !== w) return;              // 读草稿是异步的：回来时台上已经换篇就别写这一屏
  const P = (typeof Platforms !== 'undefined') ? Platforms.get(npPid(w)) : null;
  const title = (_npNote && _npNote.title) || ((w.draft && (w.draft.titles || [])[0]) || '');
  const ghost = 'border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:12px;font-weight:700;padding:6px 12px;cursor:pointer;';
  container.innerHTML =
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px 14px;border-bottom:1px solid var(--line);">' +
      '<span style="font-weight:600;color:var(--ink);">🎯 出图 / 出片</span>' +
      '<span style="font-size:11px;color:#8a929e;">' + (P ? esc(P.icon + ' ' + P.name) : '') +
        (title ? ' · ' + esc(String(title).slice(0, 24)) : '') + '</span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-task-back" style="' + ghost + '">← 笔记档案</button>' +
    '</div>' +
    '<div style="padding:12px 14px;">' +
      npTaskListHtml(w, docs) +
      '<div style="font-size:11px;color:#666;background:#f7f7f8;border-radius:8px;padding:8px 10px;margin-top:10px;">' +
        '这一页只管排活：「🖼 出图」进造图片（断句 → 图描述 → 提示词都在那一页），「🎬 出片」进出片台。' +
        '正文要改写法回「✏️ 写文案」；已出的料都在 <button type="button" class="np-go-archive" style="border:none;background:none;color:#1f6feb;font-size:11px;font-weight:700;cursor:pointer;padding:0;">笔记档案</button> 这一档。' +
      '</div>' +
    '</div>';
}

/** 造图片页那一份状态：字段名跟 _npWiz 对齐，好让「选形式 / 造图片 / 教程」那套函数原样跑 */
function npOutShape(n) {
  const plat = (typeof Platforms !== 'undefined' && Platforms.has(n.platform)) ? n.platform : 'xhs';
  const form = String(n.form || '');
  const topic = String(n.topic || '').trim();
  const hasDraft = !!String(n.draft || '').trim();
  const w = {
    arId: n.id, platform: plat, platforms: [plat], prodName: '',
    derivedFrom: String(n.derivedFrom || ''), derivedFromTitle: String(n.derivedFromTitle || ''),
    draft: hasDraft ? { content: String(n.draft), titles: (n.titles || []).map(String), tags: (n.tags || []).map(String), timeTip: String(n.timeTip || '') } : null,
    revisePrev: '',
    topics: topic ? [{ topic: topic, fact: '' }] : [], chosenTopicIdx: topic ? 0 : -1,
    chosen: (n.sellPoints || []).map((p, i) => ({
      __i: i, point: String(p.point || ''), why: String(p.why || ''), content: String(p.why || ''),
      image: p.hasImage ? (_npArImgs[String(p.point || '')] || '') : '',
    })),
    chosenPeople: (n.people || []).map((name, i) => ({ __i: i, name: String(name || '') })).filter(x => x.name),
    chosenKb: [], kbEntries: [], kbLoaded: false,
    noteStyle: Object.assign({}, (n.wip && n.wip.noteStyle) || {}),
    write: (n.wip && n.wip.write) ? Object.assign({}, n.wip.write) : null,
    planItem: (n.wip && n.wip.planItem) ? Object.assign({}, n.wip.planItem) : null,
    styleDefault: null, styleTouched: false,
    // 这篇走哪条路：档案里记过的照搬（没记过就到这一页重新选）。style.image 是老档留下的旧「出图形式」名，只当老账读；图文现在的身份在 imgDocs 每一行的流派上
    path: (form === '视频') ? 'video' : (form === '图文' ? 'image' : ''),
    style: { image: form === '图文' ? String(n.style || '') : '', video: form === '视频' ? String(n.style || '') : '' },
    filmKind: npKindFromLegacy(n),       // 这一档的成片形式（出片台第一步选的；老档按视频表现形式反推）
    visual: n.visual ? { cover: String(n.visual.cover || ''), images: String(n.visual.images || '') } : null,
    shots: npShotsShape(n.shots),
    // 出图列表：一行＝一个「平台 × 画面流派」，一行一份画面表（老档没记过 imgDocs＝读时按上面那两份合成一行，不回填）
    imgDocs: npImgRowsOf(n), imgOpen: '', imgSibs: [], uiTab: 'story',   // 造图片页里那两档（分镜表 / 预览）：只在台上记，不进档案
    filmDocs: npFilmRowsOf(n), filmSibs: [],   // 片列表的镜像：一行一种成片形式（造图片「拿去出片」把这几行递进出片台）；filmSibs＝同一篇别的平台版本，只在「出图 / 出片」那张表上摆只读行
    voice: String(n.voice || ''), voiceError: '', voicePrev: '', voiceBusy: false,
    step: 5, loading: false, hotHook: null,
    verSeed: null, verMap: null, verBaseSnap: null, verGen: 0,
  };
  // 回到上一次动过的那一行：列表按加的先后排，摊开的那一份跟着「最新改的」走
  const open = w.imgDocs.slice().sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0))[0] || w.imgDocs[0] || null;
  w.imgOpen = (open && open.id) || '';
  if (open && !w.path) w.path = 'image';
  return w;
}

/** 造图片顶上那两档（① 分镜表 · 工作流 / ② 预览）：档位在台上临时记着，不进档案。
 *  原来第一档「出图列表」管的是这一篇有哪几套图——五十八改① 把它搬进「🎯 出图 / 出片」那张任务表了，这一页只管做打开的那一套。 */
function npImgTabsHtml(w) {
  const cur = w.uiTab === 'preview' ? 'preview' : 'story';
  const row = npImgRow(w);
  const tab = (k, label) => '<button type="button" class="np-imgtab" data-t="' + k + '" style="border:1px solid ' +
    (cur === k ? 'var(--c-brand-line)' : 'var(--line)') + ';border-bottom:' + (cur === k ? '2px solid var(--c-brand)' : '1px solid var(--line)') +
    ';border-radius:8px 8px 0 0;background:' + (cur === k ? 'var(--c-brand-soft)' : '#fff') +
    ';color:' + (cur === k ? 'var(--c-brand-text)' : '#8a929e') + ';font-size:12px;font-weight:700;padding:7px 14px;cursor:pointer;">' + label + '</button>';
  const badge = (r) => {
    if (!r) return '';
    const on = npShotsOn(r), got = on.filter(x => (x.imgs || []).length).length;
    if (!on.length) return '还没断句';
    return on.length + ' 段 · ' + got + '/' + on.length + ' 有图';
  };
  return '<div style="display:flex;gap:4px;align-items:flex-end;flex-wrap:wrap;border-bottom:1px solid var(--line);">' +
    tab('story', '① 分镜表 · 工作流') + tab('preview', '② 预览 · 图文对照') +
    '<span style="flex:1;"></span>' +
    (row ? '<span style="font-size:11px;color:#8a929e;padding-bottom:8px;">现在做的是：' +
      esc(npRowMotif(row, w) || '没定流派') + '（' + esc(badge(row)) + '）' +
      (row.style ? '<span style="font-size:10px;color:#b6bec9;"> · 旧：' + esc(row.style) + '</span>' : '') + '</span>'
        : '<span style="font-size:11px;color:#b45309;padding-bottom:8px;">这一篇还没有一行图——回「🎯 出图 / 出片」那张表加一套</span>') +
    '</div>';
}

/** 切档：② 预览也要先有一行图，不然只给一句提示（不作门槛、也不烧 AI） */
function npImgTabPick(container, k) {
  const w = npS(); if (!w || !container) return;
  w.uiTab = (k === 'preview') ? 'preview' : 'story';
  npRenderOutput(container);
}

function npOutPaint(container) {
  const w = _npOut; if (!w || !container) return;
  const P = (typeof Platforms !== 'undefined') ? Platforms.get(npPid(w)) : null;
  const form = w.path === 'video' ? '视频' : (w.path === 'image' ? '图文' : '');
  // 顶上这一格的身份：图文＝这一行按哪一派取材（五十五改撤了「出图形式」那一层）；视频＝这一档的成片形式
  const sty = w.path === 'video' ? npKindOf(w) : (w.path === 'image' ? npRowMotif(npImgRow(w), w) : '');
  const title = (_npNote && _npNote.title) || ((w.draft && (w.draft.titles || [])[0]) || '');
  container.innerHTML =
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px 14px;border-bottom:1px solid var(--line);">' +
      '<span style="font-weight:600;color:var(--ink);">🖼 造图片</span>' +
      '<span style="font-size:11px;color:#8a929e;">' + (P ? esc(P.icon + ' ' + P.name) : '') +
        (form ? ' · ' + esc(form + (sty ? ' · ' + sty : (w.path === 'image' ? ' · 没定流派' : ''))) : '') + '</span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-out-back" style="border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:12px;font-weight:700;padding:6px 12px;cursor:pointer;">← 出图 / 出片</button>' +
    '</div>' +
    '<div style="padding:12px 14px;">' +
      /* 五十四改：造图片整页重做（线框图定稿）——顶上原三档：① 出图列表管任务、② 分镜表接工作流、③ 预览看效果。
         五十八改①：那第一档（这一篇有哪几套图）搬进「🎯 出图 / 出片」那张任务表了，这一页只剩 分镜表 / 预览。
         旧版那一排（正文框 + ① 路卡 + ② 这一份图 + ③ 口播稿）整块注释留着，不删函数，随时能回滚：
      '<div style="border:1px solid var(--line);border-radius:10px;background:#fafbfc;padding:9px 11px;margin-bottom:12px;">' +
        '<b style="font-size:12px;color:#333;">📄 造图片用的这份正文</b>' +
        '<textarea id="npResult" rows="5">' + esc((w.draft && w.draft.content) || '') + '</textarea>' +
      '</div>' +
      '<div id="npPathCards"></div>' + '<div id="npImgList"></div>' +
      '<div id="npVisualBox"></div>' + '<div id="npStyleRow"></div>' + '<div id="npVoiceBox"></div>' +
      */
      '<div id="npImgTabs"></div>' +
      '<div id="npTabBody" style="margin-top:10px;"></div>' +
      '<div id="npExtras" style="font-size:11px;color:#666;background:#f7f7f8;border-radius:8px;padding:8px 10px;margin-top:10px;"></div>' +
    '</div>';
  npRenderOutput(container);
}

/** 造图片页顶上那颗「← 出图 / 出片」：这一页只管一套图的料，回程就是这一套活所在的任务表
 *  （出图列表搬走之后，这一页不再摊「这一篇有哪几套图」） */
async function npOutBack() {
  npArchiveFlushTouch();
  const w = (_npMode === 'out') ? _npOut : null;
  const rec = (w && w.arId) ? await npArFindById(String(w.arId)) : null;
  if (!rec) { switchMainTab('noteArchive'); return; }
  switchMainTab('noteTask', rec);
}

/* ═══════════ 📖 发布教程（独立一页，入口在「笔记档案」的操作列） ═══════════
   原来它挂在造图片页第 ③ 步，老板要它单独出来：造图片只管拿料，这一页只管「这一篇怎么出、最后怎么发」。
   仍然按「档案里这一篇」给（npS() 在 guide 模式下认 _npOut），但这一页只读不写：
   换图文 / 视频只是换着看，既不落档案，也不像造图片那样重出一版料。 */
async function npOpenGuide(container, n) {
  if (!container || !n) return;
  ensureNpDelegation();   // 可能没开过写文案就直接从档案进：点击事件得先挂上
  _npOut = npOutShape(n);
  _npNote = { draft: _npOut.draft, title: String(n.title || ''), tags: (n.tags || []).map(String), titleIdx: 0 };
  _npOut.prodName = await getProductName();
  _npOut.styleDefault = await npLoadNoteStyle();
  _npOut.styleLook = await npLoadImgLook();
  await npLoadImgMotifs();                          // 🎭 账号自加的画面流派
  npGuidePaint(container);
}

/** 这一页顶上那排旋钮：只换「发哪一种」（图文 / 视频）；具体看哪条教程在下面的教程条里换 */
function npGuideKnobsHtml(w) {
  const pid = npPid(w);
  const paths = (typeof Platforms !== 'undefined') ? Platforms.pathsOf(pid) : ['image'];
  const pathBtn = (k) => {
    const c = (typeof Platforms !== 'undefined') ? (Platforms.pathCard(pid, k) || {}) : {};
    return '<button type="button" class="npg-path" data-p="' + npArAttr(k) + '"' + (w.path === k ? ' data-on="1"' : '') + '>' +
      (k === 'image' ? '📝' : '🎬') + ' ' + esc(c.title || (k === 'image' ? '图文' : '视频')) + '</button>';
  };
  return paths.length > 1 ? '<div class="npGuideChips">' + paths.map(pathBtn).join('') + '</div>' : '';
}

function npGuidePaint(container) {
  const w = _npOut; if (!w || !container) return;
  const P = (typeof Platforms !== 'undefined') ? Platforms.get(npPid(w)) : null;
  const paths = (typeof Platforms !== 'undefined') ? Platforms.pathsOf(npPid(w)) : ['image'];
  if (paths.indexOf(w.path) < 0) w.path = paths[0];   // 这篇还没选过走哪条路：给该平台第一条路，教程照样出
  const title = (_npNote && _npNote.title) || ((w.draft && (w.draft.titles || [])[0]) || '');
  container.innerHTML =
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px 14px;border-bottom:1px solid var(--line);">' +
      '<span style="font-weight:600;color:var(--ink);">📖 发布教程</span>' +
      '<span style="font-size:11px;color:#8a929e;">' + (P ? esc(P.icon + ' ' + P.name) : '') + (title ? ' · ' + esc(String(title).slice(0, 24)) : '') +
        '<span class="qhelp" tabindex="0" data-tip="按这一篇的平台和走哪条路给：这一篇怎么出图 / 出片、最后怎么发出去。换图文 / 视频只是换着看，不改档案里已出的料；真要重出那份料，去「🖼 造图片」。">?</span></span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-out-back" style="border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:12px;font-weight:700;padding:6px 12px;cursor:pointer;">← 笔记档案</button>' +
    '</div>' +
    '<div style="padding:12px 14px;">' +
      '<div id="npGuideKnobs">' + npGuideKnobsHtml(w) + '</div>' +
      '<div id="npTutoBox"></div>' +
      '<div style="font-size:11px;color:#8a929e;line-height:1.7;margin-top:12px;">料不在这一页——出图提示词 / 口播稿在「🖼 造图片」，正文在「✏️ 写文案」。</div>' +
    '</div>';
  npGuideBox(container);
}

/** 旋钮 + 教程一起重画（点「换一种」走这里，不碰造图片那套函数） */
function npGuideBox(container) {
  const w = _npOut; if (!w || !container) return;
  const kb = _npEl(container, 'npGuideKnobs');
  if (kb) kb.innerHTML = npGuideKnobsHtml(w);
  const tb = _npEl(container, 'npTutoBox');
  if (tb) tb.innerHTML = npGuideHtml();
}

/** 换路（图文 / 视频）：只改这一页的临时状态，好让教程跟着换 */
function npGuidePickPath(p) {
  const w = _npOut; if (!w || w.path === p) return;
  w.path = p;
  _npGuideK = '';          // 换了「发哪一种」：跟着给那一条路的第一份教程，别停在上一条路读着的那份
  npGuideBox(npGuideC());
}

/** 💾 保存：把手上这半篇存进档案（没写完也能存，草稿状态留着「继续编辑」） */
async function npSaveNow(nc) {
  const w = _npWiz;
  if (!w) return;
  const el = _npEl(nc, 'npSaveHint');
  if (!npArchiveHasWork(w)) {
    if (typeof toast === 'function') toast('这篇还没什么可存的——先把卖点选上、或出个成稿');
    return;
  }
  await npArchiveSave(w, '', { wip: true });
  if (el) { el.textContent = '已存入档案'; setTimeout(() => { if (el.textContent === '已存入档案') el.textContent = ''; }, 2500); }
}

/* 弹窗里的出片台 iframe：首次进入才挂 src（跟设置页同一手），之后切页不重载——
   里面正在调的旋钮、已经分好的幕都留着 */
let _filmReady = false, _filmPending = null;   // 首屏还没加载好时，先把稿子记着，load 回来再递
function filmFrameGo() {
  const f = document.getElementById('filmFrame');
  if (!f) return;
  if (!f.getAttribute('src')) {
    f.addEventListener('load', () => {
      _filmReady = true;
      const p = _filmPending; _filmPending = null;
      if (p) filmHandScript(p.s, p.opts);
    }, { once: true });
    f.setAttribute('src', 'video.html?embed=1');
  }
}

/** 把稿子递给已经在跑的片台；正在出片就不动它。
 *  带 opts.noteId ＝ 打开「这一篇」那份草稿：分幕 / 底图 / 配音参数一起捡回来（关弹窗再进来也接得上）；
 *  不带 ＝ 老口径，等价于「粘稿 + 生成分幕」。
 *  opts.frame：这一档成片形式派生出的画面（'text' 大字 / 'card' 卡片轮播），片台跟着切；
 *  opts.shots＝「🖼 造图片」那张画面表（[{no, text, assetIds}]）——卡片轮播照它把第 N 幕安第 N 张图 */
function filmHandScript(s, opts) {
  const f = document.getElementById('filmFrame');
  if (!f) return '';
  const o = opts || {};
  let r = '';
  try {
    r = o.noteId
      ? f.contentWindow.Film.loadNote({ id: o.noteId, title: o.title || '', script: String(s || ''), frame: o.frame || '', shots: o.shots || null })
      : f.contentWindow.Film.loadScript(s, o);
  } catch (_) {}
  if (r === 'busy' && typeof toast === 'function') toast('出片台正在出片——等这条编完再换稿，或点右上「在新标签页打开」', 'error');
  return r;
}

/** 去出片台：带着口播稿（或这一篇的草稿）就地切过去，没稿子就沿用上次的 */
function npOpenFilm(script, opts) {
  const s = String(script || '').trim();
  const o = opts || {};
  const go = () => {
    switchMainTab('noteFilm');
    if (!_filmReady) { _filmPending = (s || o.noteId) ? { s, opts: o } : null; return; }   // 首屏还在加载：load 回来递
    if (s || o.noteId) filmHandScript(s, o);
  };
  // 带 noteId＝这一篇有自己的草稿，别再往全局那份里写（那个 key 是「单开一页」的续命稿）
  if (!s || o.noteId) { go(); return; }
  try { chrome.storage.local.set({ xhsFilmScript: s }, go); } catch (_) { go(); }
}

/* ═══ 出片台第一步：这一档要做成什么片（五选一，真源＝档案的 filmKind）═══
   没选过 → 盖住片台先选；选的是本机那两种（PPT 字体动效 / 卡片画面叙事）→ 露出台、递稿分幕；
   另外三种（动态视频 / 实拍 / 数字人）不在本机出片 → 盖着一句「这一档怎么出」＋给这一档的料与教程。 */
let _npFilmNote = null;        // { id, title, script, kind, shots, rows:[{id,kind,key,updatedAt}], openId, pid, sibs }
let _npFilmChange = false;     // 点过「换一种」＝已经定过形式，这次是回来重选（改的是「打开那一行」这一片）

function npGoFilm(o) {
  const n = o || {};
  const kind = String(n.kind || '');
  const arId = String(n.noteId || '');
  let rows = (Array.isArray(n.rows) ? n.rows : []).filter(r => r && r.kind);
  if (!rows.length && kind) rows = [{ id: npFilmRowId(), kind: kind, key: arId, updatedAt: 0 }];
  // 打开哪一行＝任务表点的那一行（rowId）；没有 rowId 才按成片形式对号；再没有就落回主行（key＝档案 id）并把它的形式改成刚递来的这个
  const rowId = String(n.rowId || '');
  let open = (rowId && rows.find(r => r && r.id === rowId)) || rows.find(r => r.kind === kind) || null, fixed = false;
  if (!open && kind) {
    open = rows.find(r => r.key === arId) || rows[0] || null;
    if (open) { open.kind = kind; open.updatedAt = Date.now(); fixed = true; }
  }
  if (!open) open = rows[0] || null;
  _npFilmNote = { id: arId, title: String(n.title || ''), script: String(n.script || ''),
    kind: (open && open.kind) || kind, shots: npFilmShots(n.shots),
    rows: rows, openId: open ? open.id : '', pid: String(n.pid || 'xhs') };
  _npFilmChange = false;
  ensureNpDelegation();                                        // 盖板上那几颗按钮挂的是 document 委托：直接从档案进片台时它还没注册过
  switchMainTab('noteFilm');                                   // 里面把 iframe 挂起来
  if (fixed && arId) { try { npFilmRowsSave(arId, rows, kind); } catch (_) {} }   // 顺手把这一行的形式落回档（造图片换过形式没落 filmDocs）
  if (_npFilmNote.kind && npKindLocal(_npFilmNote.kind)) npFilmHand();
  npFilmPaint();
}

/** 「🖼 造图片」那张画面表 → 递给片台的那份：每行一段（含 ⬜ 过场句），带 rowId / 占图号 no / assetIds；片台按"一行＝一段底图、段内再分几幕"建幕 */
function npFilmShots(sh) {
  const items = npShotsShape(sh).items;
  let n = 0;
  return items.map(it => {
    const off = !!it.off;
    return { rowId: String(it.id || ''), no: off ? 0 : (++n), off: off,
      text: String(it.text || ''), assetIds: (it.imgs || []).slice(0) };
  });
}

function npFilmPaint() {
  const gate = document.getElementById('filmGate');
  const bar = document.getElementById('filmBar');
  const fr = document.getElementById('filmFrame');
  if (!gate || !bar || !fr) return;
  const n = _npFilmNote, kind = (n && n.kind) || '';
  const local = !!kind && npKindLocal(kind);
  const cover = !n || !local || _npFilmChange;   // 没定形式／不在本机出片／要重选 → 台子盖着
  gate.style.display = cover ? 'block' : 'none';
  bar.style.display = (n && !cover) ? 'flex' : 'none';
  fr.style.top = (n && !cover) ? '30px' : '0';
  fr.style.height = (n && !cover) ? 'calc(100% - 30px)' : '100%';
  if (!n) { gate.innerHTML = npFilmNoNoteHtml(); return; }
  gate.innerHTML = (!kind || _npFilmChange) ? npFilmPickHtml(n) : npFilmOffHtml(n, kind);
  if (n && !cover) {
    const d = npKindDef(kind) || {};
    bar.innerHTML = '🎬 这一片的成片形式：<b>' + esc(kind) + '</b>' + (d.frame ? '（' + (d.frame === 'card' ? '卡片轮播' : '大字动效') + '）' : '') +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-film-task" style="border:1px solid var(--line);border-radius:7px;background:#fff;color:#666;font-size:11px;padding:3px 9px;cursor:pointer;" title="这一篇还有哪几行活、都到哪一步了——摊在「🎯 出图 / 出片」那张表上">🎯 出图 / 出片</button>' +
      '<button type="button" class="np-kind-change" style="border:1px solid var(--line);border-radius:7px;background:#fff;color:#666;font-size:11px;padding:3px 9px;cursor:pointer;">✏️ 换一种</button>';
  }
}

function npFilmNoNoteHtml() {
  return '<div style="max-width:560px;margin:24px auto;font-size:12px;color:#555;line-height:1.8;">' +
    '<b style="font-size:13px;">这一台是「本机出片」的台子</b><br>' +
    '口播稿 → 分幕 → 配音 → 一条竖版 MP4。要出片的那一篇，回 <b>笔记档案</b> 那一行点「🎯 出图 / 出片」，在那张表上点「🎬 出片」过来——成片形式、稿子、分幕都跟着这一篇走。' +
    '<div style="margin-top:12px;"><button type="button" class="np-film-archive" style="padding:7px 14px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;">🗂 去笔记档案</button></div></div>';
}

function npFilmPickHtml(n) {
  const btn = 'flex:1;min-width:220px;border:1px solid var(--line);border-radius:10px;background:#fff;padding:10px 12px;cursor:pointer;text-align:left;';
  return '<div style="max-width:900px;margin:0 auto;">' +
    '<div style="font-size:13px;font-weight:700;color:#333;">① 这一片要做成什么片？（先定一种；要另一种片回「🎯 出图 / 出片」那张表加一行）</div>' +
    '<div style="font-size:11px;color:#8a929e;line-height:1.7;margin-top:4px;">选完才进得去台子。' +
    (n.script ? '稿子已经在了：' + esc(String(n.script).slice(0, 28)) + '…' : '稿子还没出（回「🖼 造图片」顶上那格文案贴一份）。') + '</div>' +
    '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;">' +
    NP_FILM_KINDS.map(x => '<button type="button" class="np-kind-pick" data-k="' + npArAttr(x.k) + '" style="' + btn + '">' +
      '<div style="font-size:12px;font-weight:700;color:#333;">' + x.icon + ' ' + esc(x.k) + '</div>' +
      '<div style="font-size:11px;color:#666;line-height:1.6;margin-top:4px;">' + esc(x.d) + '</div>' +
      '<div style="font-size:10px;color:' + (x.frame ? '#1f6feb' : '#8a929e') + ';margin-top:5px;">' + (x.frame ? '在这台电脑上出片' : '扩展给料，第三方那边跑') + '</div>' +
      '</button>').join('') + '</div>' +
    '<div style="font-size:11px;color:#8a929e;line-height:1.7;margin-top:12px;">换一种不会改稿子；只是出法不一样（大字 / 卡片 / 出去让 AI 动 / 自己拍 / 数字人）。</div>' +
    (n.id ? '<div style="margin-top:10px;"><button type="button" class="np-film-archive" style="border:none;background:none;color:#1f6feb;font-size:11px;cursor:pointer;padding:0;">← 先回笔记档案</button></div>' : '') +
    '</div>';
}

/** 这一档不在本机出片：给这一档已有的料 + 一条教程路（图 / 稿子都在造图片那一步出好了） */
function npFilmOffHtml(n, kind) {
  const d = npKindDef(kind) || {};
  const g = 'padding:7px 14px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;';
  const ghost = 'border:1px solid var(--line);border-radius:8px;background:#fff;color:#666;font-size:12px;padding:7px 14px;cursor:pointer;';
  const has = !!String(n.script || '').trim();
  return '<div style="max-width:640px;margin:20px auto;">' +
    '<div style="font-size:13px;font-weight:700;color:#333;">' + (d.icon || '🎬') + ' 这一档：' + esc(kind) + '（不在本机出片）</div>' +
    '<div style="font-size:11px;color:#8a929e;line-height:1.7;margin-top:4px;">' + esc(d.d || '') + ' 台子这边只把稿子与提示词给你，生成与拼接在第三方那边按他们的额度跑。</div>' +
    (has ? '<textarea readonly spellcheck="false" rows="8" style="width:100%;box-sizing:border-box;margin-top:10px;padding:8px 10px;border:1px solid #e7e8ec;border-radius:8px;font-size:12px;line-height:1.7;">' + esc(n.script) + '</textarea>' :
      '<div style="font-size:12px;color:#b45309;margin-top:10px;">这一档还没有要念的文案——回「🖼 造图片」顶上那格文案贴一份（出片念的就是它）。</div>') +
    '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">' +
    (has ? '<button type="button" class="np-film-copy" style="' + g + '">📋 复制整段口播稿</button>' : '') +
    '<button type="button" class="np-film-guide" style="' + ghost + '">📖 看这条怎么出、怎么发</button>' +
    '<button type="button" class="np-kind-change" style="' + ghost + '">✏️ 换一种成片形式</button></div></div>';
}

/** 选完落档：只动这一篇的 filmKind（视频那两档的 style 跟着派生，档案那一列才不骗人） */
async function npFilmPickKind(k) {
  const n = _npFilmNote;
  if (!n || !npKindDef(k)) return;
  if (k === n.kind && !_npFilmChange) return;
  n.kind = k; _npFilmChange = false;
  if (typeof editionFeatureOn === 'function' && npKindLocal(k) && !editionFeatureOn('videoFilm')) {
    if (typeof toast === 'function') toast('本机出片是「全功能版」功能：这一档可以先看教程，出片要开全功能版', 'error');
  }
  let r = npFilmCur();
  if (n.id) {
    const prev = _npOut && _npOut.arId === n.id ? _npOut : (_npWiz && _npWiz.arId === n.id ? _npWiz : null);
    const wasStyle = prev ? npStyleOf(prev, 'video') : '';
    if (!r) { r = { id: npFilmRowId(), kind: k, key: n.id, updatedAt: Date.now() }; n.rows = (n.rows || []).concat([r]); n.openId = r.id; }
    else { r.kind = k; r.updatedAt = Date.now(); }
    await npFilmKindSave(n.id, k);
    await npFilmRowsSave(n.id, n.rows, k);
    npFilmMirror(n.id, k, n.rows);
    if (prev && prev.voice && npStyleOf(prev, 'video') !== wasStyle && typeof toast === 'function') {
      toast('口播稿还是按「' + (wasStyle || '通用') + '」那份：要按新形式重念一版，回「🖼 造图片」顶上那格文案自己改', '');
    }
  }
  if (npKindLocal(k)) npFilmHand();
  else if (typeof toast === 'function') toast('这一档不在本机出片：稿子与教程给你', '');
  npFilmPaint();
}

function npFilmKindSave(id, k) {
  return npNotesSync(async () => {
    const list = await npNotesAll();
    let hit = false;
    list.forEach(x => {
      if (!x || x.id !== id) return;
      x.filmKind = k;
      if (x.form === '视频') x.style = NP_KIND_VIDEO_STYLE[k] || String(x.style || '');
      x.updatedAt = Date.now();
      hit = true;
    });
    if (!hit) return;
    try { await chrome.storage.local.set({ [NP_NOTES_KEY]: list }); } catch (_) {}
  });
}

/* ═══════════ 🎬 出片台·片列表：一行＝一种成片形式，一行一份片（各自的草稿按 key 存在 xhsFilmDocs）═══════════
   老板 2026-10-01 五十三改：一个笔记可能既要多平台的片、又要不同形式的多份片，所以台子上也得有一张列表；
   先有列表，再在列表里定「这一片做成哪种片」。真源＝档案条目上的 filmDocs：一行带 kind + 存草稿的 key。
   条目级那一份 filmKind／style＝打开那一行（镜像），所以档案「形式」列、📖 教程、口播稿那条读 filmKind 的地方一律不用改。
   第一条行的 key 恒＝档案 id（老口径：档案那颗「出片台」与旧自检都认它）；再加的行才用 档案id#行id。 */
function npFilmRowId() { return 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

/** 档案里这一篇已有的几片；没有 filmDocs 这个键（老档／还没出过片）才按这一档的 filmKind 合成一行（不回填） */
function npFilmRowsOf(n) {
  if (!n) return [];
  const arId = String(n.id || n.arId || '');
  if (Array.isArray(n.filmDocs)) {
    const rows = n.filmDocs.filter(x => x && typeof x === 'object' && x.kind).map(x => ({
      id: String(x.id || npFilmRowId()), kind: String(x.kind || ''),
      key: String(x.key || arId), updatedAt: Number(x.updatedAt || 0) || 0,
    }));
    if (rows.length) { if (arId && !rows.some(r => r.key === arId)) rows[0].key = arId; return rows; }
  }
  const kind = npKindFromLegacy(n);
  if (!kind) return [];
  return [{ id: npFilmRowId(), kind: kind, key: arId, updatedAt: Number(n.updatedAt || 0) || 0 }];
}

/** 落档那一份：只留认得的成片形式；分幕内容不并进档案（那在 xhsFilmDocs 按 key 存），行里只存指针 */
function npFilmPack(rows) {
  const out = [];
  (Array.isArray(rows) ? rows : []).forEach(r => {
    if (!r || !r.kind || !npKindDef(r.kind)) return;
    out.push({ id: r.id, kind: r.kind, key: String(r.key || ''), updatedAt: Number(r.updatedAt || 0) || 0 });
  });
  return out;
}

/** 台面上打开的那一行（列表空＝null） */
function npFilmCur() {
  const n = _npFilmNote; if (!n) return null;
  const rows = n.rows || [];
  return rows.find(r => r && r.id === n.openId) || rows[0] || null;
}

/** 把打开那一行递给片台（本机两档才递；递的是这一行自己的 key） */
function npFilmHand() {
  const n = _npFilmNote; if (!n) return;
  const r = npFilmCur(); if (!r) return;
  n.kind = r.kind;
  if (npKindLocal(r.kind)) npOpenFilm(n.script, { noteId: r.key, title: n.title, frame: npKindFrame(r.kind), shots: n.shots });
}

/** 让片台把「手上这一行」立刻落盘（换片／开列表前叫一声，别丢最后那 600ms） */
function npFilmFlush() {
  try {
    const f = document.getElementById('filmFrame');
    const F = f && f.contentWindow && f.contentWindow.Film;
    if (F && typeof F.flush === 'function') return F.flush();
  } catch (_) {}
  return Promise.resolve();
}

/** 片台顶上那颗「🎯 出图 / 出片」：先把走开着的这一片存回它自己的草稿，再回那张任务表
 *  （这一篇还有几行活、各是哪一派 / 哪一种片，全摊在那一页排，台上不再叠一层列表） */
async function npFilmBackToTask() {
  const id = String((_npFilmNote && _npFilmNote.id) || '');
  await npFilmFlush();
  npArchiveFlushTouch();
  const rec = id ? await npArFindById(id) : null;
  if (!rec) { switchMainTab('noteArchive'); return; }
  switchMainTab('noteTask', rec);
}

/** 同一篇的其他平台版本（各成一档，靠 derivedFrom／本体 id 归一组）：任务表底下摆只读行，点「过去」切进它自己那一档 */
async function npFilmSibs(id) {
  const key = String(id || '');
  if (!key) return [];
  let all = [];
  try { all = await npNotesAll(); } catch (_) { return []; }
  const cur = all.find(x => x && x.id === key);
  if (!cur) return [];
  const grp = String(cur.derivedFrom || cur.id);
  return all.filter(x => x && x.id !== cur.id && String(x.derivedFrom || x.id) === grp).map(x => ({
    arId: x.id, pid: String(x.platform || 'xhs'), kind: npKindFromLegacy(x), title: String(x.title || ''),
  }));
}

/** 落档这一篇的片列表：写条目 filmDocs + 镜像 filmKind／style（打开那一行＝条目那一份） */
function npFilmRowsSave(arId, rows, kind) {
  return npNotesSync(async () => {
    const list = await npNotesAll(); let hit = false;
    const pack = npFilmPack(rows);
    list.forEach(x => {
      if (!x || x.id !== arId) return;
      x.filmDocs = pack;
      if (kind) { x.filmKind = kind; if (x.form === '视频') x.style = NP_KIND_VIDEO_STYLE[kind] || String(x.style || ''); }
      x.updatedAt = Date.now(); hit = true;
    });
    if (!hit) return;
    try { await chrome.storage.local.set({ [NP_NOTES_KEY]: list }); } catch (_) {}
  });
}

/** 台上若还挂着这一篇（造图片／写文案那页），读到的 filmKind／filmDocs 跟着新 */
function npFilmMirror(arId, kind, rows) {
  const pack = npFilmPack(rows);
  [_npOut, _npWiz].forEach(w => {
    if (w && String(w.arId || '') === String(arId)) { if (kind) w.filmKind = kind; w.filmDocs = pack; }
  });
}

/** 删一片顺手把那份分幕草稿从 xhsFilmDocs 里摘掉（按 key） */
function npFilmDocDrop(key) {
  return (async () => {
    try {
      const d = await chrome.storage.local.get(NP_FILM_DOCS_KEY);
      const docs = (d && d[NP_FILM_DOCS_KEY]) || {};
      if (docs[key]) { delete docs[key]; await chrome.storage.local.set({ [NP_FILM_DOCS_KEY]: docs }); }
    } catch (_) {}
  })();
}

function npStepBar(container) {
  const el = _npEl(container, 'npSteps');
  if (!el || !_npWiz) return;
  const step = _npWiz.step;
  // 连接线（分隔两个 step），step 已过或当前进度后的线点亮
  const link = (after) =>
    '<span style="flex:1;height:2px;border-radius:2px;background:' +
    ((after < step || after <= step) ? 'var(--grad-brand);' : '#e5e6eb;') +
    'margin:0 4px 20px;"></span>';
  const badge = (i) => {
    const on = i < step;         // 已完成
    const cur = i === step;      // 当前
    const done = on || cur;
    const clickable = i <= step; // 可跳转：回到已完成/当前步骤
    return (clickable
      ? '<button type="button" data-ngo="' + i + '" style="width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;line-height:1;flex:none;border:none;cursor:pointer;color:' +
        (done ? '#fff' : '#9aa0ac') +
        ';background:' + (done ? 'var(--grad-brand)' : '#eef0f4') +
        ';box-shadow:' + (cur ? '0 0 0 3px var(--c-brand-soft2);' : 'none') + '" title="跳转到此步骤">' + (on ? '✓' : (i + 1)) + '</button>'
      : '<span style="width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;line-height:1;flex:none;color:#9aa0ac;background:#eef0f4;">' + (i + 1) + '</span>');
  };
  const label = (i) =>
    '<span style="text-align:center;font-size:11px;line-height:1.2;color:' +
    (i === step ? 'var(--c-brand-text)' : (i < step ? '#333' : '#9aa0ac')) +
    ';font-weight:' + (i === step ? '800' : '600') + ';">' +
    _npWizKeys[i] + '<br><span style="color:' + (i < step ? 'var(--c-brand-text)' : '#c6cad2') + ';font-weight:500;font-size:10px;">' +
    (onLabel(i)) + '</span></span>';
  el.innerHTML =
    '<div style="display:flex;align-items:flex-start;">' +
    _npWizKeys.map((s, i) =>
      '<div style="display:flex;flex-direction:column;align-items:center;width:44px;flex:none;">' + badge(i) + label(i) + '</div>' +
      (i < _npWizKeys.length - 1 ? link(i) : '')
    ).join('') + '</div>';
  el.querySelectorAll('[data-ngo]').forEach(elBtn => elBtn.addEventListener('click', function () {
    npGo(container, parseInt(this.getAttribute('data-ngo'), 10));
  }));
}
function npGo(container, i) {
  if (!_npWiz || _npWiz.loading) return;
  if (i < 0 || i >= _npWizKeys.length || i > _npWiz.step) return; // 只能回到已达步骤，不许跳未来
  if (_npWiz.step === 5 && i < 5) npVerRestoreBase(_npWiz);   // 从造图片退回写稿半段：视图落回小红书原稿
  _npWiz.step = i;
  // 回到某一步 = 想重来这一步：把上一次的报错清掉，让它能重新拉一次
  if (i === 1) _npWiz.peopleError = '';
  if (i === 2) _npWiz.topicError = '';
  npWizRender(container);
}
function onLabel(i) {
  if (i === 0) return '卖什么';
  if (i === 1) return '给谁看';
  if (i === 2) return (typeof Platforms === 'undefined') ? '聊什么' : Platforms.topicStepHint(npPid(_npWiz));
  if (i === 3) return '挑一篇';
  if (i === 4) return '改到满意';
  return '各平台各一版';
}

/** ⑥ 发稿：这条发到哪些平台（可多选）。写稿半段统一按小红书口径；勾了别的平台，发稿时按各自的规矩各改写一版 */
function npPlatformPickHtml() {
  if (typeof Platforms === 'undefined') return '';
  const sel = (_npWiz && _npWiz.platforms) || [];
  return '<div style="border:1px dashed #cfe3ff;background:#f7fbff;border-radius:10px;padding:10px 12px;">' +
    '<div style="font-size:11px;font-weight:700;color:#1f6feb;margin-bottom:6px;">📮 改满意了，这条发到哪些平台（可多选）</div>' +
    '<div style="display:flex;gap:6px;flex-wrap:wrap;">' +
    Platforms.LIST.map(p => {
      const on = sel.includes(p.id);
      return '<label style="display:flex;align-items:center;gap:6px;border:1px solid ' + (on ? 'var(--c-brand)' : 'var(--line)') + ';border-radius:8px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';padding:6px 10px;cursor:pointer;font-size:12px;color:' + (on ? 'var(--c-brand-text)' : '#333') + ';font-weight:600;">' +
        '<input type="checkbox" class="np-pfm" data-pid="' + npArAttr(p.id) + '"' + (on ? ' checked' : '') + '>' +
        p.icon + ' ' + esc(p.name) + '</label>';
    }).join('') + '</div>' +
    '<div style="font-size:10px;color:#8a929e;margin-top:6px;">正文先按 📕 小红书的口径写；勾了别的平台，点「改好了 · 去发稿」定稿时按各自的规矩各改写一版（事实、卖点不变），各成一档、各标各的发布状态。</div></div>';
}
/** 成稿/造图片页顶部：本次发笔记的工作流选择汇总（「底稿来源」那行只在造图片页给，成稿页同一屏里不再重复一遍） */
function npChoicesSummary(withOrigin) {
  const w = _npWiz; if (!w) return '';
  const topic = (w.topics && w.topics[w.chosenTopicIdx] && w.topics[w.chosenTopicIdx].topic) || '';
  const sell = (w.chosen || []).map(x => x.point || x).filter(Boolean);
  const people = (w.chosenPeople || []).map(p => (p && p.name) || '').filter(Boolean);
  const kb = (w.chosenKb || []).map(e => (e && e.title) || '').filter(Boolean);
  const cell = (label, icon, items, fallback) =>
    '<div style="flex:1;min-width:120px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 10px;">' +
    '<div style="font-size:10px;color:#8a929e;font-weight:700;margin-bottom:3px;">' + icon + ' ' + label + '</div>' +
    (items.length ? items.map(x => '<div style="font-size:11px;color:#333;font-weight:600;line-height:1.5;">' + esc(x) + '</div>').join('') : '<div style="font-size:11px;color:#bbb;">' + esc(fallback) + '</div>') +
    '</div>';
  const P = (typeof Platforms !== 'undefined') ? Platforms.get(npPid(w)) : null;
  // 📮 发到：⑤ 勾了哪几个就是哪几个；⑥ 里＝这条实际有的那几版（补写出来的也算）
  const pfIds = ((w.step >= 5 && w.verMap && w.verMap.pids.length)
    ? w.verMap.pids
    : ((w.platforms && w.platforms.length) ? w.platforms : [npPid(w)]));
  const pfItems = (typeof Platforms !== 'undefined')
    ? pfIds.map(id => { const p = Platforms.get(id); return p ? p.icon + ' ' + p.name : ''; }).filter(Boolean)
    : [];
  // ④ 挑稿＝线 × 写法：先摆这一篇走哪条线、用了哪种写法（点中哪篇样稿就定哪篇；自己想的题＝③ 里 AI 判的，从排产表接的＝那一篇的），再摆配比/话术/字数
  const lineItems = [];
  const _piSum = npEffPlanItem(w);
  const _tSum = (_piSum && _piSum.type && NotePlan.typeOf(_piSum.type)) || null;
  if (_tSum) {
    const _kSum = (_piSum.kind && NotePlan.kindOf(_piSum.kind)) ? NotePlan.kindOf(_piSum.kind) : null;
    const _wSum = npWritePick(w);
    lineItems.push('📄 ' + _tSum.name + (_kSum ? ' · ' + _kSum.name : '') +
      (_wSum ? '（这条换过）' : (_piSum.fromTopic ? '（AI 按题判的）' : '（规划里那篇）')));
  }
  const shSum = npShape(w);
  const shapeText = shSum ? ('铺垫 ' + shSum.build + '% / 展开 ' + shSum.core + '% / 产品 ' + shSum.sell + '%') : '';
  const talk = npTalk(w);
  const words = npWords(w);
  const styleItems = lineItems.concat(shapeText ? ['📐 ' + shapeText] : []).concat(talk ? ['卖货话术 ' + talk.name] : []).concat(words ? ['字数 ' + words.range] : []);
  return '<div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 10px;">' +
    cell('发到', '📮', pfItems, '未选') +
    cell('① 卖点', '🎯', sell, '未选') +
    cell('② 人群', '👥', people, '未选') +
    cell('③ ' + (P ? Platforms.topicNoun(P.id) : '话题'), '💬', topic ? [topic] : [], '未选') +
    cell('④ 挑稿', '📄', styleItems, '未选') +
    cell('📚 素材', '', kb, '不选＝按卖点自动筛') +
    (withOrigin ? '<div style="width:100%;font-size:10px;color:#9aa0ac;">以上卖点/人群/话题/写法就是这篇的底稿来源（各平台版本都从它改写），📚 决定正文引用哪些知识库素材。</div>' : '') +
    '</div>';
}
/** ⑤ 改稿页顶部：只留一句「这篇在写什么」——卖点 / 人群 / 话题（原来那一排工作流汇总格整排撤了） */
function npBriefLineHtml() {
  const w = _npWiz; if (!w) return '';
  const topic = (w.topics && w.topics[w.chosenTopicIdx] && w.topics[w.chosenTopicIdx].topic) || '';
  const sell = (w.chosen || []).map(x => x.point || x).filter(Boolean).join('、');
  const people = (w.chosenPeople || []).map(p => (p && p.name) || '').filter(Boolean).join('、');
  const seg = (icon, label, val) => val
    ? '<span style="color:#8a929e;">' + icon + ' ' + label + '</span> <b style="color:#333;font-weight:600;">' + esc(val) + '</b>'
    : '';
  const line = [seg('🎯', '卖点', sell), seg('👥', '人群', people), seg('💬', '话题', topic)].filter(Boolean).join('<span style="color:#ddd;margin:0 8px;">｜</span>');
  return '<div style="font-size:11px;line-height:1.8;margin-bottom:8px;">' + (line || '<span style="color:#bbb;">（没带前面的选择）</span>') + '</div>';
}
/** 汇总行外面包一层：⑤ 勾平台/⑥ 切版本时就地重绘这一块，不动页面上其他东西 */
function npChoicesSummaryWrap(withOrigin) {
  return '<div id="npSummary">' + npChoicesSummary(withOrigin) + '</div>';
}
function npSummaryPaint(nc) {
  const el = _npEl(nc, 'npSummary');
  if (el) el.innerHTML = npChoicesSummary(!!(_npWiz && _npWiz.step === 5));
}
function npBody(container, html) { const el = _npEl(container, 'npWizBody'); if (el) el.innerHTML = html; }
function npNav(container, items) { const el = _npEl(container, 'npWizNav'); if (el) el.innerHTML = items || ''; }
function btnWiz(cls, label, primary, disabled, why) {
  return '<button class="' + cls + '" type="button" style="padding:8px 14px;border-radius:8px;font-weight:700;font-size:12px;' + (disabled ? 'opacity:.5;cursor:not-allowed;' : 'cursor:pointer;') + (primary ? 'border:none;background:var(--grad-brand);color:var(--c-brand-on);' : 'border:1px solid var(--line);background:#fff;color:#666;') + '"' + (disabled ? ' disabled' : '') + (why ? ' title="' + escAttr(why) + '"' : '') + '>' + label + '</button>';
}

/* ═══ 📐 内容基调（四十五改：调子已退市）：账号默认＝五条线与每种写法各自的「篇幅配比 + 字数」，定在「发笔记 → 任务配置」；
   发笔记默认按它写，④ 挑稿那一步可就地改这一条的 🎚 卖货话术比例与 🖋 字数 ═══ */
let _npStyleState = { dirty: false };
async function npLoadNoteStyle() {
  try { const c = await readConfigPlain(); return (c && c.noteStyle) || null; } catch (_) { return null; }
}
/** 账号默认配比与字数的唯一写入口（发笔记 → 任务配置 用）——发笔记里改的那一条不碰 config */
async function npSaveNoteStyle(ns) {
  const cfg = await readConfigPlain();
  cfg.noteStyle = ns;
  await chrome.storage.local.set({ config: (typeof DataPrivacy !== 'undefined') ? await DataPrivacy.lockConfig(cfg) : cfg });
  _diagState.noteStyle = ns;
  if (_npWiz) {
    _npWiz.styleDefault = ns;   // 配比与建议字数跟着账号默认重算（这条自己改过的比例/字数留着不动）
    _npStyleState.dirty = !!_npWiz.draft;   // 已经有成稿：提醒要重新生成才会按新配比写
    _npRefreshStyleStep();
  }
}
/** 这一条定在哪条线 · 哪种写法（篇幅配比与字数都挂在它上面） */
function _npWriteNow(w) {
  try { return npWritePickNow(w || _npWiz) || { type: '', kind: '' }; } catch (_) { return { type: '', kind: '' }; }
}
/** ④ 挑稿这批的底座取「这一条线」的那一份：一批是同一条线的几种写法各出一篇，
    篇幅配比与字数得整批共用一档（写法自己那一份在 ⑤ 成稿时才生效，后台提示词也是按线发的） */
function _npBaseKind(w) {
  const wiz = w || _npWiz;
  return (wiz && wiz.step === 3) ? '' : _npWriteNow(wiz).kind;
}
/** 这条的配比底座：账号默认（写法→线）→ 出厂默认（写法→线）；产品段还没被 🎚 比例盖过 */
function npShapeBase(w) {
  try { return NotePlan.shapeBaseOf(_npWriteNow(w).type, _npBaseKind(w), ((w || _npWiz) || {}).styleDefault || null); } catch (_) { return null; }
}
/** 这条最终的三块配比：产品段＝🎚 比例，剩下的按底座的 铺垫 : 展开 重新切 */
function npShape(w) {
  try { return NotePlan.shapeOf(npShapeBase(w), npTalk(w)); } catch (_) { return null; }
}
/** 这条的卖货话术比例：逐条优先，其次账号默认，都没有＝默认那一档 */
function npTalk(w) {
  const wiz = w || _npWiz;
  const cur = (wiz && wiz.noteStyle) || {};
  const def = (wiz && wiz.styleDefault) || {};
  try { return NotePlan.sellTalkOf(cur.sellTalk || def.sellTalk || ''); } catch (_) { return null; }
}
/** 这条的字数档：逐条优先，其次这条线/这种写法建议的那档 */
function npWords(w) {
  const wiz = w || _npWiz;
  const cur = (wiz && wiz.noteStyle) || {};
  const def = (wiz && wiz.styleDefault) || {};
  try {
    return NotePlan.wordsOf(cur.words) ||
      NotePlan.wordsOf(NotePlan.wordsBaseOf(_npWriteNow(wiz).type, _npBaseKind(wiz), def)) ||
      NotePlan.wordsOf(NotePlan.WORDS_DEFAULT);
  } catch (_) { return null; }
}
/** 只改「这一条」的两个旋钮（🎚 比例 / 🖋 字数）：配比跟账号默认，不在这里改 */
function npStyleSetLocal(ns) {
  if (!_npWiz) return;
  _npWiz.noteStyle = ns;
  _npWiz.styleTouched = true;
  _npStyleState.dirty = !!_npWiz.draft;   // 已经有成稿：提醒要重新生成才会按新的写
  _npRefreshStyleStep();
}
/** 🎚 卖货话术的比例（只改这一条） */
function npStyleSetTalk(key) {
  if (!_npWiz) return;
  const t = NotePlan.sellTalkOf(key);
  npStyleSetLocal(Object.assign({}, _npWiz.noteStyle || {}, { sellTalk: t.key }));
}
/** 🖋 字数（只改这一条）：铺垫铺不铺得开先看它 */
function npStyleSetWords(key) {
  if (!_npWiz) return;
  const w = NotePlan.wordsOf(key);
  if (!w) return;
  npStyleSetLocal(Object.assign({}, _npWiz.noteStyle || {}, { words: w.key }));
}
/** 这条改过比例/字数后，一键回到跟账号默认 */
function npStyleClearLocal() {
  if (!_npWiz) return;
  _npWiz.noteStyle = {};
  _npWiz.styleTouched = false;
  _npStyleState.dirty = !!_npWiz.draft;
  _npRefreshStyleStep();
}
/* ═══ 📄 线 × 写法（形态与节拍归类型）：默认取这篇的底子——排产表那一篇，或 ③ 里 AI 按题判的那条线；
   ④ 里可就地改这一条（存 _npWiz.write），不碰排产表和话题 ═══ */
function npWritePick(w) {
  const wr = ((w || {}).write) || null;
  if (!wr) return null;
  const t = NotePlan.typeOf(wr.type);
  if (!t) return null;
  const kk = (wr.kind && NotePlan.kindOf(wr.kind)) ? NotePlan.kindOf(wr.kind) : null;
  return { type: t.key, kind: (kk && kk.type === t.key) ? kk.key : '' };
}
/** 这条线（含默认底子）：④ 的控件与 ⑤ 那行提示共用 */
function npWritePickNow(w) {
  const pick = npWritePick(w || _npWiz);
  if (pick) return pick;
  const base = npBasePlanItem(w || _npWiz);
  const bt = (base && base.type && NotePlan.typeOf(base.type)) ? NotePlan.typeOf(base.type).key : '';
  const bk = (bt && base.kind && NotePlan.kindOf(base.kind)) ? NotePlan.kindOf(base.kind).key : '';
  return { type: bt, kind: bk };
}
/** 定这一条的线 × 写法：与默认底子一致＝不算换过（write 清空，回到跟排产/话题走） */
function npWriteApply(typeKey, kindKey) {
  if (!_npWiz) return;
  const t = NotePlan.typeOf(typeKey);
  if (!t) return;
  const kd = kindKey ? NotePlan.kindOf(kindKey) : null;
  const k = (kd && kd.type === t.key) ? kd.key : '';
  const base = npBasePlanItem(_npWiz);
  const bt = (base && base.type && NotePlan.typeOf(base.type)) ? NotePlan.typeOf(base.type).key : '';
  const bk = (bt && base.kind && NotePlan.kindOf(base.kind)) ? NotePlan.kindOf(base.kind).key : '';
  _npWiz.write = (t.key === bt && k === bk) ? null : { type: t.key, kind: k };
  if (t.key !== bt) _npVariantsInvalidate();   // 换线＝上一批是别条线的写法，连在途的那一发一起作废，重画时自动按新线重出
  _npStyleState.dirty = !!_npWiz.draft;   // 已经有成稿：提醒要重新生成才会按新形态写
  _npRefreshStyleStep();
}
function npWriteRestore() {
  if (!_npWiz || !_npWiz.write) return;
  _npWiz.write = null;
  _npVariantsInvalidate();
  _npStyleState.dirty = !!_npWiz.draft;
  _npRefreshStyleStep();
}
/** 🔥 热点线那张「本篇借的由头」卡：④ 一挑到热点线，AI 就同步去找（找的期间摆进度）——
    找到的这条就是这批稿子的引子，「这篇的基调」也由它定；没找到就把原因摆出来，别偷偷按泛话题写。 */
function npHotHookHtml(w) {
  const ww = w || {};
  const h = '<div style="font-size:11px;background:#fffdf7;border:1px solid #f0dcb0;border-radius:8px;padding:6px 9px;margin-top:6px;line-height:1.7;color:#8a5a00;">';
  if (ww.hotBusy) {
    return h + '<span id="npHotWait"><span class="loading-spinner"></span>正在去找这周能借的由头…</span>'
      + '<div style="color:#a3894f;margin-top:2px;">AI 先看近期公开话题（社会民生 / 行业 / 公开的娱乐动态），筛出能写感悟、又接得上你产品的，自己挑一条最合适的</div></div>';
  }
  if (ww.hotErr) {
    return h + '❌ ' + esc(ww.hotErr) +
      '<button type="button" class="btn btn-primary npHotAgain" style="font-size:11px;padding:1px 9px;margin:0 0 0 6px;">🔁 再找一次</button></div>';
  }
  const hk = ww.hotHook;
  if (!hk) return h + '🔥 热点线要借一条这周的公开由头：点这条线之后，AI 会去找一条能写感悟、又能接到你产品上的新闻当引子。</div>';
  return h + '<b>🔥 本篇借的由头：' + esc(hk.name || '') + '</b>' + (hk.line ? '——' + esc(hk.line) : '') + '<br>' +
    (hk.why ? '<b>为什么合适：</b>' + esc(hk.why) + '<br>' : '') +
    (hk.angle ? '<b>这篇的基调：</b>' + esc(hk.angle) + '<br>' : '') +
    '<span style="color:#a3894f;">由头来自 AI 的知识（不是实时热搜），可能过时甚至记错——正文只借「大家在聊这件事」这个由头，'
      + '不许写具体日期 / 名次 / 爆料 / 数字；拿不准就别提时效。</span>' +
    '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:5px;">' +
    '<button type="button" class="btn btn-outline npHotSwap" style="font-size:11px;padding:1px 9px;">🔀 换一条</button>' +
    '<input id="npHotSelfText" type="text" maxlength="40" placeholder="或自己贴一条你看到的新闻 / 话题" style="flex:1;min-width:150px;box-sizing:border-box;padding:3px 7px;border:1px solid #e3d9c2;border-radius:6px;font-size:11px;">' +
    '<button type="button" class="btn btn-outline npHotSelfAdd" style="font-size:11px;padding:1px 9px;">用这条</button>' +
    '</div></div>';
}
/** 🔀 内容类型（五条线）：④ 挑稿的切换器——点一条就换，换完自动按那条线底下的几种写法重出一批。
    写法不在这里挑——四十三改起由 ④ 的样稿手机来定：点中哪台＝用那种写法。 */
function npLinePickHtml() {
  const base = npBasePlanItem(_npWiz);
  const pick = npWritePick(_npWiz);
  const now = npWritePickNow(_npWiz);
  const t = now.type ? NotePlan.typeOf(now.type) : null;
  const baseT = (base && base.type && NotePlan.typeOf(base.type)) ? NotePlan.typeOf(base.type) : null;
  const baseK = (baseT && base.kind && NotePlan.kindOf(base.kind)) ? NotePlan.kindOf(base.kind) : null;
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;background:#fff;padding:10px 12px;margin-bottom:8px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
    '<b style="font-size:12px;color:#333;">🔀 内容类型（五条线）· 这条讲哪一类</b>' +
    (pick ? '<span style="font-size:10px;color:#b45309;background:#fff8ee;border:1px solid #f3e2c7;border-radius:8px;padding:0 6px;">这条换过</span>' : '') +
    (pick && baseT ? '<button type="button" class="btn btn-outline npWriteRestore" style="font-size:11px;padding:1px 8px;margin:0 0 0 auto;">↺ 回默认「' +
      esc(baseT.name + (baseK ? ' · ' + baseK.name : '')) + '」</button>' : '') +
    '</div>' +
    '<div style="font-size:11px;color:#8a929e;margin-top:2px;">点一条就换，换完自动按它的几种写法各出一篇。</div>' +
    '<div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:6px;">' + NotePlan.TYPES.map(x => {
      const on = x.key === now.type;
      return '<button type="button" class="npWriteType" data-type="' + x.key + '" title="' + escAttr(x.what + '（作用：' + x.role + '）') + '" style="font-size:12px;padding:4px 11px;border-radius:14px;cursor:pointer;' +
        (on ? 'border:1.5px solid var(--c-brand);color:var(--c-brand-text);background:var(--c-brand-soft);font-weight:700;' : 'border:1px solid #d5dae2;color:#444;background:#fff;') + '">' + (on ? '● ' : '○ ') + esc(x.name) + '</button>';
    }).join('') + '</div>';
  // 🔥 热点线：这条线要借一条本周的公开由头——④ 一点到它就去把由头找回来（不用另点按钮）
  if (t && t.key === 'hot') h += npHotHookHtml(_npWiz);
  return h + '</div>';
}

/** 这一条的话术比例/字数改了就地把正被看着的那一步重画（④ 步的手机、⑤ 步那行提示都读这份状态） */
function _npRefreshStyleStep() {
  if (!_npActiveContainer || !_npWiz) return;
  if (_npWiz.step === 3 || _npWiz.step === 4) npWizRender(_npActiveContainer);
}
function _talkLineText(t) { return String((t && t.line) || '').replace(/\{p\}/g, '产品'); }
/** 🎚 卖货话术的比例：这篇里"卖"占多少（④ 步改这一条 / 任务配置改账号默认，共用） */
function _styleTalkHtml(cur, def) {
  cur = cur || {}; def = def || {};
  const now = NotePlan.sellTalkOf(cur.sellTalk || def.sellTalk || '');
  const inherited = !cur.sellTalk && !!def.sellTalk;
  const chip = function (t) {
    const on = t.key === now.key;
    return '<button type="button" class="npStyleTalk" data-talk="' + t.key + '" title="' + escAttr(_talkLineText(t)) + '" style="display:inline-block;font-size:11px;padding:2px 8px;margin:0 6px 6px 0;border-radius:10px;cursor:pointer;' +
      (on ? 'border:1px solid var(--c-brand);color:var(--c-brand-text);background:var(--c-brand-soft);font-weight:600;' : 'border:1px solid #ddd;color:#444;background:#fff;') + '">' + esc(t.name) + (t.share === '0' ? '' : ' · ' + esc(t.share)) + '</button>';
  };
  return '<div style="border-top:1px dashed var(--line);margin-top:10px;padding-top:8px;">' +
    '<div style="font-size:12px;font-weight:700;">🎚 卖货话术的比例 <span class="qhelp" tabindex="0" data-tip="这篇里&quot;卖&quot;占多少——比例越大越像推荐；标题、正文、结尾引导都按它分配篇幅。">?</span></div>' +
    '<div style="margin-top:6px;">' + NotePlan.SELL_TALK.map(chip).join('') + '</div>' +
    '<div style="font-size:11px;color:#0a7b5a;margin-top:4px;">当前：' + esc(now.name) + (now.share === '0' ? '' : '（约占正文 ' + esc(now.share) + '）') + (inherited ? '（跟账号默认）' : '') + '——' + esc(_talkLineText(now)) + '</div>' +
    '</div>';
}
/** 📐 配比条本体：给最终的三块百分比 + 字数档，画出「铺垫 / 展开 / 产品」各占多少字（④ 与任务配置的编辑面板共用） */
function _shapeBarHtml(sh, words, note) {
  if (!sh) return '';
  const mid = (words && words.mid) || 650;
  const seg = (pct) => Math.round(mid * pct / 100 / 10) * 10;
  const parts = [
    { n: '铺垫', p: sh.build, c: '#8a93a6' },
    { n: '展开', p: sh.core, c: '#ff8a5c' },
    { n: '产品', p: sh.sell, c: 'var(--c-brand)' },
  ].filter(x => x.p > 0);
  return '<div style="display:flex;height:12px;border-radius:6px;overflow:hidden;background:#eef0f4;margin-top:5px;">' +
    parts.map(x => '<div style="width:' + x.p + '%;background:' + x.c + ';"></div>').join('') + '</div>' +
    '<div style="font-size:11px;color:#444;margin-top:4px;line-height:1.7;">' +
    parts.map(x => '<span style="color:' + x.c + ';font-weight:700;">■</span> ' + x.n + ' ' + x.p + '%（约 ' + seg(x.p) + ' 字）').join('　') + '</div>' +
    '<div style="font-size:11px;color:#0a7b5a;margin-top:2px;">→ ' + esc(NotePlan.shapeTail(sh.sell)) + '</div>' +
    (note ? '<div style="font-size:11px;color:#8a929e;margin-top:2px;">' + note + '</div>' : '');
}
/** 📐 篇幅配比条（④ 这一条）：四十五改起配比挂在「这条线 × 这种写法」上，账号默认在「发笔记 → 任务配置」那张表里改 */
function _styleShapeHtml() {
  const wiz = _npWiz || {};
  const sh = npShape(wiz);
  if (!sh) return '';
  const base = npShapeBase(wiz);
  const from = (base && base.sell !== sh.sell) ? ('这条线／写法默认产品占 ' + base.sell + '%，被上面 🎚 比例调成了 ' + sh.sell + '%') : '';
  return '<div style="margin-top:8px;">' +
    '<div style="font-size:12px;font-weight:700;">📐 篇幅配比 <span style="font-size:10px;color:#8a929e;font-weight:500;">（这条线 × 这种写法的魂：三块各占多少字）</span></div>' +
    _shapeBarHtml(sh, npWords(wiz), from) +
    '</div>';
}
/** 🖋 字数：这一篇写多长（默认＝这条线／这种写法建议的那档；有总长规则的平台以平台为准） */
function _styleWordsHtml(cur, def) {
  cur = cur || {}; def = def || {};
  const explicit = NotePlan.wordsOf(cur.words);
  const now = npWords(_npWiz) || NotePlan.wordsOf(NotePlan.WORDS_DEFAULT);
  let pfBase = 'note';
  try { pfBase = Platforms.baseOf(npPid(_npWiz)); } catch (_) {}
  const chip = function (w) {
    const on = w.key === now.key;
    return '<button type="button" class="npStyleWords" data-words="' + w.key + '" title="' + escAttr(w.range) + '" style="display:inline-block;font-size:11px;padding:2px 8px;margin:0 6px 6px 0;border-radius:10px;cursor:pointer;' +
      (on ? 'border:1px solid var(--c-brand);color:var(--c-brand-text);background:var(--c-brand-soft);font-weight:600;' : 'border:1px solid #ddd;color:#444;background:#fff;') + '">' + esc(w.name) + ' · ' + esc(w.range) + '</button>';
  };
  return '<div style="border-top:1px dashed var(--line);margin-top:10px;padding-top:8px;">' +
    '<div style="font-size:12px;font-weight:700;">🖋 字数 <span class="qhelp" tabindex="0" data-tip="这一篇写多长——铺垫和展开铺不铺得开，先看字数够不够。">?</span></div>' +
    '<div style="margin-top:6px;">' + NotePlan.WORDS.map(chip).join('') + '</div>' +
    '<div style="font-size:11px;color:#0a7b5a;margin-top:4px;">当前：' + esc(now.name) + '（' + esc(now.range) + '）' + (explicit ? '' : '（跟这条线／写法建议的）') +
    (pfBase !== 'note' ? '；这个平台的成稿另有总长规则，以平台为准' : '') + '</div>' +
    '</div>';
}
/** ④ 底部那一行摘要 + 折叠的「就改这一条」：配比的家在任务配置那张五条线表上，这里只留话术比例与字数两个旋钮 */
function npStyleSummaryHtml() {
  const w = _npWiz || {};
  const sh = npShape(w);
  const talk = npTalk(w);
  const words = npWords(w);
  const cur = w.noteStyle || {};
  const touched = !!(cur.sellTalk || cur.words);
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;background:#fff;padding:8px 12px;margin-bottom:8px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;color:#444;">' +
    '<b style="font-size:12px;color:#333;">🎚 这一条</b>' +
    '<span class="qhelp" tabindex="0" data-tip="📐 篇幅配比和🖋 建议字数都挂在「五条线 × 写法」上，账号默认在「发笔记 → 任务配置」那张表里改；这里改的话术比例与字数只影响这一条。">?</span>' +
    '配比 ' + (sh ? sh.build + '/' + sh.core + '/' + sh.sell : '—') + ' · 卖货话术 ' + esc(talk ? talk.name : '') + ' · 字数 ' + esc(words ? words.range : '') +
    (touched ? '<span style="color:#b45309;">（这条改过）</span>' : '') +
    '<button type="button" class="btn btn-outline npStyleToggle" style="font-size:11px;padding:1px 8px;margin:0 0 0 auto;">' + (w.styleOpen ? '收起' : '就改这一条 ▾') + '</button>' +
    '</div>' +
    (w.styleOpen ? npStyleKnobsHtml() : '') + '</div>';
  return h;
}
/** 折叠块里的旋钮（就改这一条）：📐 配比预览（跟着比例与字数变）+ 🎚 卖货话术比例 + 🖋 字数 */
function npStyleKnobsHtml() {
  const w = _npWiz || {};
  const cur = w.noteStyle || {};
  const def = w.styleDefault || {};
  let h = _styleShapeHtml();
  if (cur.sellTalk || cur.words) {
    h += '<div style="margin-top:8px;"><button type="button" class="btn btn-outline npStyleRestore" style="font-size:11px;padding:1px 8px;">↺ 这两个回到跟账号默认</button></div>';
  }
  h += _styleTalkHtml(cur, def);
  h += _styleWordsHtml(cur, def);
  return h;
}
/** 这批样稿的条件指纹：换了这些就得重出一批（配比/比例/字数不进指纹——见 npVarSigOf，那三个只提示不重烧） */
function npVarKeyOf(w) {
  if (!w) return '';
  const now = npWritePickNow(w);
  const pi = npEffPlanItem(w);
  const tl = (w.topics || []);
  const tp = (pi && String(pi.title || '').trim()) || ((tl[(w.chosenTopicIdx >= 0 ? w.chosenTopicIdx : 0)] || {}).topic || '');
  let hotName = '';
  try { const hh = npHotOf(w); hotName = (hh && hh.name) || ''; } catch (_) {}
  return [now.type || '', npPid(w), tp, npTopicFactOf(w), npSellPointStr(),
    (w.chosenPeople || []).map(p => (p && p.name) || '').join('|'), npKbKeyOf(w.chosenKb), hotName].join(' · ');
}
/** 这批样稿当时的「怎么写」：📐 篇幅配比 / 卖货话术比例 / 🖋 字数——变了只在页上提示重写，不自动再烧一发 */
function npVarSigOf(w) {
  const sh = npShape(w);
  const talk = npTalk(w);
  const words = npWords(w);
  return ['配比 ' + (sh ? sh.build + '/' + sh.core + '/' + sh.sell : '—'),
    '话术 ' + ((talk && talk.name) || ''), '字数 ' + ((words && words.key) || '')].join(' · ');
}
let _npVariantsBusy = false;
let _npVariantsGen = 0;   // 代次：换线时上一批可能还在路上，回来的结果按代次丢掉，别覆盖成新线的稿子
/** 作废「当前正看着的那一批」（换线 / 换选题 / 点重新生成）：代次加一让在途请求回来也不落稿。
 *  注意不动 varCache —— 每条线各存的那一份要留着：切条线来回看，已经生成过的不该再烧一发 AI，
 *  条件真变了（选题/卖点/人群/素材/由头）时缓存里的 key 自然对不上，会重出。 */
function _npVariantsInvalidate() {
  _npVariantsGen++;
  _npVariantsBusy = false;
  if (_npWiz) { _npWiz.variants = null; _npWiz.variantsError = ''; _npWiz.picked = null; }
}
/** ④ 每条线存一份样稿的小账：{ [线]: {key, variants, sig, picked} } */
function npVarCacheOf(w) {
  const t = w || _npWiz;
  if (!t) return {};
  if (!t.varCache) t.varCache = {};
  return t.varCache;
}
/** 一批出几篇：长档 2 篇（5 篇整稿一次吐会顶穿输出上限，故事线尤其）、短档一次出完，其余 3 篇 */
function npVarBatchSize(wordsKey) {
  return wordsKey === 'long' ? 2 : (wordsKey === 'short' ? 5 : 3);
}
/** 按这条线底下的几种写法各出一篇（分批打，一次几篇；换线＝重打） */
async function npVariantsLoad(container, force) {
  const w = _npWiz;
  if (!w || w.step !== 3 || _npVariantsBusy) return;
  const now = npWritePickNow(w);
  if (!now.type) return;
  // 🔥 热点线：先把这篇要借的那条公开由头找回来（④ 一点到热点线就同步做，不用另点按钮）——
  //   由头是这批稿子的引子，没它写出来的只能是泛话题；找不回来就别烧这一批，
  //   把错误摆在那张卡上等用户点「🔁 再找一次」（renderStep 那条自动出稿也会因此不再空转）
  if (now.type === 'hot') {
    await npHotFind(w, container);
    if (_npWiz !== w || w.step !== 3) return;
    if (!w.hotHook) { npWizRender(container); return; }
  }
  const key = npVarKeyOf(w);
  if (!force && w.variants && w.variantsKey === key) return;
  // 这条线早就生成过（条件也没变）→ 直接把它那一份摆出来。切条线来回看不该每次都烧一发 AI
  //（「重写这批」force=true 才会真的重打，打完覆盖这条线的缓存，别的线留着）
  const cached = npVarCacheOf(w)[now.type];
  if (!force && cached && cached.key === key && (cached.variants || []).length) {
    w.variants = cached.variants;
    w.variantsKey = key; w.variantsSig = cached.sig || npVarSigOf(w); w.variantsLine = now.type;
    w.variantsError = ''; w.picked = (cached.picked == null ? null : cached.picked);
    // 调用方（renderStep ④）刚按「还没有样稿」画完一遍：缓存命中得重画一次，不然样稿摆不出来
    if (_npWiz === w && w.step === 3) npWizRender(container);
    return;
  }
  _npVariantsBusy = true;
  const gen = ++_npVariantsGen;
  w.variants = null; w.variantsError = ''; w.picked = null;
  w.variantsKey = key; w.variantsSig = npVarSigOf(w); w.variantsLine = now.type;
  const pi = npEffPlanItem(w);
  const tl = (w.topics || []);
  const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
  const lineName = (NotePlan.typeOf(now.type) || {}).name || '';
  // 分批：长档 2 篇一批——一次吐 5 篇整稿会顶穿模型输出上限（截断＝JSON 废掉，写故事线最容易踩）
  const allKinds = NotePlan.kindsOfType(now.type) || [];
  const per = npVarBatchSize((npWords() || {}).key);
  const groups = [];
  for (let i = 0; i < allKinds.length; i += per) groups.push(allKinds.slice(i, i + per).map(k => k.key));
  const stopWait = npWaitInto(container, 'npVarStatus',
    'AI 正按「' + lineName + '」的几种写法各写一篇' + (groups.length > 1 ? '（共 ' + groups.length + ' 批）' : ''), 'notewrite', () => _npWiz === w && _npWiz.step === 3);
  let failMsg = '';
  const got = [];
  try {
    for (let gi = 0; gi < groups.length; gi++) {
      if (_npWiz !== w || w.step !== 3 || gen !== _npVariantsGen) return;
      const st = _npEl(container, 'npVarStatus');
      if (st && groups.length > 1) {
        st.textContent = '第 ' + (gi + 1) + '/' + groups.length + ' 批：正在写「' +
          groups[gi].map(k => { const kd = NotePlan.kindOf(k); return (kd && kd.name) || k; }).join('」「') + '」' +
          (got.length ? '（已写好 ' + got.length + ' 篇）' : '');
      }
      const res = await chrome.runtime.sendMessage({
        action: 'aiGenerateWriteVariants',
        platform: npPid(w),
        type: now.type,
        kinds: groups[gi],
        topic: (pi && String(pi.title || '').trim()) || t.topic || '',
        topicFact: npTopicFactOf(w),
        hot: npHotOf(w),
        noteStyle: w.noteStyle || null,
        sellPoint: npSellPointStr(),
        people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '', pain: (p && p.pain) || '', scene: (p && p.scene) || '' })),
        productName: w.prodName,
        kbList: (w.chosenKb || []).map(e => ({ title: e.title || '', content: e.content || '', tags: e.tags || [] })),
      });
      if (_npWiz !== w || gen !== _npVariantsGen) return;
      const vs = res && res.variants;
      if (Array.isArray(vs) && vs.length) got.push.apply(got, vs);
      else failMsg = (res && (res.error || res.message)) || 'AI 没按这条线的写法出稿';
    }
    if (got.length) w.variants = got;
    if (failMsg) {
      const miss = allKinds.length - got.length;
      failMsg = got.length ? ('这批里有 ' + miss + ' 篇没写出来（' + failMsg + '）') : failMsg;
    }
  } catch (e) {
    failMsg = String((e && e.message) || e);
    if (got.length) w.variants = got;
  } finally {
    stopWait();
    if (gen !== _npVariantsGen) return;   // 已经被新一轮（换线/重新生成）顶掉：这一发的结果不作数，也别动新那轮的忙标记
    _npVariantsBusy = false;
    // 整批都写好了才记进这条线的缓存（半批不记：下次进来重打一遍，比捧着缺件的半批强）
    if (!failMsg && (w.variants || []).length) {
      npVarCacheOf(w)[now.type] = { key: w.variantsKey, variants: w.variants, sig: w.variantsSig, picked: null };
    }
    if (_npWiz === w) {
      if (failMsg) w.variantsError = failMsg;
      if (w.step === 3) { npWizRender(container); }
    }
  }
}
/** 一台「手机」样稿（四十七改：一条线底下几种写法各写一篇＝几部并排摆着挑）。
    细状态栏 + 屏内滚动看全文，写法名 / 标题在屏内顶行；点手机下面的「就用这篇 →」带稿进 ⑤。
    🕳 缺料的那种（四十六改）：画成虚线空屏、只有说明，没有正文也没有「就用这篇」——硬写的假典故比空着更坏 */
function npPhoneBarHtml() {
  return '<div style="display:flex;justify-content:space-between;align-items:center;padding:5px 9px 3px;font-size:9px;color:#b6bdc9;line-height:1;flex:none;">' +
    '<span>9:41</span>' +
    '<span style="display:flex;align-items:center;gap:3px;">' +
    '<span style="letter-spacing:1px;">▂▄▆</span>' +
    '<span style="display:inline-block;width:13px;height:6px;border:1px solid #ccd3dd;border-radius:2px;"></span>' +
    '</span></div>';
}
function npVarCardHtml(v, i) {
  const skip = String((v && v.skipped) || '').trim();
  if (skip) {
    return '<div class="npPhone">' +
      '<div class="npPhoneScreen" style="border-style:dashed;border-color:#d7dbe3;background:#fafbfc;">' +
      npPhoneBarHtml() +
      '<div class="npPhoneBody" style="color:#8a929e;">' +
      '<b style="font-size:12px;color:#8a929e;">' + esc(v.kindName || v.kind || '') + '</b>' +
      '<div style="font-size:11.5px;color:#8a6d3b;margin-top:5px;">🕳 缺料 · 补一条素材再来</div>' +
      '<div style="margin-top:5px;line-height:1.7;">这条写法要的料：' + esc(skip) +
      '——产品资料与选中的素材里都没有，没硬写。想写这种：回 ① 补一条素材，再点页脚「🔀 重写这批」。</div>' +
      '</div></div></div>';
  }
  const body = String(v.content || '').replace(/\s+$/g, '');
  return '<div class="npPhone">' +
    '<div class="npPhoneScreen">' +
    npPhoneBarHtml() +
    '<div style="flex:none;padding:0 12px 6px;border-bottom:1px solid #f2f4f7;">' +
    '<b style="font-size:12px;color:var(--c-brand-text);">' + esc(v.kindName || v.kind || '') + '</b>' +
    (v.title ? '<div style="font-size:12.5px;font-weight:600;color:#333;line-height:1.5;margin-top:3px;">' + esc(v.title) + '</div>' : '') +
    '</div>' +
    '<div class="npPhoneBody">' + esc(body) + '</div>' +
    '</div>' +
    '<button type="button" class="btn btn-primary btn-block npVarPick" data-i="' + i + '" style="font-size:12px;padding:6px 0;margin-top:8px;">就用这篇 →</button>' +
    '</div>';
}
/** ④ 挑稿页：先挑内容类型（五条线）→ 这条线底下的几种写法各出一篇 → 点中哪篇就带着它进 ⑤ 成稿 */
function npPickStepHtml() {
  const w = _npWiz || {};
  const now = npWritePickNow(w);
  const t = now.type ? NotePlan.typeOf(now.type) : null;
  const ks = t ? NotePlan.kindsOfType(t.key) : [];
  let h = '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:6px;">④ 挑稿：先挑内容类型，再在这条线的几种写法里挑一篇</div>' +
    '<div style="font-size:11px;color:#8a929e;margin-bottom:8px;">同一个选题，只换内容类型与写法——挑中哪篇就按那篇进 ⑤ 接着改。窗口拉宽一点，几台会一起变宽、字更好认；窄了自动折成两列往下排。</div>' +
    npLinePickHtml() + npStyleSummaryHtml();
  if (!t) {
    return h + '<div style="font-size:12px;color:#c77700;background:#fff8ee;border:1px solid #f3e2c7;border-radius:8px;padding:8px 10px;">先在上面的「🔀 内容类型」里挑一条线，下面就把那条线底下的几种写法各出一篇给你挑。</div>';
  }
  h += '<div id="npVarStatus" style="font-size:12px;color:#888;margin:2px 0 6px;"></div>';
  if (_npVariantsBusy) h += '<div style="font-size:11px;color:#0a7b5a;margin:2px 0 8px;">AI 正在写这批…</div>';
  if (w.variantsError) {
    h += '<div style="font-size:11px;color:#d32f2f;background:var(--c-brand-soft);border:1px solid #f6cfcf;border-radius:8px;padding:8px 10px;margin-bottom:8px;">❌ ' +
      esc(w.variantsError) + '</div>';
  }
  const vs = (w.variants || []);
  if (vs.length) {
    if (w.variantsSig && w.variantsSig !== npVarSigOf(w)) {
      h += '<div style="font-size:11px;color:#b45309;background:#fff8ee;border:1px solid #f3e2c7;border-radius:6px;padding:5px 8px;margin-bottom:6px;">' +
        '⚠️ 这批还是按「' + esc(w.variantsSig) + '」写的，跟你刚改的不一样——点下面的「🔀 重写这批」按现在的口径重写。</div>';
    }
    h += '<div class="npPhoneRow">' + vs.map((v, i) => npVarCardHtml(v, i)).join('') + '</div>';
  } else if (!w.variantsError && !_npVariantsBusy) {
    h += '<div style="font-size:12px;color:#444;background:#f7f9fc;border:1px solid #e5e8ee;border-radius:8px;padding:10px;">' +
      '「' + esc(t.name) + '」底下 ' + ks.length + ' 种写法，点下面「🔀 重写这批」就各出一篇给你挑。</div>';
  }
  return h;
}
/** 点中一篇样稿：这条就定成「这条线 · 那种写法」，这篇正文直接当 ⑤ 的底稿（不再让 AI 从零写一篇） */
function npVarPick(i, container) {
  const w = _npWiz;
  const v = ((w && w.variants) || [])[i];
  if (!v || !v.kind || !v.content) return;
  const now = npWritePickNow(w);
  const base = npBasePlanItem(w);
  const bk = (base && base.kind && NotePlan.kindOf(base.kind)) ? NotePlan.kindOf(base.kind).key : '';
  w.write = (now.type === (base && base.type) && v.kind === bk) ? null : { type: now.type, kind: v.kind };
  w.picked = i;
  const c = npVarCacheOf(w)[now.type];   // 记进这条线的缓存：切走再切回来，还是「已选」那一篇
  if (c) c.picked = i;
  w.draft = { titles: v.title ? [v.title] : [], content: v.content, tags: v.tags || [], timeTip: '', fromVar: true };
  w.revisePrev = ''; w.revSentIdx = -1; w.path = ''; w.visual = null; w.shots = null; w.voice = ''; w.voiceError = ''; w.voicePrev = '';
  _npNote = { draft: w.draft, title: v.title || '', tags: (v.tags || []).slice(), titleIdx: 0 };
  _npStyleState.dirty = false;   // 这篇就是按当前这套（线×写法×配比）写出来的
  w.step = 4;
  npWizRender(container);
  npArchiveSave(w);              // 挑中的这篇也当场进档案（草稿），关掉弹窗不丢
  npPlanMarkDone(w.planItem);
}
/** 重写这批（换线 / 配比·比例·字数改过 / 上一批失败）：先把在途与旧批次一起作废，再按现在的口径重打 */
function npVarAgain(container) {
  _npVariantsInvalidate();
  npVariantsLoad(container, true);
}
// 成稿页顶部那一行：这条按哪条线·哪种写法、三块配比多少、卖货话术占多少、写多长 + 一点就回 ④ 改
function npStyleLineHtml() {
  const sh = npShape();
  const talk = npTalk();
  const words = npWords();
  const cur = (_npWiz && _npWiz.noteStyle) || {};
  let now = { type: '', kind: '' };
  try { now = npWritePickNow(_npWiz) || now; } catch (_) {}
  const wT = now.type ? NotePlan.typeOf(now.type) : null;
  const wK = now.kind ? NotePlan.kindOf(now.kind) : null;
  return '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:11px;color:#8a929e;margin-bottom:6px;">' +
    '📄 ' + (wT ? esc(wT.name + (wK ? ' · ' + wK.name : '')) : '（没带内容类型）') + (npWritePick(_npWiz) ? '（这条换过）' : '') + ' · ' +
    '📐 ' + (sh ? sh.build + '/' + sh.core + '/' + sh.sell : '—') + ' · 卖货话术 ' + esc(talk ? talk.name : '') + ' · 字数 ' + esc(words ? words.range : '') +
    ((cur.sellTalk || cur.words) ? '（话术／字数这条改过）' : '') +
    (_npStyleState.dirty ? '<span style="color:#c77700;"> · 这条改过了，回上一步点「🔀 重写这批」才会按新的写</span>' : '') +
    '<button type="button" id="npStyleOpenFromDraft" class="btn btn-outline" style="font-size:11px;padding:1px 8px;margin:0 0 0 auto;">✏️ 换内容类型和写法</button>' +
    '</div>';
}

async function npWizRender(container) {
  if (!_npWiz) return;
  if (_npWiz.step === 0 && !_npWiz.sellPoints.length && !_npWiz.loading) { await npLoadSellPoints(container); return; }
  if (_npWiz.step === 1 && !_npWiz.people && !_npWiz.peopleError && !_npWiz.loading) { await npLoadPeople(container); return; }
  if (_npWiz.step === 2 && !_npWiz.topics && !_npWiz.topicError && !_npWiz.loading) { await npLoadTopics(container); return; }
  // 话题到手就自动勾第一个：否则「就用这篇 →」是禁用的，点了毫无反应（像卡死）
  if (_npWiz.step === 2 && _npWiz.chosenTopicIdx < 0 && (_npWiz.topics || []).length) _npWiz.chosenTopicIdx = 0;
  npStepBar(container);
  renderStep(container);
  npNav(container, navForStep());
}

/** 拉一次①可选的知识库素材（失败不拦路：不选也能写，退回「整库当背景」） */
async function npLoadKbEntries() {
  try {
    const r = await _diagSay('getKnowledgeBase');
    const list = (r && r.entries) || [];
    _npWiz.kbEntries = list
      .filter(e => e && e.isActive !== false && (String(e.title || '').trim() || String(e.content || '').trim()))
      .map(e => ({
        id: String(e.id || ''),
        title: String(e.title || '').trim(),
        category: String(e.category || '').trim(),
        content: String(e.content || ''),
        tags: Array.isArray(e.tags) ? e.tags.map(t => String(t).trim()).filter(Boolean) : [],
      }));
  } catch (_) { _npWiz.kbEntries = []; }
  _npWiz.kbLoaded = true;
}

/* ① 用过的账：档案里每一篇都记着「用了哪几条卖点 / 哪几条素材 + 写的是哪个话题」——
   把它翻成 卖点→话题、素材→话题 两张表，① 的清单上标出来，免得同一条被反复写、反复撞题。
   只读档案、不另存一份索引：档案就是这件事的真源（删档、改档它跟着变）。 */
let _npUsage = { sell: {}, kb: {} };
async function npUsageIndex() {
  const sell = {}, kb = {};
  const push = (map, key, topic) => {
    if (!key || !topic) return;
    const a = map[key] || (map[key] = []);
    if (a.indexOf(topic) < 0) a.push(topic);
  };
  try {
    const list = await npNotesAll();
    list.forEach(n => {
      if (!n) return;
      const tp = String(n.topic || '').trim();
      (n.sellPoints || []).forEach(p => push(sell, String((p && p.point) || '').trim(), tp));
      (n.kb || []).forEach(e => {
        push(kb, String((e && e.id) || '').trim(), tp);
        push(kb, String((e && e.title) || '').trim(), tp);
      });
    });
  } catch (_) {}
  _npUsage = { sell: sell, kb: kb };
  return _npUsage;
}
/** ① 两张总表（卖点 / 知识库素材）共用的表格样式 */
const _npTbl = {
  table: 'width:100%;border-collapse:collapse;background:#fff;',
  cols4: '<col style="width:30px;"><col style="width:34%;"><col><col style="width:70px;">',
  th: 'padding:6px 8px;font-size:10px;color:#8a929e;font-weight:700;text-align:left;border-bottom:1px solid var(--line);box-sizing:border-box;',
  td: 'padding:7px 8px;font-size:12px;color:#333;vertical-align:top;border-bottom:1px solid #f2f3f5;box-sizing:border-box;',
  tr: (on) => 'cursor:pointer;' + (on ? 'background:var(--c-brand-soft);' : 'background:#fff;'),
  attr: (s) => escAttr(String(s || '')),
};
/** 「写过没有」那一格：写过＝琥珀色徽章 + 次数，没写过＝绿色（一眼看出哪些还没动过） */
function npUsedBadge(topics) {
  const t = (topics || []).filter(Boolean);
  if (!t.length) return '<span style="font-size:10px;color:#2e7d32;">没写过</span>';
  return '<span style="font-size:10px;color:#8a6d3b;background:#fff7e6;border:1px solid #f0dcb0;border-radius:8px;padding:0 5px;">🖊 写过 ' + t.length + ' 次</span>';
}

async function npLoadSellPoints(container) {
  _npWiz.loading = true;
  const kbJob = npLoadKbEntries();   // 素材和卖点是①里并列的两样，卖点怎么来的都要列
  const useJob = npUsageIndex();     // 用过的账：① 清单上要标「这条写过什么」
  // 优先使用用户在「诊断&配置 → 产品卖点」维护的卖点（含配图），直接列出可选
  try {
    const c = await readConfigPlain();
    const spList = (c && c.product && c.product.sellPoints) || [];
    const manual = spList.filter(s => s && (String(s.title || '').trim() || String(s.content || '').trim()));
    if (manual.length) {
      _npWiz.sellPoints = manual.map(s => ({
        point: String(s.title || '').trim(),
        why: String(s.content || '').trim(),
        type: '', play: '',
        image: String(s.image || ''),
        manual: true,
      }));
      _npWiz.strategy = '';
      _npWiz.sellTip = '来自你在「诊断&配置 → 产品卖点」维护的卖点，选中后下方会列出对应配图';
      await kbJob; await useJob;
      _npWiz.loading = false;
      await npWizRender(container);
      return;
    }
  } catch (_) {}
  // ② 未维护卖点时，退回 AI 从产品描述提炼
  npBody(container, '');
  const stopWait = npWaitInto(container, 'npWizBody', 'AI 正在从你的产品提炼可推的卖点');
  try {
    const res = await chrome.runtime.sendMessage({ action: 'aiGenerateSellPoints', platform: npPid(_npWiz) });
    _npWiz.sellPoints = (res && res.sell_points) || [];
    _npWiz.strategy = (res && res.strategy) || '';
  } catch (e) {
    stopWait();
    npBody(container, '<div style="font-size:12px;color:#d32f2f;">提炼卖点失败，先到「诊断&配置 → 基础配置」填产品名称、「产品卖点」填卖点：' + esc((e && e.message) || e) + '</div>');
    _npWiz.loading = false; return;
  }
  stopWait();
  await kbJob; await useJob;
  _npWiz.loading = false;
  await npWizRender(container);
}

/** AI 已生成字数（message 里带 scope 的流式进度写这里），供等待条显示「正在吐字」 */
const _npStreamChars = { notepeople: 0, notetopics: 0, notedraft: 0, noterevise: 0, notecuts: 0, notedescs: 0, notevoice: 0, notewrite: 0 };

/** 等待计时条：AI 在跑的时候把「已等 N 秒 / 已写 N 字」写进指定容器，别让界面看着像卡死。返回停止函数 */
function npWaitInto(container, id, label, scope, stillValid) {
  const t0 = Date.now();
  if (scope) _npStreamChars[scope] = 0;
  const paint = () => {
    if (stillValid && !stillValid()) return;   // 用户已经点了上一步/换了一步：别把等待文案糊到那一步的画面上
    const el = _npEl(container, id);
    if (!el) return;
    const n = scope ? (_npStreamChars[scope] || 0) : 0;
    el.innerHTML = '<span class="loading-spinner"></span>' + esc(label) + '…' +
      (n ? '<b style="color:#2e7d32;">已写 ' + n + ' 字</b> · ' : '') +
      '<b style="color:var(--c-brand-text);font-weight:700;">已等 ' + Math.round((Date.now() - t0) / 1000) + ' 秒</b>';
  };
  paint();
  const timer = setInterval(paint, 1000);
  return () => clearInterval(timer);
}

/* 🔮 预取：卖点一勾就把【人群】先算好；【话题】必须等用户勾了人群再算——
   原来一次生成两样，人还没选就把话题的钱花了，而且半边格式坏掉整发都废 */
let _npPeopleJob = null;     // { key, gen, promise } 在途的那一发
let _npPeopleReady = '';     // wiz.people 是哪组卖点算出来的（key）
let _npPeopleGen = 0;        // 换一批/换卖点后 +1：旧的那发回来也不许再写回
let _npPeopleTimer = null;
let _npPeopleCount = 0;      // 单次会话最多预取 3 发：手抖连点别把钱烧了
let _npTopicsJob = null;
let _npTopicsReady = '';     // wiz.topics 是哪组「卖点 × 已选人群」算出来的（key）
let _npTopicsGen = 0;
let _npTopicsTimer = null;
let _npTopicsCount = 0;
function npSellKeyOf(chosen) { return (chosen || []).map(x => (x && x.__i) || 0).join(','); }
function npPeopleKeyOf(chosen, chosenPeople) { return npSellKeyOf(chosen) + '|' + (chosenPeople || []).map(p => (p && p.__i) || 0).join(','); }
function npKbKeyOf(chosenKb) { return (chosenKb || []).map(x => (x && (x.id || x.__i)) || '').join(','); }
/** 话题要看「卖点 × 已选人群 × 已选素材」三样：素材换了，上一组话题引的是别的料，得重算 */
function npTopicsKeyOf(wiz) { return npPeopleKeyOf(wiz.chosen, wiz.chosenPeople) + '|' + npKbKeyOf(wiz.chosenKb); }

/** 打一发【人群】；同 key 复用同一发，结果写回 wiz */
function npFetchPeople(wiz, key) {
  // 复用的前提是「同一发」：换一批会把 gen 推上去，旧的那发已经作废，不能拿它的失败/旧结果顶包
  if (_npPeopleJob && _npPeopleJob.key === key && _npPeopleJob.gen === _npPeopleGen) return _npPeopleJob.promise;
  const gen = _npPeopleGen;
  const job = { key, gen, promise: null };
  job.promise = (async () => {
    const res = await chrome.runtime.sendMessage({ action: 'aiGeneratePeople', platform: npPid(wiz), sellPoints: wiz.chosen });
    if (!res || res.ok === false || res.error) throw new Error((res && res.error) || '后台未返回结果，请重试');
    const opts = (res && res.people_options) || [];
    if (!opts.length) throw new Error('AI 未返回有效人群，请点「换一批」重试');
    // 期间用户换了卖点、或点了换一批：这一发作废，别把上一组的方案贴过来
    if (npSellKeyOf(wiz.chosen) === key && _npPeopleGen === gen) { wiz.people = { people_options: opts, people: res.people }; _npPeopleReady = key; }
    return res;
  })();
  _npPeopleJob = job;
  job.promise.catch(() => {}).then(() => { if (_npPeopleJob === job) _npPeopleJob = null; });
  return job.promise;
}

/** 打一发【候选话题】：带上已选人群 + 已选素材，AI 才知道为谁写、从哪取材；结果写回 wiz.topics */
function npFetchTopics(wiz, key) {
  // 同上：换一批推了 gen，旧那发作废；否则点了「换一批」会静默复用旧失败，一次 AI 都不打
  if (_npTopicsJob && _npTopicsJob.key === key && _npTopicsJob.gen === _npTopicsGen) return _npTopicsJob.promise;
  const gen = _npTopicsGen;
  const job = { key, gen, promise: null };
  job.promise = (async () => {
    // 别重复写过的话题：把「已发过池」和「档案里写过的所有话题」合成一张排除表一起递过去
    // （老口径只认池子，而池子只在点过「📋复制发布文案」时才记一笔——写完了没复制的那批会漏）
    const pid = npPid(wiz);
    const used = await npUsedPool(pid);
    const written = await npWrittenTopics(pid);
    const exclude = used.concat(written.filter(x => used.indexOf(x) < 0));
    const res = await chrome.runtime.sendMessage({ action: 'aiGenerateTopics', platform: pid, noteStyle: (wiz && wiz.noteStyle) || null, sellPoints: wiz.chosen, people: wiz.chosenPeople, usedPool: exclude, kbList: (wiz.chosenKb || []).map(e => ({ title: e.title || '', content: e.content || '' })) });
    if (!res || res.ok === false || res.error) throw new Error((res && res.error) || '后台未返回结果，请重试');
    let ts = (res && res.topics) || [];
    if (!ts.length) throw new Error('AI 未返回有效话题，请点「换一批」重试');
    // 写过的话题也摆进列表（排在新候选后面、标「写过」）：AI 已经不会再提它们，
    // 但用户可能就想拿同一个题换个平台/换个角度再写一篇——摆出来让他自己点
    const seen = {};
    ts.forEach(t => { const k = String((t && t.topic) || '').trim(); if (k) seen[k] = 1; });
    ts = ts.concat(written.filter(x => !seen[x])
      .map(x => ({ topic: x, type: '', kind: '', fact: '', target: '', alone: '', rationale: '', written: true })));
    if (npTopicsKeyOf(wiz) === key && _npTopicsGen === gen) {
      wiz.topics = ts; wiz.usedPool = exclude; wiz.writtenTopics = written; _npTopicsReady = key;
    }
    return res;
  })();
  _npTopicsJob = job;
  job.promise.catch(() => {}).then(() => { if (_npTopicsJob === job) _npTopicsJob = null; });
  return job.promise;
}

/* ═══ 🔥 热点线：④ 一挑到「热点线」就同步去找这条稿子要借的公开由头 ═══
   老板口径（2026-09-30）：「选了话题之后再 AI 搜一波最近的社会新闻 / 国际时事 / 舆论新闻，针对这些新闻
   写一下感悟，最后的感悟要套到我们的产品上面去」——热点**不是话题的来源**，是这篇的素材。所以：
     ① 话题照旧在 ③ 选（热点入口不再挂在选话题那一步）；② ④ 点到热点线 → 由 AI 去找一条本周能借的公开由头；
     ③ 由头的 angle 就是这篇的基调（从哪个角度切、怎么落到产品上），整批样稿都把它当上下文写。
   实现上不做程序抓站（不加域名权限、不解析网页）：就是让 AI 按"近期微博 / 搜狐这类平台上大家在聊的公开话题"
   自己总结、自己筛、自己挑一条——⚠ 所以它来自 AI 的知识，**可能过时甚至记错**，界面上必须写明，
   正文里也不许写具体日期 / 名次 / 爆料 / 数字（这条红线在提示词与线的戒条里各写了一道）。 ═══ */
/** 这批由头是按什么条件找的：题 / 真事 / 人群 / 卖点 / 平台 任一变了就该重找（条件写进指纹里） */
function npHotKeyOf(w) {
  const ww = w || {};
  const pi = npEffPlanItem(ww);
  const tl = ww.topics || [];
  const t = tl[(ww.chosenTopicIdx >= 0 && ww.chosenTopicIdx < tl.length) ? ww.chosenTopicIdx : 0] || {};
  return [String((pi && pi.title) || t.topic || ''), npTopicFactOf(ww), npPid(ww), npSellPointStr(),
    (ww.chosenPeople || []).map(p => (p && p.name) || '').join('|')].join(' · ');
}
/** 找一条本周能借的公开由头（AI 自己搜 → 自己筛 → 自己挑），一条不给就报错——由头是这批稿子的引子，没它别烧那批 */
async function npHotFind(w, container) {
  if (!w || w.hotBusy) return;
  const key = npHotKeyOf(w);
  if (w.hotHook && w.hotKey === key) return;   // 条件没变、手上这条还在用 → 不再烧一发
  w.hotBusy = true; w.hotErr = ''; w.hotCands = null; w.hotHook = null; w.hotIdx = 0; w.hotKey = key;
  // 找的期间就把「正在去找」摆出来（这一步不再触发自动出稿：renderStep 里 hotBusy 时那条闸门是关着的）
  if (container && _npWiz === w && w.step === 3) npWizRender(container);
  // 找的这一步要几十秒，界面上必须有动静，否则看着像卡死
  const stopWait = npWaitInto(container || npActiveC(), 'npHotWait', '🔥 正在去找这周能借的由头', null, () => _npWiz === w && !!w.hotBusy);
  try {
    const pi = npEffPlanItem(w);
    const tl = (w.topics || []);
    const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
    const res = await chrome.runtime.sendMessage({
      action: 'aiGenerateHotspots', platform: npPid(w),
      topic: (pi && String(pi.title || '').trim()) || t.topic || '',
      topicFact: npTopicFactOf(w),
      exclude: (w.hotSeen || []).slice(-12),   // 已经看过的别再给（「换一条」用光时再找一批）
      sellPoints: w.chosen,
      people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '', pain: (p && p.pain) || '', scene: (p && p.scene) || '' })),
    });
    if (!res || res.ok === false || res.error) throw new Error((res && res.error) || '后台未返回结果，请重试');
    const items = (res && res.hotspots) || [];
    if (!items.length) throw new Error('AI 没找到能借的由头，点「🔁 再找一次」重试');
    w.hotCands = items; w.hotIdx = 0; w.hotHook = items[0];
  } catch (e) {
    w.hotErr = String((e && e.message) || e);
  } finally {
    w.hotBusy = false;
    stopWait();
  }
}
/** 换一条：先把这次找回来的另外几条轮着用，用光了再让 AI 找一批新的（旧的进 exclude） */
function npHotSwap(container) {
  const w = _npWiz;
  if (!w || w.hotBusy) return;
  const cs = w.hotCands || [];
  if (w.hotIdx + 1 < cs.length) {
    w.hotIdx++; w.hotHook = cs[w.hotIdx]; w.hotKey = npHotKeyOf(w); w.hotErr = '';
  } else {
    w.hotSeen = (w.hotSeen || []).concat(cs.map(c => String((c && c.name) || '')).filter(Boolean));
    w.hotHook = null; w.hotCands = null; w.hotErr = '';
  }
  _npVariantsInvalidate();   // 由头换了＝这批稿子的引子换了，作废重出（进 ④ 时那条自动出稿会按新由头再打一批）
  npWizRender(container);
}

/** 卖点勾选变了 → 防抖 700ms 后静默预取人群（失败不吵，正式进入那步会自己报错） */
function npPrefetchPeople(wiz) {
  const key = npSellKeyOf(wiz.chosen);
  if (!key || _npPeopleCount >= 3) return;
  if (_npPeopleReady === key || (_npPeopleJob && _npPeopleJob.key === key)) return;
  clearTimeout(_npPeopleTimer);
  _npPeopleTimer = setTimeout(() => {
    if (_npWiz !== wiz || npSellKeyOf(wiz.chosen) !== key) return;
    // 防抖期间用户已经点到下一步：那一发已经打出去（或已算好）了，这里别再补一发烧钱
    if (_npPeopleReady === key || (_npPeopleJob && _npPeopleJob.key === key)) return;
    _npPeopleCount++;
    npFetchPeople(wiz, key).catch(() => {});
  }, 700);
}

/** 人群/素材勾选变了 → 防抖 700ms 后静默预取话题：人到这时才算选定，这一发不算白花 */
function npPrefetchTopics(wiz) {
  const key = npTopicsKeyOf(wiz);
  if (!(wiz.chosenPeople || []).length || _npTopicsCount >= 3) return;
  if (_npTopicsReady === key || (_npTopicsJob && _npTopicsJob.key === key)) return;
  clearTimeout(_npTopicsTimer);
  _npTopicsTimer = setTimeout(() => {
    if (_npWiz !== wiz || npTopicsKeyOf(wiz) !== key) return;
    if (_npTopicsReady === key || (_npTopicsJob && _npTopicsJob.key === key)) return;
    _npTopicsCount++;
    npFetchTopics(wiz, key).catch(() => {});
  }, 700);
}

async function npLoadPeople(container) {
  const wiz = _npWiz;
  const key = npSellKeyOf(wiz.chosen);
  wiz.loading = true;
  wiz.peopleError = '';
  npStepBar(container);
  npNav(container, navForStep());
  // 只锁「换一批 / 下一步」，上一步照旧能点——等待期间不至于把人困在这一步
  container.querySelectorAll('#npWizNav .np-wiz-again, #npWizNav .np-wiz-next').forEach(b => { b.disabled = true; });
  const stopWait = npWaitInto(container, 'npWizBody', 'AI 正在推导这批卖点能覆盖的目标人群', 'notepeople', () => _npWiz === wiz && wiz.step === 1);
  try {
    let res = (_npPeopleReady === key && wiz.people) ? wiz.people : null;   // 预取已就绪 → 秒开
    if (!res) {
      const job = (_npPeopleJob && _npPeopleJob.key === key) ? _npPeopleJob : null;
      if (job) { try { await job.promise; } catch (_) {} }   // 预取在路上：等它，别重复打
      res = (_npPeopleReady === key && wiz.people) ? wiz.people : null;
      if (!res) res = await npFetchPeople(wiz, key);         // 现打一发（失败原因抛给下面）
    }
    if (!res) throw new Error('AI 未返回有效人群，请点「换一批」重试');
  } catch (e) {
    wiz.people = null;
    _npPeopleReady = '';
    wiz.peopleError = String((e && e.message) || e);
  } finally {
    wiz.loading = false;
    stopWait();
  }
  if (_npWiz === wiz) await npWizRender(container);
}

async function npLoadTopics(container) {
  const wiz = _npWiz;
  const key = npTopicsKeyOf(wiz);
  wiz.loading = true;
  wiz.topicError = '';
  npStepBar(container);
  npNav(container, navForStep());
  container.querySelectorAll('#npWizNav .np-wiz-again, #npWizNav .np-wiz-next').forEach(b => { b.disabled = true; });
  const stopWait = npWaitInto(container, 'npWizBody', 'AI 正在按你选的人群出候选话题', 'notetopics', () => _npWiz === wiz && wiz.step === 2);
  try {
    let ts = (_npTopicsReady === key && wiz.topics) ? wiz.topics : null;
    if (!ts) {
      const job = (_npTopicsJob && _npTopicsJob.key === key) ? _npTopicsJob : null;
      if (job) { try { await job.promise; } catch (_) {} }
      ts = (_npTopicsReady === key && wiz.topics) ? wiz.topics : null;
      if (!ts) { await npFetchTopics(wiz, key); ts = (_npTopicsReady === key && wiz.topics) ? wiz.topics : null; }
    }
    if (!ts || !ts.length) throw new Error('AI 未返回有效话题，请点「换一批」重试');
  } catch (e) {
    wiz.topics = null;
    _npTopicsReady = '';
    wiz.topicError = String((e && e.message) || e);
  } finally {
    wiz.loading = false;
    stopWait();
  }
  if (_npWiz === wiz) await npWizRender(container);
}

/** ① 知识库素材选择块：选中几条就只喂这几条；不选＝按这次选的卖点自动挑最相关的几条 */
function npKbPickerHtml() {
  if (!_npWiz || !_npWiz.kbLoaded) return '';
  const list = _npWiz.kbEntries || [];
  const sel = (_npWiz.chosenKb || []).map(x => x.__i);
  const selIds = (_npWiz.chosenKb || []).map(x => x.id).filter(Boolean);   // 换一批卖点会重拉素材列表：按 id 回勾才不会错位
  const head = '<div style="font-size:12px;font-weight:700;color:#333;margin:14px 0 6px;">📚 这篇用哪些知识库素材（可多选）<span class="qhelp" tabindex="0" data-tip="选中的会喂给人群、候选话题和成稿，正文优先从里面取材；一条不选＝按这次选的卖点，从知识库里自动挑最相关的几条。">?</span></div>';
  if (!list.length) return head + '<div style="font-size:11px;color:#999;">知识库还没有素材（可在「诊断&配置 → 知识库」里添加），不选也能写。</div>';
  return head +
    '<div style="max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:8px;background:#fff;padding:0 8px;">' +
    '<table style="' + _npTbl.table + '"><colgroup>' + _npTbl.cols4 + '</colgroup>' +
    '<thead><tr><th style="' + _npTbl.th + 'position:sticky;top:0;background:#fff;z-index:1;"></th>' +
    '<th style="' + _npTbl.th + 'position:sticky;top:0;background:#fff;z-index:1;">素材</th>' +
    '<th style="' + _npTbl.th + 'position:sticky;top:0;background:#fff;z-index:1;">内容摘要</th>' +
    '<th style="' + _npTbl.th + 'position:sticky;top:0;background:#fff;z-index:1;">写过没有</th></tr></thead><tbody>' +
    list.map((e, i) => {
      const on = sel.includes(i) || (e.id && selIds.includes(e.id));
      const used = _npUsage.kb[String(e.id || '').trim()] || _npUsage.kb[String(e.title || '').trim()] || [];
      const body = String(e.content || '');
      return '<tr class="np-kb-row" style="' + _npTbl.tr(on) + '">' +
        '<td style="' + _npTbl.td + '"><input type="checkbox" class="np-kbk" data-i="' + i + '"' + (on ? ' checked' : '') + '></td>' +
        '<td style="' + _npTbl.td + '"><b style="font-size:12px;">' + esc(e.title || '（无标题）') + '</b>' +
        (e.category ? ' <span style="font-size:9px;color:#2563eb;background:#eef4ff;border-radius:6px;padding:0 4px;">' + esc(e.category) + '</span>' : '') + '</td>' +
        '<td style="' + _npTbl.td + 'font-size:11px;color:#888;line-height:1.5;">' + esc(body.slice(0, 60)) + (body.length > 60 ? '…' : '') + '</td>' +
        '<td style="' + _npTbl.td + '" title="' + _npTbl.attr(used.length ? '写过：' + used.join('、') : '') + '">' + npUsedBadge(used) + '</td></tr>';
    }).join('') + '</tbody></table></div>';
}

function renderStep(container) {
  const s = _npWiz.step;
  const stageErr = s === 1 ? _npWiz.peopleError : (s === 2 ? _npWiz.topicError : '');
  if (stageErr) {
    npBody(container, '<div role="alert" style="font-size:12px;color:#d32f2f;">' + (s === 1 ? '加载人群失败：' : '加载话题失败：') + esc(stageErr) + '</div>');
    return;
  }
  if (s === 0) {
    const sp = _npWiz.sellPoints || [];
    const chosenIdx = _npWiz.chosen.map(x => x.__i);
    const strategyHtml = (_npWiz.strategy ? '<div style="font-size:11px;color:#666;background:var(--c-brand-soft);border-radius:8px;padding:6px 10px;margin-bottom:8px;">🎯 你的产品整体打法：' + esc(_npWiz.strategy) + '</div>' : '');
    const sellTip = (_npWiz.sellTip ? '<span class="qhelp" tabindex="0" data-tip="' + escAttr(_npWiz.sellTip) + '">?</span>' : '');
    npBody(container, '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:6px;">① 全部产品卖点（可多选，每篇只推 1~2 个）' + sellTip + '</div>' + strategyHtml +
      (sp.length ? '<table style="' + _npTbl.table + '"><colgroup>' + _npTbl.cols4 + '</colgroup>' +
        '<thead><tr><th style="' + _npTbl.th + '"></th><th style="' + _npTbl.th + '">卖点</th><th style="' + _npTbl.th + '">解决谁的什么问题</th><th style="' + _npTbl.th + '">写过没有</th></tr></thead><tbody>' +
        sp.map((p, i) => {
          const used = _npUsage.sell[String(p.point || '').trim()] || [];
          const on = chosenIdx.includes(i);
          return '<tr class="np-sp-row" style="' + _npTbl.tr(on) + '">' +
            '<td style="' + _npTbl.td + '"><input type="checkbox" class="np-spk" data-i="' + i + '"' + (on ? ' checked' : '') + '></td>' +
            '<td style="' + _npTbl.td + '"><div style="display:flex;gap:6px;align-items:center;">' +
            (p.image ? '<img src="' + p.image + '" style="flex:none;width:34px;height:32px;object-fit:cover;border-radius:5px;border:1px solid #eee;">' : '') +
            '<div style="min-width:0;"><b style="font-size:12px;color:#333;line-height:1.5;">' + esc(p.point || '') + '</b>' +
            (p.type ? ' <span style="font-size:9px;color:#fff;background:' + ((p.type === '工具') ? '#2563eb' : '#c026a3') + ';border-radius:6px;padding:0 4px;">' + esc(p.type) + '</span>' : '') +
            (p.play || p.image ? '<div style="font-size:10px;color:#8a929e;margin-top:1px;">' + (p.play ? '打法 ' + esc(p.play) : '') + (p.image ? (p.play ? ' · ' : '') + '📷 已配图' : '') + '</div>' : '') +
            '</div></div></td>' +
            '<td style="' + _npTbl.td + 'font-size:11px;color:#666;line-height:1.5;">' + esc(p.why || '') + '</td>' +
            '<td style="' + _npTbl.td + '" title="' + _npTbl.attr(used.length ? '写过：' + used.join('、') : '') + '">' + npUsedBadge(used) + '</td></tr>';
        }).join('') + '</tbody></table>'
        : '<div style="font-size:11px;color:#999;">暂无可选卖点，点换一批</div>') +
      npKbPickerHtml());
    return;
  }
  if (s === 1) {
    const opts = (_npWiz.people && _npWiz.people.people_options) || [];
    const selIdx = (_npWiz.chosenPeople || []).map(p => p && p.__i);
    const pTip = (p) => ['痛点：' + (p.pain || ''), '场景：' + (p.scene || ''), '时机：' + (p.timing || '')]
      .filter(x => x.length > 3).join('；');
    npBody(container, '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:6px;">② 选这次要覆盖的人群（可多选，成稿会针对你勾的人群写）</div>' +
      (opts.length ? '<div style="border:1px solid var(--line);border-radius:8px;background:#fff;overflow:hidden;">' + opts.map((p, i) => {
        const on = selIdx.includes(i);
        const tip = pTip(p);
        return '<div style="display:flex;align-items:center;gap:6px;' + (i < opts.length - 1 ? 'border-bottom:1px solid #f2f3f5;' : '') + 'background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';">' +
          '<label style="flex:1;min-width:0;display:flex;gap:8px;align-items:center;padding:9px 10px;cursor:pointer;">' +
          '<input type="checkbox" class="np-ppc" data-i="' + i + '"' + (on ? ' checked' : '') + '>' +
          '<b style="font-size:13px;color:#333;line-height:1.5;">' + esc(p.name || '（人群）') + '</b></label>' +
          (tip ? '<span class="qhelp" tabindex="0" data-tip="' + escAttr(tip) + '" style="margin-right:10px;">?</span>' : '') +
          '</div>';
      }).join('') + '</div>'
        : '<div style="font-size:11px;color:#999;">暂无候选人群，点换一批</div>'));
    return;
  }
  if (s === 2) {
    const ts = (_npWiz.topics || []);
    const pid = npPid(_npWiz);
    const isMkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(pid) === 'market';
    const planCard = npPlanCardHtml();
    const tnoun = (typeof Platforms !== 'undefined') ? Platforms.topicNoun(pid) : '话题';
    const TH = 'padding:6px 8px;font-size:10px;color:#8a929e;font-weight:700;text-align:left;border-bottom:1px solid var(--line);box-sizing:border-box;';
    const TD = 'padding:7px 8px;font-size:12px;color:#333;vertical-align:top;border-bottom:1px solid #f2f3f5;box-sizing:border-box;';
    npBody(container, planCard + '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:6px;">③ 选一个' + tnoun + '（点一行就选它）</div>' +
      (ts.length ? '<table style="width:100%;border-collapse:collapse;table-layout:fixed;border:1px solid var(--line);border-radius:8px;background:#fff;"><colgroup>' +
        '<col style="width:34px;"><col><col style="width:30%;"><col style="width:78px;"></colgroup>' +
        '<thead><tr><th style="' + TH + '"></th><th style="' + TH + '">' + esc(tnoun) + '</th><th style="' + TH + '">这个题底下的一句真事</th><th style="' + TH + '">状态</th></tr></thead><tbody>' +
        ts.map((t, i) => {
          const cf = isMkt ? null : _npTopicConflict(t.topic);   // 闲鱼同方向可以换标题重上，不算重复
          const on = i === _npWiz.chosenTopicIdx;
          const rowTip = [t.target ? '瞄：' + t.target : '', t.alone ? '不提产品也立得住：' + t.alone : ''].filter(Boolean).join('；');
          const st = t.written
            ? '<span style="font-size:10px;color:#8a6d3b;background:#fff7e6;border:1px solid #f0dcb0;border-radius:8px;padding:0 5px;">🖊 写过</span>'
            : (cf ? '<span class="qhelp" tabindex="0" data-tip="与本号已发过的「' + escAttr(cf) + '」同类——想突破建议换角度；新切入有差异化也仍可用">⚠</span> <span style="font-size:10px;color:#b45309;">撞已发</span>'
              : '<span style="font-size:10px;color:#2e7d32;">✅ 没重复</span>');
          const div = (t.written && i > 0 && !(ts[i - 1] || {}).written)
            ? '<tr><td colspan="4" style="padding:8px 8px 4px;font-size:11px;font-weight:700;color:#8a6d3b;border-bottom:1px dashed #e5d9c3;">📚 写过的' + esc(tnoun) + '（AI 不会再出这些；真要拿老题换角度重写，点它就行）</td></tr>' : '';
          return div + '<tr class="np-tp" title="' + escAttr(rowTip) + '" style="cursor:pointer;background:' + (on ? 'var(--c-brand-soft)' : (t.written ? '#fffdf8' : '#fff')) + ';">' +
            '<td style="' + TD + '"><input type="radio" name="npTopic" class="np-tpc" data-i="' + i + '"' + (on ? ' checked' : '') + '></td>' +
            '<td style="' + TD + '"><b style="color:#333;">' + esc(t.topic || '') + '</b>' +
            (t.rationale ? '<div style="font-size:10px;color:#8a929e;margin-top:2px;line-height:1.5;">' + esc(t.rationale) + '</div>' : '') + '</td>' +
            '<td style="' + TD + 'font-size:11px;color:#666;line-height:1.5;">' + esc(t.fact || '') + '</td>' +
            '<td style="' + TD + '">' + st + '</td></tr>';
        }).join('') + '</tbody></table>'
        : '<div style="font-size:11px;color:#999;">暂无候选话题，点换一批</div>'));
    const use = _npEl(container, 'npPlanUse');
    if (use) use.addEventListener('click', function () {
      const items = (_npPlanCache && _npPlanCache.items) || [];
      const next = items.find(it => it && !it.done);
      if (!next) return;
      _npWiz.planItem = next;
      _npWiz.chosenTopicIdx = -1;
      _npWiz.write = null;   // 换底子了：④ 里改过的线/写法作废
      npWizRender(container);
    });
    const clr = _npEl(container, 'npPlanClear');
    if (clr) clr.addEventListener('click', function () { _npWiz.planItem = null; _npWiz.write = null; npWizRender(container); });
    return;
  }
  if (s === 3) {
    npBody(container, npPickStepHtml());
    // 进这一步就把这条线底下的几种写法各出一篇（老板：「你已经按照这个类型写了好几篇了，我来选」）；
    //   报过错就别自动重试，让他自己点「✍️ 再写一次」
    const now = npWritePickNow(_npWiz);
    // 🔥 热点线：由头还在找 / 没找回来（错误摆在卡上等「再找一次」）时，先别自动出稿——没由头写的只能是泛话题
    const hotWaiting = now.type === 'hot' && !_npWiz.hotHook && (_npWiz.hotBusy || !!_npWiz.hotErr);
    if (now.type && !_npVariantsBusy && !_npWiz.variantsError && !hotWaiting &&
      (!(_npWiz.variants || []).length || _npWiz.variantsKey !== npVarKeyOf(_npWiz))) {
      npVariantsLoad(container, false);
    }
    return;
  }
  if (s === 4) {
    npBody(container, npBriefLineHtml() +
      npStyleLineHtml() +
      '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:6px;">⑤ 改稿（先看一眼；不满意就让 AI 改，改到满意再往下一步）</div>' +
      '<div id="npDraftStatus" style="font-size:12px;color:#888;margin-bottom:6px;"></div>' +
      '<div id="npTitles" style="margin-bottom:8px;"></div>' +
      '<div id="npDraftBody">' + npDraftBodyHtml(_npWiz) + '</div>' +
      '<div id="npTags" style="margin:8px 0;"></div>' +
      '<div id="npRevise" style="margin:10px 0 0;">' + npReviseHtml() + '</div>');
    renderNpMaterial(container, _npWiz.draft);
    if (!_npWiz.draft && !_npDraftBusy) npBuildDraft(container);
    return;
  }
  if (s === 5) {
    // ⑥ 发稿：勾平台 → 逐平台各改写一版（事实/卖点不变，标题写法与正文结构按各平台规矩来）。
    //    这一步不标「待发」——这时还没有图/视频，发不出去；状态去「笔记档案」那一列标。
    //    要给某一版做图 / 做视频，去档案那一行点「造图片」。
    const w = _npWiz;
    if (!(w.verMap && w.verMap.pids.length)) {
      npBody(container, npChoicesSummaryWrap(true) + npPlatformPickHtml() +
        '<div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">' +
        '<button type="button" class="np-ver-go" style="padding:8px 16px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;">📮 生成各平台版本</button>' +
        '<span style="font-size:11px;color:#8a929e;">勾几个就各写一版；每版各自成档、各标各的状态。</span>' +
        '</div>');
      return;
    }
    const mx = (w.verMap.pids || []).length > 1;
    const curReady = npVerReadyOf(w, w.platform);
    const bar = mx ? npVerBarHtml() : '<div style="font-size:11px;color:#666;border:1px solid var(--line);border-radius:10px;background:#fafbfc;padding:8px 10px;">📮 这条只发 ' + esc(npPfName(w.platform)) + '；想多条平台就点上一步重勾。</div>';
    if (!curReady) {
      npBody(container, npChoicesSummaryWrap(true) + bar +
        '<div id="npVerWait" style="font-size:12px;color:#555;border:1px dashed var(--line);border-radius:10px;padding:12px;margin-top:8px;"></div>');
    } else {
      const note = (_npNote && _npNote.draft === w.draft) ? _npNote : null;
      const ttl = (note ? note.title : ((w.draft && (w.draft.titles || [])[0]) || ''));
      const tags = ((note && note.tags) || (w.draft && w.draft.tags) || []);
      const isMkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(npPid(w)) === 'market';
      npBody(container, npChoicesSummaryWrap(true) + bar +
        '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:10px 0 4px;">' +
        '<span style="font-size:11px;font-weight:700;color:#333;">📄 这一版正文（' + esc(npPfName(w.platform)) + '）</span>' +
        '<span style="font-size:10px;color:#8a929e;">手改会当场回写档案；要重写一版点版本条上的 ↻</span>' +
        '<span style="flex:1;"></span>' +
        '<button type="button" class="np-copy-all" style="border:1px solid var(--line);border-radius:8px;background:#fff;color:#555;font-size:11px;font-weight:700;padding:4px 10px;cursor:pointer;">📋 复制这版发布文案</button>' +
        '</div>' +
        (ttl ? '<div style="font-size:12px;font-weight:700;color:#333;margin-bottom:4px;">🏷 ' + esc(ttl) + '</div>' : '') +
        '<textarea id="npResult" rows="10" style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:12px;line-height:1.6;resize:vertical;">' + esc((w.draft && w.draft.content) || '') + '</textarea>' +
        (tags.length ? '<div style="font-size:11px;color:#8a929e;margin-top:4px;">' + esc(tags.map(t => (isMkt ? '' : '#') + String(t).replace(/^#/, '')).join(isMkt ? '、' : ' ')) + '</div>' : '') +
        '<div id="npDeriveBox" style="margin-top:10px;"></div>' +
        '<div style="font-size:11px;color:#666;background:#f7f7f8;border-radius:8px;padding:8px 10px;margin-top:10px;">' +
        '🗂 这几版都已经存进 <button type="button" class="np-go-archive" style="border:none;background:none;color:#1f6feb;font-size:11px;font-weight:700;cursor:pointer;padding:0;">笔记档案</button>（各成一档）：' +
        '要发出去、要标「待发 / 已发」，去那页的状态列标；要给某一版做图 / 做视频，点那一行的「🖼 造图片」。</div>');
    }
    npVerPaintAll(container);
    return;
  }
}

/** 这篇的底子是哪条线：优先 ③ 里点选的排产表那一篇；自己想的题就用话题自带的那条线（③ 里 AI 判的）。
    没有它就等于这篇没有线——成稿只剩话术比例，五条线又退回标签（三十九改实测那个病）。 */
function npBasePlanItem(w) {
  const ww = w || {};
  const pi = ww.planItem;
  if (pi) {
    // 排产表可能是老口径存的（八类那批键）：先翻成五条线，④ 的控件与成稿 payload 才对得上
    const t = NotePlan.typeOf(pi.type);
    if (!t) return pi;
    const kd = (pi.kind && NotePlan.kindOf(pi.kind)) ? NotePlan.kindOf(pi.kind) : null;
    return Object.assign({}, pi, { type: t.key, kind: (kd && kd.type === t.key) ? kd.key : (pi.kind || '') });
  }
  const tl = ww.topics || [];
  const t = tl[(ww.chosenTopicIdx >= 0 && ww.chosenTopicIdx < tl.length) ? ww.chosenTopicIdx : 0] || null;
  const ty = (t && t.type && NotePlan.typeOf(t.type)) ? NotePlan.typeOf(t.type).key : '';
  if (!ty) return null;
  const kd = (t && t.kind && NotePlan.kindOf(t.kind)) ? NotePlan.kindOf(t.kind) : null;
  return { no: null, title: '', type: ty, kind: (kd && kd.type === ty) ? kd.key : '', goal: '', scope: (ty === 'hot' ? 'breakout' : 'related'), credential: '', arc: null, fromTopic: true };
}
/** 这一篇到底按哪条线写：底子（排产/话题）+ ④ 里改过的那一份（_npWiz.write 只影响这一条） */
function npEffPlanItem(w) {
  const base = npBasePlanItem(w);
  const pick = npWritePick(w);
  if (!pick) return base;
  if (!base) return { no: null, title: '', type: pick.type, kind: pick.kind, goal: '', scope: (pick.type === 'hot' ? 'breakout' : 'related'), credential: '', arc: null, fromTopic: true };
  return Object.assign({}, base, { type: pick.type, kind: pick.kind });
}
function npPlanItemPayload(pi) {
  if (!pi) return null;
  return { no: pi.no || null, title: pi.title || '', type: pi.type, kind: pi.kind || '', goal: pi.goal || '',
    scope: pi.scope, credential: pi.credential || '', arc: pi.arc || null,
    col: pi.col || '', day: pi.day || 0 };   // 📅 长期栏目里的那一篇（发笔记里显示"星期几 · 栏目名"）
}
/** 🔥 本篇借的那条公开由头：只有「这一篇走的线是热点线」才带上——
    话题是话题、由头是由头（由头在 ④ 点热点线时才找回来）；切到别的线，或还没找回来，
    就当没有——写手按泛话题写，别硬把一条由头塞进不相干的稿子 */
function npHotOf(w) {
  const ww = w || {};
  const now = npWritePickNow(ww);
  if (!now || now.type !== 'hot') return null;
  const h = ww.hotHook || null;
  return (h && h.name) ? h : null;
}
/** ③ 选中的那条题底下的一句真事（四十六改）：题只是方向，这句才是打底的凭据——
    ④ 出稿、⑤ 成稿、改稿都带上它，写手才落在一件具体的事上。排产表那条自带题面，不用它 */
function npTopicFactOf(w) {
  const ww = w || {};
  if (ww.planItem && String(ww.planItem.title || '').trim()) return '';
  const tl = ww.topics || [];
  const t = tl[(ww.chosenTopicIdx >= 0 && ww.chosenTopicIdx < tl.length) ? ww.chosenTopicIdx : 0] || {};
  return String(t.fact || '').trim();
}

let _npDraftBusy = false;   // 正在写稿时别再点「重新生成」，省一次重复请求
async function npBuildDraft(container) {
  if (_npDraftBusy) return;
  _npDraftBusy = true;
  const w = _npWiz;
  const tl = (w.topics || []);
  const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
  const planTopic = (w.planItem && String(w.planItem.title || '').trim()) || '';   // 选了规划里那篇就以它为准，成稿按它的线/写法/要干嘛写
  w.sellImages = (w.chosen || []).map(x => (x && x.image) || '').filter(Boolean);
  // 重新生成 = 换一版：旧成稿、旧标题/标签、以及照旧稿出的料全部作废
  w.draft = null; _npNote = { draft: null, title: '', tags: [], titleIdx: 0 };
  w.path = '';   // 造图片走哪条路也跟着作废（旧料没了，别让 ⑤ 停在半截状态）
  w.visual = null; w.shots = null; w.voice = ''; w.voiceError = ''; w.voicePrev = '';
  w.revisePrev = ''; w.revSentIdx = -1;
  // 写稿期间锁按钮，防重复发起（npNav 在 renderStep 之后还会重画一次导航，会丢掉 disabled，所以下一微任务再锁一遍）
  const lockNav = () => { const nv = _npEl(container, 'npWizNav'); if (nv) nv.querySelectorAll('button').forEach(b => { b.disabled = true; }); };
  lockNav();
  Promise.resolve().then(lockNav);
  const stopWait = npWaitInto(container, 'npDraftStatus', 'AI 正在写这篇笔记（标题 / 正文 / 标签）', 'notedraft', () => _npWiz && _npWiz.step === 4);
  let ok = false, failMsg = '', looseWarn = false;
  try {
    const res = await chrome.runtime.sendMessage({
      action: 'aiRewriteNote',
      platform: npPid(w),
      topic: planTopic || t.topic || '',
      topicFact: npTopicFactOf(w),                     // 📌 这个题底下的一句真事（题只是方向，正文落在这件具体的事上）
      planItem: npPlanItemPayload(npEffPlanItem(w)),   // 排产表那一篇 或 ③ 里 AI 给这个题判的那一类（自己想的题也能带上类型）
      hot: npHotOf(w),                                 // 🔥 热点线那条公开由头（当上下文喂给写手；别的线 / 还没找到就是 null）
      planStage: (_npPlanCache && _npPlanCache.stage) || '',
      noteStyle: w.noteStyle || null,   // 🎚 这条的话术比例与字数（换过就按换的写，没换过＝跟账号默认）
      sellPoint: npSellPointStr(),
      sellImages: w.sellImages,
      people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '', pain: (p && p.pain) || '', scene: (p && p.scene) || '', timing: (p && p.timing) || '' })),
      productName: w.prodName,
      kbList: (w.chosenKb || []).map(e => ({ title: e.title || '', content: e.content || '', tags: e.tags || [] })),
    });
    const d = res && res.data;
    if (_npWiz === w) w.draft = d || null;
    if (d && d.content) {
      renderNpMaterial(container, d);
      ok = true;
    }
    else {
      const te = _npEl(container, 'npResult');
      const loose = String((res && res.copy) || '').trim();
      if (te) te.value = loose;
      // 非结构化兜底：AI 没给 JSON 但有整段文案，也算成稿——但**必须给它 draft 身份**，
      // 否则 ⑤ 改稿页上正文看得见，「改好了 · 去发稿 →」却一直是禁用的：用户改完字走不了（报过）
      ok = !!loose;
      if (ok) {
        looseWarn = true;
        if (_npWiz === w) {
          w.draft = { content: loose, titles: [], tags: [], timeTip: '', loose: true };
          renderNpMaterial(container, w.draft);
        }
      } else {
        // 后台已经把失败原因（超时/额度/模型不认/空响应…）放在 res.error 里了，别再吞掉它——
        // 只报一句「没返回可用内容」，用户和我们都没法判断该改哪里
        failMsg = (res && (res.error || res.message)) ||
          (res ? 'AI 没返回可用内容' : '后台没响应（扩展可能刚被重新加载），请重开插件再试');
      }
    }
  } catch (e) {
    failMsg = String((e && e.message) || e);
    const te = _npEl(container, 'npResult'); if (te) te.value = '生成成稿失败：' + failMsg;
  } finally {
    stopWait();
    _npDraftBusy = false;
    if (ok && _npWiz === w) { npArchiveSave(w); npPlanMarkDone(w.planItem); }   // 成稿一落地就进档案（草稿）：关掉弹窗也不丢；规划里那篇同时标记完成
    if (ok) { _npStyleState.dirty = false; _npRefreshStyleStep(); }   // 新成稿已是当前配比/字数写的
    const st = _npEl(container, 'npDraftStatus');
    if (st) st.innerHTML = ok
      ? (looseWarn ? '<span style="color:#b45309;">⚠️ AI 这次没按 JSON 格式回，正文已整段放进下面——可直接手改，或用下面的「🤖 AI 改稿」换一版</span>' : '')
      : ('<span style="color:#d32f2f;">❌ ' + esc(failMsg || '这次没写出内容') + '，点「上一步」再点「🔀 重写这批」再试一次</span>');
    const navEl = _npEl(container, 'npWizNav');
    if (navEl) npNav(container, navForStep());   // 按钮复位
  }
}

/** 本次所选卖点拼成一句话，给成稿 / 改稿 / 提示词 / 口播稿共用 */
function npSellPointStr() {
  return ((_npWiz && _npWiz.chosen) || []).map(x => {
    const t = String(x.point || x || '').trim();
    const c = String(x.content || x.why || '').trim();
    return (t && c) ? t + '：' + c : (t || c);
  }).filter(Boolean).join('；');
}

function navForStep() {
  const s = _npWiz.step;
  const back = (s > 0) ? btnWiz('np-wiz-prev', '上一步', false) : '';
  // 下一步的可用性只看「这一步选没选东西」：话题会自动勾上第一个，也算已选——
  // 否则用户直接点「就用这篇 →」，按钮是禁用的，点了毫无反应（像卡死）
  const none = s === 0 ? !(_npWiz.chosen || []).length
    : (s === 1 ? !(_npWiz.chosenPeople || []).length : _npWiz.chosenTopicIdx < 0);
  if (s === 0) return back + ' <span style="flex:1;"></span> ' + btnWiz('np-wiz-again', '🔀 换一批', false) + ' ' + btnWiz('np-wiz-next', '下一步 →', true, none, '先在左边勾 1~2 个卖点');
  if (s === 1) return back + ' <span style="flex:1;"></span> ' + btnWiz('np-wiz-again', '🔀 换成别人群', false) + ' ' + btnWiz('np-wiz-next', '用了所选人群 · 去看话题 →', true, none, '先勾一个人群');
  if (s === 2) return back + ' <span style="flex:1;"></span> ' + btnWiz('np-wiz-again', '🔀 换一批话题', false) + ' ' + btnWiz('np-wiz-next', '就用这篇 →', true, none, '先挑一个选题');
  if (s === 3) return back + ' ' + btnWiz('np-wiz-again', '🔀 重写这批', false) +
    ' <span style="flex:1;"></span> <span style="font-size:11px;color:#8a929e;">挑中哪篇就走哪篇</span>';
  if (s === 4) return back + ' <span style="flex:1;"></span> ' + btnWiz('np-wiz-next', '改好了 · 去发稿 →', true, !_npWiz.draft, '正文还没写出来——等它写完，或回上一步点「🔀 重写这批」');
  // ⑥ 发稿：这一步不标「待发」（这时还没有图/视频，发不出去）——每版各自成档，状态去档案那一列标。
  //    想给某一版做图 / 做视频，下一站是「笔记档案」那一行的「造图片」。
  const hasVer = !!(_npWiz.verMap && _npWiz.verMap.pids.length);
  return back + ' ' + btnWiz('np-copy-all', '📋 复制这版发布文案', true, !_npWiz.draft) +
    ' <span style="flex:1;"></span> ' +
    (hasVer ? btnWiz('np-out-go', '🎬 去笔记档案做料 →', false, false) + ' ' : '') +
    btnWiz('np-wiz-again2', '↩ 再来一篇(新卖点)', false);
}

// 🤖 AI 生成文案：选参考素材 + 引导话题 → AI 生成 → 复制
let _npActiveContainer = null;
let _npDelegated = false;
/** 发笔记这套点击事件要落在哪个容器上：台上是造图片页就用它，否则是写文案向导（两者不会同时开着） */
function npActiveC() {
  const oc = document.getElementById('noteOutputContent');
  if (_npMode === 'out' && oc) return oc;
  const tc = document.getElementById('noteTaskContent');
  if (_npMode === 'task' && tc) return tc;
  const gc = npGuideC();
  if (_npMode === 'guide' && gc) return gc;
  return document.getElementById('notePublishContent') || _npActiveContainer;
}
function npGuideC() { return document.getElementById('noteGuideContent'); }
function ensureNpDelegation() {
  if (_npDelegated) return;
  _npDelegated = true;
  // 手改也要回写：改稿 / 造图片（正文、图文提示词、口播稿）读的都是这几份文本
  document.addEventListener('input', function (ev) {
    const t = ev.target;
    const w = npS();
    if (!t || !w) return;
    if (t.id === 'npResult' && w.draft) { w.draft.content = t.value; npArchiveTouch(w); }
    if (t.id === 'npVoiceTa') { w.voice = t.value; npSrcStalePaint(npActiveC()); npArchiveTouch(w); }
    // 造图片页里那两段提示词是手改最多的地方，改了也当场回写（不然切走就白改）
    if (t.id === 'npVisualCover' && w.shots) {          // 封面提示词那一格手改：落进 shots，再重拼
      w.shots.cover = t.value; npShotsCompose(w); npArchiveTouch(w);
    }
    if (t.classList && t.classList.contains('np-shot-desc')) {
      const it = npShotOf(w, t.getAttribute('data-id'));
      // 手改过＝这一格带锁：🔁 重出图描述会跳过它（锁可以在那一格里点掉）；整页不甩，锁就地补上
      if (it) {
        it.desc = t.value; it.dlock = true;
        const cell = t.closest ? t.closest('td') : null;
        const slot = cell && cell.querySelector ? cell.querySelector('.np-shot-lockslot') : null;
        if (slot && !slot.querySelector('.np-shot-lock')) {
          slot.innerHTML = npShotLockHtml(it);
          // 锁第一次挂上才顺手刷一下风格面板（那上面的「几段带 🔒」和 🔁 的段数要跟着变）
          const lb = _npEl(npActiveC(), 'npLookBox'); if (lb) lb.innerHTML = npLookPanelHtml(w);
        }
        npShotsPaintPromptOnly(npActiveC()); npArchiveTouch(w);
      }
    }
  });
  /* ✂️ 断句台：句子（.np-sent）拖进哪一段＝那一屏；拖到某一句前面＝插在那句之前；拖回池子＝这句先不占图。
     分镜表那几行（.np-shot）另算一层：拖到紧上面那一行＝两段并成一张，拖到别处＝换顺序。 */
  document.addEventListener('dragstart', function (ev) {
    const sp = ev.target && ev.target.closest ? ev.target.closest('.np-sent') : null;
    if (sp) {
      _npSentDrag = sp.getAttribute('data-sid') || '';
      if (!_npSentDrag) return;
      try { ev.dataTransfer.setData('text/plain', 'sent:' + _npSentDrag); ev.dataTransfer.effectAllowed = 'move'; } catch (_) {}
      return;
    }
    const tr = ev.target && ev.target.closest ? ev.target.closest('.np-shot') : null;
    if (!tr) return;
    _npShotDrag = tr.getAttribute('data-id') || '';
    try { ev.dataTransfer.setData('text/plain', 'seg:' + _npShotDrag); ev.dataTransfer.effectAllowed = 'move'; } catch (_) {}
  });
  document.addEventListener('dragover', function (ev) {
    if (!_npSentDrag && !_npShotDrag) return;
    const dz = ev.target && ev.target.closest ? ev.target.closest('.np-sent,.np-cutseg,.np-cutpool,.np-cutnew,.np-shot') : null;
    if (!dz) return;
    if (_npShotDrag) { if (!dz.classList.contains('np-shot')) return; }        // 整段只落表格行
    else if (dz.classList.contains('np-shot')) return;                          // 句子落断句台那一圈，两边互收
    ev.preventDefault();
    try { ev.dataTransfer.dropEffect = 'move'; } catch (_) {}
    if (dz !== _npCutOver) { npCutHi(dz); _npCutOver = dz; }
  });
  document.addEventListener('drop', function (ev) {
    let sid = _npSentDrag, seg = _npShotDrag;
    try {
      const got = String((ev.dataTransfer && ev.dataTransfer.getData && ev.dataTransfer.getData('text/plain')) || '');
      if (/^sent:/.test(got)) { sid = got.slice(5); seg = ''; }
      else if (/^seg:/.test(got)) { seg = got.slice(4); sid = ''; }
    } catch (_) {}
    if (!sid && !seg) return;
    const dz = ev.target && ev.target.closest ? ev.target.closest('.np-sent,.np-cutseg,.np-cutpool,.np-cutnew,.np-shot') : null;
    if (!dz) return;
    ev.preventDefault();
    npCutHi(null); _npCutOver = null; _npSentDrag = ''; _npShotDrag = '';
    const c = npActiveC(); if (!c) return;
    if (sid) {
      if (dz.classList.contains('np-cutnew')) { npCutNewSegFrom(c, sid); return; }
      if (dz.classList.contains('np-sent')) {
        const host = dz.closest ? dz.closest('.np-cutseg') : null;
        npSentMoveTo(c, sid, host ? (host.getAttribute('data-id') || '') : '', dz.getAttribute('data-sid') || '');
        return;
      }
      if (dz.classList.contains('np-cutseg')) { npSentMoveTo(c, sid, dz.getAttribute('data-id') || '', ''); return; }
      if (dz.classList.contains('np-cutpool')) { npSentMoveTo(c, sid, '', ''); return; }
      return;
    }
    if (dz.classList.contains('np-shot')) npShotDrop(c, seg, dz.getAttribute('data-id') || '');
  });
  // 拖到一半松手（没落在任何格子里）：把高亮和被拖的那一份状态收掉，别留在界面上骗人
  document.addEventListener('dragleave', function (ev) {
    if (!_npCutOver) return;
    const to = ev.relatedTarget;
    if (to && _npCutOver.contains && _npCutOver.contains(to)) return;
    npCutHi(null); _npCutOver = null;
  });
  document.addEventListener('dragend', function () { _npSentDrag = ''; _npShotDrag = ''; npCutHi(null); _npCutOver = null; });
  // ✂️ 断句台上改那一句的字：回车＝提交，Esc＝不改（一句接一句改时手不离开键盘）
  document.addEventListener('keydown', function (ev) {
    const t = ev.target;
    if (!t || !t.classList || !t.classList.contains('np-sent-in')) return;
    const c = npActiveC(); if (!c) return;
    if (ev.key === 'Enter') { ev.preventDefault(); npSentFixCommit(c, t.getAttribute('data-sid'), t.value); }
    else if (ev.key === 'Escape') { ev.preventDefault(); npSentEditClose(c); }
  });
  // 逐句改：回车＝提交这一句（一句接一句改时手不离开键盘）
  document.addEventListener('keydown', function (ev) {
    const t = ev.target;
    if (!t || t.id !== 'npSentAsk' || ev.key !== 'Enter') return;
    ev.preventDefault();
    const c = npActiveC(); if (c) npReviseSentence(c);
  });
  // 📮 平台勾选：改一个就重画「发到」汇总格 + 定下一步能不能走
  document.addEventListener('change', function (ev) {
    const t = ev.target;
    if (t && t.classList && t.classList.contains('np-pfm')) npCollectPlatforms();
    // 五十四改：分镜表不再每行选「做哪一种」（一套图往哪儿取材由 ① 那一行的画面流派定死）
    // if (t && t.classList && t.classList.contains('np-shot-form')) {
    //   const w = npS(); const it = w && npShotOf(w, t.getAttribute('data-id'));
    //   if (it) { it.form = String(t.value || ''); npShotsPaintPromptOnly(npActiveC()); npArchiveTouch(w); }
    // }
    if (t && t.id === 'npShotFile') npShotUpload(t.files);   // 生成好的图传回来
    // 五十五改：那一行的身份是「平台 × 画面流派」——换派只记下新派，图描述由表上那颗 🔁 照新派重出
    if (t && t.classList && t.classList.contains('np-img-motif')) npImgMotifChange(npActiveC(), t.getAttribute('data-id'), String(t.value || ''));
  });
  document.addEventListener('click', async function (ev) {
    const t = ev.target;
    // 出片台那层盖板：按钮在 #filmContent 里，不在发笔记的容器里，得在取 nc 之前接住
    if (t && t.closest) {
      const kp = t.closest('.np-kind-pick');
      if (kp) { npFilmPickKind(kp.getAttribute('data-k') || ''); return; }
      if (t.closest('.np-kind-change')) { _npFilmChange = true; npFilmPaint(); return; }
      if (t.closest('.np-film-archive')) { switchMainTab('noteArchive'); return; }
      const cp = t.closest('.np-film-copy');
      if (cp) {
        const s = String((_npFilmNote && _npFilmNote.script) || '');
        if (s && typeof copyToClipboard === 'function') copyToClipboard(s).then(() => { if (typeof toast === 'function') toast('已复制整段口播稿'); }).catch(() => {});
        return;
      }
      const fg = t.closest('.np-film-guide');
      if (fg) {
        const n = _npFilmNote;
        if (!n || !n.id) { if (typeof toast === 'function') toast('这一篇还没入档——先在「✏️ 写文案」把正文存进档案', 'error'); return; }
        const rec = await npArFindById(n.id);
        if (!rec) { if (typeof toast === 'function') toast('档案里找不到这一篇了', 'error'); return; }
        _npGuideK = (typeof Guides !== 'undefined' && Guides.KIND_GUIDE[n.kind]) || '';
        switchMainTab('noteGuide', rec);
        return;
      }
      // 台子 → 任务表：这一篇的别的片、别的活都在「🎯 出图 / 出片」那一页排
      if (t.closest('.np-film-task')) { npFilmBackToTask(); return; }
    }
    const nc = npActiveC();
    if (!nc) return;
    if (t && t.closest('.np-wiz-save')) { npSaveNow(nc); return; }   // 💾 保存：这半篇存进档案
    if (t && t.closest('.np-wiz-back')) { npWizBack(); return; }   // ← 笔记档案：有没存的改动先问一句
    // 📮 发稿：勾完平台点一下，逐平台各改写一版（原来这一步挂在「成稿」页底，现在归发稿这步）
    if (t && t.closest('.np-ver-go')) {
      const w = _npWiz;
      if (!w || !w.draft) return;
      npCollectPlatforms();
      if (!(w.platforms || []).length) { if (typeof toast === 'function') toast('先勾这条发到哪些平台（至少一个）', 'error'); return; }
      npVerFinalize(nc).then(function () {
        if (_npWiz !== w) return;
        npWizRender(nc);
        npVerBuildAll(nc).catch(function () {});
      });
      return;
    }
    if (t && t.closest('.np-wiz-next')) { npWizNext(nc); return; }
    if (t && t.closest('.np-wiz-prev')) { if (_npWiz && _npWiz.step > 0) { if (_npWiz.step === 5) npVerRestoreBase(_npWiz); _npWiz.step--; npWizRender(nc); } return; }
    if (t && t.closest('.np-wiz-again')) { npWizAgain(nc); return; }
    if (t && t.closest('.np-wiz-again2')) { npWizAgain2(nc); return; }   // 发稿页的「再来一篇」
    if (t && t.closest('.np-out-go')) { switchMainTab('noteArchive'); return; }   // 发稿 → 去档案里做料/标状态
    const cbRow = t && t.closest && (t.closest('.np-sp-row') || t.closest('.np-kb-row'));
    if (cbRow) {
      // 点整行都算勾选：落在框上时浏览器已经切过状态，别再切一次
      const cb = cbRow.querySelector('input[type=checkbox]');
      if (cb && !(t.closest('input'))) cb.checked = !cb.checked;
      if (cbRow.classList.contains('np-sp-row')) { npCollectChosen(nc); } else { npCollectKb(nc); }
      return;
    }
    if (t && t.closest('.np-ppc')) { npCollectPeople(nc); return; }
    if (t && t.closest('.np-tp')) { const item = t.closest('.np-tp'); const rb = item.querySelector('.np-tpc'); if (rb) rb.checked = true; _npWiz.chosenTopicIdx = (rb ? parseInt(rb.getAttribute('data-i'), 10) : 0) || 0; _npWiz.write = null; _npVariantsInvalidate(); const navEl = _npEl(nc, 'npWizNav'); const nb = navEl ? navEl.querySelector('.np-wiz-next') : null; if (nb) nb.disabled = false; return; }
    if (t && t.closest('.np-copy-all')) { npCopyAll(nc); return; }
    // ④ 这一条的旋钮：🎚 卖货话术比例 / 🖋 字数 / 回到跟账号默认；成稿页那行「换内容类型和写法」跳回 ④
    //   （这两个 class 任务配置的账号默认面板也在用，必须限定点击落在发笔记容器里，别把两边状态串了）
    if (t && nc.contains(t) && t.closest('.npStyleTalk')) { npStyleSetTalk(t.closest('.npStyleTalk').getAttribute('data-talk') || ''); return; }
    if (t && nc.contains(t) && t.closest('.npStyleWords')) { npStyleSetWords(t.closest('.npStyleWords').getAttribute('data-words') || ''); return; }
    if (t && nc.contains(t) && t.closest('.npStyleRestore')) { npStyleClearLocal(); return; }
    // ④ 线 × 写法：换条线＝写法跟着清（新线底下没有那个写法）；点写法再点一次＝不挑写法
    if (t && nc.contains(t) && t.closest('.npWriteType')) {
      const ty = t.closest('.npWriteType').getAttribute('data-type') || '';
      if (ty !== npWritePickNow(_npWiz).type) npWriteApply(ty, '');
      return;
    }
    if (t && nc.contains(t) && t.closest('.npVarPick')) { npVarPick(parseInt(t.closest('.npVarPick').getAttribute('data-i'), 10) || 0, nc); return; }
    if (t && nc.contains(t) && t.closest('.npStyleToggle')) { _npWiz.styleOpen = !_npWiz.styleOpen; npWizRender(nc); return; }
    if (t && nc.contains(t) && t.closest('.npWriteRestore')) { npWriteRestore(); return; }
    // 🔥 热点线的由头卡：换一条（先用这次找回来的备选，用光了再让 AI 找一批）/ 找不到就再找一次 / 自己贴一条
    if (t && nc.contains(t) && t.closest('.npHotSwap')) { npHotSwap(nc); return; }
    if (t && nc.contains(t) && t.closest('.npHotAgain')) {
      const w = _npWiz;
      if (!w || w.hotBusy) return;
      w.hotErr = ''; w.hotHook = null; w.hotKey = '';
      _npVariantsInvalidate(); npWizRender(nc);   // 清掉错误 → ④ 那条自动出稿会先把由头再找一次
      return;
    }
    if (t && nc.contains(t) && t.closest('.npHotSelfAdd')) {
      const box = _npEl(nc, 'npHotSelfText');
      const v = String((box && box.value) || '').trim();
      if (!v) return;
      const w = _npWiz;
      if (!w) return;
      w.hotCands = [{ name: v.slice(0, 40), line: '（你自己贴的）', why: '', angle: '' }];
      w.hotIdx = 0; w.hotHook = w.hotCands[0]; w.hotKey = npHotKeyOf(w); w.hotErr = '';
      _npVariantsInvalidate(); npWizRender(nc);
      return;
    }
    if (t && nc.contains(t) && t.closest('#npStyleOpenFromDraft')) { npGo(nc, 3); return; }
    // ⑤ 成稿：AI 改稿（可撤销一版）
    if (t && t.closest('.np-rv-go')) { npReviseGo(nc); return; }
    if (t && t.closest('.np-rv-chip')) { const c = t.closest('.np-rv-chip'); const askEl = _npEl(nc, 'npReviseAsk'); if (askEl) askEl.value = c.getAttribute('data-ask') || ''; npReviseGo(nc); return; }
    if (t && t.closest('.np-rv-undo')) { npReviseUndo(nc); return; }
    // 🎯 逐句改：点一句 → 只改那一句（整篇其余不动）
    if (t && t.closest('.np-draft-mode')) { npDraftModeToggle(nc); return; }
    if (t && t.closest('.np-sent-cancel')) { if (_npWiz) _npWiz.revSentIdx = -1; npSentPaint(nc); return; }
    if (t && t.closest('.np-sent-go')) { npReviseSentence(nc); return; }
    const sentRow = t && t.closest('.np-sent-row');
    if (sentRow) {
      const i = parseInt(sentRow.getAttribute('data-i'), 10);
      if (_npWiz && !isNaN(i)) { _npWiz.revSentIdx = (_npWiz.revSentIdx === i ? -1 : i); npSentPaint(nc, true); }
      return;
    }
    // 📖 教程页那一排旋钮：换「发哪一种」（图文 / 视频）——只换着看教程，不作废料、也不重烧 AI
    if (t && t.closest('.npg-path')) { npGuidePickPath(t.closest('.npg-path').getAttribute('data-p') || ''); return; }
    // ⑥ 造图片：生成 + 复制 + 出片（五十四改：不再选路，下面两行是旧「图文 / 视频」路卡，注释留着）
    // if (t && t.closest('.np-path-image')) { npChoosePath(nc, 'image'); return; }
    // if (t && t.closest('.np-path-video')) { npChoosePath(nc, 'video'); return; }
    // 🖼 图片列表：加一行 / 打开那一行 / 删一行；别的平台版本那一行＝切到它自己那一档
    if (t && t.closest('.np-imgtab')) { npImgTabPick(nc, t.closest('.np-imgtab').getAttribute('data-t') || 'list'); return; }
    if (t && t.closest('.np-imgwall')) { const ww = npS(); if (ww) { ww.uiWall = !ww.uiWall; npRenderOutput(nc); } return; }
    if (t && t.closest('.np-img-addopen')) { _npImgAddOpen = true; npRenderOutput(nc); return; }
    if (t && t.closest('.np-img-addclose')) { _npImgAddOpen = false; npRenderOutput(nc); return; }
    if (t && t.closest('.np-img-add')) { npImgAdd(nc, t.closest('.np-img-add').getAttribute('data-k') || ''); return; }
    if (t && t.closest('.np-img-del')) { npImgDel(nc, t.closest('.np-img-del').getAttribute('data-id')); return; }
    // 🎯 任务表：行上两颗按钮分别进造图片 / 出片台；「＋ 一片」那排 chips 点了才铺；别的平台版本那一行＝切到它自己那一档
    if (t && t.closest('.np-task-back')) { npArchiveFlushTouch(); switchMainTab('noteArchive'); return; }
    if (t && t.closest('.np-task-img')) { npTaskOpenImg(t.closest('.np-task-img').getAttribute('data-id')); return; }
    if (t && t.closest('.np-task-film')) { npTaskOpenFilm(t.closest('.np-task-film').getAttribute('data-id')); return; }
    if (t && t.closest('.np-task-film-del')) { npTaskDelFilm(t.closest('.np-task-film-del').getAttribute('data-id')); return; }
    if (t && t.closest('.np-task-filmopen')) { _npTaskFilmOpen = true; npTaskPaint(nc); return; }
    if (t && t.closest('.np-task-filmclose')) { _npTaskFilmOpen = false; npTaskPaint(nc); return; }
    if (t && t.closest('.np-task-kind')) { npTaskAddFilm(t.closest('.np-task-kind').getAttribute('data-k') || ''); return; }
    const taskSib = t && t.closest('.np-task-sib');
    if (taskSib) {
      const sn = await npArFindById(taskSib.getAttribute('data-ar') || '');
      if (sn) { npArchiveFlushTouch(); switchMainTab('noteTask', sn); }
      return;
    }
    // 五十四改：「这一档要做成什么片」挪回出片台第一步
    // 五十四改：「这一档要做成什么片」挪回出片台第一步，造图片不再排形式（旧分支注释留着）
    // if (t && t.closest('.np-style')) { npPickStyle(nc, t.closest('.np-style').getAttribute('data-k') || ''); return; }
    if (t && t.closest('.np-desc-regen')) { npDescsRegen(nc); return; }   // 🔁 照这一派重出图描述（不重新断句）
    if (t && t.closest('.np-shot-lock')) { npShotUnlock(nc, t.closest('.np-shot-lock').getAttribute('data-id')); return; }
    // ② 断句台：整份重列 / 🔮 建议断点 / 新开一段 / 采纳某一刀 / 句子卡与段头上的旋钮
    if (t && t.closest('.np-cut-relest')) { npCutRelest(nc); return; }
    if (t && t.closest('.np-cut-suggest')) { npCutsSuggest(nc); return; }
    if (t && t.closest('.np-cut-newseg')) { npCutNewEmpty(nc); return; }
    if (t && t.closest('.np-cut-adopt')) { npCutAdopt(nc, t.closest('.np-cut-adopt').getAttribute('data-after')); return; }
    if (t && t.closest('.np-cut-dismiss')) { npCutDismiss(nc, t.closest('.np-cut-dismiss').getAttribute('data-after')); return; }
    if (t && t.closest('.np-sent-cut')) { npSentSplitIn(nc, t.closest('.np-sent-cut').getAttribute('data-sid')); return; }
    if (t && t.closest('.np-sent-fix')) { npSentEditOpen(nc, t.closest('.np-sent-fix').getAttribute('data-sid')); return; }
    if (t && t.closest('.np-sent-fix-ok')) {
      const b = t.closest('.np-sent-fix-ok'), sid = b.getAttribute('data-sid');
      const ta = nc.querySelector ? nc.querySelector('.np-sent-in[data-sid="' + sid + '"]') : null;
      npSentFixCommit(nc, sid, ta ? ta.value : ''); return;
    }
    if (t && t.closest('.np-sent-fix-no')) { npSentEditClose(nc); return; }
    if (t && t.closest('.np-sent-out')) { npSentMoveTo(nc, t.closest('.np-sent-out').getAttribute('data-sid'), '', ''); return; }
    if (t && t.closest('.np-seg-split')) { npSegSplitMiddle(nc, t.closest('.np-seg-split').getAttribute('data-id')); return; }
    if (t && t.closest('.np-seg-bind')) { npSegBind(nc, t.closest('.np-seg-bind').getAttribute('data-id')); return; }
    if (t && t.closest('.np-seg-only')) { npSegOnlyFirst(nc, t.closest('.np-seg-only').getAttribute('data-id')); return; }
    if (t && t.closest('.np-seg-take')) { npSegTakeNext(nc, t.closest('.np-seg-take').getAttribute('data-id')); return; }
    if (t && t.closest('.np-seg-del')) { npSegDel(nc, t.closest('.np-seg-del').getAttribute('data-id')); return; }
    if (t && t.closest('.np-cover-fill')) { npCoverFill(nc); return; }
    const nd = t && t.closest('.np-node');
    if (nd) { npNodeGoto(nc, nd.getAttribute('data-k') || ''); return; }
    // 🎨 ① 风格节点：画面流派（只进 AI 那一发）/ 四类轴 chips / 字量三档 / 退回账号默认
    const motifChip = t && t.closest('.np-motif');
    if (motifChip) { npMotifPick(nc, motifChip.getAttribute('data-k') || ''); return; }
    const lookChip = t && t.closest('.np-look');
    if (lookChip) { npLookPick(nc, lookChip.getAttribute('data-a') || '', lookChip.getAttribute('data-v') || ''); return; }
    const inkChip = t && t.closest('.np-ink');
    if (inkChip) { npLookInkPick(nc, inkChip.getAttribute('data-k') || ''); return; }
    if (t && t.closest('.np-look-back')) { npLookBackDefault(nc); return; }
    if (t && t.closest('.np-shot-key')) { npShotKeyToggle(nc, t.closest('.np-shot-key').getAttribute('data-id')); return; }
    if (t && t.closest('.np-shot-move')) { const mv = t.closest('.np-shot-move'); npShotMove(nc, mv.getAttribute('data-id'), parseInt(mv.getAttribute('data-d'), 10) < 0 ? -1 : 1); return; }
    if (t && t.closest('.np-shot-merge')) { npShotMerge(nc, t.closest('.np-shot-merge').getAttribute('data-id')); return; }
    if (t && t.closest('.np-shot-shallow')) { npDescsRegen(nc, t.closest('.np-shot-shallow').getAttribute('data-id')); return; }
    if (t && t.closest('.np-shot-copy')) { npShotCopy(t.closest('.np-shot-copy').getAttribute('data-id')); return; }
    if (t && t.closest('.np-shots-copy-all')) { npShotsCopyAll(); return; }
    if (t && t.closest('.np-shot-up')) { npShotUpPick(t.closest('.np-shot-up').getAttribute('data-id')); return; }
    if (t && t.closest('.np-shot-unlink')) { npShotUnlink(nc, t.closest('.np-shot-unlink').getAttribute('data-id'), t.closest('.np-shot-unlink').getAttribute('data-a')); return; }
    // 五十四改：口播稿那块（重新生成 / AI 改一版 / 改回上一版）随旧第③步一起下线，注释留着
    // if (t && t.closest('.np-voice-gen')) { npGenVoice(nc); return; }
    // if (t && t.closest('.np-voice-rv')) { npVoiceRevise(nc, t.closest('.np-voice-rv').getAttribute('data-ask') || ''); return; }
    // if (t && t.closest('.np-voice-undo')) { npVoiceUndo(nc); return; }
    if (t && t.closest('.np-derive')) { npDerive(nc, t.closest('.np-derive').getAttribute('data-pid') || ''); return; }
    // 📖 教程：换一份看（这一篇那份 / 数字人 / 拿去第三方出整片）——造图片与教程两页共用这一格
    if (t && t.closest('.np-guide-pick')) { npGuidePick(nc, t.closest('.np-guide-pick').getAttribute('data-k') || ''); return; }
    // ⑥ 版本条：点平台＝切到那版（没写好的点重试）；↻＝按同样口径重写这一版（同档覆盖）
    if (t && nc.contains(t) && t.closest('.npVerRedo')) { npVerRedo(nc, t.closest('.npVerRedo').getAttribute('data-pid') || ''); return; }
    if (t && nc.contains(t) && t.closest('.npVerChip')) { npVerChipClick(nc, t.closest('.npVerChip').getAttribute('data-pid') || ''); return; }
    /* 五十四改：「🎬 拿去出片」不再出现在造图片页（出片台入口在「笔记档案」操作列）。整块注释留着：
    if (t && t.closest('.np-film')) {
      const w = npS() || {};
      npGoFilm({
        noteId: w.arId || '',
        title: ((w.draft && (w.draft.titles || [])[0]) || ''),
        script: w.voice || '',
        kind: w.filmKind || '',
        shots: w.shots,
        rows: w.filmDocs || [],
        pid: w.platform || (typeof npPid === 'function' ? npPid(w) : 'xhs'),
      });
      return;
    }
    */
    if (t && t.closest('.np-go-archive')) { switchMainTab('noteArchive'); return; }
    if (t && t.closest('.np-out-back')) { npOutBack(); return; }   // 造图片页 → 回任务表（教程页那颗仍回档案）
    if (t && t.closest('.np-copy-field')) {
      const b = t.closest('.np-copy-field');
      const el = _npEl(nc, b.getAttribute('data-id') || '');
      const v = el ? String(el.value || '') : '';
      const label = b.getAttribute('data-label') || '';
      if (v && typeof copyToClipboard === 'function') copyToClipboard(v).then(() => { if (typeof toast === 'function') toast('已复制' + (label || '')); }).catch(() => {});
      return;
    }
  });
}

function npCollectPeople(nc) {
  const opts = (_npWiz && _npWiz.people && _npWiz.people.people_options) || [];
  const body = _npEl(nc, 'npWizBody');
  const idx = [];
  if (body) body.querySelectorAll('.np-ppc:checked').forEach(cb => { const i = parseInt(cb.getAttribute('data-i'), 10); if (!isNaN(i)) idx.push(i); });
  const prev = (_npWiz.chosenPeople || []).map(p => p && p.__i).join(',');
  _npWiz.chosenPeople = idx.map(i => Object.assign({ __i: i }, opts[i] || {}));
  const navEl = _npEl(nc, 'npWizNav');
  const nextBtn = navEl ? navEl.querySelector('.np-wiz-next') : null;
  if (_npWiz.step === 1 && nextBtn) nextBtn.disabled = !_npWiz.chosenPeople.length;
  // 人群换了：上一组话题是给别的人写的，作废
  if (prev !== idx.join(',')) { _npWiz.topics = null; _npWiz.topicError = ''; _npWiz.chosenTopicIdx = -1; _npTopicsReady = ''; }
  npPrefetchTopics(_npWiz);        // 人已选定 → 后台先算话题，点「下一步」时多半已经好了
}

/** ① 素材勾选变了：只作废话题（正文引的料变了），人群只看卖点，不动 */
function npCollectKb(nc) {
  const list = (_npWiz && _npWiz.kbEntries) || [];
  const body = _npEl(nc, 'npWizBody');
  const idx = [];
  if (body) body.querySelectorAll('.np-kbk:checked').forEach(cb => { const i = parseInt(cb.getAttribute('data-i'), 10); if (!isNaN(i)) idx.push(i); });
  const prev = npKbKeyOf(_npWiz.chosenKb);
  _npWiz.chosenKb = idx.map(i => Object.assign({ __i: i }, list[i] || {}));
  if (prev !== npKbKeyOf(_npWiz.chosenKb)) {
    _npWiz.topics = null; _npWiz.topicError = ''; _npWiz.chosenTopicIdx = -1; _npTopicsReady = '';
    npPrefetchTopics(_npWiz);      // 人群也选好了（多是从后面几步退回来改的）→ 顺手把话题重算
  }
}

/** 📮 平台勾选变了：记进本次选择（发稿按它各写一版），顺手重画「发到」格与下一步的可用性 */
function npCollectPlatforms() {
  const nc = npActiveC();
  const w = _npWiz;
  if (!w || !nc) return;
  const body = _npEl(nc, 'npWizBody');
  if (!body) return;
  const sel = [];
  body.querySelectorAll('.np-pfm:checked').forEach(cb => {
    const pid = cb.getAttribute('data-pid') || '';
    if (pid && (typeof Platforms === 'undefined' || Platforms.has(pid))) sel.push(pid);
  });
  if (typeof Platforms !== 'undefined') sel.sort((a, b) => Platforms.LIST.findIndex(p => p.id === a) - Platforms.LIST.findIndex(p => p.id === b));
  w.platforms = sel;
  if (w.step === 4 || w.step === 5) npSummaryPaint(nc);
  if (w.step === 4) {
    const navEl = _npEl(nc, 'npWizNav');
    const nb = navEl ? navEl.querySelector('.np-wiz-next') : null;
    if (nb) nb.disabled = !w.draft || !sel.length;
  }
}

function npCollectChosen(nc) {
  const sp = (_npWiz && _npWiz.sellPoints) || [];
  const body = _npEl(nc, 'npWizBody');
  const idx = [];
  if (body) body.querySelectorAll('.np-spk:checked').forEach(cb => { const i = parseInt(cb.getAttribute('data-i'), 10); if (!isNaN(i)) idx.push(i); });
  if (JSON.stringify(_npWiz.chosen.map(p => p.__i)) !== JSON.stringify(idx.slice(0, 2))) {
    _npWiz.people = null; _npWiz.peopleError = '';
    _npWiz.topics = null; _npWiz.topicError = '';
    _npPeopleReady = ''; _npTopicsReady = '';   // 卖点换了，上一组人群/话题作废
    _npWiz.chosenPeople = [];
    _npWiz.chosenTopicIdx = -1;
  }
  _npWiz.chosen = idx.slice(0, 2).map(i => ({ __i: i, point: (sp[i] && sp[i].point) || '', why: (sp[i] && sp[i].why) || '', content: (sp[i] && sp[i].content) || (sp[i] && sp[i].why) || '', image: (sp[i] && sp[i].image) || '' }));
  const navEl = _npEl(nc, 'npWizNav');
  const nextBtn = navEl ? navEl.querySelector('.np-wiz-next') : null;
  if (_npWiz.step === 0 && nextBtn) nextBtn.disabled = !_npWiz.chosen.length;
  npPrefetchPeople(_npWiz);       // 勾完就后台先算人群，点「下一步」时多半已经好了
}

async function npWizNext(nc) {
  if (!_npWiz || _npWiz.loading) return;
  if (_npWiz.step === 0) { npCollectChosen(nc); if (!_npWiz.chosen.length) { if (typeof toast === 'function') toast('请先选要推的卖点', 'error'); return; } }
  if (_npWiz.step === 1) { npCollectPeople(nc); if (!(_npWiz.chosenPeople || []).length) { if (typeof toast === 'function') toast('请至少选一个人群', 'error'); return; } }
  if (_npWiz.step === 2 && _npWiz.chosenTopicIdx < 0) { if (typeof toast === 'function') toast('请先选一个话题', 'error'); return; }
  // ⑤ 改稿 → ⑥ 发稿：只是翻页。多平台改写挪到发稿那一步（勾完平台点「生成各平台版本」才动手），
  //    所以这里不再冻结底稿、也不标「待发」。
  if (_npWiz.step === 4 && !_npWiz.draft) { if (typeof toast === 'function') toast('成稿还没写出来，等一下再往下走', 'error'); return; }
  _npWiz.step++;
  // 进这一步 = 想往前走：上一步留下的报错不该拦住重拉
  if (_npWiz.step === 1) _npWiz.peopleError = '';
  if (_npWiz.step === 2) _npWiz.topicError = '';
  await npWizRender(nc);
}

/** ⑥ 发稿页的「↩ 再来一篇」：新的一轮（刚才那篇已进"已发过池"，人群/话题/素材必须重选） */
async function npWizAgain2(nc) {
  const w = _npWiz;
  if (!w || w.loading) return;
  w.sellPoints = []; w.chosen = [];
  w.people = null; w.peopleError = '';
  w.topics = null; w.topicError = '';
  w.chosenPeople = []; w.chosenTopicIdx = -1; w.chosenKb = [];
  w.draft = null; w.path = '';
  w.style = { image: '', video: '' };   // 新的一篇重新选路（换稿时保留，是因为「换文案≠改主意」）
  w.arId = '';   // 新的一篇：下一份成稿在档案里另开一档，别盖掉刚写完的
  w.visual = null; w.voice = ''; w.voicePrev = '';
  w.platform = 'xhs'; w.platforms = ['xhs'];   // 新的一篇：平台从默认重新勾
  w.verSeed = null; w.verMap = null; w.verBaseSnap = null; w.verGen = 0;
  w.derivedFrom = ''; w.derivedFromTitle = '';
  if (_npVerWaitStop) { _npVerWaitStop(); _npVerWaitStop = null; }
  _npNote = { draft: null, title: '', tags: [], titleIdx: 0 };
  _npPeopleReady = ''; _npTopicsReady = '';
  w.step = 0; await npWizRender(nc);
}

async function npWizAgain(nc) {
  if (!_npWiz || _npWiz.loading) return;
  const s = _npWiz.step;
  if (s === 0) {
    // 换一批卖点：人群、话题都作废
    _npWiz.sellPoints = []; _npWiz.chosen = [];
    _npWiz.people = null; _npWiz.peopleError = '';
    _npWiz.topics = null; _npWiz.topicError = '';
    _npWiz.chosenPeople = []; _npWiz.chosenTopicIdx = -1;
    _npWiz.write = null;
    _npPeopleReady = ''; _npTopicsReady = '';
    _npPeopleGen++; _npTopicsGen++;
  } else if (s === 1) {
    // 第②步换一批 = 换人群；话题是跟着人群走的，一并作废
    _npWiz.people = null; _npWiz.peopleError = '';
    _npWiz.topics = null; _npWiz.topicError = '';
    _npWiz.chosenPeople = []; _npWiz.chosenTopicIdx = -1;
    _npWiz.write = null;
    _npPeopleReady = ''; _npTopicsReady = '';
    _npPeopleGen++; _npTopicsGen++;
  } else if (s === 2) {
    // 第③步换一批 = 只换话题，人是你选过的不动
    _npWiz.topics = null; _npWiz.topicError = '';
    _npWiz.chosenTopicIdx = -1;
    _npWiz.write = null;
    _npTopicsReady = ''; _npTopicsGen++;
  } else if (s === 3) { npVarAgain(nc); return; }
  await npWizRender(nc);
}
// 判断某个话题是否与本号已发过的话题"同类"（核心字重叠度），用于提示；返回命中那条原文，无则 null
function _npTopicConflict(topic) {
  const used = (_npWiz && _npWiz.usedPool) || [];
  if (!used.length) return null;
  const stop = '的了我你他因为它这个是就是很都在和跟与也还应该让给对把被能会见就没要着'.split('');
  const core = (s) => {
    const a = String(s || '').toLowerCase().replace(/[^\u4e00-\u9fa5a-z0-9]/g, '');
    const ks = {};
    let out = '';
    for (const ch of a) { if (!stop.includes(ch) && !ks[ch]) { ks[ch] = 1; out += ch; } }
    return out;
  };
  const cc = core(topic);
  if (!cc || !cc.length) return null;
  for (const u of used) {
    const uc = core(u);
    if (!uc || !uc.length) continue;
    let hit = 0;
    for (const ch of cc) if (uc.includes(ch)) hit++;
    if (hit >= Math.min(3, cc.length) && hit >= 3) return u; // 核心字重叠 ≥3 即判同类
  }
  return null;
}

let _npNote = { draft: null, title: '', tags: [], titleIdx: 0 };
async function getProductName() {
  try { const c = await readConfigPlain(); return (c.product && c.product.name) || ''; } catch (_) { return ''; }
}

/** 标题单选（复制发布文案取的是选中的这条） */
function npFillTitles(container) {
  const box = _npEl(container, 'npTitles'); if (!box) return;
  const titles = ((_npWiz && _npWiz.draft && _npWiz.draft.titles) || []);
  if (!titles.length) { box.innerHTML = ''; _npNote.title = ''; return; }
  if (!(_npNote.titleIdx >= 0 && _npNote.titleIdx < titles.length)) _npNote.titleIdx = 0;
  box.innerHTML = '<div style="font-size:11px;font-weight:700;color:#333;margin-bottom:4px;">选择标题（复制发布文案时用这条）</div>' + titles.map((t, i) =>
    '<label style="display:flex;gap:6px;align-items:flex-start;padding:6px 8px;margin-bottom:4px;border:1px solid ' + (i === _npNote.titleIdx ? 'var(--c-brand)' : 'var(--line)') + ';border-radius:8px;background:' + (i === _npNote.titleIdx ? 'var(--c-brand-soft)' : '#fff') + ';cursor:pointer;font-size:12px;line-height:1.5;color:#333;">' +
    '<input type="radio" name="npTitle" value="' + i + '"' + (i === _npNote.titleIdx ? ' checked' : '') + ' style="margin-top:2px;">' +
    '<span>' + esc(t) + '</span></label>').join('');
  box.querySelectorAll('input[name="npTitle"]').forEach(r => r.addEventListener('change', function () {
    _npNote.titleIdx = parseInt(this.value, 10) || 0;
    _npNote.title = titles[_npNote.titleIdx] || '';
    npFillTitles(container);
    npArchiveTouch(_npWiz);   // 换了标题：档案里也换成这条
  }));
  _npNote.title = titles[_npNote.titleIdx] || '';
}

/** 把成稿铺进 ④ 页面；同一份稿子重绘时保留用户已删的标签 / 已选的标题 */
function renderNpMaterial(container, d) {
  if (!d) return;
  if (_npNote.draft !== d) _npNote = { draft: d, title: '', tags: (d.tags || []).slice(), titleIdx: 0 };
  npFillTitles(container);
  const resultEl = _npEl(container, 'npResult'); if (resultEl) resultEl.value = d.content || '';
  npSentPaint(container);   // 默认视图是逐句列表，新正文要按它重拆
  renderNpTags(container);
  const ext = _npEl(container, 'npExtras');
  if (ext) ext.innerHTML = d.timeTip ? '⏰ 建议发布：' + esc(d.timeTip) : '';
}

/* 🖊 改稿：成稿出来先停在这一步，让用户说一句就改（改到满意再往下走造图片） */
const _npReviseChips = ['更口语一点', '再短一点，删掉废话', '开头三行更勾人', '补一个具体数字/例子', '别太像广告'];
function npReviseHtml() {
  return '<div style="border:1px solid #cfe3ff;background:#f7fbff;border-radius:10px;padding:10px;">' +
    '<div style="font-size:11px;font-weight:700;color:#1f6feb;margin-bottom:6px;">🖊 不满意就让 AI 改这版（正文原位替换，可撤销一次）</div>' +
    '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px;">' +
    _npReviseChips.map(c => '<button type="button" class="np-rv-chip" data-ask="' + esc(c) + '" style="border:1px solid #bfdbfe;background:#fff;color:#1d4ed8;border-radius:999px;font-size:11px;padding:3px 10px;cursor:pointer;">' + esc(c) + '</button>').join('') +
    '</div>' +
    '<input id="npReviseAsk" type="text" maxlength="120" placeholder="也可以自己写一句：例「保留结论，把中间那段压成两句」" style="width:100%;box-sizing:border-box;padding:6px 9px;border:1px solid #dbe4f0;border-radius:8px;font-size:12px;">' +
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;">' +
    '<button type="button" class="np-rv-go" style="padding:7px 14px;border:none;border-radius:8px;background:linear-gradient(135deg,#1f6feb,#4d94ff);color:#fff;font-size:12px;font-weight:700;cursor:pointer;">🤖 AI 改稿</button>' +
    '<button type="button" class="np-rv-undo" hidden style="border:1px solid var(--line);background:#fff;color:#666;border-radius:8px;font-size:12px;padding:6px 12px;cursor:pointer;">↩ 改回上一版</button>' +
    '<span id="npReviseMsg" style="font-size:11px;color:#9aa0ac;"></span>' +
    '</div></div>';
}

let _npReviseBusy = false;

/* 🎯 逐句改：正文按句拆开——点一句只改那一句，其余一个字都不动 */
function npSplitSents(content) {
  const out = [];
  String(content || '').replace(/\r/g, '').split(/(\n+)/).forEach(part => {
    if (!part) return;
    if (/^\n+$/.test(part)) { out.push({ br: part }); return; }
    part.split(/(?<=[。！？!?；;])/).forEach(seg => { if (seg) out.push({ t: seg }); });
  });
  return out;
}
function npJoinSents(arr) { return (arr || []).map(x => x.t || x.br || '').join(''); }

function npDraftBodyHtml(w) {
  const content = String((w && w.draft && w.draft.content) || '');
  const textMode = !!(w && w.revTextMode);
  const bar = '<div style="display:flex;align-items:center;gap:8px;margin:8px 0 4px;">' +
    '<span style="font-size:11px;font-weight:700;color:#333;">📝 正文</span>' +
    '<span style="font-size:10px;color:#8a929e;">' + (textMode ? '手改会当场回写档案' : '点某一句 → 只改那一句') + '</span>' +
    '<span style="flex:1;"></span>' +
    '<button type="button" class="np-draft-mode" style="border:none;background:none;color:#1f6feb;font-size:11px;font-weight:700;cursor:pointer;padding:0;">' +
    (textMode ? '🖱 回到逐句' : '✍️ 全文手改') + '</button></div>';
  if (textMode) {
    return bar + '<textarea id="npResult" rows="10" style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:12px;line-height:1.6;resize:vertical;">' + esc(content) + '</textarea>';
  }
  if (!content.trim()) {
    return bar + '<div style="border:1px dashed var(--line);border-radius:10px;padding:12px;font-size:11px;color:#9aa0ac;">正文还没写出来——稍等，AI 正在写。</div>';
  }
  const sents = npSplitSents(content);
  return bar + '<div style="border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden;">' +
    sents.map((s, i) => {
      if (s.br) return '<div style="height:8px;background:#fafbfc;"></div>';
      const on = (w.revSentIdx === i);
      return '<div class="np-sent-row" data-i="' + i + '" style="padding:8px 10px;font-size:12px;line-height:1.75;cursor:pointer;border-bottom:1px solid #f2f3f5;color:' +
        (on ? '#1d4ed8' : '#333') + ';background:' + (on ? '#f2f7ff' : '#fff') + ';">' + esc(s.t) + '</div>' +
        (on ? '<div style="padding:8px 10px;background:#f2f7ff;border-bottom:1px solid #dbeafe;">' +
          '<div style="display:flex;gap:6px;align-items:center;">' +
          '<input id="npSentAsk" type="text" maxlength="80" placeholder="这句要怎么改？例「短一半，别绕」" style="flex:1;min-width:0;box-sizing:border-box;padding:6px 9px;border:1px solid #bfdbfe;border-radius:8px;font-size:12px;">' +
          '<button type="button" class="np-sent-go" style="padding:6px 12px;border:none;border-radius:8px;background:linear-gradient(135deg,#1f6feb,#4d94ff);color:#fff;font-size:12px;font-weight:700;cursor:pointer;">🤖 改这句</button>' +
          '<button type="button" class="np-sent-cancel" style="border:1px solid var(--line);background:#fff;color:#666;border-radius:8px;font-size:12px;padding:6px 10px;cursor:pointer;">取消</button>' +
          '</div><div id="npSentMsg" style="font-size:11px;color:#9aa0ac;margin-top:5px;"></div></div>' : '');
    }).join('') + '</div>';
}

/** 只重画正文那一块（逐句点选 / 改完一句都用它，别把整步冲掉） */
function npSentPaint(container, focus) {
  const box = _npEl(container, 'npDraftBody');
  if (!box) return;
  box.innerHTML = npDraftBodyHtml(_npWiz);
  if (focus) {
    const ask = _npEl(container, 'npSentAsk');
    if (ask) ask.focus();
  }
}

function npSentMsg(container, text, color) {
  const m = _npEl(container, 'npSentMsg');
  if (m) { m.textContent = text; m.style.color = color || '#9aa0ac'; }
}

function npDraftModeToggle(container) {
  const w = _npWiz; if (!w) return;
  if (w.revTextMode) {
    const ta = _npEl(container, 'npResult');
    if (ta && w.draft) { w.draft.content = ta.value; npArchiveTouch(w); }   // 切回逐句前，手改的先落回正文
  }
  w.revTextMode = !w.revTextMode;
  w.revSentIdx = -1;
  npSentPaint(container);
}

async function npReviseSentence(container) {
  const w = _npWiz; if (!w || w.step !== 4 || _npReviseBusy) return;
  const idx = w.revSentIdx;
  const content = String((w.draft && w.draft.content) || '');
  const sents = npSplitSents(content);
  const cur = (sents[idx] || {}).t || '';
  if (!cur) return;
  const askEl = _npEl(container, 'npSentAsk');
  const a = String((askEl && askEl.value) || '').trim();
  if (!a) { if (askEl) askEl.focus(); npSentMsg(container, '先说一句想怎么改', '#d33'); return; }
  _npReviseBusy = true;
  const btn = container.querySelector('.np-sent-go');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ 改这句…'; }
  const stopWait = npWaitInto(container, 'npSentMsg', 'AI 正在只改这一句', 'noterevise', () => _npWiz === w && w.step === 4);
  let errMsg = '';
  try {
    const r = await chrome.runtime.sendMessage({ action: 'reviseNote', data: npRevisePayload(w, { content, onlySentence: cur, ask: a }) });
    if (!r || r.ok === false) throw new Error((r && r.error) || 'AI 没给出改后的那一句，换个说法再试');
    const s = String(r.sentence || '').trim();
    if (!s) throw new Error('AI 没给出改后的那一句，换个说法再试');
    w.revisePrev = content;
    sents[idx].t = s;
    const next = npJoinSents(sents);
    if (w.draft) w.draft.content = next;
    const ta = _npEl(container, 'npResult'); if (ta) ta.value = next;
  } catch (e) { errMsg = '改这句失败：' + ((e && e.message) || e); }
  stopWait();
  _npReviseBusy = false;
  if (btn) { btn.disabled = false; btn.textContent = '🤖 改这句'; }
  if (errMsg) { npSentMsg(container, errMsg, '#d33'); return; }
  npSentPaint(container);
  npSentMsg(container, '✅ 这句换好了——不满意点「↩ 改回上一版」，或换个说法再改一次', '#2e7d32');
  npArchiveSave(w);   // 改后的那一句同步进档案
}
/** 改稿那一发的上下文：整篇改与逐句改共用一份（少一处字段，AI 就会把这一篇写成通用稿） */
function npRevisePayload(w, extra) {
  const tl = (w.topics || []);
  const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
  const pi = npEffPlanItem(w);
  return Object.assign({
    platform: npPid(w),
    topic: t.topic || '',
    topicFact: npTopicFactOf(w),   // 📌 改稿也还落在这件具体的事上，别换成别的情形
    sellPoint: npSellPointStr(),
    people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '' })),
    tags: (_npNote.tags || []),
    noteStyle: w.noteStyle || null,   // 🎚 改稿也守住这条的配比 / 戒条 / 字数
    planItem: npPlanItemPayload(pi) ? {   // ★ 改稿也守住这条线的节拍（少了它，一改就退回「只有话术比例、没有线」）
      no: pi.no, type: pi.type, kind: pi.kind || '',
      col: pi.col || '', day: pi.day || 0,   // 📅 栏目篇：改稿也只在这个栏目的定位里改
    } : null,
    hot: npHotOf(w),   // 🔥 改稿也不许把"借的那条由头"改掉
  }, extra || {});
}

async function npReviseGo(container, ask) {
  const w = _npWiz; if (!w || w.step !== 4 || _npReviseBusy) return;
  const ta = _npEl(container, 'npResult');
  const askEl = _npEl(container, 'npReviseAsk');
  const msg = _npEl(container, 'npReviseMsg');
  const say = (s, color) => { if (msg) { msg.textContent = s; msg.style.color = color || '#9aa0ac'; } };
  const content = ta ? String(ta.value || '').trim() : String((w.draft && w.draft.content) || '').trim();
  if (!content) { say('正文还是空的——等成稿写完再改', '#d33'); return; }
  const a = String(ask || (askEl && askEl.value) || '').trim();
  if (!a) { if (askEl) askEl.focus(); say('先说一句想怎么改（上面有常用改法，点一下就行）', '#d33'); return; }
  _npReviseBusy = true;
  const btn = container.querySelector('.np-rv-go');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ 改稿中…'; }
  const stopWait = npWaitInto(container, 'npReviseMsg', 'AI 正在按你的要求改这一版', 'noterevise', () => _npWiz === w && w.step === 4);
  let okMsg = '', errMsg = '';
  try {
    const r = await chrome.runtime.sendMessage({ action: 'reviseNote', data: npRevisePayload(w, { content, ask: a }) });
    if (!r || r.ok === false || !r.content) throw new Error((r && r.error) || 'AI 没返回改后的正文，换个说法再试');
    w.revisePrev = content;
    if (ta) ta.value = r.content;
    if (w.draft) w.draft.content = r.content;
    if (Array.isArray(r.tags) && r.tags.length) { _npNote.tags = r.tags.slice(); renderNpTags(container); }
    if (Array.isArray(r.titles) && r.titles.length) { w.draft.titles = r.titles.slice(); npFillTitles(container); }
    npSentPaint(container);   // 逐句视图是按正文拆的，整篇换完要重新拆一遍
    const undo = container.querySelector('.np-rv-undo'); if (undo) undo.hidden = false;
    okMsg = '✅ 改好了——不满意点「↩ 改回上一版」，或换个说法再改一次';
  } catch (e) { errMsg = '改稿失败：' + ((e && e.message) || e); }
  stopWait();
  _npReviseBusy = false;
  if (okMsg) npArchiveSave(w);   // 改后的正文/标题/标签同步进档案
  if (btn) { btn.disabled = false; btn.textContent = '🤖 AI 改稿'; }
  say(okMsg || errMsg, okMsg ? '#2e7d32' : '#d33');
}

function npReviseUndo(container) {
  const w = _npWiz; if (!w || !w.revisePrev) return;
  const ta = _npEl(container, 'npResult');
  if (ta) ta.value = w.revisePrev;
  if (w.draft) w.draft.content = w.revisePrev;
  npSentPaint(container);   // 逐句列表按退回的正文重拆一遍
  w.revisePrev = '';
  npArchiveSave(w);   // 退回的那版也要同步进档案
  const u = container.querySelector('.np-rv-undo'); if (u) u.hidden = true;
  const msg = _npEl(container, 'npReviseMsg'); if (msg) { msg.textContent = '已改回上一版'; msg.style.color = '#9aa0ac'; }
}

function renderNpTags(container, d) {
  const box = _npEl(container, 'npTags');
  if (!box) return;
  const isMkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(npPid(_npWiz)) === 'market';
  const label = (typeof Platforms !== 'undefined') ? Platforms.tagLabel(npPid(_npWiz)) : '# 话题标签';
  box.innerHTML = '<div style="font-size:11px;font-weight:700;color:#333;margin-bottom:4px;">' + label + '（点 × 删）</div>' + (_npNote.tags.length ? _npNote.tags.map((t, ti) =>
    '<span style="display:inline-flex;align-items:center;gap:4px;margin:3px 4px 0 0;background:#fff;border:1px solid #f3c2cd;border-radius:10px;padding:1px 8px;font-size:11px;color:#c02;">' + (isMkt ? '' : '#') + esc(String(t).replace(/^#/, '')) +
    '<button type="button" data-ti="' + ti + '" style="border:none;background:none;color:#c02;cursor:pointer;font-size:12px;">×</button></span>').join('') : '<span style="font-size:11px;color:#999;">（' + (isMkt ? '未填关键词' : '未添加标签') + '）</span>');
  box.querySelectorAll('[data-ti]').forEach(b => b.addEventListener('click', function () { _npNote.tags.splice(parseInt(this.getAttribute('data-ti'), 10), 1); renderNpTags(container); npArchiveTouch(_npWiz); }));
}

/* ═══════════ ⑤ 造图片：图文＝画面表（按号出图）/ 视频＝口播稿→出片台 ═══════════ */
/** 这一排旋钮摆哪几种：视频＝五种「成片形式」（跟出片台第一步同一份真源 w.filmKind），
 *  旧的口播讲解 / 卡片轮播口播不再是选项，只作为喂 AI 的写法口径由成片形式派生（npStyleOf）。
 *  图文那支（按平台取 Platforms.stylesOf）五十五改后活界面不再摆——一行的身份是画面流派；
 *  活界面这一排只剩「这一档要做成什么片」（图文不用形式：一行＝一个画面流派）。 */
function npStylesOf(w, path) {
  if (path === 'video') return NP_FILM_KINDS.map(x => ({ k: x.k, d: x.d, i: x.icon, f: !!x.frame }));
  if (typeof Platforms === 'undefined') return [];
  return Platforms.stylesOf(npPid(w), path);
}
/** 这条路当前用哪种写法口径：视频＝这一档的成片形式派生（没选过＝空，页面上摆「还没选」）；
 *  图文＝旧档那个形式名（只剩留档渲染器读，活界面按 imgDocs 那一行的流派走） */
function npStyleOf(w, path) {
  if (path === 'video') return NP_KIND_VIDEO_STYLE[npKindOf(w)] || '';
  const list = npStylesOf(w, path);
  if (!list.length) return '';
  const cur = ((w.style || {})[path]) || '';
  if (list.some(x => x.k === cur)) return cur;
  return Platforms.defaultStyleOf(npPid(w), path) || list[0].k;
}

/* 出片台第一步：这一档要做成什么片（一篇一个，真源＝档案的 filmKind）。
   只有带 frame 的那两种在本机出片，其余三条给料 + 教程，扩展不代跑第三方（要算力、客户自己买那边的服务）。
   图文笔记不在这里——它不用出片，那条路在「🖼 造图片」里就选完了。 */
const NP_FILM_KINDS = [
  { k: 'PPT字体动效', icon: '🔤', d: '本机出片：一句话一屏大字，配晓晓念', frame: 'text' },
  { k: '卡片画面叙事', icon: '🃏', d: '本机出片：卡片跟着正文那句换，配晓晓念', frame: 'card' },
  { k: '动态视频', icon: '🌊', d: '把画面那批图逐张丢豆包 / 千问变成会动的，再拼一条' },
  { k: '实拍', icon: '🎥', d: '自己出镜照着念：给你口播稿 + 怎么拍 + 字幕' },
  { k: '数字人', icon: '🎭', d: '即梦数字人对口型：给你整段口播稿 + 字幕' },
];
/** 旧「视频表现形式」由成片形式派生（口播稿提示词、教程、档案那一列都还读这两个名字） */
const NP_KIND_VIDEO_STYLE = { 'PPT字体动效': '口播讲解', '卡片画面叙事': '卡片轮播口播' };
function npKindDef(k) { for (let i = 0; i < NP_FILM_KINDS.length; i++) if (NP_FILM_KINDS[i].k === k) return NP_FILM_KINDS[i]; return null; }
/** 这一档现在选的是哪种成片形式（没选过＝空串：造图片那排和出片台第一步都靠它摆「还没选」） */
function npKindOf(w) {
  const k = String((w && w.filmKind) || '');
  return npKindDef(k) ? k : '';
}
function npKindFrame(k) { const d = npKindDef(k); return (d && d.frame) || ''; }
/** 这一档在本机出片吗（只有大字 / 卡片轮播走片台；图文笔记、动态视频、实拍、数字人不出片） */
function npKindLocal(k) { return !!npKindFrame(k); }
/** 老档只记过「口播讲解 / 卡片轮播口播」，没记过成片形式：读的时候反推回来（不动数据） */
function npKindFromLegacy(n) {
  if (!n) return '';
  if (n.filmKind) return String(n.filmKind);
  if (String(n.form || '') !== '视频') return '';
  const ks = Object.keys(NP_KIND_VIDEO_STYLE);
  for (let i = 0; i < ks.length; i++) if (NP_KIND_VIDEO_STYLE[ks[i]] === String(n.style || '')) return ks[i];
  return '';
}

/** 图文那段提示词的叫法：闲鱼没有「封面」，第一段是主图、第二段是详情图 */
function npVwWords(pid) {
  const mkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(pid) === 'market';
  const size = ((typeof Platforms !== 'undefined' && Platforms.rulesOf(pid, 'visual') || {}).size)
    || (mkt ? '方形 1:1' : '竖版 3:4');
  return mkt
    ? { cover: '主图', image: '详情图', size: size }
    : { cover: '封面', image: '配图', size: size };
}
function npVw(w) { return npVwWords(npPid(w)); }

/** 教程当前摊开的是哪一份（空＝跟着这一篇走的那条路：图文 / 视频） */
let _npGuideK = '';

/** 📖 发布教程：按这一篇走的那条路铺一份教程（图文看流派那套图、视频看成片形式），另给两条外挂路（数字人 / 拿去第三方出整片） */
function npGuideHtml() {
  if (typeof Guides === 'undefined') return '';
  const w = npS(); if (!w) return '';
  if (!w.path) {
    return '<div style="font-size:11px;color:#9aa0ac;">先在上面选图文还是视频——选完这里就给「这一篇怎么出、最后怎么发」，另带数字人 / 拿去第三方出整片两条外挂路。</div>';
  }
  const pid = npPid(w);
  const P = (typeof Platforms !== 'undefined') ? Platforms.get(pid) : null;
  const vw = npVw(w);
  const list = Guides.list({
    base: P ? P.base : 'note', path: w.path, style: w.path === 'video' ? npStyleOf(w, 'video') : '', kind: w.filmKind || '',
    pf: P ? P.name : '小红书', home: (P && P.homeHint) || '主页简介 / 私信我',
    tags: (typeof Platforms !== 'undefined') ? Platforms.tagField(pid) : '话题',
    cover: vw.cover, image: vw.image, size: vw.size,
    mkt: !!P && P.base === 'market',
  });
  const on = list.some(g => g.k === _npGuideK) ? _npGuideK : list[0].k;
  const chips = list.map(g => {
    const sel = g.k === on;
    return '<button type="button" class="np-guide-pick" data-k="' + npArAttr(g.k) + '"' + (sel ? ' data-on="1"' : '') + '>' +
      esc(g.icon) + ' ' + esc(g.t) + '</button>';
  }).join('');
  const g = list.find(x => x.k === on) || list[0];
  return '<div class="npGuideChips">' + chips + '</div>' +
    '<div class="npGuide">' +
    '<div class="npGuideH">' + esc(g.icon) + ' ' + esc(g.t) + (g.when ? '<span>' + esc(g.when) + '</span>' : '') + '</div>' +
    '<ol class="npGuideSteps">' + g.steps.map(s => '<li>' + esc(s) + '</li>').join('') + '</ol>' +
    '<ul class="npGuideTips">' + (g.tips || []).map(s => '<li>' + esc(s) + '</li>').join('') + '</ul>' +
    '</div>';
}

function npGuidePick(container, k) {
  _npGuideK = String(k || '');
  const tb = _npEl(container, 'npTutoBox');
  if (tb) tb.innerHTML = npGuideHtml();
}

/** 造图片整页渲染：先画档位条（① 分镜表 / ② 预览），再把当前那一档的内容摊进 #npTabBody。
 *  「出图 / 出片」任务页共用这一入口：那一页没有档位条，回来只重摊那张表（加行 / 删行 / 换派都叫它）。 */
function npRenderOutput(container) {
  const w = npS(); if (!w || !container) return;
  if (_npMode === 'task') { npTaskPaint(container); return; }
  const tabs = _npEl(container, 'npImgTabs');
  const body = _npEl(container, 'npTabBody');
  if (!tabs || !body) return;
  const tab = w.uiTab === 'preview' ? 'preview' : 'story';
  tabs.innerHTML = npImgTabsHtml(w);
  if (tab === 'preview') {
    body.innerHTML = '<div id="npPreviewBox"></div>';
    const pb = _npEl(container, 'npPreviewBox');
    pb.innerHTML = (w.imgOpen && npShotsOn(w).length) ? npPreviewHtml(w)
      : '<div style="font-size:11px;color:#b45309;">还没有断好的段——先在 ① 分镜表 ✂️ 断一句，图传回来就能在这里对着看。</div>';
  } else {
    body.innerHTML = '<div id="npVisualBox"></div>';
    const vb = _npEl(container, 'npVisualBox');
    vb.innerHTML = w.imgOpen ? npShotsBoxHtml(w)
      : '<div style="font-size:11px;color:#b45309;">这一篇还没有一行图——回「🎯 出图 / 出片」那张表加一套图。</div>';
  }
  const ext = _npEl(container, 'npExtras');
  if (ext) {
    const tip = ((w.draft && w.draft.timeTip) || '');
    ext.innerHTML = (tip ? '<div>⏰ 建议发布：' + esc(tip) + '</div>' : '') +
      '<div style="margin-top:2px;">🗂 这一页只管出图的料；正文要改写法回「✏️ 写文案」，要出片回「🎯 出图 / 出片」那张表点「🎬 出片」。已存的都在 <button type="button" class="np-go-archive" style="border:none;background:none;color:#1f6feb;font-size:11px;font-weight:700;cursor:pointer;padding:0;">笔记档案</button>。</div>';
  }
}

/** ③ 预览（图文对照）：左边把整篇一段一格读下来，右边同一行就是那段配的那张图
 *  不画中间的连线——号对上就是一对；缺图的格子标红，「只看图墙」那一面单独看顺不顺眼 */
function npPreviewHtml(w) {
  const items = (w.shots && w.shots.items) || [];
  const on = npShotsOn(w);
  const got = on.filter(x => (x.imgs || []).length).length;
  const bt = 'border:1px solid var(--line);border-radius:7px;background:#fff;color:#58616f;font-size:11px;font-weight:700;padding:4px 10px;cursor:pointer;';
  const cellT = 'box-sizing:border-box;border:1px solid var(--line);border-radius:8px;background:#fff;padding:7px 9px;font-size:12px;line-height:1.7;color:#14181f;white-space:pre-wrap;';
  const head = '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:9px;">' +
      '<b style="font-size:12px;color:#14181f;">' + (w.uiWall ? '🧱 只看图墙' : '👀 图文对照') + '</b>' +
      '<span style="font-size:11px;color:#58616f;">' + items.length + ' 段 · 占图 ' + on.length + ' 张 · 已传回 ' + got + ' 张</span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-imgwall" style="' + bt + '">' + (w.uiWall ? '← 回图文对照' : '只看图墙') + '</button>' +
      '<button type="button" class="np-imgtab" data-t="story" style="' + bt + '">← 回分镜表</button>' +
    '</div>';
  const pics = (it) => (it.imgs || []).map(id => _npShotImgs[id]).filter(Boolean);
  const box = 'border:1px solid var(--line);border-radius:10px;background:#fff;padding:9px 11px;';
  if (w.uiWall) {
    return '<div style="' + box + '">' + head +
      '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:9px;">' +
      on.map((it, i) => {
        const im = pics(it);
        return '<div><div style="font-size:10px;color:#8b95a3;margin-bottom:3px;">画面 ' + (i + 1) + '</div>' +
          (im.length
            ? im.map(x => '<img src="' + escAttr(x.thumb || '') + '" title="' + npArAttr(x.name || '') + '" style="width:100%;max-height:180px;object-fit:cover;border-radius:8px;border:1px solid var(--line);display:block;">').join('')
            : '<div style="border:1px dashed #f0b4b4;border-radius:8px;background:#fef1f0;min-height:120px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#d92d20;">还没传图</div>') +
          '<div style="font-size:10px;color:#58616f;line-height:1.5;margin-top:4px;">' + esc(String(it.text || '').slice(0, 40)) + '</div></div>';
      }).join('') + '</div></div>';
  }
  let no = 0;
  const slot = (it) => {
    if (on.indexOf(it) < 0) return '<div style="border:1px dashed var(--line);border-radius:8px;background:#f7f7f8;min-height:78px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#8b95a3;">这一段不占图</div>';
    no++;
    const im = pics(it);
    if (!im.length) return '<div style="border:1px dashed #f0b4b4;border-radius:8px;background:#fef1f0;min-height:78px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#d92d20;">画面 ' + no + ' 还没传图</div>';
    return '<div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center;">' + im.map(x =>
      '<img src="' + escAttr(x.thumb || '') + '" title="' + npArAttr(x.name || '') + '" style="height:78px;width:58px;object-fit:cover;border-radius:6px;border:1px solid var(--line);">').join('') +
      '<span style="font-size:10px;color:#8b95a3;align-self:flex-end;">画面 ' + no + '</span></div>';
  };
  return '<div style="' + box + '">' + head +
    '<div style="display:grid;grid-template-columns:1fr 168px;gap:8px;align-items:stretch;">' +
      items.map(it => '<div style="' + cellT + '">' + esc(String(it.text || '（这一段还没字）')) + '</div>' + slot(it)).join('') +
    '</div>' +
    '<div style="font-size:10px;color:#8b95a3;line-height:1.6;margin-top:8px;">图是按号对的：右边这一格就是左边那一段要配的那张。缺的那几格回 ① 分镜表传图就行。</div>' +
  '</div>';
}

async function npChoosePath(container, path) {
  const w = npS(); if (!w || !w.draft) return;
  w.path = path;
  // 图文这条路＝列表里先有一行，当场断句；一行＝「平台 × 画面流派」，没定流派也能断（AI 自己按段意取材）
  if (path === 'image') {
    if (!w.imgOpen) { await npImgAdd(container, ''); return; }
    npArchiveSave(w);
    npRenderOutput(container);
    return;
  }
  npArchiveSave(w);            // 选路＝这篇定了「图文 / 视频」，立刻记进档案
  npRenderOutput(container);
  if (path === 'video' && !w.voice && !w.voiceBusy) {
    if (typeof editionFeatureOn === 'function' && !editionFeatureOn('videoFilm')) { if (typeof toast === 'function') toast('出片是「全功能版」功能', 'error'); return; }
    await npGenVoice(container);
  }
}

/** 换「这一档要做成什么片」：只有口播写法真的变了（大字 ↔ 卡片轮播）才重出一份，
 *  实拍 / 数字人 / 动态视频同口径，换了不动稿、不重烧 AI。
 *  图文那侧不在这儿——一行的身份是「平台 × 画面流派」，在 ① 出图列表那一行上定。 */
async function npPickStyle(container, k) {
  const w = npS(); if (!w || !w.draft || w.path !== 'video') return;
  if (!npStylesOf(w, 'video').some(x => x.k === k)) return;
  if (npKindOf(w) === k) return;
  const before = npStyleOf(w, 'video');
  w.filmKind = k;
  const reburn = npStyleOf(w, 'video') !== before;
  if (reburn) { w.voice = ''; w.voiceError = ''; w.voicePrev = ''; }
  npArchiveSave(w);
  npRenderOutput(container);
  if (reburn && !w.voiceBusy) await npGenVoice(container);
}

async function npGenVoice(container) {
  const w = npS(); if (!w || !w.draft || w.voiceBusy) return;
  w.voiceBusy = true; w.voiceError = '';
  npRenderOutput(container);
  const stopWait = npWaitInto(container, 'npVoiceWait', 'AI 正在把这版成稿改成口播稿', 'notevoice', () => npS() === w && w.step === 5 && w.path === 'video');
  try {
    const r = await chrome.runtime.sendMessage({
      action: 'genNoteVoiceScript',
      data: {
        platform: npPid(w),
        title: _npNote.title || ((w.draft.titles || [])[0] || ''),
        content: String(w.draft.content || ''),
        sellPoint: npSellPointStr(),
        people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '' })),
        style: npStyleOf(w, 'video'),
      },
    });
    if (!r || r.ok === false || !r.script) throw new Error((r && r.error) || 'AI 没给出口播稿，点「重新生成」再试');
    w.voice = String(r.script);
    w.voicePrev = '';
  } catch (e) { w.voice = ''; w.voiceError = String((e && e.message) || e); }
  stopWait();
  w.voiceBusy = false;
  if (npS() === w) { if (w.voice) npArchiveSave(w); npRenderOutput(container); }   // 口播稿落地就回写档案
}

/* ═══════════ 🧩 造图片·画面表：风格 → 断句 → 图描述 → 编号提示词 ═══════════
   老板 2026-10-01 五十改第 2 条：图文的图要跟正文一句一句对得上——不能人还在讲第一句，
   图上已经播到第二句。所以这一页不再一次问 AI 要「两段提示词」，而是：
     ① 🎨 这一套图的风格（画面流派 ＋ 四类轴 ＋ 字量档）——五十五改提到最前面单独成一个节点
     ② ✂️ 断句台：文案本地按标点逐句列出（零 AI），人把句子卡拖进「第 N 段」——一段＝一屏＝一张图；
        结构旋钮（不占图／拆／并／挪／收下一句／只留第一句／散掉）全在段头，AI 在这里只剩 🔮 建议断点（每一刀要点一下才生效）
     ③ 每段的「图描述」：按①那一派取材写（🔁 重出，不重新断句），表上那格段文本是句子拼出来的、只读
     ④ 按画面号本地拼提示词——改了哪一行，那张的提示词当场重排，不用再烧一次 AI
   图还是让客户自己去 AI 生成：每张留「📋 复制」和「🖼 把生成好的图传回来」两个入口（只存引用＋缩略图）。 */
/** 旧工作流那一层「每张怎么做」（五十四改撤、五十五改由画面流派接管）：表上不再有这一格，
 *  这份名目只留着认旧档里 it.form 那几个字，别当新分支用 */
const NP_SHOT_FORMS = ['对比', '故事场景', '事物评价', '清单要点', '金句大字'];

/* ═══════════ 🎨 这一套图的风格 · ①（五十五改）═══════════════
   老板 2026-10-02：「图片风格应该作为一个工作流节点单独设计，不只是字体颜色大小，而是成图风格、主题、博主特色」。
   所以风格不再是断句那一发 AI 顺手编的一行字，人在这四类客观轴上定（跨品类都填得进来：获客号 / 房贷号 / 母婴号，字段一样、值不同）：
     画面出身 · 主题 · 版式 · 博主印记
   层级只两层：账号默认（发笔记 · 任务配置 → 🎨 出图默认）＋ 这一套图覆盖（**轴级**继承：没选的轴跟账号默认走，选了的那几轴记在这一套上）。
   真源＝这一套图那份 look；shots.style 是它的派生物（一行令牌，提示词/教程/发布文案读的还是这一行，别再另立真源）。 */
const NP_LOOK_AXES = [
  { k: 'born', t: '画面出身', d: '图本身怎么来的', opts: ['扁平矢量插画', '实拍照片', '3D 渲染', '手绘线稿', '纯排版大字', '拼贴杂志感'] },
  { k: 'theme', t: '主题', d: '底色 / 点缀色 / 材质光线', opts: ['浅底＋单色点缀', '深灰底＋荧光点缀', '白底黑字·极简', '纸感米白＋铅笔灰', '高饱和大色块', '暗色玻璃拟态'] },
  { k: 'layout', t: '版式', d: '字放哪 / 占几成屏 / 留白', opts: ['一行大字居中', '左文右图·大留白', '上图下文·居中对齐', '编号清单卡', '左右分屏对比', '说明书式分栏', '满屏字块·上下留边'] },
  { k: 'mark', t: '博主印记', d: '常驻形象 / 收口 / 小符号（可留空）', opts: ['左上角小图标', '统一左下署名', '常驻卡通形象', '每张一个编号圆点'] },
];
/** 这张图上打算放多少字（不是全局限死一个字数的上限：段原文本来就可能长，上多少由这张自己说） */
const NP_INKS = [
  { k: 'low', t: '少字', d: '一张一句话（≤10 字），从「图描述」里那句图上文字来', rule: '这张只上一句大字（≤10 字），就取「这一张说的是」里那句图上文字；这段原文别整段上屏。' },
  { k: 'mid', t: '中字', d: '一行到两行', rule: '这张上的字一行到两行就够（长了自己断行、别缩字号）：' },
  { k: 'full', t: '整段上屏', d: '段原文原样上屏，靠版式分行', rule: '这张把段原文整段排成字块（按语意分行、字号统一，别缩着硬塞）：' },
];

/* ── 🎭 画面流派：风格节点的第一轴（这一套画面往哪儿取材）═══════════════
   老板 2026-10-02：撤掉「清单卡片式 / 对比测评式」那一层「什么式」，画面上摆什么由这一轴管。
   真源＝lib/visual-motif.js 那张表；账号自己加的流派记在 config.imgMotifs（名字＋取材规则＋要什么料），
   跟内置的那十条读同一张表、同一发提示词、同一排旋钮。
   两条通道分开走：流派只进 AI 那一发（断句 / 照这个风格重出图描述），它不进提示词尾巴——
   尾巴只出「怎么画」那四类轴（npLookToken），不然同一件事两处说、互相盖。 */
let _npMotifs = [];                       // 账号自加的那几条，打开造图片 / 任务配置时读一次
/** 一条流派收口：名目＋三句配方（长什么样 / 怎么转译 / 这样算不合格）＋要什么料，别的键丢掉（名字限 16 字：它是列表那一行的身份） */
function npMotifShape(raw) {
  if (typeof VisualMotif === 'undefined') return [];
  return (Array.isArray(raw) ? raw : []).map(x => VisualMotif.entry(x)).filter(Boolean).slice(0, 24);
}
/** 悬浮给人看的那三句（转译配方与反例是五十六改加的：光知道「长什么样」学不会怎么把文案变成画面） */
function npMotifTip(m) {
  if (!m) return '';
  return [m.take, m.cast ? '怎么把这段文案变成画面：' + m.cast : '', m.forbid ? '这样算不合格：' + m.forbid : '', m.need ? '要什么料：' + m.need : '']
    .filter(Boolean).join('\n');
}
function npMotifAll() {
  if (typeof VisualMotif === 'undefined') return [];
  try { return VisualMotif.all(_npMotifs); } catch (_) { return []; }
}
function npMotifOpts() { return npMotifAll().map(x => x.k); }
function npMotifOf(k) {
  const list = npMotifAll().filter(x => x.k === String(k || '').trim());
  return list[0] || null;
}
/** 内置那十条删不掉，只有账号自加的才摆「改 / 删」 */
function npMotifIsBuilt(k) {
  const s = String(k || '').trim();
  if (typeof VisualMotif === 'undefined') return false;
  return (VisualMotif.VISUAL_MOTIFS || []).some(x => x.k === s);
}
/** 给人看的那一句：这一派要备什么料（空串＝不用备图，字和版式本身就是画面） */
function npMotifNeed(k) { const m = npMotifOf(k); return m ? m.need : ''; }
async function npLoadImgMotifs() {
  try { const c = await readConfigPlain(); _npMotifs = npMotifShape(c && c.imgMotifs); }
  catch (_) { _npMotifs = []; }
  return _npMotifs;
}
async function npSaveImgMotifs(list) {
  const cfg = await readConfigPlain();
  cfg.imgMotifs = npMotifShape(list);
  await chrome.storage.local.set({ config: (typeof DataPrivacy !== 'undefined') ? await DataPrivacy.lockConfig(cfg) : cfg });
  _npMotifs = cfg.imgMotifs;
}

/** 只留四类轴 + 字量 + 画面流派，别的一律丢掉（存档里多出来的键不许漏进来） */
function npLookShape(raw) {
  const o = (raw && typeof raw === 'object') ? raw : {};
  const out = {};
  NP_LOOK_AXES.forEach(a => { const v = String(o[a.k] || '').trim(); if (a.opts.indexOf(v) >= 0) out[a.k] = v; });
  const ink = String(o.ink || '').trim();
  if (NP_INKS.some(x => x.k === ink)) out.ink = ink;
  const motif = String(o.motif || '').trim().slice(0, 16);   // 自由串：账号自加的流派名也要在存档往返里留得住
  if (motif) out.motif = motif;
  return out;
}
/** 尾巴那一行令牌＝只出「怎么画」四类轴（流派不在这里：它走 AI 那一发，两边各一条通道） */
function npLookToken(look) {
  const l = npLookShape(look);
  return NP_LOOK_AXES.map(a => l[a.k]).filter(Boolean).join('；');
}
function npInkOf(look) { const k = npLookShape(look).ink || ''; return NP_INKS.some(x => x.k === k) ? k : 'low'; }
function npInkDef(k) { for (let i = 0; i < NP_INKS.length; i++) if (NP_INKS[i].k === k) return NP_INKS[i]; return NP_INKS[0]; }
/** 这一套现在用哪份风格：轴级合并——账号默认打底，这一套选过的轴盖上去 */
function npLookOf(w) {
  const def = npLookShape(w && w.styleLook);
  const own = npLookShape((w && w.shots && w.shots.look) || null);
  return Object.assign({}, def, own);
}
/** 面板上那一轴的值算不算「这一套自己定的」（自己定的才有 ↺ 退回去） */
function npLookOwn(w, axis) { return !!npLookShape((w && w.shots && w.shots.look) || null)[axis]; }
async function npLoadImgLook() {
  try { const c = await readConfigPlain(); return npLookShape(c && c.imgLook); } catch (_) { return npLookShape(null); }
}
/** 账号默认的 🎨 出图默认（发笔记 · 任务配置 用）：唯一写入口，跟 📐/🖋 那几个默认并排 */
async function npSaveImgLook(look) {
  const cfg = await readConfigPlain();
  cfg.imgLook = npLookShape(look);
  await chrome.storage.local.set({ config: (typeof DataPrivacy !== 'undefined') ? await DataPrivacy.lockConfig(cfg) : cfg });
  if (_npWiz) _npWiz.styleLook = cfg.imgLook;
  if (_npOut) _npOut.styleLook = cfg.imgLook;
}
/** 面板动过 → 写进这一套那份 look，并重派生那一行令牌（提示词当场重排，不烧 AI） */
function npLookApply(w, look) {
  if (!w || !w.shots) return;
  w.shots.look = npLookShape(look);
  w.shots.style = npLookToken(npLookOf(w));
  npImgSync(w);
  npArchiveTouch(w);
}
function npLookPick(container, axis, v) {
  const w = npS(); if (!w || !w.shots) return;
  const cur = npLookOf(w);
  const own = npLookShape(w.shots.look);
  const next = Object.assign({}, own);
  if (String(cur[axis] || '') === v) delete next[axis];      // 再点一下＝这一轴交回账号默认
  else next[axis] = v;
  npLookApply(w, next);
  npShotsPaintPromptOnly(container);                          // 提示词当场重排（不重画整页，光标不丢）
  const box = _npEl(container, 'npLookBox'); if (box) box.innerHTML = npLookPanelHtml(w);
  npArchiveSave(w);
}
/** 换这一套的流派：不重烧 AI，也不动已断好的段——旧的图描述是按上一派写的，要跟上得点 🔁 */
function npMotifPick(container, k) {
  const w = npS(); if (!w || !w.shots) return;
  const stale = (npShotsOn(w) || []).some(it => String(it.desc || '').trim());
  npLookPick(container, 'motif', k);
  if (stale && typeof toast === 'function') toast('换了流派：下面那些图描述还是旧派写的，点「🔁 照这个风格重出图描述」才跟得上');
}
function npLookInkPick(container, k) {
  const w = npS(); if (!w || !w.shots) return;
  const own = npLookShape(w.shots.look);
  npLookApply(w, Object.assign({}, own, { ink: k }));
  npShotsPaintPromptOnly(container);
  const box = _npEl(container, 'npLookBox'); if (box) box.innerHTML = npLookPanelHtml(w);
  npArchiveSave(w);
}
function npLookBackDefault(container) {
  const w = npS(); if (!w || !w.shots) return;
  npLookApply(w, { ink: npInkOf(w) });                        // 四轴交回账号默认，只留字量
  npShotsPaintPromptOnly(container);
  const box = _npEl(container, 'npLookBox'); if (box) box.innerHTML = npLookPanelHtml(w);
  npArchiveSave(w);
}

function npShotId() { return 'p' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

/** 断句的原料（五十四改）：老板口径「口播稿就是断句用的」——这一页顶上那格文案优先，没单独写过就用正文。
 *  239 档出片功能关着也照样能断（这条路不碰 genNoteVoiceScript 那颗闸门）。 */
function npImgSourceText(w) {
  const v = String((w && w.voice) || '').trim();
  return v || String((w && w.draft && w.draft.content) || '').trim();
}

/** 这批画面是按哪一版文案断的句：稿子换了要在表上提醒（分镜表不会自己跟着文案变） */
function npShotsSeed(text) {
  const t = String(text || '').replace(/\s+/g, '');
  return t.length + ':' + t.slice(0, 10) + ':' + t.slice(-10);
}

function npSentId() { return 's' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

function npShotsShape(raw) {
  const o = (raw && typeof raw === 'object') ? raw : {};
  const sents = (Array.isArray(o.sents) ? o.sents : []).map(x => ({
    id: String((x && x.id) || npSentId()),
    text: String((x && x.text) || '').replace(/\s+/g, ' ').trim(),
  })).filter(x => x.text);
  const items = (Array.isArray(o.items) ? o.items : []).map(x => {
    const form = String((x && x.form) || '').trim();
    return {
      id: String((x && x.id) || npShotId()),
      text: String((x && x.text) || ''),
      form: NP_SHOT_FORMS.indexOf(form) >= 0 ? form : '',
      desc: String((x && x.desc) || ''),
      off: !!(x && x.off),                                  // 勾掉＝这句过场，不占一张图
      dlock: !!(x && x.dlock),                              // 图描述手改过＝带锁：🔁 重出图描述跳过这一行
      sids: (Array.isArray(x && x.sids) ? x.sids : []).map(String).filter(Boolean),   // 这一段收了哪几句（断句台拖出来的分组；段文本由它派生）
      imgs: (Array.isArray(x && x.imgs) ? x.imgs : []).map(String).filter(Boolean),
    };
  }).filter(x => x.text || x.desc || x.sids.length);
  return {
    style: String(o.style || ''), cover: String(o.cover || ''), seed: String(o.seed || ''),
    look: npLookShape(o.look), sents: sents, items: items,
    cutBusy: false, cutErr: '', suggest: [], editing: '',   // 断句台上的临时状态：建议断点跑没跑、那一发回来的切点、正在改字的那一句
  };
}

/** 落档的那一份：cutBusy/suggest/editing 是台上临时状态，不进档案 */
function npShotsPack(sh) {
  if (!sh || typeof sh !== 'object') return null;
  const sents = (sh.sents || []).map(x => ({ id: String(x.id || ''), text: String(x.text || '') })).filter(x => x.id && x.text);
  const items = (sh.items || []).map(i => ({
    id: i.id, text: String(i.text || ''), form: String(i.form || ''),
    desc: String(i.desc || ''), off: !!i.off, dlock: !!i.dlock,
    sids: (i.sids || []).map(String).filter(Boolean), imgs: (i.imgs || []).map(String),
  }));
  const style = String(sh.style || ''), cover = String(sh.cover || ''), seed = String(sh.seed || '');
  const look = npLookShape(sh.look);
  if (!items.length && !sents.length && !style && !cover) return null;
  return { style: style, cover: cover, seed: seed, look: look, sents: sents, items: items };
}

function npShotOf(w, id) {
  const s = w && w.shots; if (!s || !id) return null;
  return (s.items || []).find(x => x && x.id === id) || null;
}

/** 要出图的那几行（编号按这个顺序算，勾掉的不参与） */
function npShotsOn(w) { return ((w && w.shots && w.shots.items) || []).filter(x => !x.off); }

/** 一张画面的提示词：本地拼（编号 + 这段说什么 + 上多少字 + 这一套的风格四轴），所以手改当场生效 */
function npShotPromptText(w, it, i, total) {
  const vw = npVw(w);
  const look = npLookOf(w);
  const ink = npInkDef(npInkOf(look));
  const token = npLookToken(look) || String((w.shots && w.shots.style) || '').trim();
  const lines = [vw.image + ' 第 ' + (i + 1) + ' 张（共 ' + total + ' 张，' + vw.size + '，跟这一套其他张必须是同一风格）'];
  if (String(it.desc || '').trim()) lines.push('这一张说的是：' + String(it.desc).trim());
  lines.push(ink.rule + (npInkOf(look) === 'low' ? '' : String(it.text || '').trim()));
  if (token) lines.push('每一张都带的固定元素：' + token);
  lines.push('不出现二维码 / 联系方式；不写夸大效果的词。');
  return lines.filter(Boolean).join('\n');
}

/** 整套提示词（一次复制那一发） */
function npShotsAllText(w) {
  const vw = npVw(w);
  const on = npShotsOn(w);
  const head = (w.shots && w.shots.cover) ? (vw.cover + '提示词：\n' + String(w.shots.cover).trim()) : '';
  const body = on.map((it, i) => npShotPromptText(w, it, i, on.length)).join('\n\n');
  return [head, body].filter(Boolean).join('\n\n');
}

/** 画面表变了就重拼 w.visual：档案的缺口、教程、复制发布文案读的还是 visual 那两段，别再另立一份真源 */
function npShotsCompose(w) {
  const s = w && w.shots; if (!s) return;
  const on = npShotsOn(w);
  if (!on.length && !s.cover) return;
  if (!w.visual) w.visual = { cover: '', images: '' };
  w.visual.cover = String(s.cover || '');
  w.visual.images = on.map((it, i) => npShotPromptText(w, it, i, on.length)).join('\n\n');
}

/* 素材库 id → {name, thumb}：显示时现取（画面表里只存 id），库里删了这张就跟着空 */
let _npShotImgs = {};
async function npShotImgIndex() {
  const m = {};
  try {
    (await npAsAssetsRead()).forEach(a => { if (a && a.id) m[a.id] = { name: String(a.name || a.ref || '本机图'), thumb: String(a.thumb || '') }; });
  } catch (_) {}
  _npShotImgs = m;
  return m;
}

/* ── ✂️ 断句台（五十七改：断句单独成一个节点，段由人拖出来）─────────────────
   顶上那份文案在本地按标点逐句列出（npSplitSents，零 AI），一句一张卡；
   把卡拖进下面哪个「第 N 段」框，这一段就收那几句——一段＝一屏＝一张图，一段可以装一两句。
   段文本是派生物（＝收进来的那几句按顺序拼上），要改字就改那一句，或改顶上那份文案再点 ⟳。
   AI 在这个节点只留一件可退的活：🔮 建议断点（background 的 suggestNoteCutsBg）——
   它只回「该在哪一句后面断一刀」，人点一下才生效，一刀都不替人落，更不推翻已经拖好的分组。 */

let _npShotUpId = '';      // 刚点「传这张图」的是哪一行，文件选完认回来用
let _npShotDrag = '';      // 分镜表里正被拖着的那一行（拖到紧上面一行＝并成一张）
let _npSentDrag = '';      // 断句台里正被拖着的那一句
let _npCutOver = null;     // 当前亮着的落点（drop／dragend 都要收，不然拖一半松手留一块假高亮）
function npCutHi(el) {
  if (npCutHi.on && npCutHi.on !== el) npCutHi.on.style.outline = '';
  npCutHi.on = el || null;
  if (el) el.style.outline = '2px dashed var(--c-brand)';
}

/** 逐句拆（本地、零 AI）：。！？!?；; 算句末，空行只当间隔——出来一句就是一张卡 */
function npSentsFrom(src) {
  return npSplitSents(src).filter(x => x.t)
    .map(x => String(x.t).replace(/\s+/g, ' ').trim()).filter(Boolean);
}
function npSentNorm(t) { return String(t || '').replace(/[\s　]/g, ''); }
function npSentOf(w, sid) { return ((w && w.shots && w.shots.sents) || []).find(x => x && x.id === sid) || null; }
function npSentPos(w, sid) { return ((w && w.shots && w.shots.sents) || []).findIndex(x => x && x.id === sid); }
/** 这一句现在在哪一段（没归段＝null，摆在上面的池子里） */
function npSentOwner(w, sid) {
  return (((w && w.shots && w.shots.items) || []).find(it => (it.sids || []).indexOf(String(sid)) >= 0)) || null;
}
/** 段文本＝收进来的那几句拼出来（改句子＝改段文本）；没绑句子的段（旧档／自己补的）保留它自己那份字 */
function npSegSync(w) {
  (((w && w.shots && w.shots.items) || [])).forEach(it => {
    if (!(it.sids || []).length) return;
    it.text = it.sids.map(id => { const x = npSentOf(w, id); return x ? x.text : ''; }).filter(Boolean).join('');
  });
}
/** 从没用过的句子里找连着几句、拼起来正好等于这段原文的（抹掉空格比）；对不上＝这段不是从这份文案里切的，别硬绑 */
function npSentRunFind(texts, used, text) {
  const want = npSentNorm(text);
  if (!want) return null;
  for (let i = 0; i < texts.length; i++) {
    if (used[texts[i].id]) continue;
    let acc = '';
    for (let j = i; j < texts.length; j++) {
      if (used[texts[j].id]) break;
      acc += texts[j].text;
      const k = npSentNorm(acc);
      if (k === want) return texts.slice(i, j + 1);
      if (k.length >= want.length || want.indexOf(k) !== 0) break;
    }
  }
  return null;
}
/** 「⟳ 按这份文案重列句子」：文案改过才重列（不自动，免得人正拖着句子手下的料被抽走）。
 *  句子编号按原文复用——没改过的那几句还是原来那个 id，所以拖好的分组不散；
 *  改了字／删掉的那几句从段里掉出来落回池子；没绑过句子的段（老档）留它自己那份字，要绑去点段头上的 ⤭ 绑句子。 */
function npSentsRebuild(w, src) {
  const s = w && w.shots; if (!s) return 0;
  const spare = {};
  (s.sents || []).forEach(x => { const k = npSentNorm(x.text); if (k && spare[k] == null) spare[k] = x.id; });
  const sents = npSentsFrom(src).map(text => {
    const k = npSentNorm(text), reuse = spare[k];
    if (reuse) delete spare[k];
    return { id: reuse || npSentId(), text: text };
  });
  const pos = {};
  sents.forEach((x, i) => { pos[x.id] = i; });
  const items = s.items || [];
  items.forEach(it => { it.sids = (it.sids || []).filter(id => pos[id] != null); });
  s.sents = sents;
  s.seed = npShotsSeed(src);
  s.suggest = [];
  s.editing = '';
  npSegSync(w);
  return sents.length;
}
/** 台面上还没有句子池就先本地列一遍（刚加的一行、老档都走这条，一次 AI 都不烧）；返回列出了几句 */
function npSentsEnsure(w) {
  const s = w && w.shots; if (!s || (s.sents || []).length) return 0;
  const src = npImgSourceText(w);
  return src ? npSentsRebuild(w, src) : 0;
}/** 上面那份文案后来改过（或句子还没按它列过）：⟳ 那颗要亮着 */
function npCutStale(w) {
  const s = w && w.shots; if (!s) return false;
  const src = npImgSourceText(w);
  if (!src) return false;
  return !(s.sents || []).length || (!!s.seed && s.seed !== npShotsSeed(src));
}

/** 把一句挪进某一段：segId 空＝收回池子；beforeSid 非空＝插在那一句前面（挪来挪去都不复制） */
function npSentMove(w, sid, segId, beforeSid) {
  const s = w && w.shots; if (!s || !sid) return false;
  const items = s.items || [];
  const to = segId ? items.find(x => x && x.id === segId) : null;
  if (segId && !to) return false;
  const from = npSentOwner(w, sid);
  if (to && from === to && (!beforeSid || beforeSid === sid)) return false;   // 已经在这一段末尾／正把自己插回自己＝没挪
  items.forEach(it => { const k = (it.sids || []).indexOf(String(sid)); if (k >= 0) it.sids.splice(k, 1); });
  if (!to) return true;
  let at = to.sids.length;
  if (beforeSid) { const bi = to.sids.indexOf(String(beforeSid)); if (bi >= 0) at = bi; }
  to.sids.splice(at, 0, String(sid));
  return true;
}
function npNewSeg(sids) { return { id: npShotId(), text: '', form: '', desc: '', off: false, dlock: false, sids: sids || [], imgs: [] }; }

/** 挪完／切完统一收口：段文本重拼 → 提示词重排 → 落档 → 只重画断句台和表格那两块（整页甩会把人 scroll 顶走） */
function npCutChanged(container, w) {
  const s = w && w.shots; if (!s) return;
  npSegSync(w);
  (s.items || []).forEach(it => { if (!it.sids.length && !String(it.text || '').trim() && !String(it.desc || '').trim()) {
    const k = (s.items || []).indexOf(it); if (k >= 0) s.items.splice(k, 1);   // 空段（句子又拖走了）不留在表上
  } });
  s.suggest = npCutsValid(w, s.suggest);
  npShotsCompose(w);
  npArchiveSave(w);
  npCutPaint(container);
}

function npSentMoveTo(container, sid, segId, beforeSid) {
  const w = npS(); if (!w || !w.shots) return;
  const to = segId ? npShotOf(w, segId) : null;
  if (to && npSegLegacy(to)) {
    if (typeof toast === 'function') toast('那一段还是旧档那份字：拖句子进去会把那段顶掉。先点段头上的绑句子（对得上就接上），或散掉它再拖');
    return;
  }
  if (!npSentMove(w, sid, segId, beforeSid)) return;
  npCutChanged(container, w);
}
/** 拖到底下那条「＋ 拖到这里＝新开一段」：这一句自己起一段 */
function npCutNewSegFrom(container, sid) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  s.items = s.items || [];
  const it = npNewSeg([]);
  s.items.push(it);
  if (!npSentMove(w, sid, it.id, '')) { s.items.pop(); return; }
  npCutChanged(container, w);
}
/** ＋ 收下一句：池子里按文案顺序的第一句并进这一段（从上往下读时最顺手，不用回上面拖） */
function npSegTakeNext(container, segId) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const first = (s.sents || []).find(x => !npSentOwner(w, x.id));
  if (!first) { if (typeof toast === 'function') toast('上面池子里没有还没归段的句子了'); return; }
  npSentMove(w, first.id, segId, '');
  npCutChanged(container, w);
}
/** ✂ 在这一句后面断一刀：一段拆成两段（后面那几句成新的一段，紧跟在原段后面） */
function npSegSplitAfter(container, segId, sid) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const it = npShotOf(w, segId); if (!it) return;
  const k = (it.sids || []).indexOf(String(sid));
  if (k < 0 || k >= it.sids.length - 1) return;
  const tail = it.sids.splice(k + 1);
  s.items.splice(s.items.indexOf(it) + 1, 0, npNewSeg(tail));
  npCutChanged(container, w);
}
/** 段头那颗 ✂拆：从中间那刀切开（两句以上才有的旋钮） */
function npSegSplitMiddle(container, segId) {
  const w = npS(); const it = w && npShotOf(w, segId); if (!it) return;
  const n = (it.sids || []).length;
  if (n < 2) { if (typeof toast === 'function') toast('这一段就一句话——要拆先回上面把那句 ✂ 拆成两句'); return; }
  npSegSplitAfter(container, segId, it.sids[Math.ceil(n / 2) - 1]);
}
/** ⤒ 并上＝这一段的句子全并进紧上面那段（这一段自己消失；上面那段没写图描述就顺手接过来） */
function npSegMergeUp(container, segId) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const i = (s.items || []).findIndex(x => x && x.id === segId);
  if (i <= 0) return;
  npShotMerge(container, segId);
}
/** ✂ 只留第一句：其余句子拖回上面池子（一张图上只放一句时用，段本身不删） */
function npSegOnlyFirst(container, segId) {
  const w = npS(); const it = w && npShotOf(w, segId); if (!it) return;
  const n = (it.sids || []).length;
  if (n < 2) { if (typeof toast === 'function') toast('这一段就一句话——图上要放哪句直接在句子里改'); return; }
  it.sids.slice(1).forEach(sid => { npSentMove(w, sid, '', ''); });
  npCutChanged(container, w);
}
/** 删掉这一段：只散这一份分组，句子还回到上面池子里（正文一个字都不动） */
function npSegDel(container, segId) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const it = npShotOf(w, segId); if (!it) return;
  s.items = s.items.filter(x => x !== it);
  npCutChanged(container, w);
}

/** ⟳ 绑句子：老档那段字拿去上面的句子里连着对几句。
 *  对得上才绑（绑上之后这段的字改成由句子拼），对不上就明说——硬绑会把那段自己写的字顶掉。 */
function npSegBind(container, segId) {
  const w = npS(); const s = w && w.shots; const it = w && npShotOf(w, segId); if (!s || !it) return;
  if ((it.sids || []).length) return;
  if (!npImgSourceText(w)) { npArNoGo('顶上那格文案还是空的，没有句子可对'); return; }
  npSentsEnsure(w);
  if (!(s.sents || []).length) { npArNoGo('这份文案列不出句子：改一下那格，再点「⟳ 按这份文案重列句子」'); return; }
  const used = {};
  (s.items || []).forEach(x => { (x.sids || []).forEach(id => { used[id] = 1; }); });
  const run = npSentRunFind(s.sents, used, it.text);
  if (!run) {
    npCutPaint(container);
    if (typeof toast === 'function') toast('这一段对不上现在句子里的连着几句（多半这段是另写的）——要么散掉它重新拖，要么自己把句子拆出来');
    return;
  }
  it.sids = run.map(x => x.id);
  run.forEach(x => { used[x.id] = 1; });
  npCutChanged(container, w);
  if (typeof toast === 'function') toast('绑上了 ' + run.length + ' 句：这段的字以后由句子拼出来，改句子它就跟着改', 'ok');
}

/** 封面／首图那一张：AI 不再给，本地照第 1 段那行的提示词拼一版起手，人再改 */
function npCoverFill(container) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const on = npShotsOn(w);
  if (!on.length) { if (typeof toast === 'function') toast('还没有要出图的段——先在 ② 断句台拖出第一段'); return; }
  const vw = npVw(w);
  const lines = npShotPromptText(w, on[0], 0, on.length).split('\n');
  lines[0] = vw.cover + '／首图那一张（' + vw.size + '，跟这一套其他张同一风格）：整篇的第一眼，大字用第 1 段那句';
  s.cover = lines.join('\n');
  npShotsCompose(w); npArchiveSave(w); npCutPaint(container);
  if (typeof toast === 'function') toast('照第 1 段拼了一版，不满意在那格里自己改', 'ok');
}
/** ✂ 拆句：一句话太长想分两屏——在句中最靠前的停顿处（，、；）补一刀，没有停顿就中间切 */
function npSentSplitIn(container, sid) {
  const w = npS(); const s = w && w.shots; const x = w && npSentOf(w, sid); if (!s || !x) return;
  const t = String(x.text || '');
  if (t.length < 8) { if (typeof toast === 'function') toast('这一句已经够短了，不用再拆'); return; }
  let pos = -1;
  for (let i = 0; i < t.length - 1; i++) { if ('，、；,;'.indexOf(t.charAt(i)) >= 0) { pos = i + 1; break; } }
  if (pos <= 0) {
    const m = t.match(/^[\s\S]*?[。！？!?；;]/);
    pos = (m && m[0].length < t.length) ? m[0].length : Math.ceil(t.length / 2);
  }
  const a = t.slice(0, pos).trim(), b = t.slice(pos).trim();
  if (!a || !b) return;
  const p = npSentPos(w, sid);
  x.text = a;
  s.sents.splice(p + 1, 0, { id: npSentId(), text: b });
  const owner = npSentOwner(w, sid);
  if (owner) owner.sids.splice(owner.sids.indexOf(sid) + 1, 0, s.sents[p + 1].id);
  npCutChanged(container, w);
}
/** ✎ 改这一句的字：编号不变，所以它已经在的那一段不散（顶上整份文案改了才需要走 ⟳） */
function npSentFixCommit(container, sid, val) {
  const w = npS(); const s = w && w.shots; const x = w && npSentOf(w, sid); if (!s || !x) return;
  const t = String(val || '').replace(/\s+/g, ' ').trim();
  s.editing = '';
  if (!t || t === x.text) { npCutPaint(container); return; }
  x.text = t;
  npCutChanged(container, w);
}

/* 🔮 建议断点：那一发只回「该在哪一句后面断一刀」，这里把明显没用的那一刀先挑掉——
   已经断开的接缝不用再提；池子里的「到这句为止」得后面还跟着一句才算数。点一下才落刀。 */
function npCutsValid(w, cuts) {
  const s = w && w.shots; if (!s) return [];
  const out = [], seen = {};
  (Array.isArray(cuts) ? cuts : []).forEach(x => {
    const sid = String((x && (x.after || x['句'])) || '');
    if (!sid || seen[sid]) return;
    seen[sid] = 1;
    const p = npSentPos(w, sid);
    if (p < 0 || p >= (s.sents || []).length - 1) return;
    const here = npSentOwner(w, sid), next = npSentOwner(w, s.sents[p + 1].id);
    if (here && next === here) out.push({ after: sid, why: String((x && x.why) || ''), seg: here.id });
    else if (!here && !next) out.push({ after: sid, why: String((x && x.why) || ''), seg: '' });
  });
  return out;
}
async function npCutsSuggest(container) {
  const w = npS(); const s = w && w.shots; if (!s || s.cutBusy) return;
  npSentsEnsure(w); npCutPaint(container);
  if (!(s.sents || []).length) { npArNoGo('这份文案还没列出句子：点上面「⟳ 按这份文案重列句子」'); return; }
  if ((s.sents || []).length < 2) { if (typeof toast === 'function') toast('这份文案就一句话，不用建议断点——自己拖一下就好'); return; }
  const look = npLookOf(w);
  s.cutBusy = true; s.cutErr = ''; s.suggest = [];
  npCutPaint(container);
  const stop = npWaitInto(container, 'npCutWait', 'AI 正在看这份该在哪儿断几刀（只给建议，不动你拖好的段）', 'notecuts', () => npS() === w && s.cutBusy);
  try {
    const r = await chrome.runtime.sendMessage({
      action: 'suggestNoteCuts',
      data: {
        platform: npPid(w),
        title: (_npNote && _npNote.title) || (((w.draft && w.draft.titles) || [])[0] || ''),
        sellPoint: npSellPointStr(),
        motif: String(look.motif || ''),
        ink: npInkOf(look),
        look: npLookToken(look),
        sents: (s.sents || []).map(x => ({ id: x.id, text: x.text })),
        segs: (s.items || []).map(it => ({ sids: (it.sids || []).slice() })),
      },
    });
    if (!r || r.ok === false) throw new Error((r && r.error) || 'AI 这次没回建议断点');
    s.suggest = npCutsValid(w, r.cuts || []);
  } catch (e) { s.cutErr = String((e && e.message) || e); }
  s.cutBusy = false;
  stop();
  npCutPaint(container);
  if (!s.cutErr && !s.suggest.length && typeof toast === 'function') toast('AI 看下来这几刀不用再补——现在的切法能用');
}
/** 点某一刀的「采纳」：段中间那一刀就把这一段切开；池子里那一刀就把「到这句为止」那串没归段的句子收成一段，
 *  排在前一句所在的那一段后面（前面还没成段就排最前） */
function npCutAdopt(container, sid) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const p = npSentPos(w, sid);
  if (p < 0 || p >= (s.sents || []).length - 1) return;
  const nextId = String((s.sents[p + 1] || {}).id || '');
  if (!nextId) return;
  const here = npSentOwner(w, sid), next = npSentOwner(w, nextId);
  if (here && next === here) { npSegSplitAfter(container, here.id, sid); return; }
  if (here || next) { s.suggest = npCutsValid(w, s.suggest); npCutPaint(container); return; }
  let start = p;
  while (start - 1 >= 0 && !npSentOwner(w, s.sents[start - 1].id)) start--;
  const sids = s.sents.slice(start, p + 1).map(x => x.id);
  let after = null;
  for (let i = start - 1; i >= 0; i--) { const it = npSentOwner(w, s.sents[i].id); if (it) { after = it; break; } }
  const it = npNewSeg(sids);
  s.items.splice(after ? (s.items.indexOf(after) + 1) : 0, 0, it);
  npCutChanged(container, w);
}

/* ── 🔁 照这一派重出图描述（五十五改）──────────────────────────────────
   断句那一发是按「当时那一派」写图描述的。换了流派不必重新断句（段一重排，人调过的全没了），
   只把图描述那几格按新派重写一遍：段文本 / 顺序 / 不占图 / 传回来的图一律不动，手改过（带锁）的那几格跳过。
   一批 5 段分开烧：一次全发容易把回答撑到截断，那一发就白烧了。 */
const NP_DESC_BATCH = 5;
let _npDescBusy = false;

async function npDescsRegen(container, onlyId) {
  const w = npS(); if (!w || !w.shots || _npDescBusy) return;
  const look = npLookOf(w);
  const motif = String(look.motif || '');
  if (!motif) { if (typeof toast === 'function') toast('还没定画面流派：先在「🎨 这一套图的风格」上挑一派', 'error'); return; }
  const on = npShotsOn(w);
  const pick = onlyId ? on.filter(it => it.id === String(onlyId)) : on;
  const targets = pick.filter(it => !it.dlock && String(it.text || '').trim());
  const locked = on.filter(it => it.dlock).length;
  if (!targets.length) {
    if (typeof toast === 'function') toast(locked ? '这几段的图描述都带 🔒（你手改过）：点掉锁再重出' : '还没有要出图的段：先在 ② 断句台把句子拖成段');
    return;
  }
  const content = npImgSourceText(w);
  _npDescBusy = true;
  const box = _npEl(container, 'npLookBox'); if (box) box.innerHTML = npLookPanelHtml(w);
  const stopWait = npWaitInto(container, 'npDescWait', 'AI 正在照「' + motif + '」重写这 ' + targets.length + ' 段的图描述', 'notedescs', () => npS() === w && _npDescBusy);
  let done = 0, err = '';
  try {
    for (let i = 0; i < targets.length; i += NP_DESC_BATCH) {
      const chunk = targets.slice(i, i + NP_DESC_BATCH);
      try {
        const r = await chrome.runtime.sendMessage({
          action: 'regenNoteDescs',
          data: {
            platform: npPid(w),
            title: (_npNote && _npNote.title) || (((w.draft && w.draft.titles) || [])[0] || ''),
            sellPoint: npSellPointStr(),
            motif: motif,
            ink: npInkOf(look),
            look: npLookToken(look),
            content: content,                      // 整篇原料：只重写下面这几段，全篇拿来判断这一张该往前推什么
            items: chunk.map(it => {
              const k = on.indexOf(it);
              return {
                id: it.id, text: String(it.text || ''),
                no: k + 1, total: on.length,
                before: k > 0 ? String(on[k - 1].text || '') : '',
                after: k >= 0 && k < on.length - 1 ? String(on[k + 1].text || '') : '',
              };
            }),
          },
        });
        if (!r || r.ok === false || !Array.isArray(r.descs)) throw new Error((r && r.error) || 'AI 这次没回图描述');
        const byId = {};
        (r.descs || []).forEach(x => { if (x && x.id) byId[String(x.id)] = String(x.desc || '').trim(); });
        chunk.forEach(it => {
          const d = byId[it.id];
          if (!d) return;
          it.desc = d; it.dlock = false; done++;
        });
      } catch (e) { if (!err) err = String((e && e.message) || e); }
    }
  } finally { _npDescBusy = false; }
  stopWait();
  npShotsCompose(w);
  if (npS() === w) { if (done) npArchiveSave(w); npRenderOutput(container); }
  if (typeof toast === 'function') {
    if (done) toast('照「' + motif + '」重出了 ' + done + ' 段图描述' +
      (locked ? '（' + locked + ' 段带 🔒 手改，跳过）' : '') + (err ? '；有一批没成：' + err : ''));
    else if (err) toast('重出图描述没成：' + err, 'error');
  }
}

/* ── ② 分镜表：一行＝一段＝一张图（五十四改）────────────────────────────
   四列：段文本（这段的原文，可手改、可在光标处再断一刀）
        ｜图描述（五十六改：四小段——中心思想／取材／版式／图上文字＋增量；「取材」这一小段由这一派的转译配方管，
          不是把这段字美化一遍；下面挂一颗零 AI 的「还是在抄文案」，判法见 npDescShallow）
        ｜提示词（本地拼，改上面两格当场重排，不烧 AI）｜图（把 AI 生成好的那张传回来）
   分界怎么维护：拖一行到紧挨它上面那一行＝两段并成一张；拖到别处＝换顺序；
                或者把光标放到要断开的字前面，点「✂ 从这儿断」把一段拆成两段。 */
const NP_SHOT_TH = 'box-sizing:border-box;font-size:10px;color:#8a929e;font-weight:700;text-align:left;padding:3px 6px;white-space:nowrap;vertical-align:bottom;';
const NP_SHOT_TD = 'box-sizing:border-box;padding:6px;border-top:1px solid var(--line);vertical-align:top;';
const NP_SHOT_BT = 'border:1px solid var(--line);border-radius:6px;background:#fff;color:#666;font-size:11px;font-weight:700;cursor:pointer;padding:3px 7px;';
const NP_SHOT_TA = 'width:100%;box-sizing:border-box;padding:6px 8px;border:1px solid #e7e8ec;border-radius:7px;font-size:12px;line-height:1.65;resize:vertical;';

/** 图描述那一格的锁：手改过就挂上（🔁 重出图描述会跳过带锁的那一行），点一下放开 */
function npShotLockHtml(it) {
  if (!it || !it.dlock) return '';
  return ' <button type="button" class="np-shot-lock" data-id="' + npArAttr(it.id) + '" ' +
    'title="这一格的图描述你手改过：「\uD83D\uDD04 照这一派重出图描述」会跳过它。点一下＝放开，让它跟着重出" ' +
    'style="border:1px solid #f0d6bc;border-radius:5px;background:#fffaf3;color:#c2410c;font-size:9px;font-weight:700;cursor:pointer;padding:0 5px;">\uD83D\uDD12 手改</button>';
}

/** 零 AI 的抄文案检查（五十六改）：图描述基本还是这段字，就是没照流派重组。
 *  判法＝把这段原文里出现过的两字组从图描述里划掉，被划掉的字占七成以上＝它没带进这段没写的画面名词（人、手、桌上的实物、界面区块、格子、箭头…）。
 *  只对写得够长的格子判，短的不吵；判错也不拦路——那一格照样能手改。 */
function npDescShallow(desc, text) {
  const flat = (s) => String(s || '').replace(/[\s　「」『』“”‘’"'（）()【】[]，。、；：！？…—－·-]/g, '');
  const d = flat(desc), t = flat(text);
  if (d.length < 24 || t.length < 4) return false;
  const grams = {};
  for (let i = 0; i + 1 < t.length; i++) grams[t.substr(i, 2)] = 1;
  const hit = [];
  for (let i = 0; i < d.length; i++) hit.push(false);
  for (let i = 0; i + 1 < d.length; i++) {
    if (grams[d.substr(i, 2)]) { hit[i] = true; hit[i + 1] = true; }
  }
  let covered = 0;
  for (let i = 0; i < hit.length; i++) if (hit[i]) covered++;
  return covered / d.length > 0.7;
}
/** 图描述格子下面那颗警示钮：点一下＝只照这一派重出这一段（带 🔒 那一格由 npDescsRegen 给原因） */
function npShotShallowHtml(it) {
  if (!it || !npDescShallow(it.desc, it.text)) return '';
  return '<button type="button" class="np-shot-shallow" data-id="' + npArAttr(it.id) + '" ' +
    'title="这一格基本还是这段字（把这段的词划掉就没剩什么）：照这一派重出，画面上要摆的东西得是这段没写的。点一下＝只重出这一段" ' +
    'style="display:block;margin-top:4px;border:1px solid #f0d6bc;border-radius:6px;background:#fffaf3;color:#b45309;font-size:10px;font-weight:700;cursor:pointer;padding:2px 7px;">\u26A0\uFE0F 还是在抄文案</button>';
}

/* ── ② ✂️ 断句台的渲染 ─────────────────────────────────────────────
   句子是一张张可以拖的卡；「第 N 段」是一个框：把卡拖进哪个框，那一屏／那一张图就收这几句。
   这一段占不占图、拆、并、挪、删都在段头那一排旋钮上；段文本是拼出来的，要改字点卡上的 ✎。 */
const NP_CUT_BT = 'border:1px solid var(--line);border-radius:6px;background:#fff;color:#58616f;font-size:10px;font-weight:700;cursor:pointer;padding:2px 7px;';
const NP_CUT_TA = 'width:100%;box-sizing:border-box;margin-top:5px;padding:7px 9px;border:1px solid #e7e8ec;border-radius:8px;font-size:12px;line-height:1.7;resize:vertical;';

/** 一段还带着旧档／手打的那份字（没跟句子绑）：这种框不接拖进来的句子，不然拼出来的段文本会把那份字顶掉 */
function npSegLegacy(it) { return !!(it && !(it.sids || []).length && String(it.text || '').trim()); }

function npSentChipHtml(w, x, segId, sug) {
  const s = w.shots;
  const no = npSentPos(w, x.id) + 1;
  if (s.editing === x.id) {
    return '<span class="np-sent-edit" data-sid="' + npArAttr(x.id) + '" style="display:block;margin:3px 0;">' +
      '<textarea class="np-sent-in" data-sid="' + npArAttr(x.id) + '" rows="2" spellcheck="false" ' +
      'style="width:100%;box-sizing:border-box;padding:6px 8px;border:1px solid var(--c-brand);border-radius:7px;font-size:12px;line-height:1.65;resize:vertical;">' + esc(x.text) + '</textarea>' +
      '<button type="button" class="np-sent-fix-ok" data-sid="' + npArAttr(x.id) + '" style="' + NP_CUT_BT + 'margin-top:3px;color:#15803d;border-color:#bbe8c8;">\u2713 就这几个字</button>' +
      '<button type="button" class="np-sent-fix-no" data-sid="' + npArAttr(x.id) + '" style="' + NP_CUT_BT + 'margin-top:3px;">\u2715 不改</button>' +
      '<span style="font-size:10px;color:#8a929e;margin-left:4px;">改的是这一句本身，它还留在原来那一段里（第 ' + no + ' 句）</span></span>';
  }
  return '<span class="np-sent" data-sid="' + npArAttr(x.id) + '" data-seg="' + npArAttr(segId || '') + '" draggable="true" ' +
    'title="' + npArAttr('第 ' + no + ' 句：拖进哪个「第 N 段」框，那一屏就收这一句；拖回上面的池子＝这句先不占图') + '" ' +
    'style="display:inline-flex;align-items:center;gap:5px;vertical-align:middle;margin:3px 4px 3px 0;padding:4px 6px;border:1px solid #ddd6fe;border-radius:8px;background:#faf9ff;' +
    'font-size:12px;line-height:1.55;color:#14181f;cursor:grab;max-width:100%;">' +
    '<b style="font-size:9px;color:#a78bfa;font-weight:700;">' + no + '</b>' +
    '<span style="word-break:break-word;">' + esc(x.text) + '</span>' +
    (sug ? '<button type="button" class="np-cut-adopt" data-after="' + npArAttr(x.id) + '" title="' + npArAttr('AI 建议在这一句后面断一刀：' + (sug.why || '这一段到这里说完了，下一句另起一张图') + '（点一下才生效）') + '" ' +
      'style="border:1px dashed #f0d6bc;border-radius:6px;background:#fffaf3;color:#b45309;font-size:10px;font-weight:700;cursor:pointer;padding:1px 6px;white-space:nowrap;">\uD83D\uDD2E 在这后面断一刀' + (sug.why ? ' · ' + esc(sug.why) : '') + '</button>' +
      '<button type="button" class="np-cut-dismiss" data-after="' + npArAttr(x.id) + '" title="这条建议不用，收起来" style="border:none;background:none;color:#b6bec9;cursor:pointer;font-size:10px;">\u2715</button>' : '') +
    '<button type="button" class="np-sent-cut" data-sid="' + npArAttr(x.id) + '" title="这一句太长想分两屏：在句中停顿处补一刀，拆成前后两句" style="' + NP_CUT_BT + '">\u2702拆句</button>' +
    '<button type="button" class="np-sent-fix" data-sid="' + npArAttr(x.id) + '" title="改这一句的字（只动这一句；整份文案要改就改上面那格再点 ⟳）" style="' + NP_CUT_BT + '">\u270E</button>' +
    (segId ? '<button type="button" class="np-sent-out" data-sid="' + npArAttr(x.id) + '" title="把这句拖回上面池子（这一段就没它了）" style="' + NP_CUT_BT + '">\u2912</button>' : '') +
    '</span>';
}

function npCutSegHtml(w, it, i) {
  const s = w.shots;
  const on = !it.off;
  const sids = it.sids || [];
  const sug = {};
  (s.suggest || []).forEach(x => { sug[x.after] = x; });
  const body = sids.length
    ? sids.map((id) => {
        const x = npSentOf(w, id);
        return x ? npSentChipHtml(w, x, it.id, sug[id]) : '';
      }).join('')
    : (npSegLegacy(it)
        ? '<div style="font-size:11px;color:#8a929e;line-height:1.65;background:#f7f7f8;border:1px dashed var(--line);border-radius:7px;padding:6px 8px;">' +
            esc(it.text) + '<div style="font-size:10px;color:#b45309;margin-top:3px;">这一段还是旧档那份字，没跟上面的句子绑上：点段头的 ⟳ 按原文绑上，或直接 ✕ 散掉它再拖句子进来（拖进来的句子会把这段重新拼）。</div></div>'
        : '<div style="font-size:11px;color:#a78bfa;border:1px dashed #ddd6fe;border-radius:7px;padding:7px 8px;">把上面的句子卡拖进来＝这一屏就收这几句（一句也行，两三句也行）。</div>');
  const knob = (cls, data, title, label, extra) =>
    '<button type="button" class="' + cls + '" data-id="' + npArAttr(it.id) + '"' + (data || '') + ' title="' + npArAttr(title) + '" style="' + NP_CUT_BT + (extra || '') + '">' + label + '</button>';
  return '<div class="np-cutseg" data-id="' + npArAttr(it.id) + '" style="border:1px solid ' + (on ? '#ddd6fe' : '#e5e7eb') + ';border-radius:9px;background:' + (on ? '#fff' : '#f7f7f8') + ';padding:6px 8px;margin-top:7px;">' +
    '<div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">' +
      '<b style="font-size:11px;color:' + (on ? '#6d28d9' : '#9aa0ac') + ';">第 ' + (i + 1) + ' 段' + (on ? '' : ' · 过场') + '</b>' +
      '<span style="font-size:10px;color:#8a929e;">' + sids.length + ' 句 · ' + String(it.text || '').length + ' 字</span>' +
      '<span style="flex:1;"></span>' +
      knob('np-shot-key', '', on ? '这一段不单独出图（过场话）' : '这一段要出一张图', on ? '\uD83D\uDDBC' : '\u2B1C') +
      (sids.length > 1 ? knob('np-seg-split', '', '从中间这一刀切成两段（想切在哪一句后面，点那句上的 ✂）', '\u2702拆') : '') +
      (i > 0 ? knob('np-shot-merge', '', '并到上面那一段＝两段合一张图', '\u2912 并上') : '') +
      (npSegLegacy(it) ? knob('np-seg-bind', '', '照这段原来的字，去上面的句子里连着对上几句绑上', '\u27F3 绑句子') : '') +
      (sids.length > 1 ? knob('np-seg-only', '', '图上只放一句：只留第一句，其余句子拖回上面池子', '\u2702 只留第一句') : '') +
      knob('np-shot-move', ' data-d="-1"', '这一段往上挪一位', '\u2191', i <= 0 ? 'opacity:.35;cursor:default;' : '') +
      knob('np-shot-move', ' data-d="1"', '这一段往下挪一位', '\u2193', i >= (s.items || []).length - 1 ? 'opacity:.35;cursor:default;' : '') +
      (sids.length ? knob('np-seg-take', '', '把上面池子里按文案顺序的下一句收进这一段', '\uFF0B 收下一句') : '') +
      '<button type="button" class="np-seg-del" data-id="' + npArAttr(it.id) + '" title="散掉这一段：句子回到上面池子，正文一个字都不动" style="border:none;background:none;color:#9aa0ac;cursor:pointer;font-size:11px;">\u2715</button>' +
    '</div>' +
    '<div style="margin-top:4px;">' + body + '</div>' +
  '</div>';
}

/* ── 五档工作流节点条（五十七改：断句单独占一档，段由人拖出来）────────────────
   这一排只是「走到哪儿了」的路标＋每档一句人话状态，点一下滚过去；
   真正的旋钮都在下面那五个块里，这里不放按钮以外的东西。 */
function npNodeStripHtml(w) {
  const s = (w && w.shots) || {};
  const items = s.items || [], sents = s.sents || [];
  const on = npShotsOn(w);
  const look = npLookOf(w);
  const motif = String(look.motif || '').trim();
  const pool = sents.filter(x => !npSentOwner(w, x.id)).length;
  const noDesc = on.filter(it => !String(it.desc || '').trim()).length;
  const shallow = on.filter(it => npDescShallow(it.desc, it.text)).length;
  const noImg = on.filter(it => !(it.imgs || []).length).length;
  const noCut = !items.length;
  const node = (k, no, t, st, bad) =>
    '<button type="button" class="np-node" data-k="' + k + '" title="' + npArAttr('滚到第 ' + no + ' 档：' + t) + '" ' +
      'style="display:inline-flex;align-items:center;gap:5px;border:1px solid ' + (bad ? '#f0b4b4' : '#e9d5ff') + ';border-radius:999px;' +
      'background:' + (bad ? '#fff5f4' : '#fff') + ';color:' + (bad ? '#d92d20' : '#6d28d9') + ';font-size:11px;font-weight:700;padding:4px 10px;cursor:pointer;">' +
      '<span>' + t + '</span>' +
      '<span style="font-weight:400;color:' + (bad ? '#d92d20' : '#9aa0ac') + ';font-size:10px;">' + st + '</span></button>';
  return '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">' +
    node('look', 1, '\u2460 \uD83C\uDFA8 风格', motif ? motif : '还没挑画面流派', !motif) +
    node('cut', 2, '\u2461 \u2702\uFE0F 断句', noCut ? '一段都还没拖' : (pool ? items.length + ' 段 · ' + pool + ' 句没归段' : items.length + ' 段 · 句子都归好了'), noCut || pool > 0) +
    node('desc', 3, '\u2462 \uD83D\uDD8B 图描述', on.length ? (noDesc ? '还有 ' + noDesc + ' 段没写' : (shallow ? shallow + ' 段还在抄文案' : on.length + ' 段都写了')) : '先断句', noCut || noDesc > 0 || shallow > 0) +
    node('copy', 4, '\u2463 1\uFE0F\u20E3 编号提示词', on.length ? on.length + ' 张，复制去生成' : '先断句', !on.length) +
    node('got', 5, '\u2464 \u2B06\uFE0F 传图', on.length ? (noImg ? '缺 ' + noImg + ' 张' : on.length + ' 张齐了') : '—', on.length > 0 && noImg > 0) +
  '</div>';
}

/** ② 那一块：文案（断句的原料）→ 逐句列出 → 拖成段 */
function npCutBoxHtml(w) {
  const s = w.shots = w.shots || npShotsShape(null);
  const src = npImgSourceText(w);
  const items = s.items || [];
  const sents = s.sents || [];
  const on = npShotsOn(w);
  const pool = sents.filter(x => !npSentOwner(w, x.id));
  const stale = npCutStale(w);
  const sug = {};
  (s.suggest || []).filter(x => !x.seg).forEach(x => { sug[x.after] = x; });
  const btn = 'padding:6px 11px;border:1px solid var(--line);border-radius:8px;background:#fff;color:#58616f;font-size:11px;font-weight:700;cursor:pointer;';
  const go = 'padding:6px 12px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:11px;font-weight:700;cursor:pointer;';
  return '<div id="npCutBox" style="border:1px solid #e9d5ff;border-radius:10px;background:#faf8ff;padding:9px 11px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
      '<b style="font-size:12px;color:#333;">\uD83D\uDCC4 这一篇要断句的文案</b>' +
      '<span style="font-size:10px;color:#8a929e;">改它会存进这一档，出片台要念的还是它</span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="np-copy-field" data-id="npVoiceTa" data-label="文案" style="' + NP_CUT_BT + 'padding:2px 8px;font-size:11px;">\uD83D\uDCCB 复制</button>' +
    '</div>' +
    '<textarea id="npVoiceTa" rows="4" spellcheck="false" placeholder="一段一行更好断；没单独写过口播稿就先照正文断" style="' + NP_CUT_TA + '">' + esc(src) + '</textarea>' +
    '<div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:8px;">' +
      '<button type="button" class="np-cut-relest" style="' + (stale ? go : btn) + '">\u27F3 按这份文案重列句子' + (sents.length ? '（' + sents.length + ' 句）' : '') + '</button>' +
      '<button type="button" class="np-cut-suggest"' + (s.cutBusy ? ' disabled' : '') + ' title="' + npArAttr('让 AI 只看这份逐句清单，标出该在哪儿断一刀：每一刀都要你点一下才生效，它不会推翻你已经拖好的段') + '" style="' + btn + '">' + (s.cutBusy ? '\u23F3 看刀中…' : '\uD83D\uDD2E 建议断点') + '</button>' +
      '<button type="button" class="np-cut-newseg" style="' + btn + '">\uFF0B 新开一段</button>' +
      '<span style="flex:1;"></span>' +
      '<span style="font-size:10px;color:#8a929e;">' + sents.length + ' 句 · ' + items.length + ' 段 · 占图 ' + on.length + ' 张' + (pool.length ? ' · <b style="color:#b45309;">还有 ' + pool.length + ' 句没归段</b>' : '') + '</span>' +
    '</div>' +
    '<div id="npCutWait" style="font-size:11px;color:#888;margin-top:4px;"></div>' +
    (s.cutErr ? '<div style="font-size:11px;color:#d92d20;margin-top:4px;">建议断点没回来：' + esc(s.cutErr) + '</div>' : '') +
    '<div id="npSrcStale" style="font-size:10px;color:#b45309;margin-top:4px;"' + (stale ? '' : ' hidden') + '>\u26A0\uFE0F 上面这份文案跟下面这些句子对不上了（改过或还没重列）——点「\u27F3 按这份文案重列句子」。没改过字的那几句还是原来那段里的那一句，分组不会散。</div>' +
    '<div class="np-cutpool" style="border:1px ' + (pool.length ? 'solid' : 'dashed') + ' #ddd6fe;border-radius:9px;background:#fff;padding:7px 8px;margin-top:8px;">' +
      '<div style="font-size:10px;font-weight:700;color:#7c3aed;margin-bottom:2px;">\u2B55 还没归段的句子（' + pool.length + '）' +
        '<span class="qhelp" tabindex="0" data-tip="这一池子就是顶上那份文案按标点（。！？；）逐句列出来的，一次 AI 都没烧。句子拖进哪个「第 N 段」框，那一屏／那一张图就收它；一张图可以装一两句。句末标点对不上你想要的切法，就用卡上的 \u2702拆句 补一刀。">?</span></div>' +
      (pool.length ? pool.map(x => npSentChipHtml(w, x, '', sug[x.id])).join('')
        : '<div style="font-size:11px;color:#a78bfa;">句子都归好段了——要挪动就回下面某一段里拖那张卡。</div>') +
    '</div>' +
    items.map((it, i) => npCutSegHtml(w, it, i)).join('') +
    '<div class="np-cutnew" style="border:1px dashed #cbb7f2;border-radius:9px;background:#fdfcff;padding:7px 9px;margin-top:7px;font-size:11px;color:#7c3aed;cursor:pointer;">' +
      '\u2B07 拖到这里＝新开一段（这一句自己占一屏）；不想拖就点上面的「\uFF0B 新开一段」再收句子</div>' +
    (src ? '' : '<div style="font-size:11px;color:#b45309;margin-top:6px;">上面那格还是空的：回「\u270F\uFE0F 写文案」把正文定下来，才轮到断句出图。</div>') +
  '</div>';
}

/** ⟳ 按这份文案重列句子：句子编号按原文复用，没改过的那几句还在原来那段里，拖好的分组不散 */
function npCutRelest(container) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const src = npImgSourceText(w);
  if (!src) { npArNoGo('上面那格还是空的：回「写文案」把正文定下来，才轮到断句出图'); return; }
  const n = npSentsRebuild(w, src);
  npCutChanged(container, w);
  if (typeof toast === 'function') toast('按这份文案重列了 ' + n + ' 句' + ((s.items || []).length ? '（你已经拖好的段没散）' : ''), 'ok');
}
/** ＋ 新开一段：先摆一个空框，句子从池子拖进来或点「＋ 收下一句」一句句收 */
function npCutNewEmpty(container) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  s.items = s.items || [];
  s.items.push(npNewSeg([]));
  npArchiveSave(w);
  npCutPaint(container);
}
/** ✕ 收起一条建议（结构一个字不动；下次点 🔮 还会再看回来） */
function npCutDismiss(container, sid) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  s.suggest = (s.suggest || []).filter(x => String(x.after) !== String(sid));
  npCutPaint(container);
}
/** ✎ 改这一句的字：就地摊开输入框（回车提交／Esc 不改）——只动这一句，它所在那段不散 */
function npSentEditOpen(container, sid) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  s.editing = String(sid);
  npCutPaint(container);
  const ta = container.querySelector ? container.querySelector('.np-sent-in[data-sid="' + sid + '"]') : null;
  if (ta) { ta.focus(); ta.select(); }
}
function npSentEditClose(container) {
  const w = npS(); if (!w || !w.shots) return;
  w.shots.editing = '';
  npCutPaint(container);
}
/** 节点条：点一档滚到那一档（③④⑤ 三个锚点都在那张表下面，各自一段） */
function npNodeGoto(container, k) {
  const id = { look: 'npLookBox', cut: 'npCutWrap', desc: 'npNodeDesc', copy: 'npNodeCopy', got: 'npNodeGot' }[String(k || '')];
  const el = (id && container.querySelector) ? container.querySelector('#' + id) : null;
  if (el && el.scrollIntoView) el.scrollIntoView({ block: 'start', behavior: 'smooth' });
}

/** 断句动了结构：只重画 ② 断句台 + ③④⑤ 那张表（整页甩会把人滚过的地方顶回顶上） */
function npCutPaint(container) {
  const w = npS(); if (!w || !container || !w.shots) return;
  const wrap = _npEl(container, 'npCutWrap');
  if (wrap) wrap.innerHTML = npCutBoxHtml(w);
  const tb = _npEl(container, 'npShotTable');
  if (tb) tb.innerHTML = npShotsTableHtml(w);
  const strip = _npEl(container, 'npNodes');
  if (strip) strip.innerHTML = npNodeStripHtml(w);
  const lk = _npEl(container, 'npLookBox');
  if (lk) {                                     // ① 面板底下那颗 🔁 只在有段时才摆：断完句要当场看见它，不该再点一下别的才冒出来
    const was = lk.querySelector ? !!lk.querySelector('details[open]') : false;
    lk.innerHTML = npLookPanelHtml(w);
    if (was) { const d = lk.querySelector('details'); if (d) d.open = true; }
  }
}

function npShotRowHtml(w, it, no) {
  const items = w.shots.items || [];
  const idx = items.indexOf(it);
  const on = !it.off;
  const imgs = (it.imgs || []).map(id => ({ id: id, v: _npShotImgs[id] || null })).filter(x => x.v);
  const miss = on && !imgs.length;
  const noDesc = on && !String(it.desc || '').trim();
  const on2 = npShotsOn(w);
  const pi = on2.indexOf(it);
  const chip = (x) => '<span style="display:inline-flex;align-items:center;gap:3px;border:1px solid var(--line);border-radius:6px;padding:2px 3px;background:#fff;">' +
      (x.v.thumb ? '<img src="' + escAttr(x.v.thumb) + '" style="height:32px;width:32px;object-fit:cover;border-radius:4px;">' : '') +
      '<button type="button" class="np-shot-unlink" data-id="' + npArAttr(it.id) + '" data-a="' + npArAttr(x.id) + '" title="从这一张摘掉（素材库里那条还在）" style="border:none;background:none;color:#9aa0ac;cursor:pointer;font-size:11px;">\u2715</button></span>';
  const mini = 'font-size:10px;color:#8a929e;margin-bottom:3px;';
  const red = 'font-size:10px;font-weight:700;color:#d92d20;margin-top:3px;';
  const promptCell = on
    ? '<div class="np-shot-pout" data-id="' + npArAttr(it.id) + '" style="box-sizing:border-box;width:100%;font-size:11px;color:#555;line-height:1.6;white-space:pre-wrap;background:#fafbfc;border:1px solid var(--line);border-radius:7px;padding:6px 8px;max-height:132px;overflow:auto;">' + esc(npShotPromptText(w, it, pi, on2.length)) + '</div>' +
      '<button type="button" class="np-shot-copy" data-id="' + npArAttr(it.id) + '" style="' + NP_SHOT_BT + 'margin-top:4px;color:#6d28d9;border-color:#e0d8fb;">\uD83D\uDCCB 复制这一张</button>'
    : '<div style="font-size:11px;color:#8a929e;background:#f7f7f8;border:1px dashed var(--line-2, #dde2e9);border-radius:7px;padding:6px 8px;">这一段不占图，不拼提示词</div>';
  const imgCell = on
    ? '<div style="' + mini + '">' + esc('画面 ' + no + ' / ' + on2.length) + '</div>' +
      imgs.map(chip).join('') +
      '<button type="button" class="np-shot-up" data-id="' + npArAttr(it.id) + '" style="' + NP_SHOT_BT + (imgs.length ? 'margin-top:4px;display:block;' : '') + '">\u2B06 传图</button>' +
      (miss ? '<div style="' + red + '">\u23F3 还没传图</div>' : '')
    : '<div style="font-size:11px;color:#8a929e;">这一段不占图</div>';
  return '<tr class="np-shot" data-id="' + npArAttr(it.id) + '" draggable="true" style="background:' + (on ? '#fff' : '#f7f7f8') + ';' + (miss || noDesc ? 'outline:' : '') + (miss || noDesc ? (miss ? '1px solid #f0b4b4;' : '1px dashed #e9d5ff;') : '') + '">' +
    '<td style="' + NP_SHOT_TD + 'width:56px;text-align:center;color:#b6bec9;font-size:13px;cursor:grab;" title="拖这一行：放到紧上面那一行＝两段并成一张图，放到别处＝换顺序（同样的旋钮在 ② 断句台的段头上也有）">\u2195' +
      '<div style="font-size:10px;color:#8a929e;margin-top:3px;">' + (no ? '画面 ' + no : '不占图') + '</div></td>' +
    '<td style="' + NP_SHOT_TD + 'width:22%;">' +
      '<div style="' + mini + '">' + esc('第 ' + (idx + 1) + ' 段 · ' + (it.sids || []).length + ' 句') + (on ? '' : ' · 过场') + '</div>' +
      '<div class="np-shot-txt" data-id="' + npArAttr(it.id) + '" style="box-sizing:border-box;width:100%;padding:6px 8px;border:1px dashed var(--line);border-radius:7px;background:#fafbfc;font-size:12px;line-height:1.65;color:#555;word-break:break-word;white-space:pre-wrap;">' + (String(it.text || '').trim() ? esc(it.text) : '<span style="color:#b45309;">还没拖句子进来</span>') + '</div>' +
      '<div style="font-size:10px;color:#9aa0ac;margin-top:3px;">这段的字是上面那几句拼出来的：要换切法、增减句子，回 ② 断句台拖' + (npSegLegacy(it) ? '（这一段还是旧档那份字，去 ② 点 ⟳ 绑上句子）' : '') + '</div>' +
    '</td>' +
    '<td style="' + NP_SHOT_TD + 'width:24%;">' +
      '<div style="' + mini + '">图描述 · 中心思想／取材／版式／图上文字<span class="np-shot-lockslot">' + npShotLockHtml(it) + '</span></div>' +
      '<textarea class="np-shot-desc" data-id="' + npArAttr(it.id) + '" rows="4" spellcheck="false" placeholder="四小段：『中心思想』这张图替这段站稳什么｜『取材』照这一派摆什么具体东西（人、实物、界面、格子…这段没写的也算）｜『版式』主体在哪、字放哪、留白在哪｜『图上文字＋增量』放哪句、分几行，再加这一张比这段文字多给了什么（缺料就写「缺：××」）" style="' + NP_SHOT_TA + 'background:' + (noDesc ? '#fef1f0' : '#fcfcfe') + ';">' + esc(it.desc) + '</textarea>' +
      (noDesc ? '<div style="' + red + '">还没写图描述</div>' : '') +
      npShotShallowHtml(it) +
    '</td>' +
    '<td style="' + NP_SHOT_TD + 'width:26%;">' + '<div style="' + mini + '">提示词（这一段一张）</div>' + promptCell + '</td>' +
    '<td style="' + NP_SHOT_TD + 'width:104px;">' + imgCell + '</td></tr>';
}

function npShotsTableHtml(w) {
  const s = w.shots || {};
  const items = s.items || [];
  const on = npShotsOn(w);
  let n = 0;
  const rows = items.map(it => npShotRowHtml(w, it, it.off ? 0 : (++n))).join('');
  const lack = on.filter(x => !(x.imgs || []).length);
  const shallow = on.filter(x => npDescShallow(x.desc, x.text)).length;
  const heads = ['', '段文本（② 拖出来的那几句拼的，只读）', '图描述 · 中心思想／取材／版式／图上文字', '提示词（本地拼，改上面当场重排）', '图'];
  const h3 = 'font-size:11px;font-weight:700;color:#333;';
  const sub = 'font-size:10px;color:#8a929e;line-height:1.6;';
  const all = npShotsAllText(w);
  return '<div id="npNodeDesc" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px;">' +
      '<b style="' + h3 + '">\u2462 \uD83D\uDD8B 图描述（这一段要变成这一派里的什么料）</b>' +
      '<span class="qhelp" tabindex="0" data-tip="这一列不是把段文本美化一遍：按上面挑的那一派，把这段换成画面上看得见的具体东西（人、手、桌上的实物、界面区块、格子、箭头都算），四小段＝中心思想／取材／版式／图上文字＋增量。写着写着又只剩这段那几个字，下面那行「\u26A0\uFE0F 还是在抄文案」会亮（零 AI 判的）。要整批按新流派重写，用风格面板底下那颗 \uD83D\uDD04。">?</span>' +
      (on.length ? '<span style="' + sub + '">' + on.filter(x => String(x.desc || '').trim()).length + ' / ' + on.length + ' 段写了' +
        (shallow ? ' · <b style="color:#b45309;">' + shallow + ' 段还在抄文案</b>' : '') + '</span>' : '') +
    '</div>' +
    (items.length
    ? '<div style="border:1px solid var(--line);border-radius:10px;background:#fff;overflow:auto;">' +
        '<table style="width:100%;border-collapse:collapse;">' +
          '<thead><tr>' + heads.map(h => '<th style="' + NP_SHOT_TH + '">' + h + '</th>').join('') + '</tr></thead>' +
          '<tbody>' + rows + '</tbody></table></div>'
    : '<div style="border:1px dashed #cbb7f2;border-radius:9px;background:#fff;padding:10px 12px;">' +
        '<div style="font-size:12px;font-weight:700;color:#7c3aed;">③④⑤ 这三档在等 ②：上面还没有一段</div>' +
        '<div style="' + sub + '">回上面那档把句子卡拖进「第 1 段」「第 2 段」——一段＝一屏＝一张图，拖完这里就一行一段（一行一张图描述、一张提示词、一张图）。</div></div>') +
  (items.length
    ? '<div style="margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">' +
        '<span style="' + sub + '">共 ' + items.length + ' 段 · 占图 ' + on.length + ' 张' +
        (on.length ? (lack.length ? ' · <b style="color:#d92d20;">还有 ' + lack.length + ' 张没图</b>' : ' · 图齐了') : '') +
        (shallow ? ' · <b style="color:#b45309;">' + shallow + ' 段还在抄文案</b>' : '') +
        ' · 换切法／挪段／⬜ 不占图都在 ② 断句台的段头上</span></div>' : '') +
  '<div id="npNodeCopy" style="margin-top:12px;">' +
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">' +
      '<b style="' + h3 + '">\u2463 1\uFE0F\u20E3 编号提示词（每一张一份，本地拼，不烧 AI）</b>' +
      '<span class="qhelp" tabindex="0" data-tip="上面两列（段文本、图描述）改一个字，这里的每一份当场重排；改「图上放多少字」那一档，也是这里跟着变。拿这一份去任何一家 AI 生图都行，生成完回 ⑤ 按画面号把图传回来。">?</span>' +
    '</div>' +
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;">' +
      '<button type="button" class="np-shots-copy-all" style="padding:6px 12px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;">\uD83D\uDCCB 一次复制全部提示词（' + on.length + ' 张' + (s.cover ? ' + 封面' : '') + '）</button>' +
      '<span style="flex:1;"></span>' +
    '</div>' +
    (all ? '<details style="margin-top:6px;"><summary style="font-size:11px;color:#7c3aed;cursor:pointer;">看整份拼好的样子（一张一份，按画面号排）</summary>' +
      '<textarea rows="10" readonly spellcheck="false" style="' + NP_SHOT_TA + 'background:#fafbfc;color:#555;">' + esc(all) + '</textarea></details>' : '') +
    '<details style="margin-top:6px;"' + (s.cover ? '' : ' open') + '><summary style="font-size:11px;color:#7c3aed;cursor:pointer;">' +
      (s.cover ? '封面 / 首图那一张的提示词（改过了）' : '封面 / 首图那一张（这一版 AI 不参与，本地照第 1 段拼一版起手）') + '</summary>' +
      '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:5px;">' +
        '<button type="button" class="np-cover-fill" style="' + NP_SHOT_BT + '">\uD83D\uDD27 照第 1 段拼一版</button>' +
        '<span style="' + sub + '">拼的是第 1 段那份提示词，只是把开头那行换成封面口径；不满意在这格里自己改，或先去 ② 把第一屏换成最想留人的那几句。</span></div>' +
      '<textarea id="npVisualCover" rows="5" spellcheck="false" placeholder="封面那张：主体 + 大字标题 + 版式（尺寸跟上面同一套）" style="' + NP_SHOT_TA + '">' + esc(s.cover) + '</textarea></details>' +
  '</div>' +
  '<div id="npNodeGot" style="margin-top:12px;">' +
    '<b style="' + h3 + '">\u2464 \u2B06\uFE0F 传图回来（生成好的那张按画面号挂上，原图不搬进扩展）</b>' +
    (on.length
      ? '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:6px;">' +
          (lack.length
            ? '<span style="font-size:11px;color:#d92d20;font-weight:700;">还缺 ' + lack.length + ' 张：' +
                lack.map(x => '画面 ' + (on.indexOf(x) + 1)).join('、') + '</span>' +
                '<span class="qhelp" tabindex="0" data-tip="到上面表里对应那一行的「图」那一格，点 ⬆ 传图，把 AI 生成好的那张选进来。只存引用和缩略图，原图你自己留着——出片台与素材库读的是同一份。">?</span>'
            : '<span style="font-size:11px;color:#15803d;font-weight:700;">' + on.length + ' 张全传回来了</span>' +
                '<span style="' + sub + '">可以拿去出片台了（入口在「笔记档案」的操作列）。</span>') +
          '<span style="flex:1;"></span>' +
          '<span style="' + sub + '">已传 ' + (on.length - lack.length) + ' / ' + on.length + '</span></div>'
      : '<div style="' + sub + 'margin-top:4px;">先有要出图的段（② 断句＋③ 图描述），这一档才有东西可传。</div>') +
  '</div>';
}

/* ═══════════ 🖼 造图片·图片列表：一行＝一个「平台 × 画面流派」，一行一份画面表 ═══════════
   老板 2026-10-01 五十三改：发笔记能出多平台的文案，同一篇又要几种画面的图，所以这一页顶上先摆一张列表，
   点哪一行才在下面摊开那一行的画面表（第一步是 ✂️ 断句，流派不再是门槛）。
   2026-10-02 五十五改：那一行的身份由「出图形式」换成「画面流派」——形式那一层一物三活，已拆给流派（摆什么）/ 字量档（装多少）/ 每条流派自带的 need（要什么料）。
   真源＝档案条目上的 imgDocs：一行带自己那份 shots/visual。w.shots / w.visual 恒等于「打开那一行」的镜像，
   所以档案缺口列、📖 教程、复制发布文案、出片台分幕这些读 visual/shots 的地方一律不用改。
   老档没记过 imgDocs＝读的时候按这一档那两份合成一行摆出来（不回填、不搬原图）。 */
function npImgId() { return 'g' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

/** 档案里这一篇已有的几套图；没有 imgDocs 这个键（老档）才按这一档的画面表合成一行 */
function npImgRowsOf(n) {
  if (!n) return [];
  if (Array.isArray(n.imgDocs)) {
    return n.imgDocs.filter(x => x && typeof x === 'object').map(x => ({
      id: String(x.id || npImgId()),
      pid: String(x.pid || n.platform || 'xhs'),
      style: String(x.style || ''),
      shots: npShotsShape(x.shots),
      visual: x.visual ? { cover: String(x.visual.cover || ''), images: String(x.visual.images || '') } : null,
      updatedAt: Number(x.updatedAt || 0) || 0,
    }));
  }
  const sh = npShotsShape(n.shots);
  const vis = (n.visual && (String(n.visual.cover || '').trim() || String(n.visual.images || '').trim()))
    ? { cover: String(n.visual.cover || ''), images: String(n.visual.images || '') } : null;
  if (!sh.items.length && !sh.cover && !vis) return [];
  return [{
    id: npImgId(), pid: String(n.platform || 'xhs'),
    style: String(n.form === '图文' ? (n.style || '') : ''),
    shots: sh, visual: vis, updatedAt: Number(n.updatedAt || 0) || 0,
  }];
}

/** 落档那一份：空行（没画面、没提示词）不占档；busy/error 是台上临时状态，不进档案 */
function npImgPack(rows) {
  const out = [];
  (Array.isArray(rows) ? rows : []).forEach(r => {
    if (!r) return;
    const sh = npShotsPack(r.shots);
    const vis = (r.visual && (String(r.visual.cover || '').trim() || String(r.visual.images || '').trim()))
      ? { cover: String(r.visual.cover || ''), images: String(r.visual.images || '') } : null;
    if (!sh && !vis) return;
    out.push({ id: r.id, pid: r.pid, style: String(r.style || ''), shots: sh, visual: vis, updatedAt: Number(r.updatedAt || 0) || 0 });
  });
  return out;
}

/** 台面上打开的那一行（列表空＝null） */
function npImgRow(w) {
  const rows = (w && w.imgDocs) || [];
  if (!rows.length) return null;
  return rows.find(x => x && x.id === w.imgOpen) || rows[0] || null;
}

/** 把某一行的内容铺到台上：之后 w.shots / w.visual 就是这一行的镜像 */
function npImgUseRow(w, r) {
  if (!w || !r) return;
  w.imgOpen = r.id;
  w.shots = npShotsShape(r.shots);
  w.visual = r.visual ? { cover: String(r.visual.cover || ''), images: String(r.visual.images || '') } : null;
}

/** 落档前收口：打开那一行跟着台上的动作走（传图 / 改句 / 改风格都只动 w.shots，这一笔不补就白改）
 *  这一行的身份＝w.shots.look.motif（画面流派），随 r.shots 一起写回；r.style 是旧档留下的「出图形式」，不再覆写（列表上只当「旧：」角标读） */
function npImgSync(w) {
  if (!w || !Array.isArray(w.imgDocs)) return;
  const r = npImgRow(w); if (!r) return;
  r.pid = npPid(w);
  r.shots = w.shots || npShotsShape(null);
  r.visual = w.visual ? { cover: String(w.visual.cover || ''), images: String(w.visual.images || '') } : null;
  if ((r.shots.items || []).length || String(r.shots.cover || '').trim() || r.visual) r.updatedAt = Date.now();
}

/** 档案条目级那两份（shots/visual）＝打开那一行；没打开的行就取有内容的第一行，缺口列与教程照旧有得读 */
function npImgMirror(w) {
  if (!Array.isArray(w.imgDocs)) return null;
  const filled = (r) => r && (npShotsOn(r).length || String((r.shots && r.shots.cover) || '').trim() || r.visual);
  const cur = npImgRow(w);
  const r = filled(cur) ? cur : (w.imgDocs.find(filled) || null);
  return { shots: r ? npShotsPack(r.shots) : null, visual: r && r.visual ? { cover: String(r.visual.cover || ''), images: String(r.visual.images || '') } : null };
}

/** 同一篇的其他平台版本（档案里各成一档，靠 derivedFrom／本体 id 归一组）：列表上摆只读行 */
async function npImgSibs(n) {
  const key = String((n && (n.derivedFrom || n.id)) || '');
  if (!key) return [];
  let list = [];
  try { list = await npNotesAll(); } catch (_) { return []; }
  return list.filter(x => x && x.id !== n.id && String(x.derivedFrom || (x.id || '')) === key).map(x => ({
    arId: x.id, pid: String(x.platform || 'xhs'), form: String(x.form || ''), title: String(x.title || ''),
    imgDocs: npImgRowsOf(x),
  }));
}

/** 账号默认那一派的名字（没定＝空串）：列表「跟账号默认」和加行那一排都要读它 */
function npImgDefMotif(w) { return String((w && w.styleLook && w.styleLook.motif) || '').trim(); }

/** 列表这一行按哪一派取材：这一套自己定的盖上去，没定就跟账号默认 */
function npRowMotif(r, w) {
  return String((r && r.shots && r.shots.look && r.shots.look.motif) || '').trim() || npImgDefMotif(w);
}

/** 档案这一篇用上了哪几派（去重）：行自己定的算；带着旧「出图形式」名的老行不猜（那批画面本来不是照这一派取材的，
 *  留给调用方摆成灰色「旧：」）；两者都空＝这一行选的是「跟账号默认」，按账号默认那一派算 */
function npNoteMotifs(n, def) {
  const out = [];
  npImgRowsOf(n).forEach(r => {
    const own = String((r.shots && r.shots.look && r.shots.look.motif) || '').trim();
    const m = own || (String(r.style || '').trim() ? '' : String(def || '').trim());
    if (m && out.indexOf(m) < 0) out.push(m);
  });
  return out;
}

let _npImgAddOpen = false;   // 「＋ 再要一套图」那排流派 chip：点了才铺开，不占列表上方

/* 🎯 那一张任务表：一行＝一个要出的活。图按「平台 × 画面流派」（真源＝档案 imgDocs），片按「平台 × 成片形式」
   （filmDocs 那一行 + xhsFilmDocs 里按 key 存的那份分幕草稿）；底下两排「＋」按需展开——先挑一派 / 一种形式才加行，一次 AI 都不烧。
   同一篇的别的平台版本摆成只读行（图与片各半），点「过去」切到它自己那一档。 */
let _npTaskFilmOpen = false;   // 「＋ 一片」那排成片形式 chip：点了才铺开，不常驻表下方

function npTaskListHtml(w, docs) {
  const th = 'box-sizing:border-box;font-size:10px;color:#8a929e;font-weight:700;text-align:left;padding:3px 6px;white-space:nowrap;',
    td = 'box-sizing:border-box;padding:6px;border-top:1px solid var(--line);vertical-align:middle;font-size:11px;color:#444;',
    btn = 'border:1px solid var(--line);border-radius:6px;background:#fff;color:#666;font-size:11px;font-weight:700;cursor:pointer;padding:3px 8px;',
    go = 'border:1px solid var(--c-brand-line);border-radius:6px;background:var(--c-brand-soft);color:var(--c-brand-text);font-size:11px;font-weight:700;cursor:pointer;padding:3px 10px;',
    chip = 'border:1px solid #e9d5ff;border-radius:7px;background:#fff;color:#6d28d9;font-size:11px;font-weight:700;cursor:pointer;padding:4px 9px;';
  const when = (ms) => ms ? new Date(ms).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '还没动';
  const platOf = (pid) => {
    const P = (typeof Platforms !== 'undefined') ? Platforms.get(pid) : null;
    return P ? (P.icon + ' ' + P.name) : String(pid || '');
  };
  const canFilm = (typeof editionFeatureOn !== 'function') || editionFeatureOn('videoFilm');
  const noScript = !String(w.voice || '').trim();

  /* ── 图那一半：一行一套图，打开着的那一行压个底色 ── */
  const imgRowHtml = (r, editable, arId) => {
    const on = npShotsOn(r);
    const total = ((r.shots && r.shots.items) || []).length;
    const got = on.filter(x => (x.imgs || []).length).length;
    const own = String((r.shots && r.shots.look && r.shots.look.motif) || '').trim();
    const defMotif = npImgDefMotif(w), legacy = String(r.style || '');
    const idA = 'data-id="' + npArAttr(r.id) + '"';
    const legacyBadge = legacy ? '<div style="font-size:9px;color:#b6bec9;margin-top:2px;">旧：' + esc(legacy) + '</div>' : '';
    const motifCell = editable
      ? '<select class="np-img-motif" ' + idA + ' title="这一行按哪一派取材：换派只记下新派，进造图片后表上那颗 \uD83D\uDD04 照新派重出图描述" style="box-sizing:border-box;max-width:150px;border:1px solid var(--line);border-radius:6px;background:#fff;color:#444;font-size:11px;padding:2px 4px;">' +
        '<option value=""' + (own ? '' : ' selected') + '>跟账号默认' + (defMotif ? '·' + defMotif : '（没定）') + '</option>' +
        npMotifOpts().map(k => '<option value="' + npArAttr(k) + '"' + (k === own ? ' selected' : '') + '>' + esc(k) + '</option>').join('') + '</select>' +
        legacyBadge
      : '<span style="color:#8a929e;">' + esc(own || npImgDefMotif(w) || '（没定流派）') + '</span>' + legacyBadge;
    return '<tr' + (editable && r.id === w.imgOpen ? ' style="background:var(--c-brand-soft);"' : '') + '>' +
      '<td style="' + td + '">🖼 图</td>' +
      '<td style="' + td + '">' + esc(platOf(editable ? npPid(w) : r.pid) + (editable ? '' : ' · 另一档')) + '</td>' +
      '<td style="' + td + '">' + motifCell + '</td>' +
      '<td style="' + td + '">' + (on.length
        ? total + ' 段 / ' + on.length + ' 张' + (String((r.shots && r.shots.cover) || '').trim() ? ' + 封面' : '')
        : '<span style="color:#b45309;">还没断句</span>') + '</td>' +
      '<td style="' + td + '">' + (on.length
        ? (got === on.length ? '<span style="color:#16a34a;">图齐了</span>'
          : '<span style="color:#d32f2f;font-weight:700;">还缺 ' + (on.length - got) + ' 张</span>')
        : '—') + '</td>' +
      '<td style="' + td + 'color:#8a929e;font-size:10px;">' + when(r.updatedAt) + '</td>' +
      '<td style="' + td + 'text-align:right;white-space:nowrap;">' +
        (editable
          ? '<button type="button" class="np-task-img" ' + idA + ' style="' + go + '" title="进造图片做这一套：断句 → 图描述 → 提示词；改完自动写回这一档">🖼 出图</button> ' +
            '<button type="button" class="np-img-del" ' + idA + ' title="删掉这一行：只删这一份画面表，正文和素材库里那些图都不动" style="' + btn + 'color:#9aa0ac;">✕</button>'
          : '<button type="button" class="np-task-sib" data-ar="' + npArAttr(arId) + '" title="那一版的料写回它自己那一档" style="' + btn + '">过去 →</button>') +
      '</td></tr>';
  };

  /* ── 片那一半：一行一片（分幕 / 出片状态读 xhsFilmDocs 里这一行 key 那份）── */
  const filmRowHtml = (r, editable, sib) => {
    const doc = editable ? ((docs || {})[r.key] || null) : null;
    const sc = doc && Array.isArray(doc.scenes) ? doc.scenes.length : 0;
    const outAt = doc ? Number(doc.outAt || 0) : 0;
    const local = npKindLocal(r.kind);
    const d = npKindDef(r.kind) || {};
    const gap = !editable ? '—'
      : noScript ? '<span style="color:#b45309;">先整口播稿</span>'
      : !local ? '<span style="color:#8a929e;">不在本机出片：只给料</span>'
      : outAt ? '<span style="color:#16a34a;">🎬 已出片</span>'
      : sc ? '<span style="color:#8a929e;">还差出片那一步</span>'
      : '<span style="color:#d32f2f;font-weight:700;">还没分幕</span>';
    const idA = 'data-id="' + npArAttr(r.id) + '"';
    const dim = noScript ? 'opacity:.5;' : '';
    return '<tr>' +
      '<td style="' + td + '">🎬 片</td>' +
      '<td style="' + td + '">' + esc(platOf(editable ? npPid(w) : (sib && sib.pid)) + (editable ? '' : ' · 另一档')) + '</td>' +
      '<td style="' + td + '">' + (r.kind
        ? esc((d.icon ? d.icon + ' ' : '') + String(r.kind)) + (local ? '' : ' <span style="color:#8a929e;font-size:10px;">（给料）</span>')
        : '<span style="color:#b45309;">还没选成片形式</span>') + '</td>' +
      '<td style="' + td + '">' + (editable ? (sc ? sc + ' 幕' : '还没进台子') : '—') + '</td>' +
      '<td style="' + td + '">' + gap + '</td>' +
      '<td style="' + td + 'color:#8a929e;font-size:10px;">' + (editable ? when(r.updatedAt) : '—') + '</td>' +
      '<td style="' + td + 'text-align:right;white-space:nowrap;">' +
        (editable
          ? '<button type="button" class="np-task-film" ' + idA + ' style="' + go + dim + '" title="' +
            (noScript ? '出片台念的是口播稿：先点上面那行「🖼 出图」进造图片，把顶上那格文案整一份'
              : '进出片台做这一片：分幕 / 底图 / 配音参数按这一片存着，关掉再进来接着编') + '">🎬 出片</button> ' +
            '<button type="button" class="np-task-film-del" ' + idA + ' title="删掉这一片：只删它的分幕草稿，口播稿和别的行都不动" style="' + btn + 'color:#9aa0ac;">✕</button>'
          : '<button type="button" class="np-task-sib" data-ar="' + npArAttr(sib && sib.arId) + '" title="那一平台的片写回它自己那一档" style="' + btn + '">过去 →</button>') +
      '</td></tr>';
  };

  const imgRows = w.imgDocs || [], filmRows = w.filmDocs || [];
  const body = imgRows.map(r => imgRowHtml(r, true, '')).join('') +
    (w.imgSibs || []).map(sb => (sb.imgDocs || []).map(r => imgRowHtml(r, false, sb.arId)).join('')).join('') +
    (canFilm ? filmRows.map(r => filmRowHtml(r, true, null)).join('') +
      (w.filmSibs || []).map(sb => filmRowHtml({ id: '', kind: sb.kind, key: '' }, false, sb)).join('') : '');
  const head = ['要出什么', '平台', '这一行是什么', '到哪一步', '还缺什么', '更新', ''];

  const motifAdd = '<div style="margin-top:9px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">' +
    (_npImgAddOpen
      ? '<span style="font-size:11px;font-weight:700;color:#333;">🖼 这一套按哪一派来？</span>' +
        npMotifAll().map(m => '<button type="button" class="np-img-add" data-k="' + npArAttr(m.k) + '" title="' + npArAttr(npMotifTip(m)) + '" style="' + chip + '">' + esc(m.k) + '</button>').join('') +
        '<button type="button" class="np-img-add" data-k="" style="' + chip + 'border-style:dashed;" title="' + npArAttr(npImgDefMotif(w) ? '账号默认那一派：' + npImgDefMotif(w) : '账号还没定默认流派：断句与图描述都只按每段说的事自己摆画面') + '">跟账号默认' + (npImgDefMotif(w) ? '·' + esc(npImgDefMotif(w)) : '（没定）') + '</button>' +
        '<button type="button" class="np-img-addclose" style="' + btn + 'color:#9aa0ac;">\u2715 收起</button>'
      : '<button type="button" class="np-img-addopen" style="' + chip + 'border-style:dashed;">\uFF0B 一套图（先挑流派）</button>') +
    '</div>';
  const filmAdd = canFilm
    ? '<div style="margin-top:6px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">' +
      (_npTaskFilmOpen
        ? '<span style="font-size:11px;font-weight:700;color:#333;">🎬 这一片做成什么片？</span>' +
          NP_FILM_KINDS.map(x => '<button type="button" class="np-task-kind" data-k="' + npArAttr(x.k) + '" title="' + npArAttr(x.d || '') + '" style="' + chip + '">' + x.icon + ' ' + esc(x.k) + '</button>').join('') +
          '<button type="button" class="np-task-filmclose" style="' + btn + 'color:#9aa0ac;">\u2715 收起</button>'
        : '<button type="button" class="np-task-filmopen" style="' + chip + 'border-style:dashed;">\uFF0B 一片（挑成片形式）</button>') +
      '</div>'
    : '<div style="margin-top:6px;font-size:11px;color:#8a929e;">🎬 出片（本机出成片）是「全功能版」功能：这一版只管出图的活。</div>';

  return '<div style="border:1px solid var(--line);border-radius:10px;background:#fff;padding:8px 10px;">' +
    (body
      ? '<div style="overflow:auto;"><table style="width:100%;border-collapse:collapse;">' +
        '<thead><tr>' + head.map(h => '<th style="' + th + '">' + h + '</th>').join('') + '</tr></thead>' +
        '<tbody>' + body + '</tbody></table></div>'
      : '<div style="font-size:11px;color:#9aa0ac;padding:2px 0 8px;">这一篇还没有一个活：下面「＋ 一套图」挑一派（一段＝一张图），或「＋ 一片」挑一种成片形式。</div>') +
    motifAdd + filmAdd +
    '<div style="font-size:10px;color:#8a929e;line-height:1.6;margin-top:8px;">图：一行＝一个「平台 × 画面流派」，一行一份分镜表；片：一行＝一种成片形式，一行一份片。要另一种画面 / 另一种片就再加一行，别盖掉已经动过的那一行。</div>' +
    '</div>';
}

/** 「🖼 出图」：带着这一行进造图片（那一页摊开的就是这一行） */
async function npTaskOpenImg(id) {
  const w = npS(); if (!w || !w.arId) return;
  const rec = await npArFindById(w.arId);
  if (!rec) { npArNoGo('档案里找不到这一篇了'); return; }
  const msg = npArCan(rec, 'out');
  if (msg) { npArNoGo(msg); return; }
  _npOutOpenRow = String(id || '');
  switchMainTab('noteOut', rec);
}

/** 「🎬 出片」：带着这一片进出片台（稿子＝这一篇的口播稿，分幕草稿按这一行的 key 捡回来） */
async function npTaskOpenFilm(id) {
  const w = npS(); if (!w || !w.arId) return;
  const r = (w.filmDocs || []).find(x => x && x.id === id); if (!r) return;
  const rec = await npArFindById(w.arId);
  if (!rec) { npArNoGo('档案里找不到这一篇了'); return; }
  const chk = Object.assign({}, rec, { voice: String(rec.voice || w.voice || '') });
  const doc = await npArFilmDoc(r.key || rec.id);
  const msg = npArCan(chk, 'film', doc);
  if (msg) { npArNoGo(msg); return; }
  npGoFilm({
    noteId: rec.id,
    title: rec.title || ((rec.titles || [])[0] || ''),
    script: String(rec.voice || w.voice || ''),
    kind: r.kind, rowId: r.id,
    shots: rec.shots, rows: npFilmRowsOf(rec), pid: String(rec.platform || 'xhs'),
  });
}

/** ＋ 一片：先记这一行要做的成片形式（零 AI，不碰稿子）；第一条行的 key ＝ 档案 id，之后加的行是 档案id#行id */
function npTaskAddFilm(kind) {
  const w = npS();
  if (!w || !w.arId) { npArNoGo('这一篇还没入档——先在「✏️ 写文案」把正文存进档案'); return; }
  if (!npKindDef(kind)) return;
  if ((typeof editionFeatureOn === 'function') && npKindLocal(kind) && !editionFeatureOn('videoFilm')) {
    npArNoGo('本机出片是「全功能版」功能：这一档可以先看教程，出片要开全功能版'); return;
  }
  const rows = (w.filmDocs || []).slice();
  const have = rows.find(r => r && r.kind === kind);
  if (!have) {
    const id = npFilmRowId();
    rows.push({ id: id, kind: kind, key: (rows.length ? w.arId + '#' + id : w.arId), updatedAt: 0 });
  }
  w.filmDocs = rows;
  w.filmKind = kind;                       // 条目级那一份跟着最近挑的形式走（档案「形式 · 流派」那一列读它）
  _npTaskFilmOpen = false;
  npArchiveSave(w);
  npTaskPaint(npActiveC());
}

/** ✕ 删片：连它那份分幕草稿（xhsFilmDocs 按 key 存的那份）一起摘掉 */
async function npTaskDelFilm(id) {
  const w = npS(); if (!w) return;
  const gone = (w.filmDocs || []).find(x => x && x.id === id);
  if (!gone) return;
  if (!window.confirm('删掉这一片？只删它的分幕草稿，口播稿和别的行都不动。\n\n' + String(gone.kind || ''))) return;
  w.filmDocs = (w.filmDocs || []).filter(x => x && x.id !== id);
  if (gone.key) { try { await npFilmDocDrop(gone.key); } catch (_) {} }
  if (!w.filmDocs.length) w.filmKind = '';
  else if (w.filmKind === gone.kind) w.filmKind = w.filmDocs[0].kind;
  npArchiveSave(w);
  npTaskPaint(npActiveC());
}

/** ＋ 加一行：新行铺到台上，一次 AI 都不烧——顶上那份文案先本地逐句列好，段由人把句子拖出来（流派空＝跟账号默认） */
async function npImgAdd(container, motif) {
  const w = npS();
  if (!w || !w.draft) { npArNoGo('还没有正文：先在「✏️ 写文案」把正文定下来，才轮到断句出图'); return; }
  const m = String(motif || '').trim();
  const r = { id: npImgId(), pid: npPid(w), style: '', shots: npShotsShape(m ? { look: { motif: m } } : null), visual: null, updatedAt: 0 };
  w.imgDocs = (w.imgDocs || []).concat([r]);
  w.path = 'image';
  _npImgAddOpen = false;
  npImgUseRow(w, r);
  npArchiveSave(w);
  if (_npMode === 'task') { npTaskPaint(container); return; }   // 任务表上加行＝只多摆一行活：不跳页，点那一行的「出图」才进造图片
  w.uiTab = 'story';
  npRenderOutput(container);      // 零 AI 冷启动：摊开就是 ② 断句台，句子已经按标点列好，等人拖成段
}

/** 删一行（只删这一份画面表；素材库里那些图、正文、别的行都不动） */
function npImgDel(container, id) {
  const w = npS(); if (!w) return;
  w.imgDocs = (w.imgDocs || []).filter(x => x && x.id !== id);
  const next = w.imgDocs[0];
  if (next) npImgUseRow(w, next); else { w.imgOpen = ''; w.shots = npShotsShape(null); w.visual = null; }
  npArchiveSave(w);
  npRenderOutput(container);
}

/** 换这一行的画面流派：不推翻已经断好的段（那连你的手动调整一起没了），只记下新派——表上那颗 🔁 照新派重出图描述 */
function npImgMotifChange(container, id, motif) {
  const w = npS(); if (!w || !container) return;
  const r = (w.imgDocs || []).find(x => x && x.id === id);
  if (!r) return;
  r.shots = npShotsShape(r.shots);
  const look = npLookShape(r.shots.look);
  const m = String(motif || '').trim();
  if (m) look.motif = m; else delete look.motif;
  r.shots.look = look;
  if (r.id === w.imgOpen) {
    w.shots = npShotsShape(r.shots);            // 台面上那份跟着换（面板、提示词、断句入参都读这一份）
    npShotsCompose(w);
  }
  const had = !!(r.shots.items || []).length;
  npArchiveSave(w);
  npRenderOutput(container);
  if (had && typeof toast === 'function') toast('换了流派：下面那些图描述还是旧派写的，点 🔁 照新派重出');
}

/** ① 这一套图的风格：画面流派 + 四类轴 + 字量三档（真源看面板，尾巴那一行令牌只出四轴） */
function npLookPanelHtml(w) {
  const eff = npLookOf(w);
  const token = npLookToken(eff);
  const ink = npInkOf(eff);
  const motif = String(eff.motif || '');
  const _on = npShotsOn(w);
  const nItems = _on.length;
  const nLocked = _on.filter(it => it.dlock).length;
  const nFree = _on.filter(it => !it.dlock && String(it.text || '').trim()).length;
  const anyOwn = NP_LOOK_AXES.some(a => npLookOwn(w, a.k)) || npLookOwn(w, 'motif');
  const defToken = npLookToken(npLookShape(w && w.styleLook));
  const motifChip = (m) => {
    const on = motif === m.k;
    return '<button type="button" class="np-motif" data-k="' + npArAttr(m.k) + '" title="' + npArAttr(npMotifTip(m)) + '" style="border:1px solid ' +
      (on ? 'var(--c-brand)' : 'var(--line)') + ';border-radius:999px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';color:' +
      (on ? 'var(--c-brand-text)' : '#555') + ';font-size:11px;font-weight:700;padding:3px 10px;cursor:pointer;' +
      (npLookOwn(w, 'motif') && on ? 'box-shadow:inset 0 0 0 1px var(--c-brand);' : '') + '">' + esc(m.k) + (npLookOwn(w, 'motif') && on ? ' ·这一套' : '') + '</button>';
  };
  const ownMotif = npMotifOf(motif);
  const chip = (a, v) => {
    const on = String(eff[a.k] || '') === v;
    return '<button type="button" class="np-look" data-a="' + npArAttr(a.k) + '" data-v="' + npArAttr(v) + '" title="' + (on ? '再点一下＝这一轴交回账号默认' : '这一套就用它') + '" style="border:1px solid ' +
      (on ? 'var(--c-brand)' : 'var(--line)') + ';border-radius:999px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';color:' +
      (on ? 'var(--c-brand-text)' : '#555') + ';font-size:11px;font-weight:700;padding:3px 10px;cursor:pointer;' +
      (npLookOwn(w, a.k) && on ? 'box-shadow:inset 0 0 0 1px var(--c-brand);' : '') + '">' + esc(v) + (npLookOwn(w, a.k) && on ? ' ·这一套' : '') + '</button>';
  };
  const inkChip = (x) => {
    const on = ink === x.k;
    return '<button type="button" class="np-ink" data-k="' + npArAttr(x.k) + '" title="' + esc(x.d) + '" style="border:1px solid ' +
      (on ? 'var(--c-brand)' : 'var(--line)') + ';border-radius:8px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';color:' +
      (on ? 'var(--c-brand-text)' : '#555') + ';font-size:11px;font-weight:700;padding:4px 11px;cursor:pointer;">' + (on ? '✓ ' : '') + esc(x.t) + '</button>';
  };
  const row = (a) => '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:6px;">' +
    '<span style="min-width:62px;font-size:11px;font-weight:700;color:#374151;">' + esc(a.t) + '</span>' +
    '<span style="font-size:10px;color:#9aa0ac;">' + esc(a.d) + '</span>' +
    '<span style="display:flex;gap:4px;flex-wrap:wrap;">' + a.opts.map(v => chip(a, v)).join('') + '</span></div>';
  return '<div style="border:1px solid #e9e4fb;border-radius:9px;background:#fdfcff;padding:9px 11px;">' +
    '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">' +
      '<b style="font-size:12px;color:#333;">\uD83C\uDFA8 这一套图的风格</b>' +
      '<span style="font-size:10px;color:#8a929e;">' + (anyOwn ? '带「·这一套」的那几颗是这一套自己定的，别的跟账号默认' : '现在整份跟账号默认走') + '</span>' +
      '<span class="qhelp" tabindex="0" data-tip="这一排旋钮分两条通道：画面流派管「画面上摆什么、往哪儿取材」，它只进 AI 那一发（断句 / 重出图描述）；下面四类轴管「长什么样、看着像谁家的」，它们进每张提示词的尾巴。没选过的跟「发笔记 → 任务配置 → 🎨 出图默认」走，这一套改过的记在这一套上，不影响别的篇。改四轴或字量，下面每条提示词当场重排，不烧 AI；改流派要重出图描述才跟得上（那一颗按钮在面板底下）。">?</span>' +
      '<span style="flex:1;"></span>' +
      (anyOwn ? '<button type="button" class="np-look-back" style="border:1px solid var(--line);border-radius:6px;background:#fff;color:#666;font-size:11px;cursor:pointer;padding:2px 8px;">\u21BA 全部改回账号默认</button>' : '') +
    '</div>' +
    '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:6px;">' +
      '<span style="min-width:62px;font-size:11px;font-weight:700;color:#374151;">\uD83C\uDF3D 画面流派</span>' +
      '<span style="font-size:10px;color:#9aa0ac;">这一套往哪儿取材（图描述照它写）</span>' +
      '<span style="display:flex;gap:4px;flex-wrap:wrap;">' + npMotifAll().map(motifChip).join('') + '</span></div>' +
    (motif && ownMotif ? '<div style="font-size:10px;color:#6b7280;line-height:1.6;margin-top:3px;">' + esc(ownMotif.take || '') +
      (ownMotif.need ? '<b style="color:#b45309;">　要什么料：' + esc(ownMotif.need) + '</b>' : '') + '</div>' : '') +
    (ownMotif && (ownMotif.cast || ownMotif.forbid)
      ? '<details style="margin-top:4px;"><summary style="font-size:10px;color:#7c3aed;cursor:pointer;">这一派怎么用：怎么把这段文案变成画面 · 怎样算不合格</summary>' +
        '<div style="font-size:10px;color:#6b7280;line-height:1.7;margin-top:4px;padding-left:8px;border-left:2px solid #eee6fb;">' +
        (ownMotif.cast ? '<div><b style="color:#374151;">转译配方：</b>' + esc(ownMotif.cast) + '</div>' : '') +
        (ownMotif.forbid ? '<div style="margin-top:3px;"><b style="color:#b45309;">不合格的样子：</b>' + esc(ownMotif.forbid) + '</div>' : '') +
        '<div style="margin-top:3px;color:#9aa0ac;">这两句跟「长什么样」一起喂 AI（断句那一发与 🔁 重出都带）；要改就去 发笔记 → 任务配置 → 🎨 出图默认。</div>' +
        '</div></details>' : '') +
    NP_LOOK_AXES.map(row).join('') +
    '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:8px;">' +
      '<span style="min-width:62px;font-size:11px;font-weight:700;color:#374151;">图上放多少字</span>' +
      '<span style="display:flex;gap:5px;flex-wrap:wrap;">' + NP_INKS.map(inkChip).join('') + '</span>' +
      '<span style="font-size:10px;color:#8a929e;">' + esc(npInkDef(ink).d) + '</span>' +
    '</div>' +
    '<div style="margin-top:8px;padding:6px 8px;background:#fff;border:1px dashed var(--line);border-radius:7px;font-size:11px;color:#555;line-height:1.6;">回传配置：' +
      (token ? esc(token) : '<span style="color:#b45309;">四轴都空着——提示词就不带「固定元素」这一行</span>') +
      (defToken ? '' : '<span style="font-size:10px;color:#9aa0ac;">（账号默认也还没设，去 发笔记 → 任务配置 → 🎨 出图默认 定一次）</span>') +
    '</div>' +
    (nItems ? (() => {
      const canDo = !!motif && nFree > 0;
      const why = !motif ? '先在上面挑一派：没有流派就不知道照哪儿重出'
        : !nFree ? '这几段的图描述都带 🔒（你手改过）：点掉那一格上的锁才重出'
        : '只重写「图描述」那几格——段怎么切、顺序、⬜ 不占图、传回来的图一概不动；带 🔒 手改的那几格跳过。一批 5 段发给 AI，比重新断句省。';
      return '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:8px;">' +
        '<button type="button" class="np-desc-regen"' + (canDo ? '' : ' disabled') + ' title="' + npArAttr(why) + '" style="padding:5px 11px;border:1px solid ' + (canDo ? '#e0d8fb' : 'var(--line)') + ';border-radius:8px;background:' + (canDo ? '#fff' : '#f7f7f8') + ';color:' + (canDo ? '#6d28d9' : '#b6bec9') + ';font-size:11px;font-weight:700;cursor:' + (canDo ? 'pointer' : 'default') + ';">\uD83D\uDD04 照这一派重出图描述' + (nFree ? '（' + nFree + ' 段）' : '') + '</button>' +
        '<span class="qhelp" tabindex="0" data-tip="' + npArAttr(why) + '">?</span>' +
        (nLocked ? '<span style="font-size:10px;color:#c2410c;">' + nLocked + ' 段带 🔒 手改，这一发不碰</span>' : '') +
        '<span id="npDescWait" style="font-size:11px;color:#888;"></span>' +
      '</div>';
    })() : '') +
  '</div>';
}

/** 造图片这一页的台面＝五档一条道走下来：① 风格 → ② 断句台（句子拖成段）→ ③ 图描述 → ④ 编号提示词 → ⑤ 传图
 *  摊开就本地按标点把文案列成一句一句（npSentsEnsure，一次 AI 都不烧）；一段都还没拖时 ③④⑤ 是空的，也照样有东西可拖。 */
function npShotsBoxHtml(w) {
  const s = w.shots = w.shots || npShotsShape(null);
  npSentsEnsure(w);                      // 冷启动：句子先本地列出来（老档在这儿只补句子层，不替人把段绑上）
  npSegSync(w);
  npShotsCompose(w);                     // 只读那份是 shots 的派生物：整页重画时也要跟着重拼
  const box = 'border:1px solid #e9d5ff;border-radius:10px;background:#faf8ff;padding:10px 12px;';
  const sub = 'font-size:10px;color:#8a929e;line-height:1.6;margin-top:3px;';
  const node = (id, inner, mt) => '<div id="' + id + '" style="margin-top:' + mt + 'px;">' + inner + '</div>';
  return '<div style="' + box + '">' +
    '<div id="npNodes">' + npNodeStripHtml(w) + '</div>' +
    node('npLookBox', npLookPanelHtml(w), 10) +
    node('npCutWrap', npCutBoxHtml(w), 12) +
    node('npShotTable', npShotsTableHtml(w), 14) +
    '<input id="npShotFile" type="file" accept="image/*" multiple hidden>' +
    '<div style="' + sub + 'margin-top:8px;">' + (typeof Platforms !== 'undefined' ? esc(Platforms.tipOf(npPid(w), 'image')) : '') + '</div>' +
  '</div>';
}
/** 改了段文本 / 图描述 / 固定元素：只重拼每一行的提示词那一格（整页甩会把光标顶掉） */
function npShotsPaintPromptOnly(container) {
  const w = npS(); if (!w || !container || !w.shots) return;
  npShotsCompose(w);
  const on = npShotsOn(w);
  const cells = (container.querySelectorAll ? container.querySelectorAll('.np-shot-pout') : []);
  for (let k = 0; k < cells.length; k++) {
    const el = cells[k];
    const i = on.findIndex(x => x && x.id === el.getAttribute('data-id'));
    if (i >= 0) el.textContent = npShotPromptText(w, on[i], i, on.length);
  }
}

/** 改了顶上那格文案：只把「句子跟文案对不上了」那一行点亮（整页甩会把光标顶掉） */
function npSrcStalePaint(container) {
  const w = npS(); if (!w || !container) return;
  const el = _npEl(container, 'npSrcStale'); if (!el) return;
  if (npCutStale(w)) el.removeAttribute('hidden'); else el.setAttribute('hidden', '');
}
/** 上移 / 下移一段 */
function npShotMove(container, id, d) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const items = s.items || [];
  const i = items.findIndex(x => x && x.id === id), j = i + d;
  if (i < 0 || j < 0 || j >= items.length) return;
  const t = items[i]; items[i] = items[j]; items[j] = t;
  npCutChanged(container, w);
}
/** 拖行落点：拖到紧上面那一行＝两段并成一张；拖到别处＝换顺序 */
function npShotDrop(container, fromId, toId) {
  const w = npS(); const s = w && w.shots; if (!s || !container) return;
  const items = s.items || [];
  const fi = items.findIndex(x => x && x.id === fromId);
  const ti = items.findIndex(x => x && x.id === toId);
  if (fi < 0 || ti < 0 || fromId === toId) return;
  if (ti === fi - 1) { npShotMerge(container, fromId); return; }
  const it = items.splice(fi, 1)[0];
  items.splice(ti > fi ? ti - 1 : ti, 0, it);
  npCutChanged(container, w);
}
function npShotKeyToggle(container, id) {
  const w = npS(); const it = w && npShotOf(w, id); if (!it) return;
  it.off = !it.off;
  npCutChanged(container, w);
}
/** 点掉那一格的 🔒：这一段的图描述重新交给「🔁 照这一派重出」管 */
function npShotUnlock(container, id) {
  const w = npS(); if (!w || !w.shots) return;
  const it = npShotOf(w, id); if (!it || !it.dlock) return;
  it.dlock = false;
  npArchiveSave(w);
  npRenderOutput(container);
}

/** ⤒ 并上＝这一段的句子并进紧上面那一段，上面那段没写图描述就顺手接过来。
 *  一段绑了句子、另一段还是旧档那份字时不并：段文本现在由句子拼，硬并会把那份字顶掉。 */
function npShotMerge(container, id) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const i = (s.items || []).findIndex(x => x && x.id === id);
  if (i <= 0) return;
  const a = s.items[i - 1], b = s.items[i];
  if (npSegLegacy(a) !== npSegLegacy(b)) {
    if (typeof toast === 'function') toast('这两段一份绑了句子、一份还是旧档那份字——先回 ② 把旧档那段绑上句子（或散掉它），再并');
    return;
  }
  a.sids = (a.sids || []).concat(b.sids || []);
  a.text = [String(a.text || '').trim(), String(b.text || '').trim()].filter(Boolean).join('');
  a.desc = String(a.desc || '').trim() || String(b.desc || '').trim();
  a.form = a.form || b.form;
  a.imgs = (a.imgs || []).concat(b.imgs || []);
  s.items.splice(i, 1);
  npCutChanged(container, w);
}
function npShotCopy(id) {
  const w = npS(); const s = w && w.shots; if (!s) return;
  const on = npShotsOn(w);
  const i = on.findIndex(x => x && x.id === id);
  if (i < 0) { if (typeof toast === 'function') toast('这一句没在出图的名单里（点它前面那个 ⬜ 让它出图）', 'error'); return; }
  copyToClipboard(npShotPromptText(w, on[i], i, on.length)).then(
    () => { if (typeof toast === 'function') toast('这张的提示词已复制（画面 ' + (i + 1) + '）'); },
    () => { if (typeof toast === 'function') toast('复制没成功：选中上面那段文字，自己 Ctrl+C', 'error'); });
}

function npShotsCopyAll() {
  const w = npS(); if (!w || !w.shots) return;
  const txt = npShotsAllText(w);
  if (!txt) { if (typeof toast === 'function') toast('还没有画面表', 'error'); return; }
  copyToClipboard(txt).then(
    () => { if (typeof toast === 'function') toast('整套提示词已复制（' + npShotsOn(w).length + ' 张' + (w.shots.cover ? ' + 封面' : '') + '）'); },
    () => { if (typeof toast === 'function') toast('复制没成功：展开「整套提示词拼好的样子」自己 Ctrl+C', 'error'); });
}

function npShotUpPick(id) {
  _npShotUpId = String(id || '');
  const fi = document.getElementById('npShotFile');
  if (!fi) { if (typeof toast === 'function') toast('这一页还没画出来', 'error'); return; }
  fi.value = ''; fi.click();
}

/** 生成好的图传回来：进素材库（只存引用＋缩略图，原图不搬），画面那一行按号挂着它的 id */
async function npShotUpload(files) {
  const w = npS(); const s = w && w.shots; const c = npActiveC();
  const it = w && npShotOf(w, _npShotUpId);
  _npShotUpId = '';
  if (!it) return;
  const arr = Array.prototype.slice.call(files || []).filter(f => f && /^image\//.test(String(f.type || '')));
  if (!arr.length) { if (typeof toast === 'function') toast('选的是图片文件吗？', 'error'); return; }
  const list = await npAsAssetsRead();
  let ok = 0, bad = '';
  for (const f of arr) {
    try {
      const t = await npAsThumb(f);
      const id = npAsId();
      list.push({ id: id, kind: 'local', ref: String(f.name || '本机图'), name: String(f.name || '本机图'), thumb: t.thumb, w: t.w, h: t.h,
                  shotOf: String((w.arId || '') + '#' + it.id), addedAt: Date.now() });
      it.imgs.push(id); ok++;
    } catch (e) { bad = String((e && e.message) || e); }
  }
  if (ok) await npAsAssetsWrite(list);
  if (ok) await npShotImgIndex();
  if (ok) npArchiveSave(w);
  if (typeof toast === 'function') toast(ok ? ('画面已挂上 ' + ok + ' 张图（只存了缩略图，原图你自己留好）' + (bad ? '，另 ' + bad : '')) : ('这些没读进来：' + (bad || '不是图片')), ok ? '' : 'error');
  if (c) npRenderOutput(c);
}

async function npShotUnlink(container, shotId, assetId) {
  const w = npS(); const it = w && npShotOf(w, shotId); if (!it) return;
  it.imgs = (it.imgs || []).filter(x => x !== assetId);
  npArchiveSave(w);
  npRenderOutput(container);
}

async function npVoiceRevise(container, ask) {
  const w = npS(); if (!w || w.voiceBusy || !w.voice) return;
  const ta = _npEl(container, 'npVoiceTa');
  const askEl = _npEl(container, 'npVoiceAsk');
  const msg = _npEl(container, 'npVoiceMsg');
  const say = (s, color) => { if (msg) { msg.textContent = s; msg.style.color = color || '#9aa0ac'; } };
  const script = ta ? String(ta.value || '').trim() : String(w.voice || '').trim();
  const a = String(ask || (askEl && askEl.value) || '').trim();
  if (!a) { if (askEl) askEl.focus(); say('先说一句想怎么改（上面有常用改法，点一下就行）', '#d33'); return; }
  w.voiceBusy = true;
  const btn = container.querySelector('.np-voice-rv');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ 改稿中…'; }
  say('AI 正在改…');
  const ctx = [(_npNote.title ? '【本篇标题】' + _npNote.title : ''), (w.draft && w.draft.content) ? '【原笔记正文】\n' + w.draft.content : '', npSellPointStr() ? '【主打卖点】' + npSellPointStr() : ''].filter(Boolean).join('\n\n');
  let okMsg = '', errMsg = '';
  try {
    const r = await chrome.runtime.sendMessage({ action: 'voiceRewrite', data: { platform: npPid(w), script, ask: a, ctx } });
    if (!r || !r.script) throw new Error((r && r.error) || '改稿失败');
    w.voicePrev = script;
    w.voice = String(r.script);
    if (ta) ta.value = w.voice;
    okMsg = '✅ 改好了——不满意点「↩ 改回上一版」';
  } catch (e) { errMsg = '改稿失败：' + ((e && e.message) || e); }
  w.voiceBusy = false;
  if (okMsg) npArchiveSave(w);   // 改完的口播稿同步进档案
  if (btn) { btn.disabled = false; btn.textContent = '🤖 AI 改一版'; }
  const undo = container.querySelector('.np-voice-undo'); if (undo && w.voicePrev) undo.hidden = false;
  say(okMsg || errMsg, okMsg ? '#2e7d32' : '#d33');
}

function npVoiceUndo(container) {
  const w = npS(); if (!w || !w.voicePrev) return;
  const ta = _npEl(container, 'npVoiceTa');
  if (ta) ta.value = w.voicePrev;
  w.voice = w.voicePrev;
  w.voicePrev = '';
  npArchiveSave(w);   // 退回的那版也要同步进档案
  const u = container.querySelector('.np-voice-undo'); if (u) u.hidden = true;
  const msg = _npEl(container, 'npVoiceMsg'); if (msg) { msg.textContent = '已改回上一版'; msg.style.color = '#9aa0ac'; }
}

/* ═══════════ 📮 这条的各个平台版本（四十八改） ═══════════
   口径：写稿半段统一按小红书口径；⑤ 定稿时勾「这条发到哪些平台」（可多选）——
   小红书版＝手上这篇原稿（勾了才留档待发）；勾的其余平台按各自的规矩各改写一版（事实、卖点、人设不变），
   各成一档、各标各的发布状态；某个平台写失败只标它自己、可重试。⑥ 顶部版本条点着切、↻ 重写。 */

/** 目标平台的显示名（表里认不出就回落到 id） */
function npPfName(pid) {
  const p = (typeof Platforms !== 'undefined') ? Platforms.get(pid) : null;
  return (p && p.name) || String(pid || '');
}
/** 这一版写好没有（没有版本表＝老路，照旧） */
function npVerReadyOf(w, pid) {
  if (!w || !w.verMap) return true;
  const v = w.verMap.byPid[pid];
  return !!(v && v.ready);
}
/** 改写种子：事实面（卖点/人群/话题/素材/人设）＋ 手上这篇的成稿——其余平台版本都从它改写 */
function npVerSeedSrc(w) {
  const tl = (w.topics || []);
  const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
  const note = (_npNote && _npNote.draft === w.draft) ? _npNote : null;
  return {
    platformName: npPfName(npPid(w)),
    title: note ? (note.title || '') : ((w.draft && w.draft.titles || [])[0] || ''),
    content: String((w.draft && w.draft.content) || ''),
    tags: ((note && Array.isArray(note.tags)) ? note.tags : ((w.draft && w.draft.tags) || [])).slice(),
    topic: String(t.topic || ''),
    sellPoint: npSellPointStr(),
    sellImages: (w.sellImages || []).slice(),
    people: (w.chosenPeople || []).map(p => ({ name: (p && p.name) || '', pain: (p && p.pain) || '', scene: (p && p.scene) || '', timing: (p && p.timing) || '' })),
    productName: w.prodName || '',
    kbList: (w.chosenKb || []).map(e => ({ title: e.title || '', content: e.content || '', tags: e.tags || [] })),
  };
}
/** 当前这一版的状态快照（切版前存好，切回来不丢） */
function npVerSnap(w) {
  const note = (_npNote && _npNote.draft === w.draft) ? _npNote : null;
  return {
    arId: w.arId || '',
    derivedFrom: w.derivedFrom || '', derivedFromTitle: w.derivedFromTitle || '',
    draft: w.draft, revisePrev: w.revisePrev || '',
    title: note ? (note.title || '') : (((w.draft && w.draft.titles) || [])[0] || ''),
    titleIdx: note ? (note.titleIdx || 0) : 0,
    tags: ((note && Array.isArray(note.tags)) ? note.tags : ((w.draft && w.draft.tags) || [])).slice(),
    path: w.path || '', style: Object.assign({ image: '', video: '' }, w.style || {}),
    visual: w.visual, shots: npShotsPack(w.shots),
    voice: w.voice || '', voiceError: w.voiceError || '', voicePrev: w.voicePrev || '',
  };
}
/** 刚改写出来的那一版的快照（料还没出：path/visual/voice 都是空的） */
function npVerSnapNew(w, pid, arId, nd) {
  const seed = (w && w.verSeed) || {};
  return {
    arId: arId || '',
    derivedFrom: seed.baseArId || '', derivedFromTitle: ((seed.src && seed.src.title) || ''),
    draft: nd, revisePrev: '',
    title: ((nd.titles || [])[0] || ''), titleIdx: 0,
    tags: (nd.tags || []).slice(),
    path: '', style: { image: '', video: '' },
    visual: null, shots: null, voice: '', voiceError: '', voicePrev: '',
  };
}
/** 把某一版的快照铺回向导（切版就靠它） */
function npVerApply(w, s) {
  if (!w || !s) return;
  w.arId = s.arId || '';
  w.derivedFrom = s.derivedFrom || ''; w.derivedFromTitle = s.derivedFromTitle || '';
  w.draft = s.draft || null; w.revisePrev = s.revisePrev || '';
  _npNote = { draft: w.draft, title: s.title || '', tags: (s.tags || []).slice(), titleIdx: s.titleIdx || 0 };
  w.path = s.path || ''; w.style = Object.assign({ image: '', video: '' }, s.style || {});
  w.visual = s.visual || null; w.shots = s.shots ? npShotsShape(s.shots) : null;
  w.voice = s.voice || ''; w.voiceError = s.voiceError || ''; w.voicePrev = s.voicePrev || '';
}
/** 从造图片退回写稿半段：视图落回小红书原稿（已写好的各平台版本留在版本表里） */
function npVerRestoreBase(w) {
  if (!w || !w.verMap) return;
  if (_npVerWaitStop) { _npVerWaitStop(); _npVerWaitStop = null; }
  const cur = w.verMap.byPid[w.platform];
  if (cur && cur.ready && w.draft) cur.snap = npVerSnap(w);   // 当前这版的最新样子先存着
  const base = (w.verMap.byPid.xhs && w.verMap.byPid.xhs.snap) || w.verBaseSnap;
  if (base) npVerApply(w, base);
  w.platform = 'xhs';
}
/** 派生那一发的返回：结构化 JSON 或整段文案兜底 */
function npDeriveNote(res) {
  const d = res && res.data;
  const loose = String((res && res.copy) || '').trim();
  return (d && String(d.content || '').trim())
    ? { content: String(d.content || ''), titles: (d.titles || []).map(String), tags: (d.tags || []).map(String), timeTip: String(d.timeTip || '') }
    : (loose ? { content: loose, titles: [], tags: [], timeTip: '', loose: true } : null);
}
/** 给某一版写档案（新档 / 重写＝同档覆盖）：临时把向导指向这一版，npArchiveSave 的快照是同步取的，写完马上还原 */
async function npVerArchivePut(w, pid, arId, nd) {
  const seed = w.verSeed || {};
  const keep = {
    platform: w.platform, arId: w.arId || '', draft: w.draft, revisePrev: w.revisePrev,
    derivedFrom: w.derivedFrom || '', derivedFromTitle: w.derivedFromTitle || '',
    path: w.path || '', style: w.style, visual: w.visual, voice: w.voice,
  };
  const keepNote = _npNote;
  w.platform = pid;
  w.arId = arId || '';
  w.derivedFrom = seed.baseArId || '';
  w.derivedFromTitle = (seed.src && seed.src.title) || '';
  w.draft = nd; w.revisePrev = ''; w.revSentIdx = -1;
  w.path = ''; w.style = { image: '', video: '' };
  w.visual = null; w.voice = '';
  _npNote = { draft: nd, title: (nd.titles || [])[0] || '', tags: (nd.tags || []).slice(), titleIdx: 0 };
  const id = w.arId || (w.arId = npNoteId());
  const job = npArchiveSave(w);   // 只存正文，不标待发：状态统一在「笔记档案」那一列标
  w.platform = keep.platform; w.arId = keep.arId; w.draft = keep.draft; w.revisePrev = keep.revisePrev;
  w.derivedFrom = keep.derivedFrom; w.derivedFromTitle = keep.derivedFromTitle;
  w.path = keep.path; w.style = keep.style; w.visual = keep.visual; w.voice = keep.voice;
  _npNote = keepNote;
  await job;
  return id;
}
/** 定稿：冻结种子 + 合并版本表（已写好的不重烧；底稿改过＝各版按新底稿重写、同档覆盖）＋ 小红书原稿留档 */
async function npVerFinalize(nc) {
  const w = npS();
  if (!w || !w.draft) return;
  const checked = (w.platforms || []).slice();
  const src = npVerSeedSrc(w);
  const sig = [src.title, src.content, (src.tags || []).join(',')].join('\n');
  const old = w.verSeed;
  const baseChanged = !old || old.sig !== sig;
  w.verSeed = { pids: checked, src, sig, baseArId: (old && old.baseArId) || ((w.verMap && w.verMap.byPid.xhs && w.verMap.byPid.xhs.arId) || '') };
  w.verGen = (w.verGen || 0) + 1;   // 在途的那发回来也不许写（底稿可能已经换过）
  w.platform = 'xhs';
  w.verBaseSnap = npVerSnap(w);
  const oldMap = (w.verMap && w.verMap.byPid) || {};
  // 之前补写出来的平台版本不从版本条上抹掉（它在档案里已经是独立一档）；勾选只决定「还要新写哪些平台」
  const pids = Platforms.LIST.map(p => p.id).filter(id => checked.indexOf(id) >= 0 || (oldMap[id] && oldMap[id].ready));
  const map = { pids: pids.slice(), byPid: {} };
  for (const pid of pids) {
    const v = oldMap[pid] || { pid: pid, arId: '', ready: false, busy: false, error: '', snap: null };
    if (pid !== 'xhs' && v.ready && baseChanged) { v.ready = false; v.snap = null; v.error = ''; }   // 底稿改过：重写（同档覆盖，不新开档）
    map.byPid[pid] = v;
  }
  w.verMap = map;
  if (pids.includes('xhs')) {
    await npArchiveSave(w);   // 小红书原稿先留档（发了没发由用户去档案的状态列标）
    const v = map.byPid.xhs;
    v.arId = w.arId || v.arId || '';
    v.ready = true; v.error = ''; v.snap = w.verBaseSnap;
    w.verSeed.baseArId = w.arId || w.verSeed.baseArId || '';
  }
}
/** 逐版改写一发（force＝重写已写好的那版，同档覆盖）；写完把正看着的那版刷新或自动切过去 */
async function npVerBuildOne(nc, pid, force) {
  const w = npS();
  if (!w || !w.verMap || !w.verSeed) return;
  const v = w.verMap.byPid[pid];
  if (!v || v.busy || pid === 'xhs') return;
  if (v.ready && !force) return;
  const gen = w.verGen || 0;
  v.busy = true; v.error = '';
  npVerPaintAll(nc);
  const stopWait = npWaitInto(nc, 'npVerWaitMsg', '正在按「' + npPfName(pid) + '」的规矩改写这篇', 'notedraft',
    () => npS() === w && w.step === 5 && w.verMap && w.verMap.byPid[pid] === v && v.busy);
  let okNd = null, okId = '', waitMsg = '';
  try {
    const res = await chrome.runtime.sendMessage(npDerivePayload(w.verSeed.src, pid));
    if ((w.verGen || 0) !== gen || npS() !== w) { stopWait(); v.busy = false; return; }   // 定稿又走了一遍/换了篇：这发作废
    okNd = npDeriveNote(res);
    if (!okNd) throw new Error((res && (res.error || res.message)) || 'AI 没返回可用内容，稍后再试');
    okId = await npVerArchivePut(w, pid, v.arId || '', okNd);
    if ((w.verGen || 0) !== gen || npS() !== w) { stopWait(); v.busy = false; return; }
    v.arId = okId;
    v.snap = npVerSnapNew(w, pid, okId, okNd);
    v.ready = true; v.error = '';
  } catch (e) {
    if ((w.verGen || 0) === gen && npS() === w) v.error = String((e && e.message) || e);
    else waitMsg = String((e && e.message) || e);
  }
  stopWait();
  v.busy = false;
  if (npS() !== w) return;
  if (w.step !== 5) return;   // 已经退回写稿半段：只留下结果，页面不动
  const cur = w.verMap.byPid[w.platform];
  const curReady = !!(cur && cur.ready && w.draft);
  if (v.ready && (v.autoView || w.platform === pid || !curReady)) {
    v.autoView = false;
    w.platform = pid;
    npVerApply(w, v.snap);
    await npWizRender(nc);
    return;
  }
  npVerPaintAll(nc);
}
let _npVerBusy = false;
/** 把没写好的平台挨个写出来（一次一版；中途改过勾选/底稿也自动补上） */
async function npVerBuildAll(nc) {
  const w = npS();
  if (!w || !w.verMap || !w.verSeed || _npVerBusy) return;
  _npVerBusy = true;
  try {
    for (;;) {
      const next = w.verMap.pids.find(pid => { const v = w.verMap.byPid[pid]; return v && pid !== 'xhs' && !v.ready && !v.busy; });
      if (!next) break;
      await npVerBuildOne(nc, next, false);
      if (npS() !== w || !w.verMap) break;
    }
  } catch (_) {}
  _npVerBusy = false;
}
/** 点版本条：写好了＝切过去；标 ⚠＝点着重试；排队中＝等前面的 */
async function npVerChipClick(nc, pid) {
  const w = npS(); if (!w || !w.verMap) return;
  const v = w.verMap.byPid[pid];
  if (!v) return;
  if (v.busy) { if (typeof toast === 'function') toast('「' + npPfName(pid) + '」这版正在写，写好自动亮'); return; }
  if (v.ready) {
    if (v.error) {   // 上次 ↻ 没写成功：开出来的还是上一版，说清楚，别让人以为 ⚠ 是空档
      if (typeof toast === 'function') toast('上次重写没成功，开的还是上一版；点 ↻ 再试一次');
      v.error = '';
    }
    await npVerSwitch(nc, pid); return;
  }
  if (v.error) {
    await npVerBuildOne(nc, pid, false);
    if (npS() === w && w.verMap && w.verMap.byPid[pid].ready) await npVerSwitch(nc, pid);
    else npVerPaintAll(nc);
    return;
  }
  if (typeof toast === 'function') toast('「' + npPfName(pid) + '」排在后面，前面那版写完就到它');
}
/** ↻ 按同样口径重写这一版（同档覆盖；小红书那版＝原稿，不重写） */
async function npVerRedo(nc, pid) {
  const w = npS(); if (!w || !w.verMap || pid === 'xhs') return;
  const v = w.verMap.byPid[pid];
  if (!v || v.busy) return;
  if (typeof toast === 'function') toast('正在按「' + npPfName(pid) + '」的规矩重写这一版…');
  await npVerBuildOne(nc, pid, true);
}
/** 切到某一版：先存回当前这版的最新样子，再铺开目标那版 */
async function npVerSwitch(nc, pid) {
  const w = npS(); if (!w || !w.verMap) return;
  if (w.voiceBusy) { if (typeof toast === 'function') toast('等这版的口播稿出完再切', 'error'); return; }
  const v = w.verMap.byPid[pid];
  if (!v || !v.ready || !v.snap) return;
  if (pid === w.platform) { npVerPaintAll(nc); return; }
  const cur = w.verMap.byPid[w.platform];
  if (cur && cur.ready && w.draft) cur.snap = npVerSnap(w);
  w.platform = pid;
  npVerApply(w, v.snap);
  await npWizRender(nc);
}
/** ⑥ 顶部版本条（只有勾了 2 个及以上平台才摆） */
function npVerBarHtml() {
  const w = npS();
  if (!w || !w.verMap || w.verMap.pids.length < 2) return '';
  return '<div id="npVerBar" style="margin:8px 0 10px;"></div>';
}
function npVerBarInnerHtml() {
  const w = npS(); if (!w || !w.verMap) return '';
  const chips = w.verMap.pids.map(pid => {
    const v = w.verMap.byPid[pid] || {};
    const on = pid === w.platform;
    const bc = v.error ? '#fde8e8' : (on ? 'var(--c-brand-soft)' : '#fff');
    const bd = v.error ? '#f0b4b4' : (on ? 'var(--c-brand)' : 'var(--line)');
    const col = v.error ? '#c62828' : (on ? 'var(--c-brand-text)' : '#555');
    const st = v.busy ? ' ⏳' : (v.error ? (v.ready ? ' ⚠ 重写没成功' : ' ⚠ 没写出来') : (v.ready ? '' : ' …'));
    return '<span style="display:inline-flex;align-items:center;gap:2px;">' +
      '<button type="button" class="npVerChip" data-pid="' + npArAttr(pid) + '" title="' + (v.error ? (v.ready ? '上次重写没成功——点开还是上一版，点 ↻ 再试一次' : '点我重试这一版') : (v.ready ? '切到这版看正文' : '')) + '" style="border:1px solid ' + bd + ';border-radius:8px;background:' + bc + ';color:' + col + ';font-size:11px;font-weight:700;padding:5px 10px;cursor:pointer;">' +
      npPfName(pid) + st + (on ? ' <span style="font-size:10px;font-weight:600;">正在看</span>' : '') + '</button>' +
      ((v.ready && pid !== 'xhs') ? '<button type="button" class="npVerRedo" data-pid="' + npArAttr(pid) + '" title="按同样的口径再写一版，覆盖这一档" style="border:1px solid var(--line);border-radius:8px;background:#fff;color:#8a929e;font-size:11px;padding:5px 7px;cursor:pointer;">↻</button>' : '') +
      '</span>';
  }).join('');
  return '<div style="border:1px solid var(--line);border-radius:10px;background:#fafbfc;padding:8px 10px;">' +
    '<div style="font-size:11px;font-weight:700;color:#333;margin-bottom:5px;">📮 这条的各个平台版本（点着看那一版的正文；↻ 按同样口径重写这一版）</div>' +
    '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">' + chips + '</div>' +
    '<div style="font-size:10px;color:#8a929e;margin-top:5px;">每版各自成档、各标各的发布状态；要出图 / 出视频，去「笔记档案」那一行点「🖼 造图片」（每版各出一份料）。</div></div>';
}
let _npVerWaitStop = null;
/** 正看着的那版还没写好时的等待面板（写好了会自动切过去） */
function npVerWaitPaint(nc) {
  const w = npS(); if (!w || !w.verMap) return;
  const el = _npEl(nc, 'npVerWait'); if (!el) return;
  if (_npVerWaitStop) { _npVerWaitStop(); _npVerWaitStop = null; }
  const v = w.verMap.byPid[w.platform];
  if (v && v.busy) {
    el.innerHTML = '<div id="npVerWaitMsg"></div>' +
      '<div style="font-size:10px;color:#8a929e;margin-top:4px;">写好后会自动切过来；也可以点上面已写好的平台先看。</div>';
    _npVerWaitStop = npWaitInto(nc, 'npVerWaitMsg', '正在按「' + npPfName(w.platform) + '」的规矩把这篇改写出来', 'notedraft',
      () => npS() === w && w.step === 5 && w.verMap && w.verMap.byPid[w.platform] === v && v.busy);
  } else if (v && v.error) {
    el.innerHTML = '<div style="color:#c62828;font-weight:600;">⚠️ 「' + esc(npPfName(w.platform)) + '」这版没写出来：' + esc(v.error) + '</div>' +
      '<div style="margin-top:8px;"><button type="button" class="npVerChip" data-pid="' + npArAttr(w.platform) + '" style="border:1px solid #f0b4b4;border-radius:8px;background:#fff;color:#c62828;font-size:12px;font-weight:700;padding:6px 12px;cursor:pointer;">🔄 重试这一版</button></div>';
  } else if (v && !v.ready) {
    el.innerHTML = '⏳ 「' + esc(npPfName(w.platform)) + '」排在后面，前面那版写完就到它。';
  } else {
    const pend = w.verMap.pids.filter(p => { const x = w.verMap.byPid[p]; return x && !x.ready; });
    el.innerHTML = '这条没勾小红书。' + (pend.length
      ? '正在等勾的平台写完（写好自动切过去）。'
      : '各平台的版本都没写出来——点上面标 ⚠ 的平台重试，或回上一步改勾选。');
  }
}
function npVerPaintAll(nc) {
  const w = npS(); if (!w || !nc) return;
  const bar = _npEl(nc, 'npVerBar');
  if (bar) bar.innerHTML = npVerBarInnerHtml();
  if (_npEl(nc, 'npVerWait')) npVerWaitPaint(nc);
  const db = _npEl(nc, 'npDeriveBox');   // 补版入口的按钮随版本表变（已经在表里的平台不再重复摆按钮）
  if (db) db.innerHTML = npDeriveHtml();
}

/* ═══════════ ↗ 补一个平台的版本：同一篇，按别的平台的规矩重写一版 ═══════════
   ⑤ 勾选时没勾的平台，事后想再发一份就点这里：事实/卖点/人设不变，标题写法、正文结构、
   话题长度、要不要视频全按目标平台的来。写出来挂在版本条上，单独成档、各标各的发布状态。 */
let _npDeriveBusy = false;

/** 派生那一发的入参：seed＝源版本，让 AI 重写而不是从零写（走成稿那条通路，加码重试/知识库筛选都复用） */
function npDerivePayload(src, targetPid) {
  return {
    action: 'aiRewriteNote',
    platform: targetPid,
    topic: src.topic || '',
    sellPoint: src.sellPoint || '',
    sellImages: src.sellImages || [],
    people: src.people || [],
    productName: src.productName || '',
    kbList: src.kbList || [],
    seed: {
      platformName: src.platformName || '',
      title: src.title || '',
      content: src.content || '',
      tags: src.tags || [],
    },
  };
}

/** 造图片页底部的补版入口：版本条上还没有的平台各一个按钮（写出来的版会挂到版本条上） */
function npDeriveHtml() {
  const w = _npWiz;
  if (!w || !w.draft || typeof Platforms === 'undefined') return '';
  const byPid = (w.verMap && w.verMap.byPid) || {};
  const others = Platforms.LIST.filter(p => p.id !== 'xhs' && !byPid[p.id]);
  if (!others.length) return '';
  const dis = _npDeriveBusy ? ' disabled' : '';
  return '<div style="border:1px dashed #cfe3ff;background:#f7fbff;border-radius:10px;padding:10px 12px;">' +
    '<div style="font-size:11px;font-weight:700;color:#1f6feb;">↗ 同一篇，再补一个平台的版本</div>' +
    '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:7px;">' +
    others.map(p => '<button type="button" class="np-derive" data-pid="' + npArAttr(p.id) + '"' + dis +
      ' title="按' + npArAttr(p.name) + '的规矩从这篇改写一版：事实、卖点、人设不变，标题写法 / 正文结构 / 话题长度 / 要不要视频全按它的来。写出来是新的一档，两边各标各的发布状态"' +
      ' style="border:1px solid #bfdbfe;background:#fff;color:#1d4ed8;border-radius:8px;font-size:11px;font-weight:700;padding:5px 12px;' + (_npDeriveBusy ? 'opacity:.5;cursor:not-allowed;' : 'cursor:pointer;') + '">' + p.icon + ' 写一版' + esc(p.name) + '</button>').join('') +
    '</div>' +
    '<div id="npDeriveMsg" style="font-size:11px;color:#9aa0ac;margin-top:6px;"></div></div>';
}

/** 补一版：把目标平台挂进版本表并写出来（写完切过去看）——留在⑥，不动勾选，也不动账号配置 */
async function npDerive(container, targetPid) {
  const w = _npWiz;
  if (!w || !w.draft || _npDeriveBusy) return;
  if (typeof Platforms === 'undefined' || !Platforms.has(targetPid) || targetPid === 'xhs') return;
  if (w.verMap && w.verMap.byPid[targetPid]) return;   // 版本表里已经有了：点版本条切 / 点 ↻ 重写就行
  _npDeriveBusy = true;
  try {
    if (!w.verMap) {   // 兜底：没有版本表时现搭一张（小红书那版＝手上这篇）
      w.verMap = { pids: ['xhs'], byPid: { xhs: { pid: 'xhs', arId: w.arId || '', ready: true, busy: false, error: '', snap: npVerSnap(w) } } };
      w.verBaseSnap = w.verMap.byPid.xhs.snap;
      w.verGen = (w.verGen || 0) + 1;
    }
    if (!w.verSeed) w.verSeed = { pids: [], src: npVerSeedSrc(w), sig: '', baseArId: w.arId || '' };
    const vm = w.verMap;
    vm.byPid[targetPid] = { pid: targetPid, arId: '', ready: false, busy: false, error: '', snap: null, autoView: true };
    if (vm.pids.indexOf(targetPid) < 0) vm.pids.push(targetPid);
    vm.pids = Platforms.LIST.map(p => p.id).filter(id => vm.pids.indexOf(id) >= 0);
    npVerPaintAll(container);
  } finally { _npDeriveBusy = false; }
  if (typeof toast === 'function') toast('正在按「' + npPfName(targetPid) + '」的规矩改写这篇…');
  await npVerBuildOne(container, targetPid, false);
  if (_npWiz !== w) return;
  const v = w.verMap && w.verMap.byPid[targetPid];
  if (v && v.ready && w.platform !== targetPid) await npVerSwitch(container, targetPid);
  else {
    npVerPaintAll(container);
    if (v && v.error && typeof toast === 'function') toast('「' + npPfName(targetPid) + '」这版没写出来：' + v.error, 'error');
  }
}

/** 标题 + 正文 + 标签一把复制（图文和视频的文案都是它；复制动作才算这篇"用过"） */
async function npCopyAll(container) {
  const w = _npWiz; if (!w || !w.draft) { if (typeof toast === 'function') toast('还没有成稿可复制', 'error'); return; }
  const ta = _npEl(container, 'npResult');
  const body = String((ta && ta.value) || w.draft.content || '').trim();
  if (!body) { if (typeof toast === 'function') toast('正文是空的，等成稿写完再复制', 'error'); return; }
  const title = _npNote.title || ((w.draft.titles || [])[0] || '');
  const isMkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(npPid(w)) === 'market';
  const tagLine = (_npNote.tags || []).map(t => (isMkt ? '' : '#') + String(t).replace(/^#/, '').trim()).join(isMkt ? '、' : ' ');
  const parts = [];
  if (title) parts.push(title);
  parts.push(body);
  if (tagLine) parts.push(tagLine);
  try {
    await copyToClipboard(parts.join('\n'));
    await npAddUsed(title || body.slice(0, 20), npPid(w)); // 记入"已发过池"，下次不再推荐同题
    npArchiveSave(w);   // 复制这一刻正文/标题/标签已是最终稿，存档一份
    const P = (typeof Platforms !== 'undefined') ? Platforms.get(npPid(w)) : null;
    if (typeof toast === 'function') toast('已复制：标题 + 正文 + ' + (P && Platforms.baseOf(P.id) === 'market' ? '关键词' : '标签') + '，去' + (P ? P.name : '小红书') + (P ? P.pasteWord : '粘贴发布'));
  } catch (_) { if (typeof toast === 'function') toast('复制失败', 'error'); }
}

/* ═══════════ 🗂 笔记档案：写过的每一篇都留档（发笔记 · 二级页） ═══════════
   口径（2026-09-24 定稿）：一篇一档；素材只存引用、不搬原图；状态自己标
   （草稿 → 待发 → 已发 → 已归档）；不回填阅读/点赞，只在列表里灰字显示「已发 N 天」；
   缩略图索引要带——「要不我都不知道系统干了啥」。 */
const NP_NOTES_KEY = 'np_notes';
const NP_NOTES_CAP = 300;
// 出片台那侧按篇存的草稿（video.js 自己写；档案只读它来看「编过没 / 出片没」）
const NP_FILM_DOCS_KEY = 'xhsFilmDocs';
const NP_AR_STATUS = ['草稿', '待发', '已发', '已归档'];
const NP_AR_RANK = { '草稿': 0, '待发': 1, '已发': 2, '已归档': 3 };

async function npNotesAll() {
  try { const d = await chrome.storage.local.get(NP_NOTES_KEY); const a = d[NP_NOTES_KEY]; return Array.isArray(a) ? a : []; }
  catch (_) { return []; }
}
/** 档案是「读整条 → 改 → 写整条」，两笔并发会互相覆盖（丢档是用户一眼看得见的损失）→ 串行 */
let _npArChain = Promise.resolve();
function npNotesSync(fn) { const p = _npArChain.then(fn).catch(() => {}); _npArChain = p; return p; }
function npNoteId() { return 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }
const npArAttr = (s) => esc(String(s == null ? '' : s)).replace(/"/g, '&quot;');

/** 这篇向导里有没有「值得留档」的东西：成稿，或者已经选定的卖点/人群/话题
 *  （没写完的草稿也要能存——「💾 保存」与「✏️ 继续编辑」靠它把半篇接下去） */
function npArchiveHasWork(w) {
  if (!w) return false;
  if (w.draft && String(w.draft.content || '').trim()) return true;
  return !!((w.chosen || []).length || (w.chosenPeople || []).length || (w.topics || []).length || (w.voice || '').trim());
}

/** 从向导这一篇取「内容侧」的快照（入队前先取好：算完再取，用户可能已经翻页/重置了） */
function npArchiveData(w) {
  npImgSync(w);                          // 打开那一行先跟着台上的改动走（这一页改画面＝改列表那一行）
  const tl = w.topics || [];
  const img = npImgMirror(w);            // 条目级那两份＝列表镜像：读它的那些地方（缺口列 / 教程 / 出片台）不用改
  const t = tl[(w.chosenTopicIdx >= 0 && w.chosenTopicIdx < tl.length) ? w.chosenTopicIdx : 0] || {};
  const note = (_npNote && _npNote.draft === w.draft) ? _npNote : { title: '', tags: [] };
  const d = w.draft || {};              // 没出成稿的草稿：这一份是空的，别的照存
  const first = (w.chosen || [])[0] || null;
  return {
    platform: npPid(w),                 // 这篇发到哪个平台（老档没有这个字段＝小红书）
    derivedFrom: (w.derivedFrom || ''), // 派生出来的：记着源档案 id 与标题（不是派生的＝空）
    derivedFromTitle: (w.derivedFromTitle || ''),
    origin: (w.derivedFrom ? 'derive' : ''),   // 派生出来的那几版，档案里标「派生入库（源自《X》）」
    // 还没成稿的草稿：拿话题 / 选中的卖点当标题，档案列表里至少认得出是哪半篇
    title: note.title || (d.titles || [])[0] || String(t.topic || '') || ((first && first.point) || ''),
    topic: String(t.topic || ''),
    people: (w.chosenPeople || []).map(p => String((p && p.name) || '')).filter(Boolean),
    sellPoints: (w.chosen || []).map(x => ({ point: String(x.point || ''), why: String(x.why || ''), hasImage: !!x.image })),
    kb: (w.chosenKb || []).map(e => ({ id: String(e.id || ''), title: String(e.title || '') })).filter(x => x.id || x.title),
    form: w.path === 'video' ? '视频' : (w.path === 'image' ? '图文' : ''),
    style: w.path === 'video' ? npStyleOf(w, 'video') : '',   // 表现形式这格只剩视频在用（由成片形式派生的口播写法口径）；图文＝画面流派，记在 imgDocs 那一行上
    filmKind: String(w.filmKind || ''),   // 这一档的成片形式（出片台第一步那五选一；视频才有）
    draft: String(d.content || ''),
    titles: (d.titles || []).map(String),
    tags: (note.tags || []).map(String),
    timeTip: String(d.timeTip || ''),
    visual: img ? img.visual : (w.visual ? { cover: String(w.visual.cover || ''), images: String(w.visual.images || '') } : null),
    shots: img ? img.shots : npShotsPack(w.shots),   // 造图片那张画面表（断句段 + 图描述 + 这一套的风格含流派 + 回传的图引用）
    imgDocs: Array.isArray(w.imgDocs) ? npImgPack(w.imgDocs) : null,   // 图片列表：一行一份（没这一页的存档＝ null，别动）
    filmDocs: Array.isArray(w.filmDocs) ? npFilmPack(w.filmDocs) : null,   // 片列表：一行一片（分幕内容在 xhsFilmDocs 按 key 存，这里只存指针）
    voice: String(w.voice || ''),
    // 「继续编辑」要用、档案列表又不显示的那几样：停在第几步、这条改过的话术/字数、④ 换过的线×写法、接的排产表那篇
    wip: {
      step: Number(w.step || 0) || 0,
      path: String(w.path || ''),
      noteStyle: Object.assign({}, w.noteStyle || {}),
      write: w.write ? { type: String(w.write.type || ''), kind: String(w.write.kind || '') } : null,
      planItem: w.planItem ? { no: w.planItem.no || null, title: String(w.planItem.title || ''), type: String(w.planItem.type || ''), kind: String(w.planItem.kind || ''), col: String(w.planItem.col || ''), day: Number(w.planItem.day || 0) || 0 } : null,
    },
    // 缩略图只存引用：记「哪条卖点」，显示时现去库里取配图（库里换了图，档案跟着变）
    thumb: (first && first.image) ? { kind: 'sell', ref: String(first.point || '') } : null,
  };
}

/** 把向导这一篇写进档案（同一篇只更新不新增；「再来一篇」才开新档）。forceStatus 不给＝沿用现有状态。
 *  默认只存已经出成稿的（老口径）；opts.wip=true（＝点「💾 保存」）才允许把没写完的半篇也存成草稿 —
 *  不然光是来回翻页就会在档案里堆出一堆用户没打算留的格子。 */
function npArchiveSave(w, forceStatus, opts) {
  if (!w) return Promise.resolve();
  const hasDraft = !!(w.draft && String(w.draft.content || '').trim());
  if (!hasDraft && !((opts && opts.wip) && npArchiveHasWork(w))) return Promise.resolve();
  const id = w.arId || (w.arId = npNoteId());
  const snap = npArchiveData(w);
  // 存过就算干净：回退时只问「存完之后又改的那部分」，已落档的不重复问
  if (w === _npWiz) _npWizSnap = npWizSig(w);
  return npNotesSync(async () => {
    const list = await npNotesAll();
    const i = list.findIndex(x => x && x.id === id);
    const prev = i >= 0 ? list[i] : null;
    const cur = NP_AR_STATUS.includes(prev && prev.status) ? prev.status : '';
    const rankOf = (s) => (NP_AR_RANK[s] === undefined ? -1 : NP_AR_RANK[s]);
    // 只许往前走（草稿 → 待发 → 已发 → 已归档）：用户已经标过「已发」的，再走一遍定稿不该被拖回待发
    const status = (NP_AR_RANK[forceStatus] !== undefined && rankOf(forceStatus) > rankOf(cur)) ? forceStatus : (cur || '草稿');
    const statusAt = Object.assign({}, (prev && prev.statusAt) || {});
    if (!prev || prev.status !== status) statusAt[status] = Date.now();
    const entry = Object.assign({}, snap, {
      id,
      createdAt: (prev && prev.createdAt) || Date.now(),
      updatedAt: Date.now(),
      platform: snap.platform || ((prev && prev.platform) || 'xhs'),
      // 这篇做图文还是视频：定下来就一直记着——「重新生成」换稿会把向导里的选路清空，但那是换文案、不是改主意
      form: snap.form || ((prev && prev.form) || ''),
      style: snap.style || ((prev && prev.style) || ''),   // 表现形式（只剩视频那格由成片形式派生）：同上，换稿不清
      filmKind: snap.filmKind || ((prev && prev.filmKind) || ''),   // 成片形式：出片台那一步选过一次就一直记着
      // 画面表只有造图片那页才有：从「写文案」那页存过来的那一次带的是空，别把已断好的擦掉
      shots: snap.shots || (snap.imgDocs ? null : ((prev && prev.shots) || null)),
      // 图片列表：造图片那页带着 imgDocs 就照它存（删空了＝[]，不能拿旧的回灌）；别的页没这一键
      imgDocs: snap.imgDocs || ((prev && prev.imgDocs) || null),
      // 片列表只有出片台那页才动：造图片／写文案那次带的是镜像或没这一键，别把已排好的几片擦掉
      filmDocs: snap.filmDocs || ((prev && prev.filmDocs) || null),
      status,
      statusAt,
      origin: (prev && prev.origin) || snap.origin || 'wizard',
    });
    if (i >= 0) list[i] = entry; else list.unshift(entry);
    npNotesTrim(list);
    try { await chrome.storage.local.set({ [NP_NOTES_KEY]: list }); } catch (_) {}
  });
}

/** 超上限时先丢最旧的已归档、再丢最旧的已发，最后才动别的（刚写的永远不丢） */
function npNotesTrim(list) {
  const dropOldest = (st) => {
    for (let k = list.length - 1; k >= 0; k--) if (!st || list[k].status === st) { list.splice(k, 1); return true; }
    return false;
  };
  while (list.length > NP_NOTES_CAP) { if (!dropOldest('已归档') && !dropOldest('已发') && !dropOldest('')) break; }
  return list;
}

/** 手改（正文/口播稿/标题/标签）后延迟回写档案：不用等下一次点按钮，关弹窗前也留得住 */
let _npArTouchTimer = null;
let _npArPending = null;
function npArchiveTouch(w) {
  clearTimeout(_npArTouchTimer);
  _npArPending = w;
  _npArTouchTimer = setTimeout(npArchiveFlushTouch, 800);
}
/** 打字后 0.8 秒内就切页（点「拿去出片」、回档案）的话，延时的这一笔会被吃掉：切页前先把刚改的写回 */
function npArchiveFlushTouch() {
  clearTimeout(_npArTouchTimer);
  const w = _npArPending;
  _npArPending = null;
  if (w) npArchiveSave(w);
}

/* 「← 笔记档案」前先问一句：有没有改动按落档内容的样子比（走到第几步不算，别为翻页扣住人）。
   只管这颗回退：走别的页不拦——这半篇还留在台上（写文案页不重渲染），并没有丢。 */
let _npWizSnap = null;
function npWizSig(w) {
  if (!w) return '';
  const d = npArchiveData(w);
  d.wip = { step: 0 };
  return JSON.stringify(d);
}
function npWizDirty() {
  if (!_npWiz || _npWizSnap === null) return false;
  return npWizSig(_npWiz) !== _npWizSnap;
}
function npWizBack() {
  if (!npWizDirty()) { switchMainTab('noteArchive'); return; }
  npOpenAskSave();
}
function npOpenAskSave() {
  let mask = document.getElementById('npAskSave');
  if (!mask) {
    mask = document.createElement('div');
    mask.id = 'npAskSave';
    mask.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(20,22,26,.42);display:flex;align-items:center;justify-content:center;';
    const btn = 'padding:7px 13px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid var(--line);background:#fff;color:#555;';
    mask.innerHTML = '<div style="width:340px;max-width:88vw;background:var(--c-surface,#fff);border:1px solid var(--line);border-radius:12px;padding:16px;box-shadow:0 12px 32px rgba(17,24,39,.22);">'
        + '<div id="npAskSaveTx" style="font-size:13px;font-weight:600;color:var(--ink);line-height:1.7;"></div>'
        + '<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-top:14px;">'
        + '<button type="button" class="np-ask-stay" style="' + btn + '">留下继续改</button>'
        + '<button type="button" class="np-ask-discard" style="' + btn + '">不存，直接回档案</button>'
        + '<button type="button" class="np-ask-save" style="' + btn + 'border:none;background:var(--grad-brand);color:var(--c-brand-on);">💾 存进这一档，再回档案</button>'
        + '</div></div>';
    document.body.appendChild(mask);
    mask.addEventListener('click', function (ev) {
      const t = ev.target && ev.target.closest ? ev.target : null;
      if (!t) return;
      if (t === mask || t.closest('.np-ask-stay')) { npCloseAskSave(); return; }   // 留下：问关掉，还在写文案这页
      npCloseAskSave();
      const go = function () { switchMainTab('noteArchive'); };
      if (t.closest('.np-ask-discard')) { _npWizSnap = npWizSig(_npWiz); go(); }   // 不写档，也别下次再问同一笔
      // 存完再走：档案那一页每次切入重渲染，抢在它前面跳过去会看不到刚存的这一档
      else if (t.closest('.np-ask-save')) npArchiveSave(_npWiz, '', { wip: true }).then(go, go);
      else go();
    });
  }
  const half = !(_npWiz.draft && String(_npWiz.draft.content || '').trim());
  document.getElementById('npAskSaveTx').textContent = half
      ? '这半篇还没存进「笔记档案」。存了之后，在档案那一行点「✏️ 写文案」能接着写。'
      : '这一篇存过之后又改过，改动还没落进档案。';
  mask.style.display = 'flex';
}
function npCloseAskSave() {
  const m = document.getElementById('npAskSave');
  if (m) m.style.display = 'none';
}

async function npNoteSetStatus(id, status) {
  if (!NP_AR_STATUS.includes(status)) return;
  await npNotesSync(async () => {
    const list = await npNotesAll();
    const i = list.findIndex(x => x && x.id === id);
    if (i < 0) return;
    if (list[i].status !== status) {
      list[i].statusAt = Object.assign({}, list[i].statusAt || {}, { [status]: Date.now() });
      list[i].status = status;
      list[i].updatedAt = Date.now();
    }
    try { await chrome.storage.local.set({ [NP_NOTES_KEY]: list }); } catch (_) {}
  });
}

async function npNoteDelete(id) {
  await npNotesSync(async () => {
    const list = (await npNotesAll()).filter(x => !(x && x.id === id));
    try { await chrome.storage.local.set({ [NP_NOTES_KEY]: list }); } catch (_) {}
  });
}

function npArAgo(ts) {
  if (!ts) return '';
  const d = Date.now() - ts;
  if (d < 60000) return '刚刚';
  if (d < 3600000) return Math.floor(d / 60000) + ' 分钟前';
  if (d < 86400000) return Math.floor(d / 3600000) + ' 小时前';
  const days = Math.floor(d / 86400000);
  return days < 30 ? days + ' 天前' : new Date(ts).toLocaleDateString('zh-CN');
}
function npArDays(ts) { return ts ? Math.max(0, Math.floor((Date.now() - ts) / 86400000)) : 0; }

/* ── 档案页 ── */
let _npArFilter = 'all';
let _npArDelegated = false;
let _npArImgs = {};   // 卖点标题 → 配图（引用现取）

/** 索引用的小图：卖点配图现取那张，没有就按这条路占位（图文📝 / 视频🎬） */
function npArThumb(n) {
  const im = (n.thumb && n.thumb.kind === 'sell') ? (_npArImgs[n.thumb.ref] || '') : '';
  if (im) return '<img src="' + npArAttr(im) + '" alt="" style="flex:none;width:42px;height:38px;object-fit:cover;border-radius:7px;border:1px solid #eee;">';
  const mkt = (typeof Platforms !== 'undefined') && Platforms.baseOf(n.platform || 'xhs') === 'market';
  return '<div style="flex:none;width:42px;height:38px;border-radius:7px;border:1px solid var(--line);background:#f7f8fa;display:flex;align-items:center;justify-content:center;font-size:17px;">' +
    (mkt ? '🐟' : (n.form === '视频' ? '🎬' : (n.form === '图文' ? '📝' : '📄'))) + '</div>';
}
/** 平台小标：档案列表里一眼看出这篇是发哪儿的（老档没平台字段＝小红书） */
function npArPfChip(n) {
  if (typeof Platforms === 'undefined') return '';
  const P = Platforms.get(n && n.platform);
  return '<span class="npar-pf" style="font-size:10px;font-weight:700;color:#1f4e8c;background:#eef4ff;border-radius:6px;padding:1px 6px;">' + P.icon + ' ' + esc(P.name) + '</span>';
}

function npArBtn(cls, label, attrs, title) {
  return '<button type="button" class="npar-mini ' + cls + '" ' + (attrs || '') + (title ? ' title="' + npArAttr(title) + '"' : '') + '>' + label + '</button>';
}

/** 档案一行的动作：四个按钮永远摆在右侧（老板：操作列就是那几颗，别点了才冒出来）。
 *  其中两颗有前置——造图片要这篇有正文，出片台要已经出过料（有口播稿或该片已有出片草稿）：
 *  缺料时按钮还在，只是按下去当场说清缺哪一步，不开空页、也不烧 AI。 */
function npArCan(n, kind, film) {
  const hasDraft = !!(n && String(n.draft || '').trim());
  if (kind === 'out') return hasDraft ? '' : '这篇还没有正文——先在「✏️ 写文案」里把稿子定下来，才轮到造图片。';
  if (kind === 'film') {
    if (!hasDraft) return '这篇还没有正文——先在「✏️ 写文案」里把稿子定下来。';
    if (!String(n.voice || '').trim()) {
      return film
        ? '这一篇换过稿，口播稿已经作废了——去「🖼 造图片」顶上那格文案重新整一份（片台里那份草稿还留着，整完接着编）。'
        : '出片台念的是「🖼 造图片」顶上那格文案（口播稿）——先去造图片把这一段文案贴好，再来出片。';
    }
  }
  return '';
}

/** 表头：跟每一行用同一套格子宽度（同一份 grid-template），所以列永远对得齐 */
function npArHead() {
  return '<div class="npar-row npar-head">' +
    '<div class="npar-cell npar-col-thumb"></div>' +
    '<div class="npar-cell npar-col-ttl">篇目</div>' +
    '<div class="npar-cell npar-col-status">状态</div>' +
    '<div class="npar-cell npar-col-form">形式 · 流派</div>' +
    '<div class="npar-cell npar-col-peek">内容（正文开头 / 已出哪些料 / 还缺什么）</div>' +
    '<div class="npar-cell npar-col-time">时间</div>' +
    '<div class="npar-cell npar-col-act">操作</div>' +
  '</div>';
}

/** 一行＝一篇：缩略图 / 标题＋平台 / 状态（可直接改）/ 形式·来源 / 内容摘要 / 时间 / 操作（右侧）。
 *  全文、出图提示词、口播稿不铺在表里——去「写文案」「造图片」里看。
 *  老板口径（2026-10-01）：行高压到一列，多摆几列；操作列回到右边。 */
function npArRow(n, gaps, film, def) {
  const st = NP_AR_STATUS.includes(n.status) ? n.status : '草稿';
  const title = n.title || String(n.draft || '').split('\n').map(s => s.trim()).filter(Boolean)[0] || '（无标题）';
  const doneAt = n.statusAt && n.statusAt['已发'];
  const sent = st === '已发' || st === '已归档';
  const formBits = [];
  if (n.form === '视频') {
    const kind = n.filmKind || n.style || '';          // 视频这一档摆成片形式（出片台第一步选的）；没选过才退回旧的表现形式叫法
    formBits.push(kind ? '视频 · ' + kind : '视频');
  } else if (n.form === '图文') {
    // 五十五改：图文这一路的身份是画面流派（记在出图列表每一行上），旧档那层「形式」只当老账读
    const ms = npNoteMotifs(n, def);
    formBits.push('图文 · ' + (ms.length ? ms.join(' / ') : (n.style ? '旧：' + n.style : '没定流派')));
  } else if (n.form) formBits.push(n.form);
  if (n.origin === 'derive') formBits.push('派生入库' + (n.derivedFromTitle ? '（源自《' + n.derivedFromTitle + '》）' : ''));
  const timeBits = [];
  if (sent) timeBits.push('发出去 ' + npArDays(doneAt) + ' 天');
  timeBits.push('改于 ' + npArAgo(n.updatedAt));
  // 出片台那侧的状态（按篇存的草稿）：编过 / 已出片都在这儿露一眼
  if (film) timeBits.push(film.outAt ? ('🎬 已出片 · ' + npArAgo(film.outAt)) : '🎬 出片台编过');
  const idA = 'data-id="' + npArAttr(n.id) + '"';
  const noOut = npArCan(n, 'out', film);
  // 状态就在这一列改（不再单独摆「标为待发 / 我发了」按钮）
  const stSel = '<select class="npar-stsel" ' + idA + ' title="改这一篇的状态：草稿（没写完）→ 待发（写好了还没发）→ 已发 → 已归档（不再跟进）">' +
    NP_AR_STATUS.map(s => '<option value="' + s + '"' + (s === st ? ' selected' : '') + '>' + s + '</option>').join('') +
    '</select>';
  const act = (cls, icon, label, tips, on) =>
    '<button type="button" class="npar-mini ' + cls + (on ? '' : ' npar-dim') + '" ' + idA +
    (tips ? ' title="' + npArAttr(tips) + '"' : '') + '>' + icon +
    (label ? '<span class="lbl">' + esc(label) + '</span>' : '') + '</button>';
  return '<div class="npar-row">' +
    '<div class="npar-cell npar-col-thumb">' + npArThumb(n) + '</div>' +
    '<div class="npar-cell npar-col-ttl"><div class="npar-tx" title="' + npArAttr(title) + '">' + esc(title) + npArPfChip(n) + '</div></div>' +
    '<div class="npar-cell npar-col-status">' + stSel + '</div>' +
    '<div class="npar-cell npar-col-form"><div class="npar-sub" title="' + npArAttr(formBits.join(' · ')) + '">' + esc(formBits.join(' · ') || '还没选图文 / 视频') + '</div></div>' +
    '<div class="npar-cell npar-col-peek">' + npArPeek(n) +
      ((gaps && gaps.length) ? '<button type="button" class="npar-gap" ' + idA + ' title="这篇要的素材还没备齐——点开素材库补上">⚠ ' + esc(npAsGapText(gaps)) + '</button>' : '') +
    '</div>' +
    '<div class="npar-cell npar-col-time"><div class="npar-sub" title="' + npArAttr(timeBits.join(' · ')) + '">' + esc(timeBits.join(' · ')) + '</div></div>' +
    '<div class="npar-cell npar-col-act">' +
      act('npar-edit', '✏️', ' 写文案', '回到「写文案」接着写这一篇：卖点 / 人群 / 话题 / 正文都还留着，改完存回来还是这一档', true) +
      act('npar-task', '🎯', ' 出图 / 出片', noOut || '这一篇要出的活都摊在一张表上：一行＝一个活（图按「平台 × 画面流派」、片按「平台 × 成片形式」），点行上「🖼 出图」进造图片、「🎬 出片」进出片台', !noOut) +
      act('npar-guide', '📖', ' 教程', '这一篇怎么出图 / 出片、最后怎么发出去——发布教程单独一页（换图文 / 视频只是换着看）', true) +
      act('npar-del', '✕', '', '从档案里删掉这一篇（不可恢复）', true) +
    '</div>' +
  '</div>';
}

/** 内容那一格：正文（没正文用口播稿）开头一句 + 这篇已经有哪些料的记号 */
function npArPeek(n) {
  const peek = String(n.draft || n.voice || '').replace(/\s+/g, ' ').trim();
  const has = [];
  if (n.visual && (n.visual.cover || n.visual.images)) has.push('🎨 出图提示词');
  if (String(n.voice || '').trim()) has.push('🎙 口播稿');
  if (!peek && !has.length) return '<span class="npar-sub">（还没成稿——去「✏️ 写文案」）</span>';
  return '<span class="npar-tx1">' + esc(peek.slice(0, 30)) + (peek.length > 30 ? '…' : '') + '</span>' +
    (has.length ? '<span class="npar-has">' + esc(has.join(' · ')) + '</span>' : '');
}

/** 档案那一行对应的存档 / 该篇在出片台那侧的草稿（出片台的账按篇存在 xhsFilmDocs，不并进档案） */
async function npArFindById(id) {
  const list = await npNotesAll();
  return list.find(x => x && x.id === id) || null;
}
async function npArFilmDoc(id) {
  if (!id) return null;
  try { const d = await chrome.storage.local.get(NP_FILM_DOCS_KEY); const m = (d && d[NP_FILM_DOCS_KEY]) || {}; return m[id] || null; } catch (_) { return null; }
}
function npArNoGo(msg) { if (typeof toast === 'function') toast(msg, 'error'); }

function ensureNpArDelegation(container) {
  if (_npArDelegated) return;
  _npArDelegated = true;
  container.addEventListener('click', async function (ev) {
    const t = ev.target;
    if (!t || !t.closest) return;
    const f = t.closest('.npar-filter');
    if (f) { _npArFilter = f.getAttribute('data-f') || 'all'; renderNoteArchive(container); return; }
    const pg = t.closest('.npar-plan-go');
    if (pg) { ev.preventDefault(); switchMainTab('diagnose'); diagGo(6); return; }   // 去「规划」看 / 改那份规划
    // 🎯 出图 / 出片：这一篇的活全摊在那张任务表上，进造图片 / 出片台都从表上的行走（要有正文才排得了活）
    const tk = t.closest('.npar-task');
    if (tk) {
      const n = await npArFindById(tk.getAttribute('data-id'));
      if (!n) return;
      const msg = npArCan(n, 'out');
      if (msg) { npArNoGo(msg); return; }
      npArchiveFlushTouch();
      switchMainTab('noteTask', n);
      return;
    }
    // 📖 教程：这一篇怎么出、怎么发
    // 📖 教程：这一篇怎么出、怎么发（单独一页，换形式只是换着看，不动已出的料）
    const gd = t.closest('.npar-guide');
    if (gd) {
      const n = await npArFindById(gd.getAttribute('data-id'));
      if (n) switchMainTab('noteGuide', n);
      return;
    }
    const gp = t.closest('.npar-gap');
    if (gp) {
      const id = gp.getAttribute('data-id') || '';
      const n = (await npNotesAll()).find(x => x && x.id === id);
      const g = n ? await npAsGapsFor([n]) : {};
      _npAsFocus = ((g[id] || [])).map(x => x.id);   // 跳过去高亮这几条，别让用户自己找
      switchMainTab('noteAssets');
      return;
    }
    const del = t.closest('.npar-del');
    if (del) {
      const id = del.getAttribute('data-id');
      const n = (await npNotesAll()).find(x => x && x.id === id);
      if (!n || !window.confirm('确定从档案里删掉这一篇？不可恢复。\n\n' + (n.title || String(n.draft || '').slice(0, 30)))) return;
      await npNoteDelete(id);
      renderNoteArchive(container);
      return;
    }
    const cl = t.closest('.npar-clean');
    if (cl) {
      const list = await npNotesAll();
      const gone = list.filter(x => x && x.status === '已归档').length;
      if (!gone) { if (typeof toast === 'function') toast('没有已归档的'); return; }
      if (!window.confirm('清理 ' + gone + ' 篇已归档的笔记档案？不可恢复。')) return;
      await npNotesSync(async () => {
        const keep = (await npNotesAll()).filter(x => !(x && x.status === '已归档'));
        try { await chrome.storage.local.set({ [NP_NOTES_KEY]: keep }); } catch (_) {}
      });
      renderNoteArchive(container);
      return;
    }
    // ✍️ 写文案：档案页顶那个主按钮 —— 起新的一篇（带 'new'：上一半没写完也不接着那一半）
    if (t.closest('.npar-new')) { switchMainTab('notePublish', 'new'); return; }
    // ✏️ 继续编辑：把这一篇的存档灌回向导接着写（还是这一档，arId 不变）
    const ed = t.closest('.npar-edit');
    if (ed) {
      const n = (await npNotesAll()).find(x => x && x.id === ed.getAttribute('data-id'));
      if (n) switchMainTab('notePublish', n);
      return;
    }
  });
  // 状态直接在这一列改（下拉）：改完重画一次，筛选条上的计数跟着变
  container.addEventListener('change', async function (ev) {
    const sel = ev.target && ev.target.closest ? ev.target.closest('.npar-stsel') : null;
    if (!sel) return;
    await npNoteSetStatus(sel.getAttribute('data-id') || '', sel.value);
    renderNoteArchive(container);
  });
}

/* ── 计划 vs 实际（只提示、不约束） ──
   规划里写的「发布频率」是 AI 的一句自由文本（「建议每周 3 篇，理由是…」），
   能认出「每周 N 篇 / 日更」就拿来跟这周真发出去的对一对；认不出来就只报本周实数，不瞎猜。 */
const NP_CN_NUM = { 一: 1, 二: 2, 两: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9, 十: 10 };
function npWeekQuota(freq) {
  const s = String(freq || '');
  if (!s) return 0;
  if (/日更|每天|每日/.test(s)) return 7;
  if (!/(每周|一周|每星期|每礼拜|周更)/.test(s)) return 0;   // 没提「周」就不当周期计划看
  const m = s.match(/([0-9一二三四五六七八九十两]+)\s*(?:[~～\-—至到]\s*[0-9一二三四五六七八九十两]+)?\s*[篇更条次]/);
  if (!m) return 0;
  const n = /^\d+$/.test(m[1]) ? parseInt(m[1], 10) : (NP_CN_NUM[m[1]] || 0);
  return (n > 0 && n <= 21) ? n : 0;      // 「每周 30 篇」这种明显是随口写的，不当计划
}

/** 本周已发几篇：按档案里「已发」那一刻算（归档的也算发过），周一起算 */
function npWeekDone(list) {
  const now = new Date();
  const from = new Date(now.getFullYear(), now.getMonth(), now.getDate() - ((now.getDay() + 6) % 7)).getTime();
  return (list || []).filter(n => n && n.statusAt && Number(n.statusAt['已发']) >= from).length;
}

function npArPlanLine(list, plan) {
  if (!plan) return '';
  const freq = String(plan.frequency || plan.rhythm || '').trim();   // v2 规划用 rhythm + perWeek，v1 只有 frequency
  const quotaPlan = Number(plan.perWeek) || 0;
  if (!freq && !quotaPlan) return '';
  // 先按节奏文本解析（人写的「每周两篇 / 日更」最准），解析不出再用 v2 规划的 perWeek 数字
  const done = npWeekDone(list), quota = npWeekQuota(freq) || quotaPlan;
  const head = '📅 本周已发 <b style="color:#666;">' + done + '</b> 篇';
  const why = '规划里定的节奏对一对就好，不影响任何功能、也不卡你发';
  const link = (txt) => '<a href="#" class="npar-plan-go" title="' + npArAttr(why) + '" style="color:#1f6feb;text-decoration:none;">' + txt + '</a>';
  const planTxt = quota
    ? link('规划每周 ' + quota + ' 篇') + '（' + (done > quota ? '比规划多 ' + (done - quota) + ' 篇' : (done === quota ? '刚好' : '还差 ' + (quota - done) + ' 篇')) + '）'
    : link('规划的节奏') + '：「' + esc(freq.slice(0, 24)) + (freq.length > 24 ? '…' : '') + '」';
  return '<div class="npar-plan" style="font-size:11px;color:#8a929e;line-height:1.7;margin:-4px 0 10px;">' + head + ' · ' + planTxt + '</div>';
}

async function renderNoteArchive(container) {
  if (!container) return;
  ensureNpArDelegation(container);
  const list = await npNotesAll();
  let plan = null;
  try { const d = await chrome.storage.local.get('note_plan'); plan = (d && d.note_plan) || null; } catch (_) {}
  // 缩略图引用现取：档案里只记了「哪条卖点」，配图去当前库里取
  _npArImgs = {};
  let defMotif = '';
  try {
    const c = await readConfigPlain();
    ((c && c.product && c.product.sellPoints) || []).forEach(s => {
      if (s && s.title && s.image) _npArImgs[String(s.title)] = String(s.image);
    });
    defMotif = String(((c && c.imgLook) || {}).motif || '').trim();
  } catch (_) {}
  await npLoadImgMotifs();   // 🎭 缺口那侧认「来源名＝哪一派」要连着账号自加的那几派一起认
  // 🎬 出片台的状态按篇存在 xhsFilmDocs 里（那份是出片台自己的账，不写回档案，免得两边抢同一份存储）：
  //    这里只读一眼，好在列表里显示「编过 / 已出片」，并把「拿去出片」挂到那一条上
  let films = {};
  try { const fd = await chrome.storage.local.get(NP_FILM_DOCS_KEY); films = (fd && fd[NP_FILM_DOCS_KEY]) || {}; } catch (_) {}
  const cnt = {};
  NP_AR_STATUS.forEach(s => { cnt[s] = list.filter(n => n && n.status === s).length; });
  const shown = _npArFilter === 'all' ? list : list.filter(n => n && n.status === _npArFilter);
  // 缺口提示：只有还没发出去的才催（已发 / 已归档不再提「还缺图」）
  const gaps = await npAsGapsFor(shown.filter(n => n && n.status !== '已发' && n.status !== '已归档'));
  const chip = (key, label, n) => {
    const on = _npArFilter === key;
    return '<button type="button" class="npar-filter" data-f="' + key + '" style="border:1px solid ' + (on ? 'var(--c-brand)' : 'var(--line)') + ';background:' + (on ? 'var(--c-brand-soft)' : '#fff') + ';color:' + (on ? 'var(--c-brand-text)' : '#666') + ';border-radius:999px;font-size:11px;padding:3px 10px;cursor:pointer;">' + label + (n ? ' ' + n : '') + '</button>';
  };
  const empty = list.length
    ? '这个状态下还没有笔记，换个筛选看看。'
    : '还没有笔记——点右上「✍️ 写文案」起一篇：成稿一出来就自动进这里（草稿）；写好发稿之后，在左边「状态」那一列标成待发 / 已发。';
  container.innerHTML =
    '<div style="padding:6px 2px;">' +
      '<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;">' +
        '<div style="font-weight:600;color:var(--ink);font-size:13px;">🗂 笔记档案<span class="qhelp" tabindex="0" data-tip="这一块的主页。写过的每一篇都在这（连没写完的草稿），一行一篇：篇目 / 状态（在这一列直接改）/ 形式 · 流派（图文那侧摆这一篇用到的画面流派）/ 内容（正文开头 + 已出哪些料 + 还缺什么）/ 时间。右边操作列四件事——写文案（接着写）、造图片（图文或视频的料）、教程（这一篇怎么出、怎么发）、出片台（本机出片）；造图片要有正文、出片台要已经出过料，缺哪一步点它会当场告诉你。">?</span></div>' +
        '<span style="flex:1;"></span>' +
        // 主入口：写文案（原来挂在左栏二级，现在收进档案页顶——这里是这一块的家）
        '<button type="button" class="npar-new" title="起新的一篇：6 步向导（卖点 → 人群 → 话题 → 挑稿 → 改稿 → 发稿），成稿一出来就自动存进这张档案" style="padding:6px 14px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;">✍️ 写文案</button>' +
      '</div>' +
      '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">' +
        chip('all', '全部', list.length) + NP_AR_STATUS.map(s => chip(s, s, cnt[s])).join('') +
        '<span style="flex:1;"></span>' +
        (cnt['已归档'] ? '<button type="button" class="npar-clean" style="border:1px solid var(--line);background:#fff;color:#888;border-radius:999px;font-size:11px;padding:3px 10px;cursor:pointer;">🧹 清理已归档（' + cnt['已归档'] + '）</button>' : '') +
      '</div>' +
      npArPlanLine(list, plan) +
      (shown.length ? '<div class="npar-list">' + npArHead() + shown.map(n => npArRow(n, gaps[n.id], films[n.id], defMotif)).join('') + '</div>'
                    : '<div style="font-size:12px;color:#999;padding:14px 0;">' + empty + '</div>') +
    '</div>';
}

/* ═══════════ 📚 素材库：AI 整理出「要备哪些素材」的清单，你在卡里传本机图 ═══════════
   两条老口径不变：① 素材只存引用（知识库图 / 卖点图只记名字，现取；本机图只留 ≤160px 缩略图 + 文件名，
   原图自己保管）；② 需求清单可重建，卖点 / 知识库没变就不重算（signature 缓存），重算也保住自己加的那几条。
   2026-09-25 收敛成「一条一张卡 + 两个按钮」：🤖 AI 整理素材＝重算，➕ 新增素材＝
   自己写说明 + 传本机图（存完由 AI 按说明关联知识库 / 卖点）。贴链接 / 备好了 / 不需要 / 筛选 全部下线。
   卡而不是表：弹窗只有 640px，5 列表格会把「要什么 / 来源 / 用在哪」挤成看不见，所以标题行只留
   缩略图 + 标题 + 状态/来源 + 操作，说明与进度各占整行、不截字。 */
const NP_NEED_KEY = 'np_asset_needs';
const NP_ASSETS_KEY = 'np_assets';
/** 老清单里留下的「表现形式」名（五十五改后不再当来源摆，只用来认旧账）；现在给 AI 选的来源池＝画面流派（npMotifOpts） */
function npAsFormNames() {
  if (typeof Platforms === 'undefined') return ['清单卡片式', '教程步骤式', '对比测评式', '经验故事式', '口播讲解', '卡片轮播口播'];
  const out = [];
  Platforms.ids().forEach(id => Platforms.pathsOf(id).forEach(p => Platforms.styleKeys(id, p).forEach(k => { if (out.indexOf(k) < 0) out.push(k); })));
  return out;
}

let _npAsFocus = [];       // 从档案那侧点「还缺 N 张」跳过来时，要高亮的几条需求
let _npAsBusy = false;
let _npAsUpNeed = '';      // 「传本机图」按的是哪条需求
let _npAsDelegated = false;
let _npAsNew = false;      // 「新增素材」弹窗开着没
let _npAsNewDesc = '';     // 弹窗里写了一半的说明（重画不丢）
let _npAsNewPicked = [];   // 弹窗里已选的图（先攒缩略图，保存时一起落盘）

function npAsId() { return 's' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

async function npAsNeedsRead() {
  try {
    const d = await chrome.storage.local.get(NP_NEED_KEY);
    const v = d[NP_NEED_KEY];
    if (v && Array.isArray(v.needs)) return { sig: String(v.sig || ''), genAt: v.genAt || 0, needs: v.needs };
  } catch (_) {}
  return { sig: '', genAt: 0, needs: [] };
}
async function npAsNeedsWrite(v) { try { await chrome.storage.local.set({ [NP_NEED_KEY]: v }); } catch (_) {} }
async function npAsAssetsRead() {
  try {
    const d = await chrome.storage.local.get(NP_ASSETS_KEY);
    const a = d[NP_ASSETS_KEY];
    if (Array.isArray(a)) return a;
  } catch (_) {}
  return [];
}
async function npAsAssetsWrite(list) { try { await chrome.storage.local.set({ [NP_ASSETS_KEY]: list }); } catch (_) {} }

/** 卖点 / 知识库 的配图索引：只记引用（名字 → 图），显示时现取——库里换了图，素材库跟着变；
 *  同时单独给出「全部名字」（没配图的也算）——认来源 / 算「用在哪」要用全量，取图才只看有图的 */
async function npAsImgIndex() {
  const sell = {}, kb = {}, sellTitles = [], kbTitles = [];
  let defMotif = '';
  try {
    const c = await readConfigPlain();
    ((c && c.product && c.product.sellPoints) || []).forEach(s => {
      const t = String((s && s.title) || '').trim();
      if (!t) return;
      sellTitles.push(t);
      if (s.image) sell[t] = String(s.image);
    });
    defMotif = String(((c && c.imgLook) || {}).motif || '').trim();   // 账号默认那一派：没定流派的行按它算
  } catch (_) {}
  try {
    const r = await chrome.runtime.sendMessage({ action: 'getKnowledgeBase' });
    ((r && r.entries) || []).forEach(e => {
      if (!e || e.isActive === false) return;
      const t = String(e.title || '').trim();
      if (!t) return;
      kbTitles.push(t);
      if (e.image) kb[t] = String(e.image);
    });
  } catch (_) {}
  return { sell, kb, sellTitles, kbTitles, defMotif };
}

/** AI 给的「来源」是个名字：认出它属于 流派 / 卖点 / 知识库 哪一类，好算「用在哪」（旧清单里那层形式名只当老账认） */
function npAsFrom(source, sellTitles, kbTitles) {
  const s = String(source || '').trim();
  if (!s) return { type: '', name: '' };
  const pick = (arr) => arr.find(t => t && (t === s || s.includes(t) || t.includes(s)));
  const m = pick(npMotifOpts()); if (m) return { type: 'motif', name: m };
  const f = pick(npAsFormNames()); if (f) return { type: 'form', name: f };
  const sp = pick(sellTitles); if (sp) return { type: 'sell', name: sp };
  const kb = pick(kbTitles); if (kb) return { type: 'kb', name: kb };
  return { type: '', name: s };
}

/** 名目里写了数量（×3 / 3 张）：备够了几张才知道算不算「已有」 */
function npAsWantCount(title) {
  const m = String(title || '').match(/[×xX*]\s*(\d+)|(\d+)\s*张/);
  const n = m ? parseInt(m[1] || m[2], 10) : 0;
  return (n > 0 && n <= 20) ? n : 0;
}

/** 一条需求算哪一态（推出来的，不单独存）：挂上的够数 → 已有，否则待备 */
function npAsNeedState(x, got) {
  const want = npAsWantCount(x && x.title);
  return { want: want, state: (got && (!want || got >= want)) ? '已有' : '待备' };
}

/** 这篇笔记是不是用到了这条需求（按 卖点 / 知识库 / 画面流派 对，旧清单的形式名只当老账）——用来在清单上标「用在哪」 */
function npAsUsedBy(from, notes, defMotif) {
  const nm = String(from.name || '').trim();
  if (!nm) return [];
  const hit = (n) => {
    if (!n || n.status === '已归档') return false;
    if (from.type === 'sell') return (n.sellPoints || []).some(p => { const s = String((p && p.point) || ''); return !!s && (s === nm || s.includes(nm) || nm.includes(s)); });
    if (from.type === 'kb') return (n.kb || []).some(e => { const s = String((e && (e.title || e.id)) || '').trim(); return !!s && (s === nm || s.includes(nm) || nm.includes(s)); });
    if (from.type === 'motif') return npNoteMotifs(n, defMotif).indexOf(nm) >= 0;
    if (from.type === 'form') return (String(n.form || '') + ' ' + String(n.style || '')).includes(nm);
    return false;
  };
  return notes.filter(hit).map(n => n.title || String(n.draft || '').split('\n')[0].slice(0, 14) || '（无标题）');
}

/** 档案那侧要的缺口：档案里哪几篇还缺素材 —— 按每篇的 卖点 / 知识库 / 画面流派 反查清单，只剩「待备」的算缺 */
async function npAsGapsFor(notes) {
  const gaps = {};
  const v = await npAsNeedsRead();
  if (!(v.needs || []).length || !notes.length) return gaps;
  const assets = await npAsAssetsRead();
  const { sell: sellImgs, kb: kbImgs, sellTitles, kbTitles, defMotif } = await npAsImgIndex();
  notes.forEach(n => {
    const hit = [];
    v.needs.forEach(x => {
      const from = npAsFrom(x.source, sellTitles, kbTitles);
      if (!npAsUsedBy(from, [n], defMotif).length) return;   // 这条不是给这篇备的
      const auto = ((from.type === 'sell' && sellImgs[from.name]) || (from.type === 'kb' && kbImgs[from.name])) ? 1 : 0;
      const got = assets.filter(a => a && a.needId === x.id).length + auto;
      const st = npAsNeedState(x, got);
      if (st.state === '待备') hit.push({ id: x.id, title: String(x.title || ''), want: st.want, got: got });
    });
    if (hit.length) gaps[n.id] = hit;
  });
  return gaps;
}

/** 缺口那句话：还缺 3 张（教程步骤图 ×2、门店实拍 ×1） */
function npAsGapText(hit) {
  const total = (hit || []).reduce((s, x) => s + Math.max(1, (x.want || 1) - (x.got || 0)), 0);
  const names = (hit || []).slice(0, 2).map(x => x.title).filter(Boolean).join('、') + ((hit || []).length > 2 ? ' 等 ' + hit.length + ' 条' : '');
  return '还缺 ' + total + ' 张（' + names + '）';
}

/** 本机图 → ≤160px 缩略图（原图不入库，存的就是这张小图 + 文件名） */
function npAsThumb(file) {
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onerror = () => reject(new Error('读文件失败'));
    fr.onload = () => {
      const img = new Image();
      img.onerror = () => reject(new Error('不是能识别的图片'));
      img.onload = () => {
        try {
          const MAX = 160;
          const iw = img.width || MAX, ih = img.height || MAX;
          const sc = Math.min(1, MAX / Math.max(iw, ih));
          const w = Math.max(1, Math.round(iw * sc)), h = Math.max(1, Math.round(ih * sc));
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          resolve({ thumb: cv.toDataURL('image/jpeg', 0.72), w: iw, h: ih });
        } catch (e) { reject(e); }
      };
      img.src = String(fr.result || '');
    };
    fr.readAsDataURL(file);
  });
}

/** 这份清单是按什么算的：产品名 + 卖点 + 知识库标题 —— 没变就不重算，省一次 AI */
async function npAsFingerprint() {
  try {
    const c = await readConfigPlain();
    const sp = ((c && c.product && c.product.sellPoints) || [])
      .map(s => String((s && (s.title || s.content)) || '').trim().slice(0, 30)).filter(Boolean);
    const mt = ((c && c.imgMotifs) || []).map(m => String((m && m.k) || '').trim()).filter(Boolean);
    let kb = [];
    try {
      const r = await chrome.runtime.sendMessage({ action: 'getKnowledgeBase' });
      kb = ((r && r.entries) || []).filter(e => e && e.isActive !== false)
        .map(e => String(e.title || '').trim()).filter(Boolean).slice(0, 40);
    } catch (_) {}
    return [String((c && c.product && c.product.name) || '').trim(),
      ((c && c.product && Array.isArray(c.product.names)) ? c.product.names.slice(1) : []).join('、')]
      .concat(sp, kb, mt).join('|');
  } catch (_) { return ''; }
}

/** 算一遍：AI 按 卖点 × 知识库 × 画面流派 出「要备哪些素材」；同名条目保住我标过的状态，手加的条目留着 */
async function npAsGen(container) {
  if (_npAsBusy) return;
  const fp = await npAsFingerprint();
  const cur = await npAsNeedsRead();
  if (fp && cur.sig === fp && cur.needs.length) { if (typeof toast === 'function') toast('卖点 / 知识库 / 画面流派没变，清单还是上次那份'); return; }
  _npAsBusy = true;
  renderNoteAssets(container);
  try {
    const r = await chrome.runtime.sendMessage({ action: 'genAssetNeeds', data: {} });
    if (!r || r.ok === false || !Array.isArray(r.needs)) throw new Error((r && r.error) || 'AI 没给出素材清单');
    const prev = cur.needs || [];
    const byTitle = {};
    prev.forEach(n => { if (n && n.title) byTitle[n.title] = n; });
    const merged = r.needs.map(x => {
      const p = byTitle[x.title];
      return {
        id: (p && p.id) || npAsId(),
        title: String(x.title || '').trim(),
        spec: String(x.spec || '').trim(),
        source: String(x.source || '').trim(),
        mark: (p && p.mark) || '',                      // 我标过的「备好了 / 不需要」跟着同名条目走
        createdAt: (p && p.createdAt) || Date.now(),
      };
    });
    prev.forEach(n => { if (n && n.manual && !merged.some(m => m.title === n.title)) merged.push(n); });
    await npAsNeedsWrite({ sig: fp, genAt: Date.now(), needs: merged });
    if (typeof toast === 'function') toast('素材清单已整理好（' + merged.length + ' 条）');
  } catch (e) {
    if (typeof toast === 'function') toast('整理素材失败：' + String((e && e.message) || e), 'error');
  }
  _npAsBusy = false;
  renderNoteAssets(container);
}

async function npAsNeedDelete(container, id) {
  const v = await npAsNeedsRead();
  v.needs = (v.needs || []).filter(x => !(x && x.id === id));
  await npAsNeedsWrite(v);
  renderNoteAssets(container);
}

/* ➕ 新增素材：说明（必填）+ 本机图（先把缩略图攒在 _npAsNewPicked 里），保存时落盘并让 AI 关联知识库 / 卖点 */
async function npAsNewPick(container, files) {
  const arr = Array.prototype.slice.call(files || []).filter(f => f && /^image\//.test(String(f.type || '')));
  if (!arr.length) { if (typeof toast === 'function') toast('选的是图片文件吗？', 'error'); return; }
  let bad = '';
  for (const f of arr) {
    try {
      const t = await npAsThumb(f);
      _npAsNewPicked.push({ name: String(f.name || '本机图'), thumb: t.thumb, w: t.w, h: t.h });
    } catch (e) { bad = String((e && e.message) || e); }
  }
  if (bad && typeof toast === 'function') toast('有图没读进来：' + bad, 'error');
  renderNoteAssets(container);
}

/** 按说明问一次 AI：这条素材对得上哪个知识库条目 / 卖点（对不上就空着，行里会留「关联」再试） */
async function npAsAskAssoc(desc, fileName) {
  try {
    const r = await chrome.runtime.sendMessage({ action: 'assocAsset', data: { desc, fileName } });
    if (r && r.ok) return { kb: r.kb || [], sell: r.sell || [], hint: r.hint || '' };
    return { kb: [], sell: [], hint: '', err: (r && r.error) || 'AI 没给出关联' };
  } catch (e) { return { kb: [], sell: [], hint: '', err: String((e && e.message) || e) }; }
}

async function npAsNewSubmit(container) {
  if (_npAsBusy) return;
  const desc = String(_npAsNewDesc || '').trim();
  if (!desc) { if (typeof toast === 'function') toast('先写素材说明（这条素材是什么）', 'error'); const el = _npEl(container, 'npasAddDesc'); if (el) el.focus(); return; }
  if (!_npAsNewPicked.length) { if (typeof toast === 'function') toast('再选一张本机图（原图不入库，只存缩略图）', 'error'); return; }
  _npAsBusy = true;
  renderNoteAssets(container);
  const needId = npAsId();
  const list = await npAsAssetsRead();
  _npAsNewPicked.forEach((t, i) => {
    list.push({ id: npAsId(), kind: 'local', ref: t.name, name: t.name, thumb: t.thumb, w: t.w, h: t.h, needId, addedAt: Date.now() + i });
  });
  await npAsAssetsWrite(list);
  const link = await npAsAskAssoc(desc, _npAsNewPicked[0].name);
  const v = await npAsNeedsRead();
  v.needs = [{ id: needId, title: npAsShortTitle(desc), spec: desc, source: '自己加的', manual: true, link, createdAt: Date.now() }].concat(v.needs || []);
  await npAsNeedsWrite(v);
  const named = (link.kb || []).length + (link.sell || []).length;
  if (typeof toast === 'function') {
    toast(named ? ('已存下，关联到' + (link.kb || []).map(t => '知识库《' + t + '》').concat((link.sell || []).map(t => '卖点《' + t + '》')).join('、'))
      : (link.err ? ('素材已存下，AI 关联没成（点行里「🔗 关联」再试）：' + link.err) : '素材已存下（没找到对得上的知识库条目，行里可再点「🔗 关联」）'),
      named ? '' : 'error');
  }
  _npAsBusy = false; _npAsNew = false; _npAsNewDesc = ''; _npAsNewPicked = []; _npAsFocus = [];
  renderNoteAssets(container);
}

/** 已经存下的「自己加的」那条：再问一次 AI 关联（首次没关联上 / 知识库后来又加了条目） */
async function npAsReAssoc(container, id) {
  if (_npAsBusy) return;
  const v = await npAsNeedsRead();
  const n = (v.needs || []).find(x => x && x.id === id);
  if (!n) return;
  _npAsBusy = true;
  renderNoteAssets(container);
  n.link = await npAsAskAssoc(n.spec || n.title, ((await npAsAssetsRead()).find(a => a && a.needId === id) || {}).name || '');
  await npAsNeedsWrite(v);
  _npAsBusy = false;
  const named = (n.link.kb || []).length + (n.link.sell || []).length;
  if (typeof toast === 'function') toast(named ? '已关联' : (n.link.err || '还是没找到对得上的知识库条目'), named ? '' : 'error');
  renderNoteAssets(container);
}

/** 说明开头的短句当名目（表里第一列的字），全文还是留在「说明」那列 */
function npAsShortTitle(desc) {
  const s = String(desc || '').split(/[。！？；\n，,：:]/)[0].trim();
  return (s || String(desc || '')).slice(0, 14);
}

async function npAsUpload(container, files) {
  const arr = Array.prototype.slice.call(files || []).filter(f => f && /^image\//.test(String(f.type || '')));
  const needId = _npAsUpNeed || '';
  _npAsUpNeed = '';
  if (!arr.length) { if (typeof toast === 'function') toast('选的是图片文件吗？', 'error'); return; }
  const list = await npAsAssetsRead();
  let ok = 0, bad = '';
  for (const f of arr) {
    try {
      const t = await npAsThumb(f);
      list.push({ id: npAsId(), kind: 'local', ref: String(f.name || '本机图'), name: String(f.name || '本机图'), thumb: t.thumb, w: t.w, h: t.h, needId, addedAt: Date.now() });
      ok++;
    } catch (e) { bad = String((e && e.message) || e); }
  }
  if (ok) await npAsAssetsWrite(list);
  if (ok) _npAsFocus = [];   // 图传上了＝这条已经在办，红框（从档案跳过来的）就该撤了
  if (typeof toast === 'function') toast(ok ? ('已存 ' + ok + ' 张缩略图（原图你自己留好）' + (bad ? '，另 ' + bad : '')) : ('这些没读进来：' + (bad || '不是图片')), ok ? '' : 'error');
  renderNoteAssets(container);
}

async function npAsAssetDelete(container, id) {
  const list = (await npAsAssetsRead()).filter(a => !(a && a.id === id));
  await npAsAssetsWrite(list);
  renderNoteAssets(container);
}

function ensureNpAsDelegation(container) {
  if (_npAsDelegated) return;
  _npAsDelegated = true;
  container.addEventListener('click', function (ev) {
    const t = ev.target;
    if (!t || !t.closest) return;
    const cl = (sel) => t.closest(sel);
    if (t.classList && t.classList.contains('npas-modal')) {   // 点弹窗外面的灰底＝关掉
      _npAsNew = false; _npAsNewDesc = ''; _npAsNewPicked = []; renderNoteAssets(container); return;
    }
    if (cl('.npas-gen')) { npAsGen(container); return; }
    if (cl('.npas-new-open')) { _npAsNew = true; renderNoteAssets(container); return; }
    if (cl('.npas-new-cancel')) { _npAsNew = false; _npAsNewDesc = ''; _npAsNewPicked = []; renderNoteAssets(container); return; }
    if (cl('.npas-new-save')) { npAsNewSubmit(container); return; }
    if (cl('.npas-new-pick')) { const fi = _npEl(container, 'npasNewFile'); if (fi) { fi.value = ''; fi.click(); } return; }
    const unp = cl('.npas-new-unpick');
    if (unp) { _npAsNewPicked.splice(parseInt(unp.getAttribute('data-i'), 10) || 0, 1); renderNoteAssets(container); return; }
    const up = cl('.npas-up');
    if (up) { _npAsUpNeed = up.getAttribute('data-id') || ''; const fi = _npEl(container, 'npasFile'); if (fi) { fi.value = ''; fi.click(); } return; }
    if (cl('.npas-assoc')) { npAsReAssoc(container, cl('.npas-assoc').getAttribute('data-id') || ''); return; }
    const nd = cl('.npas-need-del'); if (nd) { npAsNeedDelete(container, nd.getAttribute('data-id') || ''); return; }
    const ad = cl('.npas-asset-del'); if (ad) { npAsAssetDelete(container, ad.getAttribute('data-id') || ''); return; }
  });
  container.addEventListener('change', function (ev) {
    const t = ev.target;
    if (!t) return;
    if (t.id === 'npasFile') npAsUpload(container, t.files);
    else if (t.id === 'npasNewFile') npAsNewPick(container, t.files);
  });
  container.addEventListener('input', function (ev) {
    const t = ev.target;
    if (t && t.id === 'npasAddDesc') _npAsNewDesc = String(t.value || '');
  });
}

async function renderNoteAssets(container) {
  if (!container) return;
  ensureNpAsDelegation(container);
  const v = await npAsNeedsRead();
  const assets = await npAsAssetsRead();
  const notes = (typeof npNotesAll === 'function') ? await npNotesAll() : [];
  await npLoadImgMotifs();                     // 🎭 来源名要认得账号自加的那几派
  const { sell: sellImgs, kb: kbImgs, sellTitles, kbTitles, defMotif } = await npAsImgIndex();
  const sellImgN = Object.keys(sellImgs).length, kbImgN = Object.keys(kbImgs).length;

  const thumbImg = (src, size) => '<img src="' + npArAttr(src) + '" alt="" style="flex:none;width:' + size + 'px;height:' + size + 'px;object-fit:cover;border-radius:6px;border:1px solid #eee;">';
  const ph = (size, ic) => '<div style="flex:none;width:' + size + 'px;height:' + size + 'px;border-radius:6px;border:1px dashed var(--line);background:#fafbfc;display:flex;align-items:center;justify-content:center;font-size:' + Math.round(size * 0.45) + 'px;">' + ic + '</div>';

  // 逐条：算清「它现在挂了几张」（我传的 + 现成引用）、状态、用在哪（自己加的按 AI 关联的知识库 / 卖点对）
  const rows = (v.needs || []).map(n => {
    const from = npAsFrom(n.source, sellTitles, kbTitles);
    const mine = assets.filter(a => a && a.needId === n.id);
    const auto = [];
    if (from.type === 'sell' && sellImgs[from.name]) auto.push({ virtual: true, kind: 'sell', ref: from.name, thumb: sellImgs[from.name] });
    if (from.type === 'kb' && kbImgs[from.name]) auto.push({ virtual: true, kind: 'kb', ref: from.name, thumb: kbImgs[from.name] });
    const got = mine.length + auto.length;
    const st = npAsNeedState(n, got);
    let usedBy = npAsUsedBy(from, notes, defMotif);
    if (n.manual && n.link) {
      (n.link.kb || []).forEach(t => { usedBy = usedBy.concat(npAsUsedBy({ type: 'kb', name: t }, notes)); });
      (n.link.sell || []).forEach(t => { usedBy = usedBy.concat(npAsUsedBy({ type: 'sell', name: t }, notes)); });
      usedBy = usedBy.filter((x, i, a) => a.indexOf(x) === i);
    }
    return { n, from, mine, auto, got, want: st.want, state: st.state, usedBy };
  });
  const done = rows.filter(r => r.state === '已有').length;

  const miniBtn = (cls, label, idA, title) => '<button type="button" class="' + cls + ' npas-mini"' + idA + (title ? ' title="' + npArAttr(title) + '"' : '') + '>' + label + '</button>';

  // 一条素材一张卡（弹窗只有 640px，5 列表格会把「要什么 / 来源 / 用在哪」挤成看不见：
  // 所以标题行只放 缩略图 + 标题 + 状态/来源 + 操作，说明与进度各占整行，不再截字）
  const card = (r) => {
    const n = r.n;
    const idA = 'data-id="' + npArAttr(n.id) + '"';
    const focus = _npAsFocus.indexOf(n.id) >= 0;   // 从档案点「还缺 N 张」跳过来的那几条：描红，别让用户自己找
    const stColor = { '待备': ['#b45309', '#fff7e6'], '已有': ['#2e7d32', '#eaf6ec'] }[r.state];
    const badges = r.mine.concat(r.auto).slice(0, 4);
    const thumbs = badges.map(a => thumbImg(a.thumb, 34)).join('') + (badges.length ? '' : ph(34, n.manual ? '📷' : '🖼'));
    const spec = String(n.spec || '');
    // 来源 / 关联：AI 整理出来的写来源；自己加的写 AI 关联到的知识库 / 卖点（没关联上留个重试的口）
    let fromCell, unlinked = false;
    if (n.manual) {
      const kb = (n.link && n.link.kb) || [], sl = (n.link && n.link.sell) || [];
      if (kb.length || sl.length) {
        fromCell = kb.map(t => '知识库「' + esc(t) + '」').concat(sl.map(t => '卖点「' + esc(t) + '」')).join(' · ');
      } else { fromCell = '<span style="color:#b45309;">未关联</span>'; unlinked = true; }
    } else {
      fromCell = r.from.type ? ({ sell: '卖点', kb: '知识库', motif: '画面流派', form: '旧形式' }[r.from.type] + '「' + esc(r.from.name) + '」') : esc(n.source || '—');
    }
    const used = r.usedBy.length ? ('《' + esc(r.usedBy[0]) + '》' + (r.usedBy.length > 1 ? ' 等 ' + r.usedBy.length + ' 篇' : '')) : '还没用在笔记上';
    // 进度 · 用在哪 直接跟标题一行（原来单占一行，卡里三行说明太长；标题旁一眼看得到）
    const prog = (r.want ? '要有 ' + r.want + ' 张 · 已有 ' + r.got + ' 张' : (r.got ? '已挂 ' + r.got + ' 张' : '还没传图')) +
      ' ｜ 用在哪：' + used;
    return '<div class="npas-card' + (focus ? ' npas-focus' : '') + '">' +
      '<div class="npas-c-head">' +
        '<div class="npas-c-thumbs">' + thumbs + '</div>' +
        '<div class="npas-c-main">' +
          '<div class="npas-c-title">' + esc(n.title) + (n.manual ? ' <span class="npas-c-chip" style="color:#6b7280;background:#f3f4f6;">自己加的</span>' : '') +
            '<span class="npas-c-prog">' + prog + '</span></div>' +
          '<div class="npas-c-meta">' +
            '<span class="npas-c-chip" style="color:' + stColor[0] + ';background:' + stColor[1] + ';">' + r.state + '</span>' +
            '<span>' + fromCell + '</span>' + (unlinked ? ' ' + miniBtn('npas-assoc', '🔗 关联', idA, '按素材说明让 AI 关联知识库 / 卖点') : '') +
          '</div>' +
        '</div>' +
        '<div class="npas-c-act">' +
          miniBtn('npas-up', '📁 传本机图', idA, '只存 ≤160px 缩略图 + 文件名，原图不入库') +
          miniBtn('npas-need-del', '×', idA, '从这张表里删掉（再点「AI 整理素材」会按卖点 / 知识库重新整理）') +
        '</div>' +
      '</div>' +
      (spec ? '<div class="npas-c-line npas-c-spec">要什么：<span class="npas-spec" ' + idA + ' data-text="' +
          npArAttr(n.manual ? spec : (n.title + '：' + spec)) + '">' + esc(spec) + '</span></div>' : '') +
      (r.mine.length ? '<div class="npas-c-foot">本机图：' + r.mine.map(a => esc(a.name) +
        '<button type="button" class="npas-asset-del" data-id="' + npArAttr(a.id) + '" title="删掉这条记录（不影响你本机的原图）" style="border:none;background:none;color:#c02;cursor:pointer;font-size:11px;padding:0 0 0 3px;">×</button>').join('、') + '</div>' : '') +
      ((n.link && n.link.hint) ? '<div class="npas-c-foot">AI 关联依据：' + esc(n.link.hint) + '</div>' : '') +
      '</div>';
  };

  const empty = '这张表还是空的——点「🤖 AI 整理素材」：AI 按你现在的卖点 + 知识库 + 画面流派（要备料的那几派）列出「要备哪些图」；手上已经有图，就直接「➕ 新增素材」。';

  const modal = !_npAsNew ? '' :
    '<div class="npas-modal" title="点空白处关掉" style="position:fixed;inset:0;background:rgba(15,20,30,.35);display:flex;align-items:center;justify-content:center;z-index:9998;">' +
      '<div style="width:470px;max-width:92vw;background:#fff;border-radius:12px;padding:16px 18px;box-shadow:0 14px 44px rgba(0,0,0,.22);">' +
        '<div style="font-weight:700;font-size:14px;color:#333;">➕ 新增素材</div>' +
        '<div style="font-size:11px;color:#8a929e;line-height:1.6;margin:6px 0 10px;">写清这条素材是什么，AI 会按说明把它关联到知识库条目 / 卖点。图片只存一张 ≤160px 缩略图 + 文件名，原图你自己留好。</div>' +
        '<textarea id="npasAddDesc" rows="3" maxlength="300" placeholder="素材说明（必填）：拍的是什么 / 截的是哪个界面 / 画面里有什么…" style="width:100%;box-sizing:border-box;padding:7px 9px;border:1px solid var(--line);border-radius:8px;font-size:12px;font-family:inherit;line-height:1.6;resize:vertical;">' + esc(_npAsNewDesc) + '</textarea>' +
        '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;">' +
          '<button type="button" class="npas-new-pick" style="border:1px solid var(--line);background:#fff;color:#555;border-radius:8px;font-size:12px;padding:5px 10px;cursor:pointer;">📁 选本机图</button>' +
          '<span style="font-size:11px;color:#9aa0ac;">' + (_npAsNewPicked.length ? '已选 ' + _npAsNewPicked.length + ' 张（原图不入库，只存缩略图）' : '说明 + 一张图就能存') + '</span>' +
        '</div>' +
        (_npAsNewPicked.length ? '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">' + _npAsNewPicked.map((t, i) =>
          '<span style="position:relative;display:inline-block;" title="' + npArAttr(t.name) + '">' + thumbImg(t.thumb, 54) +
            '<button type="button" class="npas-new-unpick" data-i="' + i + '" title="去掉这张" style="position:absolute;top:-6px;right:-6px;border:none;background:#c02;color:#fff;border-radius:50%;width:16px;height:16px;line-height:15px;font-size:11px;cursor:pointer;padding:0;">×</button>' +
          '</span>').join('') + '</div>' : '') +
        '<div style="display:flex;justify-content:flex-end;gap:8px;align-items:center;margin-top:16px;">' +
          '<button type="button" class="npas-new-cancel" style="border:1px solid var(--line);background:#fff;color:#555;border-radius:8px;font-size:12px;padding:6px 12px;cursor:pointer;">取消</button>' +
          '<button type="button" class="npas-new-save"' + ((_npAsBusy || !_npAsNewPicked.length) ? ' disabled' : '') + ' style="border:none;border-radius:8px;background:' + ((_npAsBusy || !_npAsNewPicked.length) ? 'var(--c-brand-line)' : 'var(--grad-brand)') + ';color:#fff;font-size:12px;font-weight:700;padding:6px 12px;cursor:' + ((_npAsBusy || !_npAsNewPicked.length) ? 'default' : 'pointer') + ';">' + (_npAsBusy ? '⏳ AI 正在关联…' : '存下并关联') + '</button>' +
        '</div>' +
      '</div>' +
    '</div>';

  container.innerHTML =
    '<div style="padding:6px 2px;">' +
      '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px;">' +
        '<div style="font-weight:600;color:var(--ink);font-size:13px;">📚 素材库<span class="qhelp" tabindex="0" data-tip="AI 按你的卖点 × 知识库 × 画面流派（只有要备料的那几派进来）列出「要备哪些素材」，备齐就点行里的「📁 传本机图」；手上已经有的图，用「➕ 新增素材」写一句说明传进来，AI 会顺手关联到知识库。">?</span></div>' +
        '<span style="font-size:11px;color:#8a929e;">共 ' + rows.length + ' 条 · 已备齐 ' + done + ' 条</span>' +
        (_npAsFocus.length ? '<span style="font-size:11px;color:#b45309;">从档案跳过来的那 ' + _npAsFocus.length + ' 条在下面（红框）</span>' : '') +
      '</div>' +
      '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px;">' +
        '<button type="button" class="npas-gen"' + (_npAsBusy ? ' disabled' : '') + ' style="padding:6px 12px;border:none;border-radius:8px;background:var(--grad-brand);color:var(--c-brand-on);font-size:12px;font-weight:700;cursor:pointer;">' + (_npAsBusy ? '⏳ 正在整理…' : '🤖 AI 整理素材') + '</button>' +
        '<button type="button" class="npas-new-open" style="padding:6px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;color:#333;font-size:12px;font-weight:600;cursor:pointer;">➕ 新增素材</button>' +
        (v.genAt ? '<span style="font-size:11px;color:#9aa0ac;">上次整理：' + esc(npArAgo(v.genAt)) + '</span>' : '') +
      '</div>' +
      (rows.length
        ? '<div class="npas-list">' + rows.map(card).join('') + '</div>'
        : '<div style="font-size:12px;color:#999;padding:12px 0;line-height:1.7;">' + empty + '</div>') +
      '<div style="font-size:11px;color:#8a929e;line-height:1.6;margin-top:10px;">配图只存引用：卖点 / 知识库里现成的（' + sellImgN + ' 张 / ' + kbImgN + ' 张）直接用、不用重复备；本机图只留缩略图，原图你自己保管。</div>' +
      '<input id="npasFile" type="file" accept="image/*" multiple hidden>' +
      '<input id="npasNewFile" type="file" accept="image/*" multiple hidden>' +
    '</div>' + modal;
  if (_npAsFocus.length) { const el = container.querySelector('.npas-focus'); if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center' }); }
}

/** 轻提示：右下角浮一条，2 秒后自己淡掉（复制成功 / 档位不够这类即时反馈都走它） */
function toast(msg, kind) {
  try {
    let box = document.getElementById('popToastBox');
    if (!box) {
      box = document.createElement('div');
      box.id = 'popToastBox';
      box.style.cssText = 'position:fixed;right:16px;bottom:16px;display:flex;flex-direction:column;gap:6px;z-index:99999;pointer-events:none;';
      document.body.appendChild(box);
    }
    const el = document.createElement('div');
    el.textContent = String(msg || '');
    el.style.cssText = 'max-width:300px;padding:8px 12px;border-radius:8px;font-size:12px;line-height:1.6;color:#fff;background:' +
      (kind === 'error' ? '#d32f2f' : '#333') + ';box-shadow:0 4px 14px rgba(0,0,0,.18);opacity:0;transition:opacity .15s;';
    box.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; });
    setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 200); }, 2200);
  } catch (_) {}
}

async function copyToClipboard(text) {
  if (!text) return;
  if (navigator.clipboard && navigator.clipboard.writeText) {
    await navigator.clipboard.writeText(text);
  } else {
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); ta.remove();
  }
}

// 左侧笔记列表 + 拖拽分隔条显隐（评论跟进 Tab 下不需要）
function _setPanelLeftVisible(visible) {
  const pl = document.getElementById('panelLeft');
  const dv = document.getElementById('divider');
  if (pl) pl.style.display = visible ? '' : 'none';
  if (dv) dv.style.display = visible ? '' : 'none';
}

// 工具栏「📤 自动评论 / 🔄 评论刷新」按当前 Tab 绑定不同功能：
//   评论助手 = 原功能（当前笔记页）；评论跟进 = 通知页全部回复 / 通知页重新同步
let _followBatchBtn = null, _followRefreshBtn = null;
let _plRefreshBtn = null, _plSettingsBtn = null;

/* ── 找商机：这批商机评论按什么目的写（打法优先级见 background PURPOSE_META） ──
   数据仍落 product.commentPurpose，扫描时由 background 解析成打法倾向。 */
var PURPOSE_OPTS = [
  ['sell', '🛍️ 卖产品（获客转化）'],
  ['brand', '🏷️ 品牌种草（信任/口碑）'],
  ['profile', '👤 主页涨粉（引流主页）'],
  ['likes', '👍 互动涨赞（提升活跃）'],
  ['trend', '🔥 蹭热点（借话题/大V）'],
  ['auto', '🧩 综合自动（每条看菜下饭）'],
];
async function initPurposeBar() {
  const sel = document.getElementById('purposeSel');
  if (!sel) return;
  if (!sel.options.length) {
    sel.innerHTML = PURPOSE_OPTS.map(p => '<option value="' + p[0] + '">' + esc(p[1]) + '</option>').join('');
  }
  try {
    const cfg = await readConfigPlain();
    const p = cfg.product || {};
    const cur = p.commentPurpose || (cfg.scriptStyle && cfg.scriptStyle.scriptPurpose) || 'sell';
    sel.value = PURPOSE_OPTS.some(x => x[0] === cur) ? cur : 'sell';
  } catch (_) {}
  sel.onchange = async () => {
    const msg = document.getElementById('purposeMsg');
    try {
      const cfg = await readConfigPlain();
      cfg.product = cfg.product || {};
      cfg.product.commentPurpose = sel.value || 'sell';
      if (cfg.scriptStyle) delete cfg.scriptStyle.scriptPurpose;   // 写过新字段就清掉旧字段，避免两处取值打架
      await _diagSaveCfg(cfg);
      if (msg) { msg.textContent = '✅ 已保存，下次扫描生效'; setTimeout(() => { if (msg.textContent.indexOf('已保存') >= 0) msg.textContent = ''; }, 2000); }
    } catch (e) { if (msg) msg.textContent = '保存失败：' + (e.message || e); }
  };
}

function _setToolbarMode(mode) {
  const group = document.getElementById('commentBtnGroup');
  const refresh = document.getElementById('refreshBtn');
  if (!group) return;
  const isComment = (mode === 'comment');
  group.style.display = isComment ? '' : 'none';
  if (refresh) refresh.style.display = isComment ? '' : 'none';
  // 评论目的（找商机用）：只在获客助手出现，切回来自动同步最新配置
  const bar = document.getElementById('purposeBar');
  if (bar) bar.style.display = isComment ? '' : 'none';
  if (isComment) initPurposeBar();
  if (mode === 'prospectList') {
    if (!_plRefreshBtn) {
      _plRefreshBtn = document.createElement('button');
      _plRefreshBtn.className = 'refresh-btn';
      _plRefreshBtn.textContent = '🔄 刷新清单';
      _plRefreshBtn.title = '重新加载用户清单';
      _plRefreshBtn.addEventListener('click', () => {
        const pc = document.getElementById('prospectContent');
        if (pc) loadProspectList(pc);
      });
      _plSettingsBtn = document.createElement('button');
      _plSettingsBtn.className = 'refresh-btn';
      _plSettingsBtn.textContent = '⚙️ 收录设置';
      _plSettingsBtn.title = '设置收录关键词（命中即入库）';
      _plSettingsBtn.style.marginLeft = '4px';
      _plSettingsBtn.addEventListener('click', () => editTargetKeywords());
      refresh.parentNode.appendChild(_plRefreshBtn);
      refresh.parentNode.appendChild(_plSettingsBtn);
    }
    _plRefreshBtn.style.display = '';
    _plSettingsBtn.style.display = '';
    if (_followBatchBtn) _followBatchBtn.style.display = 'none';
    if (_followRefreshBtn) _followRefreshBtn.style.display = 'none';
  } else if (mode === 'chatFollow') {
    if (!_followBatchBtn) {
      _followBatchBtn = document.createElement('button');
      _followBatchBtn.className = 'batch-send-btn';
      _followBatchBtn.textContent = '🤖 通知页全部回复';
      _followBatchBtn.title = '在通知页自动回复所有待回复会话：AI 生成 → 自动发送 → 3~8 秒随机间隔';
      _followBatchBtn.addEventListener('click', () => {
        const fc = document.getElementById('chatFollowContent');
        if (fc) batchChatFollowReply(fc);
      });
      _followRefreshBtn = document.createElement('button');
      _followRefreshBtn.className = 'refresh-btn';
      _followRefreshBtn.textContent = '🔄 通知页刷新';
      _followRefreshBtn.title = '重新从通知页提取通知流并重组会话';
      _followRefreshBtn.addEventListener('click', () => {
        const fc = document.getElementById('chatFollowContent');
        if (fc) loadChatFollow(fc);
      });
      refresh.parentNode.appendChild(_followBatchBtn);
      refresh.parentNode.appendChild(_followRefreshBtn);
    }
    _followBatchBtn.style.display = '';
    _followRefreshBtn.style.display = '';
    if (_plRefreshBtn) _plRefreshBtn.style.display = 'none';
    if (_plSettingsBtn) _plSettingsBtn.style.display = 'none';
  } else {
    if (_followBatchBtn) _followBatchBtn.style.display = 'none';
    if (_followRefreshBtn) _followRefreshBtn.style.display = 'none';
    if (_plRefreshBtn) _plRefreshBtn.style.display = 'none';
    if (_plSettingsBtn) _plSettingsBtn.style.display = 'none';
  }
}

// 重渲染评论跟进列表（发送/标记/批量完成后调用）
async function reloadChatFollow() {
  const fc = document.getElementById('chatFollowContent');
  if (fc && fc.style.display !== 'none') await loadChatFollow(fc);
}

/* ═══════════ 小窗评论助手：三分屏 （StepFlow） ═══════════ */
// 屏1：笔记列表（左栏全宽）→ 屏2：单篇进度 → 屏3：逐条评论处理
const StepFlow = {
  note: null,          // 当前选中的笔记
  prospects: [],       // 当前笔记的商机（一次一条）
  pos: 0,              // 屏3 当前处理位置
  list: [],            // 屏3 待处理队列（优先商机）
  running: false,

  // 进入屏1：左栏全宽
  enterStep1() {
    const layout = document.querySelector('.split-layout');
    if (!layout) return;
    layout.classList.remove('step2', 'step3');
    layout.classList.add('step1');
    document.getElementById('stepBar')?.remove();
    // 让左栏可见、右栏隐藏
    _setPanelLeftVisible(true);
    const right = document.querySelector('.panel-right');
    if (right) right.style.display = '';
    const mc = document.getElementById('mainContent');
    if (mc) mc.innerHTML = '';
  },

  // 进入屏2：单篇进度
  async enterStep2(note) {
    this.note = note || this.note || {};
    const layout = document.querySelector('.split-layout');
    if (!layout) return;
    layout.classList.remove('step1', 'step3');
    layout.classList.add('step2');
    _setPanelLeftVisible(false);
    // 构建待处理队列：优先商机，其次全部未回复评论
    await this._buildQueue();
    this._renderStep2();
    this._publish();
  },

  async _buildQueue() {
    this.prospects = pageData?.prospects || [];
    // 商机优先
    this.list = this.prospects.slice();
    // 若没有商机，退回全部未回复评论
    if (this.list.length === 0 && pageData?.comments) {
      this.list = pageData.comments.map((c, i) => ({
        index: i,
        author: c.author,
        original_comment: c.content,
        suggested_copies: [''], // 空话术，手动填
        userLink: c.userLink || '',
      }));
    }
    this.pos = 0;
  },

  _renderStep2() {
    const total = this.list.length;
    const done = this.prospects.filter(p => p._sent).length;
    const doneTotal = (pageData?.comments?.length || 0);
    const mc = document.getElementById('mainContent');
    if (!mc) return;
    const title = (this.note?.title || '当前笔记').slice(0, 40);
    mc.innerHTML = `
      <div class="step-bar">
        <button class="back-link" id="step2Back">← 列表</button>
        <span class="step-title">📄 ${esc(title)}</span>
        <span class="step-progress" id="step2Prog">${done}/${doneTotal} 已处理</span>
      </div>
      <div class="step-panel">
        <div class="step2-stats">
          <div class="step2-stat" style="color:#333;"><div class="num">${total}</div><div class="lbl">本篇评论</div></div>
          <div class="step2-stat amber"><div class="num">${total - done}</div><div class="lbl">待处理</div></div>
          <div class="step2-stat green"><div class="num">${done}</div><div class="lbl">已处理</div></div>
        </div>
        <button class="step2-start-btn" id="step2Start" ${total === 0 ? 'disabled' : ''}>🎯 开始逐条处理（${total} 条）</button>
        <div style="font-size:11px;color:#888;margin-top:10px;text-align:center;">优先处理 AI 判定为商机的评论${this.prospects.filter(p => p.same_city === true).length ? ` · 其中 🏙 同城 ${this.prospects.filter(p => p.same_city === true).length} 条` : ''}</div>
      </div>`;
    document.getElementById('step2Back')?.addEventListener('click', () => {
      showEmpty();
      this.enterStep1();
    });
    document.getElementById('step2Start')?.addEventListener('click', () => this.enterStep3());
  },

  // 进入屏3：逐条
  enterStep3() {
    if (this.list.length === 0) return;
    const layout = document.querySelector('.split-layout');
    if (!layout) return;
    layout.classList.remove('step1', 'step2');
    layout.classList.add('step3');
    _setPanelLeftVisible(false);
    this.pos = 0;
    this.running = true;
    this._renderStep3();
    this._publish();
  },

  _renderStep3() {
    if (this.pos >= this.list.length) {
      // 全部完成
      this._publish();
      const mc = document.getElementById('mainContent');
      mc.innerHTML = `
        <div class="step-bar">
          <button class="back-link" id="step3DoneBack">← 返回列表</button>
          <span class="step-title">✅ 全部处理完成</span>
        </div>
        <div style="text-align:center;padding:60px 20px;">
          <div style="font-size:40px;margin-bottom:12px;">🎉</div>
          <div style="font-size:16px;font-weight:700;color:#333;">本篇 ${this.list.length} 条已全部处理</div>
          <div style="font-size:12px;color:#888;margin-top:8px;">去下一篇文章继续？</div>
        </div>`;
      document.getElementById('step3DoneBack')?.addEventListener('click', () => {
        showEmpty();
        this.enterStep1();
      });
      this.running = false;
      return;
    }
    const item = this.list[this.pos];
    this._publish();
    const idx = (item.index !== undefined ? item.index : this.pos);
    const author = item.author || '匿名';
    const quote = String(item.original_comment || item.content || '');
    const copies = (item.suggested_copies && item.suggested_copies.length
      ? item.suggested_copies
      : (item.suggested_copy ? [item.suggested_copy] : [''])
    ).map(c => stripVersionPrefix(String(c || '').trim())).filter(Boolean);
    const labels = (item.copy_labels && item.copy_labels.length ? item.copy_labels : []).map(s => String(s || '').trim());
    const defaultCopy = copies[0] || '';
    const isProspect = !!this.prospects.some(p => p.index === idx || p.author === author);
    // ★ 同城标记：same_city 由 AI 按「我的城市 vs 评论人属地」判定；属地优先读商机条目，兜底读原始评论
    const _matched = this.prospects.find(p => p.index === idx || p.author === author);
    const _loc = String(item.location || ((pageData && pageData.comments && pageData.comments[idx] && pageData.comments[idx].location) || '')).trim();
    const sameCity = !!(_matched && _matched.same_city === true);
    const _locStyle = 'display:inline-block;font-size:10px;padding:1px 6px;border-radius:3px;margin-left:6px;vertical-align:middle;';
    const locChip = sameCity
      ? `<span style="${_locStyle}background:#e3f2fd;color:#1565c0;font-weight:600;">🏙 同城${_loc ? ' · ' + esc(_loc) : ''}</span>`
      : (_loc ? `<span style="${_locStyle}background:#f2f2f2;color:#888;">${esc(_loc)}</span>` : '');

    const mc = document.getElementById('mainContent');
    mc.innerHTML = `
      <div class="step-bar">
        <button class="back-link" id="step3Back">← 进度</button>
        <span class="step-title">${isProspect ? '🎯' : '💬'} ${esc(author)}</span>
        <span class="step-progress">处理中 ${this.pos + 1}/${this.list.length}</span>
      </div>
      <div class="step3-wrap">
        <div class="step3-card">
          <div class="step3-author">@${esc(author)}${locChip}</div>
          <div class="step3-quote">“${esc(quote.slice(0, 200))}${quote.length > 200 ? '…' : ''}”</div>
          <div class="step3-tabs" id="step3Tabs"></div>
          <textarea class="step3-textarea" id="step3Text" placeholder="输入回复内容...">${esc(defaultCopy)}</textarea>
          <div class="step3-flash" id="step3Flash"></div>
          <div class="step3-actions">
            <button class="send" id="step3Send">📤 发送这条</button>
            <button class="copy" id="step3Copy">📋 复制</button>
            <button class="skip" id="step3Skip">⏭ 跳过</button>
          </div>
        </div>
      </div>`;

    // 版本切换
    const tabsBox = document.getElementById('step3Tabs');
    copies.forEach((cp, vi) => {
      const b = document.createElement('button');
      b.className = 'step3-tab' + (vi === 0 ? ' active' : '');
      b.textContent = '版本' + (vi + 1) + (labels && labels[vi] ? ' · ' + labels[vi] : '');
      b.onclick = () => {
        document.querySelectorAll('.step3-tab').forEach(t => t.classList.remove('active'));
        b.classList.add('active');
        document.getElementById('step3Text').value = cp;
      };
      tabsBox.appendChild(b);
    });

    document.getElementById('step3Back')?.addEventListener('click', () => this.enterStep2(this.note));
    document.getElementById('step3Copy')?.addEventListener('click', () => {
      const t = document.getElementById('step3Text');
      if (!t) return;
      navigator.clipboard.writeText(t.value).then(() => {
        this._flash('已复制 ✓');
      }).catch(() => {});
    });
    document.getElementById('step3Skip')?.addEventListener('click', () => { this.pos++; this._publish(); this._renderStep3(); });

    // 发送这条（复用 sendReply 机制）
    document.getElementById('step3Send')?.addEventListener('click', async () => {
      const textarea = document.getElementById('step3Text');
      const replyText = (textarea ? textarea.value : '').trim();
      if (!replyText) { this._flash('⚠️ 请输入回复内容', 'err'); return; }
      const sendBtn = document.getElementById('step3Send');
      sendBtn.disabled = true;
      sendBtn.textContent = '发送中...';
      this._flash('正在发送...', 'warn');
      try {
        const tab = await getTargetTab();
        if (!tab) { this._flash('❌ 不在小红书页面', 'err'); sendBtn.disabled = false; sendBtn.textContent = '📤 发送这条'; return; }
        addLog(`📤 分步：发送给 @${author}...`, 'info');
        const result = await sendTabMessageWithTimeout(tab.id, {
          action: 'sendReply', author, originalText: quote, replyText, commentIdx: idx, userLink: item.userLink || '',
          images: kbImages, humanize: false,
        }, 60000);
        if (result && result.success) {
          try { addLocalReply(pageData?.url || '', author, quote); } catch (_) {}
          const p = this.prospects.find(p => p.index === idx || p.author === author);
          if (p) p._sent = true;
          this._flash('✅ 已发送，自动进入下一条');
          setTimeout(() => { this.pos++; this._publish(); this._renderStep3(); }, 500);
        } else {
          this._flash(`❌ ${(result && result.error) || '发送失败'}`, 'err');
          sendBtn.disabled = false;
          sendBtn.textContent = '📤 发送这条';
        }
      } catch (e) {
        this._flash('⚠️ ' + String(e.message || e), 'err');
        sendBtn.disabled = false;
        sendBtn.textContent = '📤 发送这条';
      }
    });
  },

  _flash(msg, kind) {
    const el = document.getElementById('step3Flash');
    if (!el) return;
    el.textContent = msg;
    el.style.color = kind === 'err' ? '#d32f2f' : kind === 'warn' ? '#ff8f00' : '#2e7d32';
  },

  // 供外部：笔记打开后进入屏2（小窗模式）
  async activateForNote(note, onSmall) {
    if (!onSmall) return;
    await this.enterStep2(note);
  },
  reset() {
    this.note = null; this.prospects = []; this.pos = 0; this.list = []; this.running = false;
  },

  // ★ 把当前处理状态发布到 storage，供小窗「只读状态卡」读取
  _publish() {
    const st = {
      ts: Date.now(),
      note: this.note ? (this.note.title || '') : '',
      stage: this.running ? 'processing' : (this.list.length ? 'ready' : 'idle'),
      total: this.list.length,
      done: this.prospects ? this.prospects.filter(p => p._sent).length : 0,
      pos: Math.min(this.pos + 1, Math.max(this.list.length, 1)),
      author: (this.list[this.pos] || {}).author || '',
    };
    try { chrome.storage.local.set({ _step_status: st }); } catch (_) {}
  },
};

// 大窗：打开笔记或分步变化时，把状态发布给小窗
function publishStepStatus(note, stageExtra) {
  try {
    const noteTitle = (pageData && (pageData.title || (pageData.noteData && pageData.noteData.title))) || (note ? (note.title || '') : '');
    const st = {
      ts: Date.now(),
      note: noteTitle,
      stage: stageExtra || (pageData && pageData.prospects ? 'ready' : 'processing'),
      total: (pageData && pageData.comments ? pageData.comments.length : 0),
      done: (pageData && pageData.prospects ? pageData.prospects.filter(p => p._sent).length : 0),
      pos: 0,
      author: '',
    };
    chrome.storage.local.set({ _step_status: st });
    return st;
  } catch (_) { return null; }
}

// 小窗：评论助手 tab 初始进入屏1（小窗状态卡模式不再走分步交互，保留此函数兼容）
function initStepFlow() {
  if (MODE_BIG) return;
  const layout = document.querySelector('.split-layout');
  if (layout) { layout.classList.add('step1'); }
}

/* ═══════════ 小窗只读状态卡 ═══════════ */
function renderStepStatusCard() {
  const mc = document.getElementById('mainContent');
  if (!mc) return;
  chrome.storage.local.get('_step_status', (r) => {
    const st = (r && r._step_status) || null;
    if (!st) {
      // 大窗尚未开始处理 → 显示引导
      mc.innerHTML = `
        <div style="text-align:center;padding:40px 24px;">
          <div style="font-size:38px;margin-bottom:12px;">🖥️</div>
          <div style="font-size:15px;font-weight:700;color:#333;margin-bottom:8px;">小蝉书助手 · 大窗已开启</div>
          <div style="font-size:12px;color:#888;line-height:1.8;">处理在大窗进行，本窗口实时同步状态</div>
          <button class="step2-start-btn" id="goBigBtn" style="margin-top:18px;">🚀 切换到大窗</button>
        </div>`;
      wireGoBig();
      return;
    }
    const prog = st.total ? Math.round((st.pos / st.total) * 100) : 0;
    const stageText =
      (st.stage === 'processing') ? '⏳ 正在处理评论' :
      (st.stage === 'ready') ? '✅ 待开始逐条' : '⛔ 空闲';
    mc.innerHTML = `
      <div style="padding:20px 22px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
          <span style="font-size:14px;font-weight:700;color:#333;">🖥️ 大窗状态</span>
          <button id="goBigBtn" style="padding:5px 12px;font-size:11px;background:var(--xhs-red);color:var(--c-brand-on);border:none;border-radius:8px;cursor:pointer;font-weight:600;">↗ 切换到大窗</button>
        </div>
        <div style="background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px;box-shadow:var(--shadow);">
          <div style="font-size:12px;color:#888;">当前笔记</div>
          <div style="font-size:14px;font-weight:600;color:#222;margin:4px 0 14px;word-break:break-all;">${esc(st.note || '（无）')}</div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
            <div style="font-size:20px;font-weight:700;color:var(--xhs-red);">${st.pos}/${st.total}</div>
            <div style="flex:1;height:8px;background:#f0f0f2;border-radius:4px;overflow:hidden;">
              <div style="height:100%;width:${prog}%;background:var(--grad-red);border-radius:4px;transition:width .3s;"></div>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:11px;color:#888;">
            <span>${stageText}</span>
            <span>已处理 ${st.done} · 完成 ${prog}%</span>
          </div>
        </div>
        <div style="text-align:center;font-size:11px;color:#bbb;margin-top:10px;">状态每 2 秒刷新 · ${new Date(st.ts).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</div>
      </div>`;
    wireGoBig();
  });
}

function wireGoBig() {
  const btn = document.getElementById('goBigBtn');
  if (btn) btn.addEventListener('click', () => {
    chrome.runtime.sendMessage({ action: 'openBigWindow', senderTab: null }).catch(() => {});
  });
}

// 小窗：周期性轮询状态
function startStatusPolling() {
  if (MODE_BIG) return;
  renderStepStatusCard();
  setInterval(renderStepStatusCard, 2000);
}

/* ═══════════ 获客清单模块（v2 · 销售管线：线索/商机/客户） ═══════════ */
const PL_PAGE_SIZE = 50;
let _plFilter = { keyword: '' };                             // 搜索
let _plFilter2 = { channel: '', touch: [], related: '' }; // 渠道 / 状态多选 / 是否相关
let _plShowDiscarded = false;                                 // 已废弃(回收站)视图：🗑 标废的可在此恢复/彻底删
let _plPage = 0;
let _plData = { list: [], allTags: [], fullList: [] };
let _plStage = 'notif'; // 当前页：notif(通知) / msg(消息)，由左栏二级切
let _plChannelSel = ''; // 通知页的渠道筛选：''全部 / comment / like / follow / ai
let _currentShown = []; // 当前 tab 渲染出来的那批（批量触达/生成话术作用于它，而非全量）

// 意向色点
function _plDot(intent) {
  const cls = intent === 'high' ? 'high' : (intent === 'medium' ? 'medium' : 'low');
  return `<span class="pl-dot ${cls}" title="意向：${intent || '未画像'}"></span>`;
}
function _intentLabel(v) { return v === 'high' ? '高' : v === 'medium' ? '中' : v === 'low' ? '低' : ''; }

// ── v2 字段访问器（二级管线：lead / prospect）──
const _plGetStage = p => (p && p.stage) || 'lead';
const _plFunnel = p => (p && p.funnel) || { step: 'pending', dmCount: 0, lastDmAt: null };
// ★ 双桶：msg=消息(对方进线/有往来会话)；notif=通知(没进线)。
//   ★ 我"主动触达"过的通知线索不因建了会话就跳到消息桶——等对方回了(进线)才算消息；没回的就留在通知里显示"已触达/待回复"
const _plBucket = p => {
  if (!p) return 'notif';
  if (p.inbound || p.direction === 'inbound' || (p.source && p.source.stageEntry === '消息')) return 'msg';
  return 'notif';
};
// ★ 同一个人跨渠道/跨桶的全部记录 id（userId 相同 或 昵称相同，排除未知用户）→ 状态/触达按人全局同步（双向）
function _samePersonIds(person) {
  if (!person || !person.id) return [];
  const out = new Set();
  const uid = person.userId ? String(person.userId).toLowerCase() : '';
  const nick = person.nickname ? String(person.nickname).replace(/\s+/g, '').toLowerCase() : '';
  const hasNick = !!(nick && nick !== '未知用户' && nick !== 'unknownuser');
  for (const q of (_plData.list || [])) {
    if (!q || !q.id || q.id === person.id) continue;
    const qu = q.userId ? String(q.userId).toLowerCase() : '';
    const qn = q.nickname ? String(q.nickname).replace(/\s+/g, '').toLowerCase() : '';
    const shareUid = uid && qu && uid === qu;
    const shareNick = hasNick && qn && qn === nick && qn !== '未知用户';
    if (shareUid || shareNick) out.add(q.id);
  }
  return Array.from(out);
}
const _isOutbound = p => p.direction === 'outbound' || (!p.direction && !p.inbound && !!p.convId);
const _plEntry = p => ((p && p.source && p.source.stageEntry) || '');

// ★ 渠道：和"来源"字段对应 —— 评论 / 点赞&收藏 / 关注 / AI
const _plChannel = p => {
  const e = _plEntry(p) || ((p && p.signalType) || '');
  if (e === '关注') return '关注';
  if (e === '点赞' || e === '收藏') return '赞藏';
  if (e === '回复' || e === '评论' || e === '互动') return '评论';
  if (e === 'AI路由' || e === '关键词命中' || e === '评论跟进') return 'AI';
  return '';
};

// ★ 触达标识：未触达 / 已触达 / 待回复 / 已转商机（优先级 商机 > 待回复 > 已触达 > 未触达）
function _plTouchState(p) {
  const st = _plGetStage(p);
  if (st === 'prospect' || p.convId || p.inbound || p.themReplied) return 'prospect';
  if (p.awaitingReply) return 'awaiting';
  if (_isOutbound(p) || p.dmStatus === 'sent') return 'touched';
  return 'untouched';
}

// ═══ 统一状态模型（6 档）═══
const PL_STATUS_ALL = ['待触达', '已触达', '谈单中', '流失中', '已成交', '已废弃'];
const STATUS_RANK = { '待触达': 1, '已触达': 2, '谈单中': 3, '流失中': 4, '已成交': 5, '已废弃': 6 };
const STATUS_RANK_REV = { 1: '待触达', 2: '已触达', 3: '谈单中', 4: '流失中', 5: '已成交', 6: '已废弃' };
// 旧数据迁移：历史「已回复」按「谈单中」显示（不改底层值）
function _rawStatusOf(p) { const s = (p && p.status) || ''; return (s === '已回复') ? '谈单中' : s; }
const _isMsgRecord = p => _plBucket(p) === 'msg';
// 流失中：该人已达「已触达/谈单中」这一级（已确认联系），且最后一条消息距今 ≥3 天、对方未回（等对方回）
function _isLost(q) {
  if (!(q.awaitingReply) && q.lastFrom !== 'me' && !_isOutbound(q)) return false; // 不在等对方回 → 不算流失
  const raw = (q.lastConvFp && q.lastConvFp.at);
  let t = 0;
  if (typeof raw === 'number') t = raw;
  else if (raw) { t = Date.parse(String(raw)); if (isNaN(t)) t = 0; }
  if (!t) return false;
  return (Date.now() - t) >= 3 * 24 * 3600 * 1000;
}
// ★ 一个人的「有效状态」：取该人所有记录里最高优先（跨渠道跨桶统一；流失中为时间派生）
// 该人是否在消息桶里已有同名/同 id 的记录（→ 视为已被触达，用户清单不再显示为未接触）
function _hasMsgSibling(person) {
  if (!person) return false;
  const full = (_plData && _plData.fullList) || [];
  if (!full.length) return false;
  const _nm = (s) => String(s || '').replace(/\s+/g, '').toLowerCase();
  const uid = person.userId ? String(person.userId).toLowerCase() : '';
  const nick = _nm(person.nickname);
  return full.some(q => {
    if (!q || q.id === person.id) return false;
    if (!(q.inbound || q.direction === 'inbound' || (q.source && q.source.stageEntry === '消息'))) return false;
    if (uid && q.userId) return String(q.userId).toLowerCase() === uid;
    if (nick && nick !== '未知用户' && _nm(q.nickname)) return _nm(q.nickname) === nick;
    return false;
  });
}
function _personStatus(person) {
  const ids = person ? [person.id, ..._samePersonIds(person)] : [];
  let rank = 0;
  const recs = (_plData.list || []).filter(q => q && q.id && ids.includes(q.id));
  if (!recs.length) return _rawStatusOf(person) || '待触达';
  for (const q of recs) {
    const s = _rawStatusOf(q);
    let r;
    if (s === '已废弃') r = 6;
    else if (s === '已成交') r = 5;
    else if (s === '谈单中') r = 3;
    else if (s === '已触达' || _isMsgRecord(q)) r = 2;
    else r = 1;
    if ((r === 2 || r === 3) && _isLost(q)) r = 4; // 已确认联系且 3 天未回 → 流失中
    if (r > rank) rank = r;
  }
  return STATUS_RANK_REV[rank] || '待触达';
}

// ★ 统一状态机：每桶仅 3 态，单一派生出口（不再多头判断底层字段）
const PL_STATE_META = {
  untouched: { t: '未触达', c: '#2563eb', bg: '#eff6ff' },   // 通知：进池没动手
  touched: { t: '已触达·待回复', c: '#b45309', bg: '#fffbeb' }, // 通知：我发了等对方回
  prospect: { t: '已转商机', c: '#7c3aed', bg: '#f5f3ff' }, // 通知：对方回→已转商机
  open: { t: '未转化', c: '#059669', bg: '#ecfdf5' },       // 消息：在谈没成交
  converted: { t: '已转化', c: '#92400e', bg: '#fef3c7' }, // 消息：已成交
  other: { t: '其他', c: '#6b7280', bg: '#f3f4f6' },       // 消息：未收录/受限/杂项
};
function _plClosed(p) { return p.status === '已成交' || (p.funnel && p.funnel.step === 'closed'); }
function _plStateOf(p, bucket) {
  const st = _plGetStage(p);
  if (bucket === 'msg') {
    if (_plClosed(p)) return 'converted';
    if (st === 'prospect' || (st === 'lead' && p.awaitingReply)) return 'open';
    return 'other';
  }
  if (st === 'prospect') return 'prospect';
  if (p.awaitingReply) return 'touched';
  return 'untouched';
}
function _plSatisfies(p, key, bucket) {
  if (!key) return true;
  return _plStateOf(p, bucket) === key;
}
// 层内子状态定义
const PL_STAGE_META = {
  lead: { t: '🎇 线索', c: '#0f766e', bg: '#ecfdf5' },
  prospect: { t: '🎯 商机', c: '#7c3aed', bg: '#f5f3ff' },
};
const PL_FUNNEL = {
  pending: { t: '待触达', c: '#2563eb', bg: '#eff6ff' },
  touched: { t: '已触达', c: '#b45309', bg: '#fffbeb' },
  replied: { t: '已回复', c: '#059669', bg: '#ecfdf5' },
  talking: { t: '谈单中', c: '#7c3aed', bg: '#f5f3ff' },
  closed: { t: '已成交', c: '#92400e', bg: '#fef3c7' },
};
const PL_DEFAULT_STATUSES = ['待触达', '已触达', '谈单中', '流失中', '已成交', '已废弃'];
const PL_ENTRY_BADGE = {
  '点赞': { t: '💗点赞', c: '#0e7490', bg: '#ecfeff' },
  '收藏': { t: '⭐收藏', c: '#d97706', bg: '#fffbeb' },
  '关注': { t: '👣关注', c: '#475569', bg: '#f1f5f9' },
  '回复': { t: '💬回复', c: '#059669', bg: '#ecfdf5' },
  '评论': { t: '💬评论', c: '#4f46e5', bg: '#eef2ff' },
  '关键词命中': { t: '🔑关键词', c: '#b45309', bg: '#fffbeb' },
  'AI路由': { t: '🧠AI', c: '#7c3aed', bg: '#f5f3ff' },
  '消息': { t: '💬消息', c: '#0e7490', bg: '#ecfeff' },
  '评论跟进': { t: '💬AI客服', c: '#059669', bg: '#ecfdf5' },
  '手动': { t: '✋手动', c: '#475569', bg: '#f1f5f9' },
};

// 层徽章：商机池显示用户维护的状态，线索池显示层级
const _plStatusColor = (s) => ({ '待触达': '#2563eb', '已触达': '#b45309', '谈单中': '#7c3aed', '流失中': '#d97706', '已成交': '#92400e', '已废弃': '#6b7280', '已回复': '#7c3aed' }[s] || '#6b7280');
function _plStageBadge(p) {
  const s = _plGetStage(p);
  if (s === 'prospect') { const st = p.status || '待触达'; return `<span class="pl-badge" style="background:#eef2ff;color:${_plStatusColor(st)};">${esc(st)}</span>`; }
  const m = PL_STAGE_META.lead; return `<span class="pl-badge" style="background:${m.bg};color:${m.c};">${m.t}</span>`;
}
// 来源徽章
function _plEntryBadge(p) {
  const m = PL_ENTRY_BADGE[_plEntry(p)];
  if (!m) return '';
  return `<span class="pl-origin" style="background:${m.bg};color:${m.c};">${m.t}</span>`;
}
// ── 多来源辅助：读记录历次渠道 channels[]（旧数据兜底从 source 推导）──
const _CH_PRIO = { '评论': 0, '点赞&收藏': 1, 'AI': 2, '关注': 3 };
const _CH_ENTRY_TYPE = { '关注': '关注', '点赞': '点赞&收藏', '收藏': '点赞&收藏', '回复': '评论', '评论': '评论', '互动': '评论', 'AI路由': 'AI', '关键词命中': 'AI', '评论跟进': 'AI', '消息': '' };
function _channelsOf(p) {
  if (p && Array.isArray(p.channels) && p.channels.length) return p.channels;
  const e = (p && p.source && p.source.stageEntry) || '';
  if (!e) return [];
  return [{ type: _CH_ENTRY_TYPE[e] || '评论', entry: e, comment: (p.source && p.source.comment) || p.likedComment || '', noteTitle: (p.source && p.source.noteTitle) || '', nTime: p.nTime || null, nTimeStr: p.nTimeStr || '', signalText: (p.source && p.source.signalText) || '' }];
}
function _bestChannel(p) {
  const cs = _channelsOf(p);
  if (!cs.length) return null;
  return cs.slice().sort((a, b) => (_CH_PRIO[a.type] !== undefined ? _CH_PRIO[a.type] : 9) - (_CH_PRIO[b.type] !== undefined ? _CH_PRIO[b.type] : 9))[0];
}
function _channelsBadge(p) {
  const seen = new Set();
  return _channelsOf(p).map(c => {
    const m = PL_ENTRY_BADGE[c.entry] || PL_ENTRY_BADGE[c.type == null ? '' : c.type];
    if (!m) return '';
    if (seen.has(m.t)) return '';
    seen.add(m.t);
    return `<span class="pl-origin" style="background:${m.bg};color:${m.c};">${m.t}</span>`;
  }).filter(Boolean).join(' ');
}
function _notifContent(p) {
  const c = _bestChannel(p);
  if (!c) return '<span style="color:#c0c4cc;">—</span>';
  if (c.type === '评论' && c.comment) return `📝 <span title="${esc(c.comment)}">${esc(String(c.comment).slice(0, 80))}</span>`;
  if (c.noteTitle) return `📕 <span title="${esc(c.noteTitle)}">${esc(String(c.noteTitle).slice(0, 40))}</span>`;
  const t = c.signalText || c.comment || '';
  return t ? esc(String(t).slice(0, 80)) : '<span style="color:#c0c4cc;">—</span>';
}
function _channelTimeVal(p) {
  const c = _bestChannel(p);
  return fmtDateTime((c && c.nTime) || p.nTime || p.updatedAt);
}
// 层内"下一步"建议（体现"接触过没 → 下一步该做啥"）
function _plNextHint(p) {
  const s = _plGetStage(p);
  const tip = (s === 'lead')
    ? '还没接触过：私信触达 → 对方一回复就升成商机；点「🧠 高意向跟进」优先追。'
    : '已在跟进，状态由你维护（可改状态列表）。';
  return (s === 'lead' ? '🎇 线索' : '⏩ 商机') + '<span class="qhelp" tabindex="0" data-tip="' + escAttr(tip) + '">?</span>';
}

// 收录关键词设置（弹窗编辑 config.product.targetKeywords）
async function editTargetKeywords() {
  const config = await getConfigSafe();
  const kws = (config.product && config.product.targetKeywords) || [];
  const joined = kws.join('，');
  const val = window.prompt('收录关键词（命中评论即自动入清单，多个用逗号分隔）：', joined);
  if (val === null) return;
  const list = val.split(/[,，、\s]+/).map(s => s.trim()).filter(Boolean);
  await updateConfig({ product: { targetKeywords: list } });
  addLog(`⚙️ 收录关键词已更新：${list.join('、') || '（空）'}`, 'info');
  const pc = document.getElementById('prospectContent');
  if (pc && pc.style.display !== 'none') loadProspectList(pc);
}

// 商机池状态列表管理（用户手工维护：状态可增删改，每个商机挂一个）
async function editProspectStatus() {
  const config = await getConfigSafe();
  const cur = (config.prospect && config.prospect.statuses) || PL_DEFAULT_STATUSES;
  const val = window.prompt('商机状态列表（每个商机可选一个状态，逗号分隔）：\n例：待触达，已回复，谈单中，已成交', cur.join('，'));
  if (val === null) return;
  const list = val.split(/[,，、\n]+/).map(s => s.trim()).filter(Boolean);
  await updateConfig({ prospect: { statuses: list } });
  addLog(`⚙️ 商机状态已更新：${list.join('、') || '（空）'}`, 'info');
  const pc = document.getElementById('prospectContent');
  if (pc && pc.style.display !== 'none') loadProspectList(pc);
}

async function getConfigSafe() {
  const resp = await chrome.runtime.sendMessage({ action: 'getConfig' });
  return (resp && resp.config) || {};
}
async function updateConfig(partial) {
  const config = await getConfigSafe();
  await chrome.runtime.sendMessage({ action: 'updateConfig', data: partial });
  return config;
}

// 主渲染
async function loadProspectList(container) {
  container.innerHTML = '';
  const loading = document.createElement('div');
  loading.style.cssText = 'padding:30px;text-align:center;color:#666;font-size:13px;';
  loading.textContent = '⏳ 加载用户清单...';
  container.appendChild(loading);

  const resp = await chrome.runtime.sendMessage({ action: 'getProspectList', data: { filter: _plFilter, includeDiscarded: _plShowDiscarded } });
  if (!resp || !resp.ok) {
    loading.textContent = '❌ 加载失败：' + ((resp && resp.error) || '未知错误');
    return;
  }
  // 统计条用全量数据（不带筛选），避免筛选后统计数字跟着变
  let fullList = [];
  try {
    const full = await chrome.runtime.sendMessage({ action: 'getProspectList', data: {} });
    if (full && full.ok) fullList = full.list || [];
  } catch (_) {}
  // 商机状态列表（用户可手工维护）——从配置读取
  let statuses = [];
  try {
    const cfg = await getConfigSafe();
    statuses = (cfg.prospect && cfg.prospect.statuses) || [];
  } catch (_) {}
  _plData = { list: resp.list || [], allTags: resp.allTags || [], fullList, statuses };
  try {
    renderProspectList(container);
  } catch (e) {
    addLog('❌ 渲染用户清单出错：' + (e && e.message) + '　' + ((e && e.stack || '').split('\n')[1] || ''), 'error');
    const er = document.createElement('div');
    er.style.cssText = 'padding:14px;color:#c62828;font-size:12px;line-height:1.6;';
    er.innerHTML = '❌ 渲染清单出错：' + esc((e && e.message) || e) + '<br><span style="color:#888;font-size:11px;">已在实时日志里打印出错位置，把 `❌ 渲染用户清单出错` 那行发我。</span>';
    container.appendChild(er);
  }
}

// 统一时间格式：yyyy-MM-dd HH:mm（支持 ms/秒时间戳、可解析日期串；解析失败回显原文）
function fmtDateTime(t) {
  if (t === undefined || t === null || t === '') return '';
  let d;
  if (typeof t === 'object' && t instanceof Date) { d = t; }
  else {
    const s = String(t);
    if (/^\d+$/.test(s)) { const n = Number(s); d = new Date(n > 1e12 ? n : n * 1000); }
    else d = new Date(s);
  }
  if (!d || isNaN(+d)) return String(t);
  const p = (n) => String(n).padStart(2, '0');
  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
}

// 线索页的「通知来自哪个渠道」胶囊：通知 / 消息已由左栏二级切成两条线，这一排只筛通知的来源
const PL_CH_PILLS = [
  { k: 'all', t: '全部' },
  { sep: true },
  { k: 'comment', t: '评论' }, { k: 'like', t: '赞藏' }, { k: 'follow', t: '关注' }, { k: 'ai', t: 'AI' },
];
function _plStageLabel() {
  if (_plStage === 'msg') return '消息';
  const ch = { comment: '评论', like: '赞藏', follow: '关注', ai: 'AI' }[_plChannelSel];
  return ch ? ('通知 · ' + ch) : '通知';
}
function _plPillBar(container) {
  const bar = document.createElement('div');
  bar.className = 'pl-chans';
  // 已废弃是「状态筛选」进的管理视图，给一条回程
  if (_plShowDiscarded) {
    const back = document.createElement('button');
    back.className = 'pl-chan';
    back.innerHTML = Ic('arrow-left', 'ic-sm') + '返回' + (_plStage === 'msg' ? '消息' : '通知');
    back.addEventListener('click', () => { _plFilter2.touch = []; loadProspectList(container); });
    bar.appendChild(back);
    return bar;
  }
  if (_plStage !== 'notif') return null;   // 消息没有渠道可分，整条不渲染
  const cur = _plChannelSel || 'all';
  const lbl = document.createElement('span');
  lbl.className = 'pl-chans-lbl';
  lbl.textContent = '通知来自';
  bar.appendChild(lbl);
  PL_CH_PILLS.forEach((p) => {
    if (p.sep) { const s = document.createElement('span'); s.className = 'pl-chans-sep'; bar.appendChild(s); return; }
    const b = document.createElement('button');
    b.className = 'pl-chan' + (p.k === cur ? ' active' : '');
    b.textContent = p.t;
    b.addEventListener('click', () => {
      _plChannelSel = (p.k === 'all') ? '' : p.k;
      loadProspectList(container);
    });
    bar.appendChild(b);
  });
  return bar;
}

function renderProspectList(container) {
  container.innerHTML = '';
  const allList = _plData.list;
  // ★ "已废弃"= 一种状态；多选 chips ＝ 并集筛选（选中越多显示越多）
  const _isDisc = (p) => !!(p && (p.status === '已废弃' || p.discarded === true));
  const _touchSel = Array.isArray(_plFilter2.touch) && _plFilter2.touch.length ? _plFilter2.touch.slice() : [];
  // 🗑 已废弃管理视图：仅当【只勾选「已废弃」】进入（可恢复/彻底删）；与其它状态一起多选则按普通状态并集筛选
  const _dedicatedDisc = _touchSel.length === 1 && _touchSel[0] === '已废弃';
  _plShowDiscarded = _dedicatedDisc;
  const _pillBar = _plPillBar(container);   // ★ 通知页的渠道切换（消息页不渲染）
  if (_pillBar) container.appendChild(_pillBar);
  let list;
  // 🗑 已废弃视图：只显示标废的，不做渠道/触达/相关过滤
  if (_dedicatedDisc) {
    list = allList.filter(_isDisc);
  } else {
    // 双桶：通知（平台消息）/ 消息（私信往来）—— 一级导航已分成两页，这里只按当前页的桶取
    list = allList.filter(p => _plBucket(p) === _plStage);
    if (_plHideBlocked) list = list.filter(p => !p.dmBlocked);
    // ★「通知」按渠道 tab 过滤（全部/评论/点赞&收藏/关注/AI）
    if (_plStage === 'notif' && _plChannelSel) {
      const chMap = { comment: '评论', like: '赞藏', follow: '关注', ai: 'AI' };
      const want = chMap[_plChannelSel];
      if (want) list = list.filter(p => _plChannel(p) === want);
    }
    // ★ 状态多选筛选：多选=并集（命中任一选中状态即保留）；未选=默认隐藏已废弃
    if (_touchSel.length) {
      list = list.filter(p => _touchSel.includes(_personStatus(p)));
    } else {
      list = list.filter(p => !_isDisc(p));
    }
  }
  _currentShown = list.slice(); // ★ 记录当前 tab 筛出的这批，供批量触达/生成话术用
  // ★ 一人一行：同 userId/昵称合并（触达状态按"人"算，任一渠道触达过，其余渠道也算已触达；
//  重复时保留触达进度更高/状态更优的那条）
  {
    const best = new Map();
    const prio = (x) => ({ untouched: 0, touched: 1, awaiting: 2, prospect: 3 }[_plTouchState(x)] !== undefined ? { untouched: 0, touched: 1, awaiting: 2, prospect: 3 }[_plTouchState(x)] : 0);
    const unionCh = (a, b) => {
      const out = (Array.isArray(a) ? a : []).slice();
      for (const c of (Array.isArray(b) ? b : [])) {
        if (!c || !c.type) continue;
        const i = out.findIndex(x => x && String(x.type) === String(c.type));
        if (i >= 0) out[i] = { ...out[i], ...c, type: out[i].type };
        else out.push(c);
      }
      return out;
    };
    for (const p of list) {
      const k = p.userId ? 'id:' + String(p.userId).toLowerCase() : ('nick:' + (p.nickname || '').toLowerCase());
      if (!k || k === 'nick:') { best.set('__uniq_' + best.size, p); continue; }
      const cur = best.get(k);
      if (!cur) { best.set(k, p); }
      else {
        const up = prio(p) > prio(cur) ? p : cur;
        best.set(k, { ...up, channels: unionCh(_channelsOf(cur), _channelsOf(p)) });
      }
    }
    list = Array.from(best.values());
  }
  // 消息桶：只把"已来回过的我方触达"折叠进独立分组；待回复(awaitingReply)outbound 进主列表置顶
  let outList = [];
  if (_plStage === 'msg') {
    outList = list.filter(p => _isOutbound(p) && !p.awaitingReply);
    const pendingOut = list.filter(p => _isOutbound(p) && p.awaitingReply); // 我方触达·对方未回 → 置顶
    list = list.filter(p => !_isOutbound(p));
    if (pendingOut.length) list = pendingOut.concat(list);
  }
  const total = list.length;
  const _isDisc2 = (p) => !!(p && (p.status === '已废弃' || p.discarded === true));
  const fullList = (_plData.fullList || allList).filter(p => (_plShowDiscarded || _touchSel.includes('已废弃')) ? true : !_isDisc2(p));
  // ★ 排序：待回复优先；回评(入口'回复')/高意向次之；其余按意向权重再按时间新到旧
  const _plEv = (p) => (p.profile && p.profile.intentLevel) || (p.affinity && p.affinity.intentLevel) || 'medium';
  const _intentRank = (p) => ({ high: 2, medium: 1, low: 0 }[_plEv(p)] !== undefined ? { high: 2, medium: 1, low: 0 }[_plEv(p)] : 1);
  const _replyRank = (p) => (_plEntry(p) === '回复' ? 1 : 0);
  // 最近活跃时间：优先会话最后消息时间，其次本地更新时间，避免用"收录时间"导致新旧倒置
  const _plActivity = (p) => {
    const raw = p.lastConvFp && p.lastConvFp.at;
    if (raw) { const t = (typeof raw === 'number') ? raw : Date.parse(String(raw)); if (!isNaN(t)) return t; }
    return (p.updatedAt || p.createdAt || 0);
  };
  // 消息桶排序键：XHS 会话 DOM 顺序(order, 0=最新在前)；没有则退回活跃时间倒序
  // 最近活跃/通知时间：优先通知真实时间 nTime，其次会话/更新时间
  const _nTimeOf = (p) => {
    if (p.nTime) { const n = +p.nTime; if (n > 0) return n; }
    const raw = p.lastConvFp && p.lastConvFp.at;
    if (raw) { const t = (typeof raw === 'number') ? raw : Date.parse(String(raw)); if (!isNaN(t)) return t; }
    return (p.updatedAt || p.createdAt || 0);
  };
  list = list.slice().sort((a, b) => _plActivity(b) - _plActivity(a)); // 消息/通知按"最后一条消息时间"倒序（最新在前），对齐小红书原序

  // 【诊断】列表空时，把存储与分桶情况写到"实时日志"，便于定位"没入库"还是"没显示"
  if (list.length === 0 && !_plShowDiscarded) {
    try {
      addLog(`线索清单为空：存储 ${allList.length} 条（通知 ${allList.filter(p => _plBucket(p) === 'notif').length} / 消息 ${allList.filter(p => _plBucket(p) === 'msg').length}），当前视图「${_plStageLabel()}」`, 'warn');
      if (allList.length) {
        addLog('[诊断] 示例：' + allList.slice(0, 6).map(p => `${p.nickname || '?'}/${_plBucket(p)}/stage=${p.stage || '?'}/entry=${(p.source && p.source.stageEntry) || '?'}`).join('；'), 'warn');
      }
    } catch (_) {}
  }

  // 批量操作条（按层出ロ）
  const batch = document.createElement('div');
  batch.className = 'pl-batch';
  if (_plStage === 'msg') {
    // ── 消息工具条：[✨生成AI话术▾] [🔄刷新消息▾] ──
    const grp = document.createElement('span');
    grp.style.cssText = 'display:inline-flex;gap:6px;align-items:center;';
    const mkOpt = (html, style) => { const o = document.createElement('div'); o.innerHTML = html; o.style.cssText = style || 'padding:8px 10px;font-size:12px;border-radius:6px;cursor:pointer;color:#1a1a1a;'; o.addEventListener('mouseenter', () => { o.style.background = '#f3f0ff'; }); o.addEventListener('mouseleave', () => { o.style.background = ''; }); return o; };
    // [✨生成AI话术 ▾]（下拉 = 批量联系TA）
    const genWrap = document.createElement('span');
    genWrap.className = 'plNotifGroup';
    genWrap.style.cssText = 'position:relative;display:inline-flex;align-items:stretch;border:1px solid #ef4444;border-radius:8px;';
    const genBtn = document.createElement('button');
    genBtn.id = 'plMsgGenBtn'; genBtn.textContent = '✨ 生成AI话术';
    genBtn.style.cssText = 'padding:5px 12px;border:none;border-radius:8px 0 0 8px;background:#fef2f2;color:#dc2626;font-weight:600;cursor:pointer;font-size:11px;';
    genBtn.title = '为当前消息生成AI回复话术（红色=联系TA同款，点左侧主区批量生成）';
    const genCaret = document.createElement('button');
    genCaret.id = 'plMsgGenCaret'; genCaret.textContent = '▾';
    genCaret.style.cssText = 'padding:5px 9px;border:none;border-left:1px solid #fca5a5;background:#fef2f2;color:#dc2626;cursor:pointer;font-size:11px;';
    const genMenu = document.createElement('div');
    genMenu.className = 'plNotifMenu';
    genMenu.style.cssText = 'display:none;position:absolute;top:calc(100% + 4px);right:0;z-index:61;min-width:150px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.12);padding:4px;';
    const optContact = mkOpt('💬 批量联系TA', 'padding:8px 10px;font-size:12px;border-radius:6px;cursor:pointer;color:#dc2626;font-weight:600;');
    genMenu.appendChild(optContact);
    genWrap.append(genBtn, genCaret, genMenu);
    genBtn.addEventListener('click', () => { genMsgDrafts(container); });
    genCaret.addEventListener('click', () => { genMenu.style.display = genMenu.style.display === 'block' ? 'none' : 'block'; });
    optContact.addEventListener('click', async () => { genMenu.style.display = 'none'; await batchContactMsg(container); });
    // [🔄刷新消息 ▾]（下拉 = 清空消息）
    const refWrap = document.createElement('span');
    refWrap.className = 'plNotifGroup';
    refWrap.style.cssText = 'position:relative;display:inline-flex;align-items:stretch;border:1px solid #f59e0b;border-radius:8px;';
    const inb = document.createElement('button');
    inb.id = 'plSyncInbound'; inb.textContent = '🔄 刷新消息';
    inb.style.cssText = 'padding:5px 12px;border:none;border-radius:8px 0 0 8px;background:#fffbeb;color:#b45309;font-weight:600;cursor:pointer;font-size:11px;';
    const refCaret = document.createElement('button');
    refCaret.id = 'plMsgRefCaret'; refCaret.textContent = '▾';
    refCaret.style.cssText = 'padding:5px 9px;border:none;border-left:1px solid #fde3a7;background:#fffbeb;color:#b45309;cursor:pointer;font-size:11px;';
    const refMenu = document.createElement('div');
    refMenu.className = 'plNotifMenu';
    refMenu.style.cssText = 'display:none;position:absolute;top:calc(100% + 4px);right:0;z-index:60;min-width:120px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.12);padding:4px;';
    const optClear = mkOpt('🧹 清空消息');
    refMenu.appendChild(optClear);
    refWrap.append(inb, refCaret, refMenu);
    inb.addEventListener('click', () => syncChatInbound(container));
    refCaret.addEventListener('click', () => { refMenu.style.display = refMenu.style.display === 'block' ? 'none' : 'block'; });
    optClear.addEventListener('click', async () => { refMenu.style.display = 'none'; await clearMsgBucketOnly(container); });
    if (!window.__plMsgOuterBound) {
      window.__plMsgOuterBound = true;
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.plNotifMenu').forEach(m => {
          const g = m.closest('.plNotifGroup');
          if (m.style.display === 'block' && !(g && g.contains(e.target))) m.style.display = 'none';
        });
      });
    }
    grp.append(genWrap, refWrap);
    batch.appendChild(grp);
  }
  // ★ 通知工具条：✨生成AI话术▾ / 🔄刷新通知▾（批量改状态已移到下方筛选行最前）
  let bsOpts = '';
  if (!_plShowDiscarded && _plStage === 'notif') {
    const bsList = (() => { const l = PL_STATUS_ALL.slice(); if (!l.includes('已触达')) l.unshift('已触达'); if (!l.includes('已废弃')) l.push('已废弃'); return l; })();
    bsOpts = `<option value="">批量改状态(${_selectedIds.size})…</option>` + bsList.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
    const grp = document.createElement('span');
    grp.style.cssText = 'display:inline-flex;gap:6px;align-items:center;';
    const mkOpt = (html, style) => { const o = document.createElement('div'); o.innerHTML = html; o.style.cssText = style || 'padding:8px 10px;font-size:12px;border-radius:6px;cursor:pointer;color:#1a1a1a;'; o.addEventListener('mouseenter', () => { o.style.background = '#f3f0ff'; }); o.addEventListener('mouseleave', () => { o.style.background = ''; }); return o; };
    // [✨ 生成AI话术 ▾]（下拉 = 自动触达）
    const genWrap = document.createElement('span');
    genWrap.className = 'plNotifGroup';
    genWrap.style.cssText = 'position:relative;display:inline-flex;align-items:stretch;border:1px solid #ef4444;border-radius:8px;';
    const genBtn = document.createElement('button');
    genBtn.id = 'plGenDraftBtn'; genBtn.textContent = '✨ 生成AI话术';
    genBtn.style.cssText = 'padding:5px 12px;border:none;border-radius:8px 0 0 8px;background:#fef2f2;color:#dc2626;font-weight:600;cursor:pointer;font-size:11px;';
    genBtn.title = '为通知里的线索生成AI触达话术（红色=联系TA同款，点左侧主区批量生成）';
    const genCaret = document.createElement('button');
    genCaret.id = 'plGenCaret'; genCaret.textContent = '▾';
    genCaret.style.cssText = 'padding:5px 9px;border:none;border-left:1px solid #fca5a5;background:#fef2f2;color:#dc2626;cursor:pointer;font-size:11px;';
    const genMenu = document.createElement('div');
    genMenu.className = 'plNotifMenu';
    genMenu.style.cssText = 'display:none;position:absolute;top:calc(100% + 4px);right:0;z-index:61;min-width:180px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.12);padding:4px;';
    const optTouch = mkOpt('⚡ 自动触达', 'padding:8px 10px;font-size:12px;border-radius:6px;cursor:pointer;color:#dc2626;font-weight:600;');
    genMenu.appendChild(optTouch);
    genWrap.append(genBtn, genCaret, genMenu);
    genBtn.addEventListener('click', () => { genMissingDrafts(container, false); });
    genCaret.addEventListener('click', () => { genMenu.style.display = genMenu.style.display === 'block' ? 'none' : 'block'; });
    optTouch.addEventListener('click', async () => { genMenu.style.display = 'none'; await genMissingDrafts(container, false); if (typeof batchTouchAuto === 'function') batchTouchAuto(container); });
    // [🔄 刷新通知 ▾]（下拉只剩 清空列表）
    const group = document.createElement('div');
    group.className = 'plNotifGroup';
    group.style.cssText = 'position:relative;display:inline-flex;align-items:stretch;border:1px solid #0e7490;border-radius:8px;';
    const rf = document.createElement('button'); rf.id = 'plNotifRefresh'; rf.textContent = '🔄 刷新通知'; rf.style.cssText = 'padding:5px 12px;border:none;background:#ecfeff;color:#0e7490;font-weight:600;cursor:pointer;font-size:11px;';
    const caret = document.createElement('button'); caret.id = 'plNotifMore'; caret.textContent = '▾'; caret.style.cssText = 'padding:5px 9px;border:none;border-left:1px solid #bae6fd;background:#ecfeff;color:#0e7490;cursor:pointer;font-size:11px;';
    const menu = document.createElement('div'); menu.id = 'plNotifMenu'; menu.className = 'plNotifMenu'; menu.style.cssText = 'display:none;position:absolute;top:calc(100% + 4px);right:0;z-index:60;min-width:120px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.12);padding:4px;';
    const optClear = mkOpt('🧹 清空通知');
    const optClearAll = mkOpt('🗑 清空全部（消息+通知）', 'padding:8px 10px;font-size:12px;border-radius:6px;cursor:pointer;color:#b45309;');
    menu.append(optClear, optClearAll);
    group.appendChild(rf); group.appendChild(caret); group.appendChild(menu);
    const closeMenu = () => { menu.style.display = 'none'; };
    rf.addEventListener('click', () => _refreshCurrentTab(container));
    caret.addEventListener('click', () => { menu.style.display = menu.style.display === 'block' ? 'none' : 'block'; });
    optClear.addEventListener('click', async () => { closeMenu(); await clearNotifBucketOnly(container); });
    optClearAll.addEventListener('click', async () => { closeMenu(); await clearAllProspects(container); });
    if (!window.__plNotifOuterBound) {
      window.__plNotifOuterBound = true;
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.plNotifMenu').forEach(m => {
          const g = m.closest('.plNotifGroup');
          if (m.style.display === 'block' && !(g && g.contains(e.target))) m.style.display = 'none';
        });
      });
    }
    grp.append(genWrap, group);
    batch.appendChild(grp);
  }
  // 消息视图：批量改状态下拉（消息桶无「待触达」，状态列表对应过滤）
  if (_plStage === 'msg' && !_plShowDiscarded) {
    const bsList = PL_STATUS_ALL.filter(s => s !== '待触达');
    bsOpts = `<option value="">批量改状态(${_selectedIds.size})…</option>` + bsList.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
  }
  if (!_plShowDiscarded && batch.childNodes.length) container.appendChild(batch);

  // ★ 通知视图：顶部挂「通知回访队列」（待回/正在回/今天已回；执行器控件就在这一块里）
  if (_plStage === 'notif') chatqMount(container);

  // 筛选行：左=批量改状态 + 状态(chips) ｜ 右=昵称搜索
  const filter = document.createElement('div');
  filter.className = 'pl-filter';
  filter.innerHTML = `
    ${(!_plShowDiscarded) ? `<select id="plBatchStatus" style="font-size:11px;padding:3px 8px;border:1px solid #c4b5fd;border-radius:6px;color:#6d28d9;background:#faf5ff;">${bsOpts}</select>` : ''}
    <span style="font-size:11px;color:#888;white-space:nowrap;">状态</span>
    <span id="plTouchChips" style="display:inline-flex;gap:4px;flex-wrap:wrap;"></span>
    <span style="margin-left:auto;display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap;">
      <input id="plSearch" placeholder="🔍 搜索昵称" style="width:92px;min-width:0;" value="${esc(_plFilter.keyword)}">
    </span>`;
  container.appendChild(filter);
  // ★ 状态多选 ＝ 点选 chips（唯一的状态筛选项；选"已废弃"即进已废弃视图）
  //   消息桶必然已联系 → 不提供「待触达」筛项
  const _STATUS_OPTS = (_plStage === 'msg') ? PL_STATUS_ALL.filter(s => s !== '待触达') : PL_STATUS_ALL.slice();
  const _touchSet = new Set(Array.isArray(_plFilter2.touch) ? _plFilter2.touch : []);
  const chipsBox = filter.querySelector('#plTouchChips');
  const paintChips = () => {
    chipsBox.innerHTML = _STATUS_OPTS.map((s) => {
      const on = _touchSet.has(s);
      return `<span class="plat-chip" data-s="${s}" style="cursor:pointer;font-size:11px;border:1px solid ${on ? '#7c3aed' : '#d5c8f5'};background:${on ? '#f3f0ff' : '#fff'};color:${on ? '#7c3aed' : '#6d28d9'};border-radius:12px;padding:2px 9px;">${s}</span>`;
    }).join('');
  };
  paintChips();
  chipsBox.querySelectorAll('.plat-chip').forEach((c) => c.addEventListener('click', () => {
    const s = c.dataset.s;
    if (_touchSet.has(s)) _touchSet.delete(s); else _touchSet.add(s);
    _plFilter2.touch = Array.from(_touchSet);
    paintChips();
    applyFilterHelper();
  }));
  // ★ 批量改状态：下拉选即生效（对勾选的人）
  container.querySelector('#plBatchStatus')?.addEventListener('change', async (e) => {
    const status = e.target.value; e.target.value = '';
    const ids = Array.from(_selectedIds);
    if (!ids.length) { addLog('⚠️ 未勾选任何客户', 'warn'); return; }
    if (!status) { addLog('⚠️ 未选择要改成哪个状态', 'warn'); return; }
    if (!window.confirm(`确认将 ${ids.length} 个客户的状态改为「${status}」？`)) return;
    let n = 0; const totalIds = [];
    const _plById = (i) => _plData.list.find(p => p && p.id === i);
    for (const id of ids) {
      const pg = _plById(id);
      const sibs = pg ? [id, ..._samePersonIds(pg)] : [id];
      for (const sid of sibs) { if (!totalIds.includes(sid)) totalIds.push(sid); }
    }
    for (const sid of totalIds) {
      try { await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id: sid, updates: { status } } }); n++; } catch (_) {}
    }
    _selectedIds.clear();
    addLog(`✅ 已批量改状态为「${status}」：${n}/${totalIds.length}` + (totalIds.length > ids.length ? '（含同人他渠道记录）' : ''), 'success');
    loadProspectList(container);
  });
  const applyFilter = () => {
    _plFilter.keyword = filter.querySelector('#plSearch').value.trim();
    applyFilterHelper();
  };
  const applyFilterHelper = () => { _plPage = 0; loadProspectList(container); };
  filter.querySelector('#plSearch').addEventListener('keydown', e => { if (e.key === 'Enter') applyFilter(); });

  

  // 空态
  if (total === 0) {
    const empty = document.createElement('div');
    empty.className = 'pl-empty';
    if (_plStage === 'msg') {
      empty.innerHTML = '📨 消息桶暂无记录。<br>点上方「🔄 刷新消息」，直接从小红书消息中心拉取你与客户的对话。';
      container.appendChild(empty);
      return;
    }
    empty.innerHTML = '🎯 清单为空。<br>在「获客助手」扫描笔记时，点击商机卡片的「➕ 入清单」，或用关键词收录命中评论。';
    container.appendChild(empty);
    return;
  }

  // 分页
  const pageCount = Math.max(1, Math.ceil(total / PL_PAGE_SIZE));
  _plPage = Math.min(_plPage, pageCount - 1);
  const pageList = list.slice(_plPage * PL_PAGE_SIZE, (_plPage + 1) * PL_PAGE_SIZE);

  // 表头 + tbody
  const table = document.createElement('table');
  table.className = 'pl-table';
  const isMsgView = _plStage === 'msg';
  const isNotifView = _plStage === 'notif';
  table.innerHTML = isMsgView
    ? `<thead><tr>
      <th class="pl-col-sel"><input type="checkbox" id="plHeaderSelectAll" class="pl-sel-all" title="全选本页" style="accent-color:#7c3aed;"></th>
      <th class="pl-col-user">用户</th>
      <th class="pl-col-who">收发</th>
      <th class="pl-col-msg">最近消息</th>
      <th class="pl-col-time">时间</th>
      <th class="pl-col-act">操作</th>
      <th class="pl-col-x"></th>
    </tr></thead>`
    : isNotifView
    ? `<thead><tr>
      <th class="pl-col-sel"><input type="checkbox" id="plHeaderSelectAll" class="pl-sel-all" title="全选本页" style="accent-color:#7c3aed;"></th>
      <th class="pl-col-user">用户</th>
      <th class="pl-col-src2">来源</th>
      <th class="pl-col-msg">最近内容</th>
      <th class="pl-col-time">时间</th>
      <th class="pl-col-act">操作</th>
      <th class="pl-col-x"></th>
    </tr></thead>`
    : `<thead><tr>
      <th class="pl-col-sel"><input type="checkbox" id="plHeaderSelectAll" class="pl-sel-all" title="全选本页" style="accent-color:#7c3aed;"></th>
      <th class="pl-col-user">用户</th>
      <th class="pl-col-src">来源</th>
      <th class="pl-col-state">状态</th>
      <th class="pl-col-msg">最近 / 来源内容</th>
      <th class="pl-col-act">操作</th>
      <th class="pl-col-x"></th>
    </tr></thead>`;
  const tbody = document.createElement('tbody');
  table.appendChild(tbody);
  container.appendChild(table);

  // 行
  pageList.forEach(p => {
    const s = _plGetStage(p);
    const pf = p.profile || {};
    const tagsHtml = (Array.isArray(pf.tags) && pf.tags.length ? pf.tags.map(esc).join(' · ') : '');
    const idHtml = p.userId ? `ID:${esc(p.userId)}` : '';
    const nickMeta = [tagsHtml && ('标签:' + tagsHtml), idHtml, p.keywordHit].filter(Boolean).join(' · ');
    // ★ 私信受限标记（对方隐私设置/未关注，暂时无法私信）
    const blockedHtml = p.dmBlocked
      ? `<div class="pl-id-blocked">⛔ 私信受限：对方隐私设置或未关注，暂无法私信 — 可在评论区破冰，或关注后待通过再试。${esc(p.dmBlockedAt ? new Date(p.dmBlockedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '')}</div>`
      : '';
    const isBlocked = !!p.dmBlocked;
    const srcComment = ((p.source && p.source.comment) || '').slice(0, 80);
    const srcNote = ((p.source && p.source.noteTitle) || '').slice(0, 40);
    // 评论跟进的历史对话（我们自己回复过+对方的发言），供查看"之前跟他说过啥"
    const chatHistory = (Array.isArray(p.chatHistory) && p.chatHistory.length) ? p.chatHistory : null;
    const chatHistoryHtml = chatHistory
      ? `<details class="pl-chat">
          <summary>💬 历史对话（${chatHistory.length} 条）▸</summary>
          <div class="pl-chat-body">${chatHistory.map(function (h) {
            const who = h.role === 'assistant' ? '<b style="color:#059669;">我</b>' : '<b style="color:#2563eb;">对方</b>';
            return `<div class="pl-chat-line">${who}：${esc(String(h.content || '').slice(0, 120))}</div>`;
          }).join('')}</div>
        </details>`
      : '';

    // 层内"状态/下一步"下拉（v2：所有行都显示漏斗状态，方便给手动回应过的人打标；已废弃也是状态之一）
    let statusSel = '';
    // 消息桶记录必然已联系（最低已触达）→ 状态下拉不提供「待触达」
    const stList = (isMsgView ? PL_STATUS_ALL.filter(s => s !== '待触达') : PL_STATUS_ALL.slice());
    let _curStatus = _personStatus(p);
    if (!stList.includes(_curStatus)) _curStatus = '待触达';
    // ★ 有消息往来的人在简介中不应显示为"未接触/待触达"
    if ((_curStatus === '待触达' || _curStatus === '' || _curStatus === '未接触') && _hasMsgSibling(p)) _curStatus = '已触达';
    statusSel = `<select class="pl-status" data-plid="${p.id}" data-kind="status" title="漏斗状态：手动回应对应的人可改成 谈单中/已成交/已废弃 等">${stList.map(st => `<option value="${esc(st)}" ${st === _curStatus ? 'selected' : ''}>${esc(st)}</option>`).join('')}</select>`;
    // 产品相关"只读"徽章（🟢相关/⚪无关；想看判定或手动改 → 打开画像弹窗把"意图"设成 高/中/低）
    // 单条动作：一律「联系TA」＝打开私信弹窗自己写（去卖/触达合并，不再区分）
    let actions = `<button class="act send" data-plid="${p.id}" data-action="dm" title="联系TA：打开私信自己写话术，可用「优化话术」">💬 联系TA</button>`;
    // 底部动作（普通视图：状态/联系TA + 主页；已废弃视图：恢复 + 彻底删）
    let foot;
    if (_plShowDiscarded) {
      foot = `<span style="font-size:11px;color:#888;">已废弃 · 想恢复请在状态下拉自己改</span>` +
             `<button class="act send" data-plid="${p.id}" data-action="purge" title="彻底删除（不可恢复）" style="border:1px solid #dc2626;background:#fee2e2;color:#b91c1c;">🗑 彻底删</button>`;
    } else {
      foot = `${statusSel}${actions}` +
             `<button class="pl-home" data-plid="${p.id}" data-action="locate" title="打开该用户主页">📎</button>`;
    }

    // 最近/来源内容（表格中间列）：消息桶→"最后一句话谁·说了什么·何时"；通知→评论/来源笔记
    const _lastWho = (p.lastFrom === 'them' || p.inbound || p.themReplied || p.direction === 'inbound') ? '对方' : ((p.lastFrom === 'me' || p.direction === 'outbound') ? '我方' : '');
    const _lastTime = (() => {
      const t = (p.lastConvFp && p.lastConvFp.at) || p.lastDmAt || p.updatedAt;
      if (t === undefined || t === null || t === '') return '';
      try {
        const d = new Date(t);
        if (!isNaN(+d)) { const now = new Date(); if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }); return (d.getMonth() + 1) + '-' + d.getDate(); }
      } catch (_) {}
      // 拿不到时间戳 → 回显原始时间串（如 08-17）
      return (p.lastConvFp && p.lastConvFp.at) ? String(p.lastConvFp.at) : '';
    })();
    const _lastTxt = String(p.lastMsg || '').slice(0, 40);
    // 收发列：我方(绿)/对方(蓝)
    const whoHtml = _lastWho ? `<span style="font-weight:600;color:${_lastWho === '我方' ? '#059669' : '#2563eb'};">${_lastWho}</span>` : '';
    // 时间列：正规 yyyy-MM-dd HH:mm
    const timeVal = fmtDateTime((p.lastConvFp && p.lastConvFp.at) || p.lastDmAt || p.updatedAt);
    const draftHtml = p.dmDraft ? `<span title="${esc(p.dmDraft)}" style="display:block;color:#7c3aed;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">💬话术：${esc((p.dmDraft || '').slice(0, 40))}${(p.dmDraft || '').length > 40 ? '…' : ''}</span>` : '';
    // 消息视图：最近消息列只放文本（收发/时间已拆到各自列）
    const msgTextCell = `<span title="${esc(p.lastMsg || '')}" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">📨 ${esc(_lastTxt || '对方私信了你，尽快回复')}</span>${draftHtml}`;
    // 非消息视图：最近/来源内容列（评论 / 笔记标题 + 话术）
    const msgCell = (srcComment
      ? `<span title="${esc(srcComment)}" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">📝 ${esc(srcComment)}</span>`
      : (srcNote
        ? `<span title="${esc(srcNote)}" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">📕 ${esc(srcNote)}</span>`
        : '<span style="color:#c0c4cc;">—</span>')) + draftHtml;
    const userCell = `<span class="pl-nick">${esc(p.nickname || '未知用户')}${p.unread ? ' <b style="color:#dc2626;">●</b>' : ''}</span>${isBlocked ? '<span class="pl-badge" style="background:#fef2f2;color:#b91c1c;">⛔受限</span>' : ''}${((p.profileGate && (p.profileGate.verdict === 'low' || p.profileGate.verdict === 'none')) ? `<span class="pl-badge" style="background:#fefce8;color:#a16207;" title="主页甄别：${esc(p.profileGate.reason || (p.profileGate.verdict === 'none' ? '看不出购买意向' : '购买意向偏弱'))}">低意向·暂不触达</span>` : '')}${(p.nTimeStr ? `<span style="font-size:10px;color:#9ca3af;margin-left:2px;">🕐${esc(p.nTimeStr)}</span>` : '')}${nickMeta ? `<div class="pl-nickmeta">${nickMeta}</div>` : ''}`;
    const selCell = `<input type="checkbox" class="pl-sel" data-plid="${p.id}" ${_selectedIds.has(p.id) ? 'checked' : ''} title="勾选后可在列表底部批量删除">`;

    const tr = document.createElement('tr');
    tr.className = 'pl-row';
    tr.dataset.plid = p.id;
    if (isMsgView) {
      tr.innerHTML = `
      <td class="pl-col-sel">${selCell}</td>
      <td class="pl-col-user">${userCell}</td>
      <td class="pl-col-who">${whoHtml}</td>
      <td class="pl-col-msg">${msgTextCell}</td>
      <td class="pl-col-time">${timeVal}</td>
      <td class="pl-col-act"><div class="pl-foot">${foot}</div></td>
      <td class="pl-col-x"><button class="pl-toggle" data-plid="${p.id}" title="展开详情">▸</button></td>`;
    } else if (isNotifView) {
      const nContent = _notifContent(p) + draftHtml;
      tr.innerHTML = `
      <td class="pl-col-sel">${selCell}</td>
      <td class="pl-col-user">${userCell}</td>
      <td class="pl-col-src2">${_channelsBadge(p)}</td>
      <td class="pl-col-msg">${nContent}</td>
      <td class="pl-col-time">${_channelTimeVal(p)}</td>
      <td class="pl-col-act"><div class="pl-foot">${foot}</div></td>
      <td class="pl-col-x"><button class="pl-toggle" data-plid="${p.id}" title="展开详情">▸</button></td>`;
    } else {
      tr.innerHTML = `
      <td class="pl-col-sel">${selCell}</td>
      <td class="pl-col-user">${userCell}</td>
      <td class="pl-col-src">${_plEntryBadge(p)}</td>
      <td class="pl-col-state"><span class="pl-badge" style="background:#eef2ff;color:${_plStatusColor(_curStatus)};">${esc(_curStatus)}</span></td>
      <td class="pl-col-msg">${msgCell}</td>
      <td class="pl-col-act"><div class="pl-foot">${foot}</div></td>
      <td class="pl-col-x"><button class="pl-toggle" data-plid="${p.id}" title="展开详情">▸</button></td>`;
    }
    tbody.appendChild(tr);

    // 详情行（默认收起；包含画像/历史对话/回复建议）
    const detail = document.createElement('tr');
    detail.className = 'pl-detail pl-row-detail';
    detail.dataset.plid = p.id;
    detail.style.display = 'none';
    detail.innerHTML = `<td colspan="7" style="padding:8px 12px;">
      ${blockedHtml}
      <div class="pl-hint">${_plNextHint(p)}</div>
      ${p.dmDraft ? `<div class="pl-source" style="color:#7c3aed;">💬 触达话术：${esc(p.dmDraft)}</div>` : ''}
      ${srcComment ? `<div class="pl-source">📝 评论：${esc(srcComment)}</div>` : ''}
      ${srcNote ? `<div class="pl-source">📕 来源：${esc(srcNote)}</div>` : ''}
      ${chatHistoryHtml}
      ${(s === 'prospect' && pf.intentLevel) ? `<textarea class="pl-reply-text" data-plid="${p.id}" placeholder="回复建议（自动生成，可修改）..." style="width:100%;min-width:560px;">${esc((p.replySuggest || '').trim())}</textarea>` : ''}
    </td>`;
    tbody.appendChild(detail);
  });
  // ★ 自动生成回复（默认给每个未生成过的卡片填充，串行避免并发打爆）
  {
    const needGen = [];
    container.querySelectorAll('.pl-reply-text').forEach(ta => {
      const person = list.find(p => p.id === ta.dataset.plid);
      if (person && person.stage === 'prospect' && person.profile && !(person.replySuggest || '').trim()) needGen.push(ta.dataset.plid);
    });
    if (needGen.length) {
      let chain = Promise.resolve();
      let done = 0;
      needGen.forEach(id => {
        chain = chain.then(async () => {
          const ta = container.querySelector(`.pl-reply-text[data-plid="${id}"]`);
          const person = list.find(p => p.id === id);
          if (!ta || !person || (person.replySuggest || '').trim()) return;
          try {
            const text = await generateDmText(person);
            if (ta) ta.value = text;
            person.replySuggest = text;
            try { await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { replySuggest: text } } }); } catch (_) {}
            done++;
            if (done === 1 || done % 10 === 0) addLog(`🤖 已自动生成 ${done}/${needGen.length} 条回复建议`, 'info');
          } catch (_) {}
        });
      });
    }
  }

  // ── 层内"状态/下一步"下拉（写入 v2 子状态；写 closed 自动升客户池）──
  container.querySelectorAll('.pl-status').forEach(sel => {
    sel.addEventListener('change', async () => {
      const id = sel.dataset.plid;
      const v = sel.value || '';
      const kind = sel.dataset.kind || 'status'; // status
      const person = list.find(p => p.id === id);
      if (!person) return;
      try {
        const updates = { status: v };
        const ids = [id, ..._samePersonIds(person)]; // 同人其余渠道/跨桶记录一并同步
        for (const sid of ids) {
          await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id: sid, updates } }).catch(() => {});
        }
        addLog(`✅ ${person.nickname} 商机状态 → ${v}` + (ids.length > 1 ? `（已同步 ${ids.length} 条渠道记录）` : ''), 'success');
        loadProspectList(container);
      } catch (e) {
        addLog(`❌ 更新状态失败：${e.message}`, 'error');
      }
    });
  });
  // ── 层内动作 + 底部动作（主页/移除） ──
  container.querySelectorAll('.pl-foot button').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.plid;
      const action = btn.dataset.action;
      const person = list.find(p => p.id === id);
      if (!person) return;
      if (action === 'locate') {
        btn.disabled = true; const _o = btn.textContent; btn.textContent = '⏳...';
        addLog(`📎 打开主页：${person.nickname}`, 'info');
        try {
          const r = await chrome.runtime.sendMessage({ action: 'enrichProspectByProfile', data: { person } });
          if (r && r.ok && r.xhsId) addLog(`✅ 已打开并抓取 ${r.name || person.nickname} · 小红书号:${r.xhsId}`, 'success');
          else if (r && r.ok) addLog(`✅ 已打开用户主页：${person.nickname}`, 'success');
          else addLog(`⚠️ ${(r && r.error) || '未完成'}`, 'warn');
          loadProspectList(container);
        } catch (e) { addLog(`❌ 打开主页失败：${e.message}`, 'error'); }
        btn.disabled = false; btn.textContent = _o; return;
      }
      else if (action === 'restore') {
        try {
          // 恢复 = 把「已废弃」状态改回「待触达」（废弃已并入状态体系）
          await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { status: '待触达', discarded: false } } });
          addLog(`↩️ 已恢复：${person.nickname}`, 'success');
        } catch (e) { addLog(`❌ 恢复失败：${e.message}`, 'error'); }
        loadProspectList(container); return;
      }
      else if (action === 'purge') {
        if (!window.confirm(`⚠️ 确认彻底删除 ${person.nickname}？该记录不可恢复！`)) return;
        await chrome.runtime.sendMessage({ action: 'deleteProspect', data: { id, hard: true } });
        addLog(`🗑️ 已彻底删除：${person.nickname}`, 'info');
        loadProspectList(container); return;
      }
      else if (action === 'remove') {
        if (!window.confirm(`确认将 ${person.nickname} 标废（移出清单，可在「🗑 已废弃」恢复）？`)) return;
        await chrome.runtime.sendMessage({ action: 'deleteProspect', data: { id } });
        addLog(`🗑️ 已标废：${person.nickname}`, 'info');
        loadProspectList(container); return;
      }
      else if (action === 'reply') {
        // 有会话 / 或领一个会话：先"逐条归因"该客户是否回过你 → 是则升商机(已回复)，否则标已触达·待回复；都在 /chat 里打开
        const convId = person.convId || '';
        const btnO = btn.textContent; btn.disabled = true; btn.textContent = '⏳ 判定…';
        if (convId) {
          try {
            const r = await chrome.runtime.sendMessage({ action: 'scanChatReply', data: { convId, personId: person.id, nickname: person.nickname } });
            if (r && r.ok) {
              if (r.promoted) addLog(`🎯 ${person.nickname}：对方回过你 → 已升级为商机（已回复）`, 'success');
              else addLog(r.theirs ? `💬 ${person.nickname}：对方回过你（商机池）` : `💬 ${person.nickname}：暂无对方回复，标「已触达·待回复」`, r.theirs ? 'success' : 'warn');
            } else addLog(`❌ 判定失败：${(r && r.error) || '未知'}`, 'error');
          } catch (e) { addLog('❌ 判定失败：' + e.message, 'error'); }
        } else {
          addLog('⚠️ 暂无会话，改为私信触达', 'warn');
          openDmModal(person);
          touchScenePrefill(person);
        }
        btn.disabled = false; btn.textContent = btnO;
        loadProspectList(container); return;
      }
      else if (action === 'profile') { runProfileOne([person], container); return; }
      else if (action === 'dm') {
        // 联系TA = 打开私信弹窗，直接自己写话术发；打开即自动填入已生成的 AI 话术（无则自动生成）
        //   同时把该人所有渠道记录的"待触达"置为"已触达"（状态跨渠道同步）
        openDmModal(person);
        if (!person.status || person.status === '待触达') {
          const ids = [id, ..._samePersonIds(person)];
          await Promise.all(ids.map(sid => chrome.runtime.sendMessage({ action: 'updateProspect', data: { id: sid, updates: { status: '已触达' } } }).catch(() => {})));
          if (container) loadProspectList(container);
        }
        return;
      }
      else if (action === 'maint') {
        // 成交维护话术：按 after_sale 场景生成 → 开私信弹窗填入
        btn.disabled = true; const _o2 = btn.textContent; btn.textContent = '⏳…';
        try {
          const r = await chrome.runtime.sendMessage({ action: 'aiCsTouch', data: { key: 'after_sale', person } });
          openDmModal(person);
          const dt = document.getElementById('dmText'); if (dt) dt.value = (r && r.ok && r.draft) || '';
          if (r && r.ok) addLog(`📣 已按「成交维护」生成 ${person.nickname} 的话术`, 'success');
        } catch (e) { addLog('❌ 维护话术生成失败：' + e.message, 'error'); }
        btn.disabled = false; btn.textContent = _o2;
        return;
      }
      else if (action === 'close') {
        // 成交在商机状态上作标注（不单独建客户层）
        await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { status: '已成交', funnel: Object.assign({}, _plFunnel(person), { step: 'closed' }) } } });
        addLog(`💰 ${person.nickname} 已成交标注（成交一般走线下/微信）`, 'success');
        loadProspectList(container); return;
      }
      else if (action === 'promote') {
        // AI 判断：适合的线索 → 标「高意向·待跟单」置顶（不升商机；商机=对方真回复，见 _isTwoWay）
        const _o = btn.textContent; btn.disabled = true; btn.textContent = '🧠 判断中…';
        try {
          const r = await chrome.runtime.sendMessage({ action: 'judgeLeadPromotion', data: { id } });
          if (r && r.ok) {
            if (r.promote) {
              await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { intentLevel: 'high', affinity: Object.assign({}, person.affinity || {}, { intentLevel: 'high' }) } } });
              addLog(`🧠 AI 判断高意向 → 已将 ${person.nickname} 置顶为「高意向·待跟单」（${r.reason || ''}）`, 'success');
            } else {
              addLog(`⏸ AI 判断暂不适合跟进：${r.reason || '需求不强'}（留在线索池，可稍后再判）`, 'warn');
            }
          } else {
            throw new Error((r && r.error) || 'AI 判断失败');
          }
        } catch (e) {
          addLog('❌ 升格判断失败：' + e.message, 'error');
        }
        btn.disabled = false; btn.textContent = _o;
        loadProspectList(container); return;
      }
    });
  });
  // ── 多选：勾选待删除；表头复选框=全选本页 ──
  const _syncHeaderSel = () => {
    const hdr = container.querySelector('#plHeaderSelectAll');
    const cbs = container.querySelectorAll('.pl-sel');
    let on = 0; cbs.forEach(cb => { if (cb.checked) on++; });
    if (hdr) { hdr.checked = cbs.length > 0 && on === cbs.length; hdr.indeterminate = on > 0 && on < cbs.length; }
  };
  const _selCountUI = () => {
    const d = document.getElementById('plBatchStatus');
    if (d && d.options.length) d.options[0].text = '批量改状态(' + _selectedIds.size + ')…';
    _syncHeaderSel();
  };
  const hdrSel = container.querySelector('#plHeaderSelectAll');
  if (hdrSel) hdrSel.addEventListener('change', () => {
    const on = hdrSel.checked;
    container.querySelectorAll('.pl-sel').forEach(cb => { cb.checked = on; });
    _selectedIds.clear();
    if (on) container.querySelectorAll('.pl-sel').forEach(cb => { if (cb.dataset.plid) _selectedIds.add(cb.dataset.plid); });
    _selCountUI();
  });
  container.querySelectorAll('.pl-sel').forEach(cb => {
    cb.addEventListener('change', () => {
      const id = cb.dataset.plid;
      if (cb.checked) _selectedIds.add(id); else _selectedIds.delete(id);
      _selCountUI();
    });
  });
  _syncHeaderSel();
  // ── 表格行：展开/收起详情 ──
  const _toggleDetail = (plid) => {
    const d = container.querySelector(`.pl-detail[data-plid="${plid}"]`);
    const t = container.querySelector(`.pl-toggle[data-plid="${plid}"]`);
    if (!d) return;
    const show = d.style.display === 'none';
    d.style.display = show ? '' : 'none';
    if (t) t.textContent = show ? '▾' : '▸';
  };
  container.querySelectorAll('.pl-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => { e.stopPropagation(); _toggleDetail(btn.dataset.plid); });
  });
  container.querySelectorAll('tr.pl-row').forEach(tr => {
    tr.addEventListener('click', (ev) => {
      if (ev.target.closest('button,select,input')) return;
      _toggleDetail(tr.dataset.plid);
    });
  });

  // ── 复制回复 ──
  container.querySelectorAll('.copy-inline').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.plid;
      const ta = container.querySelector(`.pl-reply-text[data-plid="${id}"]`);
      if (!ta || !ta.value) return;
      try {
        await navigator.clipboard.writeText(ta.value);
        btn.textContent = '✅ 已复制'; setTimeout(() => { btn.textContent = '📋 复制'; }, 1200);
      } catch (_) { ta.select(); document.execCommand('copy'); btn.textContent = '✅ 已复制'; setTimeout(() => { btn.textContent = '📋 复制'; }, 1200); }
    });
  });
  // 分页控制
  const pageNav = document.createElement('div');
  pageNav.className = 'pl-page';
  pageNav.innerHTML = `
    <button id="plPrev" ${_plPage === 0 ? 'disabled' : ''}>‹ 上一页</button>
    <span>第 ${_plPage + 1} / ${pageCount} 页 · 共 ${total} 人</span>
    <button id="plNext" ${_plPage >= pageCount - 1 ? 'disabled' : ''}>下一页 ›</button>`;
  container.appendChild(pageNav);
  pageNav.querySelector('#plPrev').addEventListener('click', () => { _plPage--; renderProspectList(container); });
  pageNav.querySelector('#plNext').addEventListener('click', () => { _plPage++; renderProspectList(container); });

  // ── 消息桶：⚪ 我方触达 折叠分组（默认收起，点开查看/去卖） ──
  if (_plStage === 'msg' && outList.length) {
    const sec = document.createElement('div');
    sec.className = 'pl-batch';
    const h = document.createElement('button');
    h.textContent = (_outboundCollapsed ? '▸' : '▾') + ' 我方触达（' + outList.length + '，默认收起的运营会话）';
    h.style.cssText = 'width:100%;text-align:left;font-size:12px;padding:6px 8px;border:1px solid var(--line);background:#f9fafb;color:#6b7280;border-radius:8px;cursor:pointer;font-weight:600;';
    h.addEventListener('click', () => { _outboundCollapsed = !_outboundCollapsed; renderProspectList(container); });
    sec.appendChild(h);
    if (!_outboundCollapsed) {
      outList.slice(0, 60).forEach(p => {
        const row = document.createElement('div');
        row.className = 'pl-card';
        const _s = _plStateOf(p, 'msg'); const _m = PL_STATE_META[_s] || PL_STATE_META.other;
        row.innerHTML =
          `<div class="pl-card-top"><span class="pl-nick">⚪ ${esc(p.nickname || '未知')}</span><span class="pl-badge" style="background:${_m.bg};color:${_m.c};">${_m.t}</span></div>` +
          `<div class="pl-source">📨 ${esc((p.lastMsg || '').slice(0, 60))}</div>` +
          `<div class="pl-foot"><button class="act send" data-plid="${p.id}" title="打开 /chat 会话开始卖">💬 去卖</button></div>`;
        const btn = row.querySelector('[data-plid]');
        btn.addEventListener('click', () => {
          const cid = p.convId || '';
          if (!cid) { addLog('⚠️ 无会话，请先从通知桶触达', 'warn'); return; }
          addLog(`💬 打开 ${p.nickname || '对方'} 的会话（去卖）`, 'info');
          chrome.runtime.sendMessage({ action: 'openChat', data: { convId: cid, personId: p.id } }).then(r => {
            if (r && r.ok) addLog('✅ 已打开会话', 'success'); else addLog('❌ 打开失败：' + ((r && r.error) || '未知'), 'error');
          }).catch(e => addLog('❌ 打开会话失败：' + e.message, 'error'));
        });
        container.appendChild(row);
      });
    }
    container.appendChild(sec);
  }

  }

// 刷新通知：只刷小红书通知（评论/@）数据，不再顺带刷消息 / 不跳页
async function _refreshCurrentTab(container) {
  const ok = await syncNotifToLeads(container);   // 只刷通知数据（含冷却：太频繁会跳过）
  if (!ok) return;
  await genMissingDrafts(container, false);       // 补生成没话术的
  if (container) loadProspectList(container);
}
async function syncNotifToLeads(container, opts) {
  const b = document.getElementById('plNotifRefresh') || document.getElementById('plSyncNotif');
  const bReset = document.getElementById('plNotifRefresh') ? '🔄 刷新通知' : '🔄 增量刷新通知';
  if (window.__lastNotifSyncAt && (Date.now() - window.__lastNotifSyncAt < 20000)) {
    const sec = Math.ceil((20000 - (Date.now() - window.__lastNotifSyncAt)) / 1000);
    addLog(`⏳ 刷新太频繁，请等 ${sec}s 再试`, 'warn');
    return false;
  }
  window.__lastNotifSyncAt = Date.now();
  if (_syncInFlight) return false;
  _syncInFlight = true;
  if (b) { b.disabled = true; b.textContent = '⏳ 刷新中…'; }
  // AI 打"是否产品相关"标记：配置了 AI 就走标记（不剔除任何人）；未配 AI 则仅全量收录
  const screen = true;
  addLog('🔄 增量刷新通知（前3屏）...', 'info');
  try {
    const r = await chrome.runtime.sendMessage({ action: 'collectLikersFromNotif', data: { screen, cap: NOTIF_SYNC_CAP } });
    if (r && r.ok) {
      const it = r.intents || {};
      const extra = [];
      if (it.high) extra.push('高' + it.high);
      if (it.medium) extra.push('中' + it.medium);
      if (it.low) extra.push('低' + it.low);
      const intendText = (screen && extra.length) ? '　意向：' + extra.join('/') : '';
      const capText = r.capped ? `　（另有 ${r.capped} 条超出上限，下轮再处理）` : '';
      const tabs = r.tabCounts || {};
      const tabText = (Object.keys(tabs).length) ? '　分工：' + ['评论和@', '新增关注', '赞和收藏'].filter(t => tabs[t] !== undefined).map(t => `${t}:${tabs[t]}`).join(' / ') : '';
      const aiTxt = screen
        ? ((r.aiError) ? ` ⚠️AI失败(${r.aiError})` : (r.screened ? ` · AI已标记 ${r.screened}（相关${it.high || 0}/中${it.medium || 0}/无关${it.low || 0}）` : ' · 未配AI或无需标记'))
        : '';
      addLog(`🔔 刷新通知：新增 ${r.added} · 已存在 ${r.already}` + tabText + capText + aiTxt, r.aiError ? 'warn' : 'success');
    } else {
      const err = (r && r.error) || '未知错误';
      addLog('❌ 刷新通知失败：' + err, 'error');
      if (b) window.alert('刷新通知失败：' + err + '\n\n请确保已登录小红书网页版并打开过通知页面。');
    }
    if (container) loadProspectList(container);
  } catch (e) {
    addLog('❌ 刷新通知失败：' + e.message, 'error');
    if (b) window.alert('刷新通知失败：' + e.message + '\n\n请先打开小红书网页版并登录。');
    if (container) loadProspectList(container);
  }
  _syncInFlight = false;
  if (b) { b.disabled = false; b.textContent = bReset; }
  return true;
}

// 刷新消息：拉 /chat 会话，AI 筛掉刷号玩/无关，相关的自动收进消息桶（未读标红）
async function syncChatInbound(container) {
  const b = document.getElementById('plSyncInbound');
  if (b) { b.disabled = true; b.textContent = '⏳ 刷新消息…'; }
  addLog('🔄 刷新消息（全量收录，不筛选）：读取 /chat 会话...', 'info');
  try {
    const r = await chrome.runtime.sendMessage({ action: 'syncChatInbound', data: { screen: false, full: true } });
    if (r && r.ok) {
      const ignTxt = (r.added > 0 || r.updated > 0 ? ' · 全量收录 ' + r.total + ' 条' : ' · 无可新增');
      addLog(`📨 刷新消息：新增 ${r.added} · 更新 ${r.updated} · 未读 ${r.unread}${ignTxt}`, r.unread > 0 ? 'warn' : 'success');
      if (container) {
        await loadProspectList(container); // 刷新桶视图（消息桶已持久化，直接列出）
      }
    } else {
      const err = (r && r.error) || '未知错误';
      addLog('❌ 刷新消息失败：' + err, 'error');
      if (b) window.alert('刷新消息失败：' + err + '\n\n请确认已登录小红书网页版并打开过消息中心。');
      if (container) loadProspectList(container);
    }
  } catch (e) {
    addLog('❌ 刷新消息失败：' + e.message, 'error');
    if (container) loadProspectList(container);
  }
  if (b) { b.disabled = false; b.textContent = '🔄 刷新消息'; }
}

// ═══════════ AI客服：配置读取（渠道基调/成交引导/问答话术的编辑在「线索 → 任务配置」） ═══════════
let _aiCs = null;
async function _aiCsLoad() {
  const r = await chrome.runtime.sendMessage({ action: 'getAiCsConfig', data: {} });
  if (!r || !r.ok) throw new Error((r && r.error) || '读取失败');
  return r.config;
}

// 通知回访：枚举待回复 → 按 notif_reply 场景草拟 → 发送（replyNotification 三重定位）
async function loadNotifReplies(container) {
  const box = container.querySelector('.aiCsNotifList');
  const btn = container.querySelector('.aiCsNotifSync');
  if (!box) return;
  box.innerHTML = '<div style="font-size:12px;color:#888;">同步通知页…</div>';
  if (btn) { btn.disabled = true; btn.textContent = '⏳ 同步中…'; }
  try {
    const r = await chrome.runtime.sendMessage({ action: 'getPendingNotifs', data: {} });
    if (!r || !r.ok) throw new Error((r && r.error) || '同步失败');
    const items = r.items || [];
    if (!items.length) { box.innerHTML = '<div style="font-size:12px;color:#888;">暂无待回复通知（你被回的新消息都在这里）。</div>'; }
    else {
      box.innerHTML = '';
      items.slice(0, 25).forEach((it, i) => renderNotifCard(box, it, i));
    }
  } catch (e) {
    box.innerHTML = '<div style="font-size:12px;color:#d33;">❌ ' + esc(e.message || '同步失败') + '<br>请确认小红书网页版已登录并打开。</div>';
  }
  if (btn) { btn.disabled = false; btn.textContent = '🔄 同步待回复通知'; }
}

function renderNotifCard(box, it, i) {
  const card = document.createElement('div');
  card.className = 'pl-card';
  card.innerHTML = `
    <div class="pl-card-top"><span class="pl-nick">${esc(it.userName || '对方')}</span><span style="font-size:11px;color:#8a8f99;margin-left:auto;">${esc(it.time || '')}</span></div>
    <div class="pl-source" style="font-size:12px;">💬 ${esc(it.incoming)}</div>
    <textarea class="pl-draft-text" rows="2" style="width:100%;box-sizing:border-box;font-size:12px;border:1px solid #e5d9ff;border-radius:8px;padding:6px 8px;margin-top:6px;" placeholder="草拟（按 notif_reply 场景）…"></textarea>
    <div style="display:flex;gap:6px;margin-top:6px;">
      <button class="nf-ai" style="font-size:11px;padding:4px 10px;border:1px solid #7c3aed;background:#f5f3ff;color:#6d28d9;border-radius:6px;cursor:pointer;">🤖 按场景草拟</button>
      <button class="nf-send" style="font-size:11px;padding:4px 10px;border:1px solid #ef4444;background:#fef2f2;color:#dc2626;border-radius:6px;cursor:pointer;">📤 发送</button>
    </div>`;
  const ta = card.querySelector('.pl-draft-text');
  const aiBtn = card.querySelector('.nf-ai');
  const sendBtn = card.querySelector('.nf-send');
  aiBtn.addEventListener('click', async () => {
    aiBtn.disabled = true; aiBtn.textContent = '⏳ 生成中…';
    try {
      const r = await chrome.runtime.sendMessage({ action: 'aiCsTouch', data: { key: 'notif_reply', context: it.incoming, person: { nickname: it.userName, source: { comment: it.incoming } } } });
      if (r && r.ok) ta.value = r.draft;
      else throw new Error((r && r.error) || '生成失败');
    } catch (e) { ta.value = ''; ta.placeholder = '❌ ' + (e.message || '生成失败'); }
    aiBtn.disabled = false; aiBtn.textContent = '🤖 按场景草拟';
  });
  sendBtn.addEventListener('click', async () => {
    const text = ta.value.trim();
    if (!text) { addLog('⚠️ 先草拟或手写内容', 'warn'); return; }
    sendBtn.disabled = true; sendBtn.textContent = '⏳ 发送中…';
    try {
      const r = await chrome.runtime.sendMessage({ action: 'sendNotifReply', data: { idx: it.idx, replyText: text, userId: it.userId, userName: it.userName, latestText: it.incoming } });
      if (r && r.ok) { addLog('✅ 已回复 ' + (it.userName || ''), 'success'); card.remove(); }
      else addLog('❌ 回访失败：' + ((r && r.error) || '未知'), 'error');
    } catch (e) { addLog('❌ 回访失败：' + e.message, 'error'); }
    sendBtn.disabled = false; sendBtn.textContent = '📤 发送';
  });
  box.appendChild(card);
}

// 单个/批量画像
async function runProfileOne(targets, container) {
  const candidates = targets.map(p => ({
    id: p.id,
    userId: p.userId,
    nickname: p.nickname,
    source: p.source,
  }));
  addLog(`⚡ 开始画像 ${candidates.length} 人...`, 'info');
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'profileProspects', data: { candidates } });
    if (!resp || !resp.ok) throw new Error((resp && resp.error) || '画像失败');
    if (resp.applied && resp.applied.length > 0) {
      addLog(`✅ 画像完成：${resp.applied.length} 人已生成画像`, 'success');
      // 允许手动微调（逐个弹出编辑）
      const editable = resp.applied.filter(a => a.id);
      if (editable.length > 0) {
        // 打开第一个的编辑弹窗（数据已落库，编辑后重新加载）
        const person = targets.find(t => t.id === editable[0].id);
        if (person) {
          openProfileModal(person, container);
          return;
        }
      }
    } else {
      addLog('⚠️ 画像完成，但 AI 未返回可用结果，请重试或手动编辑', 'warn');
    }
  } catch (e) {
    addLog('❌ 画像失败：' + e.message, 'error');
    window.alert('画像失败：' + e.message);
  }
  loadProspectList(container);
}

// 画像编辑弹窗
function openProfileModal(person, container) {
  const mask = document.getElementById('profileModal');
  if (!mask) return;
  const pf = person.profile || {};
  document.getElementById('pfTags').value = (pf.tags || []).join(',');
  document.getElementById('pfIdentity').value = pf.identity || '';
  document.getElementById('pfNeeds').value = pf.needs || '';
  document.getElementById('pfPain').value = pf.painPoints || '';
  document.getElementById('pfAngle').value = pf.dmAngle || '';
  mask.classList.add('open');
  mask.dataset.plid = person.id;
}

// 私信弹窗
function openDmModal(person) {
  const mask = document.getElementById('dmModal');
  if (!mask) return;
  mask.dataset.plid = person.id;
  const profile = person.profile || {};
  const src = person.source || {};
  const summaryHtml =
    `<b>${esc(person.nickname)}</b> · 意向：${profile.intentLevel || '未画像'}<br>` +
    (profile.identity ? `身份：${esc(profile.identity)}<br>` : '') +
    (profile.needs ? `需求：${esc(profile.needs)}<br>` : '') +
    (profile.painPoints ? `痛点：${esc(profile.painPoints)}<br>` : '') +
    (profile.dmAngle ? `切入：${esc(profile.dmAngle)}<br>` : '') +
    `来源：${esc(src.comment || '').slice(0, 60)}`;
  document.getElementById('dmModalSummary').innerHTML = summaryHtml;
  const _preset = (person && person.dmDraft) || '';
  const dmTextEl = document.getElementById('dmText');
  dmTextEl.value = _preset;
  dmTextEl.placeholder = _preset ? '私信内容...' : '正在生成话术…';
  document.getElementById('dmResult').textContent = '';
  const dmT = document.getElementById('dmTiming'); if (dmT) dmT.textContent = '';
  const dmTB = document.getElementById('dmTimingBtn'); if (dmTB) { dmTB.disabled = false; dmTB.textContent = '🎯 判断销售时机'; }
  document.getElementById('dmGenBtn').disabled = false;
  document.getElementById('dmSendBtn').disabled = false;
  // 升格按钮仅"线索池"显示（私信前可先 AI 判断是否值得升商机）；商机池隐藏
  const prom = document.getElementById('dmPromoteBtn');
  if (prom) { prom.disabled = false; prom.textContent = '🧠 高意向跟进'; prom.style.display = (_plGetStage(person) === 'lead') ? '' : 'none'; }
  mask.classList.add('open');
  // 无现成话术时，打开即自动生成并填入，生成后写回 dmDraft，下次直接命中
  if (!_preset.trim()) {
    generateDmText(person).then((t) => {
      const el = document.getElementById('dmText');
      if (t && el && mask.classList.contains('open')) { el.value = t; el.placeholder = '私信内容...'; }
      if (t && person && person.id) chrome.runtime.sendMessage({ action: 'updateProspect', data: { id: person.id, updates: { dmDraft: t } } }).catch(() => {});
    }).catch(() => {});
  }
}

// 生成私信话术（AI）
async function generateDmText(person) {
  const resp = await chrome.runtime.sendMessage({ action: 'generateDm', data: { person } });
  if (resp && resp.ok && resp.dmText) return resp.dmText;
  throw new Error((resp && resp.error) || 'AI 话术生成失败');
}

// 私信发送流程（含 AI 生成 + 人工确认）
let _gateOverrideArm = false; // 用户在私信弹窗里确认过"仍要发送"→ 下次发送强制跳过主页意向甄别

async function sendDmFlow(person, auto, textOverride) {
  const text = (typeof textOverride === 'string' && textOverride)
    ? textOverride
    : (document.getElementById('dmText') ? document.getElementById('dmText').value.trim() : '');
  if (!text) {
    addLog('❌ 私信内容为空', 'error');
    return false;
  }
  const resp = await chrome.runtime.sendMessage({
    action: 'sendDm',
    data: { person, text, aiGenerated: true, force: _gateOverrideArm },
  });
  // ★ 前置意向甄别拦下（低/无关）：先提示原因，再点一次「发送」即强制发出
  if (resp && resp.gated) {
    const r = document.getElementById('dmResult');
    const btn = document.getElementById('dmSendBtn');
    if (!_gateOverrideArm) {
      _gateOverrideArm = true;
      if (r) { r.innerHTML = ('🚫 ' + esc((resp.error || '低意向').split('\n')[0])) + '<br><b>再点一次「发送」= 强制发出</b>'; r.className = 'pl-result warn'; }
      if (btn) btn.textContent = '⚠️ 仍要发送';
      addLog('🚫 前置甄别拦下（见弹窗原因），再次点击可强制发送', 'warn');
      return false;
    }
    _gateOverrideArm = false;
    if (btn) btn.textContent = '📤 发送';
    if (r) { r.textContent = '已按你确认强制发送（低意向）。'; r.className = 'pl-result ok'; }
  } else {
    _gateOverrideArm = false;
  }
  if (resp && resp.ok && resp.navigating) {
    addLog(`ℹ️ ${resp.notice || '已打开用户主页，请手动发送'}：${person.nickname}`, 'warn');
    const r = document.getElementById('dmResult');
    if (r) { r.textContent = resp.notice || '已打开用户主页，请手动发送'; r.className = 'pl-result warn'; }
    return false;
  }
  if (!resp || !resp.ok) {
    const limited = resp && resp.limited;
    addLog(`❌ 私信发送失败${limited ? '（可能被限制，建议改为评论互动破冰）' : ''}：${(resp && resp.error) || '未知'}`, 'error');
    if (!auto) {
      const r = document.getElementById('dmResult');
      if (r) r.textContent = (resp && resp.error) || '发送失败';
    }
    return false;
  }
  return true;
}

// 弹窗按钮绑定（在文档初始化处调用一次）
function bindProspectModals() {
  const dmMask = document.getElementById('dmModal');
  const dmGenBtn = document.getElementById('dmGenBtn');
  const dmSendBtn = document.getElementById('dmSendBtn');
  const dmText = document.getElementById('dmText');
  const dmResult = document.getElementById('dmResult');
  if (dmMask) {
    dmMask.addEventListener('click', e => { if (e.target === dmMask) closeDmModal(); });
    document.getElementById('dmCancelBtn')?.addEventListener('click', closeDmModal);
    const dmSceneBtn = document.getElementById('dmSceneBtn');
    dmSceneBtn?.addEventListener('click', async () => {
      const person = getPlPerson(dmMask.dataset.plid);
      if (!person) return;
      // ★ 不传 key → 由后台按 层/渠道 动态选 A 触达场景（线索→dm_first/notif_reply；商机→chat_follow/after_sale）
      dmSceneBtn.disabled = true; dmSceneBtn.textContent = '⏳ 场景话术中…'; dmResult.textContent = '';
      try {
        const resp = await chrome.runtime.sendMessage({ action: 'aiCsTouch', data: { key: '', person } });
        if (resp && resp.ok) {
          dmText.value = resp.draft || '';
          dmResult.textContent = '🎧 已按「' + (resp.scene || sceneKey) + '」场景生成（可改用「AI生成」走画像话术）';
          dmResult.className = 'pl-result ok';
        } else { dmResult.textContent = (resp && resp.error) || '生成失败'; dmResult.className = 'pl-result fail'; }
      } catch (e) { dmResult.textContent = e.message; dmResult.className = 'pl-result fail'; }
      dmSceneBtn.disabled = false; dmSceneBtn.textContent = '🎧 场景话术';
    });
    dmGenBtn?.addEventListener('click', async () => {
      const person = getPlPerson(dmMask.dataset.plid);
      const raw = dmText.value.trim();
      if (!raw) { dmResult.textContent = '先在上面输入你的话术，再点「优化话术」'; dmResult.className = 'pl-result warn'; return; }
      dmGenBtn.disabled = true;
      dmGenBtn.textContent = '✨ 优化中...';
      dmResult.textContent = '';
      try {
        const resp = await chrome.runtime.sendMessage({ action: 'optimizeDm', data: { text: raw, person } });
        if (resp && resp.ok && resp.text) {
          dmText.value = resp.text;
          dmResult.textContent = '✅ 已优化：改得更自然口语（不改变原意图/引导），请再检查后发送';
          dmResult.className = 'pl-result ok';
        } else {
          dmResult.textContent = (resp && resp.error) || '优化失败';
          dmResult.className = 'pl-result fail';
        }
      } catch (e) {
        dmResult.textContent = e.message;
        dmResult.className = 'pl-result fail';
      }
      dmGenBtn.disabled = false;
      dmGenBtn.textContent = '✨ 优化话术';
    });
    // 🎯 AI 判断销售时机：决定是否现在用统一话术联系该候选
    const dmTimingBtn = document.getElementById('dmTimingBtn');
    const dmTiming = document.getElementById('dmTiming');
    dmTimingBtn?.addEventListener('click', async () => {
      const person = getPlPerson(dmMask.dataset.plid);
      if (!person) return;
      dmTimingBtn.disabled = true;
      dmTimingBtn.textContent = '🎯 判断中...';
      dmTiming.innerHTML = '<span class="loading-spinner" style="display:inline-block;width:12px;height:12px;border:2px solid;border-top-color:transparent;border-radius:50%;margin-right:6px;vertical-align:middle;"></span> AI 正在判断销售时机...';
      dmTiming.className = 'pl-result';
      try {
        const resp = await chrome.runtime.sendMessage({ action: 'judgeSaleTiming', data: { person } });
        if (resp && resp.ok) {
          const map = {
            now: { t: '🔥 时机成熟', c: '#16a34a' },
            warm_up: { t: '🌡️ 先破冰', c: '#f59e0b' },
            wait: { t: '⏳ 暂缓', c: '#6b7280' },
          };
          const m = map[resp.timing] || { t: resp.timing, c: '#6b7280' };
          dmTiming.innerHTML =
            `<div style="font-size:14px;font-weight:600;color:${m.c};">${m.t} · 意向：${resp.intent === 'high' ? '高' : resp.intent === 'medium' ? '中' : '低'}</div>` +
            `<div style="font-size:12px;color:#666;margin-top:3px;">💡 ${esc(resp.reason || '')}</div>` +
            ` ${resp.hook ? `<div style="font-size:12px;color:#7c3aed;margin-top:3px;">🎣 切入：${esc(resp.hook)}</div>` : ''}` +
            (resp.suggestedAction ? `<div style="font-size:13px;font-weight:600;color:${m.c};margin-top:5px;">✅ 建议：${esc(resp.suggestedAction)}</div>` : '');
          dmTiming.className = 'pl-result ok';
          addLog(`🎯 ${person.nickname} 销售时机：${m.t}（${resp.intent || ''}）— ${(resp.reason || '').slice(0, 40)}`, 'info');
        } else {
          dmTiming.textContent = (resp && resp.error) || '判断失败';
          dmTiming.className = 'pl-result fail';
        }
      } catch (e) {
        dmTiming.textContent = e.message;
        dmTiming.className = 'pl-result fail';
      }
      dmTimingBtn.disabled = false;
      dmTimingBtn.textContent = '🎯 判断销售时机';
    });
    // ⚡ 画像/编辑：进私信弹窗右上角，发信前先画像（无画像自动跑 AI，已有直接编辑）
    const dmProfileBtn = document.getElementById('dmProfileBtn');
    dmProfileBtn?.addEventListener('click', async () => {
      const person = getPlPerson(dmMask.dataset.plid);
      if (!person) return;
      if (person.profile && person.profile.intentLevel) {
        openProfileModal(person, null);
      } else {
        addLog(`⚡ 为 @${person.nickname} AI 画像...`, 'info');
        await runProfileOne([person], document.getElementById('prospectContent') || document.body);
      }
    });
    // 🧠 高意向跟进（仅线索在用）：私信前的 AI 判断，合适即升商机
    const dmPromoteBtn = document.getElementById('dmPromoteBtn');
    dmPromoteBtn?.addEventListener('click', async () => {
      const id = dmMask.dataset.plid;
      const person = getPlPerson(id);
      if (!person || _plGetStage(person) !== 'lead') return;
      dmPromoteBtn.disabled = true; dmPromoteBtn.textContent = '🧠 判断中…';
      try {
        const r = await chrome.runtime.sendMessage({ action: 'judgeLeadPromotion', data: { id } });
        if (r && r.ok) {
          if (r.promote) {
            await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { intentLevel: 'high', affinity: Object.assign({}, person.affinity || {}, { intentLevel: 'high' }) } } });
            addLog(`🧠 AI 判断高意向 → 已将 ${person.nickname} 置顶为「高意向·待跟单」（${r.reason || ''}）`, 'success');
            dmPromoteBtn.style.display = 'none';
          } else {
            addLog(`⏸ AI 判断暂不适合跟进：${r.reason || '需求不强'}`, 'warn');
          }
        } else {
          addLog('❌ 升格判断失败：' + ((r && r.error) || '未知'), 'warn');
        }
      } catch (e) {
        addLog('❌ 升格判断异常：' + e.message, 'warn');
      }
      dmPromoteBtn.disabled = false; dmPromoteBtn.textContent = '🧠 高意向跟进';
    });
    dmSendBtn?.addEventListener('click', async () => {
      const person = getPlPerson(dmMask.dataset.plid);
      if (!person) return;
      dmSendBtn.disabled = true;
      const ok = await sendDmFlow(person, false);
      if (ok) {
        dmResult.textContent = '✅ 私信已发送';
        dmResult.className = 'pl-result ok';
        addLog(`✅ 私信已发送给 ${person.nickname}`, 'success');
        setTimeout(() => { closeDmModal(); loadProspectList(document.getElementById('prospectContent')); }, 900);
      } else {
        dmSendBtn.disabled = false;
      }
    });
  }
  const pfMask = document.getElementById('profileModal');
  if (pfMask) {
    pfMask.addEventListener('click', e => { if (e.target === pfMask) closeProfileModal(); });
    document.getElementById('pfCancelBtn')?.addEventListener('click', closeProfileModal);
    document.getElementById('pfSaveBtn')?.addEventListener('click', async () => {
      const id = pfMask.dataset.plid;
      const tags = document.getElementById('pfTags').value.split(/[,，、\s]+/).map(s => s.trim()).filter(Boolean);
      const profile = {
        tags,
        identity: document.getElementById('pfIdentity').value.trim(),
        needs: document.getElementById('pfNeeds').value.trim(),
        painPoints: document.getElementById('pfPain').value.trim(),
        dmAngle: document.getElementById('pfAngle').value.trim(),
      };
      const resp = await chrome.runtime.sendMessage({ action: 'updateProspect', data: { id, updates: { profile } } });
      if (resp && resp.ok) {
        addLog('✅ 画像已保存', 'success');
        closeProfileModal();
        loadProspectList(document.getElementById('prospectContent'));
      }
    });
  }
}
function closeDmModal() { document.getElementById('dmModal')?.classList.remove('open'); if (_touchBatchActive) { setTimeout(() => _touchNext(), 120); } }
function closeProfileModal() { document.getElementById('profileModal')?.classList.remove('open'); }

// 触达：按渠道自动生成 A 场景话术预填私信弹窗（dm_first / notif_reply / chat_follow 由后台推导）
async function touchScenePrefill(person) {
  const dt = document.getElementById('dmText'); if (!dt) return;
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'aiCsTouch', data: { key: '', person } });
    if (resp && resp.ok && resp.draft) {
      dt.value = resp.draft;
      const r = document.getElementById('dmResult');
      if (r && r.textContent === '') { r.textContent = '🎧 已按「' + (resp.scene || '触达') + '」场景预填，可修改后发送'; r.className = 'pl-result ok'; }
    }
  } catch (e) { /* 预填失败不阻塞，仍可手动「场景话术/AI生成」 */ }
}

// ★ 批量触达（全自动）：只处理【勾选】的通知线索，AI 草拟后自动发送，逐条随机间隔发送
async function batchTouchAuto(container) {
  const ids = Array.from(_selectedIds);
  if (!ids.length) { addLog('⚠️ 未勾选任何线索：请先勾选要触达的人，再点批量触达', 'warn'); return; }
  let leads = _plData.list.filter(p => p && p.id && ids.includes(p.id) && _plBucket(p) === 'notif' && !p.convId && !p.dmBlocked);
  if (!leads.length) { addLog('⚠️ 勾选的人里没有可自动触达的（可能已在会话/受限/非通知桶）', 'warn'); return; }
  if (!window.confirm(`将自动私信以下 ${leads.length} 人：\n${leads.map(l => '· ' + (l.nickname || '未知')).join('\n')}\n\n请确认无 <b>微信/链接</b> 等违规词（请自行确认内容合规），且已登录小红书。`)) return;
  const _s = (ms) => new Promise(r => setTimeout(r, ms));
  setLockBanner(true, 'touchAuto');
  let ok = 0, blocked = 0, gated = 0, fail = 0;
  for (const p of leads) {
    const nick = p.nickname || '未知';
    try {
      // ① 话术优先用「刷新时已存好的 dmDraft」；没有（未走刷新/老数据）才临时 AI 写一次
      let draft = (p.dmDraft || '').trim();
      let via = '刷新已存';
      if (!draft) {
        via = 'AI现写';
        const r = await chrome.runtime.sendMessage({ action: 'generateDm', data: { person: p } });
        draft = ((r && r.ok && r.dmText) || '').trim();
      }
      if (!draft) { fail++; addLog(`⚠️ ${nick}：没有可发送的话术，跳过`, 'warn'); continue; }
      // ② 自动发送（后台导航聊天窗 + 发送；前置会先对低意向者开主页甄别）
      const sent = await chrome.runtime.sendMessage({ action: 'sendDm', data: { person: p, text: draft, aiGenerated: true } });
      if (sent && sent.ok) { ok++; addLog(`✉️ 已自动触达 ${nick}（${via}）`, 'success'); }
      else if (sent && sent.gated) { gated++; addLog(`🚫 ${nick}：${((sent.error || '低意向').split('\n')[0])} → 已略过，不上眼药`, 'warn'); }
      else if (sent && sent.limited) { blocked++; addLog(`⛔ ${nick}：私信受限，跳过`, 'warn'); }
      else throw new Error((sent && sent.error) || '发送失败');
    } catch (e) {
      if (e && e.limited) { blocked++; addLog(`⛔ ${nick}：私信受限，跳过`, 'warn'); }
      else if (e && e.gated) { gated++; addLog(`🚫 ${nick}：${String((e && e.gateReason) || '低意向').slice(0, 80)} → 略过`, 'warn'); }
      else { fail++; addLog(`❌ ${nick}：${e.message}`, 'error'); }
    }
    await _s(3000 + Math.random() * 5000); // 逐条随机 3~8 秒，避免连发
  }
  setLockBanner(false, 'touchAuto');
  _selectedIds.clear();
  addLog(`🏁 批量触达完成：成功 ${ok} · 略过低意向 ${gated} · 受限 ${blocked} · 失败 ${fail}`, ok > 0 ? 'success' : (fail ? 'error' : 'warn'));
  loadProspectList(container);
}

// 批量触达：仅线索池逐条预填 A 场景话术到私信弹窗，发送或关闭即进入下一位（草拟·确认，无自动）
function batchTouchDraft(list, container) {
  const leads = (list || []).filter(p => p && p.id && _plBucket(p) === 'notif' && !p.convId && !p.dmBlocked);
  if (!leads.length) { addLog('⚠️ 当前没有可触达的线索', 'warn'); return; }
  addLog(`✉️ 开始批量触达 ${leads.length} 条线索（逐条确认，发送或关闭弹窗进入下一位）`, 'info');
  _touchQueue = leads.slice();
  _touchNext();
}
function _touchNext() {
  if (_touchBusy) return; _touchBusy = true;
  let person = null;
  while (_touchQueue.length) {
    const c = _touchQueue.shift();
    if (c && c.id && _plBucket(c) === 'notif' && !c.convId) { person = c; break; }
  }
  if (!person) {
    _touchBatchActive = false;
    addLog('✅ 批量触达结束', 'success');
    const pc = document.getElementById('prospectContent');
    if (pc && pc.style.display !== 'none') loadProspectList(pc);
    _touchBusy = false; return;
  }
  _touchBatchActive = true;
  addLog(`✉️ 触达 @${(person.nickname || '未知')}：请在弹窗确认/修改后发送，关闭或发送即进入下一位`, 'info');
  openDmModal(person);
  touchScenePrefill(person);
  _touchBusy = false;
}
function getPlPerson(id) {
  return _plData.list.find(p => p.id === id) || null;
}

/* ─── 版本 / 授权控制 ─── */
let _editionCache = null;

/** 获取版本状态（带缓存），失败时返回 null */
async function getEditionStatus() {
  if (_editionCache) return _editionCache;
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'getEdition' });
    if (resp && resp.edition) { _editionCache = resp; return resp; }
  } catch (e) {
    console.warn('[版本] 获取版本状态失败:', e);
  }
  return null;
}

/** 判断某功能在当前版本是否可用（默认放行，避免消息失败误锁） */
function editionFeatureOn(name) {
  if (!_editionCache || !_editionCache.edition || !_editionCache.edition.features) return true;
  return !!_editionCache.edition.features[name];
}

/** 显示到期锁定全屏遮罩，锁死所有操作 */
function showExpiredMask(edition) {
  if (document.getElementById('editionExpiredMask')) return;
  const licensee = (edition && edition.licensee) ? ('（授权：' + esc(edition.licensee) + '）') : '';
  const mask = document.createElement('div');
  mask.id = 'editionExpiredMask';
  mask.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(30,30,30,0.94);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;';
  mask.innerHTML = `
    <div style="font-size:44px;margin-bottom:12px;">⛔</div>
    <div style="font-size:18px;font-weight:600;margin-bottom:8px;">授权已到期</div>
    <div style="font-size:13px;color:#ddd;line-height:1.7;max-width:280px;">
      当前版本使用期限已结束${licensee}，功能已锁定。<br>如需继续使用，请联系服务商续期或获取新版本。
    </div>`;
  document.body.appendChild(mask);
}

/** 显示无网络锁定遮罩（无法获取网络时间，安全策略锁定） */
function showNoNetworkMask() {
  if (document.getElementById('editionExpiredMask')) return;
  const mask = document.createElement('div');
  mask.id = 'editionExpiredMask';
  mask.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(30,30,30,0.94);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;';
  mask.innerHTML = `
    <div style="font-size:44px;margin-bottom:12px;">🌐</div>
    <div style="font-size:18px;font-weight:600;margin-bottom:8px;">无法连接网络</div>
    <div style="font-size:13px;color:#ddd;line-height:1.7;max-width:280px;">
      本插件需要联网运行以验证授权状态。<br>请检查网络连接后重试。
    </div>`;
  document.body.appendChild(mask);
}

/** 在顶栏状态徽标上展示版本与剩余天数 */
function renderEditionBadge(status) {
  const ed = status && status.edition; if (!ed) return;
  const badge = document.getElementById('statusBadge');
  if (!badge) return;
  let txt = ed.label || '';
  if (!ed.neverExpires) {
    const d = status.remainingDays;
    if (typeof d === 'number') txt += d <= 0 ? '｜今天到期' : `｜剩${d}天`;
  }
  badge.textContent = txt || '就绪';
  const bound = ed.boundAccount || {};
  const bindTxt = bound.xhsId ? (bound.name ? `｜绑定：${bound.xhsId}（${bound.name}）` : `｜绑定：${bound.xhsId}`) : '';
  badge.title = (ed.licensee ? ('授权：' + ed.licensee) : '') + bindTxt;
}

/** 账号绑定校验与展示（绑定版）：顶栏提示绑定号；校验不过则全屏锁定 */
async function applyAccountBindToPopup() {
  try {
    const st = await getEditionStatus();
    if (!st || !st.edition || !st.edition.hasBinding) return;
    const bound = st.edition.boundAccount || { xhsId: '', name: '' };
    const badge = document.getElementById('statusBadge');
    if (badge) {
      badge.title = (badge.title || '') + (bound.name ? `｜绑定：${bound.xhsId}（${bound.name}）` : `｜绑定：${bound.xhsId}`);
    }
    let r = null;
    try { r = await chrome.runtime.sendMessage({ action: 'accountGuarantee' }); } catch (_) {}
    const ok = !!(r && r.ok);
    const badgeEl = document.getElementById('statusBadge');
    if (badgeEl && ok) {
      badgeEl.textContent = (badgeEl.textContent || '') + ' ✓';
    }
    if (!ok && !_acctVerifiedInSession && !document.getElementById('accountLockBanner')) {
      const reason = (r && r.reason) || '账号不匹配';
      const b = document.createElement('div');
      b.id = 'accountLockBanner';
      b.style.cssText = 'position:fixed;inset:0;z-index:99990;background:rgba(30,30,30,0.95);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;';
      b.innerHTML = `
        <div style="font-size:44px;margin-bottom:12px;">🔒</div>
        <div style="font-size:18px;font-weight:600;margin-bottom:8px;">账号校验未通过</div>
        <div style="font-size:13px;color:#ddd;line-height:1.9;max-width:330px;">
          本工具已绑定小红书号「${esc(bound.xhsId || '')}」，仅该账号可使用。<br>
          ${esc(reason)}<br>
          打开你自己的小红书「我的」主页，保持网页打开，然后回来点下方按钮。<br>
          <span id="acctPopVerifyMsg" style="display:block;color:#ffd666;margin-top:6px;min-height:18px;font-size:12px;"></span>
        </div>
        <div style="margin-top:16px;display:flex;gap:10px;">
          <button id="acctPopVerifyBtn" onclick="verifyAccountNow()" style="padding:9px 20px;border:none;border-radius:8px;background:#ff274b;color:#fff;font-size:14px;font-weight:600;cursor:pointer;transition:transform .08s ease, background-color .15s ease, opacity .2s ease;box-shadow:0 2px 6px rgba(255,39,75,.35);">立即验证</button>
          <button onclick="document.getElementById('accountLockBanner').remove()" style="padding:9px 16px;border:1px solid #555;border-radius:8px;background:transparent;color:#bbb;font-size:14px;cursor:pointer;">知道了</button>
        </div>
        <style>
          #acctPopVerifyBtn:active{ transform:scale(.93); }
          #acctPopVerifyBtn[data-loading="1"]{ opacity:.75; cursor:wait; }
          @keyframes acctSpin{ to{ transform:rotate(360deg);} }
          .acct-spinner{ display:inline-block; width:14px; height:14px; margin-right:6px; vertical-align:-2px; border:2px solid rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; animation:acctSpin .7s linear infinite; }
          #acctPopVerifyMsg{ transition:opacity .15s ease; }
        </style>`;
      document.body.appendChild(b);
    }
  } catch (_) {}
}

/** 监听账号校验缓存变化：在其它入口(设置/向导)验证通过后，本弹窗立即解锁，无需重开 */
function wireAccountGuardWatcher() {
  try {
    chrome.storage.onChanged.addListener((changes, area) => {
      if (area !== 'local' || !changes['_acct_guard']) return;
      const v = changes['_acct_guard'].newValue;
      if (v && v.matched) {
        _acctVerifiedInSession = true;
        const b = document.getElementById('accountLockBanner'); if (b) b.remove();
        const msg = document.getElementById('acctPopVerifyMsg'); if (msg) msg.textContent = '';
        if (typeof ensureFirstSetup === 'function') ensureFirstSetup(); // 验证通过且缺 AI → 直接在 popup 展示首次设置
        if (typeof applyAccountBindToPopup === 'function') applyAccountBindToPopup();
      }
    });
  } catch (_) {}
}

/** 弹窗锁定遮罩的“立即验证”：主动请求 background 探测当前小红书的打开页面实时校验 */
async function verifyAccountNow() {
  const btn = document.getElementById('acctPopVerifyBtn');
  const msg = document.getElementById('acctPopVerifyMsg');
  if (msg) { msg.textContent = ''; msg.style.color = '#ffd666'; }
  if (btn) {
    btn.dataset.loading = '1';
    btn.disabled = true;
    btn.innerHTML = '<span class="acct-spinner"></span>验证中…';
  }
  const t0 = Date.now();
  let r = null;
  try { r = await chrome.runtime.sendMessage({ action: 'accountGuarantee', forceNow: true }); } catch (e) { r = null; }
  const wait = Math.max(0, 750 - (Date.now() - t0)); // 至少展示 0.75s，别点完一闪而过
  await new Promise(res => setTimeout(res, wait));
  if (r && r.ok) {
    _acctVerifiedInSession = true;
    if (typeof ensureFirstSetup === 'function') ensureFirstSetup(); // 验证通过且缺 AI → 直接在 popup 展示首次设置
    if (msg) { msg.textContent = '✅ 验证通过，已解锁'; msg.style.color = '#7bd88f'; }
    if (btn) { btn.dataset.loading = '0'; btn.disabled = false; btn.innerHTML = '✓ 已通过'; }
    setTimeout(() => {
      const banner = document.getElementById('accountLockBanner');
      if (banner) banner.remove();
    }, 500);
    return;
  }
  if (btn) {
    btn.dataset.loading = '0';
    btn.disabled = false;
    btn.innerHTML = '重新验证';
  }
  if (msg) { msg.textContent = '❌ ' + ((r && r.reason) || '验证失败，请确认已在网页版登录绑定账号并打开本人主页后重试'); msg.style.color = '#ffb3c1'; }
}

/** 应用版本限制：到期锁定 + 按功能开关灰显并标注受限功能（不隐藏，让用户知道升级可解锁） */
async function applyEditionToPopup() {
  const status = await getEditionStatus();
  if (!status || !status.edition) return; // 拿不到就放行（dev 或消息异常）
  const ed = status.edition;
  // 1) 无网络锁定
  if (status.noNetwork) { showNoNetworkMask(); return; }
  // 2) 到期锁定
  if (status.expired) { showExpiredMask(ed); return; }
  // 3) 顶栏展示版本
  renderEditionBadge(status);
  // 3.5) 账号绑定（绑定版）：校验当前登录账号
  applyAccountBindToPopup();
  // 4) 批量发送（自动评论）——未开通时灰显锁定 ▾ 下拉入口
  if (!ed.features || !ed.features.batchSend) {
    const btn = document.getElementById('commentCaret');
    if (btn) {
      btn.disabled = true;
      btn.dataset.locked = '1';
      btn.style.opacity = '0.45';
      btn.style.cursor = 'not-allowed';
      btn.style.filter = 'grayscale(1)';
      btn.title = '当前版本（' + (ed.label || '') + '）不含整页批量发送，仅支持逐条一键发送；升级更高版本解锁';
    }
  }
  // 4) 租户切换器：三档全开（tenant 恒为 true），不再做灰显锁定
  // 5) 一键灌水笔记列表（左侧面板依赖灌水功能）——未开通时直接隐藏整个笔记列表，右侧评论助手占满窗口自适应
  if (!ed.features || !ed.features.autoWater) {
    const panelLeft = document.getElementById('panelLeft');
    const divider = document.getElementById('divider');
    if (panelLeft) panelLeft.style.display = 'none';
    if (divider) divider.style.display = 'none';
    // 任务配置/队列/笔记池/设置都随获客一起消失（设置那页＝拟人化与频率，没开获客的档回设置页那条兜底侧栏改）
    ['tabQueue', 'tabPool', 'tabTaskCfg', 'tabHuokeCfg', 'huokeCfgContent'].forEach(id => document.getElementById(id)?.remove());
  } else {
    // 有获客的版本（① 起）：拟人化与频率的入口在 获客 → ⚙️ 设置，设置页那条二级 tab 撤掉（免得两处入口）
    document.querySelector('#setTabs [data-stab="delays"]')?.remove();
  }
  // 6) 线索——非开通版本隐藏一级 tab
  if (!ed.features || !ed.features.prospectList) {
    document.getElementById('tabProspect')?.remove();
    // 线索的「设置」（Bot 间隔）与「任务配置」（渠道基调 / 成交引导）跟着线索一起收
    document.getElementById('tabLeadCfg')?.remove();
    document.getElementById('leadCfgContent')?.remove();
    document.getElementById('tabLeadTaskCfg')?.remove();
    document.getElementById('leadTaskCfgContent')?.remove();
  }
  // 7) 发笔记——未开通版本隐藏 tab 按钮（二级 写文案/档案 跟着一起收）
  if (!ed.features || !ed.features.notePublish) {
    document.getElementById('tabNotePublish')?.remove();
    document.getElementById('noteTabs')?.remove();
  }
  // 7.5) 出片台（全功能版专属）：没开就把左栏那项和内嵌页一起摘掉
  if (!ed.features || !ed.features.videoFilm) {
    document.getElementById('tabNoteFilm')?.remove();
    document.getElementById('filmContent')?.remove();
  }
}

/* ─── 租户切换器（顶部下拉框）─── */
let _tenantWatchWired = false;
async function initTenantSwitcher() {
  const sel = document.getElementById('tenantSwitcher');
  if (!sel) return;
  if (sel.dataset.locked === '1') return; // 版本限制已锁定，不再填充租户列表
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'listTenants' });
    const tenants = (resp && resp.tenants) || [];
    const currentId = resp && resp.currentId;
    sel.innerHTML = '';
    tenants.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.id;
      opt.textContent = t.name;
      if (t.id === currentId) opt.selected = true;
      sel.appendChild(opt);
    });
    sel.dataset.current = currentId || '';
  } catch (e) {
    console.warn('[租户] 加载列表失败:', e);
  }
  sel.onchange = async () => {
    const id = sel.value;
    if (!id || id === sel.dataset.current) return;
    sel.disabled = true;
    addLog('🏢 正在切换租户…', 'info');
    try {
      const r = await chrome.runtime.sendMessage({ action: 'switchTenant', data: { id } });
      if (r && r.ok !== false) {
        // 切换后整个数据集都变了，直接重载弹窗最干净（重跑 startup + 左侧面板）
        location.reload();
      } else {
        throw new Error(r && r.error || '切换失败');
      }
    } catch (e) {
      addLog('❌ 切换租户失败：' + (e.message || e), 'error');
      sel.value = sel.dataset.current || '';
      sel.disabled = false;
    }
  };
  // 顶栏这个下拉是切换产品的唯一入口 → 在设置页（iframe 里）新建/改名/删除后要跟着刷新，
  // 否则刚建好的产品在下拉里选不到。
  if (!_tenantWatchWired) {
    _tenantWatchWired = true;
    try {
      chrome.storage.onChanged.addListener((changes, area) => {
        if (area !== 'local' || !changes['tenants']) return;
        if (sel.dataset.locked === '1') return;
        initTenantSwitcher();
      });
    } catch (_) {}
  }
}

// ★ 驱动网页上那条红色状态栏（内容脚本在小红书页里），让它反映 AI 分析/已完成
//   这些发生在 popup/background、内容脚本本身不知道的阶段。
async function _setTabStatusBar(text) {
  try {
    const t = await getTargetTab();
    if (t && t.id != null) await chrome.tabs.sendMessage(t.id, { action: 'setStatusBar', text });
  } catch (_) {}
}
async function _finishTabStatusBar() {
  try {
    const t = await getTargetTab();
    if (t && t.id != null) await chrome.tabs.sendMessage(t.id, { action: 'finishStatusBar' });
  } catch (_) {}
}
// ★ 评论加载完 → 跳回助手窗口（只有从笔记列表“打开”触发才会跳，手动刷新不跳）。
//   _focus_restore 只由 openNote 设置。
async function _restorePopupFocus() {
  try {
    const _fd = await chrome.storage.local.get('_focus_restore');
    const fr = _fd['_focus_restore'];
    if (fr && (Date.now() - (fr.ts || 0) < 120000)) {
      try {
        const selfWin = await chrome.windows.getCurrent();
        if (selfWin && selfWin.id != null) {
          await chrome.windows.update(selfWin.id, { focused: true, drawAttention: true });
        }
      } catch (_) {}
      addLog('↩️ 评论已加载完成，已切回助手窗口', 'info');
    }
    if (fr) { try { await chrome.storage.local.remove('_focus_restore'); } catch (_) {} }
  } catch (_) {}
}

async function startup() {
  hideEmpty();
  setStatus('检查 AI 配置...', '');

  // 通过 background.js 检查 AI 配置
  let configOk = false;
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'checkConfig' });
    configOk = resp?.configured === true;
  } catch (_) {}

  if (!configOk) {
    setBadge('未配置 AI', 'offline');
    setStatus('⚠️ 请先配置 API Key', 'error');
    showEmpty('请先点 <b>⚙️ 设置</b> 配 AI Key，并到 <b>诊断&配置 → 基础配置</b> 填产品名称后再用');
    return;
  }
  setBadge('AI 就绪', '');

  const tab = await getTargetTab();
  if (!tab || !tab.url || !tab.url.includes('xiaohongshu.com')) {
    hideStatus();
    showEmpty();
    return;
  }

  setStatus('提取页面评论...', '');
  addLog('📄 正在提取页面评论...', 'info');

  // ── 页面类型守卫 + 自愈重试 ──
  // 有时小红书会在笔记详情页里瞬时灌入列表/卡片内容（或 SPA 还没切完），
  // 守卫抓到"页面不对"时不再直接放弃：停掉本次 → 停顿 → 返回并重新打开笔记 → 再扫描。
  // 中间刻意加入随机停顿，让节奏更自然。
  const isNoteUrl = (u) => /xiaohongshu\.com\/(explore|discovery\/item)\//.test(u || '');
  const initialUrl = tab.url || '';
  const curNoteId = _noteIdFromUrl(initialUrl);
  _scanDoneFired = false;               // 每开一篇：重置"已发完成信号"标记
  _scanCurNoteId = curNoteId || _scanCurNoteId;
  startScanHeartbeat(curNoteId);               // ★ 扫描心跳开始（此时 curNoteId 已定义；必须放这，别放前面造成 TDZ 引用报错）
  // ★ 先拿搜索抛到的笔记列表当“对照表”（可能为空），用来精确识别背景信息流卡片
  const foundNotes = await loadFoundNotes();
  // ★ [debug] 无论有没有对照表都打一行，方便定位卡点：能看到 tab/当前URL/笔记列表数
  addLog(`🔎 [debug] 准备扫描：tab=${tab.id} noteId=${curNoteId || '无'} url=${String(initialUrl || '').slice(0, 42)} 对照表=${foundNotes.length} 条`, 'info');
  if (foundNotes.length > 0) {
    addLog(`🗂️ 已加载搜索抛到的 ${foundNotes.length} 条笔记列表，将用它交叉核对、剔除被当成评论的卡片`, 'info');
  }
  const MAX_TRY = 3;
  let result = null;
  // ★ 整体扫描预算：即使 content.js 一直不响应/自愈反复重开，整段"提取评论"也最多花 90s，
  //   到点立即收尾广播，避免无限卡在"提取页面评论"（配合上方各 content 调用的超时形成双保险）。
  const extractDeadline = Date.now() + 90000;

  for (let attempt = 1; attempt <= MAX_TRY; attempt++) {
    if (Date.now() > extractDeadline) {
      addLog('⏱ 评论提取超时（90s），跳过本篇避免卡住', 'warn');
      break;
    }
    // ★ 第一步：轻量页面类型预检（不滚动、不采集）。错页立刻走自愈重试，省掉白滚一轮评论区的时间
    let pre = null;
    addLog(`→ 预检页面类型（等 content.js 响应，上限 20s）…`, 'info');
    try {
      pre = await sendTabMessageWithTimeout(tab.id, { action: 'checkPageType' }, 20000);
      addLog(`→ 预检返回：${pre ? (pre.notNotePage ? ('非笔记页(卡片×' + pre.cardLinkCount + ')') : '是笔记页(可滚动)') : '无结果'}`, 'info');
    } catch (e) {
      // content.js 尚未注入 → 注入后再查
      addLog(`→ content 未响应（${e && e.message ? e.message : '超时'}），尝试注入 content.js…`, 'warn');
      try {
        await chrome.scripting.executeScript({ target: { tabId: tab.id }, files: ['content.js'] });
        await sleep(400);
        pre = await sendTabMessageWithTimeout(tab.id, { action: 'checkPageType' }, 20000);
        addLog(`→ 注入后预检返回：${pre ? (pre.notNotePage ? '非笔记页' : '是笔记页') : '仍无结果'}`, 'info');
      } catch (_e2) {
        addLog(`→ ⚠️ 注入 content.js 仍失败/超时（${_e2 && _e2.message ? _e2.message : '未知'}）`, 'error');
      }
    }
  
    let badPage = false;
    if (pre && pre.notNotePage) {
      // 预检就发现不是笔记详情页 → 不滚动不提取，直接进入下方自愈重试
      addLog(`⚠️ 预检：当前不是笔记详情页（卡片×${pre.cardLinkCount || 0}），跳过滚动采集，直接重试`, 'warn');
      result = { _notNotePage: true, _cardLinkCount: pre.cardLinkCount || 0, comments: [] };
      badPage = true;
    } else {
      // ★ 第二步：页面类型没问题，才滚动评论区多翻几屏、展开更多回复
      // （loadMoreComments 是页面侧滚完、DOM 稳定后才返回的，这里 await 保证“滚完才采集”）
      try {
        addLog(`📜 正在多翻几页、加载更多评论...（第 ${attempt}/${MAX_TRY} 次）`, 'info');
        const loadResult = await sendTabMessageWithTimeout(tab.id, { action: 'loadMoreComments', maxRounds: 3 }, 45000);
        if (loadResult?.success) {
          addLog(`📜 评论加载完成，页面共约 ${loadResult.commentCount || '?'} 条`, 'success');
        } else if (loadResult?.notNotePage) {
          addLog('⚠️ 页面没有“评论”标记，疑似外页/信息流，已跳过滚动加载（交给自愈重试）', 'warn');
        }
      } catch (_) {
        // content.js 尚未注入时忽略，下面 extract 会兜底重试注入
      }
  
      // ★ 第三步：滚动结束后才提取（上一步 await 已保证顺序）
      result = null;
      addLog(`→ 开始抓取评论（extract，上限 40s）…`, 'info');
      try {
        result = await sendTabMessageWithTimeout(tab.id, { action: 'extract' }, 40000);
      } catch (e) {
        addLog(`→ extract 未响应（${e && e.message ? e.message : '超时'}），尝试注入 content.js…`, 'warn');
        try {
          await chrome.scripting.executeScript({ target: { tabId: tab.id }, files: ['content.js'] });
          await sleep(400);
          result = await sendTabMessageWithTimeout(tab.id, { action: 'extract' }, 40000);
        } catch (e2) {
          addLog(`→ ⚠️ 注入后 extract 仍失败/超时（${e2 && e2.message ? e2.message : '未知'}）`, 'error');
        }
      }
      if (result && Array.isArray(result.comments)) {
        addLog(`→ extract 返回 ${result.comments.length} 条（候选${result._sourceLabel ? '/' + result._sourceLabel : ''}）`, 'info');
      } else {
        addLog(`→ ⚠️ extract 无结果（result=${result ? Object.keys(result).join(',') : 'null'}）`, 'warn');
      }
  
      // ★ 第四步：用搜索列表交叉核对：看这次抓到的“评论”里有多少其实是背景信息流卡片
      // （预检只能拦“整页都不对”，拦不住“详情页里瞬时灌入信息流”，所以这道校验仍保留）
      let feedDetected = false;
      if (result && Array.isArray(result.comments) && result.comments.length > 0) {
        const cc = crossCheckComments(result.comments, foundNotes, curNoteId);
        if (cc.removed.length > 0) {
          addLog(`🧭 交叉核对：${cc.removed.length}/${result.comments.length} 条“评论”命中笔记列表（作者/点赞数/标题都对得上），它们是背景卡片而非真评论，已剔除`, 'warn');
          result.comments = cc.kept;
          // 剔除后真评论所剩无几（或剔掉的占绝大多数）→ 判定抓到的是信息流
          if (cc.kept.length < 2 || cc.removed.length >= (cc.removed.length + cc.kept.length) * 0.6) {
            feedDetected = true;
          }
        }
      }
  
      // 对"页面类型不对"（抓到卡片而非评论）或交叉核对判定为信息流 → 触发自愈重试
      badPage = !!(result && result._notNotePage) || feedDetected;
    }
    if (!badPage) break;
    if (attempt >= MAX_TRY) break; // 用完次数，交给下面的守卫统一报错

    // 找出要重新打开的笔记 URL（当前页或进入时的 URL，只要它像笔记页）
    const curTab = await getTargetTab();
    const targetUrl = isNoteUrl(curTab?.url) ? curTab.url
                    : (isNoteUrl(initialUrl) ? initialUrl : null);
    if (!curTab || !targetUrl) break; // URL 本身就不是笔记页，无法自动恢复

    addLog(`⚠️ 检测到抓的是笔记卡片/背景信息流而非评论，停掉本次，返回后重新打开笔记重试`, 'warn');

    // 1) 返回上一页（先退出再重试），停顿时长读设置页「停留时间」配置（技术下限 300ms）
    const backWait = await getDwellMs('retryBackWait', 300);
    setStatus(`⚠️ 页面内容异常，正在返回…（第 ${attempt}/${MAX_TRY} 次重试）`, 'warn');
    try { await chrome.tabs.sendMessage(curTab.id, { action: 'goBack' }); } catch (_) {}
    await sleep(backWait);

    // 2) 重新打开这篇笔记，等 SPA/页面加载（技术下限 800ms），再进入下一轮扫描
    const openWait = await getDwellMs('retryOpenWait', 800);
    setStatus(`⚠️ 正在重新打开笔记，约 ${Math.round(openWait / 1000)} 秒后重新扫描…`, 'warn');
    try { await chrome.tabs.update(curTab.id, { url: targetUrl }); } catch (_) {}
    await sleep(openWait);
  }

  // ★ 评论加载/重试循环已结束 → 立刻跳回助手窗口，让用户看到接下来的 AI 分析（而不是干等）
  await _restorePopupFocus();

  // ★ 页面类型守卫：重试后仍不是笔记详情页 → 拦住，不把卡片当评论喂给 AI
  if (result && result._notNotePage) {
    await _finishTabStatusBar();
    setStatus('⚠️ 请先点开一篇笔记再扫描', 'error');
    showEmpty('多次返回重开后仍抓到<b>笔记卡片</b>而不是评论。<br>请手动点开具体的<b>一篇笔记详情页</b>（能看到评论区）再点扫描。');
    addLog(`⚠️ 重试 ${MAX_TRY} 次后仍不是笔记详情页（卡片×${result._cardLinkCount || 0}），已阻止把卡片当评论发给 AI`, 'warn');
    broadcastAiScanDone(false); // ★ 页面类型不对，本篇作废，通知机器人返回列表
    return;
  }

  if (!result || !result.comments || result.comments.length === 0) {
    await _finishTabStatusBar();
    setStatus('⚠️ 未找到评论，请确认在笔记页面', 'error');
    showEmpty('未找到评论，请确认在<b>笔记详情页</b>（不是首页或搜索页）');
    broadcastAiScanDone(false); // ★ 本篇无评论，通知机器人返回列表
    return;
  }

  // 使用候选2（索引1），若有
  const candidates = result._candidates || [];
  if (candidates.length >= 2 && candidates[1].comments.length > 0) {
    pageData = { ...result };
    pageData.comments = candidates[1].comments;
    pageData.threads = extractThreadsSafe(candidates[1].comments);
    // 标记候选来源
    pageData._sourceLabel = candidates[1].label || '候选2';
  } else {
    pageData = result;
    pageData._sourceLabel = '默认';
  }

  showNoteInfo(pageData);
  hideStatus();

  // 🏷 话题采集：笔记正文里的 #话题 入池（供「关键词维护 · 话题」一键转搜索词）
  try { if (window.NoteTags) window.NoteTags.recordFromPage(pageData); } catch (_) {}

  // ★ 防重复灌水：若笔记里已有“我的名字”的评论 → 直接判定已灌水、跳过 AI、记入清单
  try {
    const myComment = await findMyCommentInNote(pageData.comments || []);
    if (myComment) {
      if (forceRescan) {
        // 循环计划：不拦截、不标记已灌水，只把自己这条评论记入已回复记录（防重扫时当商机）
        try { await addLocalReply(pageData.url || '', myComment.author || '', myComment.content || ''); } catch (_) {}
      } else {
        addLog(`✅ 发现本篇已有你的评论（@${esc(myComment.author)}），判定为已灌水，跳过 AI 分析`, 'success');
        await markNoteWateredBySelf(pageData.url || '', myComment);
        await _finishTabStatusBar();
        broadcastAiScanDone(false); // ★ 本篇已有自己的评论，跳过分析，通知机器人返回列表
        return;
      }
    }
  } catch (e) {
    console.warn('[防重复] 检查自己评论异常:', e);
  }

  // 自动开始商机挖掘
  setStatus('<span class="loading-spinner"></span> AI 正在扫描评论，挖掘潜在客户...', '');
  addLog('🔍 开始商机挖掘...', 'info');
  await loadProspecting(document.getElementById('mainContent'));
}

// ========== 刷新 ==========
/** 判断当前标签页是否是笔记内容页（含笔记详情浮层/侧滑窗，URL 不一定变） */
async function isNotePage() {
  try {
    const tab = await getTargetTab();
    if (!tab || !tab.url) return false;
    // 笔记页 URL 格式：xiaohongshu.com/explore/{noteId}（/discovery/item/ 也是笔记详情）
    if (/xiaohongshu\.com\/(explore|discovery\/item)\//.test(tab.url)) return true;

    // ★ 小红书打开笔记常用“详情浮层/侧滑窗”，背景 URL 仍是搜索/信息流页、不跳转。
    //   单看 URL 会误判成“不是笔记页”而跳过刷新。这里问 content 脚本（与扫描器同口径，
    //   能识别浮层里的回复框/评论区滚动容器），确认确实是笔记内容页才算数。
    if (!/xiaohongshu\.com/.test(tab.url)) return false;
    try {
      const resp = await sendTabMessageWithTimeout(tab.id, { action: 'checkPageType' }, 3000);
      if (resp && resp.success) return resp.notNotePage === false;
      return false;
    } catch (_) { return false; }
  } catch (_) {
    return false;
  }
}

async function refreshData() {
  // ★ 循环计划强制模式：一次性标志在函数最开头读取并立即清除——
  //   中途任何提前 return（非笔记页/无评论等）都不会残留，影响下次手动操作
  const forceRescan = !!window.__forceRescan;
  window.__forceRescan = false;
  // ★ 记住"这是否自动模式/机器人带跑的扫描"：整篇处理期间持续有效。
  //   抓取异常等"单篇结单"时，据此让 popup 走"跳过本篇"而非弹红色打断界面。
  _lastScanWasAuto = forceRescan;

  // 开关：只有当前页面是笔记内容页才刷新
  const onNotePage = await isNotePage();
  if (!onNotePage) {
    addLog('⚠️ 当前页面不是笔记内容页，跳过刷新', 'warn');
    return;
  }

  addLog('🔄 刷新笔记...', 'info');

  // 屏蔽自动灌水和自动评论按钮
  const caretBtn = document.getElementById('commentCaret');
  const botBtn = document.getElementById('botToggleBtn');
  if (caretBtn) { caretBtn.disabled = true; caretBtn.style.opacity = '0.5'; }
  if (botBtn) { botBtn.disabled = true; botBtn.style.opacity = '0.5'; }

  const btn = document.getElementById('refreshBtn');
  btn.textContent = '⏳';
  btn.disabled = true;
  btn.style.opacity = '0.5';
  pageData = null;
  hideEmpty();
  document.getElementById('noteInfo').style.display = 'none';
  // 从持久化存储加载已灌水记录（而不是清空）
  const wateredUrls = await loadWateredNoteUrls();
  _wateredSet = new Set();
  for (const url of wateredUrls) {
    _wateredSet.add(url);
  }
  let _scanErr = null;
  try {
    await startup();
  } catch (e) {
    _scanErr = e;
  }
  btn.textContent = '🔄 评论刷新';
  btn.disabled = false;
  btn.style.opacity = '1';

  // ★ 跳回助手窗口已前移到 startup() 内部（评论加载完、AI 分析前就跳）：_restorePopupFocus()。
  //   这里只做兜底清理：startup 提前 return/抛异常时，把残留的 _focus_restore 标记清掉，
  //   避免下次手动刷新被误判为“从列表打开”而乱跳。
  try { await chrome.storage.local.remove('_focus_restore'); } catch (_) {}

  // 释放自动灌水和自动评论按钮
  if (caretBtn) { caretBtn.disabled = false; caretBtn.style.opacity = '1'; }
  if (botBtn) { botBtn.disabled = false; botBtn.style.opacity = '1'; }

  // ★ 兜底：扫描期间任何异常都要显式报出来 + 广播放行，绝不许"崩了但看起来像卡住"
  if (_scanErr) {
    console.error('[刷新] 扫描异常:', _scanErr);
    addLog('❌ 扫描中止：' + (_scanErr.message || String(_scanErr)), 'error');
    setStatus('❌ 扫描出错：' + String(_scanErr.message || _scanErr).slice(0, 60), 'error');
    broadcastAiScanDone(false);
  }
}
/** 刷新评论助手（供左侧面板打开笔记后调用） */
window.refreshCommentAssistant = refreshData;
/** 查询已灌水笔记 URL 集合（供左侧面板调用） */
window.getWateredNoteUrls = loadWateredNoteUrls;

// ========== 批量串行发送 ==========
// ★ 是否正在“自动批量发送”（自动评论）：决定发送时是否走自然节奏。
//   true=批量/自动（节奏放慢）；false=手动逐条一键发送（快速，不磨蹭）
let _batchSending = false;

// 互动行为配置（「🎯 获客 → ⚙️ 设置 → 🤝 互动行为」区，存 behavior_config）：
// autoFollow：发评论前是否自动关注（默认开，保持既有行为）；followEvery：批量时每隔几条关注一次（1=每条）
async function getBehaviorConfig() {
  try {
    const r = await chrome.storage.local.get('behavior_config');
    return { autoFollow: true, followEvery: 1, ...(r.behavior_config || {}) };
  } catch (_) {
    return { autoFollow: true, followEvery: 1 };
  }
}

async function batchSendAll() {
  // 版本闸门：未开通不含整页批量发送（按钮已灰显，这里双保险）
  if (!editionFeatureOn('batchSend')) {
    addLog('🔒 当前版本不支持整页批量发送，请逐条使用「一键发送」；升级更高版本可解锁', 'warn');
    return;
  }
  const caretBtn = document.getElementById('commentCaret');
  const refreshBtn = document.getElementById('refreshBtn');
  const sendBtns = Array.from(document.querySelectorAll('.send-btn:not(.watered)'));

  if (sendBtns.length === 0) {
    addLog('⚠️ 没有待发送的评论（已全部灌水或无商机）', 'warn');
    return;
  }

  addLog(`📤 开始批量发送，共 ${sendBtns.length} 条评论`, 'info');
  // ★ 标记“自动批量发送中”：只有自动发送才走自然节奏（浏览停留 + 逐字输入）；
  //   手动逐条点“一键发送”不需要这些，走快速通道
  _batchSending = true;
  if (caretBtn) { caretBtn.disabled = true; caretBtn.style.opacity = '0.5'; }
  if (refreshBtn) { refreshBtn.disabled = true; refreshBtn.style.opacity = '0.5'; }

  let successCount = 0;
  let failCount = 0;

  for (let i = 0; i < sendBtns.length; i++) {
    const btn = sendBtns[i];
    const author = btn.dataset.author || '未知';

    // 重新检查按钮状态（可能已被其他逻辑处理）
    if (btn.classList.contains('watered') || btn.disabled) {
      addLog(`⏭ @${author} 已灌水，跳过`, 'info');
      continue;
    }

    addLog(`📤 [${i + 1}/${sendBtns.length}] 发送给 @${author}...`, 'info');

    // ★ 等这条评论“处理完毕”（成功或失败都会置 data-send-done）；
    // 失败时能立刻推进下一条，不再因为等 .watered 而干等 120 秒
    btn.removeAttribute('data-send-done'); // 清掉上一轮可能残留的标记
    const donePromise = new Promise((resolve) => {
      if (btn.dataset.sendDone || btn.classList.contains('watered')) { resolve(); return; }
      const timer = setTimeout(() => { obs.disconnect(); resolve(); }, 150000); // 终极兵底，正常不会触发
      const obs = new MutationObserver(() => {
        if (btn.dataset.sendDone || btn.classList.contains('watered')) {
          clearTimeout(timer);
          obs.disconnect();
          resolve();
        }
      });
      obs.observe(btn, { attributes: true, attributeFilter: ['class', 'data-send-done'] });
    });

    // 点击发送按钮
    btn.click();

    await donePromise;
    // 以 .watered 为准判定成功/失败
    if (btn.classList.contains('watered')) {
      addLog(`✅ @${author} 发送成功`, 'success');
      successCount++;
    } else {
      addLog(`⚠️ @${author} 发送失败，继续下一个`, 'warn');
      failCount++;
    }

    // ★ 批量条间发送间隔：随机 3~8 秒（用户要求；手动逐条发送不加此间隔）
    if (i < sendBtns.length - 1) {
      const gap = 3000 + Math.floor(Math.random() * 5000);
      addLog(`⏸ 发送间隔：停 ${(gap / 1000).toFixed(1)}s 再发下一条...`, 'info');
      await sleep(gap);
    }
  }

  addLog(`🏁 批量发送完成：成功 ${successCount} 条，失败 ${failCount} 条`, successCount > 0 ? 'success' : 'warn');

  _batchSending = false; // ★ 批量结束，恢复手动快速通道
  if (caretBtn) { caretBtn.disabled = false; caretBtn.style.opacity = '1'; }
  if (refreshBtn) { refreshBtn.disabled = false; refreshBtn.style.opacity = '1'; }
  renderCqBar();   // 💬 评论条队列顶栏：整批跑完后的待发/已发/失败
}

// ========== 💬 评论条队列（获客助手页顶栏） ==========
/* 队列项＝当前笔记里的一条商机评论（.send-btn 一条一个）。状态全从卡片 DOM 现场派生，不另存队列：
     .watered=已发、.sending=发送中、[data-send-done] 且没 .watered=失败、其余=待发——「改状态＝改队列」。
   跨笔记的进度由灌水队列执行器（AutoBot）写 auto_water_state.live，队列页「▶ 正在跑」读同一份：
     { kw, scenario, title, idx, total, author, ci, cTotal, sent } → 「第 2/5 篇《标题》· 正在发 @谁 3/7」 */
let _cqLive = null;   // 最近一次读到的执行器实时进度（auto_water_state.live）

function _cqScan() {
  const st = { wait: 0, sending: 0, ok: 0, fail: 0, total: 0 };
  document.querySelectorAll('#mainContent .send-btn').forEach(b => {
    st.total++;
    if (b.classList.contains('watered')) st.ok++;
    else if (b.classList.contains('sending')) st.sending++;
    else if (b.dataset.sendDone) st.fail++;
    else st.wait++;
  });
  return st;
}

/* 卡片右上角状态徽标（跟着顶栏一起刷）：待发是默认态，只在跑着的时候标出来，免得满页挂灰标 */
function _cqBadges() {
  const on = !!_cqLive;
  document.querySelectorAll('#mainContent .prospect-card').forEach(card => {
    const btn = card.querySelector('.send-btn');
    const badge = card.querySelector('.cq-badge');
    if (!btn || !badge) return;
    const s = btn.classList.contains('watered') ? 'ok'
      : btn.classList.contains('sending') ? 'sending'
        : btn.dataset.sendDone ? 'fail' : 'wait';
    badge.className = 'cq-badge ' + s;
    badge.textContent = { ok: '✅ 已发', sending: '⏳ 发送中', fail: '❌ 失败', wait: '待发' }[s];
    badge.style.display = (s === 'wait' && !on) ? 'none' : 'inline-block';
  });
}

/* 顶栏：本条商机 待发/已发/失败 + 正在发 @谁 3/7 + ⏹ 停止（跑着时才给停止）
   ★ 只讲"本条"：第几篇/共几篇那种跨笔记的进度归 🔁 队列页（同一份 auto_water_state.live，不在这里重复） */
async function renderCqBar() {
  const bar = document.getElementById('cqBar');
  if (!bar) return;
  const st = _cqScan();
  try {
    const d = await chrome.storage.local.get('auto_water_state');
    _cqLive = ((d || {})['auto_water_state'] || {}).live || null;
  } catch (_) { _cqLive = null; }
  const running = !!(window.AutoBot && window.AutoBot.running);
  const isPaused = !!(window.AutoBot && window.AutoBot.paused);
  // 没扫到商机、也没在跑 → 这条没意义；在跑（哪怕还没扫出商机）必须留着——暂停/停止按钮在这条上
  if (!st.total && !_cqLive && !running) { bar.style.display = 'none'; bar.innerHTML = ''; return; }

  let html = (st.total
    ? `💬 本条商机：待发 <b>${st.wait}</b> · 已发 <b>${st.ok}</b>` +
      (st.fail ? ` · 失败 <b>${st.fail}</b>` : '') + (st.sending ? ` · 发送中 ${st.sending}` : '')
    : '💬 这一篇的商机队列') ;
  html = '<span class="cq-n">' + html + '</span>';
  if (isPaused) {
    html += '<span class="cq-running">⏸ 已暂停（当前这一步做完就停下等）</span>';
  } else if (_cqLive && _cqLive.author) {
    html += `<span class="cq-running">▶ 正在发 @${esc(_cqLive.author)} ${_cqLive.ci || '?'}/${_cqLive.cTotal || '?'}</span>`;
  } else if (running) {
    html += '<span class="cq-running">▶ 正在跑（等这篇的商机扫出来…）</span>';
  }
  if (running) {
    const paused = isPaused;
    html += '<button class="cq-stop" id="cqPauseBtn" title="' + (paused ? '继续跑：从暂停的那一步接着往下' : '暂停：当前这一步做完就停下等（进度不丢，点「继续」接着跑）') + '">' +
      (paused ? '▶ 继续' : '⏸ 暂停') + '</button>';
    html += '<button class="cq-stop" id="cqStopBtn" title="停止队列：当前这条发完就停，下次点「🤖 开始」从没发完的接着跑">⏹ 停止</button>';
  }
  bar.innerHTML = html;
  bar.style.display = 'flex';
  const pb = bar.querySelector('#cqPauseBtn');
  if (pb) pb.onclick = () => {
    try { window.toggleAutoBotPause(); } catch (_) {}
    addLog(window.AutoBot && window.AutoBot.paused ? '⏸ 已暂停：当前这一步做完就停下等' : '▶ 已继续，接着跑', 'warn');
    renderCqBar();
  };
  const sb = bar.querySelector('#cqStopBtn');
  if (sb) sb.onclick = () => {
    sb.disabled = true;
    addLog('⏹ 已请求停止队列：当前这条发完就停（下次点「🤖 开始」从没发完的接着跑）', 'warn');
    try { window.stopAutoBot(); } catch (_) {}
    renderCqBar();
  };
  _cqBadges();
}

// 执行器每发一条都会写 auto_water_state.live → 顶栏和队列页跟着刷（同一窗口，storage 事件即时到达）
try {
  chrome.storage.onChanged.addListener((ch, area) => {
    if (area === 'local' && ch['auto_water_state']) renderCqBar();
  });
} catch (_) {}

// ========== 评论跟进（通知页对话回复） ==========
// ★ 用户核心要求：把时间戳平铺的通知流按用户组装成对话上下文给 AI；保存待回复消息的定位，绝不回错人/回错消息。
//   流程：extractNotifications（content.js 提取，含 idx 定位）→ chatFollowSync（background 组装+落库）
//        → chatFollowReply（AI 生成）→ replyNotification（content.js 三重定位发送）→ chatFollowMarkSent（落库防重）

// 获取当前活动标签页，并确认是通知页
async function _ensureNotificationTab() {
  const tab = await getTargetTab();
  if (!tab || !tab.id) return null;
  if (!(tab.url && tab.url.includes('/notification'))) return null;
  return tab;
}

// 同步通知页：提取 → background 组装落库 → 返回会话列表
async function chatFollowSync() {
  const tab = await _ensureNotificationTab();
  if (!tab) return null;
  addLog('🔄 同步通知页：提取通知流...', 'info');
  let extractResp = null;
  try {
    extractResp = await chrome.tabs.sendMessage(tab.id, { action: 'extractNotifications' });
  } catch (e) {
    try {
      await chrome.scripting.executeScript({ target: { tabId: tab.id }, files: ['content.js'] });
      await sleep(400);
      extractResp = await chrome.tabs.sendMessage(tab.id, { action: 'extractNotifications' });
    } catch (_) {}
  }
  if (!extractResp || !extractResp.success) {
    throw new Error((extractResp && extractResp.error) || '提取通知失败（页面可能未加载完成）');
  }
  addLog(`📥 提取到 ${extractResp.count} 条通知，正在按用户组装对话...`, 'info');
  const bgResp = await chrome.runtime.sendMessage({ action: 'chatFollowSync', data: { items: extractResp.items } });
  if (!bgResp || !bgResp.ok) {
    throw new Error((bgResp && bgResp.error) || '会话组装失败');
  }
  const convs = bgResp.conversations || [];
  const pendingCount = convs.filter(c => c.needReply).length;
  addLog(`✅ 组装完成：${convs.length} 个会话（其中 ${pendingCount} 条待回复）`, pendingCount > 0 ? 'success' : 'info');

  // ★ 顺带收集"赞了我们内容/评论"的人（点赞户）→ 自动入库（点赞户可直接发销售资料）
  try {
    const lk = await chrome.tabs.sendMessage(tab.id, { action: 'collectLikers' });
    if (lk && lk.success && (lk.items || []).length) {
      const lr = await chrome.runtime.sendMessage({ action: 'collectLikers', data: { items: lk.items } });
      const addN = (lr && lr.added) ? lr.added : 0;
      const alN = (lr && lr.already) ? lr.already : 0;
      addLog(`🤍 顺带收录点赞户 ${lk.items.length} 人（新增 ${addN} / 已存在 ${alN}）`, addN > 0 ? 'success' : 'info');
    }
  } catch (_) {}

  return { conversations: convs, pendingCount };
}

// 主视图：同步 + 渲染会话卡片
async function loadChatFollow(container) {
  while (container.firstChild) container.removeChild(container.firstChild);
  document.getElementById('noteInfo').style.display = 'none';
  const loadingDiv = document.createElement('div');
  loadingDiv.style.cssText = 'padding:20px;text-align:center;color:#666;';
  loadingDiv.innerHTML = '<div class="loading-spinner" style="margin:0 auto 8px;"></div><div>同步通知页（提取+组装对话）...</div>';
  container.appendChild(loadingDiv);

  let data = null;
  try {
    data = await chatFollowSync();
  } catch (e) {
    while (container.firstChild) container.removeChild(container.firstChild);
    const errDiv = document.createElement('div');
    errDiv.className = 'empty-prospect';
    errDiv.innerHTML = `<div style="font-size:28px;margin-bottom:10px;">⚠️</div>
      <div style="font-size:14px;color:#c62828;margin-bottom:6px;font-weight:500;">${esc(e.message)}</div>
      <div style="font-size:12px;color:#555;line-height:1.6;">请打开 <strong>https://www.xiaohongshu.com/notification</strong> 后重试</div>
      <button id="retryChatFollowBtn" class="retry-btn">🔄 重试同步</button>`;
    container.appendChild(errDiv);
    document.getElementById('retryChatFollowBtn')?.addEventListener('click', () => loadChatFollow(container));
    setStatus('⚠️ AI客服同步失败', 'error');
    return;
  }
  if (!data) {
    while (container.firstChild) container.removeChild(container.firstChild);
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-prospect';
    emptyDiv.innerHTML = `<div style="font-size:28px;margin-bottom:10px;">📍</div>
      <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">请先打开小红书通知页</div>
      <div style="font-size:12px;color:#555;line-height:1.6;">AI客服需要读取 <strong>xiaohongshu.com/notification</strong><br>打开通知页后点「🔄 重试」</div>
      <button id="retryChatFollowBtn" class="retry-btn">🔄 重试</button>`;
    container.appendChild(emptyDiv);
    document.getElementById('retryChatFollowBtn')?.addEventListener('click', () => loadChatFollow(container));
    setStatus('📍 需要打开通知页', 'warn');
    return;
  }
  renderChatFollow(container, data);
  setStatus(`💬 AI客服：${data.conversations.length} 个会话 · ${data.pendingCount} 条待回复`, data.pendingCount > 0 ? 'success' : '');
}

// 渲染会话卡片列表
function renderChatFollow(container, data) {
  while (container.firstChild) container.removeChild(container.firstChild);
  const { conversations, pendingCount } = data;

  // 顶部操作条
  const toolbar = document.createElement('div');
  toolbar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 4px;border-bottom:1px solid #eee;margin-bottom:8px;flex-wrap:wrap;';
  const title = document.createElement('span');
  title.style.cssText = 'font-size:13px;font-weight:700;color:#333;';
  title.textContent = `💬 AI客服：${conversations.length} 个会话 · ${pendingCount} 条待回复`;
  toolbar.appendChild(title);
  const btnGroup = document.createElement('div');
  btnGroup.style.cssText = 'display:flex;gap:6px;';
  const batchBtn = document.createElement('button');
  batchBtn.className = 'batch-send-btn';
  batchBtn.id = 'chatFollowBatchBtn';
  batchBtn.textContent = pendingCount > 0 ? `🤖 全部回复 (${pendingCount})` : '🤖 全部回复';
  batchBtn.disabled = pendingCount === 0;
  batchBtn.title = '串行回复所有待回复会话：AI 生成 → 自动发送 → 3~8 秒随机间隔';
  const syncBtn = document.createElement('button');
  syncBtn.className = 'refresh-btn';
  syncBtn.id = 'chatFollowSyncBtn';
  syncBtn.textContent = '🔄 重新同步';
  const histBtn = document.createElement('button');
  histBtn.className = 'refresh-btn';
  histBtn.id = 'chatFollowHistBtn';
  histBtn.textContent = '📜 回复历史';
  histBtn.title = '查看 AI 已发出的所有回复记录（时间 / 对方消息 / 我的回复）';
  btnGroup.appendChild(batchBtn);
  btnGroup.appendChild(syncBtn);
  btnGroup.appendChild(histBtn);
  toolbar.appendChild(btnGroup);
  container.appendChild(toolbar);

  // 首次使用提示：通知页看不到“我是否已手动回复过”，避免重复打扰
  if (conversations.length > 0) {
    const tip = document.createElement('div');
    tip.style.cssText = 'font-size:11px;color:#8d6e63;background:#fff8e1;border:1px solid #ffe0b2;border-radius:6px;padding:6px 8px;margin-bottom:8px;line-height:1.6;';
    tip.innerHTML = '💡 通知页看不出「我是否已手动回复过」：若你曾在页面上手动回过某人，请在该会话点 <b>⏭ 手动回复过了</b> 跳过，避免重复回复；每条只会发一次。';
    container.appendChild(tip);
  }

  if (conversations.length === 0) {
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-prospect';
    emptyDiv.innerHTML = '<div style="font-size:28px;margin-bottom:10px;">📭</div><div style="font-size:14px;color:#333;font-weight:500;">通知页暂无通知</div><div style="font-size:12px;color:#555;margin-top:6px;">没有可跟进的会话</div>';
    container.appendChild(emptyDiv);
  }

  for (const conv of conversations) {
    container.appendChild(createChatFollowCard(conv));
  }

  document.getElementById('chatFollowBatchBtn')?.addEventListener('click', () => batchChatFollowReply(container));
  document.getElementById('chatFollowSyncBtn')?.addEventListener('click', () => loadChatFollow(container));
  document.getElementById('chatFollowHistBtn')?.addEventListener('click', () => showChatFollowHistory(container));
}

// 回复历史视图：从独立存储读取所有 AI 已发出的回复（最新在前）
async function showChatFollowHistory(container) {
  let list = [];
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'chatFollowGetReplyHistory' });
    if (resp && resp.ok) list = resp.list || [];
  } catch (_) {}
  while (container.firstChild) container.removeChild(container.firstChild);

  // 顶栏：返回 + 标题
  const bar = document.createElement('div');
  bar.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 4px;border-bottom:1px solid #eee;margin-bottom:8px;';
  const backBtn = document.createElement('button');
  backBtn.className = 'refresh-btn';
  backBtn.textContent = '⬅ 返回会话';
  backBtn.addEventListener('click', () => reloadChatFollow());
  bar.appendChild(backBtn);
  const title = document.createElement('span');
  title.style.cssText = 'font-size:13px;font-weight:700;color:#333;';
  title.textContent = `📜 回复历史（${list.length} 条）`;
  bar.appendChild(title);
  container.appendChild(bar);

  if (list.length === 0) {
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-prospect';
    emptyDiv.innerHTML = '<div style="font-size:28px;margin-bottom:10px;">🗒️</div><div style="font-size:14px;color:#333;font-weight:500;">还没有回复记录</div><div style="font-size:12px;color:#555;margin-top:6px;">AI 自动发出回复后会记录在这里（手动跳过 / AI 判定不回复的不记录）</div>';
    container.appendChild(emptyDiv);
    return;
  }

  for (const it of list) {
    const card = document.createElement('div');
    card.style.cssText = 'border:1px solid #e5e5e5;border-radius:8px;padding:10px 12px;margin-bottom:8px;background:#fff;';
    const timeStr = new Date(it.at).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    const head = document.createElement('div');
    head.style.cssText = 'display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap;';
    const nameEl = document.createElement('span');
    nameEl.style.cssText = 'font-size:13px;font-weight:700;color:#333;';
    nameEl.textContent = `👤 ${it.userName || '未知用户'}`;
    head.appendChild(nameEl);
    const timeEl = document.createElement('span');
    timeEl.style.cssText = 'font-size:11px;color:#999;';
    timeEl.textContent = timeStr;
    head.appendChild(timeEl);
    const tag = document.createElement('span');
    tag.style.cssText = 'font-size:10px;background:#e8f5e9;color:#2e7d32;padding:1px 6px;border-radius:8px;margin-left:auto;';
    tag.textContent = '✅ 已回复';
    head.appendChild(tag);
    card.appendChild(head);
    const replied = document.createElement('div');
    replied.style.cssText = 'font-size:12px;color:#555;background:#fafafa;border-radius:6px;padding:6px 8px;margin-bottom:6px;line-height:1.5;';
    replied.innerHTML = `<b>对方：</b>${esc(it.repliedIncoming || '（未知）')}`;
    card.appendChild(replied);
    const reply = document.createElement('div');
    reply.style.cssText = 'font-size:12px;color:#1976d2;background:#f0f7ff;border-radius:6px;padding:6px 8px;line-height:1.5;';
    reply.innerHTML = `<b>我的回复：</b>${esc(it.replyText || '')}`;
    card.appendChild(reply);
    container.appendChild(card);
  }
}

// 会话状态标签
function _chatFollowStatusLabel(conv) {
  if (conv.stale) return { text: '📌 已离线', color: '#999', bg: '#f0f0f0' };
  if (conv.sold) return { text: '💰 已销售', color: '#7b1fa2', bg: '#f3e5f5' };
  if (conv.needReply) return { text: '🔴 待回复', color: '#c62828', bg: '#fdecea' };
  return { text: '✅ 已回复', color: '#1f9d55', bg: '#e8f5e9' };
}

// 创建单张会话卡片
function createChatFollowCard(conv) {
  const card = document.createElement('div');
  card.style.cssText = 'border:1px solid #e5e5e5;border-radius:8px;padding:10px 12px;margin-bottom:10px;background:#fff;';
  card.dataset.userId = conv.userId;

  // 头部：昵称 + 状态标签 + 轮数
  const head = document.createElement('div');
  head.style.cssText = 'display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap;';
  const nameEl = document.createElement('span');
  nameEl.style.cssText = 'font-size:13px;font-weight:700;color:#333;';
  nameEl.textContent = `👤 ${conv.userName || '未知用户'}`;
  head.appendChild(nameEl);
  const label = _chatFollowStatusLabel(conv);
  const tagEl = document.createElement('span');
  tagEl.style.cssText = `font-size:11px;font-weight:600;color:${label.color};background:${label.bg};padding:2px 8px;border-radius:10px;`;
  tagEl.textContent = label.text;
  head.appendChild(tagEl);
  const metaEl = document.createElement('span');
  metaEl.style.cssText = 'font-size:11px;color:#999;margin-left:auto;';
  metaEl.textContent = `${conv.turnCount} 轮` + (conv.lastReplyAt ? ` · ${new Date(conv.lastReplyAt).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}` : '');
  head.appendChild(metaEl);
  card.appendChild(head);

  // 对话预览：完整历史（旧→新），超长可滚动——历史上下文必须全部可见，AI 的回复依据都在里面
  const histPreview = document.createElement('div');
  histPreview.style.cssText = 'font-size:12px;color:#555;line-height:1.6;margin-bottom:8px;background:#fafafa;border-radius:6px;padding:6px 8px;max-height:160px;overflow-y:auto;';
  const history = conv.history || [];
  if (history.length > 0) {
    histPreview.innerHTML = history.map(m => {
      const who = m.role === 'user' ? (conv.userName || '对方')
        : (m.role === 'context' ? '我此前的评论/回复' : '我的回复');
      return `<div><b>${esc(who)}：</b>${esc(m.content.length > 60 ? m.content.slice(0, 60) + '…' : m.content)}</div>`;
    }).join('');
  } else {
    histPreview.textContent = '（无对话记录）';
  }
  card.appendChild(histPreview);

  // 待回复：显示对方最新消息 + 操作按钮；AI 生成后显示预览与发送按钮
  if (conv.needReply && conv.pendingIncoming) {
    const pendingBox = document.createElement('div');
    pendingBox.style.cssText = 'border:1px dashed #ffb3b3;background:#fff8f8;border-radius:6px;padding:8px;margin-bottom:8px;';
    const pendingTitle = document.createElement('div');
    pendingTitle.style.cssText = 'font-size:11px;font-weight:700;color:#c62828;margin-bottom:4px;';
    pendingTitle.textContent = '📩 最新消息（待回复）';
    pendingBox.appendChild(pendingTitle);
    const pendingText = document.createElement('div');
    pendingText.style.cssText = 'font-size:12px;color:#333;line-height:1.6;';
    pendingText.textContent = conv.pendingIncoming;
    pendingBox.appendChild(pendingText);
    card.appendChild(pendingBox);

    const actions = document.createElement('div');
    actions.style.cssText = 'display:flex;gap:6px;flex-wrap:wrap;';
    const genBtn = document.createElement('button');
    genBtn.className = 'batch-send-btn';
    genBtn.textContent = '🤖 AI 生成回复';
    genBtn.style.padding = '5px 12px;font-size:12px;';
    genBtn.addEventListener('click', () => generateChatFollowReply(conv, card, genBtn));
    actions.appendChild(genBtn);
    // 手动回复过了 → 标记跳过（记录 lastRepliedIncoming 防重复，不追加回复正文）
    const skipBtn = document.createElement('button');
    skipBtn.className = 'refresh-btn';
    skipBtn.textContent = '⏭ 手动回复过了';
    skipBtn.style.padding = '5px 12px;font-size:12px;';
    skipBtn.title = '若你已在页面上手动回复过这条，点此标记，避免重复回复';
    skipBtn.addEventListener('click', async () => {
      skipBtn.disabled = true;
      const markResp = await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: '', lastRepliedIncoming: conv.pendingIncoming } });
      if (markResp && markResp.ok) {
        addLog(`⏭ @${conv.userName} 已标记为手动回复过（跳过）`, 'info');
        await _chatFollowAfterAction();
      } else {
        addLog(`⚠️ @${conv.userName} 标记失败：${(markResp && markResp.error) || '未知错误'}`, 'error');
        skipBtn.disabled = false;
      }
    });
    actions.appendChild(skipBtn);
    card.appendChild(actions);
  }
  return card;
}

// AI 生成回复（单条）：生成后渲染预览 + 发送按钮
async function generateChatFollowReply(conv, card, genBtn) {
  genBtn.disabled = true;
  genBtn.textContent = '🤖 生成中...';
  try {
    setLockBanner(true, 'chatFollowReply');
    const resp = await chrome.runtime.sendMessage({ action: 'chatFollowReply', data: { userId: conv.userId } });
    if (!resp || !resp.ok) {
      throw new Error((resp && resp.error) || 'AI 生成失败');
    }
    addLog(`🤖 @${conv.userName} AI 判断 [${resp.action}]：${resp.reason || ''}`, resp.action === 'sell' ? 'warn' : 'info');
    if (!resp.reply) {
      // AI 认为无需回复（礼貌结束语 / 已无待回复内容）
      if (resp.ending) {
        // 礼貌性结束语（谢谢/收到类）：自动标记已处理，下次同步不再提示，也不会重复回复
        genBtn.textContent = '⏭ 无需回复（已标记）';
        const markResp = await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: '', lastRepliedIncoming: conv.pendingIncoming } });
        addLog(`✅ @${conv.userName} 礼貌性结束语，已标记跳过（不再提示）`, markResp && markResp.ok ? 'success' : 'warn');
        await _chatFollowAfterAction();
        return;
      }
      genBtn.textContent = '⏭ 无需回复';
      return;
    }

    // 渲染预览区
    const preview = document.createElement('div');
    preview.style.cssText = 'border:1px solid #c8e6c9;background:#f1f8f1;border-radius:6px;padding:8px;margin-top:8px;';
    const actionColor = resp.action === 'sell' ? '#7b1fa2' : (resp.action === 'noop' ? '#999' : '#1976d2');
    const actionName = resp.action === 'sell' ? '💰 销售' : (resp.action === 'noop' ? '🤝 客套' : '💬 闲聊');
    const headLine = document.createElement('div');
    headLine.style.cssText = 'font-size:11px;font-weight:700;margin-bottom:4px;';
    headLine.innerHTML = `<span style="color:${actionColor};">${actionName}</span> <span style="color:#888;font-weight:400;">${esc(resp.reason || '')}</span>`;
    preview.appendChild(headLine);
    const replyText = document.createElement('div');
    replyText.style.cssText = 'font-size:13px;color:#333;line-height:1.6;margin-bottom:8px;';
    replyText.textContent = resp.reply;
    preview.appendChild(replyText);
    const sendRow = document.createElement('div');
    sendRow.style.cssText = 'display:flex;gap:6px;';
    const sendBtn = document.createElement('button');
    sendBtn.className = 'batch-send-btn';
    sendBtn.textContent = '✅ 发送这条回复';
    sendBtn.style.padding = '5px 12px;font-size:12px;';
    sendBtn.addEventListener('click', () => sendChatFollowReply(conv, resp.reply, card, sendBtn));
    const cancelBtn = document.createElement('button');
    cancelBtn.className = 'refresh-btn';
    cancelBtn.textContent = '✖ 放弃';
    cancelBtn.style.padding = '5px 12px;font-size:12px;';
    cancelBtn.addEventListener('click', () => { preview.remove(); genBtn.disabled = false; genBtn.textContent = '🤖 AI 生成回复'; });
    sendRow.appendChild(sendBtn);
    sendRow.appendChild(cancelBtn);
    preview.appendChild(sendRow);
    card.appendChild(preview);
    genBtn.textContent = '✅ 已生成（点上方发送）';
  } catch (e) {
    addLog(`❌ @${conv.userName} AI 生成失败：${e.message}`, 'error');
    genBtn.textContent = '🤖 AI 生成回复';
    genBtn.disabled = false;
  } finally {
    setLockBanner(false, 'chatFollowReply');
  }
}

// 发送单条回复（content.js 三重定位发送 → 落库防重 → 重渲染）
async function sendChatFollowReply(conv, replyText, card, sendBtn) {
  sendBtn.disabled = true;
  sendBtn.textContent = '⏳ 发送中...';
  try {
    setLockBanner(true, 'chatFollowSend');
    const tab = await _ensureNotificationTab();
    if (!tab) throw new Error('通知页已关闭或切换，无法发送');
    const resp = await chrome.tabs.sendMessage(tab.id, {
      action: 'replyNotification',
      idx: conv.pendingIdx,
      replyText,
      userId: conv.userId,
      userName: conv.userName,
      latestText: conv.pendingIncoming, // 发送前校验：该位置的消息必须还是这条
    });
    if (!resp || !resp.success) {
      throw new Error((resp && resp.error) || '发送失败');
    }
    addLog(`✅ 已回复 @${conv.userName}（${resp.via || ''}）`, 'success');
    // 落库：追加回复、清空待回复定位、记住回复的是哪条，防止下次同步重复回复
    const markResp = await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText, lastRepliedIncoming: conv.pendingIncoming } });
    if (!markResp || !markResp.ok) {
      addLog(`⚠️ 回复已发出，但状态落库失败：${(markResp && markResp.error) || '未知错误'}（下次同步可能重复提示，可手动忽略）`, 'warn');
    }
    // 重渲染整个列表（刷新状态标签）
    await _chatFollowAfterAction();
  } catch (e) {
    addLog(`❌ @${conv.userName} 发送失败：${e.message}`, 'error');
    if (sendBtn) { sendBtn.disabled = false; sendBtn.textContent = '✅ 发送这条回复'; }
  } finally {
    setLockBanner(false, 'chatFollowSend');
  }
}

// 全部串行回复（AI 生成 → 发送 → 3~8 秒随机间隔）
async function batchChatFollowReply(container) {
  let convs = [];
  try {
    const data = await chatFollowSync();
    if (!data) return;
    convs = data.conversations.filter(c => c.needReply && c.pendingIncoming);
  } catch (e) {
    addLog(`❌ 批量回复前置同步失败：${e.message}`, 'error');
    return;
  }
  if (convs.length === 0) {
    addLog('📭 没有待回复的会话', 'info');
    return;
  }

  setLockBanner(true, 'chatFollow');
  let okCount = 0, skipCount = 0, failCount = 0;
  try {
    for (let i = 0; i < convs.length; i++) {
      const conv = convs[i];
      addLog(`🤖 [${i + 1}/${convs.length}] @${conv.userName}：AI 生成回复...`, 'info');
      let gen = null;
      try {
        const resp = await chrome.runtime.sendMessage({ action: 'chatFollowReply', data: { userId: conv.userId } });
        if (resp && resp.ok) gen = resp;
        else throw new Error((resp && resp.error) || 'AI 生成失败');
      } catch (e) {
        addLog(`⚠️ [${i + 1}/${convs.length}] @${conv.userName} 生成失败：${e.message}，跳过`, 'warn');
        failCount++;
        continue;
      }
      if (!gen.reply) {
        addLog(`⏭ [${i + 1}/${convs.length}] @${conv.userName} AI 判定无需回复（${gen.reason || 'noop'}），标记已处理`, 'info');
        try { await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: '' } }); } catch (_) {}
        skipCount++;
        continue;
      }
      addLog(`💬 [${i + 1}/${convs.length}] @${conv.userName} AI 判断 [${gen.action}]：${gen.reply.slice(0, 50)}${gen.reply.length > 50 ? '…' : ''}`, gen.action === 'sell' ? 'warn' : 'info');
      // 发送（三重定位保障在 content.js）
      const tab = await _ensureNotificationTab();
      if (!tab) throw new Error('通知页已关闭或切换，批量中止');
      const sendResp = await chrome.tabs.sendMessage(tab.id, {
        action: 'replyNotification',
        idx: conv.pendingIdx,
        replyText: gen.reply,
        userId: conv.userId,
        userName: conv.userName,
        latestText: conv.pendingIncoming,
      });
      if (!sendResp || !sendResp.success) {
        addLog(`❌ [${i + 1}/${convs.length}] @${conv.userName} 发送失败：${(sendResp && sendResp.error) || '未知错误'}，跳过`, 'error');
        failCount++;
        continue;
      }
      okCount++;
      addLog(`✅ [${i + 1}/${convs.length}] @${conv.userName} 回复成功（${sendResp.via || ''}）`, 'success');
      try {
        await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: gen.reply, lastRepliedIncoming: conv.pendingIncoming } });
      } catch (_) {}
      // 条间发送间隔：随机 3~8 秒（最后一条不用等）
      if (i < convs.length - 1) {
        const gap = 3000 + Math.floor(Math.random() * 5000);
        addLog(`⏸ 发送间隔：停 ${(gap / 1000).toFixed(1)}s 再回复下一位...`, 'info');
        await sleep(gap);
      }
    }
  } catch (e) {
    addLog(`⛔ 批量回复中断：${e.message}`, 'error');
  } finally {
    setLockBanner(false, 'chatFollow');
  }
  addLog(`🏁 批量回复完成：成功 ${okCount}，跳过 ${skipCount}，失败 ${failCount}`, okCount > 0 ? 'success' : 'warn');
  // 重新同步渲染（页面 DOM 已更新，重建会话）
  await loadChatFollow(container);
}

/* ══════════ 通知回访队列（🔔 通知 · 用户清单页顶部） ══════════
   队列项＝「通知里有人回了我、我还没回」的那个会话（@人）。
   数据就是 chat_follow_state.conversations：回复成功会写 lastRepliedIncoming → needReply 归零，
   于是「回完自动出队、改状态＝改队列」，进度不用另存——重开弹窗照样从剩下的接着跑。
   待回＝needReply && pendingIncoming；已完成＝本轮回过的（成功/跳过/失败落 chat_follow_queue.done，只留当天看）。
   额度：ai_cs_daily.notif_reply（跟「配置-通知」里「通知回访」的 dailyMax 同一个账本，background.aiCsBump 是正源）。 */
const CHATQ_KEY = 'chat_follow_queue';
const CHATQ_DONE_KEEP = 60;
let _chatqBox = null;       // 队列块容器（重渲染用）
let _chatqRunning = false;  // 执行器在跑（页面内存；关掉弹窗即中断，与灌水队列同口径）
let _chatqStop = false;     // ⏹ 停止 置位
let _chatqLive = null;      // 正在回谁：{userName,i,total,at}
let _chatqTick = null;      // 跑的时候每秒刷一次「已等 Ns」

function _chatqDayKey(at) { try { return new Date(at || Date.now()).toISOString().slice(0, 10); } catch (_) { return ''; } }
function _chatqNorm(raw) {
  const q = (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : {};
  const s = (x) => String(x || '');
  const n = (x) => Number(x) || 0;
  const run = q.running;
  return {
    v: 1,
    running: (run && run.userId) ? { userId: s(run.userId), userName: s(run.userName), at: n(run.at), idx: n(run.idx), total: n(run.total) } : null,
    done: (Array.isArray(q.done) ? q.done : []).slice(0, CHATQ_DONE_KEEP).map(d => ({
      userId: s(d.userId), userName: s(d.userName), at: n(d.at),
      status: (d.status === 'ok' || d.status === 'skip') ? d.status : 'fail',
      reply: s(d.reply), reason: s(d.reason), incoming: s(d.incoming),
    })),
  };
}
async function chatqGet() {
  try { const d = await chrome.storage.local.get(CHATQ_KEY); return _chatqNorm(d && d[CHATQ_KEY]); }
  catch (_) { return _chatqNorm(null); }
}
async function chatqSave(q) {
  const next = _chatqNorm(q);
  try { await chrome.storage.local.set({ [CHATQ_KEY]: next }); } catch (_) {}
  return next;
}
/* 待回清单：从会话状态现场派生（回复成功即自动出队，不用另存队列） */
async function chatqPending() {
  const st = await readPlain('chat_follow_state');
  const convs = ((st || {}).conversations) || {};
  return Object.keys(convs)
    .map(uid => Object.assign({ userId: uid }, convs[uid]))
    .filter(c => c.needReply && c.pendingIncoming && !c.stale && !c.sold)
    .sort((a, b) => ((a.pendingIdx == null ? 9999 : a.pendingIdx) - (b.pendingIdx == null ? 9999 : b.pendingIdx)) || ((b.turnCount || 0) - (a.turnCount || 0)));
}
/* 额度：x＝今天已回（账本里 notif_reply 的条数），y＝配置 dailyMax（0＝不限） */
async function chatqQuota() {
  let used = 0, max = 0;
  try {
    const d = await chrome.storage.local.get('ai_cs_daily');
    used = ((((d || {})['ai_cs_daily'] || {})[_chatqDayKey(Date.now())] || {}).notif_reply) || 0;
  } catch (_) {}
  try {
    const cfg = await _aiCsLoad();
    const sc = ((cfg || {}).scenes || {}).notif_reply || {};
    max = Number((sc.schedule && sc.schedule.dailyMax) || 0) || 0;
  } catch (_) {}
  return { used, max };
}
/* 回成功一条 → 计进 notif_reply 账本（口径同 background.aiCsBump） */
async function _chatqBump() {
  const key = 'ai_cs_daily'; const day = _chatqDayKey(Date.now());
  let data = {};
  try { data = (await chrome.storage.local.get(key))[key] || {}; } catch (_) {}
  data[day] = data[day] || {};
  data[day].notif_reply = (data[day].notif_reply || 0) + 1;
  try { await chrome.storage.local.set({ [key]: data }); } catch (_) {}
}
/* 这一位处理完（成功/跳过/失败）→ 记一条，running 清掉 */
async function _chatqDone(conv, status, reply, reason) {
  const q = await chatqGet();
  const done = [{
    userId: conv.userId, userName: conv.userName, at: Date.now(),
    status, reply: String(reply || ''), reason: String(reason || ''), incoming: conv.pendingIncoming || '',
  }].concat(q.done);
  await chatqSave(Object.assign({}, q, { done, running: null }));
}

/* 挂到「通知 · 用户清单」页顶部（renderProspectList 里调用） */
function chatqMount(container) {
  const box = document.createElement('div');
  box.id = 'chatqBlock';
  container.appendChild(box);
  _chatqBox = box;
  chatqReload();
}

function _chatqStartTick() {
  if (_chatqTick) return;
  _chatqTick = setInterval(_chatqPaintLive, 1000);
}
function _chatqStopTick() { if (_chatqTick) { clearInterval(_chatqTick); _chatqTick = null; } }
function _chatqPaintLive() {
  const box = _chatqBox;
  if (!box || !box.isConnected || !_chatqLive) return;
  const el = box.querySelector('#chatqLive');
  if (!el) return;
  el.textContent = `▶ 正在回 @${_chatqLive.userName || '对方'}（${_chatqLive.i}/${_chatqLive.total}） · 已等 ${Math.round((Date.now() - _chatqLive.at) / 1000)}s`;
}

async function chatqReload() {
  const box = _chatqBox;
  if (!box || !box.isConnected) return;
  const [pending, q, quota] = await Promise.all([chatqPending().catch(() => []), chatqGet(), chatqQuota()]);
  const today = _chatqDayKey(Date.now());
  const doneToday = (q.done || []).filter(d => _chatqDayKey(d.at) === today);
  const okToday = doneToday.filter(d => d.status === 'ok').length;

  box.style.cssText = 'border:1px solid #e3e8ef;border-radius:8px;background:#fff;padding:8px 10px;margin:0 0 8px;';
  while (box.firstChild) box.removeChild(box.firstChild);

  // ── 顶栏：待回 N · 今日已回 x/y ＋ [▶ 开始][⏹ 停止][🔄 同步通知页] ──
  const bar = document.createElement('div');
  bar.style.cssText = 'display:flex;align-items:center;gap:8px;flex-wrap:wrap;';
  const title = document.createElement('span');
  title.style.cssText = 'font-size:12px;font-weight:700;color:#0e7490;';
  title.textContent = '💬 通知回访队列';
  title.title = '通知里有人回了你的评论/笔记 → 这里排队挨个回（AI 生成 → 自动发送 → 3~8 秒随机间隔）';
  bar.appendChild(title);
  const meter = document.createElement('span');
  meter.style.cssText = 'font-size:11px;color:#6b7280;';
  meter.innerHTML = `待回 <b style="color:${pending.length ? '#c62828' : '#9ca3af'};">${pending.length}</b>` +
    ` · 今日已回 <b style="color:#059669;">${quota.used}</b>/${quota.max > 0 ? quota.max : '不限'}`;
  meter.title = quota.max > 0
    ? `「通知回访」每日上限 ${quota.max} 条（在「线索 → 任务配置 → 话术配置」里调），今天已回 ${quota.used} 条`
    : '「通知回访」没设每日上限（在「线索 → 任务配置 → 话术配置」里调）';
  bar.appendChild(meter);
  const btnWrap = document.createElement('span');
  btnWrap.style.cssText = 'margin-left:auto;display:inline-flex;gap:6px;flex-wrap:wrap;';
  const startBtn = document.createElement('button');
  startBtn.className = 'batch-send-btn';
  startBtn.id = 'chatqStart';
  startBtn.textContent = _chatqRunning ? '⏳ 跑着…' : '▶ 开始';
  startBtn.disabled = _chatqRunning;
  startBtn.style.cssText = 'padding:4px 12px;font-size:11px;';
  startBtn.title = '先同步通知页，再按队列串行回访：AI 生成 → 自动发送 → 3~8 秒随机间隔（跑的时候别在通知页手动回复，免得抢位）';
  startBtn.addEventListener('click', () => chatqStart());
  const stopBtn = document.createElement('button');
  stopBtn.className = 'refresh-btn';
  stopBtn.id = 'chatqStop';
  stopBtn.textContent = '⏹ 停止';
  stopBtn.disabled = !_chatqRunning;
  stopBtn.style.cssText = 'padding:4px 12px;font-size:11px;';
  stopBtn.title = '当前这一位回完就停，剩下的下次点「▶ 开始」接着跑';
  stopBtn.addEventListener('click', () => chatqStop());
  const syncBtn = document.createElement('button');
  syncBtn.className = 'refresh-btn';
  syncBtn.id = 'chatqSync';
  syncBtn.textContent = '🔄 同步通知页';
  syncBtn.disabled = _chatqRunning;
  syncBtn.style.cssText = 'padding:4px 12px;font-size:11px;';
  syncBtn.title = '重新从通知页提取通知流并重组会话（需要通知页开着）';
  syncBtn.addEventListener('click', () => chatqSync());
  btnWrap.append(startBtn, stopBtn, syncBtn);
  bar.appendChild(btnWrap);
  box.appendChild(bar);

  // ── ▶ 正在回 / ⏸ 上次停在这 ──
  if (_chatqLive) {
    const live = document.createElement('div');
    live.id = 'chatqLive';
    live.style.cssText = 'font-size:11px;color:#b45309;font-weight:600;margin-top:6px;';
    live.textContent = `▶ 正在回 @${_chatqLive.userName || '对方'}（${_chatqLive.i}/${_chatqLive.total}） · 已等 ${Math.round((Date.now() - _chatqLive.at) / 1000)}s`;
    box.appendChild(live);
  } else if (q.running) {
    const stale = document.createElement('div');
    stale.style.cssText = 'font-size:11px;color:#8a8f99;margin-top:6px;';
    stale.textContent = `⏸ 上次停在这：@${q.running.userName || '对方'}（第 ${q.running.idx || '?'}/${q.running.total || '?'} 位）——点「▶ 开始」接着跑`;
    box.appendChild(stale);
  }

  // ── ⏳ 待回（沿用会话卡片：AI 生成 / 发送 / ⏭ 手动回复过了） ──
  if (pending.length) {
    const sec = document.createElement('details');
    sec.open = _chatqRunning || pending.length <= 3;
    const sum = document.createElement('summary');
    sum.style.cssText = 'font-size:11px;font-weight:700;color:#c62828;cursor:pointer;margin-top:6px;';
    sum.textContent = `⏳ 待回（${pending.length}）· ` + pending.slice(0, 3).map(c => c.userName || '对方').join('、') + (pending.length > 3 ? ' 等' : '');
    const q = document.createElement('span');
    q.className = 'qhelp';
    q.tabIndex = 0;
    q.setAttribute('data-tip', '通知页看不出「你是否已手动回过」：手动回过的点该会话的「⏭ 手动回复过了」，免得重复回。');
    q.textContent = '?';
    sum.appendChild(q);
    sec.appendChild(sum);
    pending.forEach(conv => { try { sec.appendChild(createChatFollowCard(conv)); } catch (_) {} });
    box.appendChild(sec);
  } else {
    const none = document.createElement('div');
    none.style.cssText = 'font-size:11px;color:#8a8f99;margin-top:6px;';
    none.textContent = '📭 没有待回的会话（通知里有人回你时，点「🔄 同步通知页」把对话抓进来）';
    box.appendChild(none);
  }

  // ── ✅ 已回（今天，折叠；成功给回复摘要，失败给原因） ──
  if (doneToday.length) {
    const sec = document.createElement('details');
    const sum = document.createElement('summary');
    sum.style.cssText = 'font-size:11px;font-weight:700;color:#059669;cursor:pointer;margin-top:6px;';
    sum.textContent = `✅ 已回（今天 ${doneToday.length} 条` + (okToday ? ` · 成功 ${okToday}` : '') + '）';
    sec.appendChild(sum);
    const list = document.createElement('div');
    list.style.cssText = 'margin-top:4px;';
    doneToday.forEach(d => {
      const row = document.createElement('div');
      row.style.cssText = 'font-size:11px;color:#555;padding:2px 0;border-bottom:1px dashed #f0f0f0;line-height:1.6;';
      const time = new Date(d.at).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      const body = d.status === 'ok'
        ? `<span style="color:#059669;font-weight:600;">✅ 已回</span>：${esc(String(d.reply || '').slice(0, 40))}${String(d.reply || '').length > 40 ? '…' : ''}`
        : d.status === 'skip'
          ? `<span style="color:#8a8f99;font-weight:600;">⏭ 跳过</span>：${esc(d.reason || 'AI 判定无需回复')}`
          : `<span style="color:#c62828;font-weight:600;">❌ 失败</span>：${esc(d.reason || '未知原因')}`;
      row.innerHTML = `<span style="color:#9ca3af;">🕐 ${time}</span> · @${esc(d.userName || '对方')} · ${body}`;
      list.appendChild(row);
    });
    sec.appendChild(list);
    box.appendChild(sec);
  }
}

/* ▶ 开始：先同步通知页（pendingIdx 必须是当前页面上那一条才敢点发送）→ 串行回访到队空/撞上限/被停 */
async function chatqStart() {
  if (_chatqRunning) return;
  const quota0 = await chatqQuota();
  if (quota0.max > 0 && quota0.used >= quota0.max) {
    addLog(`⏹ 「通知回访」今天已达上限 ${quota0.max} 条（今天已回 ${quota0.used}），队列不跑（上限在「线索 → 任务配置 → 话术配置」里调）`, 'warn');
    return;
  }
  _chatqRunning = true; _chatqStop = false;
  _chatqStartTick();
  let ok = 0, skip = 0, fail = 0, stopped = false, capHit = false;
  try {
    await chatqReload();
    addLog('🔄 通知回访：先同步通知页（把通知流重组成会话）…', 'info');
    const data = await chatFollowSync();
    if (!data) { addLog('📍 请先打开小红书通知页（xiaohongshu.com/notification）再点「▶ 开始」', 'warn'); return; }
    const pending = await chatqPending();
    await chatqReload();
    if (!pending.length) { addLog('📭 没有待回的会话，队列是空的', 'info'); return; }
    addLog(`▶ 通知回访队列开跑：${pending.length} 位待回（今日已回 ${quota0.used}${quota0.max > 0 ? '/' + quota0.max : ''}）`, 'info');

    for (let i = 0; i < pending.length; i++) {
      if (_chatqStop) { stopped = true; break; }
      const q = await chatqQuota();
      if (q.max > 0 && q.used >= q.max) {
        capHit = true;
        addLog(`⏹ 已达每日上限 ${q.max} 条（今天已回 ${q.used}），队列停在 @${pending[i].userName || '对方'}——明天点「▶ 开始」接着跑`, 'warn');
        break;
      }
      const conv = pending[i];
      const name = conv.userName || '对方';
      _chatqLive = { userName: name, i: i + 1, total: pending.length, at: Date.now() };
      await chatqSave(Object.assign({}, await chatqGet(), {
        running: { userId: conv.userId, userName: name, at: Date.now(), idx: i + 1, total: pending.length },
      }));
      await chatqReload();

      // 1) AI 生成回复
      addLog(`🤖 [${i + 1}/${pending.length}] @${name}：AI 生成回复...`, 'info');
      let gen = null;
      try {
        const resp = await chrome.runtime.sendMessage({ action: 'chatFollowReply', data: { userId: conv.userId } });
        if (resp && resp.ok) gen = resp;
        else throw new Error((resp && resp.error) || 'AI 生成失败');
      } catch (e) {
        fail++;
        addLog(`⚠️ [${i + 1}/${pending.length}] @${name} 生成失败：${(e && e.message) || e}，跳过`, 'warn');
        await _chatqDone(conv, 'fail', '', 'AI 生成失败：' + ((e && e.message) || e));
        _chatqLive = null; await chatqReload();
        continue;
      }
      // 2) AI 判定无需回复（含礼貌性结束语）→ 标记已处理，这条从此出队
      if (!gen.reply) {
        skip++;
        addLog(`⏭ [${i + 1}/${pending.length}] @${name} AI 判定无需回复（${gen.reason || 'noop'}），已标记`, 'info');
        try { await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: '', lastRepliedIncoming: conv.pendingIncoming } }); } catch (_) {}
        await _chatqDone(conv, 'skip', '', gen.reason || 'AI 判定无需回复');
        _chatqLive = null; await chatqReload();
        continue;
      }
      addLog(`💬 [${i + 1}/${pending.length}] @${name} AI 判断 [${gen.action}]：${gen.reply.slice(0, 50)}${gen.reply.length > 50 ? '…' : ''}`, gen.action === 'sell' ? 'warn' : 'info');
      // 3) 发送（三重定位 + 发送前校验 latestText 在 content.js）
      let sendErr = '';
      try {
        const tab = await _ensureNotificationTab();
        if (!tab) throw new Error('通知页已关闭或切换，无法发送');
        const sendResp = await chrome.tabs.sendMessage(tab.id, {
          action: 'replyNotification',
          idx: conv.pendingIdx,
          replyText: gen.reply,
          userId: conv.userId,
          userName: conv.userName,
          latestText: conv.pendingIncoming,
        });
        if (!sendResp || !sendResp.success) throw new Error((sendResp && sendResp.error) || '发送失败');
      } catch (e) { sendErr = (e && e.message) || String(e); }
      if (!sendErr) {
        ok++;
        await _chatqBump();   // 计入 notif_reply 每日额度
        try { await chrome.runtime.sendMessage({ action: 'chatFollowMarkSent', data: { userId: conv.userId, replyText: gen.reply, lastRepliedIncoming: conv.pendingIncoming } }); } catch (_) {}
        addLog(`✅ [${i + 1}/${pending.length}] @${name} 回复成功`, 'success');
        await _chatqDone(conv, 'ok', gen.reply, '');
      } else {
        fail++;
        addLog(`❌ [${i + 1}/${pending.length}] @${name} 发送失败：${sendErr}，跳过`, 'error');
        await _chatqDone(conv, 'fail', '', sendErr);
      }
      _chatqLive = null; await chatqReload();
      // 4) 条间间隔：随机 3~8 秒（最后一位不用等；等的时候也听停止）
      if (i < pending.length - 1) {
        const gap = 3000 + Math.floor(Math.random() * 5000);
        addLog(`⏸ 停 ${(gap / 1000).toFixed(1)}s 再回下一位...`, 'info');
        for (let t = 0; t < gap; t += 500) { if (_chatqStop) break; await sleep(500); }
      }
    }
  } catch (e) {
    addLog(`⛔ 通知回访中断：${(e && e.message) || e}`, 'error');
  } finally {
    _chatqRunning = false; _chatqLive = null; _chatqStopTick();
    await chatqSave(Object.assign({}, await chatqGet(), { running: null }));
    await chatqReload();
    if (ok + skip + fail > 0 || stopped || capHit) {
      addLog(`🏁 通知回访本轮结束：成功 ${ok} · 跳过 ${skip} · 失败 ${fail}` +
        (capHit ? '（撞每日上限，剩下的明天接着跑）' : (stopped ? '（被手动停止，剩下的下次接着跑）' : '')),
        ok > 0 ? 'success' : 'warn');
    }
  }
}

function chatqStop() {
  if (!_chatqRunning) return;
  _chatqStop = true;
  addLog('⏹ 收到停止信号，等当前这一位回完就停…', 'warn');
}

async function chatqSync() {
  if (_chatqRunning) return;
  addLog('🔄 同步通知页…', 'info');
  try {
    const data = await chatFollowSync();
    if (!data) addLog('📍 请先打开小红书通知页（xiaohongshu.com/notification）再同步', 'warn');
  } catch (e) {
    addLog('❌ 同步通知页失败：' + ((e && e.message) || e), 'error');
  }
  await chatqReload();
}

/* 会话状态被手动改过（生成/发送/跳过）后的刷新：队列块在就刷它，否则退回旧会话视图 */
async function _chatFollowAfterAction() {
  if (_chatqBox && _chatqBox.isConnected) return chatqReload();
  return reloadChatFollow();
}

// ========== 商机挖掘 ==========
// skipScreen=true：跳过评论量门槛，把不足 10 条的评论也强塞给 AI（空态里“仍要 AI 全量分析”按钮用）

// ── 同行碰撞笔记判定（获客时"不灌水、只收求分享线索") ──
//  逻辑：某笔记评论区里"求分享/求资料/求带/想要/蹲..."等求取类评论占比过高，
//  说明这是同行引流/资料钩子笔记，评论早已挤满各路中介的灌水，此刻再上去灌水极易碰撞/被淹/被拉黑。
//  → 这种笔记不灌水；改为把"求分享"的评论用户收进用户清单线索池，并备好触达词供私聊（不浪费这篇的获客价值）。
const REQ_SHARE_RE = /(求(分享|一份|一[份套发]|资料|带|模板|教程|资源|电子(版)?|报价|私(信|聊)?|发|领)|发我(一|[一1])?份|分享(我|给我|一份|一下)|发一下|发你吗|我要(一份|一个)|想要(一份|一个)|蹲(蹲|一个?|一波)?|蹲蹲|怎么领|哪里([可]?以|能)|能[不]?能(发|给我)|求求|谢谢?[发您你了]?我)/;
const SHARE_DENSITY_MIN = 0.15;  // 求分享评论占比 ≥15%
const SHARE_HITS_MIN = 2;        // 且至少命中 2 条，才判定为碰撞
const _shareNorm = (s) => String(s || '').replace(/^@/, '').replace(/\s+/g, '').toLowerCase().trim();
/** 检测某评论是否为"求分享/求取"类（本地启发式，不烧 AI） */
function _isReqShareComment(c) {
  return REQ_SHARE_RE.test(_shareNorm(c && c.content));
}
/** 判定笔记是否属于"同行碰撞、不应灌水"：命中返回 [{author,content,userLink}...]，未命中返回 [] */
function collisionShareHits(comments) {
  const hits = (comments || []).filter(_isReqShareComment);
  const density = comments && comments.length > 0 ? hits.length / comments.length : 0;
  if (hits.length >= SHARE_HITS_MIN && density >= SHARE_DENSITY_MIN) return hits;
  return [];
}
/** 读取"碰撞笔记 → 只收线索不灌水"开关（默认开，可在设置 behavior_config 关闭） */
async function collisionLeadModeEnabled() {
  try {
    const d = await chrome.storage.local.get('behavior_config');
    const c = (d && d.behavior_config) || {};
    return c.collisionLeadMode !== false;
  } catch (_) { return true; }
}
// 调试钩子：window.__collisionDebug=true 时打印判定明细，便于调阈值
window.__collisionShareLog = function(msg){ if (window.__collisionDebug) addLog(msg, 'warn'); };

// skipScreen=true：跳过评论量门槛，把不足 10 条的评论也强塞给 AI（空态里“仍要 AI 全量分析”按钮用）
async function loadProspecting(container, skipScreen) {
  // 清空容器，用 DOM 方法添加加载提示（不用 innerHTML）
  while (container.firstChild) container.removeChild(container.firstChild);
  // 重置点赞记录（新扫描 = 新笔记，清空旧列表）
  likedComments = [];

  // ★ 顶部醒目 Banner：先检查本地已回复记录
  let repliedBanner = null;
  let allRepliedKeys = new Set();
  try {
    const localReplied = await getLocalRepliedForNote(pageData.url || '');
    if (localReplied.length > 0) {
      localReplied.forEach(e => allRepliedKeys.add(e.author + '||' + e.comment));
      repliedBanner = createRepliedBanner(localReplied.length);
      container.appendChild(repliedBanner);
    }
  } catch (_) {}

  const loadingDiv = document.createElement('div');
  loadingDiv.style.cssText = 'padding:20px;text-align:center;color:#666;';
  loadingDiv.innerHTML = '<div class="loading-spinner" style="margin:0 auto 8px;"></div><div>AI 正在扫描评论...</div>';
  container.appendChild(loadingDiv);

  try {
    // 先检查已回复的评论，过滤掉
    let filteredComments = pageData.comments || [];
    let filteredCount = 0;

    // 从本地存储获取已回复列表
    let localReplied = [];
    try {
      localReplied = await getLocalRepliedForNote(pageData.url || '');
    } catch (_) {}

    // 合并去重（key = author||content）
    addLog('📋 检查本地已回复记录...', 'info');
    const localKeys = new Set(localReplied.map(e => e.author + '||' + e.comment));
    allRepliedKeys = new Set([...localKeys]);
    filteredComments = (pageData.comments || []).filter(c => !allRepliedKeys.has((c.author || '') + '||' + (c.content || '')));
    filteredCount = (pageData.comments || []).length - filteredComments.length;

    // 构建索引映射：filteredIndex → originalIndex
    const originalIdxMap = [];
    const _allComments = pageData.comments || [];
    const _mapKeys = new Set(allRepliedKeys);
    _allComments.forEach((c, i) => {
      if (!_mapKeys.has((c.author || '') + '||' + (c.content || ''))) {
        originalIdxMap.push(i);
      }
    });

    // 如果有已回复记录，更新或插入 Banner
    if (filteredCount > 0) {
      if (!repliedBanner) {
        repliedBanner = createRepliedBanner(filteredCount);
        container.insertBefore(repliedBanner, container.firstChild);
      } else {
        repliedBanner.innerHTML = `📢 本条笔记已有 <strong>${allRepliedKeys.size}</strong> 条回复记录，已自动从扫描中排除`;
      }
    }

    // 如果全部已回复，直接提示
    if (filteredComments.length === 0) {
      while (container.firstChild) container.removeChild(container.firstChild);
      if (repliedBanner) container.appendChild(repliedBanner);
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'empty-prospect';
      emptyDiv.innerHTML = `
        <div style="font-size:28px;margin-bottom:10px;">✅</div>
        <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">所有评论都已回复过</div>
        <div style="font-size:12px;color:#555;line-height:1.6;">已过滤 <strong>${filteredCount}</strong> 条已回复评论。</div>
        <button id="retryProspectBtn" class="retry-btn">🔄 重新扫描</button>`;
      container.appendChild(emptyDiv);
      document.getElementById('retryProspectBtn')?.addEventListener('click', async () => {
        addLog('🔄 重新扫描（所有已回复）', 'info');
        setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
        await refreshData();
      });
      setStatus('✅ 所有评论已回复', 'success');
      await _finishTabStatusBar();
      broadcastAiScanDone(false); // ★ 本篇无待发评论，通知机器人返回列表
      return;
    }

    // ★ 同行碰撞笔记：评论区"求分享"占比过高 → 判定为同行引流/资料钩子笔记，
    //   不灌水（避免碰撞/被淹/被拉黑），改为把"求分享"用户收入线索池 + 备触达词供私聊。
    if (await collisionLeadModeEnabled()) {
      let shareHits = [];
      try { shareHits = collisionShareHits(filteredComments); } catch (_) {}
      if (shareHits.length > 0) {
        const _leadsOn = editionFeatureOn('prospectList');
        addLog(`🚦 判定为本篇为同行碰撞笔记：${shareHits.length}/${filteredComments.length} 条为求分享评论，本笔记不灌水` + (_leadsOn ? '，改收求分享线索' : ''), 'warn');
        window.__collisionShareLog(`碰撞明细：${shareHits.map(h => '@' + (h.author || '?')).join('、')}`);
        await renderShareLeads(container, shareHits, { repliedBanner });
        // ★ 本篇无待发评论（lead 模式不灌水）→ 通知机器人返回列表 / 去下一篇，严格流水线不卡死
        //   与其它"无商机"出口一致：只广播 broadcastAiScanDone(false)，不额外 noteDone，避免双信号重复推进下篇
        broadcastAiScanDone(false);
        await _finishTabStatusBar();
        return;
      }
    }

    // ★ 评论量门槛：刚起量/没流量的文章评论不足，没有挖掘价值 → 直接退出，不劳烦 AI。
    //   评论 ≥10 条才值得挖（skipScreen=true 时跳过，强制全量分析）
    if (skipScreen) {
      addLog('⏩ 已按你的要求跳过评论量门槛（不足 10 条也全量分析）', 'warn');
    } else if (filteredComments.length < 10) {
      while (container.firstChild) container.removeChild(container.firstChild);
      if (repliedBanner) container.appendChild(repliedBanner);
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'empty-prospect';
      emptyDiv.innerHTML = `
        <div style="font-size:28px;margin-bottom:10px;">📉</div>
        <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">评论不足 10 条，跳过商机挖掘</div>
        <div style="font-size:12px;color:#555;line-height:1.6;">刚起量的文章评论太少（当前 <strong>${filteredComments.length}</strong> 条），<br>没有值得挖掘的商机，已直接退出。</div>
        <button id="forceAiBtn" class="retry-btn">🤖 仍要 AI 全量分析</button>
        <button id="retryProspectBtn" class="retry-btn">🔄 重新扫描</button>`;
      container.appendChild(emptyDiv);
      document.getElementById('forceAiBtn')?.addEventListener('click', async () => {
        addLog('🤖 手动要求：评论不足 10 条仍要 AI 分析', 'warn');
        setStatus('<span class="loading-spinner"></span> AI 全量分析中...', '');
        await loadProspecting(container, true);
      });
      document.getElementById('retryProspectBtn')?.addEventListener('click', async () => {
        addLog('🔄 重新扫描（评论不足）', 'info');
        setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
        await refreshData();
      });
      setStatus('📉 评论不足 10 条，已跳过', 'success');
      await _finishTabStatusBar();
      broadcastAiScanDone(false); // ★ 本篇无商机结束，通知机器人返回列表
      return;
    }

    // ★ 把“到底抓到了啥”显示在评论助手日志里，方便每次核对拓取结果
    // 同时做一个“疑似拓错”自检：若大量评论正文都是纯数字/万（很可能把点赞数当成了正文），就高亮告警
    try {
      const _shown = filteredComments.slice(0, 30);
      addLog(`🔍 本次共拓到 ${(pageData.comments || []).length} 条评论（过滤已回复后待分析 ${filteredComments.length} 条），下面逐条列出让你核对：`, 'info');
      // ★ 同城挡位状态：把「关没关 / 城市记没记」明确报出来，避免以为同城没生效
      try {
        const _cfg = await readConfigPlain();
        const _mc = (_cfg && _cfg.myCity && typeof _cfg.myCity === 'object') ? _cfg.myCity : {};
        const _myCity = String(_mc.city || '').trim();
        const _myZone = String(_mc.ipLocation || '').trim();
        const _mode = ['force', 'priority', 'off'].includes(_cfg && _cfg.sameCityMode) ? _cfg.sameCityMode : 'priority';
        const _modeName = { force: '同城就回', priority: '同城优先', off: '已关闭' }[_mode];
        if (_mode === 'off') {
          addLog('🏙 同城挡位已关闭：属地不参与判断（可在「诊断&配置 → 基础配置」开启）', 'info');
        } else if (_myCity || _myZone) {
          addLog(`🏙 同城挡位${_modeName}：我的城市 = ${_myCity || _myZone}${(_myZone && _myCity && _myZone !== _myCity) ? '（主页 IP 属地：' + _myZone + '）' : ''} · 同省即算同城`, 'info');
        } else {
          addLog(`🏙 同城挡位${_modeName}，但还没记录你的城市 → 去「诊断&配置 → 基础配置」抓主页读取或手填，否则同城不会生效`, 'warn');
        }
      } catch (_) {}
      let _numLike = 0;
      _shown.forEach((c, i) => {
        const body = (c.content || '').trim();
        const isNumLike = /^[\d,\.\s万k＋+]+$/i.test(body); // 正文只剩数字/万/k → 很可能是点赞数
        if (isNumLike) _numLike++;
        const flag = isNumLike ? ' ⚠️疑似点赞数而非正文' : '';
        const locTag = c.location ? `[${c.location}]` : '';
        addLog(`  ${i + 1}. @${esc(c.author || '?')}${locTag}: ${esc(body.slice(0, 60))}${body.length > 60 ? '…' : ''}${flag}`, isNumLike ? 'warn' : 'info');
      });
      if (filteredComments.length > _shown.length) {
        addLog(`  …其余 ${filteredComments.length - _shown.length} 条未列出`, 'info');
      }
      // 自检汇总：过半评论都是纯数字 → 大概率把点赞数当成了正文
      if (_shown.length >= 3 && _numLike >= Math.ceil(_shown.length * 0.5)) {
        addLog(`⚠️ 自检：${_numLike}/${_shown.length} 条评论正文都是纯数字，极可能拓取时把“点赞数/互动数”当成了评论正文，真正的评论文字没抓到！这会导致 AI 无法判断商机。`, 'warn');
      }
    } catch (_) {}

    // 本地计数检查对这篇博文的评论次数，防止被拉黑
    let noteCommentWarning = '';
    try {
      const noteCount = await getNoteReplyCount(pageData.url || '');
      if (noteCount >= 5) {
        noteCommentWarning = `⚠️ 你已在这篇笔记下回复过 ${noteCount} 次，建议不要再回复了，容易被博主拉黑！`;
      } else if (noteCount >= 3) {
        noteCommentWarning = `⚠️ 你已在这篇笔记下回复过 ${noteCount} 次，注意控制频率`;
      } else if (noteCount > 0) {
        noteCommentWarning = `📝 你在这篇笔记下回复过 ${noteCount} 次`;
      }
    } catch (_) {}

    // 通过 background.js 请求商机挖掘（skipAiScreen：“仍要 AI 全量分析”按钮同时跳过本地预筛和 AI 快筛）
    const requestData = { ...pageData, comments: filteredComments, skipAiScreen: !!skipScreen };
    // ★ AI 返回期间也锁定界面，并告知“AI 正在思考”（网络请求可能要十几秒，防止用户此时手动操作）
    setLockBanner(true, 'aiThinking');
    _startAiThinkingTicker();
    // ★ 同步让网页那条红色状态栏也显示“AI 分析中”（AI 跑在 background，内容脚本自己不知道）
    await _setTabStatusBar('🤖 AI 正在分析评论、生成话术…（请稍候）');
    addLog('🤖 AI 开始分析评论、生成话术（网络请求中，请稍候）...', 'info');
    let bgResp;
    // ★ AI 调用也设超时：findProspects 在 background 可能因网络/AI 服务长期不返回（无超时 → 刷新评论会永久卡在
    //   “AI 分析”这一步）。超时后走下方统一 catch：显示明确错误 + broadcastAiScanDone 放行（机器人可去下一篇），绝不无限等。
    const FIND_PROSPECTS_TIMEOUT = 180000;
    let _ft = null;
    const _timed = new Promise((_, reject) => {
      _ft = setTimeout(() => {
        const e = new Error('商机挖掘超时（' + Math.round(FIND_PROSPECTS_TIMEOUT / 1000) + 's），AI 未返回结果，已跳过本篇');
        e._timeout = true;
        reject(e);
      }, FIND_PROSPECTS_TIMEOUT);
    });
    try {
      bgResp = await Promise.race([
        chrome.runtime.sendMessage({ action: 'findProspects', data: requestData }),
        _timed,
      ]);
    } finally {
      if (_ft) clearTimeout(_ft);
      // 无论成败都先停读秒并解锁（后续点赞/发送等流程会各自重新锁定）
      _stopAiThinkingTicker();
      setLockBanner(false, 'aiThinking');
      // ★ 整条流程到此结束 → 网页红色状态栏停读秒、切“等待用户操作”
      await _finishTabStatusBar();
    }
    if (!bgResp?.ok) {
      const scanErr = new Error(bgResp?.error || '商机挖掘失败');
      scanErr.aiRaw = bgResp?.aiRaw || ''; // 解析失败时携带 AI 完整原始回复，供排查/手动使用
      throw scanErr;
    }
    const result = bgResp;

    const prospects = result.prospects || [];
    const summary = result.summary || '';

    // ★ 快筛打断：AI 判定抓到的根本不是真实评论（点赞数/昵称/界面文字）→ 不做大分析，直接提示重拓。
    //   ★ 自动模式（机器人带跑）下不弹红色"打断"界面、不阻塞——只记一条"跳过本篇"，交给机器人去下一篇。
    if (result.captureError) {
      if (_lastScanWasAuto) {
        addLog(`⏭ 本篇抓取异常，自动跳过（AI 快筛：${result.captureError}）`, 'warn');
        broadcastAiScanDone(false); // ★ 通知机器人返回列表 / 去下一篇
        return;
      }
      while (container.firstChild) container.removeChild(container.firstChild);
      const errDiv = document.createElement('div');
      errDiv.className = 'empty-prospect';
      errDiv.innerHTML = `
        <div style="font-size:28px;margin-bottom:10px;">🛑</div>
        <div style="font-size:14px;color:#c62828;margin-bottom:6px;font-weight:500;">抓取内容可能不是真实评论</div>
        <div style="font-size:12px;color:#555;line-height:1.6;max-width:400px;margin:0 auto;">AI 快筛发现：${esc(result.captureError)}<br>已打断分析，请重新扫描重拓评论。</div>
        <button id="retryProspectBtn" class="retry-btn">🔄 重新扫描</button>`;
      container.appendChild(errDiv);
      document.getElementById('retryProspectBtn')?.addEventListener('click', async () => {
        addLog('🔄 重新扫描（抓取异常打断）', 'info');
        setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
        await refreshData();
      });
      addLog(`🛑 AI 判定抓取内容异常，已打断分析：${result.captureError}`, 'warn');
      setStatus('🛑 抓取内容异常，已打断', 'error');
      broadcastAiScanDone(false); // ★ 抓取异常打断，通知机器人返回列表
      return;
    }

    // ★ 快筛判定无价值：几秒就出结果，大分析根本没跑 → 省下 15~30 秒
    if (result.screenedByAi && prospects.length === 0) {
      while (container.firstChild) container.removeChild(container.firstChild);
      const fastDiv = document.createElement('div');
      fastDiv.className = 'empty-prospect';
      fastDiv.innerHTML = `
        <div style="font-size:28px;margin-bottom:10px;">⚡</div>
        <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">AI 快筛：本篇无相关商机</div>
        <div style="font-size:12px;color:#555;line-height:1.6;max-width:400px;margin:0 auto;">${esc(summary || '评论中没有与产品相关的需求/痛点')}<br>快筛仅耗时 ${((result.screenMs || 0) / 1000).toFixed(1)} 秒，已跳过完整分析。</div>
        <button id="forceAiBtn" class="retry-btn">🤖 仍要 AI 全量分析</button>
        <button id="retryProspectBtn" class="retry-btn">🔄 重新扫描</button>`;
      container.appendChild(fastDiv);
      document.getElementById('forceAiBtn')?.addEventListener('click', async () => {
        addLog('🤖 手动要求：跳过快筛，全量交给 AI 分析', 'warn');
        setStatus('<span class="loading-spinner"></span> AI 全量分析中...', '');
        await loadProspecting(container, true);
      });
      document.getElementById('retryProspectBtn')?.addEventListener('click', async () => {
        addLog('🔄 重新扫描（快筛无商机）', 'info');
        setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
        await refreshData();
      });
      addLog(`⚡ AI 快筛（${((result.screenMs || 0) / 1000).toFixed(1)} 秒）：本篇无相关商机，已跳过完整分析，省下约 20 秒`, 'success');
      setStatus('⚡ AI 快筛：本篇无相关商机', 'success');
      broadcastAiScanDone(false); // ★ 本篇无商机结束，通知机器人返回列表
      return;
    }

    kbImages = result.images || []; // 存储知识库匹配的图片（已按标签筛选）
    const kbMatchedEntries = result.matchedEntries || []; // 匹配的知识库条目
    const sameCityCount = prospects.filter(p => p.same_city === true).length;
    addLog(`✅ AI分析完成：发现 ${prospects.length} 个潜在客户${sameCityCount ? `（其中 🏙 同城 ${sameCityCount} 个）` : ''}`, 'success');
    
    // 日志：显示匹配的知识库条目
    if (kbMatchedEntries.length > 0) {
      addLog(`📚 知识库匹配 ${kbMatchedEntries.length} 条：`, 'info');
      kbMatchedEntries.forEach((entry, i) => {
        const roleTag = entry.role ? `[${entry.role}]` : '';
        const imgTag = entry.hasImage ? '🖼️' : '';
        addLog(`  ${i + 1}. ${roleTag}${entry.title} ${imgTag}`, 'info');
        addLog(`     ${entry.contentPreview}`, 'info');
      });
    } else {
      addLog('📚 知识库未匹配到相关条目', 'warn');
    }
    
    // 日志：显示待发送的图片
    if (kbImages.length > 0) {
      addLog(`🖼️ 待发送图片 ${kbImages.length} 张（带“产品操作”标签的条目）：`, 'info');
      kbImages.forEach((img, i) => {
        addLog(`  ${i + 1}. ${img.title}`, 'info');
      });
    } else {
      addLog('🖼️ 无待发送图片（匹配的知识库条目无“产品操作”标签）', 'info');
    }
    
    // 日志：显示给AI的完整提示词（用于调试）
    const prompts = result.prompts || {};
    if (prompts.system || prompts.user) {
      addLog('━━━━━━━━━━ 📝 AI提示词（调试用）━━━━━━━━━━', 'info');
      addLog('【System Prompt】', 'info');
      addLog(prompts.system || '(空)', 'info');
      addLog('【User Prompt】', 'info');
      addLog(prompts.user || '(空)', 'info');
      addLog('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
    }
    
    const commentCount = pageData?.comments?.length || 0;
    const VERSION_LABELS = ['A', 'B', 'C'];
    const VERSION_NAMES = ['朋友分享型', '数据分析型', '产品介绍型'];

    console.log('[商机挖掘] 原始响应:', JSON.stringify(result, null, 2));

    // ★ 验证每个 prospect 的索引映射是否正确（商机抓取后验证）
    //   如果 AI 返回的 index 有偏移（常见于 0-based vs 1-based 混淆），
    //   通过 author + content 片段在所有评论中查找正确匹配
    console.log('[验证] filteredCount:', filteredCount, 'originalIdxMap:', JSON.stringify(originalIdxMap));
    (prospects || []).forEach((p, i) => {
      const origIdx = originalIdxMap[p.index] !== undefined ? originalIdxMap[p.index] : p.index;
      const pageComment = pageData.comments && pageData.comments[origIdx];
      if (pageComment) {
        const authorMatch = p.author === pageComment.author;
        const aiText = (p.original_comment || '').slice(0, 30);
        const pageText = (pageComment.content || '').slice(0, 30);
        const contentMatch = pageText && aiText && (pageText.includes(aiText) || aiText.includes(pageText));
        console.log(`[验证] Prospect ${i}: AI.index=${p.index} → origIdx=${origIdx}, ` +
          `author: AI="${p.author}" vs 页面="${pageComment.author}" (${authorMatch ? '✓' : '✗'}), ` +
          `text: "${aiText}" vs "${pageText}" (${contentMatch ? '✓' : '✗'})`);
        p._verified = authorMatch && contentMatch;
        p._origIdx = origIdx;
        if (!authorMatch || !contentMatch) {
          // ★ 索引不匹配：尝试在所有评论中通过 author + content 片段查找正确评论
          //   这修正了 AI 可能的 off-by-one 错误（0-based vs 1-based 混淆）
          console.warn(`[验证] ⚠️ 索引不匹配, 尝试全文搜索修正...`);
          let foundIdx = -1;
          const aiAuthor = p.author;
          const aiText30 = (p.original_comment || '').slice(0, 30);
          for (let ci = 0; ci < (pageData.comments || []).length; ci++) {
            const cc = pageData.comments[ci];
            if (!cc) continue;
            const ccText30 = (cc.content || '').slice(0, 30);
            if (aiAuthor === cc.author && ccText30 && aiText30 &&
                (ccText30.includes(aiText30) || aiText30.includes(ccText30))) {
              foundIdx = ci;
              console.log(`[验证] ✓ 通过 author+text 匹配到正确评论: idx=${ci}`);
              break;
            }
          }
          if (foundIdx >= 0) {
            p.author = pageData.comments[foundIdx].author;
            p.original_comment = pageData.comments[foundIdx].content;
            p._origIdx = foundIdx;
            p._verified = true;
          } else {
            // 没找到匹配，用原始索引的数据（至少还能点进去看）
            console.warn(`[验证] ⚠️ 未找到匹配, 使用 origIdx=${origIdx} 的数据`);
            p.author = pageComment.author;
            p.original_comment = pageComment.content;
          }
          p._wasFixed = true;
        }
      } else {
        console.warn(`[验证] ⚠️ Prospect ${i}: origIdx=${origIdx} 在 pageData.comments 中不存在`);
        p._verified = false;
        p._origIdx = -1;
      }
    });
    const hasMismatch = prospects.some(p => !p._verified);

    // ========== 自动点赞（低成本的 ID 曝光 — 对每个潜在商机都赞） ==========
    // ★ 整批点赞交给 content.js 在同一把锁内串行完成（含每次之间的等待间隔），
    // 不再在 popup 侧逐个 sleep+发消息（那样等待间隔处于锁外，会被其它操作插入）
    (async () => {
      try {
        const tab = await getTargetTab();
        if (!tab) return;
        const likeList = [];
        for (const p of prospects) {
          const idx = p._origIdx !== undefined && p._origIdx >= 0
            ? p._origIdx
            : (originalIdxMap[p.index] !== undefined ? originalIdxMap[p.index] : p.index);
          const author = p.author || '';
          const actualComment = (pageData.comments && pageData.comments[idx] && pageData.comments[idx].content) || '';
          const originalText = actualComment || p.original_comment || '';
          const userLink = (pageData.comments && pageData.comments[idx] && pageData.comments[idx].userLink) || '';
          if (!author || !originalText) continue;
          likeList.push({ author, originalText, commentIdx: idx, userLink });
        }
        if (likeList.length === 0) return;
        addLog(`👍 开始自动点赞 ${likeList.length} 个用户（全程锁定串行）...`, 'info');
        try {
          await chrome.tabs.sendMessage(tab.id, { action: 'likeCommentsBatch', list: likeList });
        } catch (_) {}
      } catch (_) {}
    })();

    // ========== 用 DOM API 重新渲染（避开 innerHTML 潜在的兼容问题） ==========
    // 清空容器
    while (container.firstChild) container.removeChild(container.firstChild);

    // ★ 重新插入已回复 Banner（如果有）
    if (repliedBanner) container.appendChild(repliedBanner);

    // 1) 原始响应折叠面板
    const details = document.createElement('details');
    details.style.cssText = 'margin-bottom:6px;font-size:11px;';
    const summaryEl = document.createElement('summary');
    summaryEl.style.cssText = 'cursor:pointer;color:#999;padding:4px;';
    summaryEl.textContent = '📄 API 原始响应（点击展开）';
    details.appendChild(summaryEl);
    const pre = document.createElement('pre');
    pre.style.cssText = 'background:#f5f5f5;padding:6px;border-radius:4px;font-size:10px;max-height:120px;overflow:auto;white-space:pre-wrap;word-break:break-all;color:#333;';
    pre.textContent = JSON.stringify(result, null, 2);
    details.appendChild(pre);
    container.appendChild(details);

    // 2) 统计栏
    const stats = document.createElement('div');
    stats.className = 'scan-stats';
    if (filteredCount > 0) {
      stats.innerHTML = `📊 共 ${commentCount} 条评论 · <span style="display:inline-block;background:#fff3cd;color:#856404;padding:0 6px;border-radius:3px;font-weight:600;">已过滤 ${filteredCount} 条已回复</span> · 发现 ${prospects.length} 个潜在客户`;
    } else {
      stats.textContent = `📊 共 ${commentCount} 条评论 · 发现 ${prospects.length} 个潜在客户`;
    }
    container.appendChild(stats);

    // 博文评论次数提示
    if (noteCommentWarning) {
      const warnDiv = document.createElement('div');
      warnDiv.style.cssText = 'font-size:11px;padding:6px 10px;border-radius:4px;margin-bottom:6px;background:#fff3e0;color:#e65100;border:1px solid #ffe0b2;line-height:1.5;';
      warnDiv.textContent = noteCommentWarning;
      container.appendChild(warnDiv);
    }

    // 3) 卡片或空状态
    if (prospects.length === 0) {
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'empty-prospect';
      emptyDiv.innerHTML = `
        <div style="font-size:28px;margin-bottom:10px;">🔍</div>
        <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">本轮未发现潜在客户</div>
        <div style="font-size:12px;color:#555;line-height:1.6;max-width:400px;margin:0 auto;">${esc(summary || '没有用户表现出与产品相关的明确需求，试试在其他笔记页面使用。')}</div>
        <button id="retryProspectBtn" class="retry-btn">🔄 重新扫描</button>
        <div style="margin-top:6px;font-size:11px;color:#aaa;">💡 建议：找与你产品领域相关的笔记</div>`;
      container.appendChild(emptyDiv);
      document.getElementById('retryProspectBtn')?.addEventListener('click', async () => {
        addLog('🔄 重新扫描（未发现客户）', 'info');
        setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
        await refreshData();
      });
      setStatus('🎯 扫描完成 · 未发现潜在客户', 'success');
      broadcastAiScanDone(false); // ★ 本篇无商机结束，通知机器人返回列表
      return;
    }

    setStatus(`🎯 发现 ${prospects.length} 个潜在客户`, 'success');

    // ★ 大窗：扫描完成发布状态给小窗只读卡
    if (MODE_BIG) publishStepStatus(null, 'ready');

    // 摘要
    const summaryDiv = document.createElement('div');
    summaryDiv.className = 'prospect-summary';
    summaryDiv.textContent = summary;
    container.appendChild(summaryDiv);

    /* ★ 小窗分步模式：不渲染全卡片，改进入「屏2 进度 / 屏3 逐条」 */
    if (!MODE_BIG && typeof StepFlow !== 'undefined') {
      // 保存商机与评论索引映射，供 StepFlow 逐条使用
      pageData.prospects = prospects.map((p, i) => {
        const idx = p._origIdx !== undefined && p._origIdx >= 0
          ? p._origIdx
          : (originalIdxMap[p.index] !== undefined ? originalIdxMap[p.index] : p.index);
        return Object.assign({}, p, { index: idx });
      });
      pageData.prospectsFull = prospects;
      StepFlow.reset();
      StepFlow.note = { title: (pageData.title || (pageData.noteData && pageData.noteData.title) || '当前笔记') };
      await StepFlow.enterStep2(StepFlow.note);
      setStatus('✅ 评论分析完成，进入分步处理', 'success');
      return; // 不再渲染卡片列表（屏3 逐条消费）
    }

    // 卡片
    prospects.forEach((p, i) => {
      // 优先使用验证阶段修正的 _origIdx，否则通过映射表计算
      const idx = p._origIdx !== undefined && p._origIdx >= 0
        ? p._origIdx
        : (originalIdxMap[p.index] !== undefined ? originalIdxMap[p.index] : p.index);
      const author = p.author || (pageData.comments[idx] ? pageData.comments[idx].author : '');
      // 优先使用页面实际评论原文（避免AI截断导致无法在页面上定位）
      const actualComment = (pageData.comments && pageData.comments[idx] && pageData.comments[idx].content) || '';
      const content = actualComment || p.original_comment || p.content || '';
      // 获取用户主页链接（用于精准定位）
      const userLink = (pageData.comments && pageData.comments[idx] && pageData.comments[idx].userLink) || '';
      // ★ 属地 / 同城：属地来自评论区（content.js 抓的 IP 显示地区），same_city 由 AI 按「我的城市」判定
      const loc = String(p.location || (pageData.comments && pageData.comments[idx] && pageData.comments[idx].location) || '').trim();
      const sameCity = p.same_city === true;
      // 清洗 AI 可能在内容里附带的版本前缀（"版本A：" / "A：" / "（版本A正文，...）"等），并剔除空串话术
      const copies = (p.suggested_copies && p.suggested_copies.length > 0
        ? p.suggested_copies
        : (p.suggested_copy ? [p.suggested_copy] : [])
      ).map(c => stripVersionPrefix(String(c || '').trim())).filter(Boolean);
      const copyLabels = (Array.isArray(p.copy_labels) ? p.copy_labels : []).map(s => String(s || '').trim());
      const versionLabels = VERSION_LABELS;
      const versionNames = VERSION_NAMES;
      // ★ 默认选中 AI 推荐的 best 版（0=A 1=B 2=C）；自动灌水发送时也用该版
      const bestIdx = (copies.length > 0 && Number.isInteger(p.best_index) && p.best_index >= 0 && p.best_index < copies.length) ? p.best_index : 0;

      // 日志：显示AI生成的每版话术
      addLog(`💬 商机${i + 1} @${p.author || '未知'} 的话术：`, 'info');
      copies.forEach((copy, vi) => {
        const charCount = copy.length;
        const tag = copies.length > 1 ? `版本${vi + 1}${vi === bestIdx ? '（推荐）' : ''}${copyLabels[vi] ? ' · ' + copyLabels[vi] : ''}` : '话术';
        addLog(`  [${tag}] (${charCount}字):`, 'info');
        addLog(`    ${copy.slice(0, 150)}${copy.length > 150 ? '...' : ''}`, 'info');
      });

      const card = document.createElement('div');
      card.className = 'card prospect-card';
      card.dataset.currentVersion = String(bestIdx);

      // 构建版本切换按钮（纯文字，不带【】标记）；只有一版/没有话术时不显示切换条
      let tabsHtml = copies.length > 1 ? '<div class="version-tabs" style="display:flex;gap:4px;margin-bottom:6px;">' : '';
      copies.forEach((_, vi) => {
        const active = vi === bestIdx ? ' active' : '';
        const vName = versionNames[vi] || '';
        const label = (vi === bestIdx ? '⭐ ' : '') + '版本' + (vi + 1) + (copyLabels[vi] ? ' · ' + copyLabels[vi] : '');
        tabsHtml += `<button class="version-tab${active}" data-prospect="${i}" data-ver="${vi}">${label}</button>`;
      });
      if (copies.length > 1) tabsHtml += '</div>';

      const defaultCopy = (copies[bestIdx] || '') ? esc(copies[bestIdx]) : '';
      const defaultRaw = copies[bestIdx] || '';

      const verifiedBadge = p._verified
        ? ''
        : p._wasFixed
          ? '<span style="display:inline-block;font-size:10px;background:#fff3cd;color:#856404;padding:1px 6px;border-radius:3px;margin-left:4px;">已修正</span>'
          : '<span style="display:inline-block;font-size:10px;background:#fce4e4;color:#c62828;padding:1px 6px;border-radius:3px;margin-left:4px;">⚠️ 索引异常</span>';
      // ★ 同城徽标（AI 判定）优先，其余显示属地灰标
      const locBadge = sameCity
        ? `<span style="display:inline-block;font-size:10px;background:#e3f2fd;color:#1565c0;font-weight:600;padding:1px 6px;border-radius:3px;margin-left:4px;">🏙 同城${loc ? ' · ' + esc(loc) : ''}</span>`
        : (loc ? `<span style="display:inline-block;font-size:10px;background:#f2f2f2;color:#888;padding:1px 6px;border-radius:3px;margin-left:4px;">${esc(loc)}</span>` : '');

      card.innerHTML = `
        <div class="prospect-badge">潜在客户 #${i + 1}${verifiedBadge}${locBadge}<span class="cq-badge" style="display:none;"></span></div>
        <div class="prospect-meta">
          <span class="prospect-author comment-clickable" data-idx="${idx}">@${esc(author)}</span>
          <span style="font-size:11px;color:#999;">${esc(p.approach || '回复')}</span>
        </div>
        <div class="prospect-quote">“${esc(content) || '（原评论缺失）'}”</div>
        <div class="prospect-reason">💡 ${esc(p.interest_reason || '')}</div>
        <div class="prospect-reply-box">
          <div class="prospect-reply-label">✍️ 回复话术（可编辑 · 点击版本切换）</div>
          ${tabsHtml}
          <div class="reply-box">
            <textarea id="replyText_${i}" rows="5" placeholder="${copies.length ? '输入回复内容...' : '（AI 未生成话术，可手动输入）'}">${defaultCopy}</textarea>
          </div>
          <div class="reply-actions">
            <button class="copy-btn" data-prospect="${i}" data-raw="${esc(defaultRaw)}">复制</button>
            <button class="locate-btn" data-prospect="${i}" data-idx="${idx}" data-author="${esc(author)}" data-original="${esc(content)}" data-userlink="${esc(userLink)}">📍 定位</button>
            <button class="interact-btn" data-prospect="${i}" data-idx="${idx}" data-author="${esc(author)}" data-original="${esc(content)}" data-userlink="${esc(userLink)}">💗 点赞关注</button>
            <button class="send-btn" data-prospect="${i}" data-idx="${idx}" data-author="${esc(author)}" data-original="${esc(content)}" data-userlink="${esc(userLink)}">
              📤 一键发送
            </button>
            ${editionFeatureOn('prospectList') ? `<button class="addlist-btn" data-prospect="${i}" data-idx="${idx}" data-author="${esc(author)}" data-original="${esc(content)}" data-userlink="${esc(userLink)}" style="font-size:11px;padding:3px 8px;border:1px solid #7c3aed;background:#f5f3ff;color:#6d28d9;border-radius:4px;cursor:pointer;">➕ 入清单</button>` : ''}
          </div>
          <div id="sendResult_${i}" class="send-result"></div>
        </div>`;
      container.appendChild(card);
    });

    // ── AI 筛选入库（不再靠关键词：AI 从评论里筛出值得收进清单跟进的人，可一键全入库）──
    //    线索入库属「通知/私信」获客清单（② 升级版起开通），未开通版本不显示这块
    if (editionFeatureOn('prospectList')) try {
      const aiCapture = document.createElement('details');
      aiCapture.style.cssText = 'margin:6px 0;font-size:11px;border:1px solid #c4b5fd;border-radius:6px;padding:6px;background:#f5f3ff;';
      const aiSummary = document.createElement('summary');
      aiSummary.style.cssText = 'cursor:pointer;color:#6d28d9;font-weight:600;';
      aiSummary.textContent = '🧠 AI 筛选入库（筛出值得跟进的人，不靠关键词）';
      aiCapture.appendChild(aiSummary);
      const aiBody = document.createElement('div');
      aiBody.style.cssText = 'margin-top:6px;';
      aiBody.innerHTML = '<button id="aiRunCapture" style="width:100%;font-size:11px;padding:5px;border:1px solid #7c3aed;background:#fff;color:#6d28d9;border-radius:6px;cursor:pointer;">⚡ 开始 AI 筛选</button><div id="aiCapHint" style="color:#999;margin-top:4px;">点击后用 AI 从评论区挑出值得收进清单的人（宽口径，先收再跟进）</div>';
      aiCapture.appendChild(aiBody);
      container.appendChild(aiCapture);

      aiBody.querySelector('#aiRunCapture').addEventListener('click', async () => {
        const btn = aiBody.querySelector('#aiRunCapture');
        const hintEl = aiBody.querySelector('#aiCapHint');
        const comments = (filteredComments || []).map((c, i) => ({ idx: i, author: c.author, content: c.content, userLink: c.userLink }));
        if (!comments.length) { hintEl.textContent = '❌ 本页没有可筛评论'; return; }
        btn.disabled = true; btn.textContent = '⏳ AI 筛选中...'; hintEl.textContent = '';
        try {
          const pname = (await getConfigSafe()).product?.name || '';
          const r = await chrome.runtime.sendMessage({ action: 'aiScreenCapture', data: { comments, productHint: pname } });
          if (!r || !r.ok) throw new Error((r && r.error) || 'AI 筛选失败');
          const picked = r.picked || [];
          if (!picked.length) { hintEl.textContent = '😐 AI 认为这条没有值得收的人'; btn.disabled = false; btn.textContent = '⚡ 开始 AI 筛选'; return; }
          // 渲染候选列表
          hintEl.innerHTML = '';
          const listEl = document.createElement('div');
          picked.forEach((c, hi) => {
            const m = (c.userLink || '').match(/\/user\/(?:profile\/)?([\w-]+)/);
            const rowEl = document.createElement('div');
            rowEl.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:6px;padding:3px 0;border-top:1px solid #e9e0ff;';
            rowEl.innerHTML = `<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@${esc(c.author || '?')}：${esc((c.content || '').slice(0, 40))} <span style="color:#a78bfa;">${esc(c.why || '')}</span></span>
              <button class="ai-cap-add" style="flex:none;font-size:10px;padding:2px 8px;border:1px solid #7c3aed;background:#fff;color:#6d28d9;border-radius:4px;cursor:pointer;" data-i="${hi}" data-idx="${c.idx}">➕ 入库</button>`;
            rowEl.querySelector('.ai-cap-add').addEventListener('click', async (e) => {
              const b2 = e.currentTarget; b2.disabled = true;
              const per = picked[parseInt(b2.dataset.i, 10)];
              const mm = (per.userLink || '').match(/\/user\/(?:profile\/)?([\w-]+)/);
              const r2 = await chrome.runtime.sendMessage({ action: 'addProspect', data: {
                userId: mm ? mm[1] : '', nickname: per.author || '未知用户',
                source: { noteTitle: pageData.title || '', noteUrl: pageData.url || '', comment: per.content || '', userUrl: per.userLink || '' },
                keywordHit: 'AI筛选', origin: 'AI筛选',
              } });
              b2.textContent = (r2 && r2.ok) ? '✅' : '❌';
              setTimeout(() => { b2.textContent = '➕ 入库'; b2.disabled = false; }, 1500);
            });
            listEl.appendChild(rowEl);
          });
          hintEl.appendChild(listEl);
          const allB = document.createElement('button');
          allB.style.cssText = 'width:100%;margin-top:5px;font-size:11px;padding:4px;border:1px solid #7c3aed;background:#ede9fe;color:#6d28d9;border-radius:4px;cursor:pointer;';
          allB.textContent = `✅ 全部入库 ${picked.length} 条`;
          allB.addEventListener('click', async () => {
            allB.disabled = true; let ok = 0;
            for (const per of picked) {
              const mm = (per.userLink || '').match(/\/user\/(?:profile\/)?([\w-]+)/);
              await chrome.runtime.sendMessage({ action: 'addProspect', data: { userId: mm ? mm[1] : '', nickname: per.author || '未知用户', source: { noteTitle: pageData.title || '', noteUrl: pageData.url || '', comment: per.content || '', userUrl: per.userLink || '' }, keywordHit: 'AI筛选', origin: 'AI筛选' } });
              ok++;
            }
            allB.textContent = `✅ 已入库 ${ok} 条`; addLog(`🧠 AI 筛选入库：已入库 ${ok} 条`, 'success');
            setTimeout(() => { allB.textContent = `✅ 全部入库 ${picked.length} 条`; allB.disabled = false; }, 1800);
          });
          listEl.appendChild(allB);
          hintEl.appendChild(listEl);
        } catch (e) { hintEl.textContent = '❌ ' + e.message; }
        btn.disabled = false; btn.textContent = '⚡ 重新 AI 筛选';
      });
    } catch (_) {}

    bindScrollToComment();

    document.querySelectorAll('.prospect-card .copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const prospectIdx = btn.dataset.prospect;
        const textarea = document.getElementById(`replyText_${prospectIdx}`);
        if (!textarea) return;
        const text = textarea.value.trim();
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = '已复制 ✓';
          setTimeout(() => { btn.textContent = '复制'; }, 1500);
        });
      });
    });

    // 版本切换
    document.querySelectorAll('.version-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const prospectIdx = tab.dataset.prospect;
        const verIdx = parseInt(tab.dataset.ver);
        const p = prospects[parseInt(prospectIdx)];
        if (!p) return;
        const copies = (p.suggested_copies && p.suggested_copies.length > 0
          ? p.suggested_copies
          : (p.suggested_copy ? [p.suggested_copy] : [])
        ).map(c => stripVersionPrefix(String(c || '').trim())).filter(Boolean);
        const rawText = copies[verIdx] || '';
        const textarea = document.getElementById(`replyText_${prospectIdx}`);
        if (textarea) {
          textarea.value = rawText;
        }
        // 更新高亮
        const card = tab.closest('.prospect-card');
        if (card) {
          card.querySelectorAll('.version-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
        }
      });
    });

    document.querySelectorAll('.send-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prospectIdx = btn.dataset.prospect;
        const commentIdx = btn.dataset.idx;
        const author = btn.dataset.author;
        const original = btn.dataset.original;
        const userLink = btn.dataset.userlink || '';

        const textarea = document.getElementById(`replyText_${prospectIdx}`);
        if (!textarea) return;

        const replyText = textarea.value.trim();
        if (!replyText) {
          showSendResult(prospectIdx, '请输入回复内容', 'fail');
          return;
        }

        btn.disabled = true;
        btn.textContent = '发送中...';
        btn.classList.add('sending');

        try {
          const tab = await getTargetTab();
          if (!tab) {
            showSendResult(prospectIdx, '不在小红书页面', 'fail');
            btn.disabled = false;
            btn.textContent = '📤 一键发送';
            btn.classList.remove('sending');
            return;
          }

          // ★ 直接执行发送（sendReplyToComment 内部已包含：定位评论 → 高亮闪烁 → 点击回复 → 填入 → 发送）
          //   （前置互动「点赞→关注→停顿」已迁移到独立的「💗 点赞关注」按钮，需要时先手动点它再发送）
          addLog(`发送回复给 @${author}...`, 'info');
          showSendResult(prospectIdx, '<span class="loading-spinner"></span> 正在定位评论并发送...', '');
          const result = await sendTabMessageWithTimeout(tab.id, {
            action: 'sendReply', author, originalText: original, replyText, commentIdx: parseInt(commentIdx), userLink,
            images: kbImages, // 传递知识库图片
            humanize: _batchSending, // ★ 只有自动批量发送才走逐字输入；手动一键发送走快速通道
          }, 60000);
          if (result && result.success) {
            if (result.verified) {
              addLog(`✅ 回复 @${author} 成功（已验证）`, 'success');
              showSendResult(prospectIdx, '✅ 回复已发送并验证通过', 'ok');
            } else {
              addLog(`⚠️ 回复 @${author} 已尝试发送（未验证）`, 'warn');
              showSendResult(prospectIdx, '⚠️ 已尝试发送但未验证到。很可能已发出，请先刷新页面确认，不要直接再点一次（防重复评论）', 'warn');
            }
            // 标记按钮为"已灌水" (req 1)
            markAsWatered(prospectIdx, author, original);
            // 保存到本地存储
            try {
              addLocalReply(pageData?.url || '', author, original);
            } catch (_) {}
          } else {
            addLog(`❌ 回复 @${author} 失败: ${result?.error || '未知'}`, 'error');
            showSendResult(prospectIdx, `❌ ${result?.error || '发送失败'}`, 'fail');
          }
        } catch (e) {
          // ★ 通道断裂（message port closed 等）≠ 发送失败：页面侧很可能已把评论发出去了，
          // 不能显示“❌ 失败”误导用户重发 → 重复评论
          const msg = String(e?.message || e);
          if (/message port closed|Receiving end does not exist|context invalidated/i.test(msg)) {
            addLog(`⚠️ 与页面通道中断，回复 @${author} 可能已发出: ${msg}`, 'warn');
            showSendResult(prospectIdx, '⚠️ 与页面的连接中断，但回复很可能已发出。请先刷新页面确认，不要直接重发（防重复评论）', 'warn');
          } else {
            showSendResult(prospectIdx, `❌ ${msg}`, 'fail');
          }
        }
        btn.disabled = false;
        btn.textContent = '📤 一键发送';
        btn.classList.remove('sending');
        // ★ 无论成功/失败都置“处理完毕”标记（已含前置点赞+关注+发送），
        // 供批量发送循环判断推进；失败时也能立刻进下一条，不再干等超时
        btn.dataset.sendDone = String(Date.now());
        renderCqBar();   // 💬 评论条队列顶栏：这条处理完（成功/失败都算）
      });
    });

    // ── 前置互动按钮（点赞+关注，不发送）——原「一键发送」里的前置互动独立出来，由用户手动控制 ──
    document.querySelectorAll('.interact-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prospectIdx = btn.dataset.prospect;
        const commentIdx = btn.dataset.idx;
        const author = btn.dataset.author;
        const original = btn.dataset.original;
        const userLink = btn.dataset.userlink || '';

        btn.disabled = true;
        btn.textContent = '互动中...';
        btn.classList.add('working');

        try {
          const tab = await getTargetTab();
          if (!tab) {
            showSendResult(prospectIdx, '不在小红书页面', 'fail');
            btn.disabled = false;
            btn.textContent = '💗 点赞关注';
            btn.classList.remove('working');
            return;
          }

          // 点赞（失败不阻断后续关注）
          let liked = false;
          try {
            showSendResult(prospectIdx, '<span class="loading-spinner"></span> 正在为 @' + author + ' 点赞...', '');
            const likeResult = await chrome.tabs.sendMessage(tab.id, {
              action: 'likeComment', author, originalText: original, commentIdx: parseInt(commentIdx), userLink,
            });
            if (likeResult?.success) {
              liked = true;
              likedComments.push({
                author,
                textSnippet: (original || '').slice(0, 60),
                time: Date.now(),
              });
              renderLikedList();
              addLog(likeResult.alreadyLiked ? `@${author} 已点过赞` : `已为 @${author} 点赞`, 'info');
            } else {
              addLog(`点赞 @${author} 失败: ${likeResult?.error || '未知'}`, 'warn');
            }
          } catch (_) {}

          // 关注（按行为配置开关；先停 preSendGap 再关注，像真人操作间隔）
          let followed = false;
          try {
            const behavior = await getBehaviorConfig();
            if (behavior.autoFollow !== false) {
              await sleep(await getDwellMs('preSendGap', 0));
              showSendResult(prospectIdx, '<span class="loading-spinner"></span> 正在关注 @' + author + '...', '');
              await chrome.tabs.sendMessage(tab.id, { action: 'followUser', author });
              followed = true;
              addLog(`已关注 @${author}`, 'info');
            } else {
              addLog(`⏭ 按配置跳过关注 @${author}`, 'info');
            }
          } catch (_) {}

          if (liked || followed) {
            const parts = [];
            if (liked) parts.push('已点赞');
            if (followed) parts.push('已关注');
            showSendResult(prospectIdx, `✅ 前置互动完成：${parts.join(' + ')} @${author}`, 'ok');
          } else {
            showSendResult(prospectIdx, '⚠️ 点赞/关注均未成功，请看日志', 'warn');
          }
        } catch (e) {
          showSendResult(prospectIdx, `❌ ${String(e?.message || e)}`, 'fail');
        }
        btn.disabled = false;
        btn.textContent = '💗 点赞关注';
        btn.classList.remove('working');
      });
    });

    // ── 加入获客清单按钮 ──
    document.querySelectorAll('.addlist-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const author = btn.dataset.author;
        const original = btn.dataset.original;
        const userLink = btn.dataset.userlink || '';
        const idx = parseInt(btn.dataset.idx);
        // 提取 userId（从 userLink /user/{id}）
        const m = (userLink || '').match(/\/user\/(?:profile\/)?([\w-]+)/);
        const userId = m ? m[1] : '';
        const person = {
          userId,
          nickname: author || '未知用户',
          source: {
            noteTitle: pageData.title || '',
            noteUrl: pageData.url || '',
            comment: original || '',
            userUrl: userLink || '',
            stageEntry: 'AI路由',   // ★ 搜索评论的商机卡片 → 主动联系 → 直接进商机池
          },
          keywordHit: null,
          origin: '手动',
          stage: 'lead',       // ★ 主动联系的商机：我方单方收集、未双向 → 进线索池，触达后对方回复才升商机
        };
        btn.disabled = true;
        try {
          const resp = await chrome.runtime.sendMessage({ action: 'addProspect', data: person });
          if (resp && resp.ok) {
            btn.textContent = resp.added ? '✅ 已入清单' : '✅ 已在清单';
            addLog(`${resp.added ? '➕ 已加入' : '➖ 已在'}用户清单：@${author}`, 'success');
          } else {
            btn.textContent = '➕ 入清单';
            btn.disabled = false;
            addLog(`❌ 加入清单失败：${(resp && resp.error) || '未知'}`, 'error');
          }
        } catch (e) {
          btn.textContent = '➕ 入清单';
          btn.disabled = false;
          addLog(`❌ 加入清单失败：${e.message}`, 'error');
        }
        setTimeout(() => { btn.textContent = resp && resp.ok ? (resp.added ? '➕ 入清单' : '➕ 入清单') : '➕ 入清单'; btn.disabled = false; }, 2000);
      });
    });

    // ── 定位按钮（手动定位评论、点击回复，但不自动发送） ──
    document.querySelectorAll('.locate-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prospectIdx = btn.dataset.prospect;
        const commentIdx = btn.dataset.idx;
        const author = btn.dataset.author;
        const original = btn.dataset.original;
        const userLink = btn.dataset.userlink || '';

        btn.disabled = true;
        btn.textContent = '定位中...';

        try {
          const tab = await getTargetTab();
          if (!tab) {
            showSendResult(prospectIdx, '不在小红书页面', 'fail');
            btn.disabled = false;
            btn.textContent = '📍 定位';
            return;
          }

          showSendResult(prospectIdx, '<span class="loading-spinner"></span> 正在定位评论...', '');
          const result = await chrome.tabs.sendMessage(tab.id, {
            action: 'locateReply', author, originalText: original, commentIdx: parseInt(commentIdx), userLink,
          });
          if (result && result.success) {
            showSendResult(prospectIdx, '✅ 已定位并打开回复框，请手动输入', 'ok');
          } else {
            showSendResult(prospectIdx, `❌ ${result?.error || '定位失败'}`, 'fail');
          }
        } catch (e) {
          showSendResult(prospectIdx, `❌ ${e.message}`, 'fail');
        }
        btn.disabled = false;
        btn.textContent = '📍 定位';
      });
    });

    // ★ 商机已成功渲染完毕（#mainContent 里已存在 .send-btn）→ 通知机器人“本篇扫描成功、可开始发送”。
    //   修复：成功路径此前从不广播（broadcastAiScanDone 全仓库都只传 false），机器人收不到成功信号，
    //   只能靠 _waterCurrentNote 里对 #mainContent .send-btn 的 DOM 监听兜底——若卡片/按钮不在该容器或监听没兜住，
    //   机器人就会干等 180s 超时后返回“没发送”，而自动点赞早已执行（表现为“只点赞、不发送”），
    //   且因未登记 noteChecked/markWatered，同一篇被循环计划反复挑中、无限循环。
    renderCqBar();   // 💬 评论条队列顶栏：本篇商机数 / 待发 / 已发 / 失败
    broadcastAiScanDone(true);

  } catch (e) {
    console.error('[商机挖掘] 错误:', e);
    setStatus(`❌ 扫描失败: ${e.message}`, 'error');
    while (container.firstChild) container.removeChild(container.firstChild);
    const errDiv = document.createElement('div');
    errDiv.className = 'empty-state';
    errDiv.style.cssText = 'padding:20px;';
    errDiv.innerHTML = `
      <div class="emoji">😵</div>
      <p style="color:#c62828;font-size:14px;">AI 调用失败</p>
      <p style="font-size:11px;color:#555;margin-top:4px;">${esc(e.message)}</p>
      ${e.aiRaw ? `<details style="margin-top:8px;text-align:left;background:#f7f7f7;border:1px solid #e0e0e0;border-radius:6px;padding:8px;"><summary style="cursor:pointer;font-size:11px;font-weight:600;color:#333;">📋 AI 原始回复（${e.aiRaw.length} 字 · 点击展开）</summary><pre style="white-space:pre-wrap;word-break:break-all;max-height:220px;overflow:auto;margin:8px 0 0;font-size:11px;line-height:1.5;color:#444;">${esc(e.aiRaw)}</pre><button id="copyAiRawBtn" class="retry-btn" style="margin-top:8px;font-size:11px;">📋 复制全文</button></details>` : ''}
      <button id="retryAiBtn" class="retry-btn">🔄 重试</button>`;
    container.appendChild(errDiv);
    broadcastAiScanDone(false); // ★ AI 分析失败，通知机器人返回列表（不再干等 180s 超时）
    document.getElementById('copyAiRawBtn')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(e.aiRaw); } catch (_) {}
    });
    document.getElementById('retryAiBtn')?.addEventListener('click', async () => {
      setStatus('<span class="loading-spinner"></span> 重新扫描中...', '');
      await loadProspecting(container);
    });
  }
}

// ========== 同行碰撞笔记 → 只收求分享线索、不灌水 ==========
// 判定命中的"求分享"评论 → 收入用户清单线索池(stage=lead) + 为每人生成触达词（可编辑）+ 一键私信触达。
// 不渲染 .send-btn → 手动获客/自动灌水对本篇都不会发评论。
async function renderShareLeads(container, shareHits, opts) {
  opts = opts || {};
  while (container.firstChild) container.removeChild(container.firstChild);
  if (opts.repliedBanner) container.appendChild(opts.repliedBanner);

  const noteCommentWarning = opts.noteCommentWarning || '';
  if (noteCommentWarning) {
    const warnDiv = document.createElement('div');
    warnDiv.style.cssText = 'font-size:11px;padding:6px 10px;border-radius:4px;margin-bottom:6px;background:#fff3e0;color:#e65100;border:1px solid #ffe0b2;line-height:1.5;';
    warnDiv.textContent = noteCommentWarning;
    container.appendChild(warnDiv);
  }

  const _leadsOn = editionFeatureOn('prospectList');   // 获客清单（通知/私信）为 ② 升级版起

  // 统计横幅
  const banner = document.createElement('div');
  banner.style.cssText = 'font-size:12px;padding:8px 10px;border-radius:6px;margin-bottom:8px;background:#fff4e5;color:#8a5a00;border:1px solid #f6d9a8;line-height:1.5;';
  banner.innerHTML = _leadsOn
    ? `🚦 判定为<b>同行碰撞笔记</b>（评论区 ${shareHits.length} 条求分享），<b>本笔记不灌水</b>。<br>已将 ${shareHits.length} 位"求分享"用户收入<b>用户清单 · 线索池</b>，备好触达词可直接<b>私信触达</b>。`
    : `🚦 判定为<b>同行碰撞笔记</b>（评论区 ${shareHits.length} 条求分享），<b>本笔记不灌水</b>。`;
  container.appendChild(banner);

  const noteTitle = (pageData && pageData.title) || (pageData && pageData.noteData && pageData.noteData.title) || '';
  const noteUrl = (pageData && pageData.url) || '';

  const stats = document.createElement('div');
  stats.className = 'scan-stats';
  stats.textContent = _leadsOn
    ? `🎇 ${shareHits.length} 位求分享用户已入线索池 · 不评论（避免碰撞）`
    : `🚫 本篇不评论（避免碰撞）· 直接换下一篇`;
  container.appendChild(stats);

  // 无获客清单版本：只提示「本篇不灌水」，不写线索池、不给私信入口
  if (!_leadsOn) return;

  for (let i = 0; i < shareHits.length; i++) {
    const h = shareHits[i] || {};
    const author = h.author || '未知用户';
    const content = (h.content || '');
    const userLink = h.userLink || '';
    const m = String(userLink || '').match(/\/user\/?(?:profile\/)?([\w-]+)/);
    const userId = m && m[1] ? m[1] : '';
    // 预填一份可用的触达词模板（避免每次扫描都烧 N 次 AI；用户可用「✨ 生成触达词」换成 AI 个性化版）
    const defaultDm = `看到你在「${(noteTitle || '那篇笔记')}」下求分享，正好我手上有相关的整理，可以发你。有需要的话跟我说，我发你。`;

    const card = document.createElement('div');
    card.className = 'card prospect-card';
    card.dataset.leadIdx = String(i);
    card.innerHTML = `
      <div class="prospect-badge">🎇 求分享线索 #${i + 1}<span style="display:inline-block;font-size:10px;background:#ecfdf5;color:#0f766e;padding:1px 6px;border-radius:3px;margin-left:4px;">线索池</span></div>
      <div class="prospect-meta">
        <span class="prospect-author">@${esc(author)}</span>
        <span style="font-size:11px;color:#999;">在「${esc((noteTitle || '本篇笔记').slice(0, 20))}」下求分享</span>
      </div>
      <div class="prospect-quote">“${esc(content) || '（原文缺失）'}”</div>
      <div style="font-size:11px;color:#999;margin:2px 0 6px;">💬 已加入用户清单线索池 — 私信对方即自动升为商机</div>
      <div class="prospect-reply-box">
        <div class="prospect-reply-label">💬 私信触达词（可编辑 · 一键生成后直接发）</div>
        <div class="reply-box">
          <textarea id="leadDm_${i}" rows="4" placeholder="点击「✨ 生成触达词」或手动输入私信内容...">${esc(defaultDm)}</textarea>
        </div>
        <div class="reply-actions">
          <button class="lead-gen-btn" data-i="${i}" ${userId ? '' : 'style="display:none;"'}>✨ 生成触达词</button>
          <button class="lead-dm-btn" data-i="${i}">💌 私信触达</button>
        </div>
        <div id="leadResult_${i}" class="send-result"></div>
      </div>`;
    container.appendChild(card);
  }

  // ── 入池：逐人 addProspect（线索池 stage=lead）──
  const listRespPromise = Promise.all(shareHits.map((h) => {
    const m2 = String(h.userLink || '').match(/\/user\/?(?:profile\/)?([\w-]+)/);
    const uid = m2 && m2[1] ? m2[1] : '';
    const person = {
      userId: uid,
      nickname: h.author || '未知用户',
      source: {
        noteTitle,
        noteUrl,
        comment: h.content || '',
        userUrl: h.userLink || '',
        stageEntry: '求分享',   // 入口口径：求分享线索 → 线索池
      },
      origin: '评论',
      stage: 'lead',            // 线索池（未接触）
    };
    return chrome.runtime.sendMessage({ action: 'addProspect', data: person }).catch(() => null);
  }));

  // ── 按钮事件 ──
  // 生成触达词：复用 background 的 prospect_dm 生成私信话术
  container.querySelectorAll('.lead-gen-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const i = parseInt(btn.dataset.i, 10);
      const h = shareHits[i];
      if (!h) return;
      btn.disabled = true; btn.textContent = '⏳ 生成中...';
      const mm = String(h.userLink || '').match(/\/user\/?(?:profile\/)?([\w-]+)/);
      const person = {
        userId: mm && mm[1] ? mm[1] : '',
        nickname: h.author || '未知用户',
        source: { noteTitle, noteUrl, comment: h.content || '', userUrl: h.userLink || '', stageEntry: '求分享' },
        stage: 'lead',
      };
      try {
        const r = await chrome.runtime.sendMessage({ action: 'generateDm', data: { person } });
        const ta = document.getElementById('leadDm_' + i);
        if (ta && r && r.ok && r.dmText) { ta.value = r.dmText; addLog(`✨ 已为 @${esc(h.author || '')} 生成触达词`, 'success'); }
        else { ta && ta.setAttribute('placeholder', '生成失败，请手写并继续'); addLog('⚠️ 触达词生成失败，可手写', 'warn'); }
      } catch (e) {
        addLog('⚠️ 触达词生成异常：' + String(e && e.message || e).slice(0, 80), 'warn');
      } finally {
        btn.disabled = false; btn.textContent = '✨ 生成触达词';
      }
    });
  });

  // 私信触达：调 background sendDm（开主页→点私信→聊天窗→发送）
  container.querySelectorAll('.lead-dm-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const i = parseInt(btn.dataset.i, 10);
      const h = shareHits[i];
      if (!h) return;
      const ta = document.getElementById('leadDm_' + i);
      const text = (ta && ta.value.trim()) || '';
      const resEl = document.getElementById('leadResult_' + i);
      if (!text) { if (resEl) resEl.innerHTML = '<span style="color:#b45309;">⚠️ 请先生成或填写触达词</span>'; return; }
      const mm = String(h.userLink || '').match(/\/user\/?(?:profile\/)?([\w-]+)/);
      const person = {
        userId: mm && mm[1] ? mm[1] : '',
        nickname: h.author || '未知用户',
        source: { noteTitle, noteUrl, comment: h.content || '', userUrl: h.userLink || '', stageEntry: '求分享' },
        stage: 'lead',
      };
      btn.disabled = true; btn.textContent = '⏳ 私信中...';
      if (resEl) resEl.innerHTML = '<span class="loading-spinner"></span> 正在打开主页并发送私信...';
      try {
        const r = await chrome.runtime.sendMessage({ action: 'sendDm', data: { person, text, aiGenerated: false } });
        if (r && r.ok) {
          if (resEl) resEl.innerHTML = '<span style="color:#1f9d55;">✅ 私信已发送（触达完成·待对方回复升商机）</span>';
          addLog(`💌 已向 @${esc(h.author || '')} 发送私信触达`, 'success');
          btn.textContent = '✅ 已私信';
        } else {
          if (resEl) resEl.innerHTML = '<span style="color:#d14343;">❌ ' + esc(((r && r.error) || '').slice(0, 60) || '发送失败') + '</span>';
          addLog('⚠️ 私信未完成：' + String((r && (r.notice || r.error)) || '未知').slice(0, 80), 'warn');
          btn.disabled = false; btn.textContent = '💌 私信触达';
        }
      } catch (e) {
        const msg = (e && e.limited) ? '对方防骚扰/需先关注，请改为评论破冰' : (String((e && e.message) || e).slice(0, 80));
        if (resEl) resEl.innerHTML = '<span style="color:#d14343;">❌ ' + esc(msg) + '</span>';
        addLog('⚠️ 私信异常：' + msg, 'warn');
        btn.disabled = false; btn.textContent = '💌 私信触达';
      }
    });
  });

  // 入池结果回填（等待 addProspect 完成，幂等：已存在则当作成功）
  try {
    const results = await listRespPromise;
    const added = results.filter(r => r && r.ok).length;
    addLog(`🎇 已确认 ${added}/${shareHits.length} 位求分享用户进入线索池（其余可能已在清单中）`, added > 0 ? 'success' : 'info');
  } catch (_) {}

  setStatus(`🎇 已收 ${shareHits.length} 位求分享线索（不灌水）`, 'success');
}

function showSendResult(prospectIdx, msg, type) {
  const el = document.getElementById(`sendResult_${prospectIdx}`);
  if (el) {
    el.innerHTML = msg;
    el.className = 'send-result ' + type;
    setTimeout(() => { el.innerHTML = ''; }, 4000);
  }
}

// ========== 操作日志系统 (req 3) ==========
let _logCount = 0;
function addLog(msg, type) {
  type = type || 'info';
  _logCount++;
  const panel = document.getElementById('logPanel');
  if (!panel) return;
  panel.style.display = 'block';
  // 如果只有初始提示，移除它
  if (panel.children.length === 1 && panel.children[0].textContent.includes('操作日志将显示在这里')) {
    panel.innerHTML = '';
  }
  const now = new Date();
  const timeStr = now.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const entry = document.createElement('div');
  entry.className = 'log-entry ' + type;
  entry.dataset.src = 'flow';
  entry.innerHTML = `<span class="log-time">${timeStr}</span>${msg}`;
  panel.appendChild(entry);
  // 自动滚动到底部
  panel.scrollTop = panel.scrollHeight;
  // 最多保留 200 条防止内存泄漏
  while (panel.children.length > 200) panel.removeChild(panel.firstChild);
  // ★ 同步镜像一份到锁定遮罩的日志区（锁定时遮罩盖住了下方日志，在这里仍能看）；最新放最上面
  window.__xhsMirrorLog(msg, type, timeStr, 'flow', '💧');
  console.log(`[${timeStr}] ${msg}`);
}

// ★ 共享日志镜像器：把一条日志同时写进【遮罩实时日志】。bot(🤖 auto-bot) 与自动灌水(💧 auto-water/popup) 两条来源都走这里，
//   并支持"全部 / 🤖只有 bot / 💧只有自动灌水"过滤——这样 bot 运行时，它的操作轨迹也能在锁屏遮罩上看得见、可分。
//   source ∈ 'bot' | 'flow'；tag 为遮罩里的来源角标。
window.__overlayLogFilter = 'all';
window.__xhsMirrorLog = function (msg, type, timeStr, source, tag) {
  source = source || 'flow';
  tag = tag || (source === 'bot' ? '🤖' : '💧');
  var ovLog = document.getElementById('lockOverlayLog');
  if (!ovLog) return;
  var f = window.__overlayLogFilter || 'all';
  if (f !== 'all' && f !== source) return;
  var c = { info: '#2a72c9', success: '#1f9d55', warn: '#b8730a', error: '#d14343' }[type] || '#5a4a2a';
  var line = document.createElement('div');
  line.dataset.src = source;                       // 供"只看 bot"过滤使用
  line.style.color = c;
  line.style.padding = '2px 0';
  line.style.borderBottom = '1px dashed #eee2c8';
  line.innerHTML = '<span style="color:#a8a090;margin-right:6px;">' + timeStr + '</span>' +
    (tag ? '<span style="color:var(--c-brand-ink);font-weight:700;margin-right:6px;">' + tag + '</span>' : '') + msg;
  ovLog.insertBefore(line, ovLog.firstChild); // 倒置：新的插到最前面
  ovLog.scrollTop = 0; // 回到顶部看最新
  while (ovLog.children.length > 200) ovLog.removeChild(ovLog.lastChild);
};
window.__setOverlayLogFilter = function (f) { window.__overlayLogFilter = f || 'all'; };
// 对已渲染的行也生效（切换过滤后，把不符合来源的行隐藏/恢复）
window._applyOverlayFilter = function () {
  var ovLog = document.getElementById('lockOverlayLog');
  if (!ovLog) return;
  var f = window.__overlayLogFilter || 'all';
  Array.prototype.forEach.call(ovLog.children, function (line) {
    var s = line.dataset.src || 'flow';
    line.style.display = (f === 'all' || s === f) ? '' : 'none';
  });
};

// ========== 操作锁状态展示（与 content.js 串行锁联动） ==========
let _lockHideTimer = null;

// AI 思考读秒：AI 请求跑在 background，content.js 的 statusUpdate 不会来，
// 所以在 popup 侧自己计时，每秒刷新遮罩顶部“当前动作”行，让用户知道 AI 在处理而非卡死
let _aiThinkingTimer = null;
let _aiStreamChars = 0; // ★ 流式：AI 已生成字数（由 aiStreamProgress 消息刷新）
function _startAiThinkingTicker() {
  _stopAiThinkingTicker();
  _aiStreamChars = 0;
  const t0 = Date.now();
  const tick = () => {
    const sec = Math.round((Date.now() - t0) / 1000);
    const ovStatus = document.getElementById('lockOverlayStatus');
    // 有流式进度就显示“已生成 N 字”（证明在实时吐字、没卡死），否则只显示等待秒数
    if (ovStatus) {
      ovStatus.textContent = _aiStreamChars > 0
        ? `🤖 AI 正在生成话术…已生成 ${_aiStreamChars} 字（${sec} 秒）`
        : `🤖 AI 正在分析评论、生成话术…已等待 ${sec} 秒`;
    }
  };
  tick();
  _aiThinkingTimer = setInterval(tick, 1000);
}
function _stopAiThinkingTicker() {
  if (_aiThinkingTimer) { clearInterval(_aiThinkingTimer); _aiThinkingTimer = null; }
  _aiStreamChars = 0;
}

function setLockBanner(locked, label) {
  const banner = document.getElementById('lockBanner');
  const overlay = document.getElementById('lockOverlay');
  const textEl = document.getElementById('lockBannerText');
  const overlayTextEl = document.getElementById('lockOverlayText');
  const labelMap = {
    sendReply: '正在发送评论',
    locateReply: '正在定位评论',
    followUser: '正在关注用户',
    likeComment: '正在点赞评论',
    likeBatch: '正在批量点赞',
    scrollToComment: '正在定位评论',
    loadMoreComments: '正在加载更多评论',
    aiThinking: 'AI 正在分析评论、生成话术',
    chatFollow: '正在串行回复AI客服',
    chatFollowReply: '正在生成并回复评论',
    chatFollowSend: '正在发送评论回复',
  };
  if (locked) {
    if (_lockHideTimer) { clearTimeout(_lockHideTimer); _lockHideTimer = null; }
    const action = labelMap[label] || '操作进行中';
    if (textEl) textEl.textContent = `🔒 ${action}，请稍候…（串行执行，防止评论错位，此时请勿手动操作）`;
    if (overlayTextEl) overlayTextEl.textContent = `🔒 ${action}，请勿手动操作…（自动化正在执行，稍后自动解锁）`;
    if (banner) banner.style.display = 'flex';
    if (overlay) {
      // 首次弹出遮罩时，把主日志面板最近的记录同步过来（倒置：最新在上），让用户有上下文
      if (overlay.style.display !== 'flex') {
        const ovLog = document.getElementById('lockOverlayLog');
        const panel = document.getElementById('logPanel');
        if (ovLog && panel) {
          ovLog.innerHTML = '';
          // 面板是“旧→新”顺序，取最后 40 条后倒序逐条追加，使最新的在最上面
          const entries = Array.from(panel.children).slice(-40).reverse();
          for (const e of entries) {
            const line = document.createElement('div');
            line.style.color = '#8a7a58';
            line.style.padding = '2px 0';
            line.style.borderBottom = '1px dashed #eee2c8';
            line.innerHTML = e.innerHTML;
            ovLog.appendChild(line);
          }
          ovLog.scrollTop = 0;
        }
        // 首次弹出先把当前动作行置为开场提示（后续由 statusUpdate 不断刷新）
        const ovStatus = document.getElementById('lockOverlayStatus');
        if (ovStatus) ovStatus.textContent = `⚙️ ${action}…`;
      }
      overlay.style.display = 'flex';
    }
  } else {
    // 延迟隐藏，避免连续发送时横幅/遮罩闪烁
    if (_lockHideTimer) clearTimeout(_lockHideTimer);
    _lockHideTimer = setTimeout(() => {
      if (banner) banner.style.display = 'none';
      if (overlay) overlay.style.display = 'none';
      _lockHideTimer = null;
    }, 500);
  }
}

// 监听 content.js 广播的锁状态变化
chrome.runtime.onMessage.addListener((request, sender, sendResponse) => {
  // 🌿 保底时钟（后台）来敲门：把执行器拉起来跑整条队列（口径/节奏就按队列页列表头选的那两个参数）
  if (request && request.action === 'dailyAutoStart') {
    try {
      if (window.AutoBot && window.AutoBot.running) { sendResponse({ ok: true, busy: true }); return; }
      if (typeof window.switchMainTab === 'function') window.switchMainTab('queue');
      const s = document.getElementById('botScopeSel'), p = document.getElementById('botPaceSel');
      window.AutoBot.start(s ? s.value : 'all', p ? p.value : 'once', { auto: true });
      sendResponse({ ok: true, busy: false });
    } catch (e) {
      sendResponse({ ok: false, error: String((e && e.message) || e) });
    }
    return;
  }
  if (request && request.action === 'lockStateChanged') {
    setLockBanner(request.locked, request.label);
  }
  // 批量点赞进度：content.js 每点一个就广播一条，据此实时更新已点赞列表
  if (request && request.action === 'likeProgress' && request.success) {
    try {
      likedComments.push({
        author: request.author || '',
        textSnippet: (request.originalText || '').slice(0, 60),
        time: Date.now(),
      });
      renderLikedList();
      console.log(`[自动点赞] ${request.author}: ${request.alreadyLiked ? '已点过' : '已点赞'}`);
    } catch (_) {}
  }
  // ★ 当前动作（含等待读秒）：content.js 每切一步/每过一秒都广播，刷新遮罩顶部“正在干啥”
  if (request && request.action === 'statusUpdate') {
    const ovStatus = document.getElementById('lockOverlayStatus');
    if (ovStatus && request.text) {
      ovStatus.textContent = request.text;
    }
  }
  // ★ AI 流式生成进度：background 每生成一段就广播已生成字数，让用户看到实时在吐字（读秒器会接手显示）
  if (request && request.action === 'aiStreamProgress') {
    _aiStreamChars = request.chars || 0;
    // 发笔记向导自己那两条等待条（人群/话题、成稿）也吃这份进度
    if (request.scope && Object.prototype.hasOwnProperty.call(_npStreamChars, request.scope)) _npStreamChars[request.scope] = request.chars || 0;
  }
  // ★ AI 两阶段切换：background 在“快筛→生成话术”之间广播，同步刷新日志和网页红色状态条
  if (request && request.action === 'aiPhase') {
    if (request.phase === 'screening') {
      addLog(`⚡ AI 第1步：快筛 ${request.count || ''} 条评论价值 + 核对抓取质量…（只要几秒）`, 'info');
      _setTabStatusBar('⚡ AI 第1步：快筛评论价值、核对抓取…');
    } else if (request.phase === 'generating') {
      addLog('🤖 AI 第2步：为选中的评论生成话术…（网络请求中，请稍候）', 'info');
      _setTabStatusBar('🤖 AI 第2步：正在生成话术…（请稍候）');
    }
  }
});

// ========== 笔记列表交叉核对（用搜索抛到的 foundNotes 剔除“把卡片当评论”）==========
// 思路：搜索功能早已把笔记列表（作者+点赞数+标题）存到 auto_water_state.searchState.foundNotes。
// 一旦“评论”的 作者+正文 恰好等于某张卡片的 作者+点赞数（或正文命中某个笔记标题），
// 就能 100% 判定它是背景信息流里的卡片而非真评论。
const _AW_STATE_KEY = 'auto_water_state';

/** 读取搜索抛到的笔记列表（可能为空——用户没走过搜索时） */
async function loadFoundNotes() {
  try {
    const data = await chrome.storage.local.get(_AW_STATE_KEY);
    const st = data[_AW_STATE_KEY];
    return (st && st.searchState && st.searchState.foundNotes) || [];
  } catch (_) {
    return [];
  }
}

/** 归一化：去 @/空白、转小写 */
function _normMatch(s) {
  return String(s || '').replace(/^@/, '').replace(/\s+/g, '').toLowerCase().trim();
}

/** 当前页 URL 里的 noteId（用于排除“当前笔记本身”，不把它当背景卡片） */
function _noteIdFromUrl(u) {
  const m = String(u || '').match(/\/(?:explore|discovery\/item|search_result)\/([a-f0-9]+)/);
  return m ? m[1] : '';
}

/** 把一条“评论”与笔记列表比对，命中则说明它其实是列表卡片 */
function _commentMatchesNoteCard(c, notes, curNoteId) {
  const author = _normMatch(c.author);
  const body = _normMatch(c.content);
  if (!body) return false;
  const bodyIsNumeric = /^[\d.,]+[\u4e07wk\uff0b+]*$/i.test(body); // 正文就是个数字/万 → 像点赞数
  for (const n of notes) {
    if (curNoteId && n.noteId === curNoteId) continue; // 跳过当前笔记自身
    const nAuthor = _normMatch(n.author);
    const nLikes = _normMatch(n.likes);
    const nTitle = _normMatch(n.title);
    // 规则1：作者对得上 + （正文等于该片点赞数 或 正文就是个数字）
    if (nAuthor && author && author === nAuthor && ((nLikes && body === nLikes) || bodyIsNumeric)) {
      return true;
    }
    // 规则2：正文命中某篇笔记标题（标题够长才算，避免误伤）
    if (nTitle && nTitle.length >= 6 && (body === nTitle || body.includes(nTitle) || nTitle.includes(body))) {
      return true;
    }
  }
  return false;
}

/** 交叉核对：返回 { kept, removed }（removed = 被判定为笔记卡片的假评论） */
function crossCheckComments(comments, notes, curNoteId) {
  if (!notes || notes.length === 0) return { kept: comments, removed: [] };
  const kept = [], removed = [];
  for (const c of comments) {
    if (_commentMatchesNoteCard(c, notes, curNoteId)) removed.push(c);
    else kept.push(c);
  }
  return { kept, removed };
}

// ========== 已灌水跟踪（持久化到 chrome.storage.local）==========
const WATERED_KEY = 'watered_notes';
let _wateredSet = new Set(); // 内存缓存，存 "noteUrl||author||originalText"

/** 获取所有已灌水的笔记 URL 集合 */
async function loadWateredNoteUrls() {
  try {
    const data = await chrome.storage.local.get(WATERED_KEY);
    return new Set(data[WATERED_KEY] || []);
  } catch (_) {
    return new Set();
  }
}

/** 保存一条已灌水笔记 URL 到持久存储 */
async function saveWateredNoteUrl(noteUrl) {
  if (!noteUrl) return;
  try {
    const data = await chrome.storage.local.get(WATERED_KEY);
    const urls = data[WATERED_KEY] || [];
    if (!urls.includes(noteUrl)) {
      urls.push(noteUrl);
      await chrome.storage.local.set({ [WATERED_KEY]: urls });
    }
  } catch (_) {}
}

function markAsWatered(prospectIdx, author, originalText) {
  const btn = document.querySelector(`.send-btn[data-prospect="${prospectIdx}"]`);
  if (btn) {
    btn.disabled = true;
    btn.textContent = '✅ 已灌水';
    btn.classList.remove('sending');
    btn.classList.add('watered');
    btn.style.background = '#9ca3af';
    // 整条评论卡片也变灰 (req 5)
    const card = btn.closest('.prospect-card');
    if (card) {
      card.style.opacity = '0.5';
      card.style.background = '#f0f0f0';
      card.style.borderLeftColor = '#9ca3af';
      card.classList.add('watered');
    }
  }
  // 也记住已灌水状态
  if (pageData?.url) {
    _wateredSet.add(pageData.url + '||' + author + '||' + originalText);
    // 持久化到 storage
    saveWateredNoteUrl(pageData.url);
  }
  // 通知左侧笔记列表 (req 2)
  window._notifyNoteWatered && window._notifyNoteWatered(pageData?.url || '');
  noteDone(noteIdFrom(pageData?.url), { sent: true, reason: 'watered' }); // 严格流水线：本篇已成功发送
  // ★ 灌水总结：记录本次发送明细（话术取文本框当前值，可能被用户编辑过）
  try {
    const replyEl = document.getElementById('replyText_' + prospectIdx);
    addWaterLog({
      noteUrl: pageData?.url || '',
      noteTitle: pageData?.title || '',
      author: author || '',
      comment: originalText || '',
      replyText: replyEl && replyEl.value ? replyEl.value.trim() : '',
      source: _batchSending ? 'batch' : 'manual',
    });
  } catch (_) {}
  renderCqBar();   // 💬 评论条队列顶栏：这条已发（执行器点发送也会走这里）
}

// ========== 防重复灌水：检测“我的名字”已在评论里 ==========
/** 读取用户在设置里维护的“我的小红书昵称”（归一化）。
 *  不缓存：只是本地读取，开销极小；保证设置里新增名字后无需重开弹窗即生效。 */
async function loadMyAccountNames() {
  try {
    const resp = await chrome.runtime.sendMessage({ action: 'getConfig' });
    const names = (resp && resp.config && resp.config.myAccountNames) || [];
    return names.map(n => _normMatch(n)).filter(Boolean);
  } catch (_) {
    return [];
  }
}

/** 在评论里找“我的名字”；命中则返回那条评论，否则 null */
async function findMyCommentInNote(comments) {
  const myNames = await loadMyAccountNames();
  if (!myNames || myNames.length === 0) return null;
  for (const c of (comments || [])) {
    const author = _normMatch(c.author);
    if (!author) continue;
    if (myNames.includes(author)) return c;
  }
  return null;
}

/** 因“发现自己的评论”而把整篇笔记标为已灌水（存本地 + 通知列表 + 渲染提示） */
async function markNoteWateredBySelf(noteUrl, myComment) {
  // 1. 存本地已灌水清单
  try { await saveWateredNoteUrl(noteUrl); } catch (_) {}
  // 2. 把自己这条评论也记入已回复记录（防下次重扫又当商机）
  try { await addLocalReply(noteUrl, myComment.author || '', myComment.content || ''); } catch (_) {}
  // 3. 通知左侧笔记列表标为已灌水
  try { window._notifyNoteWatered && window._notifyNoteWatered(noteUrl); } catch (_) {}
  noteDone(noteIdFrom(noteUrl), { sent: true, reason: 'already_watered' }); // 严格流水线：本篇已灌水
  // 4. 主区域渲染一个明确提示，不再调 AI
  const container = document.getElementById('mainContent');
  if (container) {
    while (container.firstChild) container.removeChild(container.firstChild);
    const div = document.createElement('div');
    div.className = 'empty-prospect';
    div.innerHTML = `
      <div style="font-size:28px;margin-bottom:10px;">✅</div>
      <div style="font-size:14px;color:#333;margin-bottom:6px;font-weight:500;">本篇已灌水（检测到你的评论）</div>
      <div style="font-size:12px;color:#555;line-height:1.6;">已发现 <strong>@${esc(myComment.author || '')}</strong> 的评论，已自动记入已灌水清单并跳过 AI。</div>`;
    container.appendChild(div);
  }
  setStatus('✅ 本篇已灌水（已有你的评论）', 'success');
}

// ========== 已打开笔记跟踪（持久化到 chrome.storage.local） ==========
const OPENED_KEY = 'opened_notes';

/** 获取所有已打开的笔记 URL 集合 */
async function loadOpenedNoteUrls() {
  try {
    const data = await chrome.storage.local.get(OPENED_KEY);
    return new Set(data[OPENED_KEY] || []);
  } catch (_) {
    return new Set();
  }
}

/** 保存一条已打开的笔记 URL 到持久存储 */
async function saveOpenedNoteUrl(noteUrl) {
  if (!noteUrl) return;
  try {
    const data = await chrome.storage.local.get(OPENED_KEY);
    const urls = data[OPENED_KEY] || [];
    if (!urls.includes(noteUrl)) {
      urls.push(noteUrl);
      await chrome.storage.local.set({ [OPENED_KEY]: urls });
    }
  } catch (_) {}
}

/** 查询已打开笔记 URL 集合（供左侧面板调用） */
window.getOpenedNoteUrls = loadOpenedNoteUrls;
/** 保存已打开笔记 URL（供左侧面板调用） */
window.saveOpenedNoteUrl = saveOpenedNoteUrl;

// ========== 点击评论跳转到页面 ==========
function bindScrollToComment() {
  document.querySelectorAll('.comment-clickable').forEach(el => {
    el.addEventListener('click', async () => {
      let author, originalText;
      const idx = parseInt(el.dataset.idx);
      if (!isNaN(idx) && pageData.comments && pageData.comments[idx]) {
        const comment = pageData.comments[idx];
        author = comment.author;
        originalText = comment.content;
      } else {
        return;
      }

      const tab = await getTargetTab();
      if (!tab) return;

      try {
        await chrome.tabs.sendMessage(tab.id, {
          action: 'scrollToComment', author, originalText,
        });
      } catch (e) { /* 忽略 */ }
    });
  });
}

// ========== 线程提取（供候选2使用） ==========
function authorMatch(name, target) {
  if (!name || !target) return false;
  if (name === target) return true;
  const a = name.replace(/^@/, '').trim();
  const b = target.replace(/^@/, '').trim();
  if (a === b) return true;
  if (a.includes(b) || b.includes(a)) return true;
  return a.length > 3 && b.length > 3 && (a.startsWith(b) || b.startsWith(a));
}

function extractThreadsSafe(flat) {
  if (!flat || !Array.isArray(flat)) return [];

  const hasPosition = flat.some(c => c._left != null);
  if (hasPosition) {
    const minLeft = Math.min(...flat.map(c => c._left));
    const INDENT_THRESHOLD = 15;
    const threads = [];
    let current = null;
    for (let i = 0; i < flat.length; i++) {
      const c = flat[i];
      const indent = c._left - minLeft;
      if (indent < INDENT_THRESHOLD) {
        current = { author: c.author, content: c.content, replies: [], _commentIdx: i };
        threads.push(current);
      } else if (current) {
        current.replies.push({ author: c.author, content: c.content, replyTo: c.replyTo || '' });
      }
    }
    return threads;
  }

  const threads = [], used = new Set();
  for (let i = 0; i < flat.length; i++) {
    const c = flat[i];
    if (c.replyTo || used.has(i)) continue;
    const replies = [];
    for (let j = i + 1; j < flat.length; j++) {
      const r = flat[j];
      if (used.has(j)) continue;
      if (!r.replyTo) continue;
      if (authorMatch(r.replyTo, c.author) || replies.some(p => authorMatch(r.replyTo, p.author))) {
        replies.push({ author: r.author, content: r.content, replyTo: r.replyTo });
        used.add(j);
      }
    }
    threads.push({ author: c.author, content: c.content, replies: replies.slice(0, 15), _commentIdx: i });
    used.add(i);
  }
  return threads;
}

// ========== 工具函数 ==========

/**
 * 清洗 AI 输出内容里可能残留的版本前缀标签
 * 例如："版本A：xxx" / "A: xxx" / "（版本A正文，朋友分享型...）xxx" → "xxx"
 */
function stripVersionPrefix(text) {
  if (!text) return '';
  // 去掉括号包裹的描述说明行（如"（版本A正文，朋友分享型，...）"）
  text = text.replace(/^[（(][^）)]{0,40}[）)]\s*/u, '');
  // 去掉 "版本A：" / "版本A:" / "A：" / "A:" 前缀
  text = text.replace(/^(版本\s*[A-Ca-c]\s*[：:：]\s*|[A-Ca-c]\s*[：:：]\s*)/u, '');
  return text.trim();
}

function showNoteInfo(data) {
  const el = document.getElementById('noteInfo');
  el.style.display = 'block';
  el.className = 'note-info active';  // req 5: 浅黄高亮
  const noteId = data.url ? (data.url.match(/\/explore\/([a-f0-9]+)/) || data.url.match(/\/note\/([a-f0-9]+)/) || [])[1] : '';
  el.innerHTML = `
    <div class="note-title">${esc(data.title || '(无标题)')}</div>
    <div class="note-meta">
      <span>👤 ${esc(data.author || '未知')}</span>
      <span>💬 ${data.comments.length} 条评论</span>
      <span>📡 ${esc(data._sourceLabel || '默认')}</span>
      ${noteId ? `<span style="font-size:10px;color:#bbb;font-family:monospace;">#${noteId.slice(0, 8)}</span>` : ''}
    </div>`;
  // 通知左侧笔记列表当前打开的笔记 (req 6)
  if (window._notifyNoteOpened && noteId) {
    window._notifyNoteOpened(noteId);
  }
  // 二级评论数：本轮评论分组里挂在每条一级评论下的「回复」条数（截流列表的「数据」列要用）
  const threads = Array.isArray(data && data.threads) ? data.threads : [];
  chrome.runtime.sendMessage({
    action: 'drainTrackNote',
    noteId: data.noteId || noteIdFrom(data.url), url: data.url, title: data.title, author: data.author,
    likes: (data && typeof data.likes === 'number') ? data.likes : undefined,
    commentsCount: (data && data.comments && data.comments.length) || 0,
    subCommentsCount: threads.length ? threads.reduce((s, t) => s + ((t.replies || []).length), 0) : null,
  }).then(result => {
    if (!result || !result.ok) throw new Error((result && result.error) || '后台未返回结果');
  }).catch(e => addLog('笔记列表登记失败：' + (e.message || e), 'warn'));
}
function setBadge(text, cls) {
  const el = document.getElementById('statusBadge');
  el.textContent = text;
  el.className = 'badge' + (cls ? ' ' + cls : '');
}
function setStatus(text, cls) {
  const el = document.getElementById('statusBar');
  el.innerHTML = text;
  el.className = 'status-bar' + (cls ? ' ' + cls : '');
  el.style.display = text ? 'block' : 'none';
}
function hideStatus() {
  document.getElementById('statusBar').style.display = 'none';
}
function hideEmpty() {
  const el = document.getElementById('mainContent');
  if (el) while (el.firstChild) el.removeChild(el.firstChild);
}
/** 待机态：弹窗刚打开、还没开始任何扫描时的内容区占位（不要调 refreshData，避免自动抓页） */
function showIdle() {
  const el = document.getElementById('mainContent');
  if (!el) return;
  while (el.firstChild) el.removeChild(el.firstChild);
  const div = document.createElement('div');
  div.className = 'empty';
  div.innerHTML = Ic('stop', 'ic-xl') +
    '<div class="em-title">待机中，当前未扫描任何笔记</div>' +
    '<div class="em-sub">已在笔记详情页 → 点右上「评论刷新」<br>或在左侧输入关键词搜索后点笔记「打开」</div>';
  el.appendChild(div);
}
function showEmpty(msg) {
  const el = document.getElementById('mainContent');
  if (!el) return;
  while (el.firstChild) el.removeChild(el.firstChild);
  const div = document.createElement('div');
  div.className = 'empty';
  if (msg) {
    div.innerHTML = Ic('alert', 'ic-xl') + `<div class="em-title">${msg}</div>` +
      '<div class="em-sub"><button id="retryBtn" class="btn btn-sm" style="margin-top:8px;">重试</button></div>';
    el.appendChild(div);
    document.getElementById('retryBtn')?.addEventListener('click', refreshData);
  } else {
    div.innerHTML = Ic('eye', 'ic-xl') + '<div class="em-title">请在 小红书笔记页面 点击插件图标</div>';
    el.appendChild(div);
  }
}
function esc(str) {
  if (!str) return '';
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}
function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ★ 扫描心跳：auto-bot 靠它判断"popup 是否真在扫描这篇"（扫描没起来/中途挂死都能快速收尾，不必干等 180s）
//   与 popup.js 同窗口共享，auto-bot 侧读 window.__scanLastBeat / __scanRunning / __scanActiveNoteId
window.__scanLastBeat = 0;
window.__scanRunning = false;
window.__scanActiveNoteId = '';
let __scanBeatTimer = null;
function touchScanBeat() { window.__scanLastBeat = Date.now(); }
function startScanHeartbeat(noteId) {
  window.__scanRunning = true;
  window.__scanActiveNoteId = noteId || _scanCurNoteId || '';
  touchScanBeat();
  if (!__scanBeatTimer) {
    __scanBeatTimer = setInterval(function () {
      if (window.__scanRunning) touchScanBeat();
    }, 6000);
  }
}
function stopScanHeartbeat() { window.__scanRunning = false; }

// ★ AI 扫描结束广播（供 auto-bot 监听）：本篇"无商机地结束"（无商机/AI失败/评论不足/无评论）时喊一嗓子，
//   机器人收到信号立即返回列表，不再干等 180s 超时；带 noteId 供 bot 做血缘校验，防串篇误结
function broadcastAiScanDone(ok) {
  stopScanHeartbeat();
  try { window.dispatchEvent(new CustomEvent('xhsAiScanDone', { detail: { ok: !!ok, noteId: _scanCurNoteId || '' } })); } catch (_) {}
  noteDone(null, { sent: false, reason: 'scan_done' }); // 扫描结束·无需发送 → 本篇"处理完"
  // ✂️ 截流：本轮操作停一下后，自动对"本轮未打开"的池内笔记按决策配置表补开刷新（算进 bot 一轮完成）
  drainScheduleReplenishAfterRound();
}

// 截流补开：获客一轮处理完后自动触发（防抖：本轮静默 8s 才当一轮结束，避免逐篇间隙误触发）
let _drainReplenishTimer = null;
function drainScheduleReplenishAfterRound() {
  if (window._drainReplenishBusy) return;
  if (_drainReplenishTimer) clearTimeout(_drainReplenishTimer);
  _drainReplenishTimer = setTimeout(async () => {
    try {
      const r = await chrome.runtime.sendMessage({ action: 'drainReplenish', round: true });
      if (r && r.ok && r.summary) {
        try {
          console.log('[截流] 本轮补开完成:', JSON.stringify(r.summary));
        } catch (_) {}
      }
    } catch (_) {}
  }, 8000);
}

// ═══ 统一"本篇处理完成"信号（严格自动灌水用）═══
// popup.js 与 auto-water-app.js 同在一个 window；auto 流水线每开一篇就等这一个信号（sent=true 已发出 / false 无需发），
// 收到即推进下一篇。以下 3 处各自代表一种"结单"：成功发送 / 已灌水 / 扫描结束无需发。
let _scanCurNoteId = '';
let _scanDoneFired = false;
function noteDone(id, res) {
  stopScanHeartbeat();
  if (_scanDoneFired) return;                 // 一篇最多发一次，防止"已灌水"等双信号把流水线推进两次
  _scanDoneFired = true;
  if (id) _scanCurNoteId = id;
  try { window.dispatchEvent(new CustomEvent('xhsNoteDone', { detail: { noteId: _scanCurNoteId, res: res || {} } })); } catch (_) {}
}
function noteIdFrom(url) { try { return _noteIdFromUrl(url || ''); } catch (_) { return ''; } }

// ★ 带超时的页面消息发送：防止 content.js 挂起时 popup 永久等待（超时后按"可能已发出"处理，不重发）
function sendTabMessageWithTimeout(tabId, msg, timeoutMs) {
  timeoutMs = timeoutMs || 60000;
  return Promise.race([
    chrome.tabs.sendMessage(tabId, msg),
    new Promise((_, reject) => setTimeout(() => reject(new Error('页面无响应（' + Math.round(timeoutMs / 1000) + 's），可能已发出，请刷新页面确认后再操作')), timeoutMs))
  ]);
}

// 停留时间配置（「🎯 获客 → ⚙️ 设置 → ⏱ 各环节停留 / 间隔」，存 delay_config）：未配置的键用默认表兜底
// 实际停留 = 设定值 + 随机上浮最多 50%；floor 为技术下限（防页面没加载完就开扫）
const DELAY_POPUP_DEFAULTS = { browseDwell: 0, typingCharDelay: 0, likeGap: 0, lazyLoadWait: 300, retryBackWait: 300, retryOpenWait: 800, noteOpenBuffer: 300, preSendGap: 500, batchItemGap: 0 };
async function getDwellMs(key, floor) {
  // 新{key:{min,max}}区间随机；旧数值 n → min=n、max≈n*1.6
  let v = await (async function () {
    let c;
    try {
      const r = await chrome.storage.local.get('delay_config');
      c = (r.delay_config || {})[key];
    } catch (_) { c = undefined; }
    if (c === undefined) c = DELAY_POPUP_DEFAULTS[key];
    let minV = 0, maxV = 0;
    if (c && typeof c === 'object') { minV = Math.max(0, Number(c.min) || 0); maxV = Math.max(0, Number(c.max) || 0); }
    else { minV = maxV = Math.max(0, Number(c) || 0); if (maxV) maxV = Math.round(maxV * 1.6); }
    if (maxV > minV) return minV + Math.random() * (maxV - minV);
    return minV;
  })();
  return Math.max(floor || 0, v);
}

/* ═══════════ 🧭 诊断&配置：6 个节点（基础配置[产品名称+账号类型+抓主页+昵称/同城]→问卷→人设[含说话风格]→产品卖点→知识库→规划[内容排产+深度评估]；客户话术在「线索 → 任务配置」、内容基调在「发笔记 → 任务配置」） ═══════════ */
var _diagState = { profile: null, persona: '', kbCount: 0, accountType: '', notePlan: null, mixEdit: null, report: null, busy: '', diagnosis: null, unifiedAnswers: [], userBio: null, loaded: false, quizDirty: false, syncMessage: '', scriptStyle: null, noteStyle: null, noteStyleEdit: null, styleAdvice: null, kbDraft: '', kbHistory: [], kbEntries: [], kbSearch: '', kbFilterCat: '', kbFilterStatus: '', sellDraft: { title: '', content: '', image: '' }, sellImage: '', kbFiles: [], kbBackupFile: null, kbFileLabel: '' };
var _diagStep = 1;
// ★ 统一问卷（13 题）：人设/卖点/知识库/规划共用一套，只答一次。选择题优先——点一下就成，textarea 只作补充。
//   采集时把「点选项 + 补充」拼成一段文本存进 answer，下游 AI 全量读，不用改映射。
//   出题原则：问事实（客户问过什么、你听到过什么），不问回忆（"你踩过最大的坑"这种大部分人答不上来）。
var DIAG_QUIZ = [
  { group: '你是谁', q: '你是这行里的什么人？',
    opts: ['从业者（店员/技师/顾问）', '老板·店主', '源头（工厂·产地·农户）', '深度爱好者转行'], multi: false,
    hint: '点一个最接近的，再补一句：在哪、做什么、多久了' },
  { group: '', q: '你的产品/服务是什么、帮谁解决什么问题？相比别人最大的 2-3 个优势或差异点是什么？' },
  { group: '', q: '你最硬的凭据是什么？（AI 猜不到，只能你来给）',
    opts: ['干了 3 年以上', '服务过 100+ 客户', '我自己的亲身经历', '有供应链·产地·一手货源', '有资质证书', '暂时没有，靠经验'], multi: true },
  { group: '你的故事和立场', q: '客户最常问你哪 3 个问题？',
    hint: '这题最值钱——它同时就是你的选题池，想不起来就写"最常问多少钱"' },
  { group: '', q: '这行里你最看不惯、最想吐槽什么？',
    opts: ['同行乱报价', '以次充好、假的当真的卖', '只会吹参数不讲实话', '强推、不管你需不需要', '制造焦虑催你下单', '说一套做一套'], multi: true },
  { group: '你的干货', q: '你最拿手、最想让别人记住的观点或结论是什么？' },
  { group: '', q: '你的目标客户是谁？他们最担心、最容易踩坑的地方是什么？' },
  { group: '账号怎么说话', q: '账号主要分享什么、写给谁看？' },
  { group: '', q: '用一句话介绍你自己：你是谁、在干嘛、擅长什么、能帮客户什么？',
    hint: '照这个句式写就行：我是做 XX 的 XX，做了 X 年，擅长 XX，能帮客户 XX；不想写就空着，提交问卷后 AI 会按你的资料替你写' },
  { group: '', q: '你打算怎么称呼读者？',
    opts: ['你', '姐妹们', '宝子们', '家人们', '朋友们'], multi: false },
  { group: '手上有什么料', q: '你手上有什么能用的真实素材？',
    opts: ['真实照片（几十张以上）', '真实照片（只有几张）', '拍得出来的视频', '老物件·工具·原料', '顾客反馈截图·聊天记录', '几乎没有'], multi: true },
  { group: '怎么找到你', q: '客户会在什么场景/需求下想起你、怎么找到你？' },
  { group: '', q: '内容节奏：一篇图文大概几页、多久发一篇、什么时间段发？' },
];
// 下游多处按 index 读题目文本，这里派生出来保持兼容
var DIAG_UNIFIED_QUESTIONS = DIAG_QUIZ.map(function (x) { return x.q; });
// 把已存答案拆成「命中选项的」与「剩下的原文」——原样往返，用户自己在补充里打了分号也不会丢
function _diagSplitAnswer(answer, opts) {
  const raw = String(answer == null ? '' : answer).trim();
  const list = Array.isArray(opts) ? opts : [];
  if (!raw || !list.length) return { picked: [], rest: raw };
  const picked = [], rest = [];
  raw.split('；').forEach(function (part) {
    const t = part.trim();
    if (!t) return;
    if (list.indexOf(t) >= 0 && picked.indexOf(t) < 0) picked.push(t); else rest.push(t);
  });
  return { picked: picked, rest: rest.join('；') };
}
var DIAG_KB_QUESTIONS = [
  '你的产品/服务是什么？主要帮人解决什么问题、满足什么需求？',
  '你的目标客户是谁？他们购买前最常问、最担心、最容易踩坑的点是什么？',
  '你有哪些亲身经验或案例（做过的事、帮过谁、踩过的坑），能用来建立信任和给建议？',
  '有没有具体的数字、价格、政策或行业数据，客户需要知道的？',
  '你最想让大家记住你的 2-3 个专业观点或干货结论是什么？',
];
var DIAG_ACCOUNT_TYPES = ['干货分享型', '测评型', '生活方式种草型', '教程/步骤型', '经验情感型', '资料整理型', '个人IP/创始人型'];
var DIAG_PLAN_QUESTIONS = [
  '你的笔记主要想讲什么内容？（可结合人设/产品卖点/知识库来定）',
  '主要写给谁看（目标人群）？他们最关心、最需要什么？',
  '一套图文你打算发几页？（不确定就写"帮我定"）',
  '你打算多久发一篇、在什么时间段发？',
];
var DIAG_SELL_QUESTIONS = [
  '你的产品/服务是什么？主要帮人解决什么问题、给谁用？',
  '相比竞品或以前的用法，它最大的 2-3 个优势或差异点是什么？',
  '有没有具体数字、效果、案例能证明它的价值？',
  '用户最可能在什么场景/需求下想起它、怎么找到你？',
  ];
function _dEsc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
function _dBtn(id, label, sub, color) {
  return '<button id="' + id + '" class="btn ' + (color || 'btn-primary') + '" style="margin-right:8px;margin-bottom:8px;">' + label + (sub ? '<span style="font-size:11px;opacity:.8;margin-left:4px;">' + sub + '</span>' : '') + '</button>';
}
async function _diagSay(method, data) { return await chrome.runtime.sendMessage({ action: method, data: data || {} }); }
async function _diagGetCfg() { return await readConfigPlain(); }
// 读取已记录的同城城市（基础配置记录，也可手填）
async function _diagGetMyCity() {
  try {
    const cfg = await _diagGetCfg();
    const mc = cfg && cfg.myCity;
    return (mc && typeof mc === 'object') ? mc : { city: '', ipLocation: '', source: '', updatedAt: 0 };
  } catch (_) { return { city: '', ipLocation: '', source: '', updatedAt: 0 }; }
}
async function _diagSaveCfg(cfg) { await chrome.storage.local.set({ config: (typeof DataPrivacy !== 'undefined') ? await DataPrivacy.lockConfig(cfg) : cfg }); }
function _diagCard(innerHtml) { return '<div style="border:1px solid #e7eaf0;border-radius:12px;padding:14px 16px;background:#fff;box-shadow:0 1px 3px rgba(24,24,40,.05);">' + innerHtml + '</div>'; }
function _diagLabel(txt) { return '<div style="font-size:12px;color:#333;margin-bottom:4px;">' + txt + '</div>'; }
/* 节点标题行（五十二改：序号徽标已废，只留名字）：act 是可选的动作区——保存类按钮一律挂这儿（页顶），别放页尾 */
function _diagStepTitle(txt, act) {
  return '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;">' +
    '<span style="font-weight:700;font-size:15px;color:#1f1f1f;flex:1;min-width:120px;">' + txt + '</span>' +
    (act ? '<span style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' + act + '</span>' : '') + '</div>';
}
async function renderDiagnosis(container) {
  container.innerHTML = [
    '<style>#diagBody .btn{min-height:34px;padding:7px 12px;font-size:12px;line-height:1.5;white-space:normal}#diagBody .btn-outline{background:#fff;color:var(--primary);border-color:#d8dee9}#diagBody .btn-outline:hover:not(:disabled){background:var(--primary-bg);border-color:var(--primary)}#diagBody button:disabled{opacity:.55;cursor:not-allowed}#diagBody input:not([type=checkbox]):not([type=file]),#diagBody textarea,#diagBody select{padding:8px 10px;border:1px solid #d8dee9;border-radius:8px;font-size:13px;line-height:1.6;background:#fff;color:#333}#diagBody textarea{resize:vertical}#diagBody input:focus-visible,#diagBody textarea:focus-visible,#diagBody button:focus-visible{outline:2px solid var(--primary);outline-offset:2px}#diagBody .diag-sync-line{font-size:12px;line-height:1.7;margin:6px 0;overflow-wrap:anywhere}#diagBody .dg-tabs{display:flex;gap:2px;border-bottom:1px solid var(--line,#eceef0)}#diagBody .dg-tab{border:0;background:none;padding:6px 12px;margin-bottom:-1px;font-size:12px;font-weight:600;color:#6b7280;cursor:pointer;border-bottom:2px solid transparent}#diagBody .dg-tab:hover{color:#374151}#diagBody .dg-tab.active{color:var(--c-brand-text,var(--xhs-red));border-bottom-color:var(--c-brand,var(--xhs-red))}</style>',
    '<div style="padding:14px 16px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--c-surface),var(--c-brand-soft));">',
    '  <div style="font-weight:700;font-size:15px;color:var(--ink);">诊断&amp;配置 · 一份问卷同步账号资料<span class="qhelp" tabindex="0" data-tip="左栏是一条链：先在「基础配置」填产品名称、账号类型，抓一次主页；再去「问卷」答完提交一次，AI 就把人设、卖点、知识库、规划都生成并保存，这几页随时能查看与修改。客户话术在「线索 → 任务配置」，内容基调在「发笔记 → 任务配置」，推广目标与评论区承接在「获客 → 任务配置」。">?</span></div>',
    '</div>',
    '<div id="diagBody" style="padding:14px;font-size:13px;color:#333;">正在恢复账号诊断…</div>',
  ].join('');
  const body = container.querySelector('#diagBody');
  try {
    if (!_diagState.busy) {
      const [cfg, stored] = await Promise.all([_diagGetCfg(), chrome.storage.local.get(['note_plan', 'deep_report'])]);
      const diagnosis = cfg.diagnosis || null;
      if (!_diagState.loaded) {
        if (diagnosis) {
          _diagState.profile = diagnosis.profile || null;
          _diagState.userBio = diagnosis.bio == null ? null : String(diagnosis.bio);
          _diagState.unifiedAnswers = Array.isArray(diagnosis.answers) ? diagnosis.answers : [];
          _diagState.accountType = diagnosis.accountType || '';
          // 恢复诊断是异步的，期间用户可能已经点了别的节点 —— 点过就别把他拽回原节点（diagGo 里置的 pinned）
          if (!_diagState.stepPinned) _diagStep = _diagState.unifiedAnswers.length ? 3 : 1;
        }
        _diagState.loaded = true;
      }
      _diagState.diagnosis = diagnosis;
      _diagState.scriptStyle = cfg.scriptStyle || {};
      _diagState.persona = (cfg.persona && cfg.persona.text) || _diagState.persona;
      _diagState.notePlan = stored.note_plan || null;
      _diagState.report = stored.deep_report || null;   // 跟着租户走：没有就清空，别留着上一个租户的报告
    }
    if (document.getElementById('diagBody') === body) diagGo(_diagStep, true);
  } catch (e) {
    if (document.getElementById('diagBody') !== body) return;
    body.innerHTML = '<div style="color:#c62828;">恢复诊断失败：' + _dEsc(e.message || e) + '</div>' + _dBtn('diagLoadRetry', '重新读取', '', 'btn-outline');
    body.querySelector('#diagLoadRetry').onclick = function () { renderDiagnosis(container); };
  }
}
/* 6 个节点的顺序与内部 id：按钮本体在 popup.html 的 #diagSubTabs 里（文案在那儿维护）。
   界面上已不再显示 ①~⑨ 序号；说话风格并进了「人设」页的 tab，客服话术搬到「线索 → 任务配置」，内容基调搬到「发笔记 → 任务配置」 */
const DIAG_STEPS = [1, 2, 3, 4, 5, 6];
function _diagStepDone(t) {
  const results = (_diagState.diagnosis && _diagState.diagnosis.results) || {};
  const result = results[{ 3: 'persona', 4: 'product', 5: 'knowledge', 6: 'plan' }[t]];
  // 基础配置只要抓过主页就算完成；问卷提交过才算完成（还有没提交的改动就不打勾）；
  // 人设/卖点/知识库按问卷同步的结果；规划含深度评估报告，报告没出就不打勾
  if (t === 1) return !!_diagState.profile;
  if (t === 2) return _diagQuizSubmitted() && !_diagState.quizDirty;
  if (!result || result.status !== 'done' || _diagState.quizDirty) return false;
  return t === 6 ? !!_diagState.report : true;
}
// 说话风格「设置过」的判据：识别过口吻（口吻档案/口癖词/样张，任一有值即算；字数栏有默认值，撑不起这个勾）
function _diagStyleSet() {
  const s = _diagState.scriptStyle || {};
  return !!(String(s.toneProfile || '').trim() || String(s.toneMannerisms || '').trim() || String(s.personaSample || '').trim());
}
// 问卷「提交过」的判据：库里有非空答案（跟当前编辑器内容无关，页面重进也算）
function _diagQuizSubmitted() {
  const answers = (_diagState.diagnosis && _diagState.diagnosis.answers) || [];
  return answers.some(function (a) { return String((a && a.answer) || '').trim(); });
}
/* 6 个节点画在左侧栏「诊断&配置」下方的二级 tab 里（popup.html #diagSubTabs）；页面内不再有导航圈。
   完成状态只靠 .done 变绿——不再往标签里塞「✓」，免得跟行首图标叠成两个图标 */
function _diagPaintNav() {
  const nav = document.getElementById('diagSubTabs'); if (!nav) return;
  DIAG_STEPS.forEach(function (n) {
    const btn = nav.querySelector('[data-go="' + n + '"]'); if (!btn) return;
    const cur = n === _diagStep, done = _diagStepDone(n);
    btn.classList.toggle('active', cur);
    btn.classList.toggle('done', done && !cur);
    btn.disabled = !!_diagState.busy;
  });
}
/* 节点号 → 画法：值即下面那几个 diagStep* 函数（函数声明会提升，写在这儿也能引用到） */
const DIAG_VIEWS = { 1: diagStepBase, 2: diagStepQuiz, 3: diagStepPersona, 4: diagStepSell, 5: diagStepKb, 6: diagStepPlan };
function diagGo(n, restoreView) {
  if (_diagState.busy && !restoreView) return;
  _diagStep = n;
  if (!restoreView) _diagState.stepPinned = true;   // 用户点的节点，别被恢复流程改掉
  const b = document.getElementById('diagBody'); if (!b) return;
  b.innerHTML = '<div id="diagStepBody"></div>';
  _diagPaintNav();
  const body = document.getElementById('diagStepBody');
  const draw = DIAG_VIEWS[n];
  if (typeof draw === 'function') draw(body);
}

/* ── 基础配置（产品名称 + 账号类型 + 昵称 + 同城 + 抓主页：账号与产品的基本盘）
      推广目标 & 评论区承接 2026-09-25 搬去「获客 → 任务配置 → 🎯 推广目标」（词池 / 盯人之后第三个 tab） ── */
function diagStepBase(body) {
  if (!body) return;
  body.innerHTML = '<style>' +
    '#diagStepBody .diag-s1-msg{font-size:12px;color:#777;line-height:1.7;margin:6px 0;overflow-wrap:anywhere;white-space:pre-wrap}' +
    '#diagStepBody .diag-s1-sec{border-top:1px solid #eef1f6;margin-top:14px;padding-top:12px}' +
    '#diagStepBody .diag-s1-h{font-weight:700;font-size:13px;color:#333;margin-bottom:6px}' +
    '#diagStepBody .diag-s1-sub{font-weight:400;color:#999;font-size:11px;margin-left:6px}' +
    '#diagStepBody .diag-s1-tip{font-size:11px;color:#999;margin-top:4px;line-height:1.6}' +
    '#diagStepBody .diag-s1-lab{font-size:12px;color:#333;margin:8px 0 4px}' +
    '#diagStepBody .diag-acct-chip{font-size:12px;padding:5px 10px;border:1px solid #dfe3ea;border-radius:14px;background:#f6f7f9;color:#555;cursor:pointer}' +
    '</style>' +
    _diagCard(
      _diagStepTitle('基础配置 · 账号与产品的基本盘',
        '<button type="button" id="diagS1Save" class="btn btn-primary" style="margin:0;">💾 保存基础配置</button>') +
      '<div id="diagS1Msg" role="status" class="diag-s1-msg"></div>' +
      // 产品名称 & 小红书昵称并排（2026-09-25 三十一改）：都是「你是谁」这一格里的基本盘，一行两个省半屏
      '<div class="diag-s1-sec" style="border-top:0;margin-top:6px;padding-top:0;"><div style="display:flex;gap:10px;flex-wrap:wrap;">' +
      '<div style="flex:1 1 220px;min-width:0;"><div class="diag-s1-h">产品名称<span class="diag-s1-sub">每行一个：第一行＝主名，后面＝别名·留空＝「我的产品」</span></div>' +
      '<textarea id="diagProdName" rows="2" placeholder="例：贷款计算器小程序／别名再占一行"></textarea></div>' +
      '<div style="flex:1 1 220px;min-width:0;"><div class="diag-s1-h">我的小红书昵称<span class="diag-s1-sub">认「这条是不是我评过」</span></div>' +
      '<textarea id="diagAccountNames" rows="2" placeholder="每行一个，可填多个（含曾用昵称）"></textarea></div>' +
      '</div></div>' +
      '<div class="diag-s1-sec"><div class="diag-s1-h">账号类型 <span class="qhelp" tabindex="0" data-tip="规划与评估按它写；不选＝AI 判断">?</span></div>' +
      '<div id="diagAcctChips" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">' +
      DIAG_ACCOUNT_TYPES.map(function (ty) {
        return '<button type="button" class="diag-acct-chip" data-v="' + _dEsc(ty) + '">' + _dEsc(ty) + '</button>';
      }).join('') + '</div>' +
      '<input id="diagAcctCustom" type="text" placeholder="其他类型可自填，留空由 AI 判断" style="width:100%;box-sizing:border-box;"></div>' +
      '<div class="diag-s1-sec"><div class="diag-s1-h">同城挡位 &amp; 城市 <span class="qhelp" tabindex="0" data-tip="对截流决策的影响：这一挡决定「读到同城的真人评论时，回不回、往不往前排」。同城就回＝不挑商机，同城一律回（含看不出需求的）；同城优先＝同城往前排，话术尽量走同城案例角度，不强制回；关闭＝属地不参与判断，不单独对同城评论。城市是比对基准：抓主页会自动读下来，也可以手填；留空＝不做同城判断。">?</span></div>' +
      '<select id="diagSameCity" style="width:100%;box-sizing:border-box;">' +
      '<option value="force">同城就回</option>' +
      '<option value="priority">同城优先</option>' +
      '<option value="off">关闭</option>' +
      '</select>' +
      '<div class="diag-s1-lab">📍 城市</div>' +
      '<div style="display:flex;gap:6px;align-items:center;">' +
      '<input id="diagCityInp" style="flex:1;box-sizing:border-box;" placeholder="城市或省份，如：深圳"></div>' +
      '<div id="diagCityHint" class="diag-s1-tip"></div></div>' +
      '<div class="diag-s1-sec"><div class="diag-s1-h">抓主页 <span class="qhelp" tabindex="0" data-tip="会把昵称、简介、发过的笔记标题和同城城市一起读下来；需已在小红书网页版登录">?</span></div>' +
      '<div id="diagS1Profile"></div></div>'
    );
  diagRenderProfile(document.getElementById('diagS1Profile'));
  const chips = document.getElementById('diagAcctChips');
  if (chips) chips.querySelectorAll('.diag-acct-chip').forEach(function (b) {
    b.onclick = function () {
      if (_diagState.busy) return;
      _diagState.accountType = b.getAttribute('data-v');
      _diagAcctPaint(_diagState.accountType);
    };
  });
  document.getElementById('diagAcctCustom')?.addEventListener('input', function (e) {
    _diagState.accountType = e.target.value.trim(); e.target.dataset.touched = '1';
    _diagAcctPaint(_diagState.accountType, true);
  });
  document.getElementById('diagS1Save')?.addEventListener('click', diagBaseSave);
  diagBasePrefill();
}
/* 账号类型 chips 上色 + 回填自填框（keepInput：用户正在打字，别抢他的光标内容） */
function _diagAcctPaint(type, keepInput) {
  const input = document.getElementById('diagAcctCustom');
  if (input && !keepInput) input.value = type || '';
  document.querySelectorAll('.diag-acct-chip').forEach(function (el) {
    const selected = el.getAttribute('data-v') === type;
    el.style.background = selected ? 'var(--xhs-red)' : '#f6f7f9';
    el.style.color = selected ? '#fff' : '#555';
    el.style.borderColor = selected ? 'var(--xhs-red)' : '#dfe3ea';
  });
}
/* 预填整页：产品名称 + 账号类型 + 昵称 + 同城挡位与城市（页顶一个 💾 全存） */
async function diagBasePrefill() {
  try {
    const cfg = await _diagGetCfg();
    const setV = function (id, v) { const el = document.getElementById(id); if (el && v != null) el.value = v; };
    setV('diagProdName', _diagProdNamesOf(cfg.product || {}).join('\n'));
    _diagState.accountType = _diagState.accountType || (cfg.diagnosis || {}).accountType || '';
    _diagAcctPaint(_diagState.accountType);
    setV('diagAccountNames', (cfg.myAccountNames || []).join('\n'));
    setV('diagSameCity', ['force', 'priority', 'off'].includes(cfg.sameCityMode) ? cfg.sameCityMode : 'priority');
    await diagCityPaint();
  } catch (_) {}
}
/* 产品名多值（五十二改）：names[] 第一个＝主名、后面＝别名；name 恒＝主名，读旧字段的地方一字不用改。
   两边一起写，免得「改了主名、别名里还留着旧主名」 */
function _diagProdNamesOf(product) {
  const p = product || {};
  const out = [];
  for (const raw of (Array.isArray(p.names) ? p.names : []).concat([p.name])) {
    const v = String(raw || '').trim();
    if (v && v !== '我的产品' && !out.includes(v)) out.push(v);
  }
  return out;
}
function _diagProdSetNames(cfg, text) {
  const arr = String(text || '').split(/[\n,，;；]/).map(function (s) { return s.trim(); }).filter(Boolean)
    .filter(function (v, i, a) { return a.indexOf(v) === i; });
  cfg.product.names = arr;
  cfg.product.name = arr[0] || '我的产品';
  return arr;
}
/* 同城城市：回填已记录的值 + 一行来源说明；抓主页成功后也重画一次（手填过的以手填为准） */
async function diagCityPaint() {
  const inp = document.getElementById('diagCityInp'); if (!inp) return;
  const mc = await _diagGetMyCity();
  const shown = mc.city || mc.ipLocation || '';
  inp.value = shown;
  inp.dataset.init = shown;   // 保存时拿它判「用户动过没」：没动过就保留抓主页记下的 source
  const hint = document.getElementById('diagCityHint'); if (!hint) return;
  const src = mc.source === 'manual' ? '你手填的' : (mc.updatedAt ? '从主页读到的' : '');
  hint.textContent = (src ? '当前：' + (mc.city || '-') + '（' + src + '）' : '还没记录城市——可手填，或点下方「抓取我的主页」读一次') +
    (mc.ipLocation ? ' · 主页 IP 属地：' + mc.ipLocation : '') +
    (!inp.value ? ' · 留空＝不做同城判断' : '');
}
/* 一次保存整页：产品名称 + 账号类型 + 昵称 + 同城挡位与城市（推广目标/承接在 获客 → 任务配置） */
async function diagBaseSave() {
  const btn = document.getElementById('diagS1Save');
  if (!btn || _diagState.busy) return;
  _diagState.busy = 's1-save'; btn.disabled = true;
  _diagMsg('diagS1Msg', '正在保存…');
  try {
    const cfg = await _diagGetCfg();
    cfg.product = cfg.product || {};
    _diagProdSetNames(cfg, ((document.getElementById('diagProdName') || {}).value || ''));
    cfg.myAccountNames = String(((document.getElementById('diagAccountNames') || {}).value || ''))
      .split(/[\n,，;；]/).map(function (s) { return s.trim(); }).filter(Boolean);
    const scm = ((document.getElementById('diagSameCity') || {}).value || '');
    if (['force', 'priority', 'off'].includes(scm)) cfg.sameCityMode = scm;
    // 城市：只有手填改动过才写（没动过就保留抓主页记下的 auto 值和 IP 属地）
    let cityNote = '';
    const cityInp = document.getElementById('diagCityInp');
    if (cityInp) {
      const val = String(cityInp.value || '').trim();
      if (val !== String(cityInp.dataset.init || '')) {
        const old = (cfg.myCity && typeof cfg.myCity === 'object') ? cfg.myCity : {};
        cfg.myCity = { city: val, ipLocation: old.ipLocation || '', source: 'manual', updatedAt: Date.now() };
        cityInp.dataset.init = val;
        cityNote = val ? ('同城城市记为你手填的「' + val + '」') : '同城城市已清空（不再做同城判断）';
      }
    }
    const type = ((document.getElementById('diagAcctCustom') || {}).value || '').trim();
    cfg.diagnosis = cfg.diagnosis || {};
    const oldType = String(cfg.diagnosis.accountType || '');
    let planDropped = false;
    if (type !== oldType) {
      cfg.diagnosis.accountType = type;
      // 类型换了，规划就是按旧类型写的：清掉完成标记，催一次重新生成
      if (cfg.diagnosis.results && cfg.diagnosis.results.plan) { delete cfg.diagnosis.results.plan; planDropped = true; }
    }
    await _diagSaveCfg(cfg);
    _diagState.accountType = type;
    _diagState.diagnosis = cfg.diagnosis;   // 类型换了会清掉规划标记，导航圈要立刻跟上
    _diagMsg('diagS1Msg', '✅ 已保存：基础配置已写回账号资料。'
      + (cityNote ? cityNote + '。' : '') + (planDropped ? '账号类型变了，规划要重新生成。' : ''));
    await diagCityPaint();   // 城市那行的来源说明跟着变（手填 / 清空）
  } catch (e) {
    _diagMsg('diagS1Msg', '❌ 保存失败：' + (e.message || e) + '，可重试。', true);
  } finally {
    _diagState.busy = ''; btn.disabled = false;
    _diagPaintNav();   // busy 清掉之后再画，否则左栏 tab 会一直卡在禁用态
  }
}
async function diagFetchProfile() {
  const msg = document.getElementById('diagFetchMsg'); const btn = document.getElementById('diagFetchBtn');
  if (!btn || _diagState.busy) return;
  _diagState.busy = 'fetch'; btn.disabled = true; btn.textContent = '正在抓取本人主页…'; if (msg) msg.textContent = '正在打开/读取，请稍候…';
  try {
    const r = await _diagSay('extractOwnProfile');
    if (!r || !r.ok || !r.profile) throw new Error((r && (r.reason || r.error)) || '抓取失败');
    	_diagState.profile = r.profile;
    // ★ 同城城市：把主页读到的城市/IP 属地记进配置（供评论助手做「同城」判定）；
    //   手填过的以手填为准，抓取不覆盖；主页上读不到就不动已有值
    try {
      const mc = await _diagGetMyCity();
      const city = String(r.profile.city || '').trim();
      const ip = String(r.profile.ipLocation || '').trim();
      if ((city || ip) && mc.source !== 'manual') {
        const cfg = await _diagGetCfg();
        cfg.myCity = { city: city || ip, ipLocation: ip, source: 'auto', updatedAt: Date.now() };
        await _diagSaveCfg(cfg);
        addLog('📍 同城城市已记录：' + (city || ip) + (ip ? ('（主页 IP 属地：' + ip + '）') : ''), 'info');
      } else if (!city && !ip) {
        addLog('📍 主页上没读到城市/属地，可在本页手填（评论助手「同城」判定用）', 'warn');
      }
    } catch (_) {}

    // ★ 防重复灌水：默认用抓到的号主个人身份（昵称优先，其次小红书号）兜底
    try {
      const cfg = await _diagGetCfg();
      const names = (cfg.myAccountNames && cfg.myAccountNames.length) ? cfg.myAccountNames : [];
      const acc = (r.profile.name || '').trim() || (r.profile.xhsId || '').trim();
      if (acc && !names.some(function (n) { return !n || n === acc; })) {
        if (names.length) names.push(acc); else names.push(acc);
        cfg.myAccountNames = names;
        await _diagSaveCfg(cfg);
      }
    } catch (_) {}
    // 抓完只重画主页区：基础配置的状态变了，_diagPaintNav 会跟着改完成圈；城市那行也顺手刷一次
    const ps = document.getElementById('diagS1Profile'); if (ps) diagRenderProfile(ps);
    await diagCityPaint();
  } catch (e) { if (msg) { msg.style.color = '#c62828'; msg.textContent = '❌ 抓取失败：' + (e.message || e); } }
  finally {
    _diagState.busy = ''; btn.disabled = false; btn.textContent = '抓取我的主页';
    _diagPaintNav();   // 抓到主页这一页就算完成
  }
}
function diagRenderProfile(section) {
  if (!section) return;
  if (!_diagState.profile) {
    section.innerHTML = _dBtn('diagFetchBtn', '抓取我的主页', '(需已登录小红书)') + '<span id="diagFetchMsg" style="font-size:12px;color:#0a7b5a;"></span>';
    document.getElementById('diagFetchBtn')?.addEventListener('click', diagFetchProfile);
    return;
  }
  const p = _diagState.profile || {};
  const notes = (p.notes || []).map(function (n, i) { return (i + 1) + '. ' + (n.title || '（未命名）'); }).join('\n');
  const stat = function (v, l) { return '<div style="text-align:center;flex:1;"><div style="font-weight:700;font-size:15px;">' + _dEsc(v || '-') + '</div><div style="font-size:11px;color:#999;">' + l + '</div></div>'; };
  section.innerHTML = _diagCard(
    '<div style="display:flex;gap:12px;align-items:center;">' +
    '<div style="width:52px;height:52px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:24px;flex:none;">👤</div>' +
    '<div style="flex:1;min-width:0;"><div style="font-weight:600;font-size:15px;">' + _dEsc(p.name || '未命名') + '</div>' +
    '<div style="font-size:11px;color:#999;">小红书号：' + _dEsc(p.xhsId || '-') + '</div>' +
    '<div style="font-size:12px;color:#666;margin-top:2px;white-space:pre-wrap;word-break:break-word;">' + _dEsc(p.desc || '（暂无简介）') + '</div></div></div>' +
    '<div style="display:flex;margin:10px 0 4px;">' + stat(p.fans, '粉丝') + stat(p.follows, '关注') + stat(p.likes, '获赞') + '</div>'
  ) + '<div style="margin-top:12px;border:1px solid #eee;border-radius:8px;padding:10px;background:#fafbfc;"><b style="font-size:13px;">发过的笔记 (' + (p.notes || []).length + ')</b><div style="white-space:pre-wrap;font-size:12px;color:#555;margin-top:4px;">' + _dEsc(notes || '（未读到）') + '</div></div>' +
'<div style="margin-top:14px;">' + _dBtn('diagRefetchBtn', '重新抓取', '', 'btn-outline') + '<span id="diagFetchMsg" style="font-size:12px;color:#0a7b5a;"></span></div>';
  document.getElementById('diagRefetchBtn')?.addEventListener('click', function () { _diagState.profile = null; diagGo(1); });
}

/* ── 说话风格（答 3 个问题 → AI 认出你的口吻；AI 写评论、私信时按这个走，少点 AI 味） ── */
const TONE_QUESTIONS = [
  { q: '随便写几句你平时会发的话', hint: '想到啥写啥，就当刷到一条同行的笔记、顺手回了一句的那种' },
  { q: '你跟人聊天、回私信是什么调性？', hint: '爱开玩笑还是正经讲干货、先共情还是直接给建议；有没有常挂在嘴边的话' },
  { q: '哪种腔调你一看就烦？', hint: '比如「亲」「宝子」、客服腔、老师腔、喊口号——识别时 AI 会避开这些' },
];
function _diagToneResultHtml(s) {
  const profile = String(s.toneProfile || '').trim();
  if (!profile) {
    return '<div style="font-size:11px;color:#999;line-height:1.7;">还没识别过口吻——答完上面 3 个问题，点「🧠 识别我的口吻」，AI 会把你的语感画像和口癖词存下来，往后写评论、私信都照着用。</div>';
  }
  const mz = String(s.toneMannerisms || '').trim();
  const samples = String(s.personaSample || '').trim();
  return '<div style="border:1px solid #e7eaf0;background:#f9fafb;border-radius:10px;padding:10px 12px;">' +
    '<div style="font-size:12px;font-weight:600;color:#1f2937;margin-bottom:4px;">我识别到的口吻</div>' +
    '<div style="font-size:12px;line-height:1.8;color:#333;white-space:pre-wrap;word-break:break-word;">' + _dEsc(profile) + '</div>' +
    (mz ? '<div style="font-size:11px;color:#888;margin-top:6px;white-space:pre-wrap;word-break:break-word;">口癖词：' + _dEsc(mz) + '</div>' : '') +
    (samples ? '<div style="font-size:11px;color:#888;margin-top:4px;line-height:1.7;white-space:pre-wrap;word-break:break-word;">仿写的评论样张：\n' + _dEsc(samples) + '</div>' : '') +
    '</div>';
}
function diagStepStyle(body) {
  if (!body) return;
  body.innerHTML = _diagCard(
    _diagStepTitle('说话风格 · 少点 AI 味 <span class="qhelp" tabindex="0" data-tip="答下面 3 个问题，点「🧠 识别我的口吻」，AI 会把你的语感画像和口癖词存下来，往后写评论、私信都照着用；不满意就改改回答再识别一次，口吻变了也回来重新识别。">?</span>',
      '<button type="button" id="diagToneRun" class="btn btn-primary" style="margin:0;">🧠 识别我的口吻</button>' +
      '<button type="button" id="diagStyleSave" class="btn btn-outline" style="margin:0;">💾 保存</button>') +
    '<div id="diagStyleMsg" role="status" style="font-size:12px;color:#0a7b5a;margin:6px 0;"></div>' +
    _diagLabel('AI 话术字数（评论 / 私信，超 300 字小红书发不出去）<span class="qhelp" tabindex="0" data-tip="AI 写的评论、私信、四个渠道话术都按这个范围；四个渠道基调那边只是只读显示这个值，改只改这里。">?</span>') +
    '<div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;">最少 <input id="diagMinC" type="number" min="20" max="500" step="10" style="width:70px;"> 最多 <input id="diagMaxC" type="number" min="50" max="500" step="10" style="width:70px;"></div>' +
    '<div style="font-size:12px;color:#333;margin-bottom:8px;">用大白话答这 3 个问题，AI 照着你的原话认口吻：</div>' +
    TONE_QUESTIONS.map(function (item, i) {
      return '<div style="margin-bottom:10px;">' +
        '<div style="font-size:12px;color:#333;margin-bottom:4px;">' + (i + 1) + '. ' + _dEsc(item.q) + '</div>' +
        '<textarea id="diagTq' + i + '" rows="2" placeholder="' + _dEsc(item.hint) + '" style="width:100%;box-sizing:border-box;"></textarea>' +
        '</div>';
    }).join('') +
    '<div id="diagToneResult" style="margin-top:2px;"></div>'
  );
  document.getElementById('diagToneRun')?.addEventListener('click', diagToneRun);
  document.getElementById('diagStyleSave')?.addEventListener('click', diagStyleSave);
  diagStylePrefill();
}
async function diagStylePrefill() {
  try {
    const cfg = await _diagGetCfg();
    const s = cfg.scriptStyle || {};
    _diagState.scriptStyle = s;
    const setV = function (id, v) { const el = document.getElementById(id); if (el && v != null) el.value = v; };
    setV('diagMinC', s.purposeMinChars); setV('diagMaxC', s.purposeMaxChars);
    const ans = Array.isArray(s.toneAnswers) ? s.toneAnswers : [];
    TONE_QUESTIONS.forEach(function (_, i) { setV('diagTq' + i, String(ans[i] || '')); });
    const box = document.getElementById('diagToneResult');
    if (box) box.innerHTML = _diagToneResultHtml(s);
  } catch (_) {}
}
function _diagToneAnswersFromPage() {
  return TONE_QUESTIONS.map(function (item, i) {
    return { q: item.q, answer: String(((document.getElementById('diagTq' + i) || {}).value) || '').trim() };
  });
}
async function diagStyleSave() {
  const btn = document.getElementById('diagStyleSave');
  if (!btn || _diagState.busy) return;
  _diagState.busy = 's6-save'; btn.disabled = true;
  _diagMsg('diagStyleMsg', '正在保存…');
  try {
    const cfg = await _diagGetCfg();
    cfg.scriptStyle = cfg.scriptStyle || {};
    cfg.scriptStyle.purposeMinChars = parseInt((document.getElementById('diagMinC') || {}).value, 10) || 100;
    cfg.scriptStyle.purposeMaxChars = parseInt((document.getElementById('diagMaxC') || {}).value, 10) || 300;
    cfg.scriptStyle.toneAnswers = _diagToneAnswersFromPage().map(function (a) { return a.answer; });
    await _diagSaveCfg(cfg);
    _diagState.scriptStyle = cfg.scriptStyle;
    _diagMsg('diagStyleMsg', '✅ 已保存（回答也一起存了，随时回来接着改）。');
  } catch (e) {
    _diagMsg('diagStyleMsg', '❌ 保存失败：' + (e.message || e) + '，可重试。', true);
  } finally {
    _diagState.busy = ''; btn.disabled = false;
    _diagPaintNav();
  }
}
/* 3 问回答 → AI 认口吻：口吻档案 + 口癖词 + 3 条仿写样张，连同字数一起落盘 */
async function diagToneRun() {
  const btn = document.getElementById('diagToneRun');
  if (!btn || _diagState.busy) return;
  const answers = _diagToneAnswersFromPage();
  if (answers.filter(function (a) { return a.answer; }).length < 2) {
    _diagMsg('diagStyleMsg', '先答 2 个以上问题（随便写几句就行），AI 才认得出你的口吻。', true);
    return;
  }
  _diagState.busy = 's6-tone'; btn.disabled = true; _diagPaintNav();
  _diagMsg('diagStyleMsg', '正在读你的回答、认口吻…');
  try {
    const r = await _diagSay('aiToneProfile', { answers: answers });
    if (!r || !r.ok || !r.toneProfile) throw new Error((r && r.error) || 'AI 没返回内容，请重试');
    const cfg = await _diagGetCfg();
    cfg.scriptStyle = cfg.scriptStyle || {};
    cfg.scriptStyle.purposeMinChars = parseInt((document.getElementById('diagMinC') || {}).value, 10) || 100;
    cfg.scriptStyle.purposeMaxChars = parseInt((document.getElementById('diagMaxC') || {}).value, 10) || 300;
    cfg.scriptStyle.toneAnswers = answers.map(function (a) { return a.answer; });
    cfg.scriptStyle.toneProfile = r.toneProfile;
    cfg.scriptStyle.toneMannerisms = r.toneMannerisms || '';
    cfg.scriptStyle.personaSample = r.personaSample || '';
    await _diagSaveCfg(cfg);
    _diagState.scriptStyle = cfg.scriptStyle;
    const box = document.getElementById('diagToneResult');
    if (box) box.innerHTML = _diagToneResultHtml(cfg.scriptStyle);
    _diagMsg('diagStyleMsg', '✅ 口吻已识别并保存，写评论和私信时都按它来。');
  } catch (e) {
    _diagMsg('diagStyleMsg', '❌ 识别失败：' + (e.message || e) + '，可重试。', true);
  } finally {
    _diagState.busy = ''; btn.disabled = false;
    _diagPaintNav();
  }
}
/* 各节点顶部只读的同步状态：只给一句话，不挂跳转按钮——问卷是唯一生成口，左栏「问卷」随时可点。
   tail＝同一行末尾补的短状态（如卖点的条数）；emptyText 传 '' 表示这一节点没内容时整行不显示 */
function _diagSyncLine(key, emptyText, tail) {
  const results = (_diagState.diagnosis && _diagState.diagnosis.results) || {};
  const result = results[key];
  const dirty = !!_diagState.quizDirty;
  let text, color = '#667085';
  if (_diagState.busy === 'sync') {
    text = '正在随问卷同步账号资料，请稍候…';
  } else if (result && result.status === 'error') {
    text = '⚠️ 上次同步失败' + (result.message ? '：' + result.message : '') + '——回左侧栏「问卷」重新提交即可补生成。';
    color = '#c62828';
  } else if (result && result.status === 'done') {
    if (dirty) { text = '问卷有改动还没提交；这里显示的是上次同步的内容。'; }
    else { text = '✅ 已随问卷自动生成并保存' + (result.message ? '：' + result.message : ''); color = '#0a7b5a'; }
  } else {
    if (emptyText === '') return '';   // 这一节点没内容时不摆说明（页顶已有的状态行说了）
    text = emptyText || '还没有内容——左侧栏「问卷」答完提交会自动生成并保存。';
  }
  return '<div class="diag-sync-line" style="color:' + color + ';">' + _dEsc(text) +
    (tail ? '<span style="color:#98a2b3;">　·　' + _dEsc(tail) + '</span>' : '') + '</div>';
}
/* 账号简介：以抓主页读到的本人简介为准；没抓过就沿用上次存的（问卷里不再放简介输入框） */
function _diagBio() {
  const desc = String((_diagState.profile || {}).desc || '').trim();
  if (desc) return desc;
  const saved = _diagState.userBio != null ? String(_diagState.userBio) : ((_diagState.diagnosis && _diagState.diagnosis.bio) || '');
  return String(saved || '').trim();
}
/* 「从问卷同步」的共用件：取问卷答案（没填过就只提示，不给跳转按钮——左侧栏「问卷」一直在） */
function _diagQuizAnswers() {
  const src = (_diagState.unifiedAnswers && _diagState.unifiedAnswers.length)
    ? _diagState.unifiedAnswers
    : ((_diagState.diagnosis && _diagState.diagnosis.answers) || []);
  const list = src.map(function (a, i) { return { q: a.q || DIAG_UNIFIED_QUESTIONS[i], answer: String(a.answer || '').trim() }; });
  return list.some(function (a) { return a.answer; }) ? list : null;
}
function _diagSyncNoQuiz(msg, emptyText) {
  if (msg) { msg.style.color = '#c62828'; msg.textContent = emptyText || '还没填过问卷——左侧栏「问卷」答完提交后，这里就能同步了。'; }
}
/* 只重生成并标记这一项，其余三项不动（区别于提交问卷的全量同步）；mutate 可在同一次写盘里顺带改配置 */
async function _diagMarkNode(key, message, mutate) {
  const cfg = await _diagGetCfg();
  if (mutate) mutate(cfg);
  cfg.diagnosis = cfg.diagnosis || {};
  cfg.diagnosis.results = cfg.diagnosis.results || {};
  cfg.diagnosis.results[key] = { status: 'done', message: message };
  cfg.diagnosis.updatedAt = Date.now();
  await _diagSaveCfg(cfg);
  _diagState.diagnosis = cfg.diagnosis;
}
function _diagRefreshQuizStatus() {
  const busy = _diagState.busy === 'sync';
  const msg = document.getElementById('diagQuizMsg');
  if (msg) {
    msg.textContent = busy ? '正在依次同步人设、卖点、知识库、规划；请保持页面打开，暂不能切换步骤。' : _diagState.syncMessage;
    msg.style.color = '#555';
  }
  const btn = document.getElementById('diagQuizNext');
  if (btn) { btn.disabled = busy; btn.textContent = busy ? '正在同步账号资料…' : '保存问卷并同步账号资料'; }
  document.querySelectorAll('.diagQuiz_Q').forEach(function (el) { el.disabled = busy; });
  document.querySelectorAll('.diagQuiz_chip').forEach(function (el) { el.disabled = busy; el.style.opacity = busy ? '.5' : ''; el.style.pointerEvents = busy ? 'none' : ''; });
  _diagPaintNav();
}
/* ── 问卷（唯一生成口；不依赖抓主页，随时可填） ── */
function diagStepQuiz(body) {
  if (!body) return;
  body.innerHTML = _diagCard(
    _diagStepTitle('问卷 · 13 题一次问清',
      '<button type="button" id="diagQuizNext" class="btn btn-primary" style="margin:0;">保存问卷并同步账号资料</button>') +
    '<div id="diagQuizMsg" role="status" style="font-size:12px;margin:8px 0;white-space:pre-wrap;"></div>' +
    '<div style="font-size:12px;color:#888;margin:4px 0;">能点的先点，想补再补一句。提交一次＝生成并保存人设、卖点、知识库、规划；改了再提交，只补没成的项。</div>' +
    '<div id="diagQuiz_Qs" style="margin-top:6px;"></div>'
  );
  const saved = _diagState.unifiedAnswers || [];
  body.querySelector('#diagQuiz_Qs').innerHTML = DIAG_QUIZ.map(function (item, i) {
    const hit = saved.find(function (a) { return a && a.q === item.q; }) || saved[i] || {};
    const sp = _diagSplitAnswer(hit.answer || '', item.opts);
    const head = item.group ? '<div style="font-size:12px;font-weight:600;color:#333;margin:14px 0 8px;padding-left:8px;border-left:3px solid var(--c-brand);">' + _dEsc(item.group) + '</div>' : '';
    const chips = (item.opts || []).map(function (o) {
      const on = sp.picked.indexOf(o) >= 0;
      return '<button type="button" class="diagQuiz_chip' + (on ? ' on' : '') + '" data-i="' + i + '" data-opt="' + _dEsc(o) + '"' +
        ' style="display:inline-block;padding:3px 10px;margin:0 6px 6px 0;font-size:12px;line-height:18px;border-radius:14px;cursor:pointer;' +
        (on ? 'border:1px solid var(--c-brand);color:var(--c-brand-text);background:var(--c-brand-soft);font-weight:600;' : 'border:1px solid #ddd;color:#444;background:#fff;') + '">' + _dEsc(o) + '</button>';
    }).join('');
    const tag = item.opts ? '<span style="font-weight:400;color:#999;margin-left:6px;">' + (item.multi ? '可多选' : '选一个') + '</span>' : '';
    const hint = item.hint ? '<div style="font-size:11px;color:#999;margin:2px 0 4px;">' + _dEsc(item.hint) + '</div>' : '';
    return '<div style="margin-bottom:10px;"><label for="diagQuizQ' + i + '" style="font-size:12px;">Q' + (i + 1) + '. ' + _dEsc(item.q) + tag + '</label>' +
      (chips ? '<div style="margin:6px 0 2px;">' + chips + '</div>' : '') + hint +
      '<textarea id="diagQuizQ' + i + '" class="diagQuiz_Q" data-i="' + i + '" rows="2" style="width:100%;box-sizing:border-box;" placeholder="' + (item.opts ? '补充说明（可不填）' : '你的回答…') + '">' + _dEsc(sp.rest) + '</textarea></div>';
  }).join('');
  body.querySelectorAll('.diagQuiz_Q').forEach(function (el) {
    el.addEventListener('input', function () { _diagCaptureQuiz(); _diagState.quizDirty = true; _diagState.syncMessage = '修改尚未提交，请保存问卷并同步。'; _diagRefreshQuizStatus(); });
  });
  body.querySelectorAll('.diagQuiz_chip').forEach(function (el) {
    el.addEventListener('click', function () {
      const i = el.getAttribute('data-i');
      const item = DIAG_QUIZ[Number(i)] || {};
      if (item.multi) {
        _diagPaintChip(el, !el.classList.contains('on'));
      } else {
        const wasOn = el.classList.contains('on');
        body.querySelectorAll('.diagQuiz_chip[data-i="' + i + '"]').forEach(function (o) { _diagPaintChip(o, false); });
        _diagPaintChip(el, !wasOn);
      }
      _diagCaptureQuiz();
      _diagState.quizDirty = true;
      _diagState.syncMessage = '修改尚未提交，请保存问卷并同步。';
      _diagRefreshQuizStatus();
    });
  });
  body.querySelector('#diagQuizNext').addEventListener('click', diagQuizSync);
  _diagRefreshQuizStatus();
}
function _diagPaintChip(el, on) {
  if (!el) return;
  el.classList.toggle('on', !!on);
  el.style.border = on ? '1px solid var(--c-brand)' : '1px solid #ddd';
  el.style.color = on ? 'var(--c-brand-text)' : '#444';
  el.style.background = on ? 'var(--c-brand-soft)' : '#fff';
  el.style.fontWeight = on ? '600' : '400';
}
function _diagCaptureQuiz() {
  _diagState.unifiedAnswers = DIAG_QUIZ.map(function (item, i) {
    const ta = document.getElementById('diagQuizQ' + i);
    const picked = Array.from(document.querySelectorAll('.diagQuiz_chip.on[data-i="' + i + '"]')).map(function (b) { return b.getAttribute('data-opt'); });
    const rest = String(ta && ta.value || '').trim();
    return { q: item.q, answer: picked.concat(rest ? [rest] : []).join('；') };
  });
}
async function diagQuizSync() {
  if (_diagState.busy) return;
  _diagCaptureQuiz();
  const answers = _diagState.unifiedAnswers.map(function (a, i) { return { q: a.q || DIAG_UNIFIED_QUESTIONS[i], answer: String(a.answer || '').trim() }; });
  if (!answers.some(function (a) { return a.answer; })) {
    _diagState.syncMessage = '请至少填写一题后再提交。';
    _diagRefreshQuizStatus();
    return;
  }
  _diagState.busy = 'sync';
  _diagRefreshQuizStatus();
  try {
    const r = await _diagSay('aiDiagnosisSync', { profile: _diagState.profile, bio: _diagBio(), answers: answers, accountType: _diagState.accountType || '' });
    if (r && r.diagnosis) { _diagState.diagnosis = r.diagnosis; _diagState.accountType = r.diagnosis.accountType || ''; _diagState.quizDirty = false; }
    if (r && r.persona && r.persona.text) _diagState.persona = r.persona.text;
    if (r && r.plan) _diagState.notePlan = r.plan;
    if (!r || !r.ok) throw new Error((r && r.error) || '同步未完成');
    if (r.complete) {
      _diagState.syncMessage = '问卷已保存，人设、产品卖点、知识库、内容规划都已同步。去左侧栏逐项看一眼即可。';
    } else {
      const failed = [['persona', '人设'], ['product', '产品卖点'], ['knowledge', '知识库'], ['plan', '内容规划']].filter(function (it) {
        const res = r.diagnosis && r.diagnosis.results && r.diagnosis.results[it[0]];
        return !res || res.status !== 'done';
      }).map(function (it) {
        const res = (r.diagnosis.results || {})[it[0]] || {};
        return it[1] + '：' + (res.message || '未完成');
      });
      _diagState.syncMessage = '问卷与成功项已保存，还有 ' + failed.length + ' 项没成，处理后再提交同一份问卷，只补失败项：\n· ' + failed.join('\n· ');
    }
  } catch (e) {
    try {
      const cfg = await _diagGetCfg();
      if (cfg.diagnosis) _diagState.diagnosis = cfg.diagnosis;
    } catch (_) {}
    _diagState.syncMessage = '同步未完成：' + (e.message || e) + '。回答仍保留，已成功的结果不会清空，可再次提交补齐。';
  } finally {
    _diagState.busy = '';
    _diagRefreshQuizStatus();
  }
}

/* ── 人设（五十二改：这一页内两个横 tab —— 👤 人设 / 🗣 说话风格）
      老板口径：「🔄 从问卷同步那颗按钮好奇怪，这个按钮应该不要了——它是回复完问卷就要自己带上的」
      「还未随问卷同步过的提示也不要了」「保存的按钮就直接叫保存」。
      所以：同步按钮与同步状态行整块撤（提交问卷时 aiDiagnosisSync 一次把 人设/卖点/知识库/规划 都生成），
      没答过问卷只在人设输入框的 placeholder 里提示先去答问卷；原「说话风格」那一节点搬进来当第二个 tab。 ── */
let _diagPersonaSec = 'persona';
function diagStepPersona(body) {
  if (!body) return;
  body.innerHTML = '<div class="dg-tabs" id="diagPersonaTabs">' +
    '<button type="button" class="dg-tab" data-sec="persona">👤 人设</button>' +
    '<button type="button" class="dg-tab" data-sec="style">🗣 说话风格</button>' +
    '</div><div id="diagPersonaSec" style="margin-top:10px;"></div>';
  document.getElementById('diagPersonaTabs')?.addEventListener('click', function (e) {
    const b = e.target.closest('[data-sec]');
    if (!b || b.getAttribute('data-sec') === _diagPersonaSec) return;
    _diagPersonaSec = b.getAttribute('data-sec');
    _diagPaintPersonaSec();
  });
  _diagPaintPersonaSec();
}
function _diagPaintPersonaSec() {
  const sec = document.getElementById('diagPersonaSec'); if (!sec) return;
  document.querySelectorAll('#diagPersonaTabs .dg-tab').forEach(function (b) {
    b.classList.toggle('active', b.getAttribute('data-sec') === _diagPersonaSec);
  });
  if (_diagPersonaSec === 'style') { diagStepStyle(sec); return; }
  const asked = !!_diagQuizAnswers();
  sec.innerHTML = _diagCard(
    _diagStepTitle('人设 · 立住"你是谁"',
      '<button type="button" id="diagPEditSave" class="btn btn-primary" style="margin:0;">💾 保存</button>') +
    '<div id="diagPEditMsg" role="status" style="font-size:12px;color:#0a7b5a;margin:6px 0;"></div>' +
    '<div id="diagPStatus" style="font-size:12px;color:#666;margin:6px 0;"></div>' +
    '<div id="diagPCard"></div>' +
    '<textarea id="diagPEdit" rows="6" style="width:100%;box-sizing:border-box;white-space:pre-wrap;" placeholder="' +
      (asked ? '你的人设正文会出现在这里，可编辑…'
             : '还没答过问卷——先去左栏「问卷」答完提交一次，AI 会按你的回答自动带出人设；也可以直接在这里自己写一段。') +
    '"></textarea>'
  );
  document.getElementById('diagPEditSave')?.addEventListener('click', diagPersonaEditSave);
  document.getElementById('diagPEdit')?.addEventListener('input', function (e) { e.target.dataset.touched = '1'; });
  diagPersonaStatus();
}
async function diagPersonaStatus() {
  const st = document.getElementById('diagPStatus'); const edit = document.getElementById('diagPEdit');
  const cardBox = document.getElementById('diagPCard');
  try {
    const r = await _diagSay('getPersona'); const p = (r && r.persona) || null;
    if (!p || !p.text) { if (st) st.textContent = _diagQuizAnswers() ? '还没有已保存的人设——去左栏「问卷」再提交一次会自动生成，也可以直接在下面写并保存。' : ''; if (cardBox) cardBox.innerHTML = ''; return; }
    _diagState.persona = p.text;
    if (st) st.innerHTML = '✅ 已有保存的人设（' + (p.updatedAt ? new Date(p.updatedAt).toLocaleString('zh-CN') : '') + '）';
    if (cardBox) cardBox.innerHTML = p.card ? _diagPersonaCardHtml(p.card) : '';
    if (edit && !edit.dataset.touched) edit.value = p.text;
  } catch (_) {}
}
// 人设卡（结构化）：AI 从问卷提炼的字段，规划与写稿按这些字段约束，不再只靠一段正文
function _diagPersonaCardHtml(card) {
  const rows = [['identity', '身份'], ['proof', '凭据'], ['story', '来路'], ['stance', '立场'], ['catchphrase', '口头禅'], ['taboo', '雷区'], ['address', '称呼']];
  const items = rows.filter(function (r) { return String((card || {})[r[0]] || '').trim(); });
  if (!items.length) return '';
  return '<div style="margin:8px 0;padding:8px 10px;background:#f8fafd;border:1px solid #e5e8ee;border-radius:8px;font-size:12px;line-height:1.8;">' +
    '<div style="font-weight:700;">🧩 人设卡<span style="font-weight:400;color:#888;font-size:11px;margin-left:6px;">AI 从问卷提炼，规划与写稿都按它约束</span></div>' +
    items.map(function (r) { return '<div><span style="color:#888;">' + r[1] + '：</span>' + _dEsc(card[r[0]]) + '</div>'; }).join('') +
    '</div>';
}
async function diagPersonaEditSave() {
  const btn = document.getElementById('diagPEditSave'); const msg = document.getElementById('diagPEditMsg');
  const edit = document.getElementById('diagPEdit');
  if (!btn) return; const text = (edit && edit.value) ? edit.value.trim() : '';
  if (!text) { if (msg) { msg.style.color = '#c62828'; msg.textContent = '人设内容不能为空'; } return; }
  btn.disabled = true; if (msg) msg.textContent = '';
  try {
    // 手改的只是正文：把已有的卡 / 封面短语 / 问卷答案原样带上，别一次保存把结构化信息抹掉
    let prev = {};
    try { const cur = await _diagSay('getPersona'); prev = (cur && cur.persona) || {}; } catch (_) {}
    const persona = Object.assign({}, prev, { text: text, bio: _diagState.profile ? _diagState.profile.desc : prev.bio, updatedAt: Date.now() });
    const saved = await _diagSay('setPersona', { persona: persona });
    if (!saved || !saved.ok) throw new Error('保存失败');
    _diagState.persona = text; if (edit) edit.dataset.touched = '';
    if (msg) { msg.style.color = '#0a7b5a'; msg.textContent = '✅ 已保存修改后的人设。'; }
  } catch (e) { if (msg) { msg.style.color = '#c62828'; msg.textContent = '❌ ' + (e.message || e); } }
  finally { btn.disabled = false; }
}
function _diagMsg(id, text, error) {
  const el = document.getElementById(id);
  if (el) { el.textContent = text; el.style.color = error ? '#c62828' : '#0a7b5a'; }
}

var _diagSellState = { entries: [], loading: false, loaded: false, mode: '', editIndex: -1 };
// 卖点空库时的引导语：卡片顶部与同步状态行共用一条
const DIAG_SELL_EMPTY = '还没有卖点——点右上「新增卖点」自己写/导入，或到「问卷」提交一次自动生成。';
function diagSellRender() {
  const list = document.getElementById('diagSellList'); if (!list) return;
  const search = document.getElementById('diagSellSearch').value.trim().toLowerCase();
  const rows = _diagSellState.entries.map(function (entry, index) { return { entry: entry, index: index }; }).filter(function (row) {
    return [row.entry.title, row.entry.content].join('\n').toLowerCase().includes(search);
  });
  // 条数并进上面那行同步状态里（原来「已有 N 条」与「总数 N 条」各说一遍）；这里只在搜索时报命中数
  document.getElementById('diagSellStats').textContent = search ? ('匹配 ' + rows.length + ' 条') : '';
  list.innerHTML = '<table aria-label="产品卖点"><colgroup><col style="width:25%"><col style="width:43%"><col style="width:32%"></colgroup>' +
    '<thead><tr><th scope="col">卖点标题</th><th scope="col">内容摘要</th><th scope="col">操作</th></tr></thead>' +
    (rows.length ? rows.map(function (row) {
      const s = row.entry, content = String(s.content || '');
      return '<tbody class="diag-sell-item" data-index="' + row.index + '"><tr><td><b>' + _dEsc(s.title || '未命名卖点') + '</b>' + (s.image ? '<div class="diag-sell-note" style="color:#c026a3;">📷 已配图</div>' : '') + '</td>' +
        '<td>' + _dEsc(content.length > 80 ? content.slice(0, 80) + '…' : content) + '</td><td><div class="diag-sell-actions">' +
        '<button type="button" class="btn btn-outline diag-sell-view" aria-expanded="false" aria-controls="diagSellDetail' + row.index + '">查看</button>' +
        '<button type="button" class="btn btn-outline diag-sell-edit">编辑</button><button type="button" class="btn btn-outline diag-sell-delete">删除</button></div></td></tr>' +
        '<tr id="diagSellDetail' + row.index + '" class="diag-sell-detail" hidden><td colspan="3"><div class="diag-sell-full">' + _dEsc(content) + '</div></td></tr></tbody>';
    }).join('') : '<tbody><tr><td colspan="3">' + (_diagSellState.loading ? '正在读取卖点…' : !_diagSellState.loaded ? '卖点未读取，请点击“刷新列表”重试。' : _diagSellState.entries.length ? '没有匹配的卖点，请更换搜索词。' : '暂无卖点，点击「新增卖点」添加第一条。') + '</td></tr></tbody>') + '</table>';
  list.querySelectorAll('.diag-sell-item').forEach(function (row) {
    const index = Number(row.dataset.index), detail = row.querySelector('.diag-sell-detail'), view = row.querySelector('.diag-sell-view');
    view.onclick = function () {
      detail.hidden = !detail.hidden;
      view.textContent = detail.hidden ? '查看' : '收起';
      view.setAttribute('aria-expanded', String(!detail.hidden));
    };
    row.querySelector('.diag-sell-edit').onclick = function () { diagSellDialog('edit', index); };
    row.querySelector('.diag-sell-delete').onclick = async function () {
      if (_diagState.busy || !confirm('确定删除卖点“' + (_diagSellState.entries[index].title || '未命名卖点') + '”？')) return;
      await diagSellSaveEntries(_diagSellState.entries.filter(function (_, i) { return i !== index; }), '已删除卖点。', 'diagSellMsg');
    };
  });
  diagSellLock();
}
function diagSellMessage(id, text, error) {
  const el = document.getElementById(id);
  if (el) { el.textContent = text; el.style.color = error ? '#c62828' : '#0a7b5a'; }
}
function diagSellLock() {
  if (_diagStep !== 4) return;   // 节点 4＝产品卖点（popup.html #diagSubTabs 的 data-go）
  document.querySelectorAll('#diagBody button, #diagStepBody input, #diagStepBody textarea').forEach(function (el) {
    el.disabled = !!(_diagState.busy || _diagSellState.loading);
  });
  if (!_diagSellState.loaded) document.querySelectorAll('#diagSellAdd').forEach(function (el) { el.disabled = true; });
  const fileBtn = document.getElementById('diagSellFileImport');
  if (fileBtn) fileBtn.textContent = _diagState.busy === 'sell-file' ? (_diagState.sellFileLabel || '正在处理文件…') : '开始导入所选文件';
}
/* 卖点录入/编辑弹窗里的配图：Base64 直接存进卖点的 image（发笔记当素材用） */
function diagSellImgPaint() {
  const prev = document.getElementById('diagSellImgPrev'), clear = document.getElementById('diagSellImgClear');
  const src = String(_diagState.sellImage || '');
  if (prev) {
    if (src) { prev.src = src; prev.style.display = ''; }
    else { prev.removeAttribute('src'); prev.style.display = 'none'; }
  }
  if (clear) clear.style.display = src ? '' : 'none';
}
function diagSellDialog(mode, index) {
  if (_diagState.busy || _diagSellState.loading) return;
  const dialog = document.getElementById('diagSellDialog'); if (!dialog) return;
  if (!mode) {
    const editIndex = _diagSellState.editIndex;
    _diagSellState.mode = ''; _diagSellState.editIndex = -1;
    dialog.close();
    document.getElementById('diagSellAdd').setAttribute('aria-expanded', 'false');
    const edit = editIndex >= 0 && document.querySelector('#diagSellList [data-index="' + editIndex + '"] .diag-sell-edit');
    (edit || document.getElementById('diagSellAdd')).focus();
    return;
  }
  _diagSellState.mode = mode;
  _diagSellState.editIndex = mode === 'edit' ? index : -1;
  document.getElementById('diagSellDialogTitle').textContent = { quiz: '从问卷同步', manual: '录入添加', file: '文件导入', edit: '编辑卖点' }[mode] || '你想用哪种方式新增卖点？';
  document.getElementById('diagSellMethods').hidden = mode !== 'choose';
  dialog.querySelectorAll('[data-sell-form]').forEach(function (el) { el.hidden = el.dataset.sellForm !== (mode === 'edit' ? 'manual' : mode); });
  if (mode === 'manual' || mode === 'edit') {
    const entry = mode === 'edit' ? _diagSellState.entries[index] : _diagState.sellDraft;
    document.getElementById('diagSellTitle').value = entry.title || '';
    document.getElementById('diagSellContent').value = entry.content || '';
    _diagState.sellImage = String(entry.image || '');
    diagSellImgPaint();
    document.getElementById('diagSellSubmit').textContent = '保存';
    diagSellMessage('diagSellFormMsg', '');
  }
  // 进哪一种方式就停在那一种（老板：选了方式之后不要再来一排「重新选择方式」，要换方式先关闭再点「新增卖点」）
  const foot = dialog.querySelector('.diag-sell-modal-foot');
  if (foot) foot.style.borderTop = (mode === 'manual' || mode === 'edit') ? '1px solid #eef1f5' : 'none';
  document.getElementById('diagSellSubmit').hidden = !(mode === 'manual' || mode === 'edit');
  document.getElementById('diagSellAdd').setAttribute('aria-expanded', 'true');
  if (!dialog.open) dialog.showModal();
  document.getElementById(mode === 'manual' || mode === 'edit' ? 'diagSellTitle' : mode === 'file' ? 'diagSellFileBtn' : mode === 'quiz' ? 'diagSellQuizRun' : 'diagSellDialogTitle').focus();
}
/* extra 可带 name / guideText：问卷整理出的产品信息跟卖点一次写盘 */
async function _diagSellWrite(entries, extra) {
  const cfg = await _diagGetCfg();
  cfg.product = cfg.product || {};
  cfg.product.sellPoints = entries;
  cfg.product.description = entries.map(function (s) { return s.title && s.content ? s.title + '：' + s.content : s.title || s.content || ''; }).join('\n');
  if (extra) {
    // 问卷整理出的产品名：只在「是个新叫法」时提到主名位，别名跟着留；已经填过这个叫法就不动
    if (extra.name && _diagProdNamesOf(cfg.product)[0] !== extra.name) {
      const list = _diagProdNamesOf(cfg.product);
      _diagProdSetNames(cfg, [extra.name].concat(list.filter(function (v) { return v !== extra.name; })).join('\n'));
    }
    // 引导去向只在用户还没填时补（别把「基础配置」里手填的承接悄悄改掉）
    if (extra.guideText && !String(cfg.product.guideText || '').trim()) cfg.product.guideText = extra.guideText;
  }
  await _diagSaveCfg(cfg);
}
async function diagSellSaveEntries(entries, success, messageId, extra) {
  if (_diagState.busy || _diagSellState.loading || !_diagSellState.loaded) return false;
  if (entries.length > 10) { diagSellMessage(messageId, '最多保留 10 条卖点，请减少条目后重试；本次未保存。', true); return false; }
  _diagState.busy = 'product-save'; diagSellLock();
  diagSellMessage(messageId, '正在保存…');
  try {
    await _diagSellWrite(entries, extra);
    _diagSellState.entries = entries;
    diagSellRender();
    diagSellMessage('diagSellMsg', success);
    diagSellRefreshSyncLine();
    return true;
  } catch (e) {
    diagSellMessage(messageId, '保存失败：' + (e.message || e) + '。输入已保留，可重试。', true);
    return false;
  } finally { _diagState.busy = ''; diagSellLock(); }
}
/* 录入表单的草稿（切到别的「新增方式」再回来不丢输入；编辑态不写草稿） */
function _diagSellDraftSync() {
  if (_diagSellState.mode !== 'manual') return;
  _diagState.sellDraft = {
    title: document.getElementById('diagSellTitle').value,
    content: document.getElementById('diagSellContent').value,
    image: _diagState.sellImage || ''
  };
}
async function diagSellSubmit() {
  const title = document.getElementById('diagSellTitle').value.trim(), content = document.getElementById('diagSellContent').value.trim();
  if (!title || !content) { diagSellMessage('diagSellFormMsg', '标题和内容不能为空，请补充后保存。', true); return; }
  const index = _diagSellState.editIndex;
  if (_diagSellState.entries.some(function (s, i) { return i !== index && String(s.title || '').trim() === title; })) {
    diagSellMessage('diagSellFormMsg', '已有同名卖点，请编辑原条目或换一个标题。', true); return;
  }
  const entries = _diagSellState.entries.slice();
  const image = String(_diagState.sellImage || '');
  if (index >= 0) entries[index] = Object.assign({}, entries[index], { title: title, content: content, image: image });
  else entries.push({ title: title, content: content, image: image });
  if (await diagSellSaveEntries(entries, index >= 0 ? '已保存卖点修改。' : '已新增并保存 1 条卖点。', 'diagSellFormMsg')) {
    if (index < 0) { _diagState.sellDraft = { title: '', content: '', image: '' }; _diagState.sellImage = ''; }
    diagSellDialog('');
  }
}
/* ── 产品卖点 ── */
function diagStepSell(body) {
  if (!body) return;
  _diagSellState = { entries: [], loading: false, loaded: false, mode: '', editIndex: -1 };
  _diagState.sellFiles = [];
  body.innerHTML = '<style>' +
    '#diagStepBody .diag-sell-note{font-size:12px;color:#777;line-height:1.7;margin:6px 0;overflow-wrap:anywhere}' +
    '#diagSellList{overflow-x:auto;border:1px solid #e7eaf0;border-radius:10px;margin:8px 0}' +
    '#diagSellList table{width:100%;min-width:620px;table-layout:fixed;border-collapse:collapse;font-size:12px}' +
    '#diagSellList th,#diagSellList td{box-sizing:border-box;padding:11px 12px;text-align:left;vertical-align:top;overflow-wrap:anywhere;border-bottom:1px solid #e7eaf0}' +
    '#diagSellList thead{background:#f5f7fa;color:#667085}#diagSellList .diag-sell-actions{display:flex;gap:6px;flex-wrap:wrap}' +
    '#diagSellList .diag-sell-actions .btn{min-height:28px;padding:4px 8px}#diagSellList .diag-sell-delete{color:#c62828}' +
    '#diagSellList .diag-sell-detail{background:#f8fafd}#diagSellList .diag-sell-full{white-space:pre-wrap;line-height:1.7;overflow-wrap:anywhere}' +
    '#diagSellDialog [hidden],#diagSellDialog:not([open]){display:none}' +
    '#diagSellDialog{box-sizing:border-box;width:min(620px,calc(100vw - 32px));max-height:calc(100vh - 48px);margin:auto;padding:0;overflow:auto;overscroll-behavior:contain;background:#fff;color:#333;border:1px solid #dfe6f0;border-radius:14px;box-shadow:0 20px 70px rgba(15,23,42,.25)}' +
    '#diagSellDialog::backdrop{background:rgba(15,23,42,.42)}' +
    '#diagSellDialog .diag-sell-modal-head{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 20px;border-bottom:1px solid #e7eaf0;background:#fff}' +
    '#diagSellDialog .diag-sell-modal-body{padding:16px 20px 20px}#diagSellDialog input,#diagSellDialog textarea{width:100%;box-sizing:border-box;margin:4px 0 10px}' +
    '#diagSellMethods .btn{display:block;width:100%;text-align:left;margin-top:8px;padding:12px}#diagSellMethods span{display:block;font-size:12px;color:#777;font-weight:400;margin-top:4px}' +
    '#diagSellDialog .diag-sell-modal-foot{display:flex;gap:8px;justify-content:flex-end;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid #eef1f5}' +
    '#diagSellDialog .diag-sell-modal-foot [hidden],#diagSellDialog .diag-sell-modal-foot button[hidden]{display:none}' +
    '</style>' + _diagCard(
    '<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">' +
    _diagStepTitle('产品卖点') +
    '<button type="button" id="diagSellAdd" class="btn btn-primary" style="margin:0;" aria-haspopup="dialog" aria-expanded="false" aria-controls="diagSellDialog">新增卖点</button></div>' +
    '<div id="diagSellSyncLine" style="margin:6px 0 8px;">' + _diagSyncLine('product', DIAG_SELL_EMPTY) + '</div>' +
    '<div>' +
      '<div id="diagSellStats" class="diag-sell-note"></div>' +
      '<div style="display:flex;gap:8px;align-items:center;"><input id="diagSellSearch" type="search" aria-label="搜索卖点" placeholder="搜索卖点标题或内容" style="flex:1;min-width:0;box-sizing:border-box;"><button type="button" id="diagSellRefresh" class="btn btn-outline">刷新列表</button></div>' +
      '<div id="diagSellList"></div><div id="diagSellMsg" class="diag-sell-note" role="status"></div>' +
      '<dialog id="diagSellDialog" aria-labelledby="diagSellDialogTitle"><div class="diag-sell-modal-head"><h3 id="diagSellDialogTitle" tabindex="-1" style="font-size:15px;margin:0;">你想用哪种方式新增卖点？</h3></div><div class="diag-sell-modal-body">' +
      '<div id="diagSellMethods"><button type="button" class="btn btn-outline" data-sell-method="quiz"><b>从问卷同步</b><span>按问卷的内容重新提炼卖点，同标题更新、其他保留</span></button>' +
      '<button type="button" class="btn btn-outline" data-sell-method="file"><b>文件导入</b><span>一次丢一批 Word / Excel / TXT / JSON 文件，系统整理成卖点</span></button>' +
      '<button type="button" class="btn btn-outline" data-sell-method="manual"><b>录入添加</b><span>手动填写一条卖点的标题和内容</span></button></div>' +
      '<div data-sell-form="quiz" hidden><div class="diag-sell-note">拿问卷的内容重新提炼一遍卖点：同标题更新、新卖点追加 <span class="qhelp r" tabindex="0" data-tip="手工加的条目原样保留；合并后最多 10 条。">?</span></div>' +
      _dBtn('diagSellQuizRun', '开始同步') + '<div id="diagSellQuizMsg" role="status" class="diag-sell-note"></div></div>' +
      '<div data-sell-form="file" hidden><div class="diag-sell-note">Word / Excel / TXT / MD / CSV 由 AI 提炼成卖点，JSON 按卖点结构直接导入，同标题更新 <span class="qhelp r" tabindex="0" data-tip="一次最多 20 个，单个最大 2MB；其他卖点保留，合并后最多 10 条。旧版 .doc / .xls 请先另存为 .docx / .xlsx。">?</span></div>' +
      _dBtn('diagSellFileBtn', '选择文件（可多选）', '', 'btn-outline') + '<input type="file" id="diagSellFile" multiple accept=".docx,.xlsx,.json,.txt,.md,.markdown,.csv,.log,.text,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json,text/plain,text/markdown,text/csv" style="display:none;">' +
      _dBtn('diagSellFileImport', '开始导入所选文件') + '<div id="diagSellFileName" class="diag-sell-note"></div><div id="diagSellFMsg" role="status" class="diag-sell-note"></div></div>' +
      '<div data-sell-form="manual" hidden><label for="diagSellTitle">卖点标题</label><input id="diagSellTitle" class="diagSellTitle" type="text" maxlength="40" placeholder="例如：提供试用体验">' +
      '<label for="diagSellContent">卖点内容</label><textarea id="diagSellContent" class="diagSellContent" rows="6" placeholder="说明具体优势、适用情况或服务内容"></textarea>' +
      '<div style="font-size:12px;color:#333;margin-bottom:4px;">配图（可选）<span style="color:#999;font-size:11px;">发笔记时可直接当素材用</span></div>' +
      '<div style="display:flex;align-items:center;gap:8px;margin:4px 0 10px;flex-wrap:wrap;">' +
      '<button type="button" id="diagSellImgPick" class="btn btn-outline">选择图片</button>' +
      '<img id="diagSellImgPrev" alt="卖点配图预览" style="display:none;max-height:60px;max-width:140px;object-fit:cover;border-radius:6px;border:1px solid #e7eaf0;">' +
      '<button type="button" id="diagSellImgClear" class="btn btn-outline" style="display:none;">清除配图</button></div>' +
      '<input type="file" id="diagSellImgFile" accept="image/*" style="display:none;">' +
      '<div id="diagSellFormMsg" class="diag-sell-note" role="status"></div></div>' +
      '<div class="diag-sell-modal-foot"><button type="button" id="diagSellClose" class="btn btn-outline" aria-label="关闭卖点弹窗">关闭</button>' +
      '<button type="button" id="diagSellSubmit" class="btn btn-primary" hidden>保存</button></div></dialog>' +
    '</div>'
  );
  document.getElementById('diagSellFileBtn').onclick = function () {
    if (_diagState.busy) return;
    const input = document.getElementById('diagSellFile'); input.value = ''; input.click();
  };
  document.getElementById('diagSellFile').onchange = function (e) {
    _diagState.sellFiles = Array.prototype.slice.call(e.target.files || []);
    _diagSellFileName();
    if (_diagState.sellFiles.length) diagSellMessage('diagSellFMsg', '已选择 ' + _diagState.sellFiles.length + ' 个文件，点击“开始导入所选文件”逐个整理成卖点。');
  };
  document.getElementById('diagSellFileImport').onclick = diagSellImportFile;
  document.getElementById('diagSellQuizRun').onclick = diagSellSyncFromQuiz;
  document.getElementById('diagSellImgPick').onclick = function () {
    if (_diagState.busy) return;
    const input = document.getElementById('diagSellImgFile'); input.value = ''; input.click();
  };
  document.getElementById('diagSellImgFile').onchange = function (e) {
    const file = (e.target.files || [])[0];
    if (!file) return;
    if (!/^image\//.test(file.type || '')) { diagSellMessage('diagSellFormMsg', '请选择 JPG / PNG 等图片文件。', true); return; }
    if (file.size > 2 * 1024 * 1024) { diagSellMessage('diagSellFormMsg', '图片超过 2MB，请压缩后重试。', true); return; }
    const reader = new FileReader();
    reader.onload = function () {
      _diagState.sellImage = String(reader.result || '');
      _diagSellDraftSync();
      diagSellImgPaint();
      diagSellMessage('diagSellFormMsg', '');
    };
    reader.onerror = function () { diagSellMessage('diagSellFormMsg', '图片读取出错，请换一张重试。', true); };
    reader.readAsDataURL(file);
  };
  document.getElementById('diagSellImgClear').onclick = function () {
    if (_diagState.busy) return;
    _diagState.sellImage = '';
    _diagSellDraftSync();
    diagSellImgPaint();
  };
  document.getElementById('diagSellAdd').onclick = function () { diagSellDialog('choose'); };
  document.getElementById('diagSellClose').onclick = function () { diagSellDialog(''); };
  document.getElementById('diagSellSubmit').onclick = diagSellSubmit;
  document.getElementById('diagSellSearch').oninput = diagSellRender;
  document.getElementById('diagSellRefresh').onclick = function () { diagProdPrefill(true); };
  body.querySelectorAll('[data-sell-method]').forEach(function (el) { el.onclick = function () { diagSellDialog(el.dataset.sellMethod); }; });
  ['diagSellTitle', 'diagSellContent'].forEach(function (id) {
    document.getElementById(id).oninput = function () { _diagSellDraftSync(); };
  });
  const dialog = document.getElementById('diagSellDialog');
  dialog.oncancel = function (e) { e.preventDefault(); diagSellDialog(''); };
  dialog.onclick = function (e) {
    if (e.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) diagSellDialog('');
  };
  _diagSellFileName();
  diagProdPrefill();
}
/* JSON 卖点文件：title/name + content/desc，可选 image（Base64） */
function _diagSellParseItems(text) {
  let parsed;
  try { parsed = JSON.parse(text); } catch (_) { throw new Error('JSON 解析失败，请检查括号、引号和逗号'); }
  if (!Array.isArray(parsed)) throw new Error('JSON 必须是卖点数组');
  const items = parsed.map(function (s) {
    const entry = { title: s && (s.title || s.name), content: s && (s.content || s.desc) };
    if (s && Object.prototype.hasOwnProperty.call(s, 'image')) entry.image = s.image;
    return entry;
  });
  if (!items.length) throw new Error('没解析到有效卖点');
  return items.map(function (s) {
    if (typeof s.title !== 'string' || !s.title.trim() || typeof s.content !== 'string' || !s.content.trim()) throw new Error('每条卖点都需要文字标题和内容');
    const entry = { title: s.title.trim(), content: s.content.trim() };
    if (Object.prototype.hasOwnProperty.call(s, 'image')) {
      if (typeof s.image !== 'string' || (s.image && !/^data:image\/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]+={0,2}$/.test(s.image))) throw new Error('配图须为 PNG、JPEG、WebP 或 GIF 的 Base64 图片');
      entry.image = s.image;
    }
    return entry;
  });
}
/* 同标题更新、其他保留；原条目的 id / 配图不会被覆盖掉 */
function _diagSellMerge(entries, items) {
  let added = 0, updated = 0;
  items.forEach(function (s) {
    const index = entries.findIndex(function (e) { return String(e.title || '').trim() === s.title; });
    if (index < 0) { entries.push(Object.assign({ image: '' }, s)); added++; }
    else { entries[index] = Object.assign({}, entries[index], s); updated++; }
  });
  return { added: added, updated: updated };
}
function _diagSellFileName() {
  const el = document.getElementById('diagSellFileName'), files = _diagState.sellFiles || [];
  if (el) el.textContent = files.length ? '已选择 ' + files.length + ' 个文件：' + files.map(function (f) { return f.name + '（' + f.size + ' 字节）'; }).join('、') : '尚未选择文件';
}
async function diagSellImportFile() {
  if (_diagState.busy || _diagSellState.loading) return;
  const files = (_diagState.sellFiles || []).slice();
  if (!files.length) { diagSellMessage('diagSellFMsg', '请先选择要导入的文件，一次可选多个。', true); return; }
  if (files.length > 20) { diagSellMessage('diagSellFMsg', '一次最多导入 20 个文件（当前 ' + files.length + ' 个），请分批处理。', true); return; }
  if (!_diagSellState.loaded) { diagSellMessage('diagSellFMsg', '卖点还没读取完，请稍后再试。', true); return; }
  _diagState.busy = 'sell-file'; diagSellLock();
  const failures = [], done = [], entries = _diagSellState.entries.slice();
  let added = 0, updated = 0, saved = true;
  try {
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      _diagState.sellFileLabel = '正在处理 ' + (i + 1) + '/' + files.length + '…';
      diagSellLock();
      diagSellMessage('diagSellFMsg', '正在处理第 ' + (i + 1) + '/' + files.length + ' 个文件：' + file.name + '…');
      const snapshot = entries.slice();
      try {
        if (file.size > 2 * 1024 * 1024) throw new Error('超过 2MB，请拆分后重试');
        let text = '';
        const kind = (typeof KbFile !== 'undefined') ? KbFile.kindOf(file.name) : 'text';
        if (kind === 'docx' || kind === 'xlsx') {
          // Word / Excel 在本机解包抽文字，原文件不上传；抽不出文字时由 KbFile 抛错
          text = (await KbFile.extract(file)).text;
        } else {
          if (kind === 'legacy') throw new Error('旧版 Office 格式读不了，请在 Word / Excel / WPS 里另存为 .docx / .xlsx 或 TXT 后重试');
          text = (await file.text()).replace(/^\uFEFF/, '');
          if (!text.trim()) throw new Error('文件为空');
          if (typeof CryptoBox !== 'undefined' && CryptoBox.isFileEnvelope(text)) throw new Error('这是加密的备份文件，卖点用不了，请另存为普通 JSON / TXT 后重试');
          if (text.indexOf('\u0000') >= 0) throw new Error('看起来不是文本文件，请另存为 TXT / MD / CSV，或把 Word / Excel 另存为 .docx / .xlsx');
        }
        let items;
        if (kind === 'json' || /^[\[{]/.test(text.trim())) {
          items = _diagSellParseItems(text);
        } else {
          const built = await _diagSay('aiSellPointBuild', { answers: [{ q: '产品资料文件：' + file.name, answer: text }], existing: entries.slice(0, 10) });
          if (!built || !built.ok) throw new Error((built && built.error) || '整理失败');
          items = (built.sellPoints || []).map(function (s) { return { title: String((s && s.title) || '').trim(), content: String((s && s.content) || '').trim() }; }).filter(function (s) { return s.title && s.content; });
          if (!items.length) throw new Error('AI 没整理出卖点，请在文件里写清产品优势或换一个文件');
        }
        const merged = _diagSellMerge(entries, items);
        if (entries.length > 10) throw new Error('合并后共 ' + entries.length + ' 条，超过 10 条上限，请先精简现有卖点');
        added += merged.added; updated += merged.updated;
        done.push(file.name);
      } catch (e) {
        entries.length = 0; Array.prototype.push.apply(entries, snapshot);
        failures.push({ file: file, why: e.message || String(e) });
      }
    }
    const summary = failures.length
      ? '处理完成，共 ' + files.length + ' 个文件：成功 ' + done.length + ' 个（新增 ' + added + ' 条，更新 ' + updated + ' 条' + (done.length ? '，' + done.join('、') : '') + '）；失败 ' + failures.length + ' 个：' + failures.map(function (f) { return f.file.name + '：' + f.why; }).join('；') + '。失败文件仍保留在列表，修正后可重新导入。'
      : '已导入 ' + files.length + ' 个文件：新增 ' + added + ' 条，更新 ' + updated + ' 条，其他卖点保留。';
    if (done.length) {
      _diagState.busy = '';
      saved = await diagSellSaveEntries(entries, summary, 'diagSellFMsg');
      // 摘要要留在弹窗里（保存失败时保留原有的失败原因）。
      if (saved) diagSellMessage('diagSellFMsg', summary, failures.length > 0);
    } else {
      diagSellMessage('diagSellFMsg', summary, true);
    }
  } finally {
    // 没写进库的话全部文件都留着重试，避免处理成功却被丢掉。
    _diagState.sellFiles = saved ? failures.map(function (f) { return f.file; }) : files;
    _diagState.sellFileLabel = '';
    _diagSellFileName();
    _diagState.busy = ''; diagSellLock();
    const panel = document.getElementById('diagSellDialog');
    if (panel && panel.open) document.getElementById('diagSellFileImport').focus();
  }
}
/* 「新增卖点 › 从问卷同步」：拿问卷答案重提炼卖点——同标题更新、新标题追加、其余手工条目保留（与文件导入同一口径） */
async function diagSellSyncFromQuiz() {
  if (_diagState.busy || _diagSellState.loading || !_diagSellState.loaded) return;
  const btn = document.getElementById('diagSellQuizRun'); const msg = document.getElementById('diagSellQuizMsg');
  const answers = _diagQuizAnswers();
  if (!answers) { _diagSyncNoQuiz(msg, '还没填过问卷——先去左栏「问卷」答完提交；也可以改用「文件导入」或「录入添加」自己写。'); return; }
  _diagState.busy = 'node-sync'; diagSellLock(); _diagPaintNav();
  if (msg) { msg.style.color = '#555'; msg.textContent = '正在按问卷重新提炼卖点…'; }
  let entries = null, extra = null, skipped = 0, stat = null;
  try {
    const r = await _diagSay('aiSellPointBuild', { answers: answers, existing: _diagSellState.entries.slice(0, 10) });
    if (!r || !r.ok || !Array.isArray(r.sellPoints) || !r.sellPoints.length) throw new Error((r && r.error) || 'AI 未返回卖点');
    entries = _diagSellState.entries.slice();
    stat = _diagSellMerge(entries, r.sellPoints);
    if (entries.length > 10) { skipped = entries.length - 10; entries.length = 10; }
    extra = { name: r.productName, guideText: r.guideText };
  } catch (e) {
    _diagState.busy = ''; diagSellLock(); _diagPaintNav(); if (btn) btn.disabled = false;
    if (msg) { msg.style.color = '#c62828'; msg.textContent = '❌ ' + (e.message || e) + '。可稍后重试，或改用「录入添加」自己写。'; }
    return;
  }
  _diagState.busy = '';   // 交给 diagSellSaveEntries 走标准写盘（它自己管锁与上限）
  const success = '✅ 已按问卷同步：新增 ' + stat.added + ' 条、更新 ' + stat.updated + ' 条' +
    (skipped ? '；超出 10 条上限的 ' + skipped + ' 条未写入，请先删几条' : '') + '。';
  const okSaved = await diagSellSaveEntries(entries, success, 'diagSellQuizMsg', extra);
  if (okSaved) {
    await _diagMarkNode('product', '已从问卷重新提炼');
    diagSellRefreshSyncLine();
    _diagPaintNav();   // 卖点完成态跟着变
    diagSellDialog('');                             // 同步完收起弹窗，回到表格看结果
    diagSellMessage('diagSellQuizMsg', '');
    diagSellMessage('diagSellMsg', success);
  }
  if (btn) btn.disabled = false;
}
function diagSellRefreshSyncLine() {
  const box = document.getElementById('diagSellSyncLine');
  if (!box) return;
  const result = ((_diagState.diagnosis && _diagState.diagnosis.results) || {}).product;
  const n = _diagSellState.entries.length;
  const tail = n ? ('卖点 ' + n + '/10 条') : '';
  box.innerHTML = _diagSyncLine('product', DIAG_SELL_EMPTY, tail);
}
async function diagProdPrefill(listOnly) {
  if (_diagState.busy || _diagSellState.loading) return;
  const list = document.getElementById('diagSellList'); if (!list) return;
  const state = _diagSellState;
  state.loading = true; diagSellRender();
  diagSellMessage('diagSellMsg', '正在读取…');
  try {
    const cfg = await _diagGetCfg(); const p = cfg.product || {};
    if (document.getElementById('diagSellList') !== list) return;
    state.entries = (p.sellPoints || []).filter(function (s) { return s && (s.title || s.content); });
    state.loaded = true;
    diagSellMessage('diagSellMsg', '');
    diagSellRefreshSyncLine();
  } catch (e) {
    if (document.getElementById('diagSellList') === list) diagSellMessage('diagSellMsg', '读取失败：' + (e.message || e) + '。请刷新列表重试。', true);
  } finally {
    state.loading = false;
    if (document.getElementById('diagSellList') === list) diagSellRender();
  }
}

/* ── 知识库 ── */
function diagStepKb(body) {
  if (!body) return;
  body.innerHTML = '<style>#diagStepBody .diag-kb-note{font-size:12px;color:#777;line-height:1.7;margin:5px 0;overflow-wrap:anywhere}#diagStepBody .diag-kb-full{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;line-height:1.7}#diagStepBody .diag-kb-edit input:not([type=checkbox]),#diagStepBody .diag-kb-edit textarea{width:100%;box-sizing:border-box;margin:4px 0 8px}#diagKList{overflow-x:auto;border:1px solid #e7eaf0;border-radius:10px}#diagKList table{width:100%;min-width:620px;table-layout:fixed;border-collapse:collapse;font-size:12px}#diagKList th,#diagKList td{box-sizing:border-box;padding:11px 12px;text-align:left;vertical-align:top;overflow-wrap:anywhere;border-bottom:1px solid #e7eaf0}#diagKList thead{background:#f5f7fa;color:#667085}#diagKList tbody:last-child tr:last-child td{border-bottom:0}#diagKList .diag-kb-row:hover{background:#fafbfe}#diagKList .diag-kb-actions{display:flex;gap:6px;flex-wrap:wrap}#diagKList .diag-kb-actions .btn{min-height:28px;padding:4px 8px}#diagKList .diag-kb-detail{background:#f8fafd}#diagKList .diag-kb-status{display:inline-block;padding:3px 7px;border-radius:5px;background:#e7f6ef;color:#087451;white-space:nowrap}#diagKList .diag-kb-status.off{background:#f0f1f4;color:#727885}#diagKAddPanel [hidden],#diagKAddPanel:not([open]),#diagKEditPanel [hidden],#diagKEditPanel:not([open]){display:none}#diagKAddPanel,#diagKEditPanel{box-sizing:border-box;width:min(620px,calc(100vw - 32px));max-height:calc(100vh - 48px);margin:auto;padding:0;overflow:auto;overscroll-behavior:contain;background:#fff;color:#333;border:1px solid #dfe6f0;border-radius:14px;box-shadow:0 20px 70px rgba(15,23,42,.25)}#diagKAddPanel::backdrop,#diagKEditPanel::backdrop{background:rgba(15,23,42,.42)}#diagKAddPanel .diag-kb-modal-head,#diagKEditPanel .diag-kb-modal-head{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid #e7eaf0;background:#fff}#diagKAddPanel .diag-kb-modal-content,#diagKEditPanel .diag-kb-modal-content{padding:16px 20px 20px}#diagKEditPanel .diag-kb-modal-foot{display:flex;gap:8px;justify-content:flex-end;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid #eef1f5}#diagKEditPanel .diag-kb-modal-content>label{display:block;font-weight:600;font-size:12px;color:#4b5563;margin:10px 0 3px}#diagKEditPanel .diag-kb-modal-content>input:not([type=checkbox]),#diagKEditPanel .diag-kb-modal-content>textarea{display:block;width:100%;box-sizing:border-box;margin:0;padding:7px 9px;border:1px solid #dfe6f0;border-radius:8px;font-size:13px;font-family:inherit}#diagStepBody .diag-kb-pick{position:relative;display:inline-flex;flex:none}#diagStepBody .diag-kb-pick #diagKBackupBtn{border-top-right-radius:0;border-bottom-right-radius:0;margin-right:0}#diagStepBody .diag-kb-pick #diagKBkMenuBtn{border-top-left-radius:0;border-bottom-left-radius:0;margin-left:-1px;padding:7px 9px}#diagKBkPop{position:absolute;right:0;top:36px;z-index:40;min-width:210px;background:#fff;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 10px 26px rgba(16,24,40,.14);padding:8px;text-align:left}#diagKBkPop .btn{display:block;width:100%;text-align:left;margin:0 0 6px;font-size:12px;padding:8px 10px}#diagKBkPop .btn:last-child{margin-bottom:0}#diagKBkPop .diag-kb-pop-hint{font-size:11px;color:#98a2b3;line-height:1.6;margin:2px 0 8px}#diagKMethods .btn{display:block;width:100%;text-align:left;margin-top:8px;padding:12px}#diagKMethods .btn span{display:block;margin-top:4px;font-size:12px;color:#777;font-weight:400}#diagStepBody .diag-kb-img-prev{max-width:180px;max-height:130px;border:1px solid #e7eaf0;border-radius:6px;display:block;margin:2px 0 6px}#diagStepBody .diag-kb-img-wrap[hidden]{display:none}</style>' +
    _diagCard('<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">' +
      _diagStepTitle('知识库') + '<div style="display:flex;gap:8px;align-items:center;">' +
      '<button type="button" id="diagKAddBtn" class="btn btn-primary" style="margin:0;" aria-expanded="false" aria-controls="diagKAddPanel">新增知识</button>' +
      '<span class="diag-kb-pick">' +
        '<button type="button" id="diagKBackupBtn" class="btn btn-outline" style="margin:0;" title="点一下直接导出本产品的备份文件（问卷、人设、卖点、知识库、规划；不含 AI Key）">📦 备份</button>' +
        '<button type="button" id="diagKBkMenuBtn" class="btn btn-outline" style="margin:0;" aria-haspopup="true" aria-expanded="false" aria-controls="diagKBkPop" title="备份的其他操作">▾</button>' +
        '<div id="diagKBkPop" hidden>' +
          '<div class="diag-kb-pop-hint">范围＝当前这一个产品；要连 AI Key、全部产品、获客/私信历史一起搬，用弹窗左栏「🛡️ 整机备份 / 恢复」。</div>' +
          '<button type="button" class="btn btn-outline" data-bk="merge">📥 导入备份（合并）</button>' +
          '<button type="button" class="btn btn-outline" data-bk="replace">📥 导入备份（覆盖）</button>' +
          '<button type="button" class="btn btn-outline" data-bk="kb">📤 只导出知识库</button>' +
          '<button type="button" class="btn btn-outline" data-bk="clear">🗑 清空知识库</button>' +
        '</div>' +
      '</span>' +
      '<input type="file" id="diagKBackupFile" accept=".json,application/json" style="display:none;"></div></div>' +
      '<dialog id="diagKAddPanel" aria-labelledby="diagKAddTitle">' +
      '<div class="diag-kb-modal-head"><h3 id="diagKAddTitle" tabindex="-1" style="font-size:15px;margin:0;">你想用哪种方式新增知识？</h3>' +
      '<button type="button" id="diagKAddCancel" class="btn btn-outline" aria-label="关闭新增知识弹窗">关闭</button></div>' +
      '<div class="diag-kb-modal-content"><div id="diagKMethods">' +
        '<button type="button" class="btn btn-outline" data-kb-method="text"><b>随意输入，AI 整理</b><span>直接输入或粘贴经验、聊天记录、产品说明</span></button>' +
        '<button type="button" class="btn btn-outline" data-kb-method="file"><b>文件导入</b><span>一次丢一批 Word / Excel / TXT / MD / CSV 文件，系统整理后入库</span></button>' +
      '</div>' +
      '<div data-kb-form="text" hidden>' +
      '<div class="diag-kb-note">经验、聊天记录、价格、产品说明都可以直接粘贴 <span class="qhelp r" tabindex="0" data-tip="不要求标题格式；AI 提炼后追加入库，原文保留供核对。">?</span></div>' +
      '<textarea id="diagKImp" rows="5" aria-label="知识素材" placeholder="把手头的经验、客户问答、价格或产品说明粘贴到这里…" style="width:100%;box-sizing:border-box;">' + _dEsc(_diagState.kbDraft) + '</textarea>' +
      _dBtn('diagKImport', 'AI整理并入库') + '<div id="diagKIMsg" role="status" class="diag-kb-note"></div></div>' +
      '<div data-kb-form="file" hidden>' +
      '<div class="diag-kb-note">Word / Excel / TXT / MD / CSV 等由 AI 提炼入库，JSON 按知识条目直接导入，同标题更新 <span class="qhelp r" tabindex="0" data-tip="一次最多 20 个，单个最大 2MB；其他知识保留，不覆盖全库。旧版 .doc / .xls 请先另存为 .docx / .xlsx；加密备份文件请用旁边「📦 备份 ▾」里的「导入备份」恢复。">?</span></div>' +
      _dBtn('diagKFileBtn', '选择文件（可多选）', '', 'btn-outline') + '<input type="file" id="diagKFile" multiple accept=".docx,.xlsx,.json,.txt,.md,.markdown,.csv,.log,.text,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json,text/plain,text/markdown,text/csv" style="display:none;">' +
      _dBtn('diagKFileImport', '开始导入所选文件') + '<div id="diagKFileName" class="diag-kb-note"></div><div id="diagKFMsg" role="status" class="diag-kb-note"></div></div>' +
      '</div></dialog>' +
      '<div id="diagKSyncLine">' + _diagSyncLine('knowledge', '') + '</div>' +
      '<div id="diagKStats" class="diag-kb-note">正在读取…</div>' +
      '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;"><input id="diagKSearch" type="search" aria-label="搜索知识库" placeholder="搜索标题、内容、分类或标签" style="flex:1;min-width:140px;box-sizing:border-box;" value="' + _dEsc(_diagState.kbSearch) + '">' +
      '<select id="diagKFilterCat" aria-label="按分类筛选" style="width:auto;font-size:12px;padding:5px 8px;"><option value="">全部分类</option></select>' +
      '<select id="diagKFilterStatus" aria-label="按状态筛选" style="width:auto;font-size:12px;padding:5px 8px;"><option value="">全部状态</option><option value="on">启用中</option><option value="off">已停用</option></select>' +
      '<button type="button" id="diagKRefresh" class="btn btn-outline">刷新列表</button></div>' +
      '<div id="diagKListMsg" role="status" class="diag-kb-note"></div><div id="diagKList"></div>' +
      '<div id="diagKHistory" class="diag-kb-note" aria-live="polite"></div>' +
      /* 编辑知识：弹窗改（老板：「列表的编辑按钮做成弹出窗口好了，别在原列表进行修改，太奇怪了」） */
      '<dialog id="diagKEditPanel" aria-labelledby="diagKEditTitle">' +
      '<div class="diag-kb-modal-head"><h3 id="diagKEditTitle" tabindex="-1" style="font-size:15px;margin:0;">编辑知识</h3></div>' +
      '<div class="diag-kb-modal-content">' +
      '<label for="diagKEditTitleIn">标题</label><input id="diagKEditTitleIn" class="diag-kb-title" type="text" maxlength="80">' +
      '<label for="diagKEditContent">正文</label><textarea id="diagKEditContent" class="diag-kb-content" rows="8"></textarea>' +
      '<label for="diagKEditCat">分类</label><input id="diagKEditCat" class="diag-kb-category" list="diagKCatList">' +
      '<label for="diagKEditRole">角色（可选，评论里出现该角色的关键词时优先引用这条）</label><input id="diagKEditRole" class="diag-kb-role" list="diagKRoleList">' +
      '<label for="diagKEditTags">标签（逗号分隔，也可用 JSON 数组保留标签原文）</label><input id="diagKEditTags" class="diag-kb-tags">' +
      '<div class="diag-kb-note">配图（可选，引用这条知识时随评论一起发出）</div>' +
      '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:4px 0 8px;">' +
      '<button type="button" id="diagKEditImgPick" class="btn btn-outline">选择图片</button>' +
      '<input type="file" id="diagKEditImgFile" class="diag-kb-image-file" accept="image/png,image/jpeg,image/webp" style="display:none;">' +
      '<div class="diag-kb-img-wrap" id="diagKEditImgWrap" hidden><img id="diagKEditImgPrev" class="diag-kb-img-prev" alt="配图预览">' +
      '<button type="button" id="diagKEditImgDel" class="btn btn-outline diag-kb-img-del">删除图片</button></div>' +
      '<label style="display:flex;align-items:center;gap:6px;"><input class="diag-kb-active" type="checkbox">启用</label></div>' +
      '<div id="diagKEditMsg" role="status" class="diag-kb-note"></div>' +
      '<div class="diag-kb-modal-foot">' +
      '<button type="button" id="diagKEditCancel" class="btn btn-outline" aria-label="关闭编辑弹窗">关闭</button>' +
      '<button type="button" id="diagKEditSave" class="btn btn-primary">保存</button></div></div></dialog>' +
      /* 分类 / 角色下拉：分类＝lib/ai-providers.js 的 KB_CATEGORIES；角色＝config.roleKeywords 的键（真正参与 AI 匹配的那几个） */
      '<datalist id="diagKCatList">' + KB_CATEGORIES.map(function (c) { return '<option value="' + _dEsc(c) + '"></option>'; }).join('') + '</datalist>' +
      '<datalist id="diagKRoleList"></datalist>');
  body.querySelector('#diagKAddBtn').onclick = function () { if (!_diagState.busy) diagKbAddView('choose', true); };
  body.querySelector('#diagKAddCancel').onclick = function () { if (!_diagState.busy) diagKbAddView('', true); };
  body.querySelectorAll('[data-kb-method]').forEach(function (el) { el.onclick = function () { if (!_diagState.busy) diagKbAddView(el.dataset.kbMethod, true); }; });
  const dialog = body.querySelector('#diagKAddPanel');
  dialog.oncancel = function (e) { e.preventDefault(); if (!_diagState.busy) diagKbAddView('', true); };
  dialog.onclick = function (e) {
    if (e.target !== dialog || _diagState.busy) return;
    const rect = dialog.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) diagKbAddView('', true);
  };
  body.querySelector('#diagKImp').oninput = function (e) { _diagState.kbDraft = e.target.value; };
  body.querySelector('#diagKImport').onclick = diagKbImport;
  body.querySelector('#diagKFileBtn').onclick = function () {
    if (_diagState.busy) return;
    const input = body.querySelector('#diagKFile'); input.value = ''; input.click();
  };
  body.querySelector('#diagKFile').onchange = function (e) {
    _diagState.kbFiles = Array.prototype.slice.call((e.target.files || []));
    _diagKbFileName();
    if (_diagState.kbFiles.length) _diagKbMessage('diagKFMsg', '已选择 ' + _diagState.kbFiles.length + ' 个文件，点击“开始导入所选文件”逐个整理入库。');
  };
  body.querySelector('#diagKFileImport').onclick = diagKbImportFile;
  // 「📦 备份」点一下就直接出文件；旁边 ▾ 才是导入 / 只搬知识库 / 清空（老板：备份与导入拆开，点了就做事，不要再开一页）
  body.querySelector('#diagKBackupBtn').onclick = function () { if (!_diagState.busy) diagKbExport(); };
  body.querySelector('#diagKBkMenuBtn').onclick = function () {
    const pop = body.querySelector('#diagKBkPop'); if (!pop) return;
    _diagKbPop(pop, pop.hidden);
  };
  body.querySelectorAll('#diagKBkPop [data-bk]').forEach(function (el) {
    el.onclick = function () {
      if (_diagState.busy) return;
      _diagKbPop(body.querySelector('#diagKBkPop'), false);
      const act = el.dataset.bk;
      if (act === 'kb') { diagKbOnlyExport(); return; }
      if (act === 'clear') { diagKbOnlyClear(); return; }
      _diagState.kbBackupMode = act;   // merge / replace：选完文件立刻导入
      const input = body.querySelector('#diagKBackupFile'); input.value = ''; input.click();
    };
  });
  document.addEventListener('click', function (e) {
    const pop = document.getElementById('diagKBkPop');
    if (!pop || pop.hidden) return;
    if (e.target.closest('#diagKBkPop') || e.target.closest('#diagKBkMenuBtn')) return;
    _diagKbPop(pop, false);
  });
  body.querySelector('#diagKBackupFile').onchange = function (e) {
    _diagState.kbBackupFile = (e.target.files && e.target.files[0]) || null;
    if (!_diagState.kbBackupFile) return;
    const mode = _diagState.kbBackupMode === 'replace' ? 'replace' : 'merge';
    _diagState.kbBackupMode = '';
    diagKbBackupImport(mode);
  };
  /* 编辑知识弹窗 */
  body.querySelector('#diagKEditCancel').onclick = function () { if (!_diagState.busy) diagKbEditClose(); };
  body.querySelector('#diagKEditSave').onclick = function () { if (!_diagState.busy) diagKbEditSave(); };
  body.querySelector('#diagKEditImgPick').onclick = function () {
    if (_diagState.busy) return;
    const input = body.querySelector('#diagKEditImgFile'); input.value = ''; input.click();
  };
  body.querySelector('#diagKEditImgFile').onchange = function (e) {
    const f = (e.target.files || [])[0];
    if (!f) return;
    if (!/^image\/(png|jpeg|webp)$/i.test(f.type || '')) { _diagKbMessage('diagKEditMsg', '配图只认 PNG / JPG / WebP。', true); e.target.value = ''; return; }
    const rd = new FileReader();
    rd.onload = function (ev) { _diagState.kbEditImage = String(ev.target.result || ''); _diagKbEditImgPaint(); _diagKbMessage('diagKEditMsg', ''); };
    rd.onerror = function () { _diagKbMessage('diagKEditMsg', '图片读取出错，请换一张重试。', true); };
    rd.readAsDataURL(f);
  };
  body.querySelector('#diagKEditImgDel').onclick = function () {
    if (_diagState.busy) return;
    _diagState.kbEditImage = '';
    const input = body.querySelector('#diagKEditImgFile'); if (input) input.value = '';
    _diagKbEditImgPaint();
  };
  const edPanel = body.querySelector('#diagKEditPanel');
  edPanel.oncancel = function (e) { e.preventDefault(); if (!_diagState.busy) diagKbEditClose(); };
  edPanel.onclick = function (e) {
    if (e.target !== edPanel || _diagState.busy) return;
    const rect = edPanel.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) diagKbEditClose();
  };
  body.querySelector('#diagKSearch').oninput = function (e) { _diagState.kbSearch = e.target.value; diagKbRenderList(); };
  body.querySelector('#diagKFilterCat').onchange = function (e) { _diagState.kbFilterCat = e.target.value; diagKbRenderList(); };
  body.querySelector('#diagKFilterStatus').onchange = function (e) { _diagState.kbFilterStatus = e.target.value; diagKbRenderList(); };
  body.querySelector('#diagKRefresh').onclick = function () { if (!_diagState.busy && !_diagState.kbLoading) diagKbRefresh(); };
  diagKbAddView(_diagState.busy ? _diagState.kbAddMode || '' : '');
  _diagKbFileName();
  _diagKbPop(body.querySelector('#diagKBkPop'), false);
  _diagKbRenderHistory();
  diagKbRefresh();
  diagKbLoadRoles();
  _diagKbLock();
}
function diagKbAddView(mode, focus) {
  _diagState.kbAddMode = mode;
  const panel = document.getElementById('diagKAddPanel');
  if (!panel) return;
  const add = document.getElementById('diagKAddBtn');
  add.setAttribute('aria-expanded', String(!!mode));
  document.getElementById('diagKMethods').hidden = mode !== 'choose';
  document.getElementById('diagKAddTitle').textContent = { text: '随意输入，AI 整理', file: '文件导入' }[mode] || '你想用哪种方式新增知识？';
  panel.querySelectorAll('[data-kb-form]').forEach(function (el) { el.hidden = el.dataset.kbForm !== mode; });
  if (mode && !panel.open) panel.showModal();
  else if (!mode && panel.open) panel.close();
  if (focus) {
    const id = mode === 'text' ? 'diagKImp' : mode === 'file' ? 'diagKFileBtn' : mode ? 'diagKAddTitle' : 'diagKAddBtn';
    document.getElementById(id).focus();
  }
}
/* 备份下拉：开合都收口在这一处（点外面也关） */
function _diagKbPop(pop, open) {
  if (!pop) return;
  pop.hidden = !open;
  const btn = document.getElementById('diagKBkMenuBtn');
  if (btn) btn.setAttribute('aria-expanded', String(!!open));
}
function _diagKbMessage(id, text, error) {
  const el = document.getElementById(id);
  if (el) { el.textContent = text; el.style.color = error ? '#c62828' : '#0a7b5a'; }
}
function _diagKbFileName() {
  const el = document.getElementById('diagKFileName'), files = _diagState.kbFiles || [];
  if (el) el.textContent = files.length ? '已选择 ' + files.length + ' 个文件：' + files.map(function (f) { return f.name + '（' + f.size + ' 字节）'; }).join('、') : '尚未选择文件';
}
// 角色下拉：选项＝config.roleKeywords 的键（只有这些角色名会参与 AI 的角色命中加分）。
// 走后台 getConfig 拿配置：那边已把 DEFAULT_CONFIG 深合并进来，弹窗里没有 storage.js 的默认表可用。
async function diagKbLoadRoles() {
  const dl = document.getElementById('diagKRoleList');
  if (!dl || dl.options.length) return;
  try {
    const r = await _diagSay('getConfig');
    const names = Object.keys((r && r.config && r.config.roleKeywords) || {});
    if (!names.length || !document.getElementById('diagKRoleList')) return;
    dl.innerHTML = names.map(function (n) { return '<option value="' + _dEsc(n) + '"></option>'; }).join('');
  } catch (_) {}
}
// 「只搬知识库」导出：文件里只有知识条目，导入走旁边「📦 备份 ▾」里的「导入备份」
async function diagKbOnlyExport() {
  if (_diagState.busy) return;
  if (typeof CryptoBox === 'undefined' || !CryptoBox.encryptFile) { _diagKbMessage('diagKListMsg', '当前版本不支持加密导出。', true); return; }
  _diagState.busy = 'kb-export'; _diagKbLock();
  _diagKbMessage('diagKListMsg', '正在读取知识库…');
  try {
    const r = await _diagSay('getKnowledgeBase');
    const entries = (r && r.ok && Array.isArray(r.entries)) ? r.entries : [];
    if (!entries.length) { _diagKbMessage('diagKListMsg', '知识库还是空的，没有可导出的条目。', true); return; }
    _diagKbMessage('diagKListMsg', '已读取 ' + entries.length + ' 条知识，请设置导出口令…');
    const pw = await CryptoBox.askPassword({ title: '设置导出口令', hint: '这份文件只装知识条目（角色 / 配图 / 标签一起走），导入时要用同一口令。', confirm: true, okText: '加密并导出' });
    if (!pw.ok) { _diagKbMessage('diagKListMsg', '已取消导出，知识库未改变。'); return; }
    const text = await CryptoBox.encryptFile(JSON.stringify(entries), pw.password);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
    a.download = 'knowledge_base_enc_' + Date.now() + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 10000);
    const summary = '已导出知识库 ' + entries.length + ' 条。换机器 / 换产品时用「📦 备份 ▾」里的「导入备份」：覆盖＝整库替换，合并＝按标题更新。';
    _diagKbMessage('diagKListMsg', summary);
    _diagKbRecord('知识库导出', summary);
  } catch (e) {
    const text = '导出失败：' + (e.message || e) + '。知识库未改变，可重试。';
    _diagKbMessage('diagKListMsg', text, true); _diagKbRecord('知识库导出', text, true);
  } finally {
    _diagState.busy = ''; _diagKbLock();
  }
}
async function diagKbOnlyClear() {
  if (_diagState.busy) return;
  const n = (_diagState.kbEntries || []).length;
  if (!n) { _diagKbMessage('diagKListMsg', '知识库已经是空的。', true); return; }
  if (!confirm('将清空当前产品的全部 ' + n + ' 条知识，不可撤销。\n\n建议先用「📤 只导出知识库」留一份。确定清空吗？')) { _diagKbMessage('diagKListMsg', '已取消清空，知识库未改变。'); return; }
  if (!confirm('再确认一次：真的要清空这 ' + n + ' 条知识吗？')) return;
  _diagState.busy = 'kb-clear'; _diagKbLock();
  _diagKbMessage('diagKListMsg', '正在清空知识库…');
  try {
    const r = await _diagSay('clearKnowledgeBase');
    if (!r || !r.ok) throw new Error((r && r.error) || '清空失败');
    const summary = '已清空知识库（原 ' + n + ' 条）。';
    _diagKbMessage('diagKListMsg', summary);
    _diagKbRecord('知识库清空', summary);
    await diagKbRefresh();
  } catch (e) {
    const text = '清空失败：' + (e.message || e) + '。知识库未改变，可重试。';
    _diagKbMessage('diagKListMsg', text, true); _diagKbRecord('知识库清空', text, true);
  } finally {
    _diagState.busy = ''; _diagKbLock();
  }
}
function _diagKbLock() {
  if (_diagStep !== 5) return;   // 节点 5＝知识库（popup.html #diagSubTabs 的 data-go）
  document.querySelectorAll('#diagBody button, #diagStepBody input, #diagStepBody textarea').forEach(function (el) { el.disabled = !!_diagState.busy; });
  document.querySelectorAll('#diagKRefresh, #diagKList button, #diagKList input, #diagKList textarea').forEach(function (el) { el.disabled = !!(_diagState.busy || _diagState.kbLoading); });
  const textBtn = document.getElementById('diagKImport'), fileBtn = document.getElementById('diagKFileImport');
  if (textBtn) textBtn.textContent = _diagState.busy === 'kb-text' ? '正在 AI 整理并入库…' : 'AI整理并入库';
  if (fileBtn) fileBtn.textContent = _diagState.busy === 'kb-file' ? (_diagState.kbFileLabel || '正在处理文件…') : '开始导入所选文件';
}
function _diagKbRecord(source, text, error) {
  _diagState.kbHistory.unshift({ source: source, text: text, error: !!error, at: Date.now() });
  _diagKbRenderHistory();
}
function _diagKbRenderHistory() {
  const box = document.getElementById('diagKHistory');
  if (box) box.innerHTML = _diagState.kbHistory.length ? '<details><summary>本次录入记录（' + _diagState.kbHistory.length + '）</summary>' + _diagState.kbHistory.map(function (row) {
    return '<div style="margin-top:5px;color:' + (row.error ? '#c62828' : '#555') + ';">' + _dEsc(new Date(row.at).toLocaleTimeString() + ' · ' + row.source + '：' + row.text) + '</div>';
  }).join('') + '</details>' : '';
}
function _diagKbResult(r) {
  return '新增 ' + (Number(r.added) || 0) + ' 条，更新 ' + (Number(r.updated) || 0) + ' 条，跳过 ' + (Number(r.skipped) || 0) + ' 条。' +
    ((Number(r.skipped) || 0) > 0 ? '跳过的是已存在且内容未变化的条目，其他知识均保留。' : '已保留其他知识，关闭弹窗后可在表格中核对整理结果。');
}
async function diagKbImport() {
  if (_diagState.busy) return;
  const input = document.getElementById('diagKImp');
  _diagState.kbDraft = input ? input.value : _diagState.kbDraft;
  if (!_diagState.kbDraft.trim()) { _diagKbMessage('diagKIMsg', '请先粘贴经验、聊天记录或产品说明等原料。', true); return; }
  _diagState.busy = 'kb-text'; _diagKbLock();
  _diagKbMessage('diagKIMsg', '正在整理全部原文并入库，请稍候…');
  try {
    const r = await _diagSay('aiKbImport', { text: _diagState.kbDraft });
    if (!r || !r.ok) throw new Error((r && r.error) || 'AI 整理失败');
    const result = _diagKbResult(r);
    _diagKbMessage('diagKIMsg', result + ' 原文未清空。');
    _diagKbRecord('粘贴粗料 / AI 整理', result);
    await diagKbRefresh();
  } catch (e) {
    const text = '整理失败：' + (e.message || e) + '。原文已保留，请检查 AI 配置或调整原料后重试。';
    _diagKbMessage('diagKIMsg', text, true); _diagKbRecord('粘贴粗料 / AI 整理', text, true);
  } finally { _diagState.busy = ''; _diagKbLock(); }
}
async function diagKbImportFile() {
  if (_diagState.busy) return;
  const files = (_diagState.kbFiles || []).slice();
  if (!files.length) { _diagKbMessage('diagKFMsg', '请先选择要导入的文件，一次可选多个。', true); return; }
  if (files.length > 20) { _diagKbMessage('diagKFMsg', '一次最多导入 20 个文件（当前 ' + files.length + ' 个），请分批处理。', true); return; }
  _diagState.busy = 'kb-file'; _diagKbLock();
  const failures = [], done = [];
  let added = 0, updated = 0, skipped = 0;
  try {
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      _diagState.kbFileLabel = '正在处理 ' + (i + 1) + '/' + files.length + '…';
      _diagKbLock();
      _diagKbMessage('diagKFMsg', '正在处理第 ' + (i + 1) + '/' + files.length + ' 个文件：' + file.name + '…');
      try {
        if (file.size > 2 * 1024 * 1024) throw new Error('超过 2MB，请拆分后重试');
        let text;
        const kind = (typeof KbFile !== 'undefined') ? KbFile.kindOf(file.name) : 'text';
        if (kind === 'docx' || kind === 'xlsx') {
          // Word / Excel 在本机解包抽文字，原文件不上传；抽不出文字时由 KbFile 抛错
          text = (await KbFile.extract(file)).text;
        } else {
          if (kind === 'legacy') throw new Error('旧版 Office 格式读不了，请在 Word / Excel / WPS 里另存为 .docx / .xlsx 或 TXT 后重试');
          text = (await file.text()).replace(/^\uFEFF/, '');
          if (!text.trim()) throw new Error('文件为空');
          if (typeof CryptoBox !== 'undefined' && CryptoBox.isFileEnvelope(text)) throw new Error('这是加密备份文件，请用旁边「📦 备份 ▾」里的「导入备份」恢复');
          if (text.indexOf('\u0000') >= 0) throw new Error('看起来不是文本文件，请另存为 TXT / MD / CSV，或把 Word / Excel 另存为 .docx / .xlsx');
        }
        const r = await _diagSay('aiKbImport', { text: text, format: 'file', filename: file.name });
        if (!r || !r.ok) throw new Error((r && r.error) || '整理失败');
        added += Number(r.added) || 0; updated += Number(r.updated) || 0; skipped += Number(r.skipped) || 0;
        done.push(file.name);
      } catch (e) {
        failures.push({ file: file, why: e.message || String(e) });
      }
    }
    const summary = failures.length
      ? '处理完成，共 ' + files.length + ' 个文件：成功 ' + done.length + ' 个（新增 ' + added + ' 条，更新 ' + updated + ' 条，跳过 ' + skipped + ' 条' + (done.length ? '，' + done.join('、') : '') + '）；失败 ' + failures.length + ' 个：' + failures.map(function (f) { return f.file.name + '：' + f.why; }).join('；') + '。失败文件仍保留在列表，修正后可重新导入。'
      : '已导入 ' + files.length + ' 个文件：新增 ' + added + ' 条，更新 ' + updated + ' 条，跳过 ' + skipped + ' 条。';
    _diagKbMessage('diagKFMsg', summary, failures.length > 0);
    _diagKbRecord('批量文件 / ' + files.length + ' 个', summary, failures.length > 0);
    if (done.length) await diagKbRefresh();
  } finally {
    _diagState.kbFiles = failures.map(function (f) { return f.file; });
    _diagState.kbFileLabel = '';
    _diagKbFileName();
    _diagState.busy = ''; _diagKbLock();
    const panel = document.getElementById('diagKAddPanel');
    if (panel && panel.open) document.getElementById('diagKFileImport').focus();
  }
}
/* ── 备份体：当前产品的全套账号资料（问卷答案/人设/卖点/知识库/规划与评估），刻意不含 AI Key ── */
function _diagBkBuild(cfg, stored, entries) {
  return {
    type: 'xhs_profile_backup',
    version: 1,
    exportedAt: Date.now(),
    account: {
      myCity: (cfg && cfg.myCity) || null,
      myAccountNames: (cfg && Array.isArray(cfg.myAccountNames) && cfg.myAccountNames.length) ? cfg.myAccountNames : null,
    },
    diagnosis: (cfg && cfg.diagnosis) || null,
    persona: (cfg && cfg.persona) || null,
    scriptStyle: (cfg && cfg.scriptStyle) || null,
    product: (cfg && cfg.product) || null,
    knowledgeBase: Array.isArray(entries) ? entries : [],
    notePlan: (stored && stored.note_plan) || null,
    deepReport: (stored && stored.deep_report) || null,
  };
}
/** 只认带 type 标记的新版整套备份；旧版纯知识库/数组备份返回 null，走原来的知识库逻辑 */
function _diagBkRead(parsed) {
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || parsed.type !== 'xhs_profile_backup') return null;
  return {
    account: parsed.account || null,
    diagnosis: parsed.diagnosis || null,
    persona: parsed.persona || null,
    scriptStyle: parsed.scriptStyle || null,
    product: parsed.product || null,
    knowledgeBase: Array.isArray(parsed.knowledgeBase) ? parsed.knowledgeBase : [],
    notePlan: parsed.notePlan || null,
    deepReport: parsed.deepReport || null,
  };
}
function _diagBkDigest(b) {
  const d = b.diagnosis || {};
  const answers = (Array.isArray(d.answers) ? d.answers : []).filter(function (a) { return a && String(a.answer || '').trim(); }).length;
  const points = (b.product && Array.isArray(b.product.sellPoints)) ? b.product.sellPoints.length : 0;
  const kb = Array.isArray(b.knowledgeBase) ? b.knowledgeBase.length : 0;
  return '问卷 ' + answers + ' 题、人设' + ((b.persona && b.persona.text) ? '已生成' : '未生成') + '、卖点 ' + points + ' 条、知识库 ' + kb +
    ' 条、规划' + (b.notePlan ? '已生成' : '未生成') + '、评估报告' + (b.deepReport ? '已生成' : '未生成');
}
function _diagBkAny(b) {
  const acc = b.account || {};
  return !!((b.diagnosis && (((b.diagnosis.answers || []).length) || b.diagnosis.profile)) || (b.persona && b.persona.text) ||
    b.product || b.scriptStyle || b.notePlan || b.deepReport || (b.knowledgeBase || []).length || (acc.myCity && acc.myCity.city));
}
/** 写回账号资料：合并只补本机没有的资料，覆盖整份替换；知识库仍走 saveKnowledgeBase（合并按标题 / 覆盖整库） */
async function _diagBkApply(bundle, mode) {
  const replace = mode === 'replace';
  const cfg = await _diagGetCfg();
  const stored = await chrome.storage.local.get(['note_plan', 'deep_report']);
  const acc = bundle.account || {};
  const written = [], kept = [], write = {};
  const take = function (label, backup, hasLocal, set) {
    if (!backup) { if (replace) kept.push(label); return; }   // 备份里没这份资料，本机保留
    if (!replace && hasLocal) { kept.push(label); return; }   // 合并：本机已有就不动
    set(); written.push(label);
  };
  take('问卷答案', bundle.diagnosis, !!(cfg.diagnosis && (((cfg.diagnosis.answers || []).length) || cfg.diagnosis.profile)), function () { cfg.diagnosis = bundle.diagnosis; });
  take('人设', (bundle.persona && bundle.persona.text) ? bundle.persona : null, !!(cfg.persona && cfg.persona.text), function () { cfg.persona = bundle.persona; });
  take('产品卖点', bundle.product, !!(cfg.product && (((cfg.product.sellPoints || []).length) || cfg.product.name)), function () { cfg.product = bundle.product; });
  take('话术风格', bundle.scriptStyle, !!(cfg.scriptStyle && Object.keys(cfg.scriptStyle).length), function () { cfg.scriptStyle = bundle.scriptStyle; });
  take('同城城市', (acc.myCity && acc.myCity.city) ? acc.myCity : null, !!(cfg.myCity && cfg.myCity.city), function () { cfg.myCity = acc.myCity; });
  take('我的账号名', acc.myAccountNames, !!(Array.isArray(cfg.myAccountNames) && cfg.myAccountNames.length), function () { cfg.myAccountNames = acc.myAccountNames; });
  take('内容规划', bundle.notePlan, !!stored.note_plan, function () { write.note_plan = bundle.notePlan; });
  take('评估报告', bundle.deepReport, !!stored.deep_report, function () { write.deep_report = bundle.deepReport; });
  if (written.length) {
    if (Object.keys(write).length) await chrome.storage.local.set(write);
    await _diagSaveCfg(cfg);
  }
  if (!bundle.knowledgeBase.length) return { replace: replace, written: written, kept: kept, kbText: '备份里没带知识，本机知识库保留' };
  const r = await _diagSay('saveKnowledgeBase', { entries: bundle.knowledgeBase, mode: replace ? 'replace' : 'merge' });
  if (!r || !r.ok) throw new Error((r && r.error) || '写入知识库失败');
  return { replace: replace, written: written, kept: kept, kbText: r.mode === 'replace' ? ('知识库已覆盖，共 ' + r.total + ' 条') : _diagKbResult(r) };
}
/** 导入整套资料后把内存状态对齐盘上的数据，免得导航圈和后续页面还显示旧资料 */
async function _diagBkReloadState() {
  const r = await Promise.all([_diagGetCfg(), chrome.storage.local.get(['note_plan', 'deep_report'])]);
  const cfg = r[0], stored = r[1];
  _diagState.diagnosis = cfg.diagnosis || null;
  _diagState.persona = (cfg.persona && cfg.persona.text) || _diagState.persona;
  _diagState.notePlan = stored.note_plan || null;
  _diagState.report = stored.deep_report || null;
  if (_diagState.diagnosis) {
    _diagState.profile = _diagState.diagnosis.profile || null;
    _diagState.userBio = _diagState.diagnosis.bio == null ? null : String(_diagState.diagnosis.bio);
    _diagState.unifiedAnswers = Array.isArray(_diagState.diagnosis.answers) ? _diagState.diagnosis.answers : [];
    _diagState.accountType = _diagState.diagnosis.accountType || '';
  }
  _diagState.quizDirty = false;
}
/* 「📦 备份」那一颗：点一下直接把当前产品的全套资料导成加密 JSON（不再开一页选来选去） */
async function diagKbExport() {
  if (_diagState.busy) return;
  if (typeof CryptoBox === 'undefined' || !CryptoBox.encryptFile) { _diagKbMessage('diagKListMsg', '当前版本不支持加密导出。', true); return; }
  _diagState.busy = 'kb-backup'; _diagKbLock();
  _diagKbMessage('diagKListMsg', '正在读取当前产品的资料…');
  try {
    const r = await Promise.all([_diagGetCfg(), chrome.storage.local.get(['note_plan', 'deep_report']), _diagSay('getKnowledgeBase')]);
    if (!r[2] || !r[2].ok || !Array.isArray(r[2].entries)) throw new Error((r[2] && r[2].error) || '未返回知识条目');
    const bundle = _diagBkBuild(r[0], r[1], r[2].entries);
    if (!_diagBkAny(bundle)) { _diagKbMessage('diagKListMsg', '账号资料还是空的，先去「问卷」答完提交一次，再来备份。', true); return; }
    const digest = _diagBkDigest(bundle);
    _diagKbMessage('diagKListMsg', '已读取全套账号资料（' + digest + '），请设置导出口令…');
    const pw = await CryptoBox.askPassword({ title: '设置导出口令', hint: '备份会用这个口令加密，恢复时输入同一口令即可，请自行记好。', confirm: true, okText: '加密并导出' });
    if (!pw.ok) { _diagKbMessage('diagKListMsg', '已取消导出，账号资料未改变。'); return; }
    const text = await CryptoBox.encryptFile(JSON.stringify(bundle), pw.password);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
    a.download = 'xhs_profile_backup_enc_' + Date.now() + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 10000);
    const summary = '已导出全套账号资料（' + digest + '）。';
    _diagKbMessage('diagKListMsg', summary);
    _diagKbRecord('备份导出', summary);
  } catch (e) {
    const text = '导出失败：' + (e.message || e) + '。账号资料未改变，可重试。';
    _diagKbMessage('diagKListMsg', text, true); _diagKbRecord('备份导出', text, true);
  } finally {
    _diagState.busy = ''; _diagKbLock();
  }
}
/* 「📦 备份 ▾ › 导入备份（合并 / 覆盖）」：选完文件立刻走这里，中间不留「已选择，再点一下开始」那一步 */
async function diagKbBackupImport(mode) {
  if (_diagState.busy) return;
  const file = _diagState.kbBackupFile;
  const label = mode === 'replace' ? '覆盖导入' : '合并导入';
  if (!file) { _diagKbMessage('diagKListMsg', '请先选择导出的 JSON 备份文件。', true); return; }
  _diagState.busy = 'kb-backup'; _diagKbLock();
  _diagKbMessage('diagKListMsg', '正在读取 ' + file.name + '…');
  let bundle = null;   // 新版整套备份；旧版纯知识库备份始终为 null，走下面的旧逻辑
  try {
    if (file.size > 32 * 1024 * 1024) throw new Error('备份文件超过 32MB，请拆分后再导入');
    let text = (await file.text()).replace(/^\uFEFF/, '');
    if (!text.trim()) throw new Error('文件为空，请重新选择备份文件');
    if (typeof CryptoBox !== 'undefined' && CryptoBox.isFileEnvelope(text)) {
      _diagKbMessage('diagKListMsg', '这是加密备份，请先输入口令…');
      const pw = await CryptoBox.askPassword({ title: '输入备份口令', hint: '请输入导出这份备份时设置的口令。', okText: '解密并导入' });
      if (!pw.ok) { _diagKbMessage('diagKListMsg', '已取消解密，账号资料未改变。'); return; }
      try { text = await CryptoBox.decryptFile(text, pw.password); }
      catch (_) { throw new Error('解密失败，请确认口令是否正确'); }
    }
    let parsed;
    try { parsed = JSON.parse(text); } catch (_) { throw new Error('JSON 解析失败，请确认选择的是备份文件'); }
    bundle = _diagBkRead(parsed);
    const entries = bundle ? bundle.knowledgeBase : (Array.isArray(parsed) ? parsed : parsed && (parsed.entries || parsed.knowledge_base || parsed.knowledgeBase || parsed.items || parsed.data));
    if (bundle) {
      if (!_diagBkAny(bundle)) throw new Error('备份里没有可恢复的账号资料');
      if (mode === 'replace' && !confirm('将用备份里的账号资料（' + _diagBkDigest(bundle) + '）替换当前产品的问卷、人设、卖点、知识库与规划，本地已有的同类资料会被覆盖且不可撤销。确定覆盖吗？')) {
        _diagKbMessage('diagKListMsg', '已取消覆盖，账号资料未改变。'); return;
      }
      _diagKbMessage('diagKListMsg', '正在写入账号资料…');
      const applied = await _diagBkApply(bundle, mode);
      const head = (applied.replace ? '已用备份替换账号资料：' : '已合并账号资料：') +
        (applied.written.length ? (applied.replace ? applied.written.join('、') : '补上 ' + applied.written.join('、')) : '本机已有同类资料，均保留本机');
      const summary = head + (applied.kept.length ? '（' + applied.kept.join('、') + '保留本机）' : '') + '；' + applied.kbText + '。';
      await _diagBkReloadState();
      _diagKbMessage('diagKListMsg', file.name + '：' + summary);
      _diagKbRecord('备份' + label + ' / ' + file.name, summary);
      _diagState.kbBackupFile = null;
      const input = document.getElementById('diagKBackupFile'); if (input) input.value = '';
      await diagKbRefresh();
      return;
    }
    if (!Array.isArray(entries) || !entries.length) throw new Error('备份里没有知识条目');
    if (mode === 'replace' && !confirm('将用备份里的 ' + entries.length + ' 条知识覆盖当前全部知识，原有条目会被删除且不可撤销。确定覆盖吗？')) {
      _diagKbMessage('diagKListMsg', '已取消覆盖，知识库未改变。'); return;
    }
    _diagKbMessage('diagKListMsg', '正在写入知识库…');
    const r = await _diagSay('saveKnowledgeBase', { entries: entries, mode: mode });
    if (!r || !r.ok) throw new Error((r && r.error) || '导入失败');
    const summary = r.mode === 'replace' ? ('已用备份覆盖知识库，共 ' + r.total + ' 条。') : _diagKbResult(r);
    _diagKbMessage('diagKListMsg', file.name + '：' + summary);
    _diagKbRecord('备份' + label + ' / ' + file.name, summary);
    _diagState.kbBackupFile = null;
    const input = document.getElementById('diagKBackupFile'); if (input) input.value = '';
    await diagKbRefresh();
  } catch (e) {
    // 整套备份是资料+知识库分步写入的，中断时可能只写进去一部分，别谎报「未改变」
    const tail = bundle ? '导入可能只完成了一部分，请刷新列表核对后重试。' : '知识库未改变，可修正后重试。';
    const text = label + '失败：' + (e.message || e) + '。' + tail;
    _diagKbMessage('diagKListMsg', text, true); _diagKbRecord('备份' + label + ' / ' + file.name, text, true);
  } finally {
    _diagState.busy = ''; _diagKbLock();
    _diagPaintNav();   // 导入可能带来新的问卷/人设/规划，导航圈的完成态要跟着变
  }
}
var _diagKbLoadSeq = 0;
async function diagKbRefresh() {
  const box = document.getElementById('diagKList');
  if (!box) return;
  const seq = ++_diagKbLoadSeq;
  _diagState.kbLoading = true; _diagKbLock();
  const refresh = document.getElementById('diagKRefresh');
  if (refresh) refresh.textContent = '读取中…';
  _diagKbMessage('diagKListMsg', '正在读取知识库…');
  try {
    const r = await _diagSay('getKnowledgeBase');
    if (!r || !r.ok || !Array.isArray(r.entries)) throw new Error((r && r.error) || '未返回知识条目');
    if (document.getElementById('diagKList') !== box || seq !== _diagKbLoadSeq) return;
    _diagState.kbEntries = r.entries;
    _diagState.kbCount = r.entries.length;
    diagKbRenderList();
    _diagKbMessage('diagKListMsg', '');
  } catch (e) {
    if (document.getElementById('diagKList') === box && seq === _diagKbLoadSeq) _diagKbMessage('diagKListMsg', '读取失败：' + (e.message || e) + '。请点击“刷新列表”重试。', true);
  } finally {
    if (seq === _diagKbLoadSeq) {
      _diagState.kbLoading = false;
      if (refresh) refresh.textContent = '刷新列表';
      _diagKbLock();
    }
  }
}
/* 知识库分类下拉的选项随库里的分类重建（签名没变就不重建，免得把用户的选择冲掉） */
function diagKbFilterPaint() {
  const sel = document.getElementById('diagKFilterCat');
  if (!sel) return;
  const cats = [];
  (_diagState.kbEntries || []).forEach(function (e) {
    const c = String((e && e.category) || '').trim();
    if (c && cats.indexOf(c) < 0) cats.push(c);
  });
  cats.sort();
  const sig = cats.join('\u0001');
  if (sel.dataset.sig !== sig) {
    sel.dataset.sig = sig;
    sel.innerHTML = '<option value="">全部分类</option>' + cats.map(function (c) { return '<option value="' + _dEsc(c) + '">' + _dEsc(c) + '</option>'; }).join('');
  }
  if (cats.indexOf(_diagState.kbFilterCat || '') < 0) _diagState.kbFilterCat = '';
  sel.value = _diagState.kbFilterCat || '';
  const st = document.getElementById('diagKFilterStatus');
  if (st) st.value = _diagState.kbFilterStatus || '';
}
function diagKbRenderList() {
  const box = document.getElementById('diagKList');
  if (!box) return;
  const entries = _diagState.kbEntries || [], search = (_diagState.kbSearch || '').trim().toLowerCase();
  diagKbFilterPaint();
  const cat = _diagState.kbFilterCat || '', status = _diagState.kbFilterStatus || '';
  const tagsOf = function (e) { return Array.isArray(e.tags) ? e.tags.map(String) : e.tags ? [String(e.tags)] : []; };
  const filtered = entries.map(function (entry, index) { return { entry: entry, index: index }; }).filter(function (row) {
    const e = row.entry;
    if (!e) return false;
    if (cat && String(e.category || '').trim() !== cat) return false;
    if (status && (status === 'off') !== (e.isActive === false)) return false;
    return !search || [e.title, e.content, e.category].concat(tagsOf(e)).join('\n').toLowerCase().includes(search);
  });
  const stats = document.getElementById('diagKStats');
  if (stats) stats.textContent = '总数 ' + entries.length + ' 条 · 启用 ' + entries.filter(function (e) { return e && e.isActive !== false; }).length + ' 条 · 匹配 ' + filtered.length + ' 条';
  // 正文就摆在行里（限 80 字）：原来那颗「查看」点开了也只看正文，那不如直接显示（老板口径）
  box.innerHTML = '<table aria-label="知识库"><colgroup><col style="width:46%"><col style="width:13%"><col style="width:12%"><col style="width:29%"></colgroup>' +
    '<thead><tr><th scope="col">知识标题 / 正文 / 标签</th><th scope="col">分类</th><th scope="col">状态</th><th scope="col">操作</th></tr></thead>' +
    (filtered.length ? filtered.map(function (row) {
      const e = row.entry;
      const peek = String(e.content || '').replace(/\s+/g, ' ').trim();
      return '<tbody class="diag-kb-item" data-index="' + row.index + '"><tr class="diag-kb-row">' +
        '<td><b>' + _dEsc(e.title || '未命名知识') + '</b>' +
        (peek ? '<div class="diag-kb-note" style="color:#555;">' + _dEsc(peek.length > 80 ? peek.slice(0, 80) + '…' : peek) + '</div>' : '') +
        '<div class="diag-kb-note">' + _dEsc(tagsOf(e).join('、') || '无标签') + '</div></td>' +
        '<td>' + _dEsc(e.category || '未分类') + '</td><td><span class="diag-kb-status' + (e.isActive === false ? ' off' : '') + '">' + (e.isActive === false ? '已停用' : '启用中') + '</span></td>' +
        '<td><div class="diag-kb-actions"><button type="button" class="btn btn-outline diag-kb-edit-btn">编辑</button>' +
        '<button type="button" class="btn btn-outline diag-kb-toggle">' + (e.isActive === false ? '启用' : '停用') + '</button></div>' +
        '<div class="diag-kb-entry-msg diag-kb-note" role="status"></div></td></tr></tbody>';
    }).join('') : '<tbody><tr><td colspan="4" class="diag-kb-note">' + (entries.length ? '没有匹配的知识，换个搜索词或筛选项试试。' : '暂无知识，点击「新增知识」添加第一条。') + '</td></tr></tbody>') + '</table>';
  box.querySelectorAll('.diag-kb-item').forEach(function (row) {
    const entry = entries[Number(row.dataset.index)];
    const msg = row.querySelector('.diag-kb-entry-msg');
    row.querySelector('.diag-kb-toggle').onclick = function () {
      if (_diagState.busy || _diagState.kbLoading) return;
      diagKbUpdate(entry, { isActive: entry.isActive === false }, msg);
    };
    row.querySelector('.diag-kb-edit-btn').onclick = function () {
      if (_diagState.busy || _diagState.kbLoading) return;
      diagKbOpenEdit(entry);
    };
  });
  _diagKbLock();
}
/* 编辑知识弹窗：一次只改一条，字段灌进 dialog，保存后回列表（不再在原列表就地展开表单） */
function _diagKbEditEntry() {
  const id = _diagState.kbEditId;
  if (!id) return null;
  return (_diagState.kbEntries || []).filter(function (e) { return e && e.id === id; })[0] || null;
}
function _diagKbEditImgPaint() {
  const wrap = document.getElementById('diagKEditImgWrap'), prev = document.getElementById('diagKEditImgPrev');
  const src = String(_diagState.kbEditImage || '');
  if (wrap) wrap.hidden = !src;
  if (prev) { if (src) prev.src = src; else prev.removeAttribute('src'); }
}
function diagKbOpenEdit(entry) {
  const panel = document.getElementById('diagKEditPanel');
  if (!panel || !entry) return;
  _diagState.kbEditId = entry.id;
  const set = function (id, v) { const el = document.getElementById(id); if (el) el.value = v == null ? '' : v; };
  set('diagKEditTitleIn', entry.title);
  set('diagKEditContent', entry.content);
  set('diagKEditCat', entry.category);
  set('diagKEditRole', entry.role);
  set('diagKEditTags', Array.isArray(entry.tags) ? entry.tags.join('、') : String(entry.tags || ''));
  const ck = panel.querySelector('.diag-kb-active');
  if (ck) ck.checked = entry.isActive !== false;
  const file = document.getElementById('diagKEditImgFile');
  if (file) file.value = '';
  _diagState.kbEditImage = String(entry.image || '');
  _diagKbEditImgPaint();
  _diagKbMessage('diagKEditMsg', '');
  if (!panel.open) panel.showModal();
  const t = document.getElementById('diagKEditTitleIn');
  if (t) t.focus();
}
function diagKbEditClose() {
  const panel = document.getElementById('diagKEditPanel');
  if (panel && panel.open) panel.close();
  _diagState.kbEditId = '';
  _diagState.kbEditImage = '';
}
async function diagKbEditSave() {
  const entry = _diagKbEditEntry();
  if (!entry) { diagKbEditClose(); return; }
  const val = function (id) { return String(((document.getElementById(id) || {}).value) || '').trim(); };
  const title = val('diagKEditTitleIn'), content = val('diagKEditContent');
  if (!title || !content) { _diagKbMessage('diagKEditMsg', '标题和正文不能为空，请补充后保存。', true); return; }
  let tags;
  const raw = String(((document.getElementById('diagKEditTags') || {}).value) || '');
  try {
    tags = raw.trim().startsWith('[') ? JSON.parse(raw) : raw.split(/[,，、\n]/).map(function (t) { return String(t).trim(); }).filter(Boolean);
    if (!Array.isArray(tags) || tags.some(function (t) { return typeof t !== 'string'; })) throw new Error();
  } catch (_) { _diagKbMessage('diagKEditMsg', '标签格式有误，请用逗号分隔或有效的 JSON 字符串数组。', true); return; }
  const ck = document.querySelector('#diagKEditPanel .diag-kb-active');
  const ok = await diagKbUpdate(entry, {
    title: title, content: content, category: val('diagKEditCat'), role: val('diagKEditRole'),
    tags: tags, isActive: !!(ck && ck.checked), image: _diagState.kbEditImage || null,
  }, document.getElementById('diagKEditMsg'));
  if (ok) diagKbEditClose();
}
async function diagKbUpdate(entry, updates, msg) {
  if (_diagState.busy) return false;
  if (!entry || !entry.id) {
    if (msg) { msg.style.color = '#c62828'; msg.textContent = '此条目缺少 ID，请刷新列表后再试。'; }
    return false;
  }
  _diagState.busy = 'kb-edit'; _diagKbLock();
  if (msg) { msg.style.color = '#0a7b5a'; msg.textContent = '正在保存…'; }
  try {
    const r = await _diagSay('updateKnowledgeEntry', { id: entry.id, updates: updates });
    if (!r || !r.ok) throw new Error((r && r.error) || '保存失败');
    if (msg) msg.textContent = '已保存';
    await diagKbRefresh();
    return true;
  } catch (e) {
    if (msg) { msg.style.color = '#c62828'; msg.textContent = '保存失败：' + (e.message || e) + '。修改仍保留，可重试。'; }
    return false;
  } finally {
    _diagState.busy = ''; _diagKbLock();
  }
}
/* ── 发笔记 · 任务配置（内容基调：谁在说 × 哪一阶段 × 讲哪几类）
      2026-10-01 五十二改（老板）：「内容基调这个菜单应该直接移动到发笔记下面的 2 级 tab 里面，就叫任务配置；
      这个界面的功能也设计成三级 tab 的形式」——所以这一页离开诊断左栏，挂到「发笔记」下面，
      页内三个横 tab，一次只画选中的那一节。
      口径不变（四十五改）：📐 篇幅配比与 🖋 字数的账号默认全站只在这张「五条线 × 写法」表上改
      （写文案 ④ 只留 🎚 卖货话术比例与 🖋 字数两个旋钮，改的是那一条）。 ── */
let _noteToneSec = 'stage';
const NOTE_TONE_SECS = { stage: _diagPersonaTableHtml, lines: _diagLinesHtml, talk: _diagTalkDefaultHtml, look: _diagLookDefaultHtml };
function renderNoteTaskCfg(box) {
  if (!box) return;
  box.innerHTML = '<style>' +
    '#noteTaskCfgContent .nt-tabs{display:flex;gap:2px;margin:10px 0 0;border-bottom:1px solid var(--line,#eceef0);}' +
    '#noteTaskCfgContent .nt-tab{border:0;background:none;padding:6px 12px;margin-bottom:-1px;font-size:12px;font-weight:600;color:#6b7280;cursor:pointer;border-bottom:2px solid transparent;}' +
    '#noteTaskCfgContent .nt-tab:hover{color:#374151;}' +
    '#noteTaskCfgContent .nt-tab.active{color:var(--c-brand-text,var(--xhs-red));border-bottom-color:var(--c-brand,var(--xhs-red));}' +
    '#noteTaskCfgContent .ntToneTbl{width:100%;box-sizing:border-box;border-collapse:collapse;margin-top:8px;font-size:11px;}' +
    '#noteTaskCfgContent .ntToneTbl th,#noteTaskCfgContent .ntToneTbl td{box-sizing:border-box;padding:6px 8px;border-bottom:1px solid #f2f4f7;text-align:left;vertical-align:top;}' +
    '#noteTaskCfgContent .ntToneTbl th{background:#fafbfc;color:#6b7280;font-size:11px;font-weight:600;}' +
    '#noteTaskCfgContent .ntToneTbl th:nth-child(1){width:auto;}' +
    '#noteTaskCfgContent .ntToneTbl th:nth-child(2){width:132px;}' +
    '#noteTaskCfgContent .ntToneTbl th:nth-child(3){width:96px;}' +
    '#noteTaskCfgContent .ntToneTbl th:nth-child(4){width:74px;}' +
    '#noteTaskCfgContent .ntToneTbl th:nth-child(5){width:96px;}' +
    '#noteTaskCfgContent .ntToneTbl tr.ntLine>td{padding-top:9px;padding-bottom:3px;border-bottom:none;}' +
    '#noteTaskCfgContent .ntToneTbl tr.ntKind>td{background:#fff;}' +
    '#noteTaskCfgContent .ntToneTbl tr.ntKind .ntDot{color:#98a1ad;margin-right:2px;}' +
    '#noteTaskCfgContent .ntToneTbl tr.ntEditor>td{background:#fafbfd;border-bottom:1px solid #e7eaf0;}' +
    '#noteTaskCfgContent .ntWhat{color:#8a929e;font-size:10px;line-height:1.6;font-weight:400;}' +
    '#noteTaskCfgContent .ntShape{color:#0a7b5a;white-space:nowrap;}' +
    '#noteTaskCfgContent .ntFrom{color:#98a1ad;}' +
    '#noteTaskCfgContent .ntFromEdit{color:#b45309;}' +
    '#noteTaskCfgContent .ntAct{text-align:right;}' +
    '#noteTaskCfgContent .ntAct .btn{margin:0;padding:1px 8px;font-size:11px;}' +
    '#noteTaskCfgContent .ntNum{font-size:10px;padding:1px 6px;border-radius:8px;background:#eaf7f0;color:#0a7b5a;}' +
    '#noteTaskCfgContent .ntNumOff{background:#f2f4f7;color:#98a1ad;}' +
    '#noteTaskCfgContent .ntTalkRow{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}' +
    '#noteTaskCfgContent .ntTalkBtn{box-sizing:border-box;flex:1 1 120px;min-width:104px;padding:8px 10px;border:1px solid #dfe3e8;border-radius:9px;background:#fff;color:#374151;font-size:12px;font-weight:600;cursor:pointer;}' +
    '#noteTaskCfgContent .ntTalkBtn:hover{border-color:var(--c-brand);}' +
    '#noteTaskCfgContent .ntTalkBtn.on{border-color:var(--c-brand);background:var(--c-brand-soft);color:var(--c-brand-text);}' +
    '#noteTaskCfgContent .ntTalkTip{margin-top:9px;padding:7px 9px;background:#fafbfc;border-radius:8px;font-size:11px;color:#6b7280;line-height:1.7;}' +
    '#noteTaskCfgContent .ntTalkTip b{color:#374151;}' +
    '#noteTaskCfgContent .ntTalkUse{border:0;background:none;color:var(--c-brand-text,var(--xhs-red));font-size:11px;font-weight:700;cursor:pointer;padding:0 2px;text-decoration:underline;}' +
    '</style>' +
    _diagCard(_diagStepTitle('任务配置 · 内容基调 · 谁在说 · 哪一阶段 · 讲哪几类', '') +
      '<div id="diagToneSummary"></div>') +
    '<div class="nt-tabs" id="noteToneTabs">' +
      '<button type="button" class="nt-tab" data-sec="stage">🧬 账号阶段与人设</button>' +
      '<button type="button" class="nt-tab" data-sec="lines">📄 内容基调</button>' +
      '<button type="button" class="nt-tab" data-sec="talk">🎚 话术比例</button>' +
      '<button type="button" class="nt-tab" data-sec="look">🎨 出图默认</button>' +
    '</div>' +
    '<div id="diagStyleResult" style="margin-top:10px;"></div>';
  document.getElementById('noteToneTabs')?.addEventListener('click', function (e) {
    const b = e.target.closest('[data-sec]');
    if (!b || b.getAttribute('data-sec') === _noteToneSec) return;
    _noteToneSec = b.getAttribute('data-sec');
    diagRenderStyle();
  });
  diagRenderToneSummary();
  diagStyleRestore();
}
/** 总览那一句要用的几样：阶段 / 一句话人设 / 这个阶段主用哪几条线（各几篇）/ 卖货话术的账号默认 */
function _diagToneParts() {
  const stages = NotePlan.STAGES || [];
  let stageKey = (_diagState.notePlan && _diagState.notePlan.stage) || '';
  if (!stageKey) { try { stageKey = NotePlan.detectStage(_diagState.profile) || ''; } catch (_) {} }
  const stage = stages.filter(function (s) { return s.key === stageKey; })[0] || null;
  let line = '';
  try { line = String(_diagQuizAnswerByQ('用一句话介绍你自己') || '').trim(); } catch (_) {}
  let lineFrom = 'quiz';
  if (!line) { line = String((_diagState.styleAdvice || {}).personaLine || '').trim(); lineFrom = 'ai'; }
  const ns = _diagState.noteStyle || null;
  const talk = NotePlan.sellTalkOf((ns && ns.sellTalk) || '');
  const mix = ((_diagState.notePlan && Array.isArray(_diagState.notePlan.mix)) ? _diagState.notePlan.mix : [])
    .filter(function (r) { return r && Number(r.count) > 0; })
    .sort(function (a, b) { return Number(b.count) - Number(a.count); });
  let top = [];
  if (!mix.length && stage) { try { top = NotePlan.stageTopLines(stage.key, null, 12).slice(0, 4); } catch (_) {} }
  return { stage: stage, line: line, lineFrom: lineFrom, talk: talk, mix: mix, top: top };
}
function diagRenderToneSummary() {
  const box = document.getElementById('diagToneSummary'); if (!box) return;
  const p = _diagToneParts();
  const who = p.line ? ('「' + _dEsc(p.line.slice(0, 90)) + (p.line.length > 90 ? '…' : '') + '」') : '（还没有一句话人设）';
  const whoFrom = p.line ? (p.lineFrom === 'ai' ? '（AI 按你的资料写的）' : '（问卷里你自己写的）') : '';
  const stage = p.stage ? ('<b>' + _dEsc(p.stage.name) + '</b>（粉丝 ' + _dEsc(p.stage.fans) + '）') : '<span style="color:#c77700;">（还没抓到粉丝数，先去「基础配置」抓一次主页）</span>';
  const lines = p.mix.length
    ? p.mix.map(function (r) { return '<b>' + _dEsc(_diagTypeName(r.type)) + '</b> ' + Number(r.count) + ' 篇'; }).join(' · ')
    : (p.top.length
      ? p.top.map(function (r) { return '<b>' + _dEsc(r.name || _diagTypeName(r.type)) + '</b> ' + Number(r.count) + ' 篇'; }).join(' · ') + '<span style="color:#8a929e;">（这是这一阶段的建议分配，去「诊断&amp;配置 → 规划」点一次就按它排）</span>'
      : '<span style="color:#c77700;">（还没排产——去「诊断&amp;配置 → 规划」点一次「重新生成规划与评估」）</span>');
  box.innerHTML =
    '<div style="background:linear-gradient(180deg,var(--c-brand-soft),#fff);border:1px solid #e7eaf0;border-radius:10px;padding:10px 12px;margin-top:6px;">' +
      '<div style="font-size:13px;line-height:1.9;color:#333;">' +
        who + '<span style="font-size:11px;color:#888;">' + whoFrom + '</span> 这个人，在 ' + stage + '，主要讲：' + lines +
      '</div>' +
      '<div style="font-size:11px;color:#8a929e;margin-top:4px;">这就是这个账号的内容基调：谁在说 · 哪一阶段 · 讲哪几类。每条线的 📐 篇幅配比与 🖋 字数在下面那张「五条线 × 写法」表上定，🎚 卖货话术默认「' + _dEsc(p.talk.name) + '」——发笔记 ④ 挑稿、⑤ 成稿都按它写。</div>' +
    '</div>';
}

/* ── 规划（内容规划 + 深度评估：一次点击先出规划、再基于新规划出评估） ── */
function diagStepPlan(body) {
  if (!body) return;
  body.innerHTML =
    _diagCard(_diagStepTitle('规划 · 内容排产与评估',
      '<button type="button" id="diagPlanBuild" class="btn btn-outline" style="margin:0;">🔄 重新生成规划与评估</button>') +
      '<div id="diagPlanMsg" role="status" style="font-size:12px;color:#0a7b5a;margin:6px 0;"></div>') +
    '<div id="diagPlanResult" style="margin-top:10px;"></div>' +
    '<div id="diagReportResult" style="margin-top:10px;"></div>';
  if (_diagState.report) diagRenderReport();
  if (_diagState.notePlan) diagRenderPlan();
  diagPlanRestore();
  document.getElementById('diagPlanBuild')?.addEventListener('click', diagPlanBuild);
}
async function diagPlanRestore() {
  const box = document.getElementById('diagPlanResult');
  try {
    const stored = await chrome.storage.local.get(['note_plan', 'note_columns']);
    if (document.getElementById('diagPlanResult') !== box || _diagState.busy) return;
    _diagState.notePlan = stored.note_plan || _diagState.notePlan;
    _diagState.columns = NotePlan.normalizeColumns(stored.note_columns);   // 📅 栏目表（长期设定）
    if (_diagState.notePlan) {
      diagRenderPlan();
    } else if (box) {   // 还没规划也能先定栏目（栏目是长期设定，与这批排产表无关）
      box.innerHTML = '<div style="font-size:12px;color:#888;">还没有已保存的规划。</div>' + _diagColumnsHtml(null);
      _diagColBind(box);
    }
  } catch (e) {
    const msg = document.getElementById('diagPlanMsg');
    if (msg && document.getElementById('diagPlanResult') === box) msg.textContent = '读取规划失败：' + (e.message || e) + '。请重新进入本页重试。';
  }
}
async function diagPlanBuild() {
  const btn = document.getElementById('diagPlanBuild'); const msg = document.getElementById('diagPlanMsg');
  if (!btn || _diagState.busy) return;
  _diagState.busy = 'plan';
  const t = btn.textContent; btn.textContent = '正在重新生成规划…';
  const lock = function (on) { document.querySelectorAll('#diagBody button').forEach(function (el) { el.disabled = on; }); };
  lock(true);
  if (msg) msg.textContent = '';
  const type = String(_diagState.accountType || (_diagState.notePlan && _diagState.notePlan.accountType) || '').trim();
  try {
    const answers = (_diagState.unifiedAnswers || []).map(function (a, i) { return { q: a.q || DIAG_UNIFIED_QUESTIONS[i] || '', answer: a.answer || '' }; });
    const r = await _diagSay('aiNotePlan', { profile: _diagState.profile, persona: _diagState.persona, accountType: type || '', answers: answers, noteStyle: _diagState.noteStyle || null });
    if (!r || !r.ok || !r.plan) throw new Error((r && r.error) || 'AI 未生成内容规划');
    await chrome.storage.local.set({ note_plan: r.plan });
    _diagState.notePlan = r.plan;
    _diagState.mixEdit = null;   // 新规划落地：配比条按这次实际用的权重重新起
    diagRenderPlan();
    diagRenderStyle();      // 设置面在「发笔记 → 任务配置」：这一页上它是空跑；在那一页跑＝总览那句「主要讲哪几条线」跟着新排产表重算
    diagRenderToneSummary();
    // 评估紧跟着走：报告吃刚出的规划，用户视角就是「一次操作出规划+评估」
    btn.textContent = '正在生成评估…';
    if (msg) { msg.style.color = '#0a7b5a'; msg.textContent = '规划已更新，正在生成评估…'; }
    const r2 = await _diagSay('aiDeepReport', {
      profile: _diagState.profile, persona: _diagState.persona,
      accountType: String(type || (r.plan && r.plan.accountType) || '').trim(),
      planText: JSON.stringify(_diagState.notePlan),
    });
    if (!r2 || !r2.ok || !r2.report) throw new Error((r2 && r2.error) || 'AI 未生成报告');
    _diagState.report = r2.report;
    await chrome.storage.local.set({ deep_report: r2.report });   // 落盘：规划的完成状态与刷新后的回显都靠它
    diagRenderReport();
    // 基础配置改过账号类型时规划标记会被清掉：这里补回来，规划的完成圈跟着这两份新结果走
    await _diagMarkNode('plan', '已按账号类型重新生成规划与评估');
    if (msg) { msg.style.color = '#0a7b5a'; msg.textContent = '✅ 已重新生成内容规划与评估。'; }
  } catch (e) {
    if (msg) { msg.style.color = '#c62828'; msg.textContent = '生成失败：' + (e.message || e) + '。已生成的部分保留，可重试。'; }
  }
  finally {
    _diagState.busy = ''; btn.textContent = t; lock(false);
    _diagPaintNav();   // 规划的完成圈跟着规划与报告走
  }
}
/* ── 内容基调的设置面（发笔记 → 任务配置；四十五改：🎨 调子退市）
      老板 2026-09-29：「调子不要了，但是那个铺垫、展开、产品的篇幅配比和字数设定可以给 5 条线和写法来用」
      「账号阶段的诊断应该跟着五条线来」「内容基调最上面的四件事、各管什么的表格不需要了」。
      所以这一页只剩三块：
        🧬 阶段 × 人设 —— 第三列改成「这个阶段主用哪几条线、各几篇」（由规划那份配比算出来，不再挂调子）
        📄 五条线 × 写法 —— 📐 篇幅配比与 🖋 字数的账号默认，全站只在这张表上改（存 config.noteStyle.lines / .kinds）
        🎚 卖货话术比例 —— 账号默认那一档（发笔记 ④ 可就手改那一条的） ── */
function _diagStyleEdit() {
  // linesOpen 默认展开：这一页的主内容就是这张「五条线 × 写法」表；编辑按需展开（editing 一次只开一个）
  if (!_diagState.noteStyleEdit) _diagState.noteStyleEdit = { linesOpen: true, busy: false, err: '', editing: '', draft: null };
  return _diagState.noteStyleEdit;
}
/** 问卷里某一题的答案（按题面片段找，不写死下标；答案可能带补充，按分号拆） */
function _diagQuizAnswerByQ(frag) {
  const list = _diagState.unifiedAnswers || [];
  for (let i = 0; i < list.length; i++) {
    const a = list[i] || {};
    const q = String(a.q || (DIAG_QUIZ[i] && DIAG_QUIZ[i].q) || '');
    if (q.indexOf(frag) >= 0) return a.answer || '';
  }
  return '';
}
async function diagStyleRestore() {
  const box = document.getElementById('diagStyleResult'); if (!box) return;
  try {
    const r = await Promise.all([_diagGetCfg(), chrome.storage.local.get('note_style_advice')]);
    if (document.getElementById('diagStyleResult') !== box) return;
    _diagState.noteStyle = (r[0] && r[0].noteStyle) || null;
    _diagState.imgLook = npLookShape(r[0] && r[0].imgLook);   // 🎨 出图默认（五十五改）
    await npLoadImgMotifs();                                   // 🎭 账号自加的画面流派（内置十条在 lib/visual-motif.js）
    _diagState.styleAdvice = (r[1] && r[1].note_style_advice) || null;
  } catch (_) {}
  if (document.getElementById('diagStyleResult') === box) diagRenderStyle();
}
function diagRenderStyle() {
  const box = document.getElementById('diagStyleResult'); if (!box) return;
  // 一次只画选中的那一节（读法＝总览那句话：谁在说 · 在哪一阶段 · 讲哪几条线 → 每条线/写法各占多少字 → 话术默认档）
  const sec = NOTE_TONE_SECS[_noteToneSec] ? _noteToneSec : 'stage';
  box.innerHTML = NOTE_TONE_SECS[sec]();
  document.querySelectorAll('#noteToneTabs .nt-tab').forEach(function (b) {
    b.classList.toggle('active', b.getAttribute('data-sec') === sec);
  });
  _diagStyleBind(box);
  diagRenderToneSummary();   // 改了话术默认档，顶部那句「主要讲…」与话术名跟着重算
}
/** 账号默认的卖货话术比例（任务配置这张表上的产品段就按它重切） */
function _diagTalkNow() {
  const ns = _diagState.noteStyle || {};
  try { return NotePlan.sellTalkOf(ns.sellTalk || ''); } catch (_) { return null; }
}
/** 任务配置的配比/字数覆盖挂在哪一格：'t:线key' → noteStyle.lines，'k:写法key' → noteStyle.kinds */
function _diagTargetParts(target) {
  const s = String(target || '');
  const rest = s.slice(2);
  if (s.slice(0, 2) === 'k:') {
    const k = NotePlan.kindOf(rest);
    return k ? { bag: 'kinds', key: k.key, type: k.type, name: k.name } : null;
  }
  if (s.slice(0, 2) === 't:') {
    const t = NotePlan.typeOf(rest);
    return t ? { bag: 'lines', key: t.key, type: t.key, name: t.name } : null;
  }
  return null;
}
/** 这一格的配比底座与字数档（走账号默认 → 出厂那条链，含「是不是账号自己改过」） */
function _diagTargetCur(target) {
  const p = _diagTargetParts(target);
  if (!p) return null;
  const ns = _diagState.noteStyle || {};
  const own = (ns[p.bag] || {})[p.key] || null;
  const kindKey = p.bag === 'kinds' ? p.key : '';
  const lineOwn = (ns.lines || {})[p.type] || null;
  let from = '出厂默认';
  if (own) from = '账号改过';
  else if (kindKey && lineOwn) from = '跟所在那条线';
  return {
    parts: p, own: own, from: from,
    base: NotePlan.shapeBaseOf(p.type, kindKey, ns),
    words: NotePlan.wordsBaseOf(p.type, kindKey, ns),
  };
}
/** 步进一格：改一段，另外两段按原比例补，总数永远 100 */
function _shapeStep(shape, key, delta) {
  const s = { build: Number(shape.build) || 0, core: Number(shape.core) || 0, sell: Number(shape.sell) || 0 };
  const others = ['build', 'core', 'sell'].filter(function (k) { return k !== key; });
  let v = Math.max(0, Math.min(90, (s[key] || 0) + (Number(delta) || 0)));
  const room = 100 - v;
  const sumO = (s[others[0]] || 0) + (s[others[1]] || 0);
  if (sumO <= 0) {
    s[others[0]] = Math.round(room / 2);
    s[others[1]] = room - s[others[0]];
  } else {
    let a = Math.round((s[others[0]] || 0) / sumO * room);
    a = Math.max(0, Math.min(room, a));
    s[others[0]] = a;
    s[others[1]] = room - a;
  }
  s[key] = v;
  return s;
}
/* ── 📄 五条线 × 写法：发笔记 ④ 挑稿照这张表走；📐 配比与 🖋 字数的账号默认也定在这里 ── */
function _diagLinesHtml() {
  const st = _diagStyleEdit();
  const types = NotePlan.TYPES || [];
  const cnt = {};
  ((_diagState.notePlan && Array.isArray(_diagState.notePlan.mix)) ? _diagState.notePlan.mix : []).forEach(function (r) {
    if (r && r.type) cnt[r.type] = Number(r.count) || 0;
  });
  const hasPlan = Object.keys(cnt).length > 0;
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:12px;background:#fff;margin-top:10px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><div style="font-weight:700;font-size:14px;">📄 内容基调 · 五条线 × 写法</div>' +
    '<span class="qhelp" tabindex="0" data-tip="' + escAttr('一行＝一条线，底下缩进那几行是这条线能用的写法。📐 ＝铺垫 / 展开 / 产品 各占多少（产品段还会被「🎚 话术比例」那一节盖一次）；🖋 ＝这一篇写多长。整张表＝账号默认，发笔记写哪一条都先按它走；点「改」才在这一行底下撑开旋钮。') + '">?</span>' +
    '<button type="button" id="diagLinesToggle" class="btn btn-outline" style="margin:0 0 0 auto;font-size:11px;">' + (st.linesOpen ? '收起' : '展开看') + '</button></div>';
  if (st.err) h += '<div style="font-size:11px;color:#c62828;margin-top:4px;">' + _dEsc(st.err) + '</div>';
  if (!st.linesOpen) return h + '</div>';
  h += '<table class="ntToneTbl"><thead><tr><th>线 · 写法<span style="font-weight:400;color:#8a929e;">（这一张表＝账号默认，发笔记按它写）</span></th><th>📐 铺垫 / 展开 / 产品</th><th>🖋 字数</th><th>来源</th><th></th></tr></thead><tbody>' +
    types.map(function (t) { return _diagLineRowHtml(t, cnt, hasPlan, st); }).join('') +
    '</tbody></table></div>';
  return h;
}
/** 某一格现在的配比与字数（＋来源：出厂 / 账号改过）；线级与写法级共用 */
function _diagToneCells(target) {
  const cur = _diagTargetCur(target);
  if (!cur) return null;
  const sh = NotePlan.shapeOf(cur.base, _diagTalkNow());
  const wd = NotePlan.wordsOf(cur.words) || NotePlan.wordsOf(NotePlan.WORDS_DEFAULT);
  return { sh: sh, range: wd ? wd.range : '—', from: cur.from };
}
function _diagLineRowHtml(t, cnt, hasPlan, st) {
  const target = 't:' + t.key;
  const c = _diagToneCells(target);
  if (!c) return '';
  const n = hasPlan ? (cnt[t.key] || 0) : null;
  const badge = (n == null) ? ''
    : (n > 0 ? '<span class="ntNum">本阶段 ' + n + ' 篇</span>' : '<span class="ntNum ntNumOff">本阶段没排</span>');
  const editing = st.editing === target;
  let h = '<tr class="ntLine"><td><b>' + _dEsc(t.name) + '</b> ' + badge +
    '<div class="ntWhat">' + _dEsc(t.what || '') + '</div></td>' +
    '<td class="ntShape">' + (c.sh ? c.sh.build + ' / ' + c.sh.core + ' / ' + c.sh.sell : '—') + '</td>' +
    '<td>' + _dEsc(c.range) + '</td>' +
    '<td class="' + (c.from === '账号改过' ? 'ntFromEdit' : 'ntFrom') + '">' + _dEsc(c.from) + '</td>' +
    '<td class="ntAct"><button type="button" class="btn btn-outline diagLineEdit" data-target="' + target + '">' + (editing ? '收起' : '✏️ 改这条线') + '</button></td></tr>';
  if (editing) h += '<tr class="ntEditor"><td colspan="5">' + _diagShapeEditorHtml(target) + '</td></tr>';
  (NotePlan.kindsOfType(t.key) || []).forEach(function (k) { h += _diagKindRowHtml(k, st); });
  return h;
}
function _diagKindRowHtml(k, st) {
  const target = 'k:' + k.key;
  const c = _diagToneCells(target);
  if (!c) return '';
  const editing = st.editing === target;
  let h = '<tr class="ntKind"><td><span class="ntDot">·</span>' + _dEsc(k.name) +
    '<div class="ntWhat">' + _dEsc(k.form || '') + '</div></td>' +
    '<td class="ntShape">' + (c.sh ? c.sh.build + ' / ' + c.sh.core + ' / ' + c.sh.sell : '—') + '</td>' +
    '<td>' + _dEsc(c.range) + '</td>' +
    '<td class="' + (c.from === '账号改过' ? 'ntFromEdit' : 'ntFrom') + '">' + _dEsc(c.from) + '</td>' +
    '<td class="ntAct"><button type="button" class="btn btn-outline diagLineEdit" data-target="' + target + '">' + (editing ? '收起' : '改') + '</button></td></tr>';
  if (editing) h += '<tr class="ntEditor"><td colspan="5">' + _diagShapeEditorHtml(target) + '</td></tr>';
  return h;
}
/** 一格的内联编辑器：📐 三段 −/＋（步进 5，永远凑 100）+ 🖋 字数档 + 实时配比条 */
function _diagShapeEditorHtml(target) {
  const st = _diagStyleEdit();
  const p = _diagTargetParts(target);
  if (!p) return '';
  const d = (st.editing === target && st.draft) ? st.draft : null;
  if (!d) return '';
  const talk = _diagTalkNow();
  const wd = NotePlan.wordsOf(d.words) || NotePlan.wordsOf(NotePlan.WORDS_DEFAULT);
  const sh = NotePlan.shapeOf(d.shape, talk);
  const seg = function (key, name, color) {
    const v = Number(d.shape[key]) || 0;
    return '<div style="display:flex;align-items:center;gap:6px;font-size:11px;margin-top:3px;">' +
      '<span style="width:30px;color:' + color + ';font-weight:700;">' + name + '</span>' +
      '<button type="button" class="btn btn-outline diagShapeStep" data-k="' + key + '" data-d="-5" style="font-size:11px;padding:0 8px;margin:0;">−</button>' +
      '<b style="width:34px;text-align:center;">' + v + '%</b>' +
      '<button type="button" class="btn btn-outline diagShapeStep" data-k="' + key + '" data-d="5" style="font-size:11px;padding:0 8px;margin:0;">＋</button>' +
      '<span style="color:#98a1ad;">约 ' + (Math.round(((wd && wd.mid) || 650) * v / 100 / 10) * 10) + ' 字</span>' +
      '</div>';
  };
  let h = '<div style="border:1px solid #e7eaf0;border-radius:8px;background:#fafbfd;padding:8px 10px;margin-top:5px;">' +
    '<div style="font-size:11px;font-weight:700;color:#333;">✏️ 改「' + _dEsc(p.name) + '」的篇幅配比与字数<span style="font-weight:400;color:#8a929e;">（账号默认，发笔记这一条线／这种写法就按它写）</span></div>' +
    '<div style="display:flex;gap:18px;flex-wrap:wrap;align-items:flex-start;margin-top:4px;">' +
    '<div style="min-width:230px;">' + seg('build', '铺垫', '#8a93a6') + seg('core', '展开', '#ff8a5c') + seg('sell', '产品', 'var(--c-brand)') + '</div>' +
    '<div style="min-width:200px;">' +
    '<div style="font-size:11px;color:#555;font-weight:600;">🖋 字数</div>' +
    '<div style="margin-top:3px;">' + NotePlan.WORDS.map(function (w) {
      const on = w.key === d.words;
      return '<button type="button" class="diagShapeWords" data-words="' + w.key + '" title="' + _dEsc(w.range) + '" style="display:inline-block;font-size:11px;padding:2px 8px;margin:0 6px 6px 0;border-radius:10px;cursor:pointer;' +
        (on ? 'border:1px solid var(--c-brand);color:var(--c-brand-text);background:var(--c-brand-soft);font-weight:600;' : 'border:1px solid #ddd;color:#444;background:#fff;') + '">' + _dEsc(w.name) + ' · ' + _dEsc(w.range) + '</button>';
    }).join('') + '</div>' +
    '</div></div>' +
    '<div style="margin-top:2px;">' + _shapeBarHtml(sh, wd, '上面 🎚 话术默认「' + _dEsc(talk ? talk.name : '') + '」：产品段实际按 ' + (sh ? sh.sell : 0) + '% 走。') + '</div>' +
    '<div style="display:flex;gap:8px;align-items:center;margin-top:6px;">' +
    '<button type="button" class="btn btn-primary diagShapeSave" style="font-size:11px;margin:0;">保存</button>' +
    '<button type="button" class="btn btn-outline diagShapeReset" style="font-size:11px;margin:0;">↺ 恢复默认</button>' +
    '<button type="button" class="btn btn-outline diagShapeCancel" style="font-size:11px;margin:0;">取消</button>' +
    '<span style="font-size:10px;color:#98a1ad;">恢复默认＝这一格不再覆盖，跟所在那条线／出厂那套走</span>' +
    '</div></div>';
  return h;
}
/** 账号默认覆盖的唯一写法：entry 里没内容就把这一格整条删掉（删掉＝回退到上一级默认） */
async function _diagStylePatch(target, entry) {
  const p = _diagTargetParts(target);
  if (!p) return false;
  const ns = Object.assign({}, _diagState.noteStyle || {});
  const bag = Object.assign({}, ns[p.bag] || {});
  const clean = {};
  Object.keys(entry || {}).forEach(function (k) {
    const v = entry[k];
    if (v === null || v === undefined || v === '') return;
    clean[k] = v;
  });
  if (Object.keys(clean).length) bag[p.key] = clean; else delete bag[p.key];
  ns[p.bag] = bag;
  ns.updatedAt = Date.now();
  try {
    await npSaveNoteStyle(ns);
    return true;
  } catch (e) {
    _diagStyleEdit().err = '保存失败：' + String((e && e.message) || e);
    return false;
  }
}
function _diagEditOpen(target) {
  const st = _diagStyleEdit();
  st.err = '';
  if (st.editing === target) { st.editing = ''; st.draft = null; diagRenderStyle(); return; }
  const cur = _diagTargetCur(target);
  if (!cur) return;
  st.editing = target;
  st.draft = { shape: { build: cur.base.build, core: cur.base.core, sell: cur.base.sell }, words: cur.words };
  diagRenderStyle();
}
async function _diagEditSave(target) {
  const st = _diagStyleEdit();
  const d = st.draft;
  if (!d) return;
  const shape = NotePlan.normShape(d.shape);
  if (!shape) { st.err = '配比得是三个加起来不为 0 的数。'; diagRenderStyle(); return; }
  if (await _diagStylePatch(target, { shape: shape, words: d.words })) { st.editing = ''; st.draft = null; }
  diagRenderStyle();
}
async function _diagEditReset(target) {
  if (await _diagStylePatch(target, {})) {
    const st = _diagStyleEdit();
    st.editing = ''; st.draft = null;
  }
  diagRenderStyle();
}
/** 🎚 卖货话术比例 · 账号默认（全站只在这一处改默认档；发笔记 ④ 改的那一条不碰这里） */
function _diagTalkDefaultHtml() {
  const ns = _diagState.noteStyle || {};
  const now = NotePlan.sellTalkOf(ns.sellTalk || '');
  const ad = _diagTalkAdvice();
  const btn = function (t) {
    const on = t.key === now.key;
    return '<button type="button" class="npStyleTalk ntTalkBtn' + (on ? ' on' : '') + '" data-talk="' + t.key + '"' +
      ' title="' + escAttr(_talkLineText(t)) + '">' + esc(t.name) + (t.share === '0' ? '' : ' · ' + esc(t.share)) + '</button>';
  };
  return '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:12px;background:#fff;margin-top:10px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><span style="font-weight:700;font-size:14px;">🎚 话术比例 · 账号默认</span>' +
    '<span class="qhelp" tabindex="0" data-tip="' + escAttr('这一档管「这篇里卖占多少」。选好之后，「内容基调」那张表里每一格的产品段都按它重切（铺垫与展开照原比例分剩下的）。发笔记 ④ 挑稿那一页可以就手改那一条的，不改就跟这里。括号里的成数＝产品大约占正文多少。') + '">?</span></div>' +
    '<div class="ntTalkRow">' + NotePlan.SELL_TALK.map(btn).join('') + '</div>' +
    '<div class="ntTalkTip">💡 建议：<b>' + esc(ad.talk.name) + '</b>——' + esc(ad.why) +
    (ad.talk.key === now.key ? '<span style="color:#0a7b5a;">（已是这一档）</span>'
      : '<button type="button" class="npStyleTalk ntTalkUse" data-talk="' + ad.talk.key + '">就按建议改</button>') + '</div>' +
    '</div>';
}
/** 🎭 画面流派面板状态：默认只查看，点「＋ 自己加一条」才摊开那一小格编辑 */
function _diagMotifEdit() {
  if (!_diagState.motifEdit) _diagState.motifEdit = { open: false, editing: '', draft: null, err: '' };
  return _diagState.motifEdit;
}
/** 账号默认面板上那一行：一条流派一颗钮，自定义的能改能删；展开时才摆编辑格 */
function _diagMotifRowHtml(cur) {
  const st = _diagMotifEdit();
  const now = String(cur.motif || '');
  const chipStyle = function (on) {
    return 'border:1px solid ' + (on ? 'var(--c-brand)' : '#dfe3e8') + ';border-radius:999px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') +
      ';color:' + (on ? 'var(--c-brand-text)' : '#374151') + ';font-size:11px;font-weight:600;padding:4px 11px;cursor:pointer;margin:0 5px 5px 0;';
  };
  const chip = function (m) {
    const on = now === m.k;
    const custom = !npMotifIsBuilt(m.k);
    const tip = m.take + (m.need ? '\n要什么料：' + m.need : '') + (custom ? '\n（这一派是自己加的）' : '');
    return '<button type="button" class="diagMotifChip" data-k="' + escAttr(m.k) + '" title="' + escAttr(tip) + '" style="' + chipStyle(on) + '">' + esc(m.k) + '</button>' +
      (custom ? '<button type="button" class="diagMotifFix" data-k="' + escAttr(m.k) + '" title="改这一派的三句配方 / 要什么料" style="border:none;background:none;color:#9aa0ac;cursor:pointer;font-size:11px;padding:0 2px;">\u270E</button>' +
        '<button type="button" class="diagMotifDel" data-k="' + escAttr(m.k) + '" title="删掉自己加的这一派（内置的删不掉）" style="border:none;background:none;color:#c4cad4;cursor:pointer;font-size:11px;padding:0 4px 0 0;">\u2715</button>' : '');
  };
  const list = npMotifAll();
  const need = now ? npMotifNeed(now) : '';
  const editing = st.open ? (st.draft || { k: '', take: '', cast: '', forbid: '', need: '' }) : null;
  const inp = 'width:100%;box-sizing:border-box;padding:6px 8px;border:1px solid #e7e8ec;border-radius:7px;font-size:12px;line-height:1.6;resize:vertical;';
  const lab = 'display:block;font-size:10px;color:#8a929e;margin:6px 0 2px;';
  return '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:9px;">' +
      '<span style="min-width:62px;font-size:12px;font-weight:700;color:#374151;">\uD83C\uDF3D 画面流派</span>' +
      '<span style="font-size:10px;color:#9aa0ac;">这一套画面往哪儿取材（图描述按它写）</span>' +
      '<span class="qhelp" tabindex="0" data-tip="' + escAttr('这一轴管「画面上摆什么」：真人干活、软件界面拼贴、一页方案、抽象符号、前后对比的剧情……选哪一派，AI 就往哪个路子写每一张的图描述。跟下面四类轴各走一条通道——流派只进 AI 那一发（断句 / 照这个风格重出图描述），不进提示词尾巴；尾巴只带「怎么画」那四轴。某篇要换派，在造图片那一页当场改，只记那一篇。') + '">?</span>' +
      '<span style="flex:1;"></span>' +
      '<button type="button" class="diagMotifAdd" style="border:1px dashed #cbb8f0;border-radius:999px;background:#fff;color:#6d28d9;font-size:11px;font-weight:600;padding:4px 11px;cursor:pointer;">' + (st.open ? '\u2715 收起' : '\uFF0B 自己加一条流派') + '</button>' +
    '</div>' +
    '<div style="display:flex;gap:0;flex-wrap:wrap;margin-top:5px;padding-left:68px;">' + list.map(chip).join('') + '</div>' +
    (now ? (function () {
      const m = list.filter(x => x.k === now)[0] || {};
      return '<div style="font-size:10px;color:#6b7280;margin-top:3px;padding-left:68px;line-height:1.6;">' + esc(m.take || '') +
        (need ? '<b style="color:#b45309;">　要什么料：' + esc(need) + '</b>' : '') + '</div>' +
        (m.cast || m.forbid
          ? '<details style="margin:3px 0 0 68px;"><summary style="font-size:10px;color:#7c3aed;cursor:pointer;">这一派怎么用：转译配方 · 不合格的样子（这两句跟「长什么样」一起喂 AI）</summary>' +
            '<div style="font-size:10px;color:#6b7280;line-height:1.7;margin-top:4px;padding-left:8px;border-left:2px solid #eee6fb;max-width:560px;">' +
            (m.cast ? '<div><b style="color:#374151;">转译配方（这段文案要变成这一派的什么料）：</b>' + esc(m.cast) + '</div>' : '') +
            (m.forbid ? '<div style="margin-top:3px;"><b style="color:#b45309;">这样算不合格：</b>' + esc(m.forbid) + '</div>' : '') +
            '</div></details>' : '');
    })() : '') +
    (st.open ? '<div style="margin:8px 0 2px 68px;padding:9px 10px;border:1px solid #e9e4fb;border-radius:9px;background:#fdfcff;max-width:560px;">' +
      '<span style="font-size:11px;font-weight:700;color:#374151;">' + (st.editing ? '改这一派：' + esc(st.editing) : '新流派叫什么名字（≤16 字，它就是列表那一行的身份）') + '</span>' +
      '<input class="diagMotifK" type="text" maxlength="16" value="' + escAttr(editing.k) + '" placeholder="如：门店实拍＋大字" style="' + inp + '">' +
      '<label style="' + lab + '">① 长什么样：画面上摆什么 / 别摆什么（三句都喂 AI，它照这三句写每一张的图描述）</label>' +
      '<textarea class="diagMotifTake" rows="2" maxlength="200" placeholder="如：画面上是真人在店里干活，手和屏幕同框，别画成产品海报" style="' + inp + '">' + esc(editing.take) + '</textarea>' +
      '<label style="' + lab + '">② 转译配方：这段文案要变成这一派里的什么具体东西（空着 AI 就只会把这段字排上画面）</label>' +
      '<textarea class="diagMotifCast" rows="3" maxlength="220" placeholder="如：先在这段里揪出一个正在发生的动作，摆成干到一半的那一帧：人＋手＋他操作的东西同框，旁边放两三件干这事一定有的小东西" style="' + inp + '">' + esc(editing.cast) + '</textarea>' +
      '<label style="' + lab + '">③ 这样算不合格：这一派最常见的偷懒写法（反例比正例管用，AI 照着查自己）</label>' +
      '<textarea class="diagMotifForbid" rows="2" maxlength="140" placeholder="如：把这段的字排在画面中间，人缩在角落当装饰" style="' + inp + '">' + esc(editing.forbid) + '</textarea>' +
      '<label style="' + lab + '">要什么料（空着＝不用备图，字和版式本身就是画面）</label>' +
      '<input class="diagMotifNeed" type="text" maxlength="120" value="' + escAttr(editing.need) + '" placeholder="如：要有真截图 / 真数据，拿不到就明说缺料" style="' + inp + '">' +
      '<div style="display:flex;gap:8px;align-items:center;margin-top:8px;">' +
        '<button type="button" class="btn btn-primary diagMotifSave" style="margin:0;">\uD83D\uDCBE 存这一派</button>' +
        (st.editing ? '<button type="button" class="btn btn-outline diagMotifCancel" style="margin:0;">取消</button>' : '') +
        '<span style="font-size:11px;color:' + (st.err ? '#d33' : '#9aa0ac') + ';">' + esc(st.err || '') + '</span>' +
      '</div></div>' : '');
}
/** 🎨 出图默认 · 账号默认：造图片 ③ 那一排轴在这一档定一次，全账号的篇都跟它走（某篇单独改了只记那篇） */
function _diagLookDefaultHtml() {
  const cur = npLookShape(_diagState.imgLook);
  const token = npLookToken(cur);
  const chip = function (a, v) {
    const on = String(cur[a.k] || '') === v;
    return '<button type="button" class="diagLookChip' + (on ? ' on' : '') + '" data-a="' + escAttr(a.k) + '" data-v="' + escAttr(v) + '"' +
      ' style="border:1px solid ' + (on ? 'var(--c-brand)' : '#dfe3e8') + ';border-radius:999px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') +
      ';color:' + (on ? 'var(--c-brand-text)' : '#374151') + ';font-size:11px;font-weight:600;padding:4px 11px;cursor:pointer;margin:0 5px 5px 0;">' + esc(v) + '</button>';
  };
  const row = function (a) {
    return '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:9px;">' +
      '<span style="min-width:62px;font-size:12px;font-weight:700;color:#374151;">' + esc(a.t) + '</span>' +
      '<span style="font-size:10px;color:#9aa0ac;">' + esc(a.d) + '</span>' +
      '<span style="display:flex;gap:4px;flex-wrap:wrap;">' + a.opts.map(function (v) { return chip(a, v); }).join('') + '</span></div>';
  };
  const ink = npInkOf(cur);
  const inkBtn = function (x) {
    const on = ink === x.k;
    return '<button type="button" class="diagLookInk" data-k="' + escAttr(x.k) + '" title="' + escAttr(x.d) + '"' +
      ' style="border:1px solid ' + (on ? 'var(--c-brand)' : '#dfe3e8') + ';border-radius:8px;background:' + (on ? 'var(--c-brand-soft)' : '#fff') +
      ';color:' + (on ? 'var(--c-brand-text)' : '#374151') + ';font-size:11px;font-weight:600;padding:5px 12px;cursor:pointer;margin-right:6px;">' + (on ? '✓ ' : '') + esc(x.t) + '</button>';
  };
  return '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:12px;background:#fff;margin-top:10px;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><span style="font-weight:700;font-size:14px;">🎨 出图默认 · 账号默认</span>' +
    '<span class="qhelp" tabindex="0" data-tip="' + escAttr('造图片那一页的「🎨 这一套图的风格」就是这一排旋钮：这里定的是账号级默认，某篇要不一样就在那页当场改，只记那一篇。画面流派管「画面上摆什么」，四类轴管「长什么样、看着像谁家的」——一套图看起来才是一家人；再点一下已选中的那颗就是撤掉这一轴。改完不影响已经断好的表，只影响下一套图（以及那页上现改的这一套）。') + '">?</span></div>' +
    _diagMotifRowHtml(cur) +
    NP_LOOK_AXES.map(row).join('') +
    '<div style="display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;margin-top:10px;">' +
      '<span style="min-width:62px;font-size:12px;font-weight:700;color:#374151;">图上放多少字</span>' +
      '<span style="display:flex;gap:0;flex-wrap:wrap;">' + NP_INKS.map(inkBtn).join('') + '</span>' +
      '<span style="font-size:10px;color:#8a929e;">' + esc(npInkDef(ink).d) + '</span></div>' +
    '<div style="margin-top:9px;padding:7px 9px;background:#fafbfc;border-radius:8px;font-size:11px;color:#6b7280;line-height:1.7;">回传配置：' +
      '<div>断句那一发（图描述往哪儿取材）：' + (cur.motif ? '<b style="color:#374151;">' + esc(cur.motif) + '</b>' : '<span style="color:#b45309;">没定流派——AI 自己按这段的意思定</span>') + '</div>' +
      '<div>提示词尾巴（每张都带的固定元素）：' + (token ? '<b style="color:#374151;">' + esc(token) + '</b>' : '<span style="color:#b45309;">四类轴都空着——那张提示词就不带这一行，建议至少定下「画面出身」与「主题」</span>') + '</div>' +
      '　（改完这一页按「💾 保存」才算数）</div>' +
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:9px;">' +
      '<button type="button" class="btn btn-primary diagLookSave" style="margin:0;">💾 保存出图默认</button>' +
      '<button type="button" class="btn btn-outline diagLookClear" style="margin:0;">清空</button>' +
      '<span id="diagLookMsg" style="font-size:11px;color:#9aa0ac;"></span></div>' +
  '</div>';
}
/** 这一档该选哪一档：只看当前账号阶段（冷启动 / 成长 / 成熟），不烧 AI */
function _diagTalkAdvice() {
  const stages = NotePlan.STAGES || [];
  let stageKey = (_diagState.notePlan && _diagState.notePlan.stage) || '';
  if (!stageKey) { try { stageKey = NotePlan.detectStage(_diagState.profile) || ''; } catch (_) {} }
  const stage = stages.filter(function (s) { return s.key === stageKey; })[0] || null;
  const byKey = {};
  NotePlan.SELL_TALK.forEach(function (t) { byKey[t.key] = t; });
  if (!stage) return { talk: byKey.light, why: '还没抓到你的主页（不知道粉丝量），先按「轻带一句」走——去「诊断&配置 → 基础配置」抓一次主页再定。' };
  if (stage.key === 'cold') return { talk: byKey.light, why: '冷启动期还没有信任资产，先把人认下：产品出现一句就够，别在正文里推。' };
  if (stage.key === 'grow') return { talk: byKey.mid, why: '成长期有人认你了，可以用两三成篇幅自然带出产品——讲它怎么解决前面说的那个问题。' };
  return { talk: byKey.strong, why: '成熟期信任够了，可以主推：产品当主角，但另一半篇幅仍要留真实的经验与判断。' };
}
function _diagStyleBind(box) {
  if (!box) return;
  const st = _diagStyleEdit();
  const lt = box.querySelector('#diagLinesToggle');
  if (lt) lt.addEventListener('click', function () { st.linesOpen = !st.linesOpen; diagRenderStyle(); });
  const run = box.querySelector('#diagStyleRun');
  if (run) run.addEventListener('click', _diagStyleRun);
  box.querySelectorAll('.diagLineEdit').forEach(function (b) {
    b.addEventListener('click', function () { _diagEditOpen(b.getAttribute('data-target') || ''); });
  });
  box.querySelectorAll('.diagShapeStep').forEach(function (b) {
    b.addEventListener('click', function () {
      if (!st.draft) return;
      st.draft.shape = _shapeStep(st.draft.shape, b.getAttribute('data-k') || 'build', Number(b.getAttribute('data-d')) || 0);
      diagRenderStyle();
    });
  });
  box.querySelectorAll('.diagShapeWords').forEach(function (b) {
    b.addEventListener('click', function () {
      if (!st.draft) return;
      const w = NotePlan.wordsOf(b.getAttribute('data-words') || '');
      if (w) st.draft.words = w.key;
      diagRenderStyle();
    });
  });
  const sv = box.querySelector('.diagShapeSave');
  if (sv) sv.addEventListener('click', function () { _diagEditSave(st.editing); });
  const rs = box.querySelector('.diagShapeReset');
  if (rs) rs.addEventListener('click', function () { _diagEditReset(st.editing); });
  const cc = box.querySelector('.diagShapeCancel');
  if (cc) cc.addEventListener('click', function () { st.editing = ''; st.draft = null; st.err = ''; diagRenderStyle(); });
  box.querySelectorAll('.npStyleTalk').forEach(function (b) {
    b.addEventListener('click', function () { _diagStyleSetTalk(b.getAttribute('data-talk') || ''); });
  });
  // 🎨 出图默认：四类轴 + 字量（面板上现改，按「💾 保存出图默认」才落库）
  box.querySelectorAll('.diagLookChip').forEach(function (b) {
    b.addEventListener('click', function () {
      const a = b.getAttribute('data-a') || '', v = b.getAttribute('data-v') || '';
      if (!a || !v) return;
      const cur = npLookShape(_diagState.imgLook);
      if (String(cur[a] || '') === v) delete cur[a]; else cur[a] = v;
      _diagState.imgLook = npLookShape(cur);
      diagRenderStyle();
    });
  });
  box.querySelectorAll('.diagLookInk').forEach(function (b) {
    b.addEventListener('click', function () {
      _diagState.imgLook = Object.assign(npLookShape(_diagState.imgLook), { ink: b.getAttribute('data-k') || 'low' });
      diagRenderStyle();
    });
  });
  // 🎭 画面流派：点钮＝改账号默认那一派（跟四类轴一样按「💾 保存出图默认」才落库）；加 / 改 / 删 当场落库 config.imgMotifs
  const mt = _diagMotifEdit();
  const pullMotifDraft = function () {                        // 整块面板每点一下都重画：先把输入格里的字收回草稿，别打到一半丢掉
    if (!mt.open) return;
    const g = function (sel) { const el = box.querySelector(sel); return el ? String(el.value || '') : ''; };
    mt.draft = { k: g('.diagMotifK'), take: g('.diagMotifTake'), cast: g('.diagMotifCast'), forbid: g('.diagMotifForbid'), need: g('.diagMotifNeed') };
  };
  box.querySelectorAll('.diagMotifChip').forEach(function (b) {
    b.addEventListener('click', function () {
      pullMotifDraft();
      const k = b.getAttribute('data-k') || '';
      const cur = npLookShape(_diagState.imgLook);
      if (String(cur.motif || '') === k) delete cur.motif; else cur.motif = k;
      _diagState.imgLook = npLookShape(cur);
      diagRenderStyle();
    });
  });
  const mAdd = box.querySelector('.diagMotifAdd');
  if (mAdd) mAdd.addEventListener('click', function () {
    if (mt.open) { pullMotifDraft(); }
    if (mt.open && !mt.editing && mt.draft && String(mt.draft.k || '').trim()) { mt.open = false; mt.draft = null; }
    else if (mt.open) { mt.open = false; mt.editing = ''; mt.draft = null; mt.err = ''; }
    else { mt.open = true; mt.editing = ''; mt.draft = { k: '', take: '', need: '' }; mt.err = ''; }
    diagRenderStyle();
  });
  box.querySelectorAll('.diagMotifFix').forEach(function (b) {
    b.addEventListener('click', function () {
      const k = b.getAttribute('data-k') || '', m = npMotifOf(k) || { take: '', need: '' };
      mt.open = true; mt.editing = k; mt.err = '';
      mt.draft = { k: k, take: m.take || '', need: m.need || '' };
      diagRenderStyle();
    });
  });
  box.querySelectorAll('.diagMotifDel').forEach(function (b) {
    b.addEventListener('click', async function () {
      const k = b.getAttribute('data-k') || '';
      const msg = document.getElementById('diagLookMsg');
      try {
        await npSaveImgMotifs(_npMotifs.filter(x => x.k !== k));
        const cur = npLookShape(_diagState.imgLook);
        if (String(cur.motif || '') === k && !npMotifIsBuilt(k)) delete cur.motif;
        _diagState.imgLook = cur;
        if (mt.editing === k) { mt.open = false; mt.editing = ''; mt.draft = null; }
        if (msg) { msg.textContent = '已删掉自己加的这一派：' + k; msg.style.color = '#0a7b5a'; }
        diagRenderStyle();
      } catch (e) { if (msg) { msg.textContent = '删除失败：' + ((e && e.message) || e); msg.style.color = '#d33'; } }
    });
  });
  const mCancel = box.querySelector('.diagMotifCancel');
  if (mCancel) mCancel.addEventListener('click', function () { mt.open = false; mt.editing = ''; mt.draft = null; mt.err = ''; diagRenderStyle(); });
  const mSave = box.querySelector('.diagMotifSave');
  if (mSave) mSave.addEventListener('click', async function () {
    pullMotifDraft();
    const msg = document.getElementById('diagLookMsg');
    const d = mt.draft || { k: '', take: '', need: '' };
    const k = String(d.k || '').trim();
    if (!k) { mt.err = '名字要写（它就是列表那一行的身份）'; diagRenderStyle(); return; }
    if (!String(d.take || '').trim()) { mt.err = '「画面上摆什么」要写一句，AI 照这句写每一张的图描述'; diagRenderStyle(); return; }
    const built = npMotifIsBuilt(k) && k !== mt.editing;      // 不许顶掉内置那十条的名字（同名会把内置那条的取材规则盖掉）
    if (built) { mt.err = '这一派内置里已经有了，换个名字'; diagRenderStyle(); return; }
    const keep = _npMotifs.filter(x => x.k !== (mt.editing || k));
    keep.push({ k: k, take: String(d.take).trim(), need: String(d.need).trim() });
    try {
      await npSaveImgMotifs(keep);
      const cur = npLookShape(_diagState.imgLook);
      if (mt.editing && String(cur.motif || '') === mt.editing) cur.motif = k;   // 改了名，默认那一派跟着指到新名
      _diagState.imgLook = cur;
      mt.open = false; mt.editing = ''; mt.draft = null; mt.err = '';
      if (msg) { msg.textContent = '已存这一派：' + k + '（选中它要按「💾 保存出图默认」才算账号默认）'; msg.style.color = '#0a7b5a'; }
      diagRenderStyle();
    } catch (e) { mt.err = '存不下：' + ((e && e.message) || e); diagRenderStyle(); }
  });
  const lookSave = box.querySelector('.diagLookSave');
  if (lookSave) lookSave.addEventListener('click', async function () {
    const msg = document.getElementById('diagLookMsg');
    if (msg) { msg.textContent = '保存中…'; msg.style.color = '#9aa0ac'; }
    try { await npSaveImgLook(_diagState.imgLook); if (msg) { msg.textContent = '✅ 已保存（造图片那页按这个默认走）'; msg.style.color = '#0a7b5a'; } }
    catch (e) { if (msg) { msg.textContent = '保存失败：' + ((e && e.message) || e); msg.style.color = '#d33'; } }
  });
  const lookClear = box.querySelector('.diagLookClear');
  if (lookClear) lookClear.addEventListener('click', function () {
    _diagState.imgLook = npLookShape(null);
    diagRenderStyle();
  });
}
/** 🧠 一句话人设 + 三个阶段怎么说：AI 按问卷/人设卡/知识库把这三行写具体（不再推调子——调子已退市） */
async function _diagStyleRun() {
  const st = _diagStyleEdit();
  if (st.busy) return;
  st.busy = true; st.err = '';
  diagRenderStyle();
  try {
    let prof = _diagState.profile;
    if (!prof) { try { const c = await _diagGetCfg(); prof = (c && c.diagnosis && c.diagnosis.profile) || null; } catch (_) {} }
    const r = await _diagSay('aiNoteStyleAdvice', { profile: prof, answers: _diagState.unifiedAnswers || [], noteStyle: _diagState.noteStyle || null });
    if (!r || r.ok === false || r.error) throw new Error((r && r.error) || 'AI 没返回人设与阶段建议');
    const line = String(r.personaLine || '').trim();
    const rows = (Array.isArray(r.stages) ? r.stages : []).map(function (row) {
      const s = NotePlan.stageOf(row && row.stage);
      return { stage: s ? s.key : '', line: String((row && row.line) || '').trim() };
    }).filter(function (row) { return row.stage && row.line; });
    if (!line && !rows.length) throw new Error('AI 没给出可用建议，请重试');
    _diagState.styleAdvice = {
      personaLine: line,
      stages: rows,
      advice: String(r.advice || '').trim(),
      at: Date.now(),
    };
    try { await chrome.storage.local.set({ note_style_advice: _diagState.styleAdvice }); } catch (_) {}
  } catch (e) {
    st.err = String((e && e.message) || e);
  }
  st.busy = false;
  diagRenderStyle();
}
/** 🎚 话术比例的账号默认（写 config；发笔记 ④ 改的那一条不碰 config） */
async function _diagStyleSetTalk(key) {
  const st = _diagStyleEdit();
  const prev = _diagState.noteStyle || {};
  st.err = '';
  const ns = Object.assign({}, prev, { sellTalk: NotePlan.sellTalkOf(key).key, updatedAt: Date.now() });
  try {
    await npSaveNoteStyle(ns);
  } catch (e) {
    st.err = '保存失败：' + String((e && e.message) || e);
  }
  diagRenderStyle();
}
/** 任务配置算「设置过」：定过话术默认 / 改过任一条线或写法 / 有了一句话人设，任一即算 */
function _diagToneSet() {
  const ns = _diagState.noteStyle || {};
  if (ns.sellTalk) return true;
  if (ns.lines && Object.keys(ns.lines).length) return true;
  if (ns.kinds && Object.keys(ns.kinds).length) return true;
  if (_diagState.styleAdvice && (_diagState.styleAdvice.personaLine || (_diagState.styleAdvice.stages || []).length)) return true;
  let line = '';
  try { line = String(_diagQuizAnswerByQ('用一句话介绍你自己') || '').trim(); } catch (_) {}
  return !!line;
}
/** 这一阶段排几篇、按哪份配比（规划改过的权重只影响它自己那个阶段） */
function _diagStageCustom() {
  const p = _diagState.notePlan || null;
  const mw = (p && p.mixWeights) || null;
  if (!mw || !p.stage) return null;
  const out = {};
  out[p.stage] = mw;
  return out;
}
function _diagStageTotal() {
  const p = _diagState.notePlan || null;
  const n = ((p && Array.isArray(p.mix)) ? p.mix : []).reduce(function (a, r) { return a + (Number(r && r.count) || 0); }, 0);
  return n > 0 ? n : 12;
}
/** 🧬 账号阶段 × 个人人设：三个阶段各给「你这句话在这个阶段怎么说」+ 这一阶段主用哪几条线（各几篇），当前阶段高亮「你在这」 */
function _diagPersonaTableHtml() {
  const stages = NotePlan.STAGES || [];
  if (!stages.length) return '';
  let stageKey = (_diagState.notePlan && _diagState.notePlan.stage) || '';
  if (!stageKey) { try { stageKey = NotePlan.detectStage(_diagState.profile) || ''; } catch (_) {} }
  const adv = _diagState.styleAdvice || {};
  // 那句话以问卷里自己写的为准（本人原话）；没写就看任务配置里 AI 按资料写的那句
  let line = '';
  try { line = String(_diagQuizAnswerByQ('用一句话介绍你自己') || '').trim(); } catch (_) {}
  let lineFrom = 'quiz';
  if (!line) { line = String(adv.personaLine || '').trim(); lineFrom = 'ai'; }
  const aiRows = {};
  (Array.isArray(adv.stages) ? adv.stages : []).forEach(function (r) { if (r && r.stage) aiRows[r.stage] = r; });
  const st = _diagStyleEdit();
  const total = _diagStageTotal();
  const custom = _diagStageCustom();
  const hasPlan = !!(_diagState.notePlan && Array.isArray(_diagState.notePlan.mix) && _diagState.notePlan.mix.length);
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:12px;background:#fff;">' +
    '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><div style="font-weight:700;font-size:14px;">🧬 账号阶段 × 个人人设：你这句话分三个阶段怎么讲</div>' +
    '<button type="button" id="diagStyleRun" class="btn btn-outline" style="margin:0 0 0 auto;font-size:11px;">' + (st.busy ? 'AI 正在看你的资料…' : '🧠 AI 按我的资料写这三行') + '</button></div>' +
    '<div style="font-size:12px;line-height:1.7;margin-top:4px;">' +
    (line
      ? '你的一句话人设：「' + _dEsc(line.slice(0, 160)) + '」' + (lineFrom === 'ai' ? '<span style="color:#1f6feb;">（AI 按你的资料写的）</span>' : '<span style="color:#888;">（问卷里你自己写的）</span>')
      : '<span style="color:#c77700;">还没有你的一句话人设——去「问卷」那题写一句（你是谁 / 在干嘛 / 擅长什么 / 能帮客户什么），或点右上角「🧠 AI 按我的资料写」让它替你写。</span>') +
    '</div>' +
    (st.err ? '<div style="font-size:11px;color:#c62828;margin-top:4px;">' + _dEsc(st.err) + '</div>' : '') +
    '<div style="overflow-x:auto;margin-top:8px;"><table style="width:100%;border-collapse:collapse;font-size:11px;">' +
    '<tr><th style="text-align:left;padding:6px 6px 6px 0;border-bottom:1px solid #eceff3;color:#999;font-weight:600;width:92px;">阶段</th>' +
    '<th style="text-align:left;padding:6px;border-bottom:1px solid #eceff3;color:#999;font-weight:600;">这句话在这个阶段怎么说</th>' +
    '<th style="text-align:left;padding:6px;border-bottom:1px solid #eceff3;color:#999;font-weight:600;width:190px;">这一阶段主用哪几条线（各几篇）</th></tr>';
  stages.forEach(function (s) {
    const on = s.key === stageKey;
    const p = (NotePlan.stagePlayOf && NotePlan.stagePlayOf(s.key)) || {};
    const row = aiRows[s.key] || {};
    const txt = row.line || p.line || '';
    let top = [];
    try { top = NotePlan.stageTopLines(s.key, custom, s.key === stageKey ? total : 12).slice(0, 3); } catch (_) {}
    const linesTxt = top.length
      ? top.map(function (r) { return '<b>' + _dEsc(r.name || _diagTypeName(r.type)) + '</b> ' + Number(r.count) + ' 篇'; }).join(' · ')
      : '<span style="color:#c77700;">（这一阶段的配比都被改成 0 了——去「规划」的配比条调）</span>';
    h += '<tr' + (on ? ' style="background:var(--c-brand-soft);"' : '') + '>' +
      '<td style="padding:6px 6px 6px 0;border-bottom:1px solid #f2f4f7;vertical-align:top;font-weight:600;color:' + (on ? 'var(--c-brand-ink)' : '#333') + ';">' + _dEsc(s.name) +
      '<div style="font-size:10px;font-weight:400;color:#aaa;">粉丝 ' + _dEsc(s.fans) + '</div>' +
      (on ? '<div style="font-size:10px;color:var(--c-brand-text);">← 你在这</div>' : '') + '</td>' +
      '<td style="padding:6px;border-bottom:1px solid #f2f4f7;vertical-align:top;line-height:1.6;color:#555;">' + _dEsc(txt) + '</td>' +
      '<td style="padding:6px;border-bottom:1px solid #f2f4f7;vertical-align:top;color:' + (on ? 'var(--c-brand-ink)' : '#444') + ';line-height:1.7;">' + linesTxt + '</td></tr>';
  });
  h += '</table></div>' +
    '<div style="font-size:11px;color:#888;margin-top:6px;">右边那一列就是这一阶段发哪几条线、各几篇（按规划的配比算）' + (hasPlan ? '，「你在这」那一行就是这批排产表用的数' : '；还没排产，先按这一阶段的建议配比给') + '。每条线底下的写法与篇幅配比在下面那张表里定。' +
    (adv.advice ? '<div style="font-size:12px;color:#0a7b5a;background:#f4fbf7;border:1px solid #d9efe4;border-radius:8px;padding:8px 10px;margin-top:6px;">🧠 AI 建议：' + _dEsc(adv.advice) + '</div>' : '') +
    '</div>' +
    '</div>';
  return h;
}

// 线徽标：一条排产 = 哪条线 · 哪种具体写法（档位已撤，不再标卖不卖）
function _diagKindName(k) {
  try { const x = NotePlan.kindOf(k); if (x) return x.name; } catch (_) {}
  return '';
}
function _diagScopeTag(scope) {
  if (scope === 'samePeople') return '<span style="display:inline-block;font-size:10px;padding:1px 6px;border-radius:8px;background:#eaf7f0;color:#0a7b5a;">同人群</span>';
  if (scope === 'breakout') return '<span style="display:inline-block;font-size:10px;padding:1px 6px;border-radius:8px;background:#fff4e5;color:#b26a00;">破圈</span>';
  return '';
}
function _diagTypeName(k) {
  try { const t = NotePlan.typeOf(k); if (t) return t.name; } catch (_) {}
  return String(k || '');
}
/* ── ⚖️ 配比（可调）：权重 → 篇数，改的是「下一批怎么分」，本批排产表不动 ── */
function _diagMixSize(p) {
  const m = (p && Array.isArray(p.mix)) ? p.mix : [];
  const n = m.reduce(function (a, r) { return a + (Number(r && r.count) || 0); }, 0);
  return n > 0 ? n : 12;
}
function _diagMixRows(stage, weights) {
  let base = [];
  try { base = NotePlan.mixOf(stage, null) || []; } catch (_) {}
  return base.map(function (r) {
    const raw = (weights && weights[r.type] != null) ? Number(weights[r.type]) : r.share;
    return Object.assign({}, r, { share: Math.max(0, Math.min(60, isFinite(raw) ? raw : r.share)) });
  });
}
function _diagMixPlan(p, rows) {
  const shortSet = {};
  (Array.isArray(p && p.short) ? p.short : []).forEach(function (s) { if (s && s.type) shortSet[s.type] = 1; });
  const alloc = NotePlan.allocate((rows || []).filter(function (r) { return !shortSet[r.type]; }), _diagMixSize(p));
  const target = {};
  alloc.forEach(function (r) { target[r.type] = r.count; });
  const actual = {};
  ((p && p.items) || []).forEach(function (it) { if (it && it.type) actual[it.type] = (actual[it.type] || 0) + 1; });
  return { alloc: alloc, target: target, actual: actual, shortSet: shortSet };
}
function _diagMixHtml(p) {
  const stage = String((p && p.stage) || '');
  const used = (p && p.mixWeights) || null;
  if (!stage || !used) return '';
  if (!_diagState.mixEdit || _diagState.mixEdit.stage !== stage) {
    _diagState.mixEdit = { stage: stage, weights: Object.assign({}, used), dirty: false };
  }
  const w = _diagState.mixEdit.weights;
  const rows = _diagMixRows(stage, w);
  const calc = _diagMixPlan(p, rows);
  const sum = rows.reduce(function (a, r) { return a + (Number(r.share) || 0); }, 0);
  const chip = function (r) {
    const cnt = calc.target[r.type] || 0;
    const pct = sum > 0 ? Math.round((Number(r.share) || 0) / sum * 100) : 0;
    return '<div style="display:flex;align-items:center;gap:5px;border:1px solid ' + (cnt ? '#e3e8ef' : '#f0f1f3') + ';border-radius:8px;padding:3px 5px;background:' + (cnt ? '#fafbfc' : '#f7f8fa') + ';" title="' + _dEsc((r.goal || '') + (r.ex ? '（例：' + r.ex + '）' : '')) + '">' +
      '<span style="font-size:11px;color:' + (cnt ? '#333' : '#aaa') + ';">' + _dEsc(_diagTypeName(r.type)) + '</span>' +
      '<b style="font-size:11px;color:' + (cnt ? 'var(--c-brand-ink)' : '#bbb') + ';">' + cnt + '篇</b>' +
      '<span style="font-size:10px;color:#999;">' + pct + '%</span>' +
      '<button type="button" data-mix="' + _dEsc(r.type) + '" data-d="-5" style="width:19px;height:19px;line-height:1;padding:0;border:1px solid #d8dee9;background:#fff;border-radius:6px;font-size:12px;color:#555;cursor:pointer;">−</button>' +
      '<button type="button" data-mix="' + _dEsc(r.type) + '" data-d="5" style="width:19px;height:19px;line-height:1;padding:0;border:1px solid #d8dee9;background:#fff;border-radius:6px;font-size:12px;color:#555;cursor:pointer;">＋</button>' +
      '</div>';
  };
  const size = _diagMixSize(p);
  let h = '<div style="border:1px solid #e5e8ee;border-radius:10px;padding:12px;background:#fff;margin-top:10px;">' +
    '<div style="font-weight:700;font-size:14px;">⚖️ 配比<span style="font-size:11px;color:#888;font-weight:400;margin-left:6px;">下一批 ' + size + ' 篇怎么分，可以自己挪</span></div>' +
    '<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;">' + rows.map(chip).join('') + '</div>';
  if (!(sum > 0)) {
    h += '<div style="font-size:11px;color:#c62828;margin-top:8px;">一类都排不出来了：至少给一类留权重，再保存。</div>';
  } else {
    const off = [];
    rows.forEach(function (r) {
      const want = calc.target[r.type] || 0, got = calc.actual[r.type] || 0;
      if (Math.abs(got - want) >= 2) off.push(_diagTypeName(r.type) + ' 目标 ' + want + ' / 本批排了 ' + got);
    });
    if (off.length) h += '<div style="font-size:11px;color:#c77700;margin-top:8px;">⚠️ 本批和这个配比有出入：' + _dEsc(off.join('；')) + '——这张排产表是旧配比排的，想照新的重排一遍，点顶部「🔄 重新生成规划与评估」。</div>';
    else h += '<div style="font-size:11px;color:#0a7b5a;margin-top:8px;">✓ 本批篇数跟这个配比一致。</div>';
  }
  const shortNames = Object.keys(calc.shortSet).map(function (k) {
    const row = (Array.isArray(p.short) ? p.short : []).filter(function (s) { return s && s.type === k; })[0];
    return (row && row.name) || _diagTypeName(k);
  });
  if (shortNames.length) h += '<div style="font-size:11px;color:#888;margin-top:4px;">这几条线缺料、这次没排：' + _dEsc(shortNames.join('、')) + '——补齐后它的篇数会自动加进来。</div>';
  h += '<div style="margin-top:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
    '<button type="button" id="diagMixSave" class="btn btn-primary" style="font-size:11px;margin:0;">保存配比</button>' +
    '<button type="button" id="diagMixReset" class="btn btn-outline" style="font-size:11px;margin:0;">恢复默认</button>' +
    (_diagState.mixEdit.dirty ? '<span style="font-size:11px;color:#c77700;">有改动还没保存</span>' : '') +
    '<span id="diagMixMsg" style="font-size:11px;color:#0a7b5a;"></span></div>';
  return h + '</div>';
}
function _diagMixStep(type, d) {
  const st = _diagState.mixEdit;
  if (!st || !type || !d) return;
  const cur = Number(st.weights[type]);
  st.weights[type] = Math.max(0, Math.min(60, (isFinite(cur) ? cur : 0) + d));
  st.dirty = true;
  diagRenderPlan();
}
async function _diagMixPersist(rows) {
  const p = _diagState.notePlan || {};
  const stage = String((_diagState.mixEdit || {}).stage || p.stage || '');
  const d = await chrome.storage.local.get('note_plan_mix');
  const store = (d && d.note_plan_mix && typeof d.note_plan_mix === 'object') ? d.note_plan_mix : {};
  const patch = { note_plan_mix: store };
  if (rows) store[stage] = rows.reduce(function (a, r) { a[r.type] = r.share; return a; }, {});
  else delete store[stage];
  if (Array.isArray(p.items)) {   // 本批的「目标篇数」跟着更新，实排不动——偏差提示才是当前口径
    const shortSet = {};
    (Array.isArray(p.short) ? p.short : []).forEach(function (s) { if (s && s.type) shortSet[s.type] = 1; });
    p.mix = NotePlan.allocate(((rows || _diagMixRows(stage, null)) || []).filter(function (r) { return !shortSet[r.type]; }), _diagMixSize(p));
    p.mixWeights = _diagMixRows(stage, rows ? rows.reduce(function (a, r) { a[r.type] = r.share; return a; }, {}) : null)
      .reduce(function (a, r) { a[r.type] = r.share; return a; }, {});
    p.problems = NotePlan.validatePlan(p).problems;
