        '<b>' + _dEsc(c.name) + '</b>' +
        '<span style="color:#666;">' + _dEsc(_diagTypeName(c.type)) + '</span>' +
        (off ? '<span style="font-size:11px;color:#c77700;">⚠ 这条线现在缺料</span>' : '') +
