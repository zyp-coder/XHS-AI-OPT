          '<button type="button" class="btn btn-outline diag-col-edit" style="font-size:11px;margin:0;">编辑</button>' +
          '<button type="button" class="btn btn-outline diag-col-del" style="font-size:11px;margin:0;">删</button>' +
        '</span></div>';
    }).join('') + '</div>';
  }
